<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Tensor Admin Dashboard</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-base: #070a0f;
      --bg-base-2: #0b0f17;
      --bg-panel: rgba(17, 24, 39, 0.88);
      --bg-card: rgba(15, 23, 42, 0.78);
      --bg-hover: rgba(45, 55, 72, 0.92);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.14);
      --border-strong: rgba(148, 163, 184, 0.25);
      --green: #0ecb81;
      --red: #f6465d;
      --yellow: #f59e0b;
      --blue: #3b82f6;
      --purple: #8b5cf6;
      --purple-soft: rgba(139, 92, 246, 0.18);
      --green-soft: rgba(14, 203, 129, 0.15);
      --red-soft: rgba(246, 70, 93, 0.15);
      --shadow: 0 24px 80px rgba(0,0,0,0.42);
      --radius: 18px;
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="light"] {
      --bg-base: #f6f8fb;
      --bg-base-2: #eef2f8;
      --bg-panel: rgba(255,255,255,0.92);
      --bg-card: rgba(255,255,255,0.86);
      --bg-hover: rgba(226, 232, 240, 0.92);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border: rgba(15, 23, 42, 0.10);
      --border-strong: rgba(15, 23, 42, 0.18);
      --shadow: 0 18px 55px rgba(15,23,42,0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      width: 100%;
      min-height: 100%;
      background:
        radial-gradient(circle at top left, rgba(139,92,246,0.22), transparent 28%),
        radial-gradient(circle at top right, rgba(59,130,246,0.16), transparent 24%),
        linear-gradient(180deg, var(--bg-base), var(--bg-base-2));
      color: var(--text-main);
      overflow-x: hidden;
      font-variant-numeric: tabular-nums;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.026) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.026) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.65), transparent 70%);
      z-index: 0;
    }

    button, input, select, textarea {
      font: inherit;
      outline: none;
      border: none;
      background: transparent;
      color: inherit;
    }

    textarea {
      resize: vertical;
    }

    button {
      cursor: pointer;
      transition: transform 0.08s ease, opacity 0.12s ease, background 0.12s ease, border-color 0.12s ease;
    }

    button:active {
      transform: scale(0.98);
    }

    button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .app {
      position: relative;
      z-index: 1;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 60;
      padding: calc(10px + var(--safe-top)) 14px 10px;
      background: rgba(7, 10, 15, 0.78);
      backdrop-filter: blur(22px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    [data-theme="light"] .topbar {
      background: rgba(255,255,255,0.78);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,0.35), transparent 22%),
        linear-gradient(135deg, var(--purple), var(--blue));
      box-shadow: 0 14px 34px rgba(139,92,246,0.35);
      flex: 0 0 auto;
    }

    .brand-title {
      font-weight: 950;
      font-size: 1.02rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .brand-sub {
      color: var(--text-muted);
      font-size: 0.68rem;
      font-weight: 850;
      margin-top: 2px;
      white-space: nowrap;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      border: 1px solid rgba(139,92,246,0.34);
      background: rgba(139,92,246,0.14);
      color: #c4b5fd;
      font-size: 0.72rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .page {
      width: min(1720px, 100%);
      margin: 0 auto;
      padding: 14px 12px calc(34px + var(--safe-bottom));
      display: grid;
      gap: 14px;
    }

    .hero {
      border-radius: 24px;
      padding: 16px;
      background:
        radial-gradient(circle at 0% 0%, rgba(139,92,246,0.30), transparent 28%),
        radial-gradient(circle at 100% 0%, rgba(14,203,129,0.12), transparent 24%),
        var(--bg-panel);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
      overflow: hidden;
      position: relative;
    }

    .hero-head {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .hero-title {
      font-size: clamp(1.45rem, 4vw, 3.4rem);
      line-height: 0.98;
      letter-spacing: -0.07em;
      font-weight: 950;
    }

    .hero-sub {
      margin-top: 9px;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 780;
      line-height: 1.5;
      max-width: 900px;
    }

    .stats-grid {
      margin-top: 16px;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 9px;
    }

    .stat-card {
      background: rgba(7,10,15,0.42);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 12px;
      min-width: 0;
    }

    [data-theme="light"] .stat-card {
      background: rgba(255,255,255,0.74);
    }

    .stat-label {
      color: var(--text-muted);
      font-size: 0.65rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .stat-value {
      margin-top: 7px;
      font-weight: 950;
      font-size: 1rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .nav-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 3px;
      border-radius: 18px;
      background: rgba(7,10,15,0.38);
      border: 1px solid var(--border);
      position: sticky;
      top: calc(59px + var(--safe-top));
      z-index: 50;
      backdrop-filter: blur(18px);
    }

    .nav-tabs::-webkit-scrollbar {
      display: none;
    }

    .nav-tab {
      min-height: 40px;
      padding: 9px 13px;
      border-radius: 14px;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 950;
      white-space: nowrap;
      border: 1px solid transparent;
    }

    .nav-tab.active {
      color: white;
      background: linear-gradient(135deg, var(--purple), var(--blue));
      border-color: rgba(255,255,255,0.12);
    }

    .layout {
      display: grid;
      gap: 14px;
    }

    @media (min-width: 1180px) {
      .layout.two {
        grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
        align-items: start;
      }

      .layout.three {
        grid-template-columns: minmax(0, 0.85fr) minmax(360px, 0.75fr) minmax(360px, 0.75fr);
        align-items: start;
      }
    }

    .panel {
      border-radius: var(--radius);
      padding: 14px;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
      min-width: 0;
    }

    .section-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 1rem;
      font-weight: 950;
    }

    .section-icon {
      width: 30px;
      height: 30px;
      border-radius: 11px;
      display: grid;
      place-items: center;
      background: var(--purple-soft);
      color: #c4b5fd;
      flex: 0 0 auto;
    }

    .section-icon svg,
    .brand-logo svg {
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .section-sub {
      color: var(--text-muted);
      font-size: 0.74rem;
      font-weight: 760;
      line-height: 1.45;
      margin-top: 4px;
    }

    .btn-row {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .primary-btn, .mini-btn, .danger-btn, .green-btn, .yellow-btn {
      min-height: 40px;
      border-radius: 13px;
      padding: 9px 12px;
      font-size: 0.77rem;
      font-weight: 950;
      border: 1px solid transparent;
      text-align: center;
      white-space: nowrap;
    }

    .primary-btn {
      color: #fff;
      background: linear-gradient(135deg, var(--purple), var(--blue));
      box-shadow: 0 14px 30px rgba(59,130,246,0.18);
    }

    .green-btn {
      color: #fff;
      background: linear-gradient(135deg, #0ecb81, #10b981);
      box-shadow: 0 14px 30px rgba(14,203,129,0.14);
    }

    .yellow-btn {
      color: #111827;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
    }

    .mini-btn {
      background: var(--bg-card);
      color: var(--text-main);
      border-color: var(--border);
    }

    .danger-btn {
      background: var(--red-soft);
      color: var(--red);
      border-color: rgba(246,70,93,0.24);
    }

    .form {
      display: grid;
      gap: 10px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .form-grid.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .field {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      color: var(--text-muted);
      font-size: 0.66rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: center;
    }

    .field input, .field select, .field textarea {
      min-height: 42px;
      background: rgba(7,10,15,0.58);
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 9px 11px;
      font-size: 0.84rem;
      font-weight: 850;
      width: 100%;
    }

    [data-theme="light"] .field input,
    [data-theme="light"] .field select,
    [data-theme="light"] .field textarea {
      background: rgba(248,250,252,0.92);
    }

    .field input:focus, .field select:focus, .field textarea:focus {
      border-color: rgba(139,92,246,0.72);
      box-shadow: 0 0 0 3px rgba(139,92,246,0.10);
    }

    .note {
      color: var(--text-muted);
      font-size: 0.72rem;
      font-weight: 760;
      line-height: 1.45;
    }

    .small-note {
      color: var(--text-muted);
      font-size: 0.67rem;
      font-weight: 760;
      line-height: 1.45;
    }

    .list {
      display: grid;
      gap: 9px;
    }

    .card {
      position: relative;
      overflow: hidden;
      border-radius: 17px;
      padding: 12px;
      background: rgba(7,10,15,0.44);
      border: 1px solid var(--border);
      min-width: 0;
    }

    [data-theme="light"] .card {
      background: rgba(255,255,255,0.78);
    }

    .card.active {
      border-color: rgba(139,92,246,0.60);
      box-shadow: 0 16px 40px rgba(139,92,246,0.12);
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
    }

    .token-row {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .token-icon {
      width: 42px;
      height: 42px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, rgba(139,92,246,0.88), rgba(59,130,246,0.82));
      color: white;
      overflow: hidden;
      flex: 0 0 auto;
    }

    .token-icon svg {
      width: 24px;
      height: 24px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .token-title {
      font-size: 0.92rem;
      font-weight: 950;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .token-sub {
      color: var(--text-muted);
      font-size: 0.69rem;
      font-weight: 820;
      margin-top: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 8px;
      border-radius: 999px;
      font-size: 0.66rem;
      font-weight: 950;
      white-space: nowrap;
      border: 1px solid var(--border);
      background: rgba(15,23,42,0.58);
      color: var(--text-muted);
    }

    .badge.green {
      background: var(--green-soft);
      color: var(--green);
      border-color: rgba(14,203,129,0.24);
    }

    .badge.red {
      background: var(--red-soft);
      color: var(--red);
      border-color: rgba(246,70,93,0.24);
    }

    .badge.purple {
      background: var(--purple-soft);
      color: #c4b5fd;
      border-color: rgba(139,92,246,0.30);
    }

    .badge.yellow {
      background: rgba(245,158,11,0.15);
      color: var(--yellow);
      border-color: rgba(245,158,11,0.24);
    }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 7px;
      margin-top: 12px;
    }

    .metric {
      padding: 9px;
      border-radius: 13px;
      background: rgba(15,23,42,0.45);
      border: 1px solid var(--border);
      min-width: 0;
    }

    [data-theme="light"] .metric {
      background: rgba(248,250,252,0.74);
    }

    .metric-label {
      color: var(--text-muted);
      font-size: 0.62rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .metric-value {
      margin-top: 5px;
      font-size: 0.82rem;
      font-weight: 950;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .card-actions {
      margin-top: 12px;
      display: flex;
      gap: 8px;
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .icon-grid {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 7px;
      max-height: 305px;
      overflow: auto;
      padding: 4px;
      border-radius: 15px;
      border: 1px solid var(--border);
      background: rgba(7,10,15,0.34);
    }

    .icon-choice {
      aspect-ratio: 1;
      min-height: 40px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-main);
    }

    .icon-choice.active {
      border-color: rgba(139,92,246,0.82);
      box-shadow: 0 0 0 3px rgba(139,92,246,0.12);
      background: linear-gradient(135deg, rgba(139,92,246,0.36), rgba(59,130,246,0.22));
    }

    .icon-choice svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .hidden {
      display: none !important;
    }

    .empty {
      padding: 22px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 800;
      border: 1px dashed var(--border-strong);
      border-radius: 16px;
      background: rgba(7,10,15,0.22);
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: calc(24px + var(--safe-bottom));
      transform: translateX(-50%) translateY(20px);
      z-index: 200;
      min-width: 240px;
      max-width: calc(100% - 28px);
      padding: 12px 14px;
      border-radius: 15px;
      background: rgba(15,23,42,0.95);
      border: 1px solid var(--border-strong);
      color: white;
      font-weight: 900;
      font-size: 0.78rem;
      box-shadow: 0 18px 50px rgba(0,0,0,0.35);
      opacity: 0;
      pointer-events: none;
      transition: 0.18s ease;
      text-align: center;
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .admin-only-warning {
      display: none;
      min-height: 100vh;
      place-items: center;
      padding: 22px;
      position: relative;
      z-index: 2;
    }

    .warning-card {
      width: min(560px, 100%);
      padding: 22px;
      border-radius: 24px;
      background: var(--bg-panel);
      border: 1px solid var(--border-strong);
      box-shadow: var(--shadow);
      text-align: center;
    }

    .warning-title {
      font-size: 1.4rem;
      font-weight: 950;
      margin-top: 12px;
    }

    .warning-text {
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1.5;
      font-weight: 780;
      margin-top: 8px;
    }

    @media (max-width: 900px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .form-grid,
      .form-grid.three {
        grid-template-columns: 1fr;
      }

      .metric-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .icon-grid {
        grid-template-columns: repeat(6, 1fr);
      }

      .brand-sub {
        display: none;
      }
    }

    @media (max-width: 520px) {
      .topbar {
        align-items: flex-start;
      }

      .top-actions {
        gap: 6px;
      }

      .pill {
        display: none;
      }

      .hero-head {
        flex-direction: column;
      }

      .btn-row {
        justify-content: stretch;
      }

      .btn-row button,
      .btn-row a {
        flex: 1;
      }

      .stats-grid,
      .metric-grid {
        grid-template-columns: 1fr;
      }

      .icon-grid {
        grid-template-columns: repeat(5, 1fr);
      }
    }
  </style>
</head>

<body>
  <div id="adminDenied" class="admin-only-warning">
    <div class="warning-card">
      <div class="brand-logo" style="margin:0 auto;">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>
          <path d="M12 8v5"/>
          <path d="M12 17h.01"/>
        </svg>
      </div>
      <div class="warning-title">Admin access only</div>
      <div class="warning-text">This dashboard is locked to the staff/admin account. Log in through the staff form on the index page.</div>
      <div class="btn-row" style="justify-content:center;margin-top:16px;">
        <a class="primary-btn" href="/index.html">Go to login</a>
        <a class="mini-btn" href="/trading">Back to trading</a>
      </div>
    </div>
  </div>

  <div id="adminApp" class="app hidden">
    <script>
      const SERVER_EMAIL = <%- JSON.stringify(typeof email !== 'undefined' ? email : '') %>;
      const SERVER_ROLE = <%- JSON.stringify(typeof role !== 'undefined' ? role : '') %>;
      const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
    </script>

    <header class="topbar">
      <a href="/dashboard" class="brand">
        <span class="brand-logo">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
            <path d="M4 19.5V4.5A2.5 2.5 0 0 1 6.5 2h11A2.5 2.5 0 0 1 20 4.5v15A2.5 2.5 0 0 1 17.5 22h-11A2.5 2.5 0 0 1 4 19.5Z"/>
            <path d="M8 7h8"/>
            <path d="M8 12h8"/>
            <path d="M8 17h4"/>
          </svg>
        </span>
        <span style="min-width:0;">
          <div class="brand-title">Tensor Admin</div>
          <div class="brand-sub">Dashboard • Copy portfolios • Tensor assets • Balance editor</div>
        </span>
      </a>

      <div class="top-actions">
        <span class="pill">● Admin</span>
        <button class="mini-btn" onclick="refreshAll()">Refresh</button>
