    function isAdmin() {
      const role = String(SERVER_ROLE || '').toLowerCase();
      const email = String(SERVER_EMAIL || '').toLowerCase();
      const walletRole = String(adminWallet?.role || '').toLowerCase();

      return role === 'staff'
        || role === 'admin'
        || walletRole === 'staff'
        || walletRole === 'admin'
        || email === 'admin@tensorwallet.local';
    }

    function apiBaseCandidates(kind) {
      const map = {
        summary: ['/api/admin/summary', '/api/admin/state'],
        tokens: ['/api/admin/tensor/tokens', '/api/tensor'],
        tokenCreate: ['/api/admin/tensor/tokens', '/api/tensor/deploy'],
        tokenUpdate: id => [`/api/admin/tensor/tokens/${encodeURIComponent(id)}`, `/api/tensor/update/${encodeURIComponent(id)}`],
        tokenDelete: id => [`/api/admin/tensor/tokens/${encodeURIComponent(id)}`, `/api/tensor/delete/${encodeURIComponent(id)}`],
        copyProfiles: ['/api/admin/copy/profiles', '/api/copy/profiles'],
        copyCreate: ['/api/admin/copy/profiles', '/api/copy/admin/profile'],
        copyUpdate: id => [`/api/admin/copy/profiles/${encodeURIComponent(id)}`, `/api/copy/admin/profile/${encodeURIComponent(id)}`],
        copyDelete: id => [`/api/admin/copy/profiles/${encodeURIComponent(id)}`, `/api/copy/admin/profile/${encodeURIComponent(id)}`],
        adminWallet: ['/api/admin/wallet', '/api/wallet'],
        adminWalletAdjust: ['/api/admin/wallet/adjust'],
        users: ['/api/admin/users'],
        userAdjust: ['/api/admin/users/adjust'],
        userReset: ['/api/admin/users/reset-wallet']
      };

      return map[kind];
    }

    async function apiTry(candidates, options = {}) {
      const list = typeof candidates === 'function' ? candidates(options.id) : candidates;
      let lastError = null;

      for (const url of list) {
        try {
          const res = await fetch(url, {
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              ...(options.headers || {})
            },
            ...options,
            body: options.body && typeof options.body !== 'string'
              ? JSON.stringify(options.body)
              : options.body
          });

          const contentType = res.headers.get('content-type') || '';
          const data = contentType.includes('application/json')
            ? await res.json()
            : { text: await res.text() };

          if (res.ok) {
            return { ok: true, data, url };
          }

          lastError = data.error || data.text || `HTTP ${res.status}`;
        } catch (err) {
          lastError = err.message;
        }
      }

      return { ok: false, error: lastError || 'Endpoint unavailable.' };
    }

    function formatMoney(n, decimals = 2) {
      return (Number(n) || 0).toLocaleString(undefined, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    function formatPrice(n) {
      n = Number(n) || 0;
      if (n >= 1000) return formatMoney(n, 2);
      if (n >= 1) return formatMoney(n, 4);
      return n.toLocaleString(undefined, { minimumFractionDigits: 6, maximumFractionDigits: 6 });
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function showToast(message = 'Done') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.classList.add('show');

      clearTimeout(showToast.timer);
      showToast.timer = setTimeout(() => toast.classList.remove('show'), 2100);
    }

    function toggleTheme() {
      currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', currentTheme);
      localStorage.setItem('blue_theme', currentTheme);
    }

    function switchSection(name, btn) {
      document.querySelectorAll('.dashboard-section').forEach(s => s.classList.add('hidden'));
      document.getElementById(`section-${name}`).classList.remove('hidden');

      document.querySelectorAll('.nav-tab').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
    }

    function switchSectionByName(name) {
      const btn = Array.from(document.querySelectorAll('.nav-tab')).find(b => {
        return b.textContent.trim().toLowerCase().includes(name);
      });

      switchSection(name, btn);
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('show');
    }

    function openTokenModal(mode = 'create') {
      if (mode === 'create') clearTokenForm();
      document.getElementById('tokenModal').classList.add('show');
    }

    function openCopyModal(mode = 'create') {
      if (mode === 'create') clearCopyForm();
      document.getElementById('copyModal').classList.add('show');
    }

    function renderIconGrid() {
      const grid = document.getElementById('iconGrid');

      grid.innerHTML = iconLibrary.map(([id, svg]) => `
        <button type="button" class="icon-choice ${selectedIconId === id ? 'active' : ''}" title="${escapeHtml(id)}" onclick="selectIcon('${escapeHtml(id)}')">
          ${svg}
        </button>
      `).join('');
    }

    function selectIcon(id) {
      selectedIconId = id;
      const found = iconLibrary.find(x => x[0] === id);
      document.getElementById('tokenIcon').value = found ? found[1] : id;
      renderIconGrid();
    }

    function getIconHtml(icon) {
      if (!icon) return iconLibrary[0][1];
      if (String(icon).includes('<svg')) return icon;

      const found = iconLibrary.find(x => x[0] === icon);
      if (found) return found[1];

      return `<span style="font-weight:950;">${escapeHtml(String(icon).slice(0, 2).toUpperCase())}</span>`;
    }

    function syncRangeLabels() {
      const minRange = document.getElementById('tokenMinMovePct');
      const maxRange = document.getElementById('tokenMaxMovePct');

      let minVal = Number(minRange.value) || 1;
      let maxVal = Number(maxRange.value) || 1;

      if (minVal > maxVal) {
        maxVal = minVal;
        maxRange.value = maxVal;
      }

      document.getElementById('tokenMinMovePctNum').value = minVal;
      document.getElementById('tokenMaxMovePctNum').value = maxVal;
      document.getElementById('minMoveLabel').textContent = `${minVal}%`;
      document.getElementById('maxMoveLabel').textContent = `${maxVal}%`;
    }

    function syncRangeInputs(type) {
      const input = type === 'min'
        ? document.getElementById('tokenMinMovePctNum')
        : document.getElementById('tokenMaxMovePctNum');

      const range = type === 'min'
        ? document.getElementById('tokenMinMovePct')
        : document.getElementById('tokenMaxMovePct');

      range.value = Math.max(1, Math.min(50, Number(input.value) || 1));
      syncRangeLabels();
    }

    async function refreshAll() {
      await Promise.allSettled([
        loadSummary(),
        loadTokens(),
        loadCopyProfiles(),
        loadAdminWallet(),
        loadUsers()
      ]);

      renderAll();
      showToast('Dashboard refreshed');
    }

    async function loadSummary() {
      const result = await apiTry(apiBaseCandidates('summary'));

      if (result.ok) {
        const data = result.data;
        if (data.wallet) adminWallet = data.wallet;
        if (Array.isArray(data.tokens)) tokens = data.tokens;
        if (Array.isArray(data.tensorRegistry)) tokens = data.tensorRegistry;
        if (Array.isArray(data.copyProfiles)) copyProfiles = data.copyProfiles;
        if (Array.isArray(data.profiles)) copyProfiles = data.profiles;
        if (Array.isArray(data.users)) users = data.users;
      }
    }

    async function loadTokens() {
      const result = await apiTry(apiBaseCandidates('tokens'));

      if (!result.ok) {
        console.warn(result.error);
        return;
      }

      const data = result.data;
      tokens = data.tokens || data.registry || data.tensorRegistry || [];
    }

    async function loadCopyProfiles() {
      const result = await apiTry(apiBaseCandidates('copyProfiles'));

      if (!result.ok) {
        console.warn(result.error);
        return;
      }

      const data = result.data;
      copyProfiles = data.copyProfiles || data.profiles || (data.portfolio ? [data.portfolio] : []);
    }

    async function loadAdminWallet() {
      const result = await apiTry(apiBaseCandidates('adminWallet'));

      if (!result.ok) {
        console.warn(result.error);
        return;
      }

      adminWallet = result.data.wallet || result.data;
    }

    async function loadUsers() {
      const result = await apiTry(apiBaseCandidates('users'));

      if (!result.ok) {
        console.warn(result.error);
        users = [];
        renderUsers();
        return;
      }

      users = result.data.users || [];
      renderUsers();
    }

    function renderAll() {
      renderStats();
      renderCopyProfiles();
      renderTokens();
      renderWallet();
      renderUsers();
      renderAdminAssetSelect();
      renderUserAssetSelect();
      renderOverview();
      renderIconGrid();
    }

    function renderStats() {
      document.getElementById('statTokens').textContent = tokens.length;
      document.getElementById('statProfiles').textContent = copyProfiles.length;
      document.getElementById('statUsdt').textContent = formatMoney(adminWallet.usdtBalance || 0);
      document.getElementById('statOusd').textContent = formatMoney(adminWallet.ousdBalance || 0);
      document.getElementById('statPositions').textContent = Array.isArray(adminWallet.positions) ? adminWallet.positions.length : 0;

      const followers = copyProfiles.reduce((sum, p) => sum + Number(p.followers || 0), 0);
      document.getElementById('statFollowers').textContent = followers;
    }

    function renderOverview() {
      document.getElementById('overviewCopyList').innerHTML = copyProfiles.slice(0, 4).map(copyCardHtml).join('') || `<div class="empty">No copy profiles yet.</div>`;
      document.getElementById('overviewTokenList').innerHTML = tokens.slice(0, 4).map(tokenCardHtml).join('') || `<div class="empty">No Tensor tokens yet.</div>`;

      const rows = getWalletRows(adminWallet).slice(0, 8).map(row => `
        <div class="card">
          <div class="card-top">
            <div>
              <div class="token-title">${escapeHtml(row.symbol)}</div>
              <div class="token-sub">${escapeHtml(row.type)}</div>
            </div>
            <div style="text-align:right;font-weight:950;">${formatPrice(row.balance)}</div>
          </div>
        </div>
      `).join('');

      document.getElementById('overviewWalletList').innerHTML = rows || `<div class="empty">No wallet data loaded.</div>`;
    }

    function copyCardHtml(p) {
      const pnl = Number(p.pnl || p.manualPnl || 0);
      const roi = Number(p.roi || p.manualRoi || 0);
      const col = pnl >= 0 ? 'green' : 'red';
      const statusBadge = p.status === 'active' ? 'green' : 'yellow';

      return `
        <div class="card">
          <div class="card-top">
            <div class="token-row">
              <div class="token-icon">${iconLibrary[32][1]}</div>
              <div>
                <div class="token-title">${escapeHtml(p.name || 'Copy Profile')}</div>
                <div class="token-sub">${escapeHtml(p.tag || 'Public strategy')} • ${escapeHtml(p.risk || 'Medium')} risk</div>
              </div>
            </div>
            <span class="badge ${statusBadge}">${escapeHtml(p.status || 'active')}</span>
          </div>

          <div class="metric-grid">
            <div class="metric"><div class="metric-label">ROI</div><div class="metric-value ${roi >= 0 ? 'text-green' : 'text-red'}">${roi >= 0 ? '+' : ''}${formatMoney(roi)}%</div></div>
            <div class="metric"><div class="metric-label">PNL</div><div class="metric-value ${pnl >= 0 ? 'text-green' : 'text-red'}">${pnl >= 0 ? '+' : '-'}$${formatMoney(Math.abs(pnl))}</div></div>
            <div class="metric"><div class="metric-label">Min Copy</div><div class="metric-value">$${formatMoney(p.minCopyUsdt || 50, 0)}</div></div>
            <div class="metric"><div class="metric-label">Followers</div><div class="metric-value">${formatMoney(p.followers || 0, 0)}</div></div>
          </div>

          <div class="card-actions">
            <button class="mini-btn" onclick="fillCopyForm('${escapeHtml(p.id || p.publicId || '')}')">Edit</button>
            ${p.shareUrl ? `<button class="mini-btn" onclick="copyText('${escapeHtml(p.shareUrl)}')">Copy Link</button>` : ''}
            <button class="danger-btn" onclick="deleteCopyProfile('${escapeHtml(p.id || p.publicId || '')}')">Delete</button>
          </div>
        </div>
      `;
    }

    function renderCopyProfiles() {
      document.getElementById('copyProfilesList').innerHTML = copyProfiles.map(copyCardHtml).join('') || `<div class="empty">No copy profiles. Create one.</div>`;
    }

    function tokenCardHtml(t) {
      const stable = t.stableCoin || t.stable || t.bias === 'pegged';
      const moveMin = Number(t.minPct || 0) * 100;
      const moveMax = Number(t.maxPct || 0) * 100;

      return `
        <div class="card">
          <div class="card-top">
            <div class="token-row">
              <div class="token-icon">${getIconHtml(t.iconSvg || t.iconId || t.icon)}</div>
              <div>
                <div class="token-title">${escapeHtml(t.symbol || 'TENSOR')} / USDT</div>
                <div class="token-sub">${escapeHtml(t.name || 'Tensor Asset')}</div>
              </div>
            </div>
            <span class="badge ${stable ? 'green' : 'purple'}">${stable ? 'Stable' : escapeHtml(t.bias || 'balanced')}</span>
          </div>

          <div class="metric-grid">
            <div class="metric"><div class="metric-label">Price</div><div class="metric-value">$${formatPrice(t.price || 0)}</div></div>
            <div class="metric"><div class="metric-label">Supply</div><div class="metric-value">${formatMoney(t.supply || 0, 0)}</div></div>
            <div class="metric"><div class="metric-label">Move</div><div class="metric-value">${formatMoney(moveMin, 0)}-${formatMoney(moveMax, 0)}%</div></div>
            <div class="metric"><div class="metric-label">Cap</div><div class="metric-value">$${formatMoney(t.marketCap || 0, 0)}</div></div>
          </div>

          <div class="small-note" style="margin-top:10px;">
            Bull zone: ${escapeHtml(t.bullZoneMin ?? '—')} → ${escapeHtml(t.bullZoneMax ?? '—')} • Bear zone: ${escapeHtml(t.bearZoneMin ?? '—')} → ${escapeHtml(t.bearZoneMax ?? '—')}
          </div>

          <div class="card-actions">
            <button class="mini-btn" onclick="fillTokenForm('${escapeHtml(t.id || '')}')">Edit</button>
            <button class="danger-btn" onclick="deleteToken('${escapeHtml(t.id || '')}')">Delete</button>
          </div>
        </div>
      `;
    }

    function renderTokens() {
      document.getElementById('tokenList').innerHTML = tokens.map(tokenCardHtml).join('') || `<div class="empty">No Tensor tokens. Create one.</div>`;
    }

    function getWalletRows(wallet) {
      const rows = cryptoAssets.map(symbol => {
        const field = symbol === 'USDT'
          ? 'usdtBalance'
          : symbol === 'OUSD'
            ? 'ousdBalance'
            : `${symbol.toLowerCase()}Balance`;

        return {
          symbol,
          type: 'Crypto',
          balance: Number(wallet[field] || 0),
          id: symbol
        };
      });

      tokens.forEach(t => {
        rows.push({
          symbol: t.symbol || t.id,
          type: 'Tensor',
          balance: Number(wallet.tensorBalances?.[t.id] || 0),
          id: t.id
        });
      });

      return rows;
    }

    function renderWallet() {
      const rows = getWalletRows(adminWallet);

      document.getElementById('adminWalletList').innerHTML = rows.map(row => `
        <div class="card">
          <div class="card-top">
            <div class="token-row">
              <div class="token-icon">${row.type === 'Tensor' ? iconLibrary[0][1] : iconLibrary[37][1]}</div>
              <div>
                <div class="token-title">${escapeHtml(row.symbol)}</div>
                <div class="token-sub">${escapeHtml(row.type)} wallet balance</div>
              </div>
            </div>
            <span class="badge ${row.balance >= 0 ? 'green' : 'red'}">${formatPrice(row.balance)}</span>
          </div>
        </div>
      `).join('');
    }

    function renderAdminAssetSelect() {
      const type = document.getElementById('adminWalletType')?.value || 'crypto';
      const select = document.getElementById('adminWalletAsset');
      if (!select) return;

      if (type === 'tensor') {
        select.innerHTML = tokens.map(t => `<option value="${escapeHtml(t.id)}">${escapeHtml(t.symbol || t.id)} - ${escapeHtml(t.name || '')}</option>`).join('');
      } else {
        select.innerHTML = cryptoAssets.map(a => `<option value="${a}">${a}</option>`).join('');
      }
    }

    function renderUserAssetSelect() {
      const type = document.getElementById('userWalletType')?.value || 'crypto';
      const select = document.getElementById('userWalletAsset');
      if (!select) return;

      if (type === 'tensor') {
        select.innerHTML = tokens.map(t => `<option value="${escapeHtml(t.id)}">${escapeHtml(t.symbol || t.id)} - ${escapeHtml(t.name || '')}</option>`).join('');
      } else {
        select.innerHTML = cryptoAssets.map(a => `<option value="${a}">${a}</option>`).join('');
      }
    }

    function renderUsers() {
      const q = String(document.getElementById('userSearch')?.value || '').toLowerCase();
      const filtered = users.filter(u => {
        const text = JSON.stringify(u || {}).toLowerCase();
        return !q || text.includes(q);
      });

      document.getElementById('usersList').innerHTML = filtered.map(u => `
        <div class="card ${selectedUser && selectedUser.email === u.email ? 'active' : ''}">
          <div class="card-top">
            <div>
              <div class="token-title">${escapeHtml(u.email || 'unknown')}</div>
              <div class="token-sub">${escapeHtml(u.id || '')} • ${escapeHtml(u.role || 'user')}</div>
            </div>
            <span class="badge ${u.role === 'staff' ? 'purple' : 'green'}">${escapeHtml(u.role || 'user')}</span>
          </div>
          <div class="metric-grid">
            <div class="metric"><div class="metric-label">USDT</div><div class="metric-value">$${formatMoney(u.usdtBalance || 0)}</div></div>
            <div class="metric"><div class="metric-label">OUSD</div><div class="metric-value">$${formatMoney(u.ousdBalance || 0)}</div></div>
            <div class="metric"><div class="metric-label">Trades</div><div class="metric-value">${Array.isArray(u.positions) ? u.positions.length : 0}</div></div>
            <div class="metric"><div class="metric-label">Copy</div><div class="metric-value">${Array.isArray(u.copyTrades) ? u.copyTrades.length : 0}</div></div>
          </div>
          <div class="card-actions">
            <button class="mini-btn" onclick="selectUser('${escapeHtml(u.email || '')}')">Select</button>
          </div>
        </div>
      `).join('') || `<div class="empty">No users loaded. Make sure /api/admin/users exists.</div>`;
    }

    function selectUser(email) {
      selectedUser = users.find(u => String(u.email) === String(email)) || null;
      document.getElementById('selectedUserEmail').value = selectedUser ? selectedUser.email : '';
      renderUsers();
    }

    function clearTokenForm() {
      document.getElementById('tokenId').value = '';
      document.getElementById('tokenName').value = '';
      document.getElementById('tokenSymbol').value = '';
      document.getElementById('tokenPrice').value = '';
      document.getElementById('tokenSupply').value = '';
      document.getElementById('tokenStable').value = 'false';
      document.getElementById('tokenVolatilityMode').value = 'medium';
      document.getElementById('tokenMoveEverySec').value = '3';
      document.getElementById('tokenBias').value = 'balanced';
      document.getElementById('tokenMinMovePct').value = '1';
      document.getElementById('tokenMaxMovePct').value = '5';
      document.getElementById('tokenBullMin').value = '';
      document.getElementById('tokenBullMax').value = '';
      document.getElementById('tokenBearMin').value = '';
      document.getElementById('tokenBearMax').value = '';
      selectedIconId = 'icon-ai';
      selectIcon(selectedIconId);
      syncRangeLabels();
    }

    function fillTokenForm(id) {
      const t = tokens.find(x => String(x.id) === String(id));
      if (!t) return showToast('Token not found');

      switchSectionByName('tokens');

      document.getElementById('tokenId').value = t.id || '';
      document.getElementById('tokenName').value = t.name || '';
      document.getElementById('tokenSymbol').value = t.symbol || '';
      document.getElementById('tokenPrice').value = t.price || '';
      document.getElementById('tokenSupply').value = t.supply || '';
      document.getElementById('tokenStable').value = (t.stableCoin || t.stable || t.bias === 'pegged') ? 'true' : 'false';
      document.getElementById('tokenVolatilityMode').value = t.volatilityMode || 'medium';
      document.getElementById('tokenMoveEverySec').value = t.moveEverySec || 3;
      document.getElementById('tokenBias').value = t.bias || 'balanced';

      const minPct = Math.max(1, Math.min(50, Math.round(Number(t.minPct || 0.01) * 100)));
      const maxPct = Math.max(1, Math.min(50, Math.round(Number(t.maxPct || 0.05) * 100)));

      document.getElementById('tokenMinMovePct').value = minPct;
      document.getElementById('tokenMaxMovePct').value = maxPct;

      document.getElementById('tokenBullMin').value = t.bullZoneMin ?? '';
      document.getElementById('tokenBullMax').value = t.bullZoneMax ?? '';
      document.getElementById('tokenBearMin').value = t.bearZoneMin ?? '';
      document.getElementById('tokenBearMax').value = t.bearZoneMax ?? '';

      document.getElementById('tokenIcon').value = t.iconSvg || t.iconId || t.icon || '';

      const found = iconLibrary.find(x => x[1] === t.iconSvg || x[0] === t.iconId || x[0] === t.icon);
      selectedIconId = found ? found[0] : 'icon-ai';

      syncRangeLabels();
      renderIconGrid();
    }

    async function saveToken(event) {
      event.preventDefault();

      const id = document.getElementById('tokenId').value.trim();
      const stableCoin = document.getElementById('tokenStable').value === 'true';
      const minMove = Math.max(1, Math.min(50, Number(document.getElementById('tokenMinMovePct').value) || 1));
      const maxMove = Math.max(minMove, Math.min(50, Number(document.getElementById('tokenMaxMovePct').value) || minMove));

      const payload = {
        name: document.getElementById('tokenName').value.trim(),
        symbol: document.getElementById('tokenSymbol').value.trim().toUpperCase(),
        price: Number(document.getElementById('tokenPrice').value || 0),
        startPrice: Number(document.getElementById('tokenPrice').value || 0),
        supply: Number(document.getElementById('tokenSupply').value || 0),
        stableCoin,
        stable,
        bias: stableCoin ? 'pegged' : document.getElementById('tokenBias').value,
        volatilityMode: document.getElementById('tokenVolatilityMode').value,
        moveEverySec: Number(document.getElementById('tokenMoveEverySec').value || 3),
        minPct: minMove,
        maxPct: maxMove,
        bullZoneMin: Number(document.getElementById('tokenBullMin').value || 0),
        bullZoneMax: Number(document.getElementById('tokenBullMax').value || 0),
        bearZoneMin: Number(document.getElementById('tokenBearMin').value || 0),
        bearZoneMax: Number(document.getElementById('tokenBearMax').value || 0),
        icon: selectedIconId,
        iconId: selectedIconId,
        iconSvg: document.getElementById('tokenIcon').value
      };

      if (!payload.name || !payload.symbol || payload.price <= 0 || payload.supply <= 0) {
        return showToast('Fill name, symbol, price, and supply');
      }

      const result = id
        ? await apiTry(apiBaseCandidates('tokenUpdate')(id), { method: 'PUT', body: payload })
        : await apiTry(apiBaseCandidates('tokenCreate'), { method: 'POST', body: payload });

      if (!result.ok) return showToast(result.error || 'Token save failed');

      showToast(id ? 'Token updated' : 'Token created');
      await loadTokens();
      renderAll();
    }

    async function deleteSelectedToken() {
      const id = document.getElementById('tokenId').value.trim();
      if (!id) return showToast('Select a token first');
      await deleteToken(id);
    }

    async function deleteToken(id) {
      if (!id) return;
      if (!confirm('Delete this Tensor token? This can remove user balances/positions depending on your backend.')) return;

      const result = await apiTry(apiBaseCandidates('tokenDelete')(id), { method: 'DELETE' });

      if (!result.ok) return showToast(result.error || 'Delete failed');

      showToast('Token deleted');
      clearTokenForm();
      await loadTokens();
      renderAll();
    }

    function clearCopyForm() {
      document.getElementById('copyProfileId').value = '';
      document.getElementById('copyName').value = '';
      document.getElementById('copyTag').value = '';
      document.getElementById('copyDescription').value = '';
      document.getElementById('copyManualRoi').value = '0';
      document.getElementById('copyManualPnl').value = '0';
      document.getElementById('copyDaysTrading').value = '1';
      document.getElementById('copyMinCopy').value = '50';
      document.getElementById('copyRisk').value = 'Medium';
      document.getElementById('copyStatus').value = 'active';
      document.getElementById('copyPositionSource').value = 'admin_live';
      document.getElementById('copyPositionsJson').value = '';
    }

    function fillCopyForm(id) {
      const p = copyProfiles.find(x => String(x.id || x.publicId) === String(id));
      if (!p) return showToast('Copy profile not found');

      switchSectionByName('copy');

      document.getElementById('copyProfileId').value = p.id || p.publicId || '';
      document.getElementById('copyName').value = p.name || '';
      document.getElementById('copyTag').value = p.tag || '';
      document.getElementById('copyDescription').value = p.description || '';
      document.getElementById('copyManualRoi').value = p.manualRoi ?? p.roi ?? 0;
      document.getElementById('copyManualPnl').value = p.manualPnl ?? p.pnl ?? 0;
      document.getElementById('copyDaysTrading').value = p.daysTrading ?? 1;
      document.getElementById('copyMinCopy').value = p.minCopyUsdt ?? 50;
      document.getElementById('copyRisk').value = p.risk || 'Medium';
      document.getElementById('copyStatus').value = p.status || 'active';
      document.getElementById('copyPositionSource').value = p.positionSource || 'admin_live';
      document.getElementById('copyPositionsJson').value = p.positions ? JSON.stringify(p.positions, null, 2) : '';
    }

    async function saveCopyProfile(event) {
      event.preventDefault();

      const id = document.getElementById('copyProfileId').value.trim();
      let positions = [];

      if (document.getElementById('copyPositionSource').value === 'manual') {
        try {
          positions = JSON.parse(document.getElementById('copyPositionsJson').value || '[]');
          if (!Array.isArray(positions)) positions = [];
        } catch {
          return showToast('Positions JSON is invalid');
        }
      }

      const payload = {
        name: document.getElementById('copyName').value.trim(),
        tag: document.getElementById('copyTag').value.trim(),
        description: document.getElementById('copyDescription').value.trim(),
        manualRoi: Number(document.getElementById('copyManualRoi').value || 0),
        manualPnl: Number(document.getElementById('copyManualPnl').value || 0),
        roi: Number(document.getElementById('copyManualRoi').value || 0),
        pnl: Number(document.getElementById('copyManualPnl').value || 0),
        daysTrading: Number(document.getElementById('copyDaysTrading').value || 0),
        minCopyUsdt: Number(document.getElementById('copyMinCopy').value || 50),
        risk: document.getElementById('copyRisk').value,
        status: document.getElementById('copyStatus').value,
        positionSource: document.getElementById('copyPositionSource').value,
        positions
      };

      if (!payload.name) return showToast('Profile name is required');

      const result = id
        ? await apiTry(apiBaseCandidates('copyUpdate')(id), { method: 'PUT', body: payload })
        : await apiTry(apiBaseCandidates('copyCreate'), { method: 'POST', body: payload });

      if (!result.ok) return showToast(result.error || 'Copy profile save failed');

      showToast(id ? 'Copy profile updated' : 'Copy profile created');
      await loadCopyProfiles();
      renderAll();
    }

    async function deleteSelectedCopyProfile() {
      const id = document.getElementById('copyProfileId').value.trim();
      if (!id) return showToast('Select a copy profile first');
      await deleteCopyProfile(id);
    }

    async function deleteCopyProfile(id) {
      if (!id) return;
      if (!confirm('Delete this copy trading profile?')) return;

      const result = await apiTry(apiBaseCandidates('copyDelete')(id), { method: 'DELETE' });

      if (!result.ok) return showToast(result.error || 'Delete failed');

      showToast('Copy profile deleted');
      clearCopyForm();
      await loadCopyProfiles();
      renderAll();
    }

    async function adjustAdminWallet(event) {
      event.preventDefault();

      const payload = {
        targetEmail: 'admin@tensorwallet.local',
        walletType: document.getElementById('adminWalletType').value,
        asset: document.getElementById('adminWalletAsset').value,
        amount: Number(document.getElementById('adminWalletAmount').value || 0),
        reason: document.getElementById('adminWalletReason').value || 'Manual admin wallet adjustment'
      };

      if (!payload.asset || !payload.amount) return showToast('Choose asset and amount');

      const result = await apiTry(apiBaseCandidates('adminWalletAdjust'), {
        method: 'POST',
        body: payload
      });

      if (!result.ok) return showToast(result.error || 'Admin wallet edit failed');

      showToast('Admin wallet updated');
      document.getElementById('adminWalletAmount').value = '';
      await loadAdminWallet();
      renderAll();
    }

    async function adjustUserWallet(event) {
      event.preventDefault();

      const email = document.getElementById('selectedUserEmail').value.trim();
      if (!email) return showToast('Select a user first');

      const payload = {
        targetEmail: email,
        walletType: document.getElementById('userWalletType').value,
        asset: document.getElementById('userWalletAsset').value,
        amount: Number(document.getElementById('userWalletAmount').value || 0),
        reason: document.getElementById('userWalletReason').value || 'Manual user wallet adjustment'
      };

      if (!payload.asset || !payload.amount) return showToast('Choose asset and amount');

      const result = await apiTry(apiBaseCandidates('userAdjust'), {
        method: 'POST',
        body: payload
      });

      if (!result.ok) return showToast(result.error || 'User wallet edit failed');

      showToast('User wallet updated');
      document.getElementById('userWalletAmount').value = '';
      await loadUsers();
      await loadAdminWallet();
      renderAll();
    }

    async function resetSelectedUserWallet() {
      const email = document.getElementById('selectedUserEmail').value.trim();
      if (!email) return showToast('Select a user first');
      if (!confirm(`Reset wallet for ${email}?`)) return;

      const result = await apiTry(apiBaseCandidates('userReset'), {
        method: 'POST',
        body: { targetEmail: email }
      });

      if (!result.ok) return showToast(result.error || 'Reset failed');

      showToast('User wallet reset');
      await loadUsers();
      renderAll();
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        showToast('Copied');
      } catch {
        prompt('Copy:', text);
      }
    }

    async function boot() {
      document.documentElement.setAttribute('data-theme', currentTheme);

      if (!isAdmin()) {
        document.getElementById('adminDenied').style.display = 'grid';
        document.getElementById('adminApp').classList.add('hidden');
        return;
      }

      document.getElementById('adminDenied').style.display = 'none';
      document.getElementById('adminApp').classList.remove('hidden');

      renderIconGrid();
      clearTokenForm();
      clearCopyForm();

      await refreshAll();
    }

    window.addEventListener('load', boot);
  </script>
</body>
</html>