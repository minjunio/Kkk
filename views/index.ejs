    function bytesToBase64(bytes) {
      return btoa(String.fromCharCode(...new Uint8Array(bytes)));
    }

    function base64ToBytes(base64) {
      return Uint8Array.from(atob(base64),c => c.charCodeAt(0));
    }

    async function getOrCreateDeviceKey() {
      let key = localStorage.getItem(`blue_device_key_${CURRENT_EMAIL}`);

      if (!key) {
        const bytes = crypto.getRandomValues(new Uint8Array(32));
        key = bytesToBase64(bytes);
        localStorage.setItem(`blue_device_key_${CURRENT_EMAIL}`,key);
      }

      return key;
    }

    async function deriveAesKey(secret,saltBase64) {
      const salt = base64ToBytes(saltBase64);
      const keyMaterial = await crypto.subtle.importKey('raw',new TextEncoder().encode(secret),'PBKDF2',false,['deriveKey']);

      return crypto.subtle.deriveKey(
        {name:'PBKDF2',salt,iterations:250000,hash:'SHA-256'},
        keyMaterial,
        {name:'AES-GCM',length:256},
        false,
        ['encrypt','decrypt']
      );
    }

    async function encryptVault(vaultObject,secret) {
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const saltBase64 = bytesToBase64(salt);
      const key = await deriveAesKey(secret,saltBase64);
      const encrypted = await crypto.subtle.encrypt({name:'AES-GCM',iv},key,new TextEncoder().encode(JSON.stringify(vaultObject)));

      return {
        version:1,
        encryptionMode:'device-key',
        kdf:'PBKDF2-SHA256',
        cipher:'AES-GCM',
        iterations:250000,
        salt:saltBase64,
        iv:bytesToBase64(iv),
        data:bytesToBase64(encrypted)
      };
    }

    async function decryptVault(encryptedVault,secret) {
      const key = await deriveAesKey(secret,encryptedVault.salt);
      const iv = base64ToBytes(encryptedVault.iv);
      const encryptedData = base64ToBytes(encryptedVault.data);
      const decrypted = await crypto.subtle.decrypt({name:'AES-GCM',iv},key,encryptedData);
      return JSON.parse(new TextDecoder().decode(decrypted));
    }

    function generateWallet() {
      const wallet = ethers.Wallet.createRandom();

      return {
        type:'evm',
        phrase:wallet.mnemonic.phrase,
        privateKey:wallet.privateKey,
        address:wallet.address,
        createdAt:new Date().toISOString()
      };
    }

    async function saveVault(encryptedVault,publicWallets) {
      const res = await fetch('/api/wallet/vault',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({encryptedVault,publicWallets})
      });

      if (!res.ok) throw new Error('Could not save wallet vault');
      return res.json();
    }

    async function createWalletNoPin() {
      try {
        if (SERVER_WALLET?.encryptedVault || getPublicWallet()) return await unlockDeviceWallet();

        const real = generateWallet();
        const vault = {wallets:[real],createdAt:new Date().toISOString(),encryptionMode:'device-key'};
        const deviceKey = await getOrCreateDeviceKey();
        const secret = `${CURRENT_EMAIL}:${deviceKey}`;
        const encryptedVault = await encryptVault(vault,secret);

        const publicWallets = [{
          type:'evm',
          address:real.address,
          networks:Object.values(NETWORKS).map(n => n.name),
          createdAt:real.createdAt
        }];

        await saveVault(encryptedVault,publicWallets);
        localStorage.setItem('bluecrypto_public_wallets',JSON.stringify(publicWallets));

        ACTIVE_DECRYPTED_WALLET = vault;
        activeProvider = provider(activeNetworkKey);
        activeSigner = new ethers.Wallet(real.privateKey,activeProvider);

        updateUi();
        refreshAllBalances(true);
        return vault;
      } catch (err) {
        console.error(err);
        toast(err.message || 'Wallet creation failed');
        return null;
      }
    }

    async function unlockDeviceWallet() {
      try {
        if (!SERVER_WALLET?.encryptedVault) return await createWalletNoPin();

        const deviceKey = localStorage.getItem(`blue_device_key_${CURRENT_EMAIL}`);
        if (!deviceKey) {
          toast('This browser cannot decrypt the saved wallet.');
          return null;
        }

        const secret = `${CURRENT_EMAIL}:${deviceKey}`;
        ACTIVE_DECRYPTED_WALLET = await decryptVault(SERVER_WALLET.encryptedVault,secret);

        activeProvider = provider(activeNetworkKey);
        activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey,activeProvider);

        updateUi();
        return ACTIVE_DECRYPTED_WALLET;
      } catch (err) {
        console.error(err);
        toast('Could not load wallet');
        return null;
      }
    }

    async function ensureUnlocked() {
      if (activeSigner) return activeSigner;
      const wallet = await unlockDeviceWallet();
      if (!wallet) throw new Error('Wallet not available');
      return activeSigner;
    }

    function normalizeRawSymbol(symbol) {
      if (symbol === 'WETH') return 'ETH';
      if (symbol === 'WBNB') return 'BNB';
      if (symbol === 'WMATIC') return 'MATIC';
      if (symbol === 'WAVAX') return 'AVAX';
      return symbol;
    }

    function binanceForSymbol(symbol) {
      const pair = BINANCE_SYMBOLS[normalizeRawSymbol(symbol)];
      return pair ? binancePrices[pair] : null;
    }

    async function fetchPricesForAll() {
      const ids = new Set();

      for (const key of Object.keys(NETWORKS)) {
        ids.add(NATIVE_GECKO[key]);

        for (const token of ERC20_TOKENS[key] || []) {
          if (token.gecko) ids.add(token.gecko);
        }
      }

      for (const watch of WATCH_ASSETS) ids.add(watch.gecko);

      const geckoIds = [...ids];
      const symbols = Object.values(BINANCE_SYMBOLS);

      const binancePromise = fetch(`/api/binance-prices?symbols=${encodeURIComponent(symbols.join(','))}`,{cache:'no-store'})
        .then(r => r.ok ? r.json() : {})
        .catch(() => ({}));

      const geckoPromise = fetch(`/api/prices?ids=${encodeURIComponent(geckoIds.join(','))}`,{cache:'no-store'})
        .then(r => r.ok ? r.json() : {})
        .catch(() => ({}));

      const metaPromise = fetch(`/api/market-meta?ids=${encodeURIComponent(geckoIds.join(','))}`,{cache:'no-store'})
        .then(r => r.ok ? r.json() : {})
        .catch(() => ({}));

      const [bp,gp,meta] = await Promise.all([binancePromise,geckoPromise,metaPromise]);

      binancePrices = bp || {};
      prices = gp || {};
      marketMeta = meta || {};
    }

    function priceFor(asset) {
      const b = binanceForSymbol(asset.symbol);
      if (b?.lastPrice) return Number(b.lastPrice);

      if (asset.type === 'native') return prices[NATIVE_GECKO[asset.networkKey]]?.usd || 0;
      return prices[asset