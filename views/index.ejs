    function money(value) {
      const cfg = DISPLAY_RATES[displayCurrency] || DISPLAY_RATES.USD;
      const converted = Number(value || 0) * cfg.rate;
      return `${cfg.symbol}${converted.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`;
    }

    function compactMoney(value) {
      const cfg = DISPLAY_RATES[displayCurrency] || DISPLAY_RATES.USD;
      const converted = Number(value || 0) * cfg.rate;

      if (converted >= 1_000_000_000_000) return `${cfg.symbol}${(converted / 1_000_000_000_000).toFixed(2)}T`;
      if (converted >= 1_000_000_000) return `${cfg.symbol}${(converted / 1_000_000_000).toFixed(2)}B`;
      if (converted >= 1_000_000) return `${cfg.symbol}${(converted / 1_000_000).toFixed(2)}M`;
      if (converted >= 1_000) return `${cfg.symbol}${(converted / 1_000).toFixed(2)}K`;

      return money(value);
    }

