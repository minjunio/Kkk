<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>BlueCrypto Login</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg1: #eaf8ff;
      --bg2: #f8fcff;
      --bg3: #d7efff;
      --panel: rgba(255, 255, 255, 0.9);
      --soft: #f0f7ff;
      --text: #0f172a;
      --muted: #64748b;
      --blue: #0284c7;
      --blue2: #2563eb;
      --cyan: #38bdf8;
      --red: #e11d48;
      --green: #16a34a;
      --border: rgba(15, 23, 42, 0.08);
      --shadow: 0 24px 64px rgba(37, 99, 235, 0.12);
      --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: Inter, sans-serif; }
    
    body {
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at 10% 0%, rgba(56, 189, 248, 0.25), transparent 35%),
        radial-gradient(circle at 90% 15%, rgba(37, 99, 235, 0.15), transparent 30%),
        radial-gradient(circle at 50% 100%, rgba(14, 165, 233, 0.2), transparent 40%),
        linear-gradient(135deg, var(--bg1), var(--bg2) 50%, var(--bg3));
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
    }

    .card {
      width: 100%;
      max-width: 420px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 32px;
      padding: 32px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(24px);
    }

    .header { text-align: center; margin-bottom: 24px; }
    .logo {
      width: 56px; height: 56px; margin: 0 auto 16px;
      background: linear-gradient(135deg, var(--blue2), var(--cyan));
      border-radius: 20px; display: grid; place-items: center;
      color: white; font-size: 1.5rem; font-weight: 900;
      box-shadow: 0 12px 28px rgba(37, 99, 235, 0.25);
    }
    .title { font-size: 1.4rem; font-weight: 900; letter-spacing: -0.04em; }
    .subtitle { color: var(--muted); font-size: 0.85rem; font-weight: 600; margin-top: 4px; }

    .tabs {
      display: flex; gap: 8px; background: var(--soft);
      padding: 6px; border-radius: 20px; margin-bottom: 24px; border: 1px solid var(--border);
    }
    .tab {
      flex: 1; min-height: 42px; border-radius: 14px; border: none;
      background: transparent; color: var(--muted); font-weight: 800;
      font-size: 0.85rem; cursor: pointer; transition: 0.2s;
    }
    .tab.active {
      background: white; color: var(--blue2); box-shadow: var(--shadow-sm);
    }

    .panel { display: none; animation: fadeIn 0.3s ease; }
    .panel.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

    .form-group { margin-bottom: 16px; }
    label { display: block; font-size: 0.75rem; font-weight: 800; color: var(--muted); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.05em; }
    
    .input {
      width: 100%; min-height: 54px; padding: 0 16px; border-radius: 18px;
      background: var(--soft); border: 1px solid var(--border);
      font-size: 0.95rem; font-weight: 600; color: var(--text); outline: none; transition: 0.2s;
    }
    .input:focus { border-color: var(--cyan); box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.1); }

    .btn {
      width: 100%; min-height: 54px; border-radius: 18px; border: none;
      background: linear-gradient(135deg, var(--blue2), var(--cyan));
      color: white; font-size: 0.95rem; font-weight: 800; cursor: pointer;
      box-shadow: 0 12px 24px rgba(37, 99, 235, 0.2); transition: transform 0.1s;
    }
    .btn:active { transform: scale(0.98); }
    .btn:disabled { opacity: 0.7; cursor: not-allowed; }

    .alert {
      padding: 12px 16px; border-radius: 16px; font-size: 0.85rem; font-weight: 700; margin-bottom: 20px;
    }
    .alert.error { background: rgba(225, 29, 72, 0.08); color: var(--red); border: 1px solid rgba(225, 29, 72, 0.2); }
    .alert.success { background: rgba(22, 163, 74, 0.08); color: var(--green); border: 1px solid rgba(22, 163, 74, 0.2); }

    .footer-text { text-align: center; color: var(--muted); font-size: 0.75rem; font-weight: 600; margin-top: 20px; line-height: 1.5; }
  </style>
</head>
<body>

  <div class="card">
    <div class="header">
      <div class="logo">B</div>
      <div class="title">BlueCrypto</div>
      <div class="subtitle">Secure Web3 Access</div>
    </div>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><%= success %></div><% } %>

    <div class="tabs">
      <button class="tab active" id="tab-user" onclick="switchTab('user')">User Login</button>
      <button class="tab" id="tab-admin" onclick="switchTab('admin')">Staff Login</button>
    </div>

    <div class="panel active" id="panel-user">
      <% if (!otpEmail) { %>
        <form action="/send-otp" method="POST">
          <div class="form-group">
            <label>Email Address</label>
            <input class="input" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
          </div>
          <button class="btn" type="submit">Send Login Code</button>
        </form>
        <div class="footer-text">New wallets are generated automatically upon first login. Returning users will load their existing wallet.</div>
      <% } else { %>
        <form action="/verify-otp" method="POST">
          <input type="hidden" name="email" value="<%= otpEmail %>" />
          <div class="form-group">
            <label>6-Digit Code for <%= otpEmail %></label>
            <input class="input" type="text" name="otp" inputmode="numeric" maxlength="6" placeholder="123456" required autocomplete="one-time-code" autofocus />
          </div>
          <button class="btn" type="submit">Verify & Access Wallet</button>
        </form>
        <div class="footer-text">Check your inbox and spam folder for the code. It expires in 10 minutes.</div>
      <% } %>
    </div>

    <div class="panel" id="panel-admin">
      <form action="/staff-login" method="POST">
        <div class="form-group">
          <label>Username</label>
          <input class="input" type="text" name="username" placeholder="admin" required autocomplete="username" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input class="input" type="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
        </div>
        <button class="btn" type="submit">Staff Login</button>
      </form>
      <div class="footer-text">Staff logins automatically generate a fresh, temporary wallet session for testing purposes.</div>
    </div>
  </div>

  <script>
    function switchTab(target) {
      document.getElementById('tab-user').classList.remove('active');
      document.getElementById('tab-admin').classList.remove('active');
      document.getElementById('panel-user').classList.remove('active');
      document.getElementById('panel-admin').classList.remove('active');
      
      document.getElementById('tab-' + target).classList.add('active');
      document.getElementById('panel-' + target).classList.add('active');
    }
  </script>
</body>
</html>
