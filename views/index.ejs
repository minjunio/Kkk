<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Blue Wallet Login</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #f4f9ff;
      --card: #ffffff;
      --card2: #f8fbff;
      --text: #0f172a;
      --muted: #64748b;
      --border: rgba(15, 23, 42, 0.08);
      --blue: #0284c7;
      --blue2: #2563eb;
      --green: #16a34a;
      --red: #e11d48;
      --shadow: 0 24px 70px rgba(15, 23, 42, 0.1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body {
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(2, 132, 199, 0.12), transparent 30%),
        radial-gradient(circle at bottom right, rgba(22, 163, 74, 0.08), transparent 25%),
        linear-gradient(135deg, #f4f9ff, #e8f3ff);
      padding: 18px;
    }

    .topbar {
      width: min(980px, 100%);
      margin: 0 auto 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: white;
      font-weight: 950;
      background: linear-gradient(135deg, var(--blue2), #38bdf8);
      box-shadow: 0 12px 28px rgba(37, 99, 235, 0.2);
    }

    .brand h1 {
      font-size: 1rem;
      font-weight: 950;
      letter-spacing: -0.04em;
    }

    .brand p {
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 700;
    }

    .staff-btn {
      height: 42px;
      padding: 0 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: white;
      color: var(--text);
      font-weight: 850;
      cursor: pointer;
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
    }

    .wrap {
      width: min(980px, 100%);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 430px 1fr;
      gap: 18px;
      align-items: start;
    }

    .card {
      background: rgba(255, 255, 255, 0.94);
      border: 1px solid var(--border);
      border-radius: 28px;
      box-shadow: var(--shadow);
      padding: 22px;
      backdrop-filter: blur(16px);
    }

    .login-card {
      order: 1;
    }

    .info-card {
      order: 2;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      background: rgba(2, 132, 199, 0.08);
      border: 1px solid rgba(2, 132, 199, 0.22);
      color: var(--blue);
      font-size: 0.76rem;
      font-weight: 950;
      margin-bottom: 14px;
    }

    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--blue);
    }

    .title {
      font-size: 1.45rem;
      font-weight: 950;
      letter-spacing: -0.06em;
      margin-bottom: 7px;
    }

    .subtitle {
      color: var(--muted);
      font-size: 0.88rem;
      font-weight: 650;
      line-height: 1.55;
      margin-bottom: 18px;
    }

    .form-group {
      display: grid;
      gap: 8px;
      margin-bottom: 13px;
    }

    label {
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    input {
      width: 100%;
      min-height: 50px;
      padding: 13px 14px;
      border-radius: 16px;
      background: var(--card2);
      border: 1px solid var(--border);
      color: var(--text);
      outline: none;
      font-weight: 800;
      font-size: 0.95rem;
    }

    input:focus {
      border-color: rgba(2, 132, 199, 0.35);
      box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.08);
    }

    .btn {
      width: 100%;
      min-height: 50px;
      border: 0;
      border-radius: 16px;
      font-weight: 950;
      cursor: pointer;
    }

    .primary {
      background: linear-gradient(135deg, var(--blue2), var(--blue));
      color: white;
      box-shadow: 0 14px 32px rgba(37, 99, 235, 0.18);
    }

    .secondary {
      background: var(--card2);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .msg {
      padding: 12px;
      border-radius: 15px;
      font-size: 0.84rem;
      font-weight: 800;
      line-height: 1.45;
      margin-bottom: 13px;
    }

    .error {
      background: rgba(225, 29, 72, 0.08);
      color: var(--red);
    }

    .success {
      background: rgba(22, 163, 74, 0.09);
      color: var(--green);
      display: flex;
      gap: 9px;
      align-items: flex-start;
    }

    .check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--green);
      color: white;
      display: inline-grid;
      place-items: center;
      flex: 0 0 auto;
      font-size: 0.82rem;
      font-weight: 950;
    }

    .hint {
      background: rgba(2, 132, 199, 0.08);
      color: var(--blue);
    }

    .resend {
      margin-top: 10px;
    }

    .security-list {
      display: grid;
      gap: 10px;
      margin-top: 14px;
    }

    .security-item {
      padding: 13px;
      border-radius: 18px;
      background: var(--card2);
      border: 1px solid var(--border);
    }

    .security-item strong {
      display: block;
      font-size: 0.9rem;
      font-weight: 950;
      margin-bottom: 4px;
    }

    .security-item span {
      color: var(--muted);
      font-size: 0.8rem;
      font-weight: 650;
      line-height: 1.5;
    }

    .small {
      margin-top: 12px;
      color: var(--muted);
      text-align: center;
      font-size: 0.76rem;
      font-weight: 700;
      line-height: 1.5;
    }

    .modal {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: none;
      place-items: center;
      background: rgba(15, 23, 42, 0.42);
      backdrop-filter: blur(8px);
      padding: 18px;
    }

    .modal.active {
      display: grid;
    }

    .modal-card {
      width: min(420px, 100%);
      background: white;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      padding: 20px;
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }

    .close {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: var(--card2);
      font-size: 1.2rem;
      font-weight: 950;
      cursor: pointer;
    }

    @media (max-width: 840px) {
      .wrap {
        grid-template-columns: 1fr;
      }

      .login-card {
        order: 1;
      }

      .info-card {
        order: 2;
      }
    }

    @media (max-width: 430px) {
      body {
        padding: 13px;
      }

      .brand p {
        display: none;
      }

      .card {
        padding: 18px;
        border-radius: 24px;
      }

      .staff-btn {
        padding: 0 11px;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="brand">
      <div class="logo">B</div>
      <div>
        <h1>Blue Wallet</h1>
        <p>Secure email wallet login</p>
      </div>
    </div>

    <button class="staff-btn" type="button" onclick="openStaffModal()">Staff</button>
  </header>

  <main class="wrap">
    <section class="card login-card">
      <div class="badge"><span class="dot"></span>Email verification</div>
      <div class="title">Open your wallet</div>
      <div class="subtitle">
        Enter your email. Existing users load their saved wallet. New users get a new encrypted wallet setup after login.
      </div>

      <% if (error) { %>
        <div class="msg error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="msg success">
          <span class="check">✓</span>
          <div>
            <strong><%= success %></strong><br />
            Check your inbox. Also check Spam/Junk and mark it as “Not spam” if needed.
          </div>
        </div>
      <% } %>

      <% if (otpEmail) { %>
        <form action="/verify-otp" method="POST">
          <input type="hidden" name="email" value="<%= otpEmail %>" />

          <div class="form-group">
            <label>Email</label>
            <input type="email" value="<%= otpEmail %>" disabled />
          </div>

          <div class="form-group">
            <label>OTP code</label>
            <input
              type="text"
              name="otp"
              placeholder="Enter 6-digit code"
              inputmode="numeric"
              maxlength="6"
              autocomplete="one-time-code"
              required
            />
          </div>

          <button class="btn primary" type="submit">Verify & go to wallet</button>
        </form>

        <form action="/send-otp" method="POST" class="resend">
          <input type="hidden" name="email" value="<%= otpEmail %>" />
          <button class="btn secondary" type="submit" id="resendBtn" disabled>
            Resend OTP in <span id="countdown">10</span>s
          </button>
        </form>

        <div class="msg hint" style="margin-top: 12px;">
          After verification, you will be redirected to <strong>/wallet</strong>. If this email already has a wallet, it loads the same wallet.
        </div>
      <% } else { %>
        <form action="/send-otp" method="POST">
          <div class="form-group">
            <label>Email address</label>
            <input
              type="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>

          <button class="btn primary" type="submit">Send OTP</button>
        </form>
      <% } %>

      <div class="small">
        Your OTP expires after 10 minutes.
      </div>
    </section>

    <section class="card info-card">
      <div class="badge"><span class="dot"></span>Security</div>
      <div class="title">How secure is it?</div>
      <div class="subtitle">
        Blue Wallet is designed as a non-custodial web wallet. Your wallet key is created in your browser and encrypted before storage.
      </div>

      <div class="security-list">
        <div class="security-item">
          <strong>Client-side wallet generation</strong>
          <span>The real wallet is generated in the browser. The server should never receive the raw seed phrase or private key.</span>
        </div>

        <div class="security-item">
          <strong>Encrypted wallet vault</strong>
          <span>Your seed/private key is encrypted with your wallet passcode before being saved to your account record.</span>
        </div>

        <div class="security-item">
          <strong>Same email, same wallet</strong>
          <span>When you login with the same verified email, the server loads your designated wallet record.</span>
        </div>

        <div class="security-item">
          <strong>Important warning</strong>
          <span>If you lose your wallet passcode and seed phrase, your wallet cannot be recovered.</span>
        </div>
      </div>
    </section>
  </main>

  <div class="modal" id="staffModal" onclick="closeStaffModalOnOverlay(event)">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="title" style="font-size:1.2rem;margin-bottom:4px;">Staff login</div>
          <div class="subtitle" style="margin-bottom:0;">Staff account loads the admin wallet.</div>
        </div>
        <button class="close" type="button" onclick="closeStaffModal()">×</button>
      </div>

      <form action="/staff-login" method="POST">
        <div class="form-group">
          <label>Username</label>
          <input type="text" name="username" placeholder="admin" autocomplete="username" required />
        </div>

        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="Password" autocomplete="current-password" required />
        </div>

        <button class="btn primary" type="submit">Open staff wallet</button>
      </form>
    </div>
  </div>

  <script>
    function openStaffModal() {
      document.getElementById('staffModal').classList.add('active');
    }

    function closeStaffModal() {
      document.getElementById('staffModal').classList.remove('active');
    }

    function closeStaffModalOnOverlay(event) {
      if (event.target.id === 'staffModal') closeStaffModal();
    }

    window.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeStaffModal();
    });

    const resendBtn = document.getElementById('resendBtn');
    const countdownEl = document.getElementById('countdown');

    if (resendBtn && countdownEl) {
      let seconds = 10;

      const timer = setInterval(function () {
        seconds -= 1;
        countdownEl.textContent = seconds;

        if (seconds <= 0) {
          clearInterval(timer);
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend OTP';
        }
      }, 1000);
    }
  </script>
</body>
</html>