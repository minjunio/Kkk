<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Blue Wallet - Login</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #f4f9ff;
      --bg-2: #e8f3ff;
      --card: #ffffff;
      --card-2: #f7fbff;
      --border: rgba(15, 23, 42, 0.08);
      --border-strong: rgba(2, 132, 199, 0.25);
      --text: #0f172a;
      --muted: #64748b;
      --primary: #0284c7;
      --primary-2: #2563eb;
      --danger: #e11d48;
      --success: #16a34a;
      --shadow: 0 24px 80px rgba(15, 23, 42, 0.1);
      --shadow-soft: 0 12px 34px rgba(15, 23, 42, 0.08);
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(2, 132, 199, 0.12), transparent 28%),
        radial-gradient(circle at 90% 8%, rgba(22, 163, 74, 0.08), transparent 24%),
        linear-gradient(135deg, var(--bg), var(--bg-2));
      overflow-x: hidden;
    }

    button,
    input {
      font: inherit;
    }

    .topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 20;
      padding: calc(14px + var(--safe-top)) 18px 14px;
    }

    .topbar-inner {
      width: min(1120px, 100%);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .logo {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: white;
      font-weight: 950;
      letter-spacing: -0.06em;
      background: linear-gradient(135deg, #2563eb, #38bdf8);
      box-shadow: 0 12px 28px rgba(37, 99, 235, 0.22);
    }

    .brand-title {
      font-weight: 950;
      letter-spacing: -0.045em;
      font-size: 1.04rem;
      white-space: nowrap;
    }

    .brand-subtitle {
      margin-top: 2px;
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .staff-btn {
      height: 42px;
      padding: 0 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.82);
      color: var(--text);
      font-weight: 900;
      font-size: 0.82rem;
      cursor: pointer;
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(14px);
      transition: transform 0.18s ease, border-color 0.18s ease;
    }

    .staff-btn:hover {
      transform: translateY(-1px);
      border-color: var(--border-strong);
    }

    .page {
      min-height: 100vh;
      width: min(1120px, 100%);
      margin: 0 auto;
      padding: calc(86px + var(--safe-top)) 18px calc(28px + var(--safe-bottom));
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 28px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      color: var(--primary);
      background: rgba(2, 132, 199, 0.08);
      border: 1px solid var(--border-strong);
      font-weight: 950;
      font-size: 0.78rem;
      margin-bottom: 18px;
    }

    .pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--primary);
      box-shadow: 0 0 0 rgba(2, 132, 199, 0.45);
      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(2, 132, 199, 0.42); }
      80% { box-shadow: 0 0 0 9px rgba(2, 132, 199, 0); }
      100% { box-shadow: 0 0 0 0 rgba(2, 132, 199, 0); }
    }

    h1 {
      font-size: clamp(2.5rem, 7vw, 5.2rem);
      line-height: 0.95;
      letter-spacing: -0.08em;
      font-weight: 950;
      margin-bottom: 18px;
    }

    .hero p {
      max-width: 540px;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.7;
      font-weight: 650;
    }

    .features {
      margin-top: 24px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      max-width: 620px;
    }

    .feature {
      padding: 14px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.76);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
    }

    .feature strong {
      display: block;
      font-size: 0.9rem;
      font-weight: 950;
      margin-bottom: 5px;
    }

    .feature span {
      color: var(--muted);
      font-size: 0.76rem;
      font-weight: 750;
      line-height: 1.45;
    }

    .login-card {
      width: 100%;
      max-width: 440px;
      justify-self: end;
      background: rgba(255, 255, 255, 0.94);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: 28px;
      padding: 22px;
      backdrop-filter: blur(18px);
    }

    .card-title {
      font-size: 1.35rem;
      font-weight: 950;
      letter-spacing: -0.055em;
    }

    .card-subtitle {
      margin-top: 6px;
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.5;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .primary-btn,
    .secondary-btn {
      width: 100%;
      min-height: 50px;
      border-radius: 16px;
      font-weight: 950;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, opacity 0.18s ease;
    }

    .primary-btn {
      background: linear-gradient(135deg, var(--primary-2), var(--primary));
      color: white;
      border: 0;
      box-shadow: 0 14px 32px rgba(37, 99, 235, 0.18);
      margin-top: 8px;
    }

    .secondary-btn {
      background: var(--card-2);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .primary-btn:hover,
    .secondary-btn:hover {
      transform: translateY(-1px);
      border-color: var(--border-strong);
    }

    .primary-btn:disabled,
    .secondary-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
    }

    .form-group {
      display: grid;
      gap: 8px;
      margin-bottom: 13px;
      text-align: left;
    }

    .form-group label {
      color: var(--muted);
      font-size: 0.76rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .form-group input {
      width: 100%;
      min-height: 50px;
      padding: 13px 14px;
      border-radius: 16px;
      background: var(--card-2);
      border: 1px solid var(--border);
      color: var(--text);
      outline: none;
      font-weight: 850;
    }

    .form-group input:focus {
      border-color: var(--border-strong);
      box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.08);
    }

    .error-msg,
    .success-msg,
    .hint-msg {
      padding: 12px;
      border-radius: 15px;
      font-size: 0.83rem;
      font-weight: 850;
      line-height: 1.45;
      margin-bottom: 13px;
    }

    .error-msg {
      background: rgba(225, 29, 72, 0.08);
      color: var(--danger);
    }

    .success-msg {
      background: rgba(22, 163, 74, 0.09);
      color: var(--success);
      display: flex;
      gap: 9px;
      align-items: flex-start;
    }

    .hint-msg {
      background: rgba(2, 132, 199, 0.08);
      color: var(--primary);
    }

    .check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--success);
      color: white;
      display: inline-grid;
      place-items: center;
      flex: 0 0 auto;
      font-size: 0.85rem;
      font-weight: 950;
      margin-top: -1px;
    }

    .small-text {
      margin-top: 12px;
      color: var(--muted);
      font-size: 0.76rem;
      font-weight: 700;
      line-height: 1.55;
      text-align: center;
    }

    .resend-row {
      margin-top: 10px;
    }

    .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: none;
      background: rgba(15, 23, 42, 0.4);
      backdrop-filter: blur(8px);
      padding: 16px;
    }

    .modal-overlay.active {
      display: grid;
      place-items: center;
    }

    .modal-card {
      width: min(420px, 100%);
      background: white;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: 24px;
      padding: 20px;
      animation: pop 0.2s ease both;
    }

    @keyframes pop {
      from { transform: translateY(14px) scale(0.98); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
      margin-bottom: 16px;
    }

    .modal-title {
      font-size: 1.2rem;
      font-weight: 950;
      letter-spacing: -0.05em;
    }

    .modal-subtitle {
      margin-top: 4px;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 700;
      line-height: 1.45;
    }

    .close-btn {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      background: var(--card-2);
      border: 1px solid var(--border);
      color: var(--text);
      font-weight: 950;
      font-size: 1.2rem;
      cursor: pointer;
    }

    @media (max-width: 860px) {
      .page {
        grid-template-columns: 1fr;
        align-items: start;
        padding-top: calc(92px + var(--safe-top));
      }

      .login-card {
        justify-self: stretch;
        max-width: none;
      }

      .features {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 430px) {
      .brand-subtitle {
        display: none;
      }

      .staff-btn {
        padding: 0 11px;
      }

      .login-card {
        padding: 18px;
        border-radius: 24px;
      }

      h1 {
        font-size: 2.65rem;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="logo">B</div>
        <div>
          <div class="brand-title">Blue Wallet</div>
          <div class="brand-subtitle">Wallet · staking · trading</div>
        </div>
      </div>

      <button class="staff-btn" type="button" onclick="openStaffModal()">Staff login</button>
    </div>
  </header>

  <main class="page">
    <section class="hero">
      <div class="eyebrow"><span class="pulse"></span> Secure email access</div>
      <h1>Your crypto wallet terminal.</h1>
      <p>
        Login with your email to access your saved wallet. If this is a new email,
        Blue Wallet will create a new encrypted wallet setup for that account.
      </p>

      <div class="features">
        <div class="feature">
          <strong>Same email, same wallet</strong>
          <span>Returning users connect back to their designated wallet record.</span>
        </div>
        <div class="feature">
          <strong>OTP protected</strong>
          <span>One-time login code sent to your email inbox.</span>
        </div>
        <div class="feature">
          <strong>Trading-ready</strong>
          <span>Wallet data connects to wallet.ejs and trading.ejs.</span>
        </div>
      </div>
    </section>

    <section class="login-card">
      <div class="card-title">Login to wallet</div>
      <div class="card-subtitle">
        Enter your email. We will send a one-time code to continue.
      </div>

      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="success-msg">
          <span class="check">✓</span>
          <div>
            <strong><%= success %></strong><br>
            Check your inbox. If you do not see it, check Spam/Junk and mark it as “Not spam”.
          </div>
        </div>
      <% } %>

      <% if (otpEmail) { %>
        <form action="/verify-otp" method="POST">
          <input type="hidden" name="email" value="<%= otpEmail %>" />

          <div class="form-group">
            <label>Email</label>
            <input type="email" value="<%= otpEmail %>" disabled />
          </div>

          <div class="form-group">
            <label>OTP Code</label>
            <input
              type="text"
              name="otp"
              placeholder="Enter 6-digit code"
              inputmode="numeric"
              maxlength="6"
              required
            />
          </div>

          <button type="submit" class="primary-btn">Verify & Open Wallet</button>
        </form>

        <form action="/send-otp" method="POST" class="resend-row">
          <input type="hidden" name="email" value="<%= otpEmail %>" />
          <button type="submit" class="secondary-btn" id="resendBtn" disabled>
            Resend OTP in <span id="countdown">10</span>s
          </button>
        </form>

        <div class="hint-msg" style="margin-top: 12px;">
          If this email already has a wallet, it will load that wallet. If not, a new wallet setup will be generated after login.
        </div>
      <% } else { %>
        <form action="/send-otp" method="POST">
          <div class="form-group">
            <label>Email address</label>
            <input
              type="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>

          <button type="submit" class="primary-btn">Send OTP Code</button>
        </form>
      <% } %>

      <div class="small-text">
        Staff accounts use the Staff login button in the top-right.
      </div>
    </section>
  </main>

  <div class="modal-overlay" id="staffModal" onclick="closeStaffModalOnOverlay(event)">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Staff login</div>
          <div class="modal-subtitle">
            Admin/staff accounts load the custom staff wallet balance.
          </div>
        </div>
        <button class="close-btn" type="button" onclick="closeStaffModal()">×</button>
      </div>

      <form action="/staff-login" method="POST">
        <div class="form-group">
          <label>Staff username</label>
          <input type="text" name="username" placeholder="admin" autocomplete="username" required />
        </div>

        <div class="form-group">
          <label>Staff password</label>
          <input type="password" name="password" placeholder="Password" autocomplete="current-password" required />
        </div>

        <button type="submit" class="primary-btn">Open Staff Wallet</button>
      </form>
    </div>
  </div>

  <script>
    function openStaffModal() {
      document.getElementById('staffModal').classList.add('active');
    }

    function closeStaffModal() {
      document.getElementById('staffModal').classList.remove('active');
    }

    function closeStaffModalOnOverlay(event) {
      if (event.target.id === 'staffModal') closeStaffModal();
    }

    window.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeStaffModal();
    });

    const resendBtn = document.getElementById('resendBtn');
    const countdownEl = document.getElementById('countdown');

    if (resendBtn && countdownEl) {
      let seconds = 10;

      const timer = setInterval(() => {
        seconds -= 1;
        countdownEl.textContent = seconds;

        if (seconds <= 0) {
          clearInterval(timer);
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend OTP';
        }
      }, 1000);
    }
  </script>
</body>
</html>