<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard • Credity</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    body { font-family: 'Inter', system_ui, sans-serif; }
    .glass { background: rgba(255,255,255,0.95); border: 1px solid #e2e8f0; }
    .section-header { font-size: 1.75rem; font-weight: 700; letter-spacing: -.025em; }
    .modern-input { background: white; border: 1px solid #cbd5e1; }
    .modern-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); outline: none; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900">
  <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-x-3">
        <div class="w-8 h-8 bg-blue-600 rounded-xl flex items-center justify-center">
          <span class="text-white font-bold text-xl">C</span>
        </div>
        <span class="font-semibold text-xl">Credity Admin</span>
      </div>
      <div class="flex items-center gap-x-4">
        <div class="text-sm text-slate-600">Welcome, Admin</div>
        <a href="/logout" class="px-4 py-2 text-sm border border-slate-300 rounded-xl hover:bg-slate-100 transition-colors">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-6 pt-8 pb-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="text-sm text-blue-600 font-medium tracking-widest">ADMIN CONTROL PANEL</div>
        <h1 class="text-4xl font-semibold tracking-tight">Platform Overview</h1>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-10">
      <div class="glass p-6 rounded-3xl border border-slate-200">
        <div class="text-xs text-slate-500">TOTAL BADGES ISSUED</div>
        <div class="text-4xl font-semibold mt-1"><%= badges.length + issuedBadges.length %></div>
      </div>
      <div class="glass p-6 rounded-3xl border border-slate-200">
        <div class="text-xs text-slate-500">ACTIVE EVENTS</div>
        <div class="text-4xl font-semibold mt-1"><%= events.length %></div>
      </div>
      <div class="glass p-6 rounded-3xl border border-slate-200">
        <div class="text-xs text-slate-500">TESTS CREATED</div>
        <div class="text-4xl font-semibold mt-1"><%= tests.length %></div>
      </div>
      <div class="glass p-6 rounded-3xl border border-slate-200">
        <div class="text-xs text-slate-500">REGISTERED USERS</div>
        <div class="text-4xl font-semibold mt-1">247</div>
      </div>
    </div>

    <!-- Quick Actions + Forms (Create Badge, Event, Test) -->
    <div class="mb-10">
      <div class="section-header mb-4">Quick Actions</div>
      <div class="grid md:grid-cols-3 gap-4">
        <button onclick="document.getElementById('create-badge-section').scrollIntoView({behavior:'smooth'})" class="glass p-5 rounded-3xl border border-slate-200 text-left hover:border-blue-300 transition-colors">
          <i class="fa-solid fa-plus text-blue-600 mb-3"></i>
          <div class="font-semibold">Create New Badge</div>
        </button>
        <button onclick="document.getElementById('post-event-section').scrollIntoView({behavior:'smooth'})" class="glass p-5 rounded-3xl border border-slate-200 text-left hover:border-blue-300 transition-colors">
          <i class="fa-solid fa-calendar-plus text-blue-600 mb-3"></i>
          <div class="font-semibold">Post Special Event</div>
        </button>
        <button onclick="document.getElementById('create-test-section').scrollIntoView({behavior:'smooth'})" class="glass p-5 rounded-3xl border border-slate-200 text-left hover:border-blue-300 transition-colors">
          <i class="fa-solid fa-file-lines text-blue-600 mb-3"></i>
          <div class="font-semibold">Create Assessment</div>
        </button>
      </div>
    </div>

    <!-- Create Badge Form -->
    <div id="create-badge-section" class="glass p-8 rounded-3xl border border-slate-200 mb-8">
      <div class="section-header mb-6">Create Badge or Certificate</div>
      <form action="/create-badge" method="POST" class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="text-xs font-medium text-slate-600 block mb-1">TYPE</label>
          <select name="type" class="modern-input w-full px-4 py-3 rounded-2xl text-sm">
            <option value="badge">Skill Badge</option>
            <option value="certificate">Certificate</option>
          </select>
        </div>
        <div>
          <label class="text-xs font-medium text-slate-600 block mb-1">TITLE</label>
          <input type="text" name="title" value="Advanced Data Analysis" class="modern-input w-full px-4 py-3 rounded-2xl text-sm" required>
        </div>
        <div class="md:col-span-2">
          <label class="text-xs font-medium text-slate-600 block mb-1">DESCRIPTION</label>
          <textarea name="description" class="modern-input w-full px-4 py-3 rounded-2xl text-sm h-20">Completed rigorous training in data analysis and visualization.</textarea>
        </div>
        <div>
          <label class="text-xs font-medium text-slate-600 block mb-1">PRIMARY COLOR</label>
          <input type="color" name="designColor" value="#3b82f6" class="w-full h-11 p-1 border border-slate-300 rounded-2xl">
        </div>
        <div>
          <label class="text-xs font-medium text-slate-600 block mb-1">SIGNATURE</label>
          <input type="text" name="signature" value="Admin" class="modern-input w-full px-4 py-3 rounded-2xl text-sm">
        </div>
        <div class="md:col-span-2">
          <button type="submit" class="w-full py-4 bg-blue-600 text-white font-semibold rounded-3xl hover:bg-blue-700 transition-colors">Create & Publish</button>
        </div>
      </form>
    </div>

    <!-- Post Event Form -->
    <div id="post-event-section" class="glass p-8 rounded-3xl border border-slate-200 mb-8">
      <div class="section-header mb-6">Post Special Event</div>
      <form action="/post-event" method="POST">
        <input type="text" name="title" placeholder="Spring Skill Challenge 2026" class="modern-input w-full px-4 py-3 rounded-2xl text-sm mb-4" required>
        <textarea name="description" placeholder="Complete 3 skill badges to earn exclusive recognition." class="modern-input w-full px-4 py-3 rounded-2xl text-sm h-20 mb-4"></textarea>
        <button type="submit" class="w-full py-4 bg-blue-600 text-white font-semibold rounded-3xl hover:bg-blue-700 transition-colors">Publish Event</button>
      </form>
    </div>

    <!-- Create Test Form -->
    <div id="create-test-section" class="glass p-8 rounded-3xl border border-slate-200">
      <div class="section-header mb-6">Create Assessment</div>
      <form action="/create-test" method="POST">
        <input type="text" name="title" value="Midterm Data Science Assessment" class="modern-input w-full px-4 py-3 rounded-2xl text-sm mb-4" required>
        <textarea name="questions" class="modern-input w-full px-4 py-3 rounded-2xl text-sm h-32 font-mono text-xs mb-4" placeholder='[{"q":"Explain correlation vs causation.","type":"frq","timer":180}]'>[{"q":"What is the mean?","type":"mcq","options":["Average","Median","Mode"],"timer":60}]</textarea>
        <button type="submit" class="w-full py-4 bg-blue-600 text-white font-semibold rounded-3xl hover:bg-blue-700 transition-colors">Create Test with Anti-Cheat</button>
      </form>
    </div>
  </div>
</body>
</html>