<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard • Credity</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Cinzel:wght@600;700&family=Playfair+Display:ital,wght@0,600;1,400&family=Space+Grotesk:wght@500;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .glass { background: white; border: 1px solid #e2e8f0; }
    .cert-container { container-type: inline-size; }
    .certificate-preview { background: white; box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.2); position: relative; overflow: hidden; }
    
    /* 8-Stack Wave System */
    .wave-stack { position: absolute; inset: 0; pointer-events: none; opacity: 0.08; z-index: 1; }
    .draggable-logo { position: absolute; cursor: grab; z-index: 50; mix-blend-mode: multiply; }
    .draggable-logo img { width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  </style>
</head>
<body class="bg-slate-50">

  <nav class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 flex justify-between">
    <div class="font-bold text-xl">Credity Admin</div>
    <a href="/logout" class="px-4 py-2 bg-slate-900 text-white rounded-lg text-sm">Logout</a>
  </nav>

  <div class="max-w-[90rem] mx-auto p-6">
    <form action="/create-credential" method="POST" class="flex flex-col xl:flex-row gap-8">
      
      <!-- Controls -->
      <div class="xl:w-2/3 glass p-8 rounded-3xl space-y-6">
        <h2 class="text-xl font-bold">Credential Engine</h2>
        <div class="grid grid-cols-2 gap-4">
          <input type="text" name="title" id="cert-title" value="Master of Science" oninput="updateCert()" class="border p-3 rounded-xl w-full">
          <input type="date" id="cert-date" oninput="updateCert()" class="border p-3 rounded-xl w-full">
        </div>
        
        <!-- Logo Engine -->
        <div class="p-4 bg-slate-50 rounded-xl">
          <label class="text-xs font-bold uppercase mb-2 block">Logo Repository (Tech & AI)</label>
          <div id="logo-grid" class="grid grid-cols-8 gap-2 max-h-40 overflow-y-auto p-2 bg-white rounded-lg border"></div>
        </div>
        <button type="submit" class="w-full py-4 bg-blue-600 text-white rounded-xl font-bold">Issue Credential</button>
      </div>

      <!-- Preview -->
      <div class="xl:w-1/3">
        <div id="cert-preview" class="certificate-preview w-full aspect-[1.414] p-[5%] flex flex-col items-center justify-center text-center">
          
          <!-- 8-Layer Wave Stack -->
          <svg class="wave-stack" viewBox="0 0 1000 700">
            <defs><path id="w" d="M-100 0 Q 250 50, 500 0 T 1100 0"/></defs>
            <g font-family="monospace" font-size="14" font-weight="bold" fill="#000">
              <text><textPath href="#w" startOffset="0%" y="80">VERIFIABLE ON CREDITY.INK • VERIFIABLE ON CREDITY.INK</textPath></text>
              <text><textPath href="#w" startOffset="0%" y="160">VERIFIABLE ON CREDITY.INK • VERIFIABLE ON CREDITY.INK</textPath></text>
              <text><textPath href="#w" startOffset="0%" y="240">VERIFIABLE ON CREDITY.INK • VERIFIABLE ON CREDITY.INK</textPath></text>
              <text><textPath href="#w" startOffset="0%" y="320">VERIFIABLE ON CREDITY.INK • VERIFIABLE ON CREDITY.INK</textPath></text>
              <text><textPath href="#w" startOffset="0%" y="400">VERIFIABLE ON CREDITY.INK • VERIFIABLE ON CREDITY.INK</textPath></text>
              <text><textPath href="#w" startOffset="0%" y="480">VERIFIABLE ON CREDITY.INK • VERIFIABLE ON CREDITY.INK</textPath></text>
              <text><textPath href="#w" startOffset="0%" y="560">VERIFIABLE ON CREDITY.INK • VERIFIABLE ON CREDITY.INK</textPath></text>
              <text><textPath href="#w" startOffset="0%" y="640">VERIFIABLE ON CREDITY.INK • VERIFIABLE ON CREDITY.INK</textPath></text>
            </g>
          </svg>

          <div id="drag-boundary" class="absolute inset-0 z-50"></div>
          
          <div class="z-20 w-full mt-10">
            <h1 id="preview-title" class="text-4xl font-bold">Master of Science</h1>
            <p id="preview-date" class="text-slate-500 mt-2 text-sm italic">Issue Date: --</p>
          </div>

          <!-- Bottom Right QR -->
          <div class="absolute bottom-6 right-6 z-20">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=Verify" class="w-20 h-20 shadow-lg">
          </div>
        </div>
      </div>
    </form>
  </div>

  <script>
    const techSlugs = ['openai', 'tensorflow', 'pytorch', 'keras', 'scikitlearn', 'pandas', 'numpy', 'python', 'huggingface', 'meta', 'nvidia', 'intel', 'linux', 'docker', 'kubernetes', 'git', 'github', 'react', 'nodedotjs', 'javascript', 'typescript', 'mongodb', 'postgresql', 'redis', 'amazon', 'apple', 'android', 'firebase', 'amazonwebservices', 'googlecloud', 'microsoftazure', 'cloudflare', 'apache', 'java', 'ruby', 'php', 'swift', 'kotlin', 'cplusplus', 'rust'];

    function init() {
      const logoGrid = document.getElementById('logo-grid');
      techSlugs.forEach(slug => {
        const url = `https://cdn.simpleicons.org/${slug}/0f172a`;
        const img = document.createElement('img');
        img.src = url;
        img.className = 'w-10 h-10 p-2 cursor-pointer bg-white border rounded hover:border-blue-500 object-contain';
        
        // Error handling: if logo fails to load, remove it immediately
        img.onerror = () => img.remove();
        img.onclick = () => addLogo(url);
        logoGrid.appendChild(img);
      });
      document.getElementById('cert-date').value = new Date().toISOString().split('T')[0];
    }

    function addLogo(url) {
      const wrapper = document.createElement('div');
      wrapper.className = 'draggable-logo w-20 h-20';
      wrapper.style.left = '50px';
      wrapper.style.top = '50px';
      wrapper.innerHTML = `<img src="${url}" onerror="this.parentElement.remove()">`;
      document.getElementById('drag-boundary').appendChild(wrapper);
      makeDraggable(wrapper);
    }

    function updateCert() {
      document.getElementById('preview-title').innerText = document.getElementById('cert-title').value;
      document.getElementById('preview-date').innerText = "Issue Date: " + document.getElementById('cert-date').value;
    }

    function makeDraggable(elmnt) {
      let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
      elmnt.onmousedown = (e) => {
        pos3 = e.clientX; pos4 = e.clientY;
        document.onmousemove = (e) => {
          pos1 = pos3 - e.clientX; pos2 = pos4 - e.clientY;
          pos3 = e.clientX; pos4 = e.clientY;
          elmnt.style.top = (elmnt.offsetTop - pos2) + "px";
          elmnt.style.left = (elmnt.offsetLeft - pos1) + "px";
        };
        document.onmouseup = () => { document.onmousemove = null; };
      };
    }

    window.onload = init;
  </script>
</body>
</html>
