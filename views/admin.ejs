<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard • Credity</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Space+Grotesk:wght@500;700&family=Cinzel:wght@500;700&family=Montserrat:wght@400;600;700&family=Pinyon+Script&display=swap');
    
    body { font-family: 'Inter', sans-serif; overflow-x: hidden; }
    .glass { background: white; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
    .modern-input { background: #f8fafc; border: 1px solid #e2e8f0; transition: all 0.2s; }
    .modern-input:focus { border-color: #3b82f6; background: white; outline: none; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
    .custom-scroll::-webkit-scrollbar { height: 5px; width: 5px; }
    .custom-scroll::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    
    .font-signature { font-family: 'Pinyon Script', cursive; }

    .draggable-logo {
      position: absolute;
      cursor: grab;
      z-index: 50;
      mix-blend-mode: multiply;
      transition: box-shadow 0.2s;
    }
    .draggable-logo:active { cursor: grabbing; }
    .draggable-logo img { width: 100%; height: 100%; object-fit: contain; pointer-events: none; }

    .cert-container { container-type: inline-size; perspective: 1000px; }
    .certificate-preview {
      background: white;
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.2);
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
      transform-style: preserve-3d;
      display: flex;
      flex-direction: column;
    }

    /* Templates Styles */
    .tpl-1-degree { font-family: 'Cinzel', serif; border: 2.5cqw solid #1e293b; outline: 0.6cqw solid #1e293b; outline-offset: -1.2cqw; background: linear-gradient(#fffdf8, #fefaf0); box-shadow: inset 0 0 0 1.5cqw #f8f1e3, inset 0 0 90px rgba(180, 83, 9, 0.07); position: relative; }
    .tpl-1-degree::before { content: ''; position: absolute; inset: 1.6cqw; border: 0.45cqw solid #1e293b; opacity: 0.12; pointer-events: none; }
    .tpl-1-degree .cert-title { font-size: 4.6cqi; color: #1e293b; font-weight: 700; border-bottom: 2.5px solid #b45309; padding-bottom: 1.8cqw; display: inline-block; letter-spacing: 0.02em; }
    .tpl-2-university { font-family: 'Playfair Display', serif; border: 3cqw solid #1e293b; background: #ffffff; position: relative; }
    .tpl-2-university::before { content:''; position:absolute; inset: 1.8cqw; border: 0.35cqw solid #1e293b; opacity: 0.15; pointer-events: none; }
    .tpl-2-university .cert-title { font-size: 4cqi; text-transform: uppercase; letter-spacing: 0.25em; color: #1e293b; }
    .tpl-3-corporate { font-family: 'Montserrat', sans-serif; border-top: 5.5cqw solid #1e293b; border-bottom: 1.8cqw solid #1e293b; background: #ffffff; }
    .tpl-3-corporate .cert-title { font-size: 3.6cqi; font-weight: 800; letter-spacing: 0.12em; color: #1e293b; }
    .tpl-4-tech { font-family: 'Space Grotesk', sans-serif; border: 0.6cqw solid #1e293b; background: #ffffff; background-image: linear-gradient(rgba(15,23,42,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(15,23,42,0.035) 1px, transparent 1px); background-size: 3.8cqw 3.8cqw; }
    .tpl-4-tech .cert-title { font-size: 3.5cqi; text-transform: uppercase; color: #1e293b; letter-spacing: 0.1em; }
    .tpl-5-scholar { font-family: 'Cinzel', serif; border: 1.6cqw solid #b45309; background: linear-gradient(135deg, #fffbeb, #fef3c7); position: relative; }
    .tpl-5-scholar::after { content:''; position:absolute; inset: 0.6cqw; border: 0.35cqw solid #b45309; pointer-events: none; }
    .tpl-5-scholar .cert-title { font-size: 4.1cqi; color: #92400e; }
    .tpl-6-minimal { font-family: 'Inter', sans-serif; border-left: 6.5cqw solid #1e293b; background: #f8fafc; }
    .tpl-6-minimal .cert-title { font-size: 3.6cqi; font-weight: 700; text-align: left; color: #1e293b; }
    .tpl-7-exec { font-family: 'Playfair Display', serif; border: 0.25cqw solid #64748b; background: #ffffff; box-shadow: inset 0 0 0 2.2cqw #f1f5f9; }
    .tpl-7-exec .cert-title { font-size: 3.9cqi; font-style: italic; color: #1e293b; }
    .tpl-8-dark { font-family: 'Space Grotesk', sans-serif; border: 0.55cqw solid #334155; background: radial-gradient(circle at 50% 0%, #1e293b, #0f172a); color: #f8fafc !important; }
    .tpl-8-dark .draggable-logo { mix-blend-mode: normal; filter: drop-shadow(0 0 6px rgba(255,255,255,0.6)); } 
    .tpl-8-dark .cert-title { font-size: 3.5cqi; color: #fff; }
    .tpl-9-honors { font-family: 'Cinzel', serif; border: 1.1cqw double #9f1239; outline: 2.2cqw solid #fff1f2; outline-offset: -3.2cqw; background: #ffffff; }
    .tpl-9-honors .cert-title { font-size: 4.1cqi; color: #9f1239; }
    .tpl-10-cyber { font-family: 'Space Grotesk', sans-serif; border-right: 3.2cqw solid #10b981; border-left: 3.2cqw solid #10b981; background: #000000; color: #10b981 !important; }
    .tpl-10-cyber .draggable-logo { mix-blend-mode: normal; filter: drop-shadow(0 0 6px #10b981); }
    .tpl-10-cyber .cert-title { font-size: 3.1cqi; letter-spacing: 0.35em; }
    .tpl-11-artdeco { font-family: 'Montserrat', sans-serif; border: 1.1cqw solid #1e293b; background: #fafaf9; outline: 0.25cqw solid #1e293b; outline-offset: -1.6cqw; }
    .tpl-12-startup { font-family: 'Inter', sans-serif; border-radius: 4.5cqw; border: 0.9cqw solid #1e293b; background: #ffffff; box-shadow: inset 0 0 3.5cqw rgba(0,0,0,0.06); }
    .tpl-13-classic { font-family: 'Playfair Display', serif; border: 2.2cqw solid #1e293b; background: #fefce8; }
    .tpl-14-geo { font-family: 'Montserrat', sans-serif; border: 1.1cqw solid #1e293b; background: repeating-linear-gradient(45deg, transparent, transparent 11px, rgba(15,23,42,0.035) 11px, rgba(15,23,42,0.035) 22px); }
    .tpl-15-eco { font-family: 'Inter', sans-serif; border-top: 3.2cqw solid #166534; border-bottom: 3.2cqw solid #166534; background: #f0fdf4; }
    .tpl-16-vintage { font-family: 'Cinzel', serif; border: 2.2cqw groove #b45309; background: #fef3c7; }
    .tpl-17-angle { font-family: 'Montserrat', sans-serif; background: #f8fafc; clip-path: polygon(0 0, 100% 0, 95% 100%, 0% 100%); border-left: 4.5cqw solid #1e293b; }
    .tpl-18-neon { font-family: 'Space Grotesk', sans-serif; border: 0.45cqw solid #334155; border-radius: 2.2cqw; background: #171717; color: #fff !important; box-shadow: inset 0 0 5cqw #334155; }
    .tpl-18-neon .draggable-logo { mix-blend-mode: normal; }
    .tpl-19-medical { font-family: 'Inter', sans-serif; border-left: 6.5cqw solid #0369a1; background: #f0f9ff; }
    .tpl-20-future { font-family: 'Montserrat', sans-serif; background: #ffffff; box-shadow: inset 0 0 0 0.6cqw #1e293b, inset 0 0 0 1.2cqw #fff, inset 0 0 0 1.8cqw #1e293b; }

    .shape-circle { border-radius: 50%; }
    .shape-shield { clip-path: polygon(50% 100%, 0 80%, 0 0, 100% 0, 100% 80%); }
    .shape-hexagon { clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); }
    .shape-octagon { clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%); }
    .shape-pentagon { clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%); }
    .shape-diamond { clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); }
    .shape-star { clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
  </style>
</head>
<body class="bg-slate-50 text-slate-800">

  <nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-[90rem] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-x-3">
        <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/30">
          <span class="text-white font-bold text-xl">C</span>
        </div>
        <span class="font-bold text-xl tracking-tight">Credity Admin</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/assessment" class="hidden sm:flex items-center gap-2 px-5 py-2.5 text-sm font-semibold bg-slate-900 text-white rounded-xl hover:bg-slate-800 transition-colors">
          <i class="fa-solid fa-plus"></i> <span class="hidden md:inline">Create Assessment</span>
        </a>
        <a href="/logout" class="px-5 py-2.5 text-sm font-medium border border-slate-200 rounded-xl hover:bg-slate-50">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 pt-8 pb-20">

    <div class="mb-10">
      <div class="glass rounded-3xl p-8 md:p-10 border border-blue-100 bg-gradient-to-br from-white via-blue-50/30 to-white flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-600 text-white text-xs font-bold tracking-[2px] rounded-lg mb-4">
            <i class="fa-solid fa-rocket"></i>
            <span>PRIMARY ACTION</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-slate-900 leading-none">Create Assessment</h1>
          <p class="mt-4 text-xl text-slate-600">Build secure proctored exams and instantly link them to beautiful, verifiable credentials.</p>
          
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/assessment" 
               class="inline-flex items-center justify-center gap-3 px-9 py-4 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold text-lg rounded-xl shadow-xl shadow-blue-600/40 transition-all active:scale-[0.985]">
              <i class="fa-solid fa-plus text-xl"></i>
              <span>Create New Assessment</span>
            </a>
            <button onclick="document.getElementById('tab-certificates').click(); window.scrollTo({top: 580, behavior:'smooth'})"
                    class="inline-flex items-center justify-center gap-3 px-7 py-4 border-2 border-slate-300 hover:bg-white text-slate-700 font-semibold text-lg rounded-xl transition-all active:scale-[0.985]">
              Design Credentials
            </button>
          </div>
        </div>
        
        <!-- UPDATED STAT COUNTER SECTION -->
        <div class="hidden xl:block">
          <div class="flex items-center gap-4 text-sm bg-white/70 p-4 rounded-2xl border border-blue-50 shadow-sm">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center shadow-inner">
              <i class="fa-solid fa-users text-blue-600 text-xl"></i>
            </div>
            <div>
              <div class="font-bold text-slate-900 text-xl"><%= typeof users !== 'undefined' ? users.length : 0 %> Registered Users</div>
              <div class="text-xs text-slate-500 font-medium">System Wide • Credity</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">Credential Architecture</h2>
        <p class="text-slate-500 mt-1">Design highly secure, verifiable certificates and custom badges.</p>
      </div>
    </div>

    <div class="flex border-b border-slate-200 mb-8 overflow-x-auto custom-scroll">
      <button onclick="showTab('certificates')" class="tab-btn px-6 py-3 font-semibold border-b-2 border-blue-600 text-blue-600 whitespace-nowrap" id="tab-certificates">Certificate Engine</button>
      <button onclick="showTab('badges')" class="tab-btn px-6 py-3 font-medium text-slate-500 hover:text-slate-700 whitespace-nowrap" id="tab-badges">Badge Creator</button>
      <button onclick="showTab('overview')" class="tab-btn px-6 py-3 font-medium text-slate-500 hover:text-slate-700 whitespace-nowrap" id="tab-overview">System Overview</button>
    </div>

    <div id="certificates-tab" class="tab-content">
      <form action="/create-credential" method="POST" class="flex flex-col xl:flex-row gap-8">
        <input type="hidden" name="type" value="certificate">
        
        <div class="xl:w-3/5 glass p-6 md:p-8 rounded-3xl space-y-6">
          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <label class="text-xs font-bold text-blue-800 uppercase tracking-wider block mb-2">Link to Assessment</label>
            <select name="assessmentId" class="modern-input w-full px-4 py-3 rounded-xl text-sm font-medium border-blue-200 bg-white" required>
              <option value="">-- Attach to Assessment --</option>
              <% if (typeof tests !== 'undefined') { %>
                <% tests.forEach(t => { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              <% } else { %>
                <option value="1">Introduction to AI &amp; Data Science</option>
              <% } %>
            </select>
          </div>

          <div class="grid md:grid-cols-3 gap-4 p-4 border border-slate-200 rounded-2xl bg-slate-50">
            <div>
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-2">Preview Student</label>
              <input type="text" id="cert-student" value="Alex Rivera" oninput="updateCert()" class="modern-input w-full px-3 py-2 rounded-lg text-sm">
            </div>
            <div>
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-2">Preview Signature</label>
              <input type="text" name="signature" id="cert-signature" value="Dr. Admin" oninput="updateCert()" class="modern-input w-full px-3 py-2 rounded-lg text-sm">
            </div>
            <div>
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-2">Preview Issue Date</label>
              <input type="date" id="cert-date" oninput="updateCert()" class="modern-input w-full px-3 py-2 rounded-lg text-sm">
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Degree / Certificate Title</label>
              <input type="text" name="title" id="cert-title" value="Master of Science" oninput="updateCert()" class="modern-input w-full px-4 py-3 rounded-xl text-sm font-bold">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Primary Template Color</label>
              <input type="color" name="designColor" id="cert-color" value="#1e293b" oninput="updateCert()" class="w-full h-11 p-0 border-0 rounded-xl cursor-pointer">
            </div>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Accolade Description</label>
            <textarea name="description" id="cert-desc" oninput="updateCert()" class="modern-input w-full px-4 py-3 rounded-xl h-20 text-sm">has fulfilled all requirements and is hereby admitted to the degree with all rights, privileges, and honors appertaining thereto.</textarea>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Master Templates (20)</label>
            <div id="template-grid" class="flex gap-2 overflow-x-auto pb-4 custom-scroll snap-x"></div>
          </div>

          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200">
            <div class="flex justify-between items-center mb-4">
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Multi-Logo Engine</label>
            </div>
            <div class="flex flex-col sm:flex-row gap-2 mb-4">
              <input type="text" id="custom-logo-input" placeholder="Paste logo URL..." class="modern-input flex-1 px-4 py-2.5 rounded-xl text-sm">
              <button type="button" onclick="addCustomLogo()" class="px-5 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-xl">Add Custom Logo</button>
            </div>
            <div class="mb-4">
              <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-2">Active Logos on Certificate</label>
              <div id="active-logos-list" class="flex flex-wrap gap-2 empty:hidden bg-white p-3 rounded-xl border border-slate-200 min-h-[44px]"></div>
            </div>
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-2">Quick Add Reliable Tech Logos</label>
            <div id="logo-grid" class="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10 gap-2 max-h-44 overflow-y-auto custom-scroll p-2 bg-white border border-slate-200 rounded-xl"></div>
          </div>

          <button type="submit" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-lg shadow-lg">Generate Secure Credential</button>
        </div>

        <div class="xl:w-2/5 cert-container">
          <div class="sticky top-24">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-sm font-bold text-slate-400 uppercase">Live Preview</h3>
            </div>
            <div id="cert-preview" class="certificate-preview tpl-1-degree w-full aspect-[1.414] p-[5%] flex flex-col items-center text-center">
              <div id="drag-boundary" class="absolute inset-0 z-50 overflow-hidden pointer-events-none"></div>
              <div class="w-full relative z-10 mt-[7%]">
                <div class="text-[1.65cqi] tracking-[0.3em] text-slate-500 uppercase mb-[2%] cert-text-color font-semibold">The Board of Trustees certifies that</div>
                <div id="preview-student" class="text-[5.1cqi] font-bold text-slate-900 leading-none cert-text-color mt-[2%]">Alex Rivera</div>
              </div>
              <div class="px-[7%] my-[5%] relative z-10 w-full flex-grow">
                <div id="preview-title" class="cert-title mb-[4%] drop-shadow-sm">Master of Science</div>
                <div id="preview-desc" class="text-[1.6cqi] text-slate-600 cert-text-color leading-relaxed">has fulfilled all requirements and is hereby admitted to the degree.</div>
              </div>
              <div class="w-full flex justify-between items-end mt-auto pt-1 pb-1 relative z-10">
                <div class="text-center border-t border-slate-400 pt-2 min-w-[13cqi]">
                  <div id="preview-signature" class="font-signature text-[3.9cqi] text-slate-800 cert-text-color leading-none mb-0.5">Dr. Admin</div>
                  <div class="text-[0.85cqi] text-slate-500 uppercase tracking-widest cert-text-color font-bold">Authorized Signatory</div>
                </div>
                <div class="text-center border-t border-slate-400 pt-2 min-w-[13cqi]">
                  <div id="preview-date-display" class="text-[1.45cqi] font-bold text-slate-800 cert-text-color leading-none mb-1 mt-1">Date</div>
                  <div class="text-[0.85cqi] text-slate-500 uppercase tracking-widest cert-text-color font-bold">Issue Date</div>
                </div>
                <div class="flex flex-col items-center">
                  <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&amp;data=Verify" class="w-[6.6cqi] h-[6.6cqi] mb-0.5 p-0.5 bg-white border border-slate-200 shadow-sm">
                  <div class="text-[0.82cqi] text-slate-500 uppercase cert-text-color font-bold tracking-widest">Verify</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>

    <div id="badges-tab" class="tab-content hidden">
      <form action="/create-credential" method="POST" class="flex flex-col md:flex-row gap-8">
        <input type="hidden" name="type" value="badge">
        <input type="hidden" id="selected-badge-icon" name="badgeIcon" value="fa-shield-halved">
        
        <div class="md:w-1/2 glass p-6 md:p-8 rounded-3xl space-y-6">
          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <label class="text-xs font-bold text-blue-800 uppercase tracking-wider block mb-2">Link to Assessment</label>
            <select name="assessmentId" class="modern-input w-full px-4 py-3 rounded-xl text-sm font-medium border-blue-200" required>
              <option value="">-- Select Assessment --</option>
              <option value="1">Introduction to AI &amp; Data Science</option>
            </select>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Badge Title</label>
            <input type="text" name="title" id="badge-title" value="Certified Engineer" oninput="updateBadge()" class="modern-input w-full px-4 py-3 rounded-xl">
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Shape Geometry</label>
              <select id="badge-shape" onchange="updateBadge()" class="modern-input w-full px-4 py-3 rounded-xl">
                <option value="shape-shield">Shield</option>
                <option value="shape-hexagon">Hexagon</option>
                <option value="shape-circle">Circle</option>
              </select>
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Base Gradient Color</label>
              <input type="color" name="designColor" id="badge-color" value="#0f172a" oninput="updateBadge()" class="w-full h-12 p-0 border-0 rounded-xl cursor-pointer">
            </div>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Vector Icon</label>
            <div class="grid grid-cols-6 gap-2">
              <button type="button" onclick="setBadgeIcon('fa-shield-halved')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-shield-halved text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-award')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-award text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-code')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-code text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-bolt')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-bolt text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-brain')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-brain text-xl"></i></button>
            </div>
          </div>

          <button type="submit" class="w-full py-4 bg-slate-900 hover:bg-black text-white font-semibold rounded-xl">Mint Secure Badge</button>
        </div>

        <div class="md:w-1/2 flex items-center justify-center bg-slate-100 rounded-3xl p-10 md:p-14 border border-slate-200 shadow-inner overflow-hidden relative">
          <div class="absolute inset-0" style="background-image: radial-gradient(#d1d5db 1px, transparent 1px); background-size: 24px 24px; opacity: 0.6;"></div>
          <div class="text-center w-full relative z-10 flex flex-col items-center">
            <div id="preview-badge-text" class="text-[15px] font-bold tracking-[3px] uppercase text-slate-900 mb-7 drop-shadow-sm">Certified Engineer</div>
            <div class="badge-preview-container relative w-56 h-56 mb-8">
              <div id="preview-badge-base" class="badge-base shape-shield w-full h-full shadow-2xl flex flex-col justify-center items-center relative" style="background: linear-gradient(145deg, #0f172a, #1e2937);">
                <i id="preview-badge-icon" class="fa-solid fa-shield-halved text-[3.9rem] text-white mb-3 drop-shadow-xl z-20"></i>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>

    <div id="overview-tab" class="tab-content hidden">
      <div class="glass rounded-3xl overflow-hidden border border-slate-200">
        
        <!-- UPDATED DIRECTORY HEADER -->
        <div class="p-6 border-b border-slate-200 bg-slate-50 flex flex-wrap gap-4 justify-between items-center">
          <div class="flex items-center gap-3">
            <h2 class="text-xl font-bold text-slate-900">Account Directory</h2>
            <span class="px-2.5 py-1 bg-blue-100 text-blue-700 rounded-lg text-xs font-bold uppercase tracking-wider">
              <%= typeof users !== 'undefined' ? users.length : 0 %> Total Users
            </span>
          </div>
          <div class="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-lg text-xs font-bold uppercase tracking-wider">Status: Online</div>
        </div>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-white border-b border-slate-200 text-xs uppercase tracking-wider text-slate-400 font-bold">
                <th class="p-5">Acc Number</th>
                <th class="p-5">Full Name</th>
                <th class="p-5">Email Address</th>
                <th class="p-5">Role</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <% if (typeof users !== 'undefined' && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <tr class="hover:bg-slate-50">
                    <td class="p-5 font-mono text-sm text-slate-500">#<%= u.id.toString().padStart(5, '0') %></td>
                    <td class="p-5 font-semibold text-slate-800"><%= u.name %></td>
                    <td class="p-5 text-slate-600"><%= u.email %></td>
                    <td class="p-5">
                      <% if(u.role === 'teacher') { %>
                        <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-lg text-xs font-bold uppercase">Teacher</span>
                      <% } else { %>
                        <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-lg text-xs font-bold uppercase">Student</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    const templates = [
      { id: '1-degree', name: 'Master\'s Degree' }, { id: '2-university', name: 'University Seal' },
      { id: '3-corporate', name: 'Corporate Award' }, { id: '4-tech', name: 'Grid Technology' },
      { id: '5-scholar', name: 'Gold Scholar' }, { id: '6-minimal', name: 'Minimal Block' }
    ];

    const presetLogos = [
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-original-wordmark.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/googlecloud/googlecloud-original.svg'
    ];

    let currentTemplate = 'tpl-1-degree';
    let activeLogos = [];

    function init() {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('cert-date').value = today;

      const templateGrid = document.getElementById('template-grid');
      templates.forEach(t => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'snap-start flex-shrink-0 px-4 py-2 bg-white border border-slate-300 rounded-xl text-sm font-medium hover:border-blue-500';
        btn.innerText = t.name;
        btn.onclick = () => setTemplate(t.id);
        templateGrid.appendChild(btn);
      });

      const logoGrid = document.getElementById('logo-grid');
      presetLogos.forEach(url => {
        const img = document.createElement('img');
        img.src = url;
        img.className = 'w-9 h-9 p-1.5 cursor-pointer bg-slate-50 rounded-lg border border-transparent hover:border-blue-500 object-contain';
        img.onclick = () => addLogoToDoc(url);
        logoGrid.appendChild(img);
      });

      updateCert();
    }

    function addCustomLogo() {
      const url = document.getElementById('custom-logo-input').value.trim();
      if (url) {
        addLogoToDoc(url);
        document.getElementById('custom-logo-input').value = '';
      }
    }

    function addLogoToDoc(url) {
      const id = 'logo_' + Date.now();
      const wrapper = document.createElement('div');
      wrapper.id = id;
      wrapper.className = 'draggable-logo w-[8.5cqi] h-[8.5cqi] pointer-events-auto';
      wrapper.style.left = '8%';
      wrapper.style.top = '8%';

      const img = document.createElement('img');
      img.src = url;
      img.style.width = '100%';
      img.style.height = '100%';
      img.style.objectFit = 'contain';

      img.onload = () => {
        const boundary = document.getElementById('drag-boundary');
        boundary.appendChild(wrapper);
        wrapper.appendChild(img);
        makeDraggable(wrapper);
        activeLogos.push({ id, url });
        renderActiveLogosList();
      };
    }

    function removeLogo(id) {
      activeLogos = activeLogos.filter(l => l.id !== id);
      const el = document.getElementById(id);
      if (el) el.remove();
      renderActiveLogosList();
    }

    function renderActiveLogosList() {
      const list = document.getElementById('active-logos-list');
      list.innerHTML = '';
      activeLogos.forEach((logo, index) => {
        const badge = document.createElement('div');
        badge.className = 'flex items-center gap-2 bg-slate-100 pl-2 pr-1 py-1 rounded-lg text-xs font-semibold border border-slate-200';
        badge.innerHTML = `
          <img src="${logo.url}" class="w-4 h-4 object-contain"> Logo ${index + 1}
          <button type="button" onclick="removeLogo('${logo.id}')" class="text-red-500"><i class="fa-solid fa-xmark"></i></button>
        `;
        list.appendChild(badge);
      });
    }

    function makeDraggable(elmnt) {
      let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
      elmnt.onmousedown = dragMouseDown;
      function dragMouseDown(e) {
        e.preventDefault();
        pos3 = e.clientX; pos4 = e.clientY;
        document.onmouseup = closeDragElement;
        document.onmousemove = elementDrag;
      }
      function elementDrag(e) {
        e.preventDefault();
        pos1 = pos3 - e.clientX; pos2 = pos4 - e.clientY; pos3 = e.clientX; pos4 = e.clientY;
        const boundary = document.getElementById('drag-boundary').getBoundingClientRect();
        let newTop = ((elmnt.offsetTop - pos2) / boundary.height) * 100;
        let newLeft = ((elmnt.offsetLeft - pos1) / boundary.width) * 100;
        elmnt.style.top = Math.max(0, Math.min(newTop, 92)) + "%";
        elmnt.style.left = Math.max(0, Math.min(newLeft, 92)) + "%";
      }
      function closeDragElement() {
        document.onmouseup = null; document.onmousemove = null;
      }
    }

    function setTemplate(id) {
      const preview = document.getElementById('cert-preview');
      preview.classList.remove(currentTemplate);
      currentTemplate = `tpl-${id}`;
      preview.classList.add(currentTemplate);
      updateCert();
    }

    function updateCert() {
      const title = document.getElementById('cert-title').value;
      const desc = document.getElementById('cert-desc').value;
      const color = document.getElementById('cert-color').value;
      const student = document.getElementById('cert-student').value;
      const signature = document.getElementById('cert-signature').value;
      const dateVal = document.getElementById('cert-date').value;

      document.getElementById('preview-title').innerText = title;
      document.getElementById('cert-preview').style.borderColor = color;
      document.getElementById('cert-preview').style.outlineColor = color;
      document.getElementById('preview-desc').innerText = desc;
      document.getElementById('preview-student').innerText = student || '[Student Name]';
      document.getElementById('preview-signature').innerText = signature || 'Authorized Signature';
      if (dateVal) document.getElementById('preview-date-display').innerText = new Date(dateVal).toLocaleDateString();
    }

    function setBadgeIcon(iconClass) {
      document.getElementById('selected-badge-icon').value = iconClass;
      document.getElementById('preview-badge-icon').className = `fa-solid ${iconClass} text-[3.9rem] text-white mb-3 drop-shadow-xl z-20`;
    }

    function updateBadge() {
      const title = document.getElementById('badge-title').value;
      const shape = document.getElementById('badge-shape').value;
      const hexColor = document.getElementById('badge-color').value;

      document.getElementById('preview-badge-text').innerText = title || 'Badge Title';
      const base = document.getElementById('preview-badge-base');
      base.className = `badge-base ${shape} w-full h-full shadow-2xl flex flex-col justify-center items-center relative`;
      base.style.background = `linear-gradient(145deg, ${hexColor}, #0f172a)`;
    }

    function showTab(tab) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(tab + '-tab').classList.remove('hidden');
      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('border-b-2', 'border-blue-600', 'text-blue-600');
        el.classList.add('text-slate-500');
      });
      document.getElementById('tab-' + tab).classList.remove('text-slate-500');
      document.getElementById('tab-' + tab).classList.add('border-b-2', 'border-blue-600', 'text-blue-600');
    }

    window.onload = init;
  </script>
</body>
</html>
