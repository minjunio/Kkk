<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard • Credity</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap');
    
    body { font-family: 'Inter', sans-serif; }
    .glass { background: white; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
    .modern-input { background: #f8fafc; border: 1px solid #e2e8f0; transition: all 0.2s; }
    .modern-input:focus { border-color: #3b82f6; background: white; outline: none; }
    
    .cert-container { container-type: inline-size; }
    .certificate-preview {
      background: white;
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
      font-family: 'Playfair Display', serif;
      transition: all 0.4s ease;
      position: relative;
    }

    /* Template Styles */
    .template-classic { border: 16px solid; background-image: radial-gradient(#f1f5f9 1px, transparent 1px); background-size: 20px 20px; }
    .template-modern { border-left: 32px solid; border-right: 32px solid; background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%); }
    .template-geometric { border: 4px solid; background: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(0,0,0,0.02) 10px, rgba(0,0,0,0.02) 20px); }
    
    /* Advanced Badge Styles */
    .badge-preview-container { filter: drop-shadow(0 20px 13px rgb(0 0 0 / 0.15)); }
    .badge-base { position: relative; display: flex; align-items: center; justify-content: center; z-index: 10; transition: all 0.3s; }
    .badge-ribbon { position: absolute; bottom: -15px; left: 50%; transform: translateX(-50%); width: 80%; height: 30px; z-index: 5; border-radius: 4px; }
    
    .shape-circle { border-radius: 50%; }
    .shape-shield { clip-path: polygon(50% 100%, 0 80%, 0 0, 100% 0, 100% 80%); }
    .shape-hexagon { clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); }
  </style>
</head>
<body class="bg-slate-50 text-slate-800">

  <nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-[90rem] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-x-3">
        <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/30">
          <span class="text-white font-bold text-xl">C</span>
        </div>
        <span class="font-bold text-xl tracking-tight">Credity Admin</span>
      </div>
      <a href="/logout" class="px-5 py-2 text-sm font-medium border border-slate-200 rounded-full hover:bg-slate-50">Logout</a>
    </div>
  </nav>

  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 pt-8 pb-20">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Credential Manager</h1>
    </div>

    <div class="flex border-b border-slate-200 mb-8 overflow-x-auto">
      <button onclick="showTab('certificates')" class="tab-btn px-6 py-3 font-semibold border-b-2 border-blue-600 text-blue-600" id="tab-certificates">Certificates</button>
      <button onclick="showTab('badges')" class="tab-btn px-6 py-3 font-medium text-slate-500 hover:text-slate-700" id="tab-badges">Badges</button>
    </div>

    <div id="certificates-tab" class="tab-content">
      <form action="/create-credential" method="POST" class="flex flex-col xl:flex-row gap-8">
        <input type="hidden" name="type" value="certificate">
        <input type="hidden" id="selected-cert-logo" name="logoUrl" value="">
        
        <div class="xl:w-3/5 glass p-6 md:p-8 rounded-3xl space-y-6">
          
          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <label class="text-xs font-bold text-blue-800 uppercase tracking-wider block mb-2">Link to Assessment (Required)</label>
            <select name="assessmentId" class="modern-input w-full px-4 py-3 rounded-xl text-sm font-medium" required>
              <option value="">-- Select Assessment --</option>
              <option value="1">Introduction to Computer Science (Final)</option>
              <option value="2">Advanced Mathematics Midterm</option>
              <option value="3">Corporate Compliance Training 2026</option>
            </select>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Style Template</label>
            <div class="flex gap-3">
              <button type="button" onclick="setTemplate('template-classic')" class="px-4 py-2 bg-white border border-slate-300 rounded-xl text-sm font-medium hover:border-blue-500 focus:border-blue-500">Classic</button>
              <button type="button" onclick="setTemplate('template-modern')" class="px-4 py-2 bg-white border border-slate-300 rounded-xl text-sm font-medium hover:border-blue-500 focus:border-blue-500">Modern</button>
              <button type="button" onclick="setTemplate('template-geometric')" class="px-4 py-2 bg-white border border-slate-300 rounded-xl text-sm font-medium hover:border-blue-500 focus:border-blue-500">Geometric</button>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Title</label>
              <input type="text" name="title" id="cert-title" value="Certificate of Completion" oninput="updateCert()" class="modern-input w-full px-4 py-3 rounded-xl text-sm">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Theme Color</label>
              <input type="color" name="designColor" id="cert-color" value="#1e40af" oninput="updateCert()" class="w-full h-11 p-0 border-0 rounded-xl cursor-pointer">
            </div>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Description</label>
            <textarea name="description" id="cert-desc" oninput="updateCert()" class="modern-input w-full px-4 py-3 rounded-xl h-20 text-sm">has successfully completed the assessment with distinction.</textarea>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Professional Logos</label>
            <div id="logo-grid" class="flex gap-3 overflow-x-auto pb-2">
              </div>
          </div>

          <div class="grid md:grid-cols-2 gap-5 p-5 bg-slate-50 rounded-2xl border border-slate-100">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Verification Method</label>
              <label class="flex items-center gap-2 mb-2 text-sm"><input type="radio" name="useQR" value="false" checked onchange="toggleVerification('sig')"> Authorized Signature</label>
              <label class="flex items-center gap-2 text-sm"><input type="radio" name="useQR" value="true" onchange="toggleVerification('qr')"> Secure QR Code (Recommended)</label>
              
              <input type="text" id="sig-input" name="signature" value="Dr. Admin" oninput="updateCert()" class="modern-input w-full mt-3 px-3 py-2 rounded-lg text-sm" placeholder="Signature Name">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Expiration</label>
              <label class="flex items-center gap-2 mb-2 text-sm"><input type="checkbox" id="forever-cert" onchange="toggleExpiry('cert')" checked> Never Expires</label>
              <input type="date" id="expiry-cert" name="expiry" class="modern-input w-full px-3 py-2 rounded-lg text-sm opacity-50 pointer-events-none">
            </div>
          </div>

          <button type="submit" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl">Issue Certificate</button>
        </div>

        <div class="xl:w-2/5 cert-container">
          <div class="sticky top-24">
            <h3 class="text-sm font-bold text-slate-400 uppercase mb-4">Live Preview</h3>
            
            <div id="cert-preview" class="certificate-preview template-classic w-full aspect-[1.414] p-[5%] flex flex-col text-center justify-between" style="border-color: #1e40af;">
              <div class="mt-[2%]">
                <img id="preview-logo" src="" class="h-[8cqi] mx-auto mb-[4%] hidden object-contain">
                <div class="text-[2cqi] tracking-[0.2em] text-slate-500 uppercase font-sans mb-[2%]">This is to certify that</div>
                <div class="text-[5cqi] font-bold italic text-slate-800">[Student Name]</div>
              </div>

              <div class="px-[10%]">
                <div id="preview-title" class="text-[3cqi] font-bold uppercase tracking-widest mb-[3%] text-[#1e40af]">Certificate of Completion</div>
                <div id="preview-desc" class="text-[2cqi] text-slate-600 font-sans">has successfully completed the assessment with distinction.</div>
              </div>

              <div class="flex justify-between items-end mt-auto pt-[4%] border-t border-slate-200">
                <div class="text-left">
                  <div class="text-[1.5cqi] font-sans font-medium text-slate-800" id="preview-date">Valid: Forever</div>
                </div>
                <div class="text-right flex flex-col items-end">
                  <div id="preview-sig-container">
                    <div id="preview-sig" class="text-[2.5cqi] font-medium italic text-slate-800">Dr. Admin</div>
                    <div class="text-[1.2cqi] text-slate-400 font-sans uppercase">Authorized Signature</div>
                  </div>
                  <div id="preview-qr-container" class="hidden">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=Verify" class="w-[6cqi] h-[6cqi] mb-1 opacity-80">
                    <div class="text-[1cqi] text-slate-400 font-sans uppercase text-center">Scan to Verify</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>

    <div id="badges-tab" class="tab-content hidden">
      <form action="/create-credential" method="POST" class="flex flex-col md:flex-row gap-8">
        <input type="hidden" name="type" value="badge">
        <input type="hidden" id="selected-badge-icon" name="badgeIcon" value="fa-award">
        
        <div class="md:w-1/2 glass p-6 md:p-8 rounded-3xl space-y-6">
          
          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <label class="text-xs font-bold text-blue-800 uppercase tracking-wider block mb-2">Link to Assessment (Required)</label>
            <select name="assessmentId" class="modern-input w-full px-4 py-3 rounded-xl text-sm font-medium" required>
              <option value="">-- Select Assessment --</option>
              <option value="1">Introduction to Computer Science (Final)</option>
            </select>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Badge Title</label>
            <input type="text" name="title" id="badge-title" value="Python Master" oninput="updateBadge()" class="modern-input w-full px-4 py-3 rounded-xl">
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Shape</label>
              <select id="badge-shape" onchange="updateBadge()" class="modern-input w-full px-4 py-3 rounded-xl">
                <option value="shape-shield">Shield</option>
                <option value="shape-hexagon">Hexagon</option>
                <option value="shape-circle">Circle</option>
              </select>
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Main Color</label>
              <input type="color" name="designColor" id="badge-color" value="#8b5cf6" oninput="updateBadge()" class="w-full h-12 p-0 border-0 rounded-xl cursor-pointer">
            </div>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Badge Icon</label>
            <div class="grid grid-cols-6 gap-2">
              <button type="button" onclick="setBadgeIcon('fa-award')" class="p-3 bg-slate-100 rounded-lg hover:bg-slate-200"><i class="fa-solid fa-award text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-code')" class="p-3 bg-slate-100 rounded-lg hover:bg-slate-200"><i class="fa-solid fa-code text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-bolt')" class="p-3 bg-slate-100 rounded-lg hover:bg-slate-200"><i class="fa-solid fa-bolt text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-brain')" class="p-3 bg-slate-100 rounded-lg hover:bg-slate-200"><i class="fa-solid fa-brain text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-chart-line')" class="p-3 bg-slate-100 rounded-lg hover:bg-slate-200"><i class="fa-solid fa-chart-line text-xl"></i></button>
              <button type="button" onclick="setBadgeIcon('fa-globe')" class="p-3 bg-slate-100 rounded-lg hover:bg-slate-200"><i class="fa-solid fa-globe text-xl"></i></button>
            </div>
          </div>

          <div>
            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Expiration</label>
            <label class="flex items-center gap-2 mb-2 text-sm"><input type="checkbox" id="forever-badge" onchange="toggleExpiry('badge')" checked> Never Expires</label>
            <input type="date" id="expiry-badge" name="expiry" class="modern-input w-full px-3 py-2 rounded-lg text-sm opacity-50 pointer-events-none">
          </div>

          <button type="submit" class="w-full py-4 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-xl">Generate Badge</button>
        </div>

        <div class="md:w-1/2 flex items-center justify-center bg-slate-100 rounded-3xl p-12 border border-slate-200">
          <div class="text-center w-full">
            <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-12">Live Preview</h3>
            
            <div class="badge-preview-container relative w-48 mx-auto h-48">
              <div id="preview-badge-base" class="badge-base shape-shield w-full h-full shadow-inner flex flex-col" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">
                <div class="absolute inset-2 border-2 border-white/30" id="preview-badge-inner" style="clip-path: inherit;"></div>
                <i id="preview-badge-icon" class="fa-solid fa-award text-5xl text-white mb-2 drop-shadow-md z-20"></i>
                <div id="preview-badge-text" class="text-white font-bold text-sm tracking-wide uppercase px-4 z-20 text-center leading-tight">Python Master</div>
              </div>
              <div id="preview-badge-ribbon" class="badge-ribbon shadow-lg flex items-center justify-center text-[10px] font-bold text-white uppercase tracking-widest" style="background-color: #4c1d95;">
                Verified
              </div>
            </div>
            
          </div>
        </div>
      </form>
    </div>

  </div>

  <script>
    // 1. Initial Data Setup
    const professionalLogos = [
      'https://upload.wikimedia.org/wikipedia/commons/a/a7/React-icon.svg',
      'https://upload.wikimedia.org/wikipedia/commons/c/c3/Python-logo-notext.svg',
      'https://upload.wikimedia.org/wikipedia/commons/6/6a/JavaScript-logo.png',
      'https://upload.wikimedia.org/wikipedia/commons/2/27/CISCO_logo.svg',
      'https://api.dicebear.com/7.x/shapes/svg?seed=AcmeCorp&backgroundColor=transparent',
      'https://api.dicebear.com/7.x/shapes/svg?seed=GlobalTech&backgroundColor=transparent'
    ];

    function init() {
      const logoGrid = document.getElementById('logo-grid');
      professionalLogos.forEach(url => {
        const img = document.createElement('img');
        img.src = url;
        img.className = 'w-12 h-12 p-2 cursor-pointer bg-white rounded-lg border hover:border-blue-500 object-contain';
        img.onclick = () => selectCertLogo(url, img);
        logoGrid.appendChild(img);
      });
      updateCert();
      updateBadge();
    }

    // 2. Certificate Logic
    function setTemplate(className) {
      const preview = document.getElementById('cert-preview');
      preview.className = `certificate-preview ${className} w-full aspect-[1.414] p-[5%] flex flex-col text-center justify-between`;
    }

    function selectCertLogo(url, el) {
      document.querySelectorAll('#logo-grid img').forEach(img => img.classList.remove('border-blue-500'));
      el.classList.add('border-blue-500');
      document.getElementById('selected-cert-logo').value = url;
      document.getElementById('preview-logo').src = url;
      document.getElementById('preview-logo').classList.remove('hidden');
    }

    function toggleVerification(type) {
      const isSig = type === 'sig';
      document.getElementById('sig-input').classList.toggle('opacity-50', !isSig);
      document.getElementById('sig-input').classList.toggle('pointer-events-none', !isSig);
      
      document.getElementById('preview-sig-container').classList.toggle('hidden', !isSig);
      document.getElementById('preview-qr-container').classList.toggle('hidden', isSig);
    }

    function toggleExpiry(type) {
      const isForever = document.getElementById(`forever-${type}`).checked;
      const input = document.getElementById(`expiry-${type}`);
      input.classList.toggle('opacity-50', isForever);
      input.classList.toggle('pointer-events-none', isForever);
      
      if (type === 'cert') {
        const displayDate = isForever ? 'Forever' : (input.value || 'Not set');
        document.getElementById('preview-date').innerText = `Valid: ${displayDate}`;
      }
    }

    function updateCert() {
      const title = document.getElementById('cert-title').value;
      const desc = document.getElementById('cert-desc').value;
      const color = document.getElementById('cert-color').value;
      const sig = document.getElementById('sig-input').value;

      document.getElementById('preview-title').innerText = title;
      document.getElementById('preview-title').style.color = color;
      document.getElementById('cert-preview').style.borderColor = color;
      document.getElementById('preview-desc').innerText = desc;
      document.getElementById('preview-sig').innerText = sig;
      
      // Update expiry text if not forever
      if (!document.getElementById('forever-cert').checked) {
        document.getElementById('preview-date').innerText = `Valid until: ${document.getElementById('expiry-cert').value}`;
      }
    }

    // 3. Badge Logic
    function setBadgeIcon(iconClass) {
      document.getElementById('selected-badge-icon').value = iconClass;
      document.getElementById('preview-badge-icon').className = `fa-solid ${iconClass} text-5xl text-white mb-2 drop-shadow-md z-20`;
    }

    function updateBadge() {
      const title = document.getElementById('badge-title').value;
      const shape = document.getElementById('badge-shape').value;
      const hexColor = document.getElementById('badge-color').value;
      
      document.getElementById('preview-badge-text').innerText = title;
      
      const base = document.getElementById('preview-badge-base');
      const inner = document.getElementById('preview-badge-inner');
      const ribbon = document.getElementById('preview-badge-ribbon');

      // Update Shape
      base.className = `badge-base ${shape} w-full h-full shadow-inner flex flex-col`;
      inner.style.clipPath = 'inherit';

      // Advanced Color Generation (Darken for gradient and ribbon)
      // This creates a professional 3D-like effect for the badge based on a single hex color
      base.style.background = `linear-gradient(135deg, ${hexColor}, ${adjustColor(hexColor, -40)})`;
      ribbon.style.backgroundColor = adjustColor(hexColor, -60);
    }

    // Helper: Darken hex color
    function adjustColor(color, amount) {
      return '#' + color.replace(/^#/, '').replace(/../g, color => ('0'+Math.min(255, Math.max(0, parseInt(color, 16) + amount)).toString(16)).substr(-2));
    }

    // Tabs logic
    function showTab(tab) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(tab + '-tab').classList.remove('hidden');
      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('border-b-2', 'border-blue-600', 'text-blue-600');
        el.classList.add('text-slate-500');
      });
      document.getElementById('tab-' + tab).classList.remove('text-slate-500');
      document.getElementById('tab-' + tab).classList.add('border-b-2', 'border-blue-600', 'text-blue-600');
    }

    window.onload = init;
  </script>
</body>
</html>
