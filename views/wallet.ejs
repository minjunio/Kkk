<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Tensor Wallet | Wallet</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>

  <style>
    :root {
      --bg-base: #070a0f;
      --bg-base-2: #0b0f17;
      --bg-panel: rgba(17, 24, 39, 0.86);
      --bg-panel-solid: #111827;
      --bg-card: rgba(15, 23, 42, 0.72);
      --bg-hover: rgba(45, 55, 72, 0.9);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.14);
      --border-strong: rgba(148, 163, 184, 0.24);

      --green: #0ecb81;
      --green-glow: rgba(14, 203, 129, 0.18);
      --red: #f6465d;
      --red-glow: rgba(246, 70, 93, 0.18);
      --tensor: #8b5cf6;
      --tensor-2: #3b82f6;
      --tensor-soft: rgba(139, 92, 246, 0.18);
      --yellow: #f59e0b;

      --shadow: 0 22px 70px rgba(0,0,0,0.38);
      --radius: 18px;
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="light"] {
      --bg-base: #f6f8fb;
      --bg-base-2: #eef2f8;
      --bg-panel: rgba(255,255,255,0.90);
      --bg-panel-solid: #ffffff;
      --bg-card: rgba(255,255,255,0.84);
      --bg-hover: rgba(226, 232, 240, 0.9);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border: rgba(15, 23, 42, 0.10);
      --border-strong: rgba(15, 23, 42, 0.18);
      --shadow: 0 18px 55px rgba(15,23,42,0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.22), transparent 28%),
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.14), transparent 24%),
        linear-gradient(180deg, var(--bg-base), var(--bg-base-2));
      color: var(--text-main);
      font-variant-numeric: tabular-nums;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent 70%);
      z-index: 0;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
      outline: none;
      border: none;
      background: transparent;
      color: inherit;
    }

    button {
      cursor: pointer;
      transition: transform 0.08s ease, opacity 0.12s ease, background 0.12s ease, border-color 0.12s ease;
    }

    button:active {
      transform: scale(0.98);
    }

    button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .app {
      position: relative;
      z-index: 1;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: calc(10px + var(--safe-top)) 14px 10px;
      background: rgba(7, 10, 15, 0.78);
      backdrop-filter: blur(22px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    [data-theme="light"] .topbar {
      background: rgba(255,255,255,0.78);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 950;
      font-size: 1.08rem;
      color: var(--text-main);
    }

    .brand-logo {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,0.35), transparent 22%),
        linear-gradient(135deg, var(--tensor), var(--tensor-2));
      box-shadow: 0 12px 30px rgba(139, 92, 246, 0.35);
    }

    .brand-logo svg {
      width: 19px;
      height: 19px;
      stroke: white;
    }

    .top-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .icon-btn {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-main);
    }

    .page {
      width: min(1640px, 100%);
      margin: 0 auto;
      padding: 12px 12px calc(84px + var(--safe-bottom));
      display: grid;
      gap: 14px;
    }

    @media (min-width: 1100px) {
      .page {
        grid-template-columns: minmax(0, 1fr) 380px;
        align-items: start;
        padding-bottom: 18px;
      }
    }

    .main-column {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
    }

    .panel {
      border-radius: var(--radius);
      padding: 14px;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
    }

    .hero {
      padding: 16px;
      border-radius: 24px;
      background:
        radial-gradient(circle at 0% 0%, rgba(139,92,246,0.34), transparent 28%),
        radial-gradient(circle at 100% 0%, rgba(14,203,129,0.16), transparent 24%),
        linear-gradient(135deg, rgba(17,24,39,0.96), rgba(7,10,15,0.84));
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      overflow: hidden;
      position: relative;
      backdrop-filter: blur(18px);
    }

    .hero::before {
      content: "";
      position: absolute;
      top: -150px;
      right: -120px;
      width: 280px;
      height: 280px;
      background: radial-gradient(circle, rgba(139,92,246,0.25), transparent 68%);
      pointer-events: none;
    }

    .hero-head {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
      position: relative;
      z-index: 1;
    }

    .wallet-label {
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }

    .wallet-balance-wrap {
      margin-top: 8px;
      display: flex;
      align-items: flex-end;
      gap: 12px;
      flex-wrap: wrap;
    }

    .wallet-balance {
      font-size: clamp(2.4rem, 9vw, 5.2rem);
      font-weight: 950;
      letter-spacing: -0.085em;
      line-height: 0.95;
      text-shadow: 0 18px 60px rgba(139,92,246,0.28);
    }

    .portfolio-pnl-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 12px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 950;
      border: 1px solid rgba(14,203,129,0.26);
      background: rgba(14,203,129,0.14);
      color: var(--green);
      margin-bottom: 7px;
      white-space: nowrap;
    }

    .portfolio-pnl-pill.negative {
      color: var(--red);
      background: var(--red-glow);
      border-color: rgba(246,70,93,0.26);
    }

    .portfolio-mini-grid {
      margin-top: 14px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      position: relative;
      z-index: 1;
    }

    .portfolio-mini-card {
      padding: 12px;
      border-radius: 16px;
      background: rgba(7,10,15,0.42);
      border: 1px solid var(--border);
    }

    [data-theme="light"] .portfolio-mini-card {
      background: rgba(255,255,255,0.72);
    }

    .portfolio-mini-label {
      color: var(--text-muted);
      font-size: 0.64rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .portfolio-mini-value {
      margin-top: 6px;
      font-weight: 950;
      font-size: 1.05rem;
    }

    .wallet-sub {
      margin-top: 8px;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 800;
      line-height: 1.4;
      max-width: 720px;
    }

    .network-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      border: 1px solid rgba(139,92,246,0.34);
      background: rgba(139,92,246,0.14);
      color: #c4b5fd;
      font-size: 0.74rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 15px;
      position: relative;
      z-index: 1;
    }

    .primary-btn,
    .mini-btn,
    .danger-btn,
    .green-btn,
    .yellow-btn {
      min-height: 40px;
      border-radius: 13px;
      padding: 9px 12px;
      font-size: 0.78rem;
      font-weight: 950;
      border: 1px solid transparent;
      text-align: center;
    }

    .primary-btn {
      color: #fff;
      background: linear-gradient(135deg, var(--tensor), var(--tensor-2));
      box-shadow: 0 14px 30px rgba(59,130,246,0.18);
    }

    .green-btn {
      color: #fff;
      background: linear-gradient(135deg, #0ecb81, #10b981);
      box-shadow: 0 14px 30px rgba(14,203,129,0.14);
    }

    .yellow-btn {
      color: var(--yellow);
      background: rgba(245,158,11,0.14);
      border-color: rgba(245,158,11,0.26);
    }

    .mini-btn {
      background: var(--bg-card);
      color: var(--text-main);
      border-color: var(--border);
    }

    .danger-btn {
      background: var(--red-glow);
      color: var(--red);
      border-color: rgba(246,70,93,0.24);
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 1rem;
      font-weight: 950;
    }

    .section-title-icon {
      width: 28px;
      height: 28px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: var(--tensor-soft);
      color: #c4b5fd;
    }

    .section-sub {
      color: var(--text-muted);
      font-size: 0.76rem;
      font-weight: 760;
      line-height: 1.42;
      margin-top: 3px;
    }

    .asset-scroll {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 2px 2px 10px;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .asset-scroll::-webkit-scrollbar {
      display: none;
    }

    .asset-card {
      flex: 0 0 244px;
      scroll-snap-align: start;
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      background: rgba(7, 10, 15, 0.48);
      border: 1px solid var(--border);
      padding: 12px;
      cursor: pointer;
      transition: 0.16s ease;
    }

    [data-theme="light"] .asset-card {
      background: rgba(255,255,255,0.82);
    }

    .asset-card:hover,
    .asset-card.active {
      border-color: rgba(139,92,246,0.52);
      transform: translateY(-1px);
      box-shadow: 0 18px 40px rgba(0,0,0,0.14);
    }

    .asset-card.active::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--tensor), transparent);
    }

    .asset-top {
      display: flex;
      justify-content: space-between;
      gap: 9px;
      align-items: center;
    }

    .coin {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
    }

    .coin-icon {
      width: 38px;
      height: 38px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, rgba(139,92,246,0.88), rgba(59,130,246,0.82));
      color: white;
      font-weight: 950;
      overflow: hidden;
      flex: 0 0 auto;
    }

    .coin-icon svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .coin-name {
      min-width: 0;
    }

    .coin-symbol {
      font-weight: 950;
      font-size: 0.94rem;
      line-height: 1.1;
    }

    .coin-full {
      margin-top: 3px;
      color: var(--text-muted);
      font-size: 0.68rem;
      font-weight: 820;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .asset-price {
      margin-top: 12px;
      font-weight: 950;
      font-size: 1.12rem;
      letter-spacing: -0.03em;
    }

    .asset-row {
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 850;
    }

    .asset-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
      margin-top: 10px;
    }

    .asset-actions button {
      min-height: 32px;
      border-radius: 10px;
      font-size: 0.68rem;
      font-weight: 950;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-main);
    }

    .text-green {
      color: var(--green);
    }

    .text-red {
      color: var(--red);
    }

    .side-panel {
      position: sticky;
      top: 68px;
      height: fit-content;
      display: grid;
      gap: 14px;
    }

    .tabs {
      display: flex;
      gap: 7px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .tabs::-webkit-scrollbar {
      display: none;
    }

    .tab {
      padding: 8px 10px;
      font-weight: 900;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.82rem;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }

    .tab.active {
      color: var(--text-main);
      border-bottom-color: var(--tensor);
    }

    .settings-tabs {
      display: flex;
      gap: 8px;
      padding: 4px;
      background: rgba(7,10,15,0.38);
      border: 1px solid var(--border);
      border-radius: 15px;
      margin-bottom: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .settings-tabs::-webkit-scrollbar {
      display: none;
    }

    .settings-tab {
      min-height: 34px;
      padding: 7px 10px;
      border-radius: 12px;
      font-size: 0.72rem;
      font-weight: 950;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .settings-tab.active {
      color: white;
      background: linear-gradient(135deg, var(--tensor), var(--tensor-2));
    }

    .qr-card {
      display: grid;
      gap: 12px;
    }

    .qr-box {
      width: 178px;
      height: 178px;
      margin: 0 auto;
      background: white;
      border-radius: 18px;
      padding: 12px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,0.3);
      box-shadow: 0 18px 45px rgba(0,0,0,0.20);
    }

    #qrCanvas,
    #modalQrCanvas {
      width: 154px !important;
      height: 154px !important;
      display: block;
    }

    .address-box,
    .seed-box,
    .balance-box {
      padding: 11px;
      border-radius: 14px;
      background: rgba(7,10,15,0.48);
      border: 1px solid var(--border);
      word-break: break-all;
      font-size: 0.76rem;
      color: var(--text-main);
      font-weight: 850;
      line-height: 1.44;
      text-align: center;
    }

    .balance-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      text-align: left;
      color: var(--text-muted);
    }

    .balance-box strong {
      color: var(--text-main);
      font-size: 0.9rem;
    }

    .seed-box {
      text-align: left;
      user-select: text;
      filter: blur(5px);
      min-height: 52px;
    }

    .seed-box.revealed {
      filter: none;
    }

    [data-theme="light"] .address-box,
    [data-theme="light"] .seed-box,
    [data-theme="light"] .balance-box {
      background: rgba(248,250,252,0.90);
    }

    .network-select {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 7px;
    }

    .network-btn {
      min-height: 36px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-muted);
      font-size: 0.72rem;
      font-weight: 950;
    }

    .network-btn.active {
      background: rgba(139,92,246,0.16);
      color: #c4b5fd;
      border-color: rgba(139,92,246,0.38);
    }

    .form {
      display: grid;
      gap: 10px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .field {
      display: grid;
      gap: 6px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      color: var(--text-muted);
      font-size: 0.67rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .field input,
    .field select,
    .field textarea {
      min-height: 42px;
      background: rgba(7,10,15,0.58);
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 9px 11px;
      font-size: 0.84rem;
      font-weight: 850;
      width: 100%;
    }

    [data-theme="light"] .field input,
    [data-theme="light"] .field select,
    [data-theme="light"] .field textarea {
      background: rgba(248,250,252,0.92);
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: rgba(139,92,246,0.72);
      box-shadow: 0 0 0 3px rgba(139,92,246,0.10);
    }

    .mini-note {
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 760;
      line-height: 1.44;
    }

    .tx-list {
      display: grid;
      gap: 9px;
    }

    .tx-card {
      padding: 11px;
      border-radius: 15px;
      border: 1px solid var(--border);
      background: rgba(7,10,15,0.42);
    }

    [data-theme="light"] .tx-card {
      background: rgba(255,255,255,0.78);
    }

    .tx-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
    }

    .tx-title {
      font-weight: 950;
      font-size: 0.82rem;
    }

    .tx-date {
      color: var(--text-muted);
      font-size: 0.66rem;
      font-weight: 800;
    }

    .tx-detail {
      margin-top: 7px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 760;
      line-height: 1.44;
      word-break: break-all;
    }

    .empty {
      padding: 22px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 800;
      border: 1px dashed var(--border-strong);
      border-radius: 16px;
      background: rgba(7,10,15,0.22);
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: calc(74px + var(--safe-bottom));
      transform: translateX(-50%) translateY(20px);
      z-index: 200;
      min-width: 220px;
      max-width: calc(100% - 28px);
      padding: 11px 13px;
      border-radius: 14px;
      background: rgba(15,23,42,0.94);
      border: 1px solid var(--border-strong);
      color: white;
      font-weight: 900;
      font-size: 0.78rem;
      box-shadow: 0 18px 50px rgba(0,0,0,0.35);
      opacity: 0;
      pointer-events: none;
      transition: 0.18s ease;
      text-align: center;
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .bottom-nav {
      position: fixed;
      left: 0;
      bottom: 0;
      width: 100%;
      height: calc(60px + var(--safe-bottom));
      background: rgba(7,10,15,0.86);
      backdrop-filter: blur(22px);
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding-bottom: var(--safe-bottom);
      z-index: 60;
    }

    [data-theme="light"] .bottom-nav {
      background: rgba(255,255,255,0.86);
    }

    @media (min-width: 1024px) {
      .bottom-nav {
        display: none;
      }
    }

    .bottom-nav button {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 800;
      width: 100%;
      height: 100%;
      justify-content: center;
    }

    .bottom-nav button svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.5;
    }

    .bottom-nav button.active {
      color: var(--text-main);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(0,0,0,0.66);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      backdrop-filter: blur(12px);
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal {
      width: min(620px, 100%);
      max-height: 90vh;
      overflow: auto;
      background: var(--bg-panel-solid);
      border: 1px solid var(--border-strong);
      border-radius: 22px;
      padding: 16px;
      box-shadow: 0 30px 90px rgba(0,0,0,0.50);
    }

    .modal-title {
      font-size: 1.08rem;
      font-weight: 950;
    }

    .modal-desc {
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 780;
      line-height: 1.44;
      margin-top: 6px;
    }

    .modal-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 13px;
    }

    @media (max-width: 720px) {
      .brand span:last-child {
        display: none;
      }

      .portfolio-mini-grid {
        grid-template-columns: 1fr;
      }

      .network-select {
        grid-template-columns: 1fr 1fr;
      }

      .hero-head {
        flex-direction: column;
      }

      .hero-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .asset-card {
        flex-basis: 218px;
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <script>
      const SERVER_EMAIL = <%- JSON.stringify(typeof email !== 'undefined' ? email : '') %>;
      const SERVER_ROLE = <%- JSON.stringify(typeof role !== 'undefined' ? role : '') %>;
      const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
    </script>

    <header class="topbar">
      <a href="/wallet" class="brand">
        <span class="brand-logo">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H19a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5.5A2.5 2.5 0 0 1 3 18.5v-11Z"/>
            <path d="M18 12h.01"/>
            <path d="M3 8h18"/>
          </svg>
        </span>
        <span>Tensor Wallet</span>
      </a>

      <div class="top-actions">
        <button class="icon-btn" onclick="refreshWallet()" aria-label="Refresh wallet">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 12a9 9 0 0 1-15.5 6.2"/>
            <path d="M3 12A9 9 0 0 1 18.5 5.8"/>
            <path d="M18 2v4h4"/>
            <path d="M6 22v-4H2"/>
          </svg>
        </button>

        <button class="icon-btn" onclick="toggleTheme()" aria-label="Toggle theme">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <button class="icon-btn" onclick="window.location.href='/logout'" aria-label="Logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <path d="M16 17l5-5-5-5"/>
            <path d="M21 12H9"/>
          </svg>
        </button>
      </div>
    </header>

    <main class="page">
      <div class="main-column">
        <section class="hero">
          <div class="hero-head">
            <div>
              <div class="wallet-label">Total Portfolio Value</div>

              <div class="wallet-balance-wrap">
                <div class="wallet-balance">$<span id="totalBalance">0.00</span></div>
                <div id="portfolioPnlPill" class="portfolio-pnl-pill">+$0.00 • +0.00%</div>
              </div>

              <div class="wallet-sub">
                Crypto wallet and Tensor wallet are separated. Select a currency first, then receive or send from the correct wallet.
              </div>
            </div>

            <div class="network-pill" id="selectedNetworkPill">Crypto • USDT • Ethereum</div>
          </div>

          <div class="portfolio-mini-grid">
            <div class="portfolio-mini-card">
              <div class="portfolio-mini-label">Crypto Value</div>
              <div class="portfolio-mini-value">$<span id="cryptoTotalValue">0.00</span></div>
            </div>

            <div class="portfolio-mini-card">
              <div class="portfolio-mini-label">Tensor Value</div>
              <div class="portfolio-mini-value">$<span id="tensorTotalValue">0.00</span></div>
            </div>

            <div class="portfolio-mini-card">
              <div class="portfolio-mini-label">Selected Balance</div>
              <div class="portfolio-mini-value"><span id="selectedHeroBalance">0.00 USDT</span></div>
            </div>
          </div>

          <div class="hero-actions">
            <button class="primary-btn" onclick="window.location.href='/trading'">Open Trading</button>
            <button class="green-btn" onclick="openReceiveModal()">Receive</button>
            <button class="mini-btn" onclick="focusSendForm()">Send</button>
            <button class="yellow-btn" onclick="switchSettingsTab('seeds')">Settings</button>
          </div>
        </section>

        <section class="panel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"/>
                    <path d="M12 6v12"/>
                  </svg>
                </span>
                Crypto Wallet
              </div>
              <div class="section-sub">Normal crypto assets. Swipe horizontally to view all coins.</div>
            </div>

            <button class="mini-btn" onclick="refreshWallet()">Refresh</button>
          </div>

          <div class="asset-scroll" id="normalAssetGrid"></div>
        </section>

        <section class="panel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4Z"/>
                    <path d="M9 12l2 2 4-5"/>
                  </svg>
                </span>
                Tensor Wallet
              </div>
              <div class="section-sub">Tensor token currencies. Swipe horizontally to view all tokens.</div>
            </div>
          </div>

          <div class="asset-scroll" id="tensorAssetGrid"></div>
        </section>

        <section class="panel" id="settingsPanel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z"/>
                    <path d="M19.4 15a1.8 1.8 0 0 0 .36 1.98l.05.05a2.1 2.1 0 0 1-2.97 2.97l-.05-.05a1.8 1.8 0 0 0-1.98-.36a1.8 1.8 0 0 0-1.1 1.65V21a2.1 2.1 0 0 1-4.2 0v-.08A1.8 1.8 0 0 0 8.4 19.3a1.8 1.8 0 0 0-1.98.36l-.05.05a2.1 2.1 0 1 1-2.97-2.97l.05-.05A1.8 1.8 0 0 0 3.8 15a1.8 1.8 0 0 0-1.65-1.1H2a2.1 2.1 0 0 1 0-4.2h.08A1.8 1.8 0 0 0 3.8 8.6a1.8 1.8 0 0 0-.36-1.98l-.05-.05A2.1 2.1 0 1 1 6.36 3.6l.05.05A1.8 1.8 0 0 0 8.4 4a1.8 1.8 0 0 0 1.1-1.65V2a2.1 2.1 0 0 1 4.2 0v.08A1.8 1.8 0 0 0 15 3.8a1.8 1.8 0 0 0 1.98-.36l.05-.05A2.1 2.1 0 1 1 20 6.36l-.05.05A1.8 1.8 0 0 0 19.6 8.4a1.8 1.8 0 0 0 1.65 1.1H22a2.1 2.1 0 0 1 0 4.2h-.08A1.8 1.8 0 0 0 19.4 15Z"/>
                  </svg>
                </span>
                Settings
              </div>
              <div class="section-sub">Seeds are hidden by default. Reveal only when private.</div>
            </div>
          </div>

          <div class="settings-tabs">
            <button id="settingsTabSeeds" class="settings-tab active" onclick="switchSettingsTab('seeds')">Seeds</button>
            <button id="settingsTabVault" class="settings-tab" onclick="switchSettingsTab('vault')">Vault</button>
          </div>

          <div id="settingsSeedsView">
            <div class="form-grid">
              <div class="field">
                <label>Crypto Wallet Seed</label>
                <div class="seed-box" id="normalSeedBox">Hidden</div>
                <button class="mini-btn" onclick="toggleSeedBlur('normalSeedBox')">Reveal / Hide</button>
              </div>

              <div class="field">
                <label>Tensor Wallet Seed</label>
                <div class="seed-box" id="tensorSeedBox">Hidden</div>
                <button class="mini-btn" onclick="toggleSeedBlur('tensorSeedBox')">Reveal / Hide</button>
              </div>

              <div class="field full">
                <button class="mini-btn" onclick="copyBothSeeds()">Copy Seeds</button>
              </div>
            </div>
          </div>

          <div id="settingsVaultView" style="display:none;">
            <div class="form">
              <div class="field">
                <label>Encrypted Vault JSON</label>
                <textarea id="vaultInput" rows="4" placeholder="Encrypted wallet payload"></textarea>
              </div>

              <button class="mini-btn" onclick="saveVault()">Save Vault</button>
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M3 3v18h18"/>
                    <path d="M7 15l4-4 3 3 5-6"/>
                  </svg>
                </span>
                Activity
              </div>
              <div class="section-sub">Wallet sends, deposits, open trades, copy trading, and history.</div>
            </div>
          </div>

          <div class="tabs">
            <div class="tab active" onclick="switchActivityTab('sends', this)">Sends</div>
            <div class="tab" onclick="switchActivityTab('deposits', this)">Deposits</div>
            <div class="tab" onclick="switchActivityTab('positions', this)">Positions</div>
            <div class="tab" onclick="switchActivityTab('copy', this)">Copy</div>
            <div class="tab" onclick="switchActivityTab('history', this)">History</div>
          </div>

          <div id="sendsView" class="tx-list"></div>
          <div id="depositsView" class="tx-list" style="display:none;"></div>
          <div id="positionsView" class="tx-list" style="display:none;"></div>
          <div id="copyView" class="tx-list" style="display:none;"></div>
          <div id="historyView" class="tx-list" style="display:none;"></div>
        </section>
      </div>

      <aside class="side-panel">
        <section class="panel qr-card">
          <div class="section-head" style="margin-bottom:0;">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                  </svg>
                </span>
                Receive
              </div>
              <div class="section-sub">Choose currency and network. QR stays visible in dark mode.</div>
            </div>
          </div>

          <div class="field">
            <label>Currency</label>
            <select id="receiveAsset"></select>
          </div>

          <div class="network-select" id="networkSelect"></div>

          <div class="qr-box">
            <canvas id="qrCanvas"></canvas>
          </div>

          <div class="address-box" id="receiveAddress">Loading address...</div>

          <button class="primary-btn" onclick="copyCurrentAddress()">Copy Receive Address</button>
        </section>

        <section class="panel" id="sendPanel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M22 2L11 13"/>
                    <path d="M22 2l-7 20-4-9-9-4 20-7Z"/>
                  </svg>
                </span>
                Send
              </div>
              <div class="section-sub">You cannot send more than your selected balance.</div>
            </div>
          </div>

          <div class="form">
            <div class="field">
              <label>Currency</label>
              <select id="sendAsset"></select>
            </div>

            <div class="balance-box">
              <span>Available Balance</span>
              <strong id="sendAvailableBalance">0.00 USDT</strong>
            </div>

            <div class="field">
              <label>Network</label>
              <select id="sendNetwork"></select>
            </div>

            <div class="field">
              <label>Amount</label>
              <input id="sendAmount" type="number" step="any" placeholder="0.00" oninput="validateSendAmountLive()">
            </div>

            <div class="field">
              <label>To Address</label>
              <textarea id="sendTo" rows="3" placeholder="Paste recipient address"></textarea>
            </div>

            <button id="sendButton" class="green-btn" onclick="sendSelectedAsset()">Send Asset</button>

            <div class="mini-note" id="sendValidationNote">
              Normal crypto calls <b>/api/wallet/send</b>. Tensor tokens call <b>/api/tensor/send</b>.
            </div>
          </div>
        </section>
      </aside>
    </main>

    <nav class="bottom-nav">
      <button class="active" onclick="window.location.href='/wallet'">
        <svg viewBox="0 0 24 24">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Wallet
      </button>

      <button onclick="window.location.href='/trading'">
        <svg viewBox="0 0 24 24">
          <path d="M3 3v18h18"/>
          <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/>
        </svg>
        Trading
      </button>
    </nav>

    <div class="modal-backdrop" id="receiveModal">
      <div class="modal">
        <div class="modal-title">Receive <span id="receiveModalAsset">USDT</span></div>
        <div class="modal-desc">Use the selected address below.</div>

        <div style="margin:14px auto 12px;" class="qr-box">
          <canvas id="modalQrCanvas"></canvas>
        </div>

        <div class="address-box" id="modalReceiveAddress">Loading...</div>

        <div class="modal-actions">
          <button class="mini-btn" onclick="closeReceiveModal()">Close</button>
          <button class="primary-btn" onclick="copyCurrentAddress()">Copy Address</button>
        </div>
      </div>
    </div>

    <div class="toast" id="toast">Copied</div>
  </div>

  <script>
    let currentTheme = localStorage.getItem('blue_theme') || 'dark';
    let walletState = SERVER_WALLET || {};
    let tensorRegistry = [];
    let prices = { live: {}, cg: {} };

    let selectedWalletType = 'crypto';
    let selectedAsset = 'USDT';
    let selectedTokenId = '';
    let selectedNetwork = normalizeNetwork(walletState.usdtNetwork || 'eth');
    let refreshInterval = null;

    const networkMap = {
      eth: { key: 'eth', network: 'Ethereum', short: 'ERC20', symbol: 'ETH', address: '' },
      arbitrum: { key: 'arbitrum', network: 'Arbitrum', short: 'ARB', symbol: 'ETH', address: '' },
      base: { key: 'base', network: 'Base', short: 'BASE', symbol: 'ETH', address: '' },
      polygon: { key: 'polygon', network: 'Polygon', short: 'POL', symbol: 'POL', address: '' },
      sol: { key: 'sol', network: 'Solana', short: 'SOL', symbol: 'SOL', address: '' },
      trx: { key: 'trx', network: 'TRON', short: 'TRC20', symbol: 'TRX', address: '' }
    };

    const assetMeta = {
      USDT: { name: 'Tether USD', symbol: 'USDT', stable: true, price: 1, networks: ['eth', 'arbitrum', 'base', 'polygon', 'sol', 'trx'] },
      OUSD: { name: 'Origin Dollar', symbol: 'OUSD', stable: true, price: 1, networks: ['eth', 'arbitrum', 'base', 'polygon'] },
      BTC: { name: 'Bitcoin', symbol: 'BTC', binance: 'BTCUSDT', priceId: 'bitcoin', networks: ['eth', 'arbitrum', 'base', 'polygon'] },
      ETH: { name: 'Ethereum', symbol: 'ETH', binance: 'ETHUSDT', priceId: 'ethereum', networks: ['eth', 'arbitrum', 'base', 'polygon'] },
      SOL: { name: 'Solana', symbol: 'SOL', binance: 'SOLUSDT', priceId: 'solana', networks: ['sol'] },
      BNB: { name: 'BNB', symbol: 'BNB', binance: 'BNBUSDT', priceId: 'binancecoin', networks: ['eth', 'arbitrum'] },
      XRP: { name: 'XRP', symbol: 'XRP', binance: 'XRPUSDT', priceId: 'ripple', networks: ['eth'] },
      DOGE: { name: 'Dogecoin', symbol: 'DOGE', binance: 'DOGEUSDT', priceId: 'dogecoin', networks: ['eth'] }
    };

    function normalizeNetwork(network) {
      const raw = String(network || '').trim().toLowerCase();

      if (raw.includes('arb')) return 'arbitrum';
      if (raw.includes('base')) return 'base';
      if (raw.includes('poly') || raw.includes('matic')) return 'polygon';
      if (raw.includes('sol')) return 'sol';
      if (raw.includes('tron') || raw.includes('trc') || raw.includes('trx')) return 'trx';
      if (raw.includes('eth') || raw.includes('erc')) return 'eth';

      return 'eth';
    }

    function formatMoney(n, decimals = 2) {
      return (Number(n) || 0).toLocaleString(undefined, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    function formatPriceSmart(price) {
      price = Number(price) || 0;

      if (price >= 1000) return price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (price >= 1) return price.toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });

      return price.toLocaleString(undefined, { minimumFractionDigits: 6, maximumFractionDigits: 6 });
    }

    function shortAddress(address) {
      const a = String(address || '');
      if (a.length <= 16) return a || '—';
      return `${a.slice(0, 7)}...${a.slice(-6)}`;
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function showToast(message = 'Done') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.classList.add('show');

      clearTimeout(showToast.timer);
      showToast.timer = setTimeout(() => toast.classList.remove('show'), 1800);
    }

    function toggleTheme() {
      currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', currentTheme);
      localStorage.setItem('blue_theme', currentTheme);
      drawQrCodes();
    }

    function coinSvg(symbol, type = 'crypto', iconSvg = '') {
      if (iconSvg && String(iconSvg).includes('<svg')) return iconSvg;

      const s = String(symbol || 'T').toUpperCase();
      const textMap = {
        USDT: '₮',
        OUSD: 'O',
        BTC: '₿',
        ETH: 'Ξ',
        SOL: '◎',
        BNB: 'B',
        XRP: 'X',
        DOGE: 'Ð'
      };

      const text = textMap[s] || s.slice(0, 1);

      const colors = type === 'tensor'
        ? ['#8b5cf6', '#3b82f6']
        : ({
            USDT: ['#26a17b', '#50af95'],
            OUSD: ['#f59e0b', '#f97316'],
            BTC: ['#f7931a', '#fbbf24'],
            ETH: ['#627eea', '#8b5cf6'],
            SOL: ['#14f195', '#9945ff'],
            BNB: ['#f3ba2f', '#f59e0b'],
            XRP: ['#334155', '#64748b'],
            DOGE: ['#c2a633', '#facc15']
          }[s] || ['#8b5cf6', '#3b82f6']);

      const id = `g_${type}_${s}_${Math.random().toString(16).slice(2)}`;

      return `
        <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="${id}" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="${colors[0]}"/>
              <stop offset="100%" stop-color="${colors[1]}"/>
            </linearGradient>
          </defs>
          <circle cx="24" cy="24" r="23" fill="url(#${id})"/>
          <circle cx="24" cy="24" r="17" fill="rgba(255,255,255,0.10)"/>
          ${type === 'tensor' ? '<path d="M15 14h18M24 14v20M18 34h12" stroke="#fff" stroke-width="3" stroke-linecap="round"/>' : ''}
          <text x="24" y="${type === 'tensor' ? '29' : '31'}" text-anchor="middle" font-family="Inter,Arial" font-size="${text.length > 1 ? 13 : 20}" font-weight="900" fill="#fff">${escapeHtml(text)}</text>
        </svg>
      `;
    }

    function getCryptoAddress(network = selectedNetwork) {
      const key = normalizeNetwork(network);

      return walletState.cryptoWallet?.receiveAddresses?.[key]
        || walletState.receiveAddresses?.[key]
        || walletState.receiveAddresses?.USDT?.[key]
        || networkMap[key]?.address
        || walletState.evmAddress
        || '';
    }

    function getTensorAddress(tokenId = selectedTokenId) {
      if (tokenId) {
        return walletState.tensorWallet?.tokenAddresses?.[tokenId]?.address
          || walletState.tensorTokenAddresses?.[tokenId]?.address
          || walletState.tensorTokenAddresses?.[tokenId]
          || walletState.tokenAddresses?.[tokenId]?.address
          || walletState.tensorAddress
          || '';
      }

      return walletState.tensorAddress || walletState.tensorWallet?.tensorAddress || '';
    }

    function getSelectedAddress() {
      if (selectedWalletType === 'tensor') return getTensorAddress(selectedTokenId);
      return getCryptoAddress(selectedNetwork);
    }

    function getAvailableNetworks() {
      if (selectedWalletType === 'tensor') return ['eth', 'arbitrum', 'base', 'polygon', 'sol'];

      const meta = assetMeta[selectedAsset];
      return meta?.networks || ['eth', 'arbitrum', 'base', 'polygon', 'sol', 'trx'];
    }

    function getCryptoBalance(symbol) {
      if (symbol === 'USDT') return Number(walletState.usdtBalance || 0);
      if (symbol === 'OUSD') return Number(walletState.ousdBalance || walletState.ousd || walletState.OUSD || 0);

      return Number(walletState[`${String(symbol).toLowerCase()}Balance`] || 0);
    }

    function getTensorBalance(tokenId) {
      return Number(walletState.tensorBalances?.[tokenId] || 0);
    }

    function getSelectedBalance() {
      if (selectedWalletType === 'tensor') return getTensorBalance(selectedTokenId);
      return getCryptoBalance(selectedAsset);
    }

    function getCryptoPrice(meta) {
      if (meta.stable) return 1;

      if (meta.binance && prices.live?.[meta.binance]?.price) {
        return Number(prices.live[meta.binance].price || 0);
      }

      if (meta.priceId && prices.cg?.[meta.priceId]?.usd) {
        return Number(prices.cg[meta.priceId].usd || 0);
      }

      return 0;
    }

    function getCryptoChange(meta) {
      if (meta.stable) return 0;

      if (meta.binance && prices.live?.[meta.binance]?.changePercent !== undefined) {
        return Number(prices.live[meta.binance].changePercent || 0);
      }

      if (meta.priceId && prices.cg?.[meta.priceId]?.usd_24h_change !== undefined) {
        return Number(prices.cg[meta.priceId].usd_24h_change || 0);
      }

      return 0;
    }

    function buildCryptoAssets() {
      return Object.values(assetMeta).map(meta => {
        const balance = getCryptoBalance(meta.symbol);
        const price = getCryptoPrice(meta);

        return {
          type: 'crypto',
          tokenId: '',
          symbol: meta.symbol,
          name: meta.name,
          balance,
          price,
          change: getCryptoChange(meta),
          usdValue: balance * price,
          stable: Boolean(meta.stable),
          networks: meta.networks
        };
      });
    }

    function buildTensorAssets() {
      return tensorRegistry.map(token => {
        const balance = getTensorBalance(token.id);
        const price = Number(token.price || 0);

        return {
          type: 'tensor',
          tokenId: token.id,
          symbol: token.symbol,
          name: token.name || token.symbol,
          balance,
          price,
          change: Number(token.changePercent24h || 0),
          usdValue: balance * price,
          iconSvg: token.iconSvg || token.svg || '',
          raw: token
        };
      });
    }

    function calculateTotals() {
      const cryptoTotal = buildCryptoAssets().reduce((sum, a) => sum + Number(a.usdValue || 0), 0);
      const tensorTotal = buildTensorAssets().reduce((sum, a) => sum + Number(a.usdValue || 0), 0);
      const total = cryptoTotal + tensorTotal;

      const realizedPnl = Number(walletState.realizedPnl || walletState.pnl || 0);
      const historyPnl = (walletState.orderHistory || []).reduce((sum, h) => sum + Number(h.pnl || 0), 0);
      const copyPnl = (walletState.copyTrades || []).reduce((sum, c) => sum + Number(c.pnl || 0), 0);
      const positionsPnl = (walletState.positions || []).reduce((sum, p) => sum + calculatePositionPnl(p), 0);

      const pnl = Number(walletState.portfolioPnl ?? (realizedPnl || historyPnl + copyPnl + positionsPnl));
      const basis = Math.max(1, total - pnl);
      const pct = (pnl / basis) * 100;

      return { cryptoTotal, tensorTotal, total, pnl, pct };
    }

    function selectCurrency(type, symbol, tokenId = '') {
      selectedWalletType = type === 'tensor' ? 'tensor' : 'crypto';
      selectedAsset = symbol;
      selectedTokenId = tokenId || '';

      const networks = getAvailableNetworks();
      if (!networks.includes(selectedNetwork)) {
        selectedNetwork = networks[0] || 'eth';
      }

      renderAll();
    }

    function parseSelectValue(value) {
      const [type, id] = String(value || '').split(':');

      if (type === 'tensor') {
        const token = tensorRegistry.find(t => String(t.id) === String(id));

        if (token) {
          return {
            type: 'tensor',
            symbol: token.symbol,
            tokenId: token.id
          };
        }
      }

      return {
        type: 'crypto',
        symbol: id || 'USDT',
        tokenId: ''
      };
    }

    function renderHero() {
      const totals = calculateTotals();
      const pnlPill = document.getElementById('portfolioPnlPill');
      const pnlSign = totals.pnl >= 0 ? '+' : '-';
      const pctSign = totals.pct >= 0 ? '+' : '';

      document.getElementById('totalBalance').textContent = formatMoney(totals.total);
      document.getElementById('cryptoTotalValue').textContent = formatMoney(totals.cryptoTotal);
      document.getElementById('tensorTotalValue').textContent = formatMoney(totals.tensorTotal);
      document.getElementById('selectedHeroBalance').textContent = `${formatPriceSmart(getSelectedBalance())} ${selectedAsset}`;

      pnlPill.textContent = `${pnlSign}$${formatMoney(Math.abs(totals.pnl))} • ${pctSign}${totals.pct.toFixed(2)}%`;
      pnlPill.classList.toggle('negative', totals.pnl < 0);

      const network = networkMap[selectedNetwork] || networkMap.eth;
      document.getElementById('selectedNetworkPill').textContent =
        `${selectedWalletType === 'tensor' ? 'Tensor' : 'Crypto'} • ${selectedAsset} • ${selectedWalletType === 'tensor' ? 'Tensor Address' : network.network}`;
    }

    function renderSendBalance() {
      const balance = getSelectedBalance();
