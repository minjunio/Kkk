<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Bluebook Wallet</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: light;
      --bg1:#e8f7ff;
      --bg2:#f8fbff;
      --bg3:#d5efff;
      --glass:rgba(255,255,255,.74);
      --glass2:rgba(255,255,255,.58);
      --solid:#ffffff;
      --soft:#f4f9ff;
      --text:#0f172a;
      --muted:#64748b;
      --blue:#0284c7;
      --blue2:#2563eb;
      --cyan:#38bdf8;
      --pink:#e11d48;
      --green:#16a34a;
      --orange:#d97706;
      --border:rgba(15,23,42,.08);
      --border2:rgba(2,132,199,.28);
      --shadow:0 24px 80px rgba(37,99,235,.14);
      --shadow2:0 12px 34px rgba(15,23,42,.08);
      --safe-top:env(safe-area-inset-top);
      --safe-bottom:env(safe-area-inset-bottom);
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg1:#06111f;
      --bg2:#050816;
      --bg3:#0b2940;
      --glass:rgba(13,22,40,.8);
      --glass2:rgba(17,29,51,.6);
      --solid:#0d1628;
      --soft:#111d33;
      --text:#f8fafc;
      --muted:#94a3b8;
      --blue:#38bdf8;
      --border:rgba(125,211,252,.13);
      --border2:rgba(56,189,248,.3);
      --shadow:0 24px 80px rgba(0,0,0,.36);
      --shadow2:0 12px 34px rgba(0,0,0,.22);
    }

    * {
      box-sizing:border-box;
      margin:0;
      padding:0;
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      -webkit-tap-highlight-color:transparent;
    }

    html,body {
      width:100%;
      max-width:100%;
      overflow-x:hidden;
    }

    body {
      min-height:100vh;
      color:var(--text);
      background:
        radial-gradient(circle at 8% 5%,rgba(56,189,248,.30),transparent 30%),
        radial-gradient(circle at 92% 12%,rgba(37,99,235,.16),transparent 24%),
        radial-gradient(circle at 50% 105%,rgba(14,165,233,.18),transparent 30%),
        linear-gradient(135deg,var(--bg1),var(--bg2) 46%,var(--bg3));
      background-attachment:fixed;
      padding-bottom:calc(88px + var(--safe-bottom));
    }

    button,input,select,textarea {
      font:inherit;
    }

    button {
      border:0;
      cursor:pointer;
    }

    .topbar {
      position:sticky;
      top:0;
      z-index:50;
      padding:calc(10px + var(--safe-top)) 12px 10px;
      background:rgba(248,251,255,.6);
      border-bottom:1px solid var(--border);
      backdrop-filter:blur(20px);
    }

    [data-theme="dark"] .topbar {
      background:rgba(5,8,22,.7);
    }

    .topbar-inner {
      width:min(940px,100%);
      margin:0 auto;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
    }

    .brand {
      min-width:0;
      display:flex;
      align-items:center;
      gap:10px;
    }

    .logo {
      width:42px;
      height:42px;
      border-radius:16px;
      display:grid;
      place-items:center;
      color:white;
      font-weight:950;
      background:linear-gradient(135deg,var(--blue2),var(--cyan));
      box-shadow:0 14px 34px rgba(37,99,235,.22);
      flex:0 0 auto;
    }

    .brand-title {
      font-weight:950;
      letter-spacing:-.05em;
      font-size:1rem;
      white-space:nowrap;
    }

    .brand-sub {
      margin-top:2px;
      color:var(--muted);
      font-size:.72rem;
      font-weight:800;
      white-space:nowrap;
    }

    .top-actions {
      display:flex;
      align-items:center;
      gap:6px;
    }

    .icon-btn {
      width:40px;
      height:40px;
      display:grid;
      place-items:center;
      border-radius:15px;
      background:var(--glass);
      border:1px solid var(--border);
      color:var(--text);
      box-shadow:var(--shadow2);
      backdrop-filter:blur(16px);
      font-weight:950;
    }

    .shell {
      width:min(940px,100%);
      margin:0 auto;
      padding:12px;
    }

    .hero {
      position:relative;
      overflow:hidden;
      border-radius:32px;
      padding:18px;
      background:var(--glass);
      border:1px solid var(--border);
      box-shadow:var(--shadow);
      backdrop-filter:blur(24px);
    }

    .hero::before {
      content:"";
      position:absolute;
      right:-90px;
      bottom:-130px;
      width:310px;
      height:310px;
      border-radius:50%;
      background:radial-gradient(circle,rgba(2,132,199,.24),transparent 70%);
      pointer-events:none;
    }

    .hero-inner {
      position:relative;
      z-index:1;
    }

    .badge {
      display:inline-flex;
      align-items:center;
      gap:7px;
      padding:8px 11px;
      border-radius:999px;
      color:var(--blue);
      background:rgba(2,132,199,.08);
      border:1px solid var(--border2);
      font-size:.74rem;
      font-weight:950;
    }

    .dot {
      width:7px;
      height:7px;
      border-radius:50%;
      background:var(--blue);
      animation:pulse 1.8s infinite;
    }

    @keyframes pulse {
      0% { box-shadow:0 0 0 0 rgba(2,132,199,.42); }
      80% { box-shadow:0 0 0 9px rgba(2,132,199,0); }
      100% { box-shadow:0 0 0 0 rgba(2,132,199,0); }
    }

    .balance {
      margin-top:12px;
      font-size:clamp(2.45rem,12vw,5rem);
      font-weight:950;
      line-height:.93;
      letter-spacing:-.08em;
      font-variant-numeric:tabular-nums;
    }

    .pnl-line {
      margin-top:9px;
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 11px;
      border-radius:999px;
      background:var(--glass2);
      border:1px solid var(--border);
      color:var(--muted);
      font-weight:900;
      font-size:.76rem;
    }

    .pnl-line.up {
      color:var(--green);
      background:rgba(22,163,74,.09);
      border-color:rgba(22,163,74,.16);
    }

    .pnl-line.down {
      color:var(--pink);
      background:rgba(225,29,72,.08);
      border-color:rgba(225,29,72,.14);
    }

    .chips {
      display:flex;
      gap:7px;
      overflow-x:auto;
      scrollbar-width:none;
      margin-top:13px;
      padding-bottom:2px;
    }

    .chips::-webkit-scrollbar {
      display:none;
    }

    .chip {
      flex:0 0 auto;
      padding:8px 10px;
      border-radius:999px;
      color:var(--muted);
      background:var(--glass2);
      border:1px solid var(--border);
      font-size:.72rem;
      font-weight:900;
      backdrop-filter:blur(14px);
    }

    .quick {
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:8px;
      margin-top:15px;
    }

    .quick-btn {
      min-height:70px;
      border-radius:22px;
      padding:10px;
      text-align:center;
      color:var(--text);
      background:var(--solid);
      border:1px solid var(--border);
      box-shadow:var(--shadow2);
    }

    .quick-btn.primary {
      color:white;
      background:linear-gradient(135deg,var(--blue2),var(--blue));
      border-color:transparent;
    }

    .quick-btn strong {
      display:block;
      font-size:.86rem;
      font-weight:950;
      margin-bottom:4px;
    }

    .quick-btn span {
      color:var(--muted);
      font-size:.66rem;
      font-weight:850;
    }

    .quick-btn.primary span {
      color:rgba(255,255,255,.82);
    }

    .panel {
      margin-top:12px;
      border-radius:25px;
      padding:14px;
      background:var(--glass);
      border:1px solid var(--border);
      box-shadow:var(--shadow2);
      backdrop-filter:blur(20px);
      overflow:hidden;
      max-width:100%;
    }

    .panel-head {
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:10px;
      margin-bottom:12px;
    }

    .title {
      font-size:1rem;
      font-weight:950;
      letter-spacing:-.04em;
    }

    .sub {
      margin-top:3px;
      color:var(--muted);
      font-size:.75rem;
      line-height:1.45;
      font-weight:760;
    }

    .asset-scroll {
      display:flex;
      gap:10px;
      overflow-x:auto;
      scroll-snap-type:x mandatory;
      scrollbar-width:none;
      padding:2px 2px 4px;
    }

    .asset-scroll::-webkit-scrollbar {
      display:none;
    }

    .asset-card {
      flex:0 0 168px;
      scroll-snap-align:start;
      border-radius:22px;
      padding:13px;
      background:var(--glass2);
      border:1px solid var(--border);
      backdrop-filter:blur(14px);
      min-width:0;
      text-align:left;
      color:var(--text);
    }

    .asset-card.selected {
      border-color:var(--border2);
      box-shadow:0 0 0 4px rgba(2,132,199,.08);
    }

    .asset-card.watch {
      background:linear-gradient(180deg,var(--glass2),rgba(255,255,255,.28));
    }

    .asset-top {
      display:flex;
      align-items:center;
      gap:9px;
      min-width:0;
    }

    .coin {
      width:38px;
      height:38px;
      display:grid;
      place-items:center;
      border-radius:50%;
      background:var(--soft);
      border:1px solid var(--border);
      color:var(--blue);
      font-size:.7rem;
      font-weight:950;
      overflow:hidden;
      flex:0 0 auto;
    }

    .coin img {
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .name {
      font-weight:950;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      min-width:0;
    }

    .tiny {
      margin-top:3px;
      color:var(--muted);
      font-size:.72rem;
      line-height:1.45;
      font-weight:800;
      overflow-wrap:anywhere;
      word-break:break-word;
    }

    .asset-value {
      margin-top:11px;
      font-size:1.05rem;
      font-weight:950;
      font-variant-numeric:tabular-nums;
    }

    .asset-sub {
      margin-top:3px;
      color:var(--muted);
      font-size:.72rem;
      font-weight:800;
    }

    .network-list {
      display:grid;
      gap:6px;
      margin-top:8px;
    }

    .mini-net {
      display:flex;
      justify-content:space-between;
      gap:8px;
      color:var(--muted);
      font-size:.68rem;
      font-weight:850;
    }

    .small-btn,.primary-btn,.secondary-btn,.danger-btn {
      min-height:44px;
      border-radius:15px;
      font-weight:950;
    }

    .small-btn {
      padding:0 12px;
      color:var(--text);
      background:var(--solid);
      border:1px solid var(--border);
      font-size:.75rem;
      white-space:nowrap;
    }

    .primary-btn {
      color:white;
      background:linear-gradient(135deg,var(--blue2),var(--blue));
      box-shadow:0 14px 30px rgba(37,99,235,.18);
    }

    .secondary-btn {
      color:var(--text);
      background:var(--solid);
      border:1px solid var(--border);
    }

    .danger-btn {
      color:white;
      background:linear-gradient(135deg,#be123c,#fb7185);
    }

    .form {
      display:grid;
      gap:10px;
    }

    .field {
      display:grid;
      gap:7px;
    }

    label {
      color:var(--muted);
      font-size:.7rem;
      font-weight:950;
      text-transform:uppercase;
      letter-spacing:.04em;
    }

    .input,.select,.textarea {
      width:100%;
      min-height:46px;
      padding:12px;
      border-radius:15px;
      color:var(--text);
      background:var(--soft);
      border:1px solid var(--border);
      outline:none;
      font-weight:850;
      max-width:100%;
    }

    .textarea {
      min-height:112px;
      resize:vertical;
      font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
      font-size:.8rem;
      line-height:1.5;
    }

    .button-row {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:9px;
      margin-top:10px;
    }

    .button-row.one {
      grid-template-columns:1fr;
    }

    .box {
      margin-top:10px;
      padding:12px;
      border-radius:18px;
      background:var(--glass2);
      border:1px solid var(--border);
      max-width:100%;
      min-width:0;
    }

    .box.warn {
      color:var(--orange);
      background:rgba(217,119,6,.1);
      border-color:rgba(217,119,6,.18);
    }

    .box.bad {
      color:var(--pink);
      background:rgba(225,29,72,.08);
      border-color:rgba(225,29,72,.14);
    }

    .receive-grid {
      display:grid;
      gap:8px;
    }

    .receive-option {
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:8px;
      align-items:center;
      padding:12px;
      border-radius:18px;
      background:var(--soft);
      border:1px solid var(--border);
      text-align:left;
      max-width:100%;
      color:var(--text);
    }

    .fee-box {
      display:grid;
      grid-template-columns:minmax(0,1fr) 42px;
      align-items:center;
      gap:10px;
    }

    .countdown-ring {
      width:42px;
      height:42px;
      border-radius:50%;
      display:grid;
      place-items:center;
      background:conic-gradient(var(--blue) calc(var(--progress,1) * 360deg),rgba(100,116,139,.16) 0deg);
      position:relative;
      flex:0 0 auto;
    }

    .countdown-ring::before {
      content:"";
      width:32px;
      height:32px;
      border-radius:50%;
      background:var(--solid);
      position:absolute;
    }

    .countdown-ring span {
      position:relative;
      font-size:.72rem;
      font-weight:950;
      color:var(--blue);
      z-index:1;
    }

    .chart-wrap {
      width:100%;
      border-radius:22px;
      background:var(--soft);
      border:1px solid var(--border);
      overflow:hidden;
      padding:10px;
    }

    .chart-head {
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:8px;
      margin-bottom:10px;
    }

    .live-price {
      font-size:1.55rem;
      font-weight:950;
      letter-spacing:-.05em;
    }

    .timeframe-row {
      display:flex;
      gap:7px;
      overflow-x:auto;
      scrollbar-width:none;
      margin:10px 0;
    }

    .timeframe-row::-webkit-scrollbar {
      display:none;
    }

    .timeframe-btn {
      flex:0 0 auto;
      min-height:36px;
      padding:0 12px;
      border-radius:999px;
      background:var(--solid);
      border:1px solid var(--border);
      color:var(--muted);
      font-size:.74rem;
      font-weight:950;
    }

    .timeframe-btn.active {
      color:#fff;
      background:linear-gradient(135deg,var(--blue2),var(--blue));
      border-color:transparent;
    }

    .chart-canvas {
      width:100%;
      height:270px;
      display:block;
    }

    .staking-card {
      flex:0 0 188px;
      scroll-snap-align:start;
      border-radius:22px;
      padding:13px;
      background:var(--glass2);
      border:1px solid var(--border);
      backdrop-filter:blur(14px);
    }

    .staking-card.real {
      border-color:rgba(22,163,74,.2);
    }

    .apy {
      margin-top:10px;
      font-size:1.65rem;
      line-height:1;
      font-weight:950;
      letter-spacing:-.06em;
      color:var(--blue);
    }

    .modal-overlay,.drawer-overlay {
      position:fixed;
      inset:0;
      z-index:100;
      display:none;
      background:rgba(15,23,42,.42);
      backdrop-filter:blur(10px);
      padding:10px;
    }

    .modal-overlay.active,.drawer-overlay.active {
      display:block;
    }

    .modal-card {
      width:min(520px,100%);
      max-height:calc(100vh - 20px - var(--safe-top) - var(--safe-bottom));
      overflow-y:auto;
      margin:calc(10px + var(--safe-top)) auto 0;
      padding:14px;
      border-radius:26px;
      background:var(--solid);
      border:1px solid var(--border);
      box-shadow:var(--shadow);
      animation:pop .22s ease both;
      max-width:100%;
    }

    .drawer {
      position:absolute;
      top:0;
      right:0;
      width:min(470px,100%);
      height:100%;
      overflow-y:auto;
      padding:calc(16px + var(--safe-top)) 14px calc(18px + var(--safe-bottom));
      background:var(--solid);
      border-left:1px solid var(--border);
      box-shadow:-24px 0 80px rgba(0,0,0,.22);
      animation:slide .23s ease both;
      max-width:100%;
    }

    @keyframes pop {
      from { transform:translateY(18px) scale(.98); opacity:0; }
      to { transform:translateY(0) scale(1); opacity:1; }
    }

    @keyframes slide {
      from { transform:translateX(36px); opacity:0; }
      to { transform:translateX(0); opacity:1; }
    }

    .modal-head,.drawer-head {
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:flex-start;
      margin-bottom:12px;
    }

    .modal-title,.drawer-title {
      font-size:1.22rem;
      font-weight:950;
      letter-spacing:-.055em;
    }

    .modal-sub,.drawer-sub {
      margin-top:3px;
      color:var(--muted);
      font-size:.8rem;
      font-weight:760;
      line-height:1.45;
    }

    .close {
      width:40px;
      height:40px;
      border-radius:15px;
      color:var(--text);
      background:var(--soft);
      border:1px solid var(--border);
      font-size:1.2rem;
      font-weight:950;
      flex:0 0 auto;
    }

    .secret-card {
      filter:blur(5px);
      user-select:none;
      transition:filter .2s ease;
    }

    .secret-card.visible {
      filter:none;
      user-select:text;
    }

    .toast {
      position:fixed;
      left:50%;
      bottom:calc(92px + var(--safe-bottom));
      transform:translateX(-50%) translateY(12px);
      z-index:150;
      max-width:min(430px,calc(100% - 28px));
      padding:12px 14px;
      border-radius:16px;
      background:rgba(2,6,23,.92);
      color:white;
      box-shadow:var(--shadow2);
      opacity:0;
      pointer-events:none;
      transition:all .22s ease;
      font-weight:850;
      font-size:.84rem;
    }

    .toast.active {
      opacity:1;
      transform:translateX(-50%) translateY(0);
    }

    .bottom-nav {
      position:fixed;
      left:50%;
      bottom:calc(10px + var(--safe-bottom));
      transform:translateX(-50%);
      z-index:70;
      width:min(430px,calc(100% - 24px));
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:6px;
      padding:7px;
      border-radius:22px;
      background:rgba(255,255,255,.9);
      border:1px solid var(--border);
      box-shadow:var(--shadow);
      backdrop-filter:blur(16px);
    }

    [data-theme="dark"] .bottom-nav {
      background:rgba(13,22,40,.9);
    }

    .bottom-nav button {
      min-height:47px;
      border-radius:16px;
      color:var(--muted);
      background:transparent;
      font-size:.7rem;
      font-weight:950;
    }

    .bottom-nav button.active {
      color:white;
      background:linear-gradient(135deg,var(--blue2),var(--blue));
    }

    @media (max-width:580px) {
      body {
        padding-bottom:calc(82px + var(--safe-bottom));
      }

      .shell {
        padding:9px;
      }

      .hero {
        padding:14px;
        border-radius:27px;
      }

      .quick {
        grid-template-columns:repeat(3,1fr);
      }

      .quick-btn {
        min-height:62px;
        padding:8px 6px;
        border-radius:19px;
      }

      .quick-btn strong {
        font-size:.8rem;
      }

      .quick-btn span {
        font-size:.62rem;
      }

      .panel {
        padding:12px;
        border-radius:22px;
      }

      .asset-card {
        flex-basis:150px;
      }

      .receive-option {
        grid-template-columns:1fr;
      }

      .button-row {
        grid-template-columns:1fr;
      }

      .brand-sub {
        display:none;
      }

      .drawer {
        width:100%;
      }

      .modal-card {
        width:100%;
        margin-top:calc(8px + var(--safe-top));
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="logo">B</div>
        <div>
          <div class="brand-title">Bluebook Wallet</div>
          <div class="brand-sub" id="statusText">Loading wallet</div>
        </div>
      </div>

      <div class="top-actions">
        <button class="icon-btn" onclick="refreshAllBalances(true)">⟳</button>
        <button class="icon-btn" onclick="openSettings()">⚙</button>
      </div>
    </div>
  </header>

  <main class="shell">
    <section class="hero" id="homeSection">
      <div class="hero-inner">
        <div class="badge"><span class="dot"></span><span id="walletStatusBadge">Wallet loading</span></div>
        <div class="balance" id="totalUsd">$0.00</div>
        <div class="pnl-line" id="pnlLine">24h PnL $0.00 · ROI 0.00%</div>

        <div class="chips">
          <span class="chip">All networks</span>
          <span class="chip" id="tokenCountText">0 assets</span>
          <span class="chip" id="securityText">Auto encrypted</span>
        </div>

        <div class="quick">
          <button class="quick-btn primary" onclick="openModal('receiveModal')">
            <strong>Receive</strong>
            <span>Network first</span>
          </button>

          <button class="quick-btn" onclick="openModal('sendModal')">
            <strong>Send</strong>
            <span>Owned assets</span>
          </button>

          <button class="quick-btn" onclick="openModal('swapModal')">
            <strong>Swap</strong>
            <span>Owned assets</span>
          </button>
        </div>
      </div>
    </section>

    <section class="panel" id="assetsSection">
      <div class="panel-head">
        <div>
          <h2 class="title">My assets</h2>
          <p class="sub">Owned assets are combined. Watch assets still show live charts at 0 balance.</p>
        </div>
        <button class="small-btn" onclick="refreshAllBalances(true)">Refresh</button>
      </div>

      <div class="asset-scroll" id="assetCards"></div>
    </section>

    <section class="panel" id="stakingSection">
      <div class="panel-head">
        <div>
          <h2 class="title">Staking</h2>
          <p class="sub">Highest APY first. ETH Lido staking is real; other protocols need adapters.</p>
        </div>
      </div>

      <div class="asset-scroll" id="stakingCards"></div>
    </section>
  </main>

  <nav class="bottom-nav">
    <button id="navHome" class="active" onclick="navGo('home')">Home</button>
    <button id="navAssets" onclick="navGo('assets')">Assets</button>
    <button id="navStake" onclick="navGo('stake')">Stake</button>
    <button id="navSettings" onclick="openSettings()">Settings</button>
  </nav>

  <div class="modal-overlay" id="receiveModal" onclick="overlayClose(event,'receiveModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Receive</div>
          <div class="modal-sub">Choose a network first. Then copy the address for that token/network.</div>
        </div>
        <button class="close" onclick="closeModal('receiveModal')">×</button>
      </div>

      <div class="form">
        <div class="field">
          <label>Network</label>
          <select class="select" id="receiveNetworkSelect" onchange="renderReceiveAssets()"></select>
        </div>

        <div class="receive-grid" id="receiveAssetsList"></div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="sendModal" onclick="overlayClose(event,'sendModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Send</div>
          <div class="modal-sub">Only funded assets appear. The network auto-matches your selection.</div>
        </div>
        <button class="close" onclick="closeModal('sendModal')">×</button>
      </div>

      <div class="form">
        <div class="field">
          <label>Your asset</label>
          <div class="asset-scroll" id="sendOwnedAssets"></div>
        </div>

        <div class="box">
          <div class="name">Selected balance</div>
          <div class="tiny" id="sendBalanceText">Select an asset.</div>
        </div>

        <div class="field">
          <label>Recipient</label>
          <input class="input" id="sendToInput" placeholder="0x..." autocomplete="off" oninput="scheduleImmediateFeeRefresh()" />
        </div>

        <div class="field">
          <label>Amount</label>
          <input class="input" id="sendAmountInput" type="number" step="any" placeholder="0.00" oninput="scheduleImmediateFeeRefresh()" />
        </div>

        <div class="box">
          <div class="fee-box">
            <div>
              <div class="name">Estimated network fee</div>
              <div class="tiny" id="sendFeePreview">Enter address and amount.</div>
            </div>
            <div class="countdown-ring" id="sendCountdown" style="--progress:1"><span>5</span></div>
          </div>
        </div>

        <div class="button-row one">
          <button class="primary-btn" onclick="openSendConfirm()">Send</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="sendConfirmModal" onclick="overlayClose(event,'sendConfirmModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Confirm send</div>
          <div class="modal-sub">Blockchain transactions cannot be reversed.</div>
        </div>
        <button class="close" onclick="closeModal('sendConfirmModal')">×</button>
      </div>

      <div class="box bad">
        <div class="name">Final review</div>
        <div class="tiny" id="sendConfirmText"></div>
      </div>

      <div class="button-row">
        <button class="secondary-btn" onclick="closeModal('sendConfirmModal')">Cancel</button>
        <button class="primary-btn" onclick="sendRealTransaction()">Confirm</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="swapModal" onclick="overlayClose(event,'swapModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Swap</div>
          <div class="modal-sub">Choose an owned asset, then choose what you want to receive.</div>
        </div>
        <button class="close" onclick="closeModal('swapModal')">×</button>
      </div>

      <div class="form">
        <div class="field">
          <label>Sell asset</label>
          <div class="asset-scroll" id="swapOwnedAssets"></div>
        </div>

        <div class="box">
          <div class="name">Your sell balance</div>
          <div class="tiny" id="swapSellBalanceText">Select an asset.</div>
        </div>

        <div class="field">
          <label>Buy asset</label>
          <select class="select" id="swapBuySelect" onchange="scheduleImmediateFeeRefresh()"></select>
        </div>

        <div class="field">
          <label>Sell amount</label>
          <input class="input" id="swapAmount" type="number" step="any" placeholder="0.00" oninput="scheduleImmediateFeeRefresh()" />
        </div>

        <div class="box">
          <div class="fee-box">
            <div>
              <div class="name">Estimated swap fee</div>
              <div class="tiny" id="swapQuoteText">Enter amount to estimate route.</div>
            </div>
            <div class="countdown-ring" id="swapCountdown" style="--progress:1"><span>5</span></div>
          </div>
        </div>

        <div class="button-row one">
          <button class="primary-btn" onclick="openSwapConfirm()">Swap</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="swapConfirmModal" onclick="overlayClose(event,'swapConfirmModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Confirm swap</div>
          <div class="modal-sub">This executes the loaded swap quote.</div>
        </div>
        <button class="close" onclick="closeModal('swapConfirmModal')">×</button>
      </div>

      <div class="box bad">
        <div class="name">Final review</div>
        <div class="tiny" id="swapConfirmText"></div>
      </div>

      <div class="button-row">
        <button class="secondary-btn" onclick="closeModal('swapConfirmModal')">Cancel</button>
        <button class="primary-btn" onclick="executeSwap()">Confirm</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="assetChartModal" onclick="overlayClose(event,'assetChartModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title" id="chartAssetTitle">Asset</div>
          <div class="modal-sub" id="chartAssetSub">Live price and candles</div>
        </div>
        <button class="close" onclick="closeModal('assetChartModal')">×</button>
      </div>

      <div class="chart-wrap">
        <div class="chart-head">
          <div>
            <div class="live-price" id="chartLivePrice">$0.00</div>
            <div class="tiny" id="chartChangeText">Live</div>
          </div>
          <button class="small-btn" onclick="refreshChart()">Refresh</button>
        </div>

        <div class="timeframe-row">
          <button class="timeframe-btn active" id="tf5m" onclick="setChartTf('5m')">5m</button>
          <button class="timeframe-btn" id="tf15m" onclick="setChartTf('15m')">15m</button>
          <button class="timeframe-btn" id="tf1h" onclick="setChartTf('1h')">1h</button>
        </div>

        <canvas class="chart-canvas" id="assetChartCanvas"></canvas>
      </div>
    </div>
  </div>

  <div class="drawer-overlay" id="settingsOverlay" onclick="overlayClose(event,'settingsOverlay')">
    <aside class="drawer">
      <div class="drawer-head">
        <div>
          <div class="drawer-title">Settings</div>
          <div class="drawer-sub">Wallet info, recovery, theme, RPC, and deletion.</div>
        </div>
        <button class="close" onclick="closeSettings()">×</button>
      </div>

      <div class="box">
        <div class="name">Wallet address</div>
        <div class="tiny" id="settingsAddress">No wallet loaded.</div>
      </div>

      <div class="box warn">
        <div class="name">Recovery</div>
        <div class="tiny">Save your seed phrase. If you delete browser data and lose your seed phrase, you may lose access.</div>

        <div class="button-row">
          <button class="secondary-btn" onclick="showSeed()">Show seed</button>
          <button class="secondary-btn" onclick="showPrivateKey()">Show key</button>
        </div>

        <div class="field" style="margin-top:10px;">
          <label>Secret output</label>
          <textarea class="textarea secret-card" id="secretOutput" readonly placeholder="Seed phrase or private key appears here."></textarea>
        </div>
      </div>

      <div class="box">
        <div class="name">Custom RPC</div>
        <div class="tiny">Applies to the selected network while sending or swapping.</div>
        <div class="field" style="margin-top:10px;">
          <input class="input" id="customRpcInput" placeholder="https://..." />
        </div>
        <div class="button-row one">
          <button class="primary-btn" onclick="saveCustomRpc()">Save RPC</button>
        </div>
      </div>

      <div class="box">
        <div class="name">Theme</div>
        <div class="button-row">
          <button class="secondary-btn" onclick="setTheme('light')">Light</button>
          <button class="secondary-btn" onclick="setTheme('dark')">Dark</button>
        </div>
      </div>

      <div class="box bad">
        <div class="name">Delete wallet</div>
        <div class="tiny">Deletes the encrypted wallet vault from this email account. This does not delete blockchain funds.</div>
        <div class="field" style="margin-top:10px;">
          <label>Type DELETE to confirm</label>
          <input class="input" id="deleteConfirmInput" placeholder="DELETE" />
        </div>
        <div class="button-row one">
          <button class="danger-btn" onclick="deleteWallet()">Delete wallet</button>
        </div>
      </div>

      <div class="box">
        <form action="/logout" method="POST">
          <button class="secondary-btn" type="submit" style="width:100%;">Logout</button>
        </form>
      </div>
    </aside>
  </div>

  <div class="toast" id="toast"></div>

