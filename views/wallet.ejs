      <div class="modal-head">
        <div>
          <div class="modal-title" id="stakeTitle">Stake</div>
          <div class="modal-sub" id="stakeSub">Available staking option</div>
        </div>
        <button class="close" onclick="closeModal('stakeModal')">×</button>
