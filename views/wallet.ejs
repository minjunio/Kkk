    function parseAssetValue(value) {
      const parts = String(value || '').split(':');
      const type = parts[0] || 'standard';
      const id = parts[1] || 'USDT';

      if (type === 'tensor') {
        const token = tensorRegistry.find(t => String(t.id) === String(id));
        if (token) {
          return { type: 'tensor', symbol: token.symbol, tokenId: token.id };
        }
      }

      return { type: 'standard', symbol: id, tokenId: '' };
    }

