    async function refreshPrices() {
      try {
        const liveRes = await fetch(`/api/live-prices?_t=${Date.now()}`);

        if (liveRes.ok) {
          const liveData = await liveRes.json();
          prices.live = liveData.prices || {};
        }
      } catch {}

      try {
        const ids = Object.values(assetMeta).map(a => a.priceId).filter(Boolean).join(',');
        const cgRes = await fetch(`/api/prices?ids=${encodeURIComponent(ids)}&_t=${Date.now()}`);

        if (cgRes.ok) {
          prices.cg = await cgRes.json();
        }
      } catch {}
    }

    async function refreshTensor() {
      try {
        const res = await fetch(`/api/tensor?_t=${Date.now()}`);

        if (!res.ok) return;

        const data = await res.json();

        tensorRegistry = data.registry || [];
        walletState.tensorAddress = data.address || walletState.tensorAddress;
        walletState.tensorBalances = data.balances || walletState.tensorBalances || {};
        walletState.tensorTxHistory = data.tensorTxHistory || walletState.tensorTxHistory || [];
        walletState.tensorWallet = {
          ...(walletState.tensorWallet || {}),
          ...(data.tensorWallet || {}),
          tokenAddresses: data.tokenAddresses || data.tensorWallet?.tokenAddresses || walletState.tensorWallet?.tokenAddresses || {}
        };
      } catch {}
    }

    async function refreshWallet() {
      try {
        const res = await fetch(`/api/wallet?includeSecrets=true&_t=${Date.now()}`);

        if (res.ok) {
          const data = await res.json();
          walletState = { ...walletState, ...data };

          if (walletState.supportedNetworks) {
            Object.keys(walletState.supportedNetworks).forEach(key => {
              const n = walletState.supportedNetworks[key];
              networkMap[key] = {
                ...(networkMap[key] || {}),
                key,
                network: n.name || n.network || key,
                short: n.short || key.toUpperCase(),
                symbol: n.symbol || key.toUpperCase(),
                address: getCryptoAddress(key)
              };
            });
          }

          selectedNetwork = normalizeNetwork(walletState.usdtNetwork || selectedNetwork);
        }

        const stateRes = await fetch(`/api/trading/state?_t=${Date.now()}`);

        if (stateRes.ok) {
          const state = await stateRes.json();

          walletState.usdtBalance = Number(state.usdtBalance || walletState.usdtBalance || 0);
          walletState.ousdBalance = Number(state.ousdBalance || walletState.ousdBalance || 0);
          walletState.usdtNetwork = state.usdtNetwork || walletState.usdtNetwork || selectedNetwork;
          walletState.positions = state.positions || [];
          walletState.orderHistory = state.orderHistory || [];
          walletState.tradeDeposits = state.tradeDeposits || [];
          walletState.copyTrades = state.copyTrades || [];
          walletState.copyDeposits = state.copyDeposits || [];
          walletState.walletTxHistory = state.walletTxHistory || walletState.walletTxHistory || [];
        }

        await refreshTensor();
        await refreshPrices();

        renderAll();
      } catch (err) {
        console.error('refreshWallet error:', err);
        showToast('Could not refresh wallet');
      }
    }

    function bindSelectors() {
      document.getElementById('sendAsset').onchange = function() {
        const parsed = parseSelectValue(this.value);
        selectCurrency(parsed.type, parsed.symbol, parsed.tokenId);
      };

      document.getElementById('receiveAsset').onchange = function() {
        const parsed = parseSelectValue(this.value);
        selectCurrency(parsed.type, parsed.symbol, parsed.tokenId);
      };

      document.getElementById('sendNetwork').onchange = function() {
        setNetwork(this.value);
      };
    }

    function renderAll() {
      renderHero();
      renderAssets();
      renderNetworkSelect();
      renderAddress();
      renderSeeds();
      renderSendBalance();
      renderActivity();
      bindSelectors();

      const vault = document.getElementById('vaultInput');

      if (vault && walletState.encryptedVault && !vault.value) {
        vault.value = walletState.encryptedVault;
      }
    }

    async function bootWallet() {
      document.documentElement.setAttribute('data-theme', currentTheme);

      selectedWalletType = 'crypto';
      selectedAsset = 'USDT';
      selectedTokenId = '';

      renderAll();
      await refreshWallet();

      if (refreshInterval) clearInterval(refreshInterval);

      refreshInterval = setInterval(async () => {
        await refreshWallet();
      }, 6000);
    }

    window.addEventListener('load', bootWallet);
  </script>
</body>
</html>