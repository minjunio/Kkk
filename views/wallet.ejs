          </div>

          <div class="field">
            <label>Bull Chance %</label>
            <input id="modalTokenBullChance" type="number" step="1">
          </div>

          <div class="field">
            <label>Min Move %</label>
            <input id="modalTokenMinPct" type="number" step="any">
          </div>

          <div class="field">
            <label>Max Move %</label>
            <input id="modalTokenMaxPct" type="number" step="any">
