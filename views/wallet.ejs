    function renderAutoStakePlanner() {
      const box = document.getElementById('stakingPlannerList');
      if (!box) return;

      const current = STAKE_OPTIONS.find(o => o.id === autoStakeSettings.currentStrategy) || STAKE_OPTIONS[0];
      const best = STAKE_OPTIONS.slice().sort((a, b) => b.apy - a.apy)[0];
      const candidate = autoStakeSettings.candidate;
      const now = Date.now();

      let candidateHtml = '';

      if (candidate) {
        const remaining = Math.max(0, candidate.readyAt - now);
        const days = Math.ceil(remaining / (24 * 60 * 60 * 1000));

        candidateHtml = `
          <div class="row">
            <div>
              <div class="name">Pending switch</div>
              <div class="sub">${candidate.label} · ${candidate.apy.toFixed(2)}% APY · ready in ${days} day${days === 1 ? '' : 's'}</div>
