<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>BlueCrypto | Ecosystem</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lightweight-charts/dist/lightweight-charts.standalone.production.js"></script>

  <style>
    :root {
      color-scheme: light;
      --bg1: #e9f8ff; --bg2: #f8fcff; --bg3: #d7f0ff;
      --glass: rgba(255,255,255,0.85); --glass2: rgba(255,255,255,0.65);
      --solid: #ffffff; --soft: #f0f7ff; --soft-hover: #e0f0ff;
      --text: #0f172a; --muted: #64748b; --muted2: #94a3b8;
      --blue: #0284c7; --blue2: #2563eb; --cyan: #38bdf8;
      --pink: #e11d48; --orange: #d97706; --green: #10b981;
      --tensor: #8b5cf6; --tensor2: #d946ef; 
      --border: rgba(2,132,199,0.12); --border2: rgba(2,132,199,0.35);
      --shadow: 0 24px 64px rgba(37,99,235,0.12); --shadow2: 0 12px 32px rgba(2,132,199,0.08);
      --safe-top: env(safe-area-inset-top); --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg1: #06111f; --bg2: #050816; --bg3: #0a2942;
      --glass: rgba(13,22,40,0.88); --glass2: rgba(17,29,51,0.72);
      --solid: #0d1628; --soft: #111d33; --soft-hover: #1e293b;
      --text: #f8fafc; --muted: #94a3b8; --muted2: #64748b;
      --blue: #38bdf8; --tensor: #a78bfa; --tensor2: #e879f9;
      --border: rgba(125,211,252,0.16); --border2: rgba(56,189,248,0.36);
      --shadow: 0 28px 86px rgba(0,0,0,0.5); --shadow2: 0 14px 38px rgba(0,0,0,0.3);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: Inter, system-ui, sans-serif; -webkit-tap-highlight-color: transparent; }
    html, body { width: 100%; min-height: 100vh; overflow-x: hidden; scroll-behavior: smooth; }
    body {
      color: var(--text);
      background: radial-gradient(circle at 10% 0%, rgba(56,189,248,0.25), transparent 35%), radial-gradient(circle at 90% 15%, rgba(37,99,235,0.15), transparent 30%), radial-gradient(circle at 50% 100%, rgba(14,165,233,0.2), transparent 40%), linear-gradient(135deg, var(--bg1), var(--bg2) 50%, var(--bg3));
      background-attachment: fixed; padding-bottom: calc(92px + var(--safe-bottom)); -webkit-font-smoothing: antialiased;
    }
    button, input, select, textarea { font: inherit; outline: none; border: none; background: transparent; }
    button { cursor: pointer; transition: transform 0.1s ease, filter 0.1s ease; }
    button:active { transform: scale(0.97); filter: brightness(0.95); }

    .topbar { position: sticky; top: 0; z-index: 50; padding: calc(10px + var(--safe-top)) 12px 10px; background: rgba(248,251,255,0.7); border-bottom: 1px solid var(--border); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); }
    [data-theme="dark"] .topbar { background: rgba(5,8,22,0.8); }
    .topbar-inner { width: min(980px, 100%); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; }
    .logo { width: 46px; height: 46px; border-radius: 18px; display: grid; place-items: center; color: white; font-weight: 900; font-size: 1.2rem; background: linear-gradient(135deg, var(--blue2), var(--cyan)); box-shadow: 0 12px 28px rgba(37,99,235,0.25); }
    .brand-title { font-weight: 900; letter-spacing: -0.04em; font-size: 1.1rem; }
    .brand-sub { color: var(--muted); font-size: 0.75rem; font-weight: 700; margin-top: 2px; }
    .top-actions { display: flex; gap: 8px; }
    .icon-btn { width: 44px; height: 44px; border-radius: 16px; background: var(--glass); border: 1px solid var(--border); color: var(--text); box-shadow: var(--shadow2); backdrop-filter: blur(16px); font-weight: 900; display: grid; place-items: center; }

    .shell { width: min(980px, 100%); margin: 0 auto; padding: 12px; }
    
    /* Hero & Portfolio Overview */
    .hero { position: relative; overflow: hidden; border-radius: 32px; padding: 28px 24px; background: var(--glass); border: 1px solid var(--border); box-shadow: var(--shadow); backdrop-filter: blur(32px); -webkit-backdrop-filter: blur(32px); }
    .hero::before { content: ""; position: absolute; right: -80px; bottom: -100px; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle, rgba(2,132,199,0.2), transparent 60%); pointer-events: none; }
    
    .portfolio-overview { display: flex; align-items: center; justify-content: space-between; gap: 20px; z-index: 2; position: relative; }
    .balance-info { flex: 1; }
    
    .badge { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 99px; color: var(--blue); background: rgba(2,132,199,0.1); border: 1px solid var(--border2); font-size: 0.75rem; font-weight: 800; margin-bottom: 12px; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); animation: pulse 2s infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(2,132,199,0.5); } 70% { box-shadow: 0 0 0 8px rgba(2,132,199,0); } 100% { box-shadow: 0 0 0 0 rgba(2,132,199,0); } }
    
    .balance { font-size: clamp(2.6rem, 10vw, 4.5rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
    
    /* Donut Chart System */
    .donut-wrapper { position: relative; width: 100px; height: 100px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center; box-shadow: var(--shadow2); }
    .donut-chart { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(var(--blue) 0% 100%, var(--tensor) 100% 100%); transition: background 0.8s cubic-bezier(0.2, 0.9, 0.3, 1.1); }
    .donut-hole { position: absolute; inset: 16px; background: var(--solid); border-radius: 50%; display: grid; place-items: center; font-size: 0.7rem; font-weight: 900; color: var(--muted); box-shadow: inset 0 4px 12px rgba(0,0,0,0.05); }
    .donut-legend { display: flex; gap: 12px; font-size: 0.75rem; font-weight: 800; margin-top: 14px; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 6px; color: var(--muted); }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; }
    .legend-dot.crypto { background: var(--blue); }
    .legend-dot.tensor { background: var(--tensor); }
    
    .flash-up { color: var(--green) !important; text-shadow: 0 0 8px rgba(16,185,129,0.4); transition: 0.1s; }
    .flash-down { color: var(--pink) !important; text-shadow: 0 0 8px rgba(225,29,72,0.4); transition: 0.1s; }
    .pnl-line { display: inline-block; padding: 4px 10px; border-radius: 99px; background: var(--glass2); font-weight: 800; font-size: 0.85rem; }
    .pnl-line.up { color: var(--green); background: rgba(16,185,129,0.08); }
    .pnl-line.down { color: var(--pink); background: rgba(225,29,72,0.08); }

    .market-strip { margin-top: 24px; display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-bottom: 8px; }
    .market-strip::-webkit-scrollbar { display: none; }
    .market-card { flex: 0 0 148px; scroll-snap-align: start; padding: 14px; border-radius: 20px; background: var(--glass2); border: 1px solid var(--border); box-shadow: var(--shadow2); color: var(--text); text-align: left; }
    
    .quick { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 24px; }
    .quick-btn { min-height: 80px; border-radius: 22px; padding: 12px 6px; text-align: center; color: var(--text); background: var(--solid); border: 1px solid var(--border); box-shadow: var(--shadow2); display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .quick-btn.primary { color: white; background: linear-gradient(135deg, var(--blue2), var(--cyan)); border: none; box-shadow: 0 12px 28px rgba(37,99,235,0.25); }
    .quick-btn.tensor-btn { color: white; background: linear-gradient(135deg, var(--tensor), var(--tensor2)); border: none; box-shadow: 0 12px 28px rgba(139,92,246,0.25); }
    .quick-btn strong { font-size: 0.9rem; font-weight: 900; margin-bottom: 4px; }
    .quick-btn span { color: var(--muted); font-size: 0.65rem; font-weight: 700; }
    .quick-btn.primary span, .quick-btn.tensor-btn span { color: rgba(255,255,255,0.9); }

    .panel { margin-top: 14px; border-radius: 28px; padding: 24px; background: var(--glass); border: 1px solid var(--border); box-shadow: var(--shadow2); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); }
    .panel.tensor-panel { border-color: rgba(139,92,246,0.3); background: linear-gradient(180deg, rgba(139,92,246,0.05), var(--glass)); }
    .panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .title { font-size: 1.3rem; font-weight: 900; letter-spacing: -0.03em; }

    .asset-scroll { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-bottom: 8px; }
    .asset-scroll::-webkit-scrollbar { display: none; }
    
    .asset-card { flex: 0 0 200px; scroll-snap-align: start; border-radius: 24px; padding: 18px; background: var(--glass2); border: 1px solid var(--border); color: var(--text); text-align: left; box-shadow: var(--shadow2); transition: 0.15s ease; position: relative; cursor: pointer; }
    .asset-card:active { transform: scale(0.97); }
    .asset-card.tensor { border-color: rgba(139,92,246,0.4); background: rgba(139,92,246,0.05); }

    .asset-top { display: flex; align-items: center; gap: 12px; }
    .coin { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: var(--solid); border: 1px solid var(--border); color: var(--blue); font-weight: 900; font-size: 0.75rem; flex-shrink: 0; padding: 6px; overflow: hidden; }
    .coin.tensor-coin { border: none; background: transparent; padding: 0; }
    .coin.tensor-coin svg { width: 100%; height: 100%; }
    .coin img { width: 100%; height: 100%; object-fit: contain; }

    .name { font-weight: 900; font-size: 1.05rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tiny { color: var(--muted); font-size: 0.8rem; font-weight: 700; margin-top: 2px; }
    .asset-value { margin-top: 16px; font-size: 1.4rem; font-weight: 900; font-variant-numeric: tabular-nums; }
    
    .small-btn { height: 36px; padding: 0 14px; font-size: 0.8rem; border-radius: 12px; font-weight: 800; background: var(--solid); border: 1px solid var(--border); color: var(--text); }
    .primary-btn { width: 100%; height: 56px; border-radius: 20px; font-size: 1rem; font-weight: 900; color: white; background: linear-gradient(135deg, var(--blue2), var(--cyan)); box-shadow: 0 12px 24px rgba(37,99,235,0.25); }
    .tensor-primary-btn { width: 100%; height: 56px; border-radius: 20px; font-size: 1rem; font-weight: 900; color: white; background: linear-gradient(135deg, var(--tensor), var(--tensor2)); box-shadow: 0 12px 24px rgba(139,92,246,0.25); }
    .secondary-btn { width: 100%; height: 56px; border-radius: 20px; font-size: 1rem; font-weight: 800; background: var(--solid); border: 1px solid var(--border); color: var(--text); }

    .form { display: grid; gap: 14px; }
    .field { display: grid; gap: 8px; }
    label { color: var(--muted); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.02em; }

    .input, .select { width: 100%; height: 56px; padding: 0 18px; border-radius: 18px; background: var(--soft); border: 1px solid var(--border); color: var(--text); font-weight: 800; font-size: 1rem; transition: border-color 0.2s; }
    .input:focus, .select:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(56,189,248,0.1); }
    
    .box { padding: 18px; border-radius: 24px; background: var(--glass2); border: 1px solid var(--border); }
    .box.tensor { background: rgba(139,92,246,0.05); border-color: rgba(139,92,246,0.2); }
    .box.bad { color: var(--pink); background: rgba(225,29,72,0.06); border-color: rgba(225,29,72,0.15); }

    /* Polished DeFi Inputs */
    .defi-input-wrap { display: flex; align-items: center; justify-content: space-between; background: var(--solid); border-radius: 20px; padding: 14px 18px; border: 1px solid var(--border); transition: 0.2s; box-shadow: inset 0 2px 8px rgba(0,0,0,0.02); }
    .defi-input-wrap:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
    .defi-input-wrap.tensor-focus:focus-within { border-color: var(--tensor); box-shadow: 0 0 0 3px rgba(139,92,246,0.1); }
    .defi-amount { flex: 1; font-size: 2rem; font-weight: 900; background: transparent; color: var(--text); padding: 0; outline: none; border: none; font-variant-numeric: tabular-nums; width: 100%; }
    .defi-amount::placeholder { color: var(--muted2); }
    .defi-token-select { background: var(--soft); border: 1px solid var(--border); border-radius: 99px; padding: 8px 14px; font-weight: 800; font-size: 0.95rem; display: flex; align-items: center; gap: 8px; }

    .pill-toggle { display: flex; background: var(--soft); border-radius: 99px; padding: 6px; border: 1px solid var(--border); margin-bottom: 12px; }
    .pill-toggle button { flex: 1; height: 40px; border-radius: 99px; font-size: 0.9rem; font-weight: 800; color: var(--muted); transition: 0.2s; }
    .pill-toggle button.active { background: var(--solid); color: var(--text); box-shadow: var(--shadow2); border: 1px solid var(--border); }

    .modal-overlay, .drawer-overlay { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(15,23,42,0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); padding: 16px; opacity: 0; pointer-events: none; transition: opacity 0.2s ease; }
    .modal-overlay.active, .drawer-overlay.active { opacity: 1; pointer-events: auto; }
    .modal-card { width: min(520px, 100%); background: var(--solid); padding: 28px; border-radius: 36px; border: 1px solid var(--border); box-shadow: var(--shadow); transform: translateY(20px) scale(0.95); transition: 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1); display: flex; flex-direction: column; max-height: 90vh; }
    .modal-overlay.active .modal-card { transform: translateY(0) scale(1); }
    .modal-content-scroll { overflow-y: auto; padding-right: 4px; }
    .modal-content-scroll::-webkit-scrollbar { width: 6px; }
    .modal-content-scroll::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 10px; }
    
    .drawer { position: absolute; top: 0; right: 0; width: min(440px, 100%); height: 100%; overflow-y: auto; padding: calc(24px + var(--safe-top)) 24px calc(24px + var(--safe-bottom)); background: var(--solid); border-left: 1px solid var(--border); box-shadow: -20px 0 80px rgba(0,0,0,0.2); transform: translateX(100%); transition: 0.3s ease; }
    .drawer-overlay.active .drawer { transform: translateX(0); }

    .modal-head, .drawer-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-shrink: 0; }
    .modal-title, .drawer-title { font-size: 1.5rem; font-weight: 900; letter-spacing: -0.04em; }
    .close { width: 44px; height: 44px; border-radius: 18px; background: var(--soft); border: 1px solid var(--border); font-size: 1.4rem; font-weight: 900; color: var(--text); display:grid; place-items:center; }

    .toast { position: fixed; left: 50%; bottom: calc(100px + var(--safe-bottom)); transform: translateX(-50%) translateY(20px); z-index: 150; padding: 14px 24px; border-radius: 20px; background: rgba(15,23,42,0.95); color: white; font-weight: 800; font-size: 0.9rem; box-shadow: 0 16px 32px rgba(0,0,0,0.3); opacity: 0; pointer-events: none; transition: all 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1); white-space:nowrap; }
    .toast.active { opacity: 1; transform: translateX(-50%) translateY(0); }

    .bottom-nav { position: fixed; left: 50%; bottom: calc(12px + var(--safe-bottom)); transform: translateX(-50%); z-index: 70; width: min(440px, calc(100% - 24px)); display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 8px; border-radius: 32px; background: rgba(255,255,255,0.92); border: 1px solid var(--border); box-shadow: var(--shadow); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); }
    [data-theme="dark"] .bottom-nav { background: rgba(13,22,40,0.95); }
    .bottom-nav button { min-height: 64px; border-radius: 24px; color: var(--muted); background: transparent; font-size: 0.75rem; font-weight: 800; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; }
    .bottom-nav button svg { width: 24px; height: 24px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; transition:0.2s; }
    .bottom-nav button.active { color: var(--blue); background: var(--soft); box-shadow: inset 0 0 0 1px var(--border); }
    .bottom-nav button.active svg { stroke: var(--blue); }

    /* Mobile First Adjustments */
    @media (max-width: 768px) {
      .hero { padding: 24px 20px; border-radius: 28px; }
      .balance { font-size: 2.8rem; }
      .donut-wrapper { width: 80px; height: 80px; }
      .quick { grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 20px; }
      .quick-btn { min-height: 72px; padding: 8px 4px; border-radius: 20px; }
      .quick-btn strong { font-size: 0.8rem; }
      .panel { padding: 20px 16px; border-radius: 24px; }
      
      .modal-overlay { align-items: flex-end; padding: 0; }
      .modal-card { width: 100%; border-radius: 32px 32px 0 0; margin: 0; padding: 24px 20px; max-height: 92vh; transform: translateY(100%); }
      .modal-overlay.active .modal-card { transform: translateY(0); }
      .defi-amount { font-size: 1.6rem; }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <div class="logo">B</div>
        <div>
          <div class="brand-title">BlueCrypto</div>
          <div class="brand-sub" id="statusText">Connecting...</div>
        </div>
      </a>
      <div class="top-actions">
        <button class="icon-btn" onclick="openSettings()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="shell">
    <section class="hero" id="homeSection">
      <div class="hero-inner">
        <div class="badge"><span class="dot"></span><span id="walletStatusBadge">Secure Network</span></div>
        
        <div class="portfolio-overview">
          <div class="balance-info">
            <div class="balance" id="totalUsd">$0.00</div>
            <div class="donut-legend">
              <div class="legend-item"><div class="legend-dot crypto"></div>Crypto</div>
              <div class="legend-item"><div class="legend-dot tensor"></div>Tensor AI</div>
            </div>
          </div>
          <div class="donut-wrapper">
             <div class="donut-chart" id="portfolioDonut"></div>
             <div class="donut-hole">Ratio</div>
          </div>
        </div>
        
        <div class="market-strip" id="topMarketCards" style="margin-top:20px; margin-bottom: 8px;"></div>
        
        <div class="quick">
          <button class="quick-btn tensor-btn" onclick="openModal('tensorSwapModal')"><strong>Swap</strong><span>AI Tokens</span></button>
          <button class="quick-btn primary" onclick="openModal('receiveModal')"><strong>Receive</strong><span>Deposit</span></button>
          <button class="quick-btn" onclick="openModal('sendModal')"><strong>Send</strong><span>Transfer</span></button>
          <button class="quick-btn" onclick="openModal('swapModal')"><strong>DEX</strong><span>Trade</span></button>
        </div>
      </div>
    </section>

    <section class="panel" id="assetsSection">
      <div class="panel-head"><h2 class="title">Crypto Assets</h2><button class="small-btn" onclick="refreshAllBalances(true)">Sync</button></div>
      <div class="asset-scroll" id="assetCards"></div>
    </section>

    <section class="panel tensor-panel" id="tensorAssetsSection">
      <div class="panel-head"><h2 class="title" style="color:var(--tensor);">Tensor Assets (AI)</h2><button class="small-btn" style="color:var(--tensor); border-color:var(--tensor);" onclick="openModal('tensorSendModal')">Send</button></div>
      <div class="asset-scroll" id="tensorCards"></div>
    </section>
  </main>

  <nav class="bottom-nav">
    <button id="navHome" class="active" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); navSetActive('navHome');"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Home</button>
    <button id="navTrading" onclick="window.location.href='trading'"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg>Trading</button>
