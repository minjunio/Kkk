            <div class="field full">
              <button class="mini-btn" onclick="copyBothSeeds()">Copy Seeds</button>
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M3 3v18h18"/>
                    <path d="M7 15l4-4 3 3 5-6"/>
                  </svg>
                </span>
                Trading / Wallet Activity
              </div>
              <div class="section-sub">Live trades, copy allocations, wallet sends, deposits, and history.</div>
            </div>
          </div>

          <div class="tabs">
            <div class="tab active" onclick="switchActivityTab('positions', this)">Positions</div>
            <div class="tab" onclick="switchActivityTab('copy', this)">Copy Trades</div>
            <div class="tab" onclick="switchActivityTab('deposits', this)">Deposits</div>
            <div class="tab" onclick="switchActivityTab('sends', this)">Sends</div>
            <div class="tab" onclick="switchActivityTab('history', this)">History</div>
          </div>

          <div id="positionsView" class="tx-list"></div>
          <div id="copyView" class="tx-list" style="display:none;"></div>
          <div id="depositsView" class="tx-list" style="display:none;"></div>
          <div id="sendsView" class="tx-list" style="display:none;"></div>
          <div id="historyView" class="tx-list" style="display:none;"></div>
        </section>
      </div>

      <aside class="side-panel">
        <section class="panel qr-card">
          <div class="section-head" style="margin-bottom:0;">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                  </svg>
                </span>
                Receive
              </div>
              <div class="section-sub">Choose asset and network. QR works in dark mode.</div>
            </div>
          </div>

          <div class="field">
            <label>Asset</label>
            <select id="receiveAsset"></select>
          </div>

          <div class="network-select" id="networkSelect"></div>

          <div class="qr-box">
            <canvas id="qrCanvas"></canvas>
          </div>

          <div class="address-box" id="receiveAddress">Loading address...</div>

          <button class="primary-btn" onclick="copyCurrentAddress()">Copy Receive Address</button>
        </section>

        <section class="panel" id="sendPanel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M22 2L11 13"/>
                    <path d="M22 2l-7 20-4-9-9-4 20-7Z"/>
                  </svg>
                </span>
                Send
              </div>
              <div class="section-sub">Send normal crypto or Tensor tokens from the selected wallet.</div>
            </div>
          </div>

          <div class="form">
            <div class="field">
              <label>Asset</label>
              <select id="sendAsset"></select>
            </div>

            <div class="field">
              <label>Network</label>
              <select id="sendNetwork"></select>
            </div>

            <div class="field">
              <label>Amount</label>
              <input id="sendAmount" type="number" step="any" placeholder="0.00">
            </div>

            <div class="field">
              <label>To Address</label>
              <textarea id="sendTo" rows="3" placeholder="Paste recipient address"></textarea>
            </div>

            <button class="green-btn" onclick="sendSelectedAsset()">Send Asset</button>

            <div class="mini-note">
              This uses your existing server endpoint and records a demo transaction hash. Real on-chain transfers require wallet signing.
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>
                    <path d="M9 12l2 2 4-4"/>
                  </svg>
                </span>
                Vault
              </div>
              <div class="section-sub">Encrypted vault storage hook for your frontend wallet data.</div>
            </div>
          </div>

          <div class="form">
            <div class="field">
              <label>Encrypted Vault JSON</label>
              <textarea id="vaultInput" rows="4" placeholder="Encrypted wallet payload"></textarea>
            </div>

            <button class="mini-btn" onclick="saveVault()">Save Vault</button>
          </div>
        </section>
      </aside>
    </main>

    <nav class="bottom-nav">
      <button class="active" onclick="window.location.href='/wallet'">
        <svg viewBox="0 0 24 24">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
