    <div class="toast" id="toast">Copied</div>
  </div>

  <script>
    let currentTheme = localStorage.getItem('blue_theme') || 'dark';
    let walletState = SERVER_WALLET || {};
    let tensorRegistry = [];
    let selectedAsset = 'USDT';
    let selectedNetwork = normalizeNetwork(walletState.usdtNetwork || 'eth');
    let selectedAssetType = 'standard';
    let selectedTensorTokenId = '';
    let prices = {};
    let refreshInterval = null;

    const networkMap = {
      eth: {
        key: 'eth',
        network: 'Ethereum',
        short: 'ERC20',
        symbol: 'ETH',
        address: '0x0ab846457e6f9c7e9720a8e8782c9d1f8a260e5a'
      },
      arbitrum: {
        key: 'arbitrum',
        network: 'Arbitrum',
        short: 'ARB',
        symbol: 'ARB',
        address: '0x0ab846457e6f9c7e9720a8e8782c9d1f8a260e5a'
      },
      sol: {
        key: 'sol',
        network: 'Solana',
        short: 'SOL',
        symbol: 'SOL',
        address: '9prrQtQxzdt5Kt7nPHUxwWAVQLZATrj2bjU27k5Xkt5i'
      },
      trx: {
        key: 'trx',
        network: 'TRON',
        short: 'TRC20',
        symbol: 'TRX',
        address: 'TPwY7YfXuufmgfCLF7ie9E2nyo6KhT4fn2'
      }
    };

    const assetMeta = {
      USDT: { name: 'Tether USD', symbol: 'USDT', icon: '₮', stable: true, price: 1, networks: ['eth', 'arbitrum', 'sol', 'trx'] },
      OUSD: { name: 'Origin Dollar', symbol: 'OUSD', icon: 'O', stable: true, price: 1, networks: ['eth', 'arbitrum', 'sol'] },
      BTC: { name: 'Bitcoin', symbol: 'BTC', icon: '₿', binance: 'BTCUSDT', priceId: 'bitcoin', networks: ['eth', 'arbitrum', 'sol'] },
      ETH: { name: 'Ethereum', symbol: 'ETH', icon: 'Ξ', binance: 'ETHUSDT', priceId: 'ethereum', networks: ['eth', 'arbitrum'] },
      SOL: { name: 'Solana', symbol: 'SOL', icon: '◎', binance: 'SOLUSDT', priceId: 'solana', networks: ['sol'] },
      BNB: { name: 'BNB', symbol: 'BNB', icon: 'B', binance: 'BNBUSDT', priceId: 'binancecoin', networks: ['eth', 'arbitrum'] },
      XRP: { name: 'XRP', symbol: 'XRP', icon: 'X', binance: 'XRPUSDT', priceId: 'ripple', networks: ['eth'] },
      DOGE: { name: 'Dogecoin', symbol: 'DOGE', icon: 'D', binance: 'DOGEUSDT', priceId: 'dogecoin', networks: ['eth'] }
    };

    const seedWords = [
      'alpha','orbit','matrix','tensor','vault','river','signal','quantum','neural','forest','silver','phoenix',
      'rocket','cipher','galaxy','anchor','velvet','dragon','ember','crystal','shadow','summit','pixel','vector'
    ];

    function isAdmin() {
      const role = String(SERVER_ROLE || '').toLowerCase();
      const email = String(SERVER_EMAIL || '').toLowerCase();
      const walletRole = String(walletState?.role || '').toLowerCase();

      return role === 'staff'
        || role === 'admin'
        || walletRole === 'staff'
        || walletRole === 'admin'
        || email === 'admin@tensorwallet.local';
    }

    function updateAdminDetectionUI() {
      const badge = document.getElementById('adminDetectedBadge');
      if (badge) badge.classList.toggle('show', isAdmin());

      document.querySelectorAll('.admin-panel').forEach(el => {
        el.classList.toggle('show', isAdmin());
      });
    }

    function normalizeNetwork(network) {
      const raw = String(network || '').trim().toLowerCase();
      if (raw.includes('arb')) return 'arbitrum';
      if (raw.includes('sol')) return 'sol';
      if (raw.includes('tron') || raw.includes('trc') || raw.includes('trx')) return 'trx';
      if (raw.includes('eth') || raw.includes('erc')) return 'eth';
      return 'eth';
    }

    function formatMoney(n, decimals = 2) {
      return (Number(n) || 0).toLocaleString(undefined, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    function formatPriceSmart(price) {
      price = Number(price) || 0;
      if (price >= 1000) return price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (price >= 1) return price.toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      return price.toLocaleString(undefined, { minimumFractionDigits: 6, maximumFractionDigits: 6 });
    }

    function shortAddress(address) {
      const a = String(address || '');
      if (a.length <= 16) return a;
      return `${a.slice(0, 7)}...${a.slice(-6)}`;
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function showToast(message = 'Done') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.classList.add('show');

      clearTimeout(showToast.timer);
      showToast.timer = setTimeout(() => toast.classList.remove('show'), 1800);
    }

    function toggleTheme() {
      currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', currentTheme);
      localStorage.setItem('blue_theme', currentTheme);
      drawQrCodes();
    }

    function coinSvg(symbol, type = 'standard') {
      const s = String(symbol || 'T').toUpperCase().slice(0, 5);
      const text = s === 'USDT' ? '₮' : s === 'BTC' ? '₿' : s === 'ETH' ? 'Ξ' : s === 'SOL' ? '◎' : s.slice(0, 1);

      const normalColors = {
        USDT: ['#26a17b', '#50af95'],
        OUSD: ['#f59e0b', '#f97316'],
        BTC: ['#f7931a', '#fbbf24'],
        ETH: ['#627eea', '#8b5cf6'],
        SOL: ['#14f195', '#9945ff'],
        BNB: ['#f3ba2f', '#f59e0b'],
        XRP: ['#334155', '#64748b'],
        DOGE: ['#c2a633', '#facc15']
      };

      const c = type === 'tensor'
        ? ['#8b5cf6', '#3b82f6']
        : normalColors[s] || ['#8b5cf6', '#3b82f6'];

      return `
        <svg viewBox="0 0 48 48">
          <defs>
            <linearGradient id="g${type}${s}" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="${c[0]}"/>
              <stop offset="100%" stop-color="${c[1]}"/>
            </linearGradient>
          </defs>
          <circle cx="24" cy="24" r="23" fill="url(#g${type}${s})"/>
          <circle cx="24" cy="24" r="17" fill="rgba(255,255,255,0.10)"/>
          ${type === 'tensor' ? '<path d="M15 14h18M24 14v20M18 34h12" stroke="#fff" stroke-width="3" stroke-linecap="round"/>' : ''}
          <text x="24" y="${type === 'tensor' ? '29' : '31'}" text-anchor="middle" font-family="Inter,Arial" font-size="${text.length > 1 ? 13 : 20}" font-weight="900" fill="#fff">${escapeHtml(text)}</text>
        </svg>
      `;
    }

    function simpleHash(str) {
      let h = 2166136261;
      for (let i = 0; i < String(str).length; i++) {
        h ^= String(str).charCodeAt(i);
        h += (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24);
      }
      return Math.abs(h >>> 0);
    }

    function deterministicSeed(kind) {
      const base = `${SERVER_EMAIL}|${walletState.id || ''}|${walletState.tensorAddress || ''}|${kind}`;
      let cursor = simpleHash(base);
      const words = [];

      for (let i = 0; i < 12; i++) {
        cursor = simpleHash(`${cursor}-${base}-${i}`);
        words.push(seedWords[cursor % seedWords.length]);
      }

      return words.join(' ');
    }

    function getUsdtBalance() {
      return Number(walletState.usdtBalance || 0);
    }

    function getOusdBalance() {
      return Number(walletState.ousdBalance || walletState.OUSD || walletState.ousd || 0);
    }

    function getTensorBalance(tokenId) {
      return Number(walletState.tensorBalances?.[tokenId] || 0);
    }

    function getNormalAssetBalance(symbol) {
      if (symbol === 'USDT') return getUsdtBalance();
      if (symbol === 'OUSD') return getOusdBalance();
      return Number(walletState[`${String(symbol).toLowerCase()}Balance`] || 0);
    }

    function getCurrentAssetNetworks() {
      if (selectedAssetType === 'tensor') return ['eth', 'arbitrum', 'sol'];
      return assetMeta[selectedAsset]?.networks || ['eth', 'arbitrum', 'sol', 'trx'];
    }

    function getCurrentAddress() {
      if (selectedAssetType === 'tensor') {
        return walletState.tensorAddress || networkMap.eth.address;
      }

      if (selectedAsset === 'USDT' || selectedAsset === 'OUSD') {
        return walletState.receiveAddresses?.[selectedAsset]?.[selectedNetwork]
          || networkMap[selectedNetwork]?.address
          || networkMap.eth.address;
      }

      const custom = findPublicWalletAddress(selectedAsset, selectedNetwork);
      if (custom) return custom;

      if (selectedNetwork === 'sol') return networkMap.sol.address;
      if (selectedNetwork === 'trx') return networkMap.trx.address;

      return walletState.tensorAddress || networkMap.eth.address;
    }

    function findPublicWalletAddress(asset, network) {
      const candidates = [];

      if (Array.isArray(walletState.publicWallets)) candidates.push(...walletState.publicWallets);
      if (Array.isArray(walletState.assets)) candidates.push(...walletState.assets);
      if (Array.isArray(walletState.wallets)) candidates.push(...walletState.wallets);
      if (Array.isArray(walletState.balances)) candidates.push(...walletState.balances);

      const item = candidates.find(x => {
        const text = JSON.stringify(x || {}).toLowerCase();
        return text.includes(String(asset).toLowerCase()) && text.includes(String(network).toLowerCase());
      });

      if (!item) return '';
      return item.address || item.publicAddress || item.walletAddress || item.depositAddress || '';
    }

    function getNormalAssetPrice(meta) {
      if (meta.stable) return 1;

      if (meta.binance && prices.live && prices.live[meta.binance]) {
        return Number(prices.live[meta.binance].price || 0);
      }

      if (meta.priceId && prices.cg && prices.cg[meta.priceId]) {
        return Number(prices.cg[meta.priceId].usd || 0);
      }

      return 0;
    }

    function getNormalAssetChange(meta) {
      if (meta.stable) return 0;

      if (meta.binance && prices.live && prices.live[meta.binance]) {
        return Number(prices.live[meta.binance].changePercent || 0);
      }

      if (meta.priceId && prices.cg && prices.cg[meta.priceId]) {
        return Number(prices.cg[meta.priceId].usd_24h_change || 0);
      }

      return 0;
    }

    function buildNormalAssets() {
      return Object.values(assetMeta).map(meta => {
        const balance = getNormalAssetBalance(meta.symbol);
        const price = getNormalAssetPrice(meta);
        const change = getNormalAssetChange(meta);

        return {
          ...meta,
          balance,
          price,
          change,
          usdValue: balance * price,
          type: 'standard',
          tokenId: ''
        };
      });
    }

    function buildTensorAssets() {
      return tensorRegistry.map(t => {
        const balance = getTensorBalance(t.id);
        const price = Number(t.price || 0);

        return {
          name: t.name || t.symbol,
          symbol: t.symbol,
          balance,
          price,
          change: Number(t.changePercent24h || 0),
          usdValue: balance * price,
          type: 'tensor',
          tokenId: t.id,
          raw: t
        };
      });
    }

    function calculateTotalBalance() {
      const normalTotal = buildNormalAssets().reduce((sum, a) => sum + Number(a.usdValue || 0), 0);
      const tensorTotal = buildTensorAssets().reduce((sum, a) => sum + Number(a.usdValue || 0), 0);
      return normalTotal + tensorTotal;
    }

