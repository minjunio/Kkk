        <div style="margin:14px auto 12px;" class="qr-box">
          <canvas id="modalQrCanvas"></canvas>
        </div>

        <div class="address-box" id="modalReceiveAddress">Loading...</div>

        <div class="modal-actions">
          <button class="mini-btn" onclick="closeReceiveModal()">Close</button>
          <button class="primary-btn" onclick="copyCurrentAddress()">Copy Address</button>
        </div>
      </div>
    </div>

    <div class="modal-backdrop" id="tokenModal">
      <div class="modal">
        <div class="modal-title" id="tokenModalTitle">Edit Tensor Token</div>
        <div class="modal-desc">Admin can edit the selected Tensor token currency.</div>

        <input id="modalTokenId" type="hidden">

        <div class="form-grid" style="margin-top:14px;">
          <div class="field">
            <label>Name</label>
            <input id="modalTokenName">
          </div>

          <div class="field">
            <label>Symbol</label>
            <input id="modalTokenSymbol" maxlength="12">
          </div>

          <div class="field">
            <label>Price</label>
            <input id="modalTokenPrice" type="number" step="any">
          </div>

          <div class="field">
            <label>Supply</label>
            <input id="modalTokenSupply" type="number" step="any">
          </div>

          <div class="field">
            <label>Bias</label>
            <select id="modalTokenBias">
              <option value="balanced">Balanced</option>
              <option value="bullish">Bullish</option>
              <option value="bearish">Bearish</option>
              <option value="pegged">Pegged</option>
