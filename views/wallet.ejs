        return;
      }

      view.innerHTML = positions.map(p => {
        const pnl = calculatePositionPnl(p);
        const roi = Number(p.margin || 0) > 0 ? (pnl / Number(p.margin)) * 100 : 0;
        const color = pnl >= 0 ? 'text-green' : 'text-red';

        return `
          <div class="tx-card">
            <div class="tx-top">
              <div>
                <div class="tx-title">${escapeHtml(p.symbol)} ${escapeHtml(p.side)} ${Number(p.leverage || 1)}x</div>
                <div class="tx-date">${p.openedAt ? new Date(p.openedAt).toLocaleString() : 'Open position'}</div>
              </div>
              <div style="text-align:right;">
                <div class="${color}" style="font-weight:950;">${pnl >= 0 ? '+' : '-'}$${formatMoney(Math.abs(pnl))}</div>
                <div class="${color}" style="font-size:.7rem;font-weight:900;">${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%</div>
              </div>
            </div>
            <div class="tx-detail">
              Margin $${formatMoney(p.margin)} ${escapeHtml(p.settlementAsset || 'USDT')} • Size $${formatMoney(p.size)} • Entry $${formatPriceSmart(p.entryPrice)} • Mark $${formatPriceSmart(p.markPrice)}
            </div>
          </div>
        `;
      }).join('');
    }

    function calculatePositionPnl(p) {
      const entry = Number(p.entryPrice || 0);
      const mark = Number(p.markPrice || p.entryPrice || 0);
      const size = Number(p.size || 0);

      if (!entry || !size) return 0;

      const diff = p.side === 'short' ? entry - mark : mark - entry;
      return (diff / entry) * size;
    }

