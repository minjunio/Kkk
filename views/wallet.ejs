      OP: { name: 'Optimism', price: 2.62, change24h: 1.8, cap: '$2.8B', type: 'alt-coins' },
      RENDER: { name: 'Render', price: 9.4, change24h: 3.1, cap: '$4.7B', type: 'alt-coins' },
      PEPE: { name: 'Pepe', price: 0.000012, change24h: 6.5, cap: '$5.1B', type: 'alt-coins' },
      WLD: { name: 'Worldcoin', price: 5.7, change24h: -4.2, cap: '$1.4B', type: 'alt-coins' }
    };

    const DEFAULT_PORTFOLIO = [
      { currency: 'BTC', name: 'Bitcoin', amount: 0.45, avgBuyPrice: 62000 },
      { currency: 'ETH', name: 'Ethereum', amount: 4.25, avgBuyPrice: 2850.5 },
      { currency: 'SOL', name: 'Solana', amount: 145.5, avgBuyPrice: 85.2 }
    ];

    const DEFAULT_VAULTS = [
      { currency: 'ETH', name: 'Ethereum Validator', stakedAmount: 2.5, apy: 5.5, earnedAmount: 0 },
      { currency: 'SOL', name: 'Solana Delegation', stakedAmount: 50, apy: 7.2, earnedAmount: 0 }
    ];

    let marketPrices = JSON.parse(localStorage.getItem('bc_markets_v2')) || structuredClone(DEFAULT_MARKETS);
    let portfolio = JSON.parse(localStorage.getItem('bc_portfolio_v2')) || structuredClone(DEFAULT_PORTFOLIO);
    let stakingVaults = JSON.parse(localStorage.getItem('bc_vaults_v2')) || structuredClone(DEFAULT_VAULTS);
    let currentActiveMarketTab = 'top-crypto';
    let lastTimestamp = parseInt(localStorage.getItem('bc_last_update_v2') || Date.now(), 10);
    let toastTimer = null;

    function saveData() {
      localStorage.setItem('bc_markets_v2', JSON.stringify(marketPrices));
      localStorage.setItem('bc_portfolio_v2', JSON.stringify(portfolio));
      localStorage.setItem('bc_vaults_v2', JSON.stringify(stakingVaults));
      localStorage.setItem('bc_last_update_v2', String(lastTimestamp));
    }

    function money(value) {
      const num = Number(value) || 0;
      const digits = Math.abs(num) < 1 && num !== 0 ? 6 : 2;
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: digits, maximumFractionDigits: digits }).format(num);
    }

    function compactMoney(value) {
      const num = Number(value) || 0;
      return new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 2, style: 'currency', currency: 'USD' }).format(num);
    }

    function amountFmt(value) {
      return Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: 8 });
    }

    function coinIcon(symbol) {
      return `https://assets.coincap.io/assets/icons/${String(symbol).toLowerCase()}@2x.png`;
    }

    function iconHtml(symbol) {
      const safe = String(symbol).replace(/[^A-Z0-9]/gi, '').toUpperCase();
      return `<div class="coin-icon"><img src="${coinIcon(safe)}" alt="${safe}" onerror="this.remove(); this.parentNode.textContent='${safe.slice(0, 3)}';" /></div>`;
    }

    function toast(message) {
      const el = document.getElementById('toast');
      el.textContent = message;
      el.classList.add('active');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove('active'), 2300);
    }

    function pnlClass(value) {
      if (value > 0) return 'pnl-positive';
      if (value < 0) return 'pnl-negative';
      return 'pnl-neutral';
    }

    function updateStakingYield() {
      const now = Date.now();
      const elapsedMs = Math.max(0, now - lastTimestamp);
      const elapsedYears = elapsedMs / (1000 * 60 * 60 * 24 * 365.25);
      stakingVaults.forEach(vault => {
        vault.earnedAmount = Number(vault.earnedAmount || 0) + (Number(vault.stakedAmount || 0) * (Number(vault.apy || 0) / 100) * elapsedYears);
      });
      lastTimestamp = now;
      saveData();
    }

    async function refreshPrices(manual = false) {
      const syncText = document.getElementById('syncText');
      const feedStatus = document.getElementById('feedStatus');
      const symbols = [...new Set([...Object.keys(DEFAULT_MARKETS), ...portfolio.map(a => a.currency), ...stakingVaults.map(v => v.currency)])]
        .map(s => String(s).toUpperCase())
        .filter(s => COINGECKO_IDS[s]);
      const ids = symbols.map(s => COINGECKO_IDS[s]).join(',');
      if (!ids) return;

      try {
        syncText.textContent = 'Updating prices...';
        const url = `https://api.coingecko.com/api/v3/simple/price?ids=${encodeURIComponent(ids)}&vs_currencies=usd&include_24hr_change=true&include_market_cap=true`;
        const res = await fetch(url, { cache: 'no-store' });
        if (!res.ok) throw new Error('Price feed failed');
        const data = await res.json();

        symbols.forEach(symbol => {
          const id = COINGECKO_IDS[symbol];
          if (!data[id] || typeof data[id].usd !== 'number') return;
          const current = marketPrices[symbol] || { name: symbol, type: 'watchlist' };
          marketPrices[symbol] = {
            ...current,
            name: current.name || symbol,
            price: data[id].usd,
            change24h: data[id].usd_24h_change || 0,
            cap: data[id].usd_market_cap ? compactMoney(data[id].usd_market_cap) : current.cap || '--',
            type: current.type || 'watchlist'
          };
        });

        syncText.textContent = `Live sync • ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
        if (feedStatus) feedStatus.textContent = 'Live CoinGecko crypto prices loaded successfully.';
        saveData();
        renderDashboard(false);
        if (manual) toast('Live prices refreshed');
      } catch (err) {
        syncText.textContent = 'Local price fallback';
        if (feedStatus) feedStatus.textContent = 'Live feed was blocked or rate-limited. Local fallback simulation is active.';
        simulateFallbackPrices();
        renderDashboard(false);
        if (manual) toast('Live feed unavailable, using fallback prices');
      }
    }

    function simulateFallbackPrices() {
      Object.keys(marketPrices).forEach(symbol => {
        const data = marketPrices[symbol];
        const delta = (Math.random() - 0.5) * 0.004;
        data.price = Math.max(0.0000001, Number(data.price || 1) * (1 + delta));
        data.change24h = Number(data.change24h || 0) + (Math.random() - 0.5) * 0.18;
      });
      saveData();
    }

    function openSettings(targetId) {
      document.getElementById('settingsOverlay').classList.add('active');
      renderAssetManager();
      if (targetId) setTimeout(() => document.getElementById(targetId)?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
    }

    function closeSettings() {
      document.getElementById('settingsOverlay').classList.remove('active');
    }

    function openModal(id) {
      populateSelects();
      document.getElementById(id).classList.add('active');
      if (id === 'swapModal') calculateSwapFees();
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    function overlayClose(event, id) {
      if (event.target.id === id) document.getElementById(id).classList.remove('active');
    }

    function setTheme(theme) {
      if (theme === 'midnight') document.documentElement.setAttribute('data-theme', 'midnight');
      else document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('bc_theme_v2', theme);
      toast(theme === 'midnight' ? 'Midnight theme enabled' : 'Cloud blue theme enabled');
    }

    function loadTheme() {
      setTheme(localStorage.getItem('bc_theme_v2') || 'cloud');
    }

    function clearAssetForm() {
      ['assetSearchInput', 'currencyInput', 'nameInput', 'amountInput', 'buyPriceInput'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('assetSuggestions').classList.remove('active');
    }

    function filterAssetSearch(query, boxId, callback) {
      const box = document.getElementById(boxId);
      const q = query.trim().toLowerCase();
      box.innerHTML = '';
      if (!q) {
        box.classList.remove('active');
        return;
      }

      const matches = Object.keys(marketPrices)
        .filter(symbol => symbol.toLowerCase().includes(q) || String(marketPrices[symbol].name).toLowerCase().includes(q))
        .slice(0, 18);

      if (!matches.length) {
        box.innerHTML = `<div class="suggestion"><span>No match. Type a custom symbol below.</span></div>`;
        box.classList.add('active');
        return;
      }

      matches.forEach(symbol => {
        const item = document.createElement('div');
        item.className = 'suggestion';
        item.innerHTML = `<span><strong>${symbol}</strong> · ${marketPrices[symbol].name}</span><span>${money(marketPrices[symbol].price)}</span>`;
        item.onclick = () => {
          callback(symbol);
          box.classList.remove('active');
        };
        box.appendChild(item);
      });
      box.classList.add('active');
    }

    function selectAssetTicker(symbol) {
      const data = marketPrices[symbol] || { name: symbol, price: 0 };
      const existing = portfolio.find(a => a.currency === symbol);
      document.getElementById('assetSearchInput').value = `${symbol} · ${data.name}`;
      document.getElementById('currencyInput').value = symbol;
      document.getElementById('nameInput').value = existing?.name || data.name || symbol;
      document.getElementById('amountInput').value = existing?.amount ?? '';
      document.getElementById('buyPriceInput').value = existing?.avgBuyPrice ?? data.price ?? '';
    }

    function selectStakeTicker(symbol) {
      document.getElementById('stakeSearchInput').value = `${symbol} · ${marketPrices[symbol]?.name || symbol}`;
      document.getElementById('stakeAssetTarget').value = symbol;
    }

    function saveAssetEntry() {
      const symbol = document.getElementById('currencyInput').value.trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
      const name = document.getElementById('nameInput').value.trim() || marketPrices[symbol]?.name || symbol;
      const amount = parseFloat(document.getElementById('amountInput').value);
      const avgBuyPrice = parseFloat(document.getElementById('buyPriceInput').value) || marketPrices[symbol]?.price || 0;

      if (!symbol || Number.isNaN(amount)) {
        toast('Enter a valid symbol and balance');
        return;
      }

      if (!marketPrices[symbol]) {
        marketPrices[symbol] = { name, price: avgBuyPrice || 1, change24h: 0, cap: 'Custom', type: 'watchlist' };
      } else {
        marketPrices[symbol].name = name;
      }

      if (amount <= 0) {
        portfolio = portfolio.filter(a => a.currency !== symbol);
        toast(`${symbol} removed from wallet`);
      } else {
        const existing = portfolio.find(a => a.currency === symbol);
        if (existing) {
          existing.name = name;
          existing.amount = amount;
          existing.avgBuyPrice = avgBuyPrice;
          toast(`${symbol} updated`);
        } else {
          portfolio.push({ currency: symbol, name, amount, avgBuyPrice });
          toast(`${symbol} added to wallet`);
        }
      }

      saveData();
      clearAssetForm();
      renderDashboard(false);
      renderAssetManager();
      refreshPrices(false);
    }

    function editAsset(symbol) {
      selectAssetTicker(symbol);
      document.getElementById('assetTools').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function removeAsset(symbol) {
      portfolio = portfolio.filter(a => a.currency !== symbol);
      saveData();
      renderDashboard(false);
      renderAssetManager();
      toast(`${symbol} removed`);
    }

    function renderAssetManager() {
      const list = document.getElementById('assetManagerList');
      if (!portfolio.length) {
        list.innerHTML = `<div class="empty-state">No assets yet. Search a coin above and add your balance.</div>`;
        return;
      }

      list.innerHTML = portfolio.map(asset => {
        const live = marketPrices[asset.currency] || { price: 0 };
        return `
          <div class="manager-item">
            <div>
              <div class="manager-name">${asset.name} · ${asset.currency}</div>
              <div class="manager-balance">${amountFmt(asset.amount)} ${asset.currency} · ${money(asset.amount * live.price)}</div>
            </div>
            <div class="manager-actions">
              <button class="small-icon-button" type="button" onclick="editAsset('${asset.currency}')">✎</button>
              <button class="small-icon-button danger" type="button" onclick="removeAsset('${asset.currency}')">×</button>
            </div>
          </div>
        `;
      }).join('');
    }

    function populateSelects() {
      const portfolioOptions = portfolio.map(a => `<option value="${a.currency}">${a.name} (${a.currency}) · ${amountFmt(a.amount)}</option>`).join('');
      const allOptions = Object.keys(marketPrices).sort().map(s => `<option value="${s}">${marketPrices[s].name} (${s})</option>`).join('');
      ['sendAssetSelect', 'swapSrcSelect'].forEach(id => document.getElementById(id).innerHTML = portfolioOptions || '<option>No assets</option>');
      document.getElementById('swapDestSelect').innerHTML = allOptions;
    }

    function executeSendAction() {
      const symbol = document.getElementById('sendAssetSelect').value;
      const amount = parseFloat(document.getElementById('sendAmountInput').value);
      const asset = portfolio.find(a => a.currency === symbol);
      if (!asset || Number.isNaN(amount) || amount <= 0 || amount > asset.amount) {
        toast('Invalid send amount');
        return;
      }
      asset.amount -= amount;
      if (asset.amount <= 0) portfolio = portfolio.filter(a => a.currency !== symbol);
      saveData();
      closeModal('sendModal');
      renderDashboard(false);
      toast(`Sent ${amountFmt(amount)} ${symbol}`);
    }

    function calculateSwapFees() {
      const src = document.getElementById('swapSrcSelect').value;
      const dest = document.getElementById('swapDestSelect').value;
      const amount = parseFloat(document.getElementById('swapAmountInput').value) || 0;
      const srcPrice = marketPrices[src]?.price || 0;
      const destPrice = marketPrices[dest]?.price || 1;
      const grossUsd = amount * srcPrice;
      const fee = grossUsd * 0.003;
      const receive = destPrice > 0 ? (grossUsd - fee) / destPrice : 0;
      document.getElementById('feeNetworkSpan').textContent = money(fee);
      document.getElementById('swapTargetReceiveSpan').textContent = `${amountFmt(receive)} ${dest || ''}`;
    }

    function executeSwapAction() {
      const src = document.getElementById('swapSrcSelect').value;
      const dest = document.getElementById('swapDestSelect').value;
      const amount = parseFloat(document.getElementById('swapAmountInput').value) || 0;
      const srcAsset = portfolio.find(a => a.currency === src);
      if (!srcAsset || !dest || src === dest || amount <= 0 || amount > srcAsset.amount) {
        toast('Invalid swap');
        return;
      }
      const netUsd = amount * (marketPrices[src]?.price || 0) * 0.997;
      const receive = netUsd / (marketPrices[dest]?.price || 1);
      srcAsset.amount -= amount;
      if (srcAsset.amount <= 0) portfolio = portfolio.filter(a => a.currency !== src);
      const destAsset = portfolio.find(a => a.currency === dest);
      if (destAsset) destAsset.amount += receive;
      else portfolio.push({ currency: dest, name: marketPrices[dest]?.name || dest, amount: receive, avgBuyPrice: marketPrices[dest]?.price || 0 });
      saveData();
      closeModal('swapModal');
      renderDashboard(false);
      toast(`Swapped into ${dest}`);
    }

    function executeStakingModification() {
      const type = document.getElementById('stakeOperationType').value;
      const symbol = document.getElementById('stakeAssetTarget').value.trim().toUpperCase();
      const amount = parseFloat(document.getElementById('stakeActionAmountInput').value) || 0;
      if (!symbol || amount <= 0) {
        toast('Choose an asset and amount');
        return;
      }

      if (type === 'STAKE') {
        const asset = portfolio.find(a => a.currency === symbol);
        if (!asset || asset.amount < amount) {
          toast('Insufficient spot balance');
          return;
        }
        asset.amount -= amount;
        if (asset.amount <= 0) portfolio = portfolio.filter(a => a.currency !== symbol);
        const vault = stakingVaults.find(v => v.currency === symbol);
        if (vault) vault.stakedAmount += amount;
        else stakingVaults.push({ currency: symbol, name: `${marketPrices[symbol]?.name || symbol} Vault`, stakedAmount: amount, apy: 5.5, earnedAmount: 0 });
        toast(`Staked ${amountFmt(amount)} ${symbol}`);
      } else {
        const vault = stakingVaults.find(v => v.currency === symbol);
        if (!vault || vault.stakedAmount < amount) {
          toast('Insufficient staked balance');
          return;
        }
        vault.stakedAmount -= amount;
        const asset = portfolio.find(a => a.currency === symbol);
        if (asset) asset.amount += amount;
        else portfolio.push({ currency: symbol, name: marketPrices[symbol]?.name || symbol, amount, avgBuyPrice: marketPrices[symbol]?.price || 0 });
        stakingVaults = stakingVaults.filter(v => v.stakedAmount > 0);
        toast(`Unstaked ${amountFmt(amount)} ${symbol}`);
      }
      saveData();
      closeModal('stakeActionModal');
      renderDashboard(false);
    }

    function copyReceiveAddress() {
      const value = document.getElementById('receiveAddress').value;
      navigator.clipboard?.writeText(value);
      toast('Address copied');
    }

    function switchMarketTab(tabName, element) {
      currentActiveMarketTab = tabName;
      document.querySelectorAll('.tab').forEach(btn => btn.classList.remove('active'));
      element.classList.add('active');
      renderMarketTabSection();
    }

    function marketSymbolsForTab() {
      if (currentActiveMarketTab === 'watchlist') {
        return [...new Set([...portfolio.map(a => a.currency), ...stakingVaults.map(v => v.currency)])];
      }
      return Object.keys(marketPrices).filter(symbol => marketPrices[symbol].type === currentActiveMarketTab);
    }

    function renderMarketTabSection() {
      const list = document.getElementById('marketTabsList');
      const symbols = marketSymbolsForTab();
      if (!symbols.length) {
        list.innerHTML = `<div class="empty-state">Your watchlist is empty. Add assets from settings.</div>`;
        return;
      }
      list.innerHTML = symbols.map(symbol => {
        const data = marketPrices[symbol] || { name: symbol, price: 0, change24h: 0, cap: '--' };
        const sign = data.change24h >= 0 ? '+' : '';
        return `
          <div class="market-card">
            <div class="asset-main">
              ${iconHtml(symbol)}
              <div>
                <div class="asset-name">${data.name}</div>
                <div class="asset-symbol">${symbol}</div>
              </div>
            </div>
            <div>
              <div class="cell-label">Price</div>
              <div class="cell-value">${money(data.price)}</div>
              <div class="cell-sub">Cap ${data.cap || '--'}</div>
            </div>
            <div>
              <div class="cell-label">24h</div>
              <div class="cell-value"><span class="pnl-chip ${pnlClass(data.change24h)}">${sign}${Number(data.change24h || 0).toFixed(2)}%</span></div>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderDashboard(runYield = true) {
      if (runYield) updateStakingYield();

      let totalValue = 0;
      let totalCostValue = 0;
      let dayWeighted = 0;
      let best = null;
      let largest = null;
      const list = document.getElementById('portfolioList');

      if (!portfolio.length) {
        list.innerHTML = `<div class="empty-state">No assets added yet. Tap the top-right settings button to add BTC, ETH, SOL or any custom asset.</div>`;
      } else {
        list.innerHTML = portfolio.map(asset => {
          const live = marketPrices[asset.currency] || { price: 0, change24h: 0 };
          const value = asset.amount * live.price;
          const cost = asset.amount * (asset.avgBuyPrice || 0);
          const pnl = value - cost;
          const roi = cost > 0 ? (pnl / cost) * 100 : 0;
          totalValue += value;
          totalCostValue += cost;
          dayWeighted += value * ((live.change24h || 0) / 100);
          if (!best || roi > best.roi) best = { symbol: asset.currency, roi };
          if (!largest || value > largest.value) largest = { symbol: asset.currency, value };

          return `
            <div class="asset-card">
              <div class="asset-main">
                ${iconHtml(asset.currency)}
                <div>
                  <div class="asset-name">${asset.name}</div>
                  <div class="asset-symbol">${asset.currency} · ${amountFmt(asset.amount)}</div>
                </div>
              </div>
              <div>
                <div class="cell-label">Price</div>
                <div class="cell-value">${money(live.price)}</div>
                <div class="cell-sub ${pnlClass(live.change24h)}">${live.change24h >= 0 ? '+' : ''}${Number(live.change24h || 0).toFixed(2)}% 24h</div>
              </div>
              <div>
                <div class="cell-label">Holdings</div>
                <div class="cell-value">${amountFmt(asset.amount)}</div>
                <div class="cell-sub">${asset.currency}</div>
              </div>
              <div>
                <div class="cell-label">Value</div>
                <div class="cell-value">${money(value)}</div>
                <div class="cell-sub ${pnlClass(pnl)}">${pnl >= 0 ? '+' : ''}${money(Math.abs(pnl))} · ${pnl >= 0 ? '+' : ''}${roi.toFixed(2)}%</div>
              </div>
              <div class="hide-mobile">
                <button class="small-icon-button" type="button" onclick="openSettings('assetTools'); editAsset('${asset.currency}')">✎</button>
              </div>
            </div>
          `;
        }).join('');
      }

      const totalPnl = totalValue - totalCostValue;
      const totalRoi = totalCostValue > 0 ? (totalPnl / totalCostValue) * 100 : 0;
      const dayPct = totalValue > 0 ? (dayWeighted / totalValue) * 100 : 0;

      document.getElementById('totalBalance').textContent = money(totalValue);
      const totalPnlEl = document.getElementById('totalPnl');
      totalPnlEl.className = `pnl-chip ${pnlClass(totalPnl)}`;
      totalPnlEl.textContent = `${totalPnl >= 0 ? '+' : ''}${money(Math.abs(totalPnl))} (${totalPnl >= 0 ? '+' : ''}${totalRoi.toFixed(2)}%)`;
      document.getElementById('spotCount').textContent = portfolio.length;
      document.getElementById('totalCost').textContent = money(totalCostValue);
      document.getElementById('bestAsset').textContent = best ? `${best.symbol} ${best.roi >= 0 ? '+' : ''}${best.roi.toFixed(1)}%` : '--';
      document.getElementById('largestHolding').textContent = largest ? `${largest.symbol}` : '--';
      document.getElementById('dayChange').textContent = `${dayPct >= 0 ? '+' : ''}${dayPct.toFixed(2)}%`;
      document.getElementById('dayChange').style.color = dayPct >= 0 ? 'var(--success)' : 'var(--danger)';

      renderStaking();
      renderMarketTabSection();
      renderAssetManager();
      populateSelects();
    }

    function renderStaking() {
      let totalStaking = 0;
      let totalYieldUsd = 0;
      const list = document.getElementById('stakingList');

      if (!stakingVaults.length) {
        list.innerHTML = `<div class="empty-state">No active vaults. Tap Stake to lock an asset into a demo vault.</div>`;
      } else {
        list.innerHTML = stakingVaults.map(vault => {
          const price = marketPrices[vault.currency]?.price || 0;
          const value = vault.stakedAmount * price;
          const yieldUsd = (vault.earnedAmount || 0) * price;
          totalStaking += value;
          totalYieldUsd += yieldUsd;
          return `
            <div class="vault-card">
              <div class="asset-main">
                ${iconHtml(vault.currency)}
                <div>
                  <div class="asset-name">${vault.name}</div>
                  <div class="asset-symbol">${vault.currency}</div>
                </div>
              </div>
              <div>
                <div class="cell-label">Locked</div>
                <div class="cell-value">${amountFmt(vault.stakedAmount)} ${vault.currency}</div>
                <div class="cell-sub">${money(value)}</div>
              </div>
              <div>
                <div class="cell-label">Yield</div>
                <div class="cell-value"><span class="pnl-chip pnl-positive">${vault.apy}% APY</span></div>
                <div class="cell-sub pnl-positive">+${amountFmt(vault.earnedAmount)} ${vault.currency}</div>
              </div>
            </div>
          `;
        }).join('');
      }
      document.getElementById('stakingBalance').textContent = money(totalStaking);
      document.getElementById('stakingProfits').textContent = `+${money(totalYieldUsd)}`;
    }

    function scrollToSection(id, button) {
      document.querySelectorAll('.bottom-nav button').forEach(b => b.classList.remove('active'));
      button.classList.add('active');
      if (id === 'top') window.scrollTo({ top: 0, behavior: 'smooth' });
      else document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function resetDemoData() {
      marketPrices = structuredClone(DEFAULT_MARKETS);
      portfolio = structuredClone(DEFAULT_PORTFOLIO);
      stakingVaults = structuredClone(DEFAULT_VAULTS);
      lastTimestamp = Date.now();
      saveData();
      renderDashboard(false);
      toast('Demo wallet reset');
      refreshPrices(false);
    }

    window.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeSettings();
        document.querySelectorAll('.modal-overlay.active').forEach(el => el.classList.remove('active'));
      }
    });

    window.addEventListener('click', event => {
      if (!event.target.closest('.form-row')) {
        document.querySelectorAll('.suggestions').forEach(el => el.classList.remove('active'));
      }
    });

    loadTheme();
    renderDashboard(false);
    refreshPrices(false);
    setInterval(() => refreshPrices(false), 60000);
    setInterval(() => {
      simulateFallbackPrices();
      renderDashboard();
    }, 5000);
  </script></body>
</html>