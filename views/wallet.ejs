<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Blue Wallet</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      color-scheme: light;
      --bg: #f4f9ff;
      --bg2: #e9f4ff;
      --surface: #ffffff;
      --surface2: #f7fbff;
      --surface3: #eef6ff;
      --text: #0f172a;
      --muted: #64748b;
      --muted2: #94a3b8;
      --border: rgba(15, 23, 42, 0.08);
      --border2: rgba(2, 132, 199, 0.24);
      --blue: #0284c7;
      --blue2: #2563eb;
      --green: #16a34a;
      --red: #e11d48;
      --orange: #d97706;
      --shadow: 0 24px 70px rgba(15, 23, 42, 0.09);
      --shadow2: 0 12px 32px rgba(15, 23, 42, 0.07);
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg: #050816;
      --bg2: #08111f;
      --surface: #0d1628;
      --surface2: #111d33;
      --surface3: #15233d;
      --text: #f8fafc;
      --muted: #94a3b8;
      --muted2: #64748b;
      --border: rgba(125, 211, 252, 0.13);
      --border2: rgba(56, 189, 248, 0.3);
      --blue: #38bdf8;
      --blue2: #2563eb;
      --green: #38bdf8;
      --red: #fb7185;
      --shadow: 0 24px 80px rgba(0,0,0,0.36);
      --shadow2: 0 12px 34px rgba(0,0,0,0.22);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(2,132,199,.12), transparent 30%),
        radial-gradient(circle at bottom right, rgba(22,163,74,.08), transparent 24%),
        linear-gradient(135deg, var(--bg), var(--bg2));
      padding-bottom: calc(86px + var(--safe-bottom));
      overflow-x: hidden;
    }

    button, input, select, textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 40;
      padding: calc(10px + var(--safe-top)) 12px 10px;
      background: rgba(244,249,255,.9);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(16px);
    }

    [data-theme="dark"] .topbar {
      background: rgba(5,8,22,.9);
    }

    .topbar-inner {
      width: min(1120px, 100%);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .logo {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: white;
      font-weight: 950;
      background: linear-gradient(135deg, var(--blue2), #38bdf8);
      box-shadow: 0 12px 28px rgba(37,99,235,.2);
      flex: 0 0 auto;
    }

    .brand-title {
      font-size: 1rem;
      font-weight: 950;
      letter-spacing: -.045em;
      white-space: nowrap;
    }

    .brand-sub {
      margin-top: 2px;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      box-shadow: var(--shadow2);
      font-weight: 950;
      transition: transform .18s ease, border-color .18s ease;
    }

    .icon-btn:hover {
      transform: translateY(-1px);
      border-color: var(--border2);
    }

    .user-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 10px 7px 7px;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow2);
      font-size: .78rem;
      font-weight: 900;
    }

    .avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
    }

    .shell {
      width: min(1120px, 100%);
      margin: 0 auto;
      padding: 12px;
    }

    .hero {
      border-radius: 26px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      padding: 18px;
      overflow: hidden;
      position: relative;
    }

    .hero::after {
      content: "";
      position: absolute;
      right: -80px;
      bottom: -120px;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(2,132,199,.12), transparent 68%);
      pointer-events: none;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 370px;
      gap: 14px;
      position: relative;
      z-index: 1;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      color: var(--blue);
      background: rgba(2,132,199,.08);
      border: 1px solid var(--border2);
      font-size: .74rem;
      font-weight: 950;
    }

    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--blue);
      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(2,132,199,.42); }
      80% { box-shadow: 0 0 0 9px rgba(2,132,199,0); }
      100% { box-shadow: 0 0 0 0 rgba(2,132,199,0); }
    }

    .address-line {
      margin-top: 14px;
      color: var(--muted);
      font-size: .8rem;
      font-weight: 800;
      word-break: break-all;
      line-height: 1.45;
    }

    .big-balance {
      margin-top: 10px;
      font-size: clamp(2.3rem, 9vw, 4.6rem);
      line-height: .95;
      letter-spacing: -.075em;
      font-weight: 950;
      font-variant-numeric: tabular-nums;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .meta-chip {
      padding: 8px 10px;
      border-radius: 999px;
      color: var(--muted);
      background: var(--surface2);
      border: 1px solid var(--border);
      font-size: .73rem;
      font-weight: 850;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      align-content: end;
    }

    .action-card {
      min-height: 78px;
      border-radius: 20px;
      padding: 13px;
      text-align: left;
      color: var(--text);
      background: var(--surface2);
      border: 1px solid var(--border);
      box-shadow: var(--shadow2);
      transition: transform .18s ease, border-color .18s ease;
    }

    .action-card:hover {
      transform: translateY(-1px);
      border-color: var(--border2);
    }

    .action-card.primary {
      color: white;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
      border-color: transparent;
    }

    .action-card strong {
      display: block;
      font-size: .92rem;
      font-weight: 950;
      margin-bottom: 5px;
    }

    .action-card span {
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
      line-height: 1.3;
    }

    .action-card.primary span {
      color: rgba(255,255,255,.82);
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 12px;
      margin-top: 12px;
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow2);
      padding: 14px;
      overflow: hidden;
    }

    .panel + .panel {
      margin-top: 12px;
    }

    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 12px;
    }

    .panel-title {
      font-size: 1rem;
      font-weight: 950;
      letter-spacing: -.04em;
    }

    .panel-sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: .76rem;
      font-weight: 750;
      line-height: 1.45;
    }

    .list {
      display: grid;
      gap: 8px;
    }

    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      align-items: center;
      padding: 12px;
      border-radius: 17px;
      background: var(--surface2);
      border: 1px solid var(--border);
    }

    .asset-main {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .coin {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      background: var(--surface3);
      border: 1px solid var(--border);
      color: var(--blue);
      font-size: .72rem;
      font-weight: 950;
      overflow: hidden;
    }

    .coin img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .name {
      font-weight: 950;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: .73rem;
      font-weight: 800;
      word-break: break-word;
      line-height: 1.45;
    }

    .value {
      text-align: right;
      font-weight: 950;
      font-variant-numeric: tabular-nums;
    }

    .value-sub {
      margin-top: 3px;
      text-align: right;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
    }

    .small-btn,
    .primary-btn,
    .secondary-btn,
    .danger-btn {
      min-height: 44px;
      border-radius: 14px;
      font-weight: 950;
      transition: transform .18s ease, border-color .18s ease, opacity .18s ease;
    }

    .small-btn {
      padding: 0 12px;
      color: var(--text);
      background: var(--surface2);
      border: 1px solid var(--border);
      font-size: .76rem;
      white-space: nowrap;
    }

    .primary-btn {
      color: white;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
      box-shadow: 0 14px 30px rgba(37,99,235,.18);
    }

    .secondary-btn {
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--border);
    }

    .danger-btn {
      color: white;
      background: linear-gradient(135deg, #be123c, #fb7185);
    }

    .small-btn:hover,
    .primary-btn:hover,
    .secondary-btn:hover,
    .danger-btn:hover {
      transform: translateY(-1px);
      border-color: var(--border2);
    }

    .primary-btn:disabled,
    .secondary-btn:disabled,
    .danger-btn:disabled {
      opacity: .55;
      cursor: not-allowed;
      transform: none;
    }

    .pill-row {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 3px;
      margin-bottom: 10px;
    }

    .pill-row::-webkit-scrollbar {
      display: none;
    }

    .pill-btn {
      flex: 0 0 auto;
      min-height: 39px;
      padding: 0 13px;
      border-radius: 999px;
      background: var(--surface2);
      color: var(--muted);
      border: 1px solid var(--border);
      font-size: .75rem;
      font-weight: 950;
    }

    .pill-btn.active {
      color: white;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
      border-color: transparent;
    }

    .form-grid {
      display: grid;
      gap: 10px;
    }

    .form-row {
      display: grid;
      gap: 7px;
    }

    .form-row label {
      color: var(--muted);
      font-size: .72rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .input,
    .select,
    .textarea {
      width: 100%;
      min-height: 46px;
      border-radius: 14px;
      padding: 12px;
      color: var(--text);
      background: var(--surface2);
      border: 1px solid var(--border);
      outline: none;
      font-weight: 850;
    }

    .textarea {
      min-height: 112px;
      resize: vertical;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      line-height: 1.5;
      font-size: .8rem;
    }

    .input:focus,
    .select:focus,
    .textarea:focus {
      border-color: var(--border2);
      box-shadow: 0 0 0 4px rgba(2,132,199,.08);
    }

    .button-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 10px;
    }

    .button-row.one {
      grid-template-columns: 1fr;
    }

    .section {
      margin-top: 10px;
      border-radius: 17px;
      background: var(--surface2);
      border: 1px solid var(--border);
      padding: 12px;
    }

    .section h3 {
      font-size: .9rem;
      font-weight: 950;
      letter-spacing: -.035em;
      margin-bottom: 7px;
    }

    .modal-overlay,
    .drawer-overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      background: rgba(0,0,0,.42);
      backdrop-filter: blur(8px);
      padding: 12px;
    }

    .modal-overlay.active,
    .drawer-overlay.active {
      display: block;
    }

    .modal-card {
      width: min(530px, 100%);
      max-height: calc(100vh - 24px - var(--safe-top) - var(--safe-bottom));
      overflow-y: auto;
      margin: calc(12px + var(--safe-top)) auto 0;
      padding: 14px;
      border-radius: 22px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      animation: pop .22s ease both;
    }

    .drawer {
      position: absolute;
      top: 0;
      right: 0;
      width: min(470px, 100%);
      height: 100%;
      overflow-y: auto;
      padding: calc(16px + var(--safe-top)) 14px calc(20px + var(--safe-bottom));
      background: var(--surface);
      border-left: 1px solid var(--border);
      box-shadow: -24px 0 80px rgba(0,0,0,.22);
      animation: slide .23s ease both;
    }

    @keyframes pop {
      from { transform: translateY(18px) scale(.98); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    @keyframes slide {
      from { transform: translateX(36px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    .modal-head,
    .drawer-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 12px;
    }

    .modal-title,
    .drawer-title {
      font-size: 1.22rem;
      font-weight: 950;
      letter-spacing: -.055em;
    }

    .modal-sub,
    .drawer-sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: .8rem;
      font-weight: 750;
      line-height: 1.45;
    }

    .close {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      color: var(--text);
      background: var(--surface2);
      border: 1px solid var(--border);
      font-size: 1.2rem;
      font-weight: 950;
      flex: 0 0 auto;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: calc(92px + var(--safe-bottom));
      transform: translateX(-50%) translateY(12px);
      z-index: 150;
      max-width: min(430px, calc(100% - 28px));
      padding: 12px 14px;
      border-radius: 15px;
      background: rgba(2,6,23,.92);
      color: white;
      box-shadow: var(--shadow2);
      opacity: 0;
      pointer-events: none;
      transition: all .22s ease;
      font-weight: 850;
      font-size: .84rem;
    }

    .toast.active {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(10px + var(--safe-bottom));
      transform: translateX(-50%);
      z-index: 70;
      width: min(430px, calc(100% - 24px));
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      padding: 7px;
      border-radius: 21px;
      background: rgba(255,255,255,.92);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(14px);
    }

    [data-theme="dark"] .bottom-nav {
      background: rgba(13,22,40,.9);
    }

    .bottom-nav button {
      min-height: 47px;
      border-radius: 15px;
      background: transparent;
      color: var(--muted);
      font-size: .71rem;
      font-weight: 950;
    }

    .bottom-nav button.active {
      color: white;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
    }

    .warning {
      color: var(--orange);
      background: rgba(217,119,6,.1);
      border: 1px solid rgba(217,119,6,.2);
    }

    .success {
      color: var(--green);
      background: rgba(22,163,74,.09);
      border: 1px solid rgba(22,163,74,.16);
    }

    .danger {
      color: var(--red);
      background: rgba(225,29,72,.08);
      border: 1px solid rgba(225,29,72,.14);
    }

    @media (max-width: 930px) {
      .hero-grid,
      .grid {
        grid-template-columns: 1fr;
      }

      .hero-actions {
        grid-template-columns: repeat(4, 1fr);
      }

      .action-card {
        text-align: center;
      }
    }

    @media (max-width: 650px) {
      body {
        padding-bottom: calc(84px + var(--safe-bottom));
      }

      .topbar {
        padding-left: 10px;
        padding-right: 10px;
      }

      .shell {
        padding: 10px;
      }

      .hero {
        padding: 14px;
        border-radius: 23px;
      }

      .hero-actions {
        grid-template-columns: repeat(2, 1fr);
      }

      .action-card {
        min-height: 72px;
        padding: 12px;
      }

      .grid {
        gap: 10px;
        margin-top: 10px;
      }

      .panel {
        padding: 12px;
        border-radius: 20px;
      }

      .row {
        grid-template-columns: 1fr;
        gap: 9px;
      }

      .value,
      .value-sub {
        text-align: left;
      }

      .button-row {
        grid-template-columns: 1fr;
      }

      .brand-sub,
      .user-chip span {
        display: none;
      }

      .top-actions {
        gap: 5px;
      }

      .icon-btn {
        width: 39px;
        height: 39px;
      }

      .drawer,
      .modal-card {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="logo">B</div>
        <div>
          <div class="brand-title">Blue Wallet</div>
          <div class="brand-sub" id="statusText">Secure encrypted EVM wallet</div>
        </div>
      </div>

      <div class="top-actions">
        <button class="icon-btn" onclick="goTrading()" aria-label="Trading">↗</button>
        <button class="icon-btn" onclick="refreshBalances()" aria-label="Refresh">⟳</button>
        <button class="icon-btn" onclick="openSettings()" aria-label="Settings">⚙</button>
        <div class="user-chip">
          <div class="avatar"></div>
          <span><%= typeof username !== 'undefined' ? username : 'user' %></span>
        </div>
      </div>
    </div>
  </header>

  <main class="shell">
    <section class="hero">
      <div class="hero-grid">
        <div>
          <div class="badge"><span class="dot"></span> Real wallet</div>
          <div class="address-line" id="walletAddressText">No wallet loaded</div>
          <div class="big-balance" id="totalBalance">0 assets</div>
          <div class="hero-meta">
            <span class="meta-chip" id="activeNetworkText">Network: Ethereum</span>
            <span class="meta-chip" id="lockStateText">Locked</span>
            <span class="meta-chip" id="autoStakeStateText">Auto-stake off</span>
          </div>
        </div>

        <div class="hero-actions">
          <button class="action-card primary" onclick="openModal('receiveModal')">
            <strong>Receive</strong>
            <span>Show address</span>
          </button>
          <button class="action-card" onclick="openModal('sendModal')">
            <strong>Send</strong>
            <span>Native + ERC-20</span>
          </button>
          <button class="action-card" onclick="openModal('swapModal')">
            <strong>Swap</strong>
            <span>USDT / tokens</span>
          </button>
          <button class="action-card" onclick="openModal('stakeModal')">
            <strong>Stake</strong>
            <span>Auto APY planner</span>
          </button>
        </div>
      </div>
    </section>

    <section class="grid">
      <div>
        <section class="panel" id="assetsSection">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Balances</h2>
              <p class="panel-sub">Real balances from the selected EVM network RPC.</p>
            </div>
            <button class="small-btn" onclick="refreshBalances()">Refresh</button>
          </div>
          <div class="list" id="tokenList"></div>
        </section>

        <section class="panel" id="networksSection">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Networks</h2>
