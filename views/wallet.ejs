  <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.5/dist/ethers.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>

  <script>
    const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
    const CURRENT_EMAIL = "<%= typeof email !== 'undefined' ? email : '' %>";
    const USER_ROLE = "<%= typeof role !== 'undefined' ? role : 'user' %>";
    const IS_ADMIN = USER_ROLE === 'staff';
    const NATIVE_TOKEN = '0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee';

    const DISPLAY_RATES = { USD:{symbol:'$',rate:1}, AED:{symbol:'AED ',rate:3.6725}, EUR:{symbol:'€',rate:.92}, GBP:{symbol:'£',rate:.79}, SAR:{symbol:'SAR ',rate:3.75} };

    const NETWORKS = {
      ethereum:{name:'Ethereum',chainId:1,symbol:'ETH',rpc:'https://cloudflare-eth.com'},
      bsc:{name:'BNB Chain',chainId:56,symbol:'BNB',rpc:'https://bsc-dataseed.binance.org'},
      polygon:{name:'Polygon',chainId:137,symbol:'MATIC',rpc:'https://polygon-rpc.com'},
      base:{name:'Base',chainId:8453,symbol:'ETH',rpc:'https://mainnet.base.org'},
      arbitrum:{name:'Arbitrum',chainId:42161,symbol:'ETH',rpc:'https://arb1.arbitrum.io/rpc'},
      optimism:{name:'Optimism',chainId:10,symbol:'ETH',rpc:'https://mainnet.optimism.io'},
      avalanche:{name:'Avalanche',chainId:43114,symbol:'AVAX',rpc:'https://api.avax.network/ext/bc/C/rpc'}
    };

    const ERC20_TOKENS = {
      ethereum:[ {symbol:'USDT',name:'Tether',address:'0xdAC17F958D2ee523a2206206994597C13D831ec7',decimals:6,gecko:'tether'}, {symbol:'USDC',name:'USD Coin',address:'0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48',decimals:6,gecko:'usd-coin'}, {symbol:'LINK',name:'Chainlink',address:'0x514910771AF9Ca656af840dff83E8264EcF986CA',decimals:18,gecko:'chainlink'}, {symbol:'UNI',name:'Uniswap',address:'0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984',decimals:18,gecko:'uniswap'} ],
      bsc:[ {symbol:'USDT',name:'Tether',address:'0x55d398326f99059fF775485246999027B3197955',decimals:18,gecko:'tether'}, {symbol:'USDC',name:'USD Coin',address:'0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d',decimals:18,gecko:'usd-coin'} ],
      polygon:[ {symbol:'USDT',name:'Tether',address:'0xc2132D05D31c914a87C6611C10748AEb04B58e8F',decimals:6,gecko:'tether'}, {symbol:'USDC',name:'USD Coin',address:'0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174',decimals:6,gecko:'usd-coin'} ]
    };

    // Swap Routers Config (Uniswap V2 / PancakeSwap / QuickSwap)
    const SWAP_ROUTERS = {
      ethereum: { router: '0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D', wrapped: '0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2' },
      bsc: { router: '0x10ED43C718714eb63d5aA57B78B54704E256024E', wrapped: '0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c' },
      polygon: { router: '0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff', wrapped: '0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270' }
    };

    const DEX_ABI = [
      "function getAmountsOut(uint amountIn, address[] memory path) view returns (uint[] memory amounts)",
      "function swapExactETHForTokens(uint amountOutMin, address[] calldata path, address to, uint deadline) payable returns (uint[] memory amounts)",
      "function swapExactTokensForETH(uint amountIn, uint amountOutMin, address[] calldata path, address to, uint deadline) returns (uint[] memory amounts)",
      "function swapExactTokensForTokens(uint amountIn, uint amountOutMin, address[] calldata path, address to, uint deadline) returns (uint[] memory amounts)"
    ];
    const ERC20_ABI = ['function balanceOf(address owner) view returns (uint256)', 'function transfer(address to, uint256 amount) returns (bool)', 'function approve(address spender, uint256 amount) returns (bool)', 'function allowance(address owner, address spender) view returns (uint256)'];
    const LIDO_STETH_CONTRACT = '0xae7ab96520DE3A18E5e111B5EaAb095312D7fE84';
    const LIDO_ABI = ['function submit(address _referral) payable returns (uint256)'];

    const NATIVE_GECKO = { ethereum:'ethereum', bsc:'binancecoin', polygon:'matic-network', base:'ethereum', arbitrum:'ethereum', optimism:'ethereum', avalanche:'avalanche-2' };
    const WATCH_ASSETS = [{symbol:'BTC',name:'Bitcoin',gecko:'bitcoin'}, {symbol:'SOL',name:'Solana',gecko:'solana'}, {symbol:'ETH',name:'Ethereum',gecko:'ethereum'}, {symbol:'BNB',name:'BNB',gecko:'binancecoin'}, {symbol:'XRP',name:'XRP',gecko:'ripple'}];
    const BINANCE_SYMBOLS = { BTC:'BTCUSDT', ETH:'ETHUSDT', SOL:'SOLUSDT', BNB:'BNBUSDT', XRP:'XRPUSDT' };
    const TOP_MARKETS = ['BTC','SOL','ETH','BNB','XRP'];
    const STAKING_OPTIONS = [{id:'lido-eth',title:'Lido ETH',asset:'ETH',networkKey:'ethereum',apy:4.2,real:true,adapter:'lido',description:'Stake ETH and receive stETH directly.'}];

    let activeNetworkKey = localStorage.getItem('blue_active_network') || 'ethereum';
    let displayCurrency = localStorage.getItem('blue_display_currency') || 'USD';
    let activeProvider = null, activeSigner = null, allBalances = [], combinedAssets = [], ownedPositions = [];
    let activeWalletMnemonic = "";
    let selectedSend = null, selectedSwapSell = null, selectedReceiveAsset = null, selectedStake = null;
    let prices = {}, binancePrices = {}, marketMeta = {};
    let toastTimer, countdownTimer = null, chartTimer = null, chartCandlesRaw = [];
    let sendFeeRefreshAt = 0, swapFeeRefreshAt = 0;
    
    function toast(msg) { const el = document.getElementById('toast'); el.textContent = msg; el.classList.add('active'); clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('active'), 2500); }
    function formatCompact(num) { return !num ? '$0' : new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',notation:'compact'}).format(num); }
    function money(val) { const cfg = DISPLAY_RATES[displayCurrency] || DISPLAY_RATES.USD; return `${cfg.symbol}${(Number(val||0) * cfg.rate).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`; }
    function fmt(val, dec=6) { return Number(val||0).toLocaleString(undefined,{maximumFractionDigits:dec}); }
    function icon(sym) { return `<div class="coin"><img src="https://assets.coincap.io/assets/icons/${String(sym).toLowerCase()}@2x.png" onerror="this.remove();this.parentNode.textContent='${String(sym).slice(0,4)}'" /></div>`; }

    function openModal(id) { document.getElementById(id).classList.add('active'); renderSelects(); if(id === 'receiveModal') renderReceiveAssets(); if(id === 'sendModal' || id === 'swapModal') { scheduleImmediateFeeRefresh(); startCountdownLoop(); } }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }
    function overlayClose(e,id) { if(e.target.id === id) closeModal(id); }
    function navSetActive(id) { document.querySelectorAll('.bottom-nav button').forEach(b=>b.classList.remove('active')); document.getElementById(id)?.classList.add('active'); }
    function openSettings() { document.getElementById('settingsOverlay').classList.add('active'); navSetActive('navSettings'); renderSettings(); }
    function closeSettings() { document.getElementById('settingsOverlay').classList.remove('active'); navSetActive('navHome'); }
    function setTheme(t) { document.documentElement.setAttribute('data-theme',t); localStorage.setItem('blue_theme',t); toast(`${t} mode enabled`); }
    function setDisplayCurrency(c) { displayCurrency = c; localStorage.setItem('blue_display_currency',c); document.getElementById('currencySelect').value = c; renderAll(); }
    function rpcUrl(key = activeNetworkKey) { return localStorage.getItem(`blue_rpc_${key}`) || NETWORKS[key].rpc; }
    function provider(key = activeNetworkKey) { return new ethers.JsonRpcProvider(rpcUrl(key), NETWORKS[key].chainId); }
    function currentAddress() { return IS_ADMIN ? "0xAdminDemoWalletNotRealAddress123456789" : (activeSigner ? activeSigner.address : null); }
    function normalizeRawSymbol(s) { return ['WETH','WBNB','WMATIC','WAVAX'].includes(s) ? s.substring(1) : s; }
    function binanceForSymbol(s) { return BINANCE_SYMBOLS[normalizeRawSymbol(s)] ? binancePrices[BINANCE_SYMBOLS[normalizeRawSymbol(s)]] : null; }
    function priceFor(a) { const b=binanceForSymbol(a.symbol); if(b?.lastPrice) return Number(b.lastPrice); return prices[a.type==='native'?NATIVE_GECKO[a.networkKey]:a.gecko]?.usd||0; }
    function changeFor(a) { const b=binanceForSymbol(a.symbol); if(b) return Number(b.priceChangePercent); return prices[a.type==='native'?NATIVE_GECKO[a.networkKey]:a.gecko]?.usd_24h_change||0; }
    function metaFor(a) { return marketMeta[a.type==='native'?NATIVE_GECKO[a.networkKey]:a.gecko] || {}; }

    async function fetchPricesForAll() {
      try {
        const ids = new Set(); Object.keys(NETWORKS).forEach(k => { ids.add(NATIVE_GECKO[k]); (ERC20_TOKENS[k]||[]).forEach(t => ids.add(t.gecko)); }); WATCH_ASSETS.forEach(w => ids.add(w.gecko));
        const [bp,gp,meta] = await Promise.all([ fetch(`/api/binance-prices?symbols=${Object.values(BINANCE_SYMBOLS).join(',')}`).then(r=>r.ok?r.json():{}), fetch(`/api/prices?ids=${[...ids].join(',')}`).then(r=>r.ok?r.json():{}), fetch(`/api/market-meta?ids=${[...ids].join(',')}`).then(r=>r.ok?r.json():{}) ]);
        binancePrices = bp||{}; prices = gp||{}; marketMeta = meta||{};
      } catch(e) {}
    }

    function combineAssets() {
      const map = new Map(); WATCH_ASSETS.forEach(w => map.set(w.symbol, {symbol:w.symbol, name:w.name, gecko:w.gecko, amount:0, usd:0, weightedPrev:0, positions:[], isWatch:true}));
      allBalances.forEach(a => {
        const sym = normalizeRawSymbol(a.symbol); const usd = Number(a.balance||0)*priceFor(a);
        if(!map.has(sym)) map.set(sym, {symbol:sym, name:a.name, gecko:a.gecko, amount:0, usd:0, weightedPrev:0, positions:[], isWatch:false});
        const item = map.get(sym); item.amount += Number(a.balance||0); item.usd += usd; item.weightedPrev += (changeFor(a)>-99.9 ? usd/(1+changeFor(a)/100) : usd);
        if(Number(a.balance||0)>0) { item.isWatch=false; item.positions.push({...a,usd}); }
      });
      combinedAssets = [...map.values()].sort((a,b) => b.usd - a.usd || a.symbol.localeCompare(b.symbol));
      ownedPositions = allBalances.filter(x=>Number(x.balance||0)>0).sort((a,b)=> (Number(b.balance||0)*priceFor(b)) - (Number(a.balance||0)*priceFor(a)));
    }

    function renderTotals() {
      let tot = 0, prev = 0, totalMc = 0; combinedAssets.forEach(a => { tot += a.usd; prev += a.weightedPrev || a.usd; if(a.amount > 0) { totalMc += (metaFor(a).marketCap || 0); } });
      const pnl = tot - prev, roi = prev > 0 ? (pnl/prev) * 100 : 0;
      document.getElementById('totalUsd').textContent = money(tot);
      const pL = document.getElementById('pnlLine');
      pL.textContent = `24h PnL ${pnl>=0?'+':''}${money(pnl)} (${pnl>=0?'+':''}${roi.toFixed(2)}%) · Port. MC: ${formatCompact(totalMc)}`;
      pL.className = `pnl-line ${pnl>0?'up':pnl<0?'down':''}`;
    }

    function renderAssetCards() {
      document.getElementById('topMarketCards').innerHTML = TOP_MARKETS.map(s => { const a = WATCH_ASSETS.find(x=>x.symbol===s), p=priceFor(a), ch=changeFor(a); return `<button class="market-card" onclick="openAssetChart('${s}')">${icon(s)}<strong>${s}</strong><div class="market-price">${money(p)}</div><div class="change ${ch>=0?'up':'down'}">${ch>=0?'+':''}${Number(ch||0).toFixed(2)}%</div></button>`; }).join('');
      document.getElementById('assetCards').innerHTML = combinedAssets.map(a => {
        const p=priceFor(a), ch=changeFor(a), m=metaFor(a);
        return `<button class="asset-card ${a.usd<=0?'watch':''}" onclick="openAssetChart('${a.symbol}')">
          <div class="asset-top">${icon(a.symbol)}<div style="min-width:0;text-align:left;"><div class="name">${a.symbol}</div><div class="tiny">${a.positions.length?`${a.positions.length} network(s)`:'Market Rate'}</div></div></div>
          <div class="asset-value">${a.usd>0?money(a.usd):money(p)}</div>
          <div class="asset-sub"><span class="${ch>=0?'change up':'change down'}" style="margin:0;">${ch>=0?'+':''}${ch.toFixed(2)}%</span><span style="opacity:0.6;">·</span><span>MC: ${formatCompact(m.marketCap)}</span></div>
          <div class="tiny" style="margin-top:8px; opacity:0.8;">${fmt(a.amount, a.amount<1?8:6)} ${a.symbol}</div>
        </button>`;
      }).join('');
    }

    function renderAll() { renderAssetCards(); renderTotals(); renderSelects(); renderStakingCards(); }

    async function refreshAllBalances(force = false) {
      if (IS_ADMIN) {
        if(force) { document.getElementById('walletStatusBadge').textContent = 'Secured Wallet'; document.getElementById('statusText').textContent = 'Connected'; }
        allBalances = [{networkKey:'ethereum', networkName:'Ethereum', type:'native', symbol:'ETH', balance: 5.4, decimals:18, gecko:'ethereum'}, {networkKey:'ethereum', networkName:'Ethereum', type:'erc20', symbol:'USDC', address:'0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48', balance: 25000, decimals:6, gecko:'usd-coin'}];
        await fetchPricesForAll(); combineAssets(); renderAll(); return;
      }
      const addr = currentAddress(); if(!addr) { if(force) document.getElementById('walletStatusBadge').textContent = 'Creating Wallet...'; renderAll(); return; }
      if(force) document.getElementById('walletStatusBadge').textContent = 'Live Syncing';
      if(!force && !allBalances.length) { const c = localStorage.getItem(`blue_bal_${CURRENT_EMAIL}`); if(c) { const p=JSON.parse(c); allBalances=p.bal||[]; prices=p.pr||{}; binancePrices=p.bp||{}; marketMeta=p.meta||{}; combineAssets(); renderAll(); } }
      if(force) document.getElementById('statusText').textContent = 'Updating...';
      
      await fetchPricesForAll();
      const nTasks = Object.entries(NETWORKS).map(async ([nKey,net]) => {
        const p = provider(nKey), out = [];
        try { out.push({networkKey:nKey, networkName:net.name, type:'native', symbol:net.symbol, name:`${net.name} Native`, balance:Number(ethers.formatEther(await p.getBalance(addr))), decimals:18, gecko:NATIVE_GECKO[nKey]}); }
        catch { out.push({networkKey:nKey, networkName:net.name, type:'native', symbol:net.symbol, balance:0, gecko:NATIVE_GECKO[nKey], error:true}); }
        const tkTasks = (ERC20_TOKENS[nKey]||[]).map(async t => {
          try { const c = new ethers.Contract(t.address,ERC20_ABI,p); return {...t, networkKey:nKey, networkName:net.name, type:'erc20', balance:Number(ethers.formatUnits(await c.balanceOf(addr),t.decimals))}; }
          catch { return {...t, networkKey:nKey, networkName:net.name, type:'erc20', balance:0, error:true}; }
        });
        out.push(...await Promise.all(tkTasks)); return out;
      });
      allBalances = (await Promise.allSettled(nTasks)).flatMap(r=>r.status==='fulfilled'?r.value:[]);
      localStorage.setItem(`blue_bal_${CURRENT_EMAIL}`, JSON.stringify({bal:allBalances, pr:prices, bp:binancePrices, meta:marketMeta}));
      combineAssets(); renderAll(); 
      document.getElementById('statusText').textContent = 'Connected'; document.getElementById('walletStatusBadge').textContent = 'Secured Wallet';
    }

    function renderReceiveSelects() { const s = document.getElementById('receiveNetworkSelect'); if(s) { s.innerHTML = Object.entries(NETWORKS).map(([k,n])=>`<option value="${k}">${n.name}</option>`).join(''); s.value = activeNetworkKey; renderReceiveAssets(); } }
    function renderReceiveAssets() {
      const nk = document.getElementById('receiveNetworkSelect')?.value || activeNetworkKey; const net = NETWORKS[nk], addr = currentAddress();
      const assets = [{type:'native',symbol:net.symbol,name:`${net.symbol} Native`,address:NATIVE_TOKEN}, ...(ERC20_TOKENS[nk]||[])];
      if (!selectedReceiveAsset || selectedReceiveAsset.networkKey !== nk) selectedReceiveAsset = {...assets[0], networkKey:nk};
      document.getElementById('qrNetworkBadge').textContent = net.name; document.getElementById('receiveTitle').textContent = `${selectedReceiveAsset.symbol} on ${net.name}`;
      document.getElementById('receiveAddressInput').value = addr || 'No wallet loaded'; renderQr(addr || '');
      document.getElementById('receiveAssetsList').innerHTML = assets.map(a => `<button class="receive-option ${selectedReceiveAsset?.symbol===a.symbol?'selected':''}" onclick="selectReceiveAsset('${nk}','${a.symbol}')"><div style="display:flex; align-items:center; gap:12px;">${icon(a.symbol)}<div style="text-align:left;"><div class="name">${a.symbol}</div><div class="tiny">${a.name}</div></div></div>${selectedReceiveAsset?.symbol===a.symbol?`<div class="dot" style="width:12px; height:12px; box-shadow:0 0 0 4px rgba(2,132,199,0.2);"></div>`:''}</button>`).join('');
    }
    function selectReceiveAsset(nk, sym) { selectedReceiveAsset = {...[{type:'native',symbol:NETWORKS[nk].symbol}, ...(ERC20_TOKENS[nk]||[])].find(x=>x.symbol===sym), networkKey:nk}; activeNetworkKey = nk; localStorage.setItem('blue_active_network',nk); renderReceiveAssets(); }
    function renderQr(val) { const box = document.getElementById('qrBox'); if(!box) return; box.innerHTML = ''; if(!val || !window.QRCode) { box.innerHTML = '<div class="tiny">No QR</div>'; return; } QRCode.toCanvas(val, {width:220, margin:1, color:{dark:'#0f172a',light:'#ffffff'}}, (err,cvs) => { if(!err) box.appendChild(cvs); }); }
    function copyReceiveAddress() { const a = currentAddress(); if(!a) return toast('No address available'); navigator.clipboard?.writeText(a); toast('Address copied'); }

    function updateSignerNetwork(nk) { if(IS_ADMIN) return; activeNetworkKey = nk; localStorage.setItem('blue_active_network',nk); activeProvider = provider(nk); if(activeSigner) activeSigner = activeSigner.connect(activeProvider); }

    function renderOwnedCards(tid, sel, setter) {
      const box = document.getElementById(tid); if(!box) return;
      if(!ownedPositions.length) { box.innerHTML = `<div class="asset-card"><div class="name">No assets</div><div class="tiny">Deposit funds to trade.</div></div>`; return; }
      box.innerHTML = ownedPositions.map((p,i) => {
        const id=`${p.networkKey}:${p.address||'n'}:${p.symbol}`, sid=sel?`${sel.networkKey}:${sel.address||'n'}:${sel.symbol}`:'';
        return `<button class="asset-card ${id===sid?'selected':''}" onclick="${setter}(${i})"><div class="asset-top">${icon(p.symbol)}<div><div class="name">${p.symbol}</div><div class="tiny">${p.networkName}</div></div></div><div class="asset-value">${money(Number(p.balance||0)*priceFor(p))}</div><div class="asset-sub">${fmt(p.balance)} ${p.symbol}</div></button>`;
      }).join('');
    }

    function setSelectedSend(i) { selectedSend = ownedPositions[i]||null; if(selectedSend) updateSignerNetwork(selectedSend.networkKey); renderSelects(); scheduleImmediateFeeRefresh(); }
    function setSelectedSwapSell(i) { selectedSwapSell = ownedPositions[i]||null; if(selectedSwapSell) updateSignerNetwork(selectedSwapSell.networkKey); renderSelects(); scheduleImmediateFeeRefresh(); }
    
    function renderSelects() {
      if(!selectedSend && ownedPositions.length) selectedSend = ownedPositions[0]; if(!selectedSwapSell && ownedPositions.length) selectedSwapSell = ownedPositions[0];
      renderReceiveSelects(); renderOwnedCards('sendOwnedAssets', selectedSend, 'setSelectedSend'); renderOwnedCards('swapOwnedAssets', selectedSwapSell, 'setSelectedSwapSell');
      if(selectedSend) document.getElementById('sendBalanceText').textContent = `${fmt(selectedSend.balance)} ${selectedSend.symbol} on ${selectedSend.networkName}`;
      if(selectedSwapSell) {
        document.getElementById('swapSellBalanceText').textContent = `Bal: ${fmt(selectedSwapSell.balance)} ${selectedSwapSell.symbol}`;
        const s = document.getElementById('swapBuySelect');
        s.innerHTML = [`<option value="${NATIVE_TOKEN}">${NETWORKS[selectedSwapSell.networkKey].symbol} · Native</option>`, ...(ERC20_TOKENS[selectedSwapSell.networkKey]||[]).map(t=>`<option value="${t.address}">${t.symbol} · ${t.name}</option>`)].join('');
      }
    }

    function setMaxSend() {
      if(!selectedSend) return;
      // Reserve small amount of native for gas if sending native
      let maxAmt = Number(selectedSend.balance);
      if (selectedSend.type === 'native' && maxAmt > 0) { maxAmt = maxAmt * 0.98; } 
      document.getElementById('sendAmountInput').value = maxAmt.toFixed(6);
      scheduleImmediateFeeRefresh();
    }

    async function estimateSendFee() {
      try {
        if(!document.getElementById('sendModal')?.classList.contains('active') || !selectedSend || (!activeSigner && !IS_ADMIN)) return;
        const to = document.getElementById('sendToInput').value.trim(), amt = document.getElementById('sendAmountInput').value.trim();
        if(!ethers.isAddress(to) || !amt || Number(amt)<=0) { document.getElementById('sendFeePreview').textContent='Enter valid details'; return; }
        
        let gas;
        if (IS_ADMIN) { gas = selectedSend.type==='native' ? 21000n : 65000n; } 
        else {
          try { gas = selectedSend.type==='native' ? await activeSigner.estimateGas({to,value:ethers.parseEther(amt)}) : await (new ethers.Contract(selectedSend.address,ERC20_ABI,activeSigner)).transfer.estimateGas(to,ethers.parseUnits(amt,selectedSend.decimals)); } 
          catch { gas = selectedSend.type==='native' ? 21000n : 65000n; }
        }
        const feeData = IS_ADMIN ? { gasPrice: 3000000000n } : await activeSigner.provider.getFeeData();
        const gasPrice = feeData.gasPrice || feeData.maxFeePerGas || 3000000000n;
        const fee = ethers.formatEther(gas * gasPrice);
        document.getElementById('sendFeePreview').textContent = `~ ${Number(fee).toFixed(6)} ${NETWORKS[selectedSend.networkKey].symbol}`;
      } catch(e) { document.getElementById('sendFeePreview').textContent = 'Calculation failed'; }
    }
    
    function openSendConfirm() {
      if(!selectedSend) return toast('No asset');
      const to = document.getElementById('sendToInput').value, amt = document.getElementById('sendAmountInput').value;
      if (!to || !amt) return toast('Enter details');
      document.getElementById('sendConfirmText').textContent = `Send ${amt} ${selectedSend.symbol} to ${to.slice(0,6)}...`;
      openModal('sendConfirmModal');
    }
    
    async function sendRealTransaction() {
      try {
        if(IS_ADMIN) { closeModal('sendConfirmModal'); closeModal('sendModal'); return toast('Demo: Transaction simulated.'); }
        const to = document.getElementById('sendToInput').value.trim(), amt = document.getElementById('sendAmountInput').value.trim();
        const tx = selectedSend.type==='native' ? await activeSigner.sendTransaction({to,value:ethers.parseEther(amt)}) : await (new ethers.Contract(selectedSend.address,ERC20_ABI,activeSigner)).transfer(to,ethers.parseUnits(amt,selectedSend.decimals));
        closeModal('sendConfirmModal'); closeModal('sendModal'); toast('Transaction sent'); await tx.wait(); toast('Confirmed'); refreshAllBalances(true);
      } catch(e) { toast('Send failed'); }
    }

    // Direct On-Chain DEX Router integration (Uniswap V2 logic)
    async function getOnChainRoute(netKey, sellType, sellAddress, buyAddress, amtInWei) {
      const cfg = SWAP_ROUTERS[netKey]; if(!cfg) throw new Error("DEX Routing not supported here");
      const router = new ethers.Contract(cfg.router, DEX_ABI, activeSigner || provider(netKey));
      let path = [];
      if (sellType === 'native') { path = [cfg.wrapped, buyAddress]; } 
      else if (buyAddress === NATIVE_TOKEN) { path = [sellAddress, cfg.wrapped]; } 
      else { path = [sellAddress, cfg.wrapped, buyAddress]; }
      const amounts = await router.getAmountsOut(amtInWei, path);
      return { path, amountOut: amounts[amounts.length - 1], routerAddress: cfg.router };
    }

    async function estimateSwapFee() {
      try {
        if(!document.getElementById('swapModal')?.classList.contains('active') || !selectedSwapSell) return;
        const amt = document.getElementById('swapAmount').value.trim();
        if(!amt || Number(amt)<=0) { document.getElementById('swapQuoteText').textContent='Enter amount'; window.__BLUE_SWAP_ROUTE=null; return; }
        
        const buyAddr = document.getElementById('swapBuySelect').value;
        const amtWei = ethers.parseUnits(amt, selectedSwapSell.decimals);
        const route = await getOnChainRoute(selectedSwapSell.networkKey, selectedSwapSell.type, selectedSwapSell.address, buyAddr, amtWei);
        
        // Output formatting
        const targetTokenDec = (buyAddr === NATIVE_TOKEN) ? 18 : (ERC20_TOKENS[selectedSwapSell.networkKey].find(t=>t.address===buyAddr)?.decimals || 18);
        const displayOut = ethers.formatUnits(route.amountOut, targetTokenDec);
        
        document.getElementById('swapQuoteText').textContent = `~ ${Number(displayOut).toFixed(4)} estimated out.`;
        window.__BLUE_SWAP_ROUTE = { ...route, amtWei, buyAddr, sellDecimals: selectedSwapSell.decimals };
      } catch(e) { document.getElementById('swapQuoteText').textContent = "Route not found/Liquidty issue"; window.__BLUE_SWAP_ROUTE=null; }
    }

    function openSwapConfirm() {
      if(!window.__BLUE_SWAP_ROUTE || !selectedSwapSell) return toast('Need quote');
      document.getElementById('swapConfirmText').textContent = `Swap ${selectedSwapSell.symbol} via on-chain router.`;
      openModal('swapConfirmModal');
    }

    async function executeSwap() {
      try {
        if(IS_ADMIN) { closeModal('swapConfirmModal'); closeModal('swapModal'); return toast('Demo: Swap simulated.'); }
        const rt = window.__BLUE_SWAP_ROUTE;
        const routerContract = new ethers.Contract(rt.routerAddress, DEX_ABI, activeSigner);
        
        // 1. Approve if ERC20
        if (selectedSwapSell.type === 'erc20') {
           const tokenContract = new ethers.Contract(selectedSwapSell.address, ERC20_ABI, activeSigner);
           const allowance = await tokenContract.allowance(activeSigner.address, rt.routerAddress);
           if (allowance < rt.amtWei) {
             toast('Approving token...');
             const appTx = await tokenContract.approve(rt.routerAddress, ethers.MaxUint256);
             await appTx.wait();
           }
        }

        toast('Executing swap...');
        const deadline = Math.floor(Date.now()/1000) + 60*20; // 20m deadline
        const minOut = (rt.amountOut * 95n) / 100n; // 5% slippage tolerance

        let tx;
        if (selectedSwapSell.type === 'native') {
           tx = await routerContract.swapExactETHForTokens(minOut, rt.path, activeSigner.address, deadline, { value: rt.amtWei });
        } else if (rt.buyAddr === NATIVE_TOKEN) {
           tx = await routerContract.swapExactTokensForETH(rt.amtWei, minOut, rt.path, activeSigner.address, deadline);
        } else {
           tx = await routerContract.swapExactTokensForTokens(rt.amtWei, minOut, rt.path, activeSigner.address, deadline);
        }

        closeModal('swapConfirmModal'); closeModal('swapModal'); toast('Swap sent'); await tx.wait(); toast('Confirmed'); refreshAllBalances(true);
      } catch(e) { console.error(e); toast('Swap failed or reverted'); closeModal('swapConfirmModal'); }
    }

    function scheduleImmediateFeeRefresh() { sendFeeRefreshAt=Date.now(); swapFeeRefreshAt=Date.now(); }
    function startCountdownLoop() {
      if(countdownTimer) return;
      countdownTimer = setInterval(()=>{
        const now = Date.now();
        const sRem = Math.max(0,Math.ceil((sendFeeRefreshAt-now)/1000)), swRem = Math.max(0,Math.ceil((swapFeeRefreshAt-now)/1000));
        document.getElementById('sendCountdown').style.setProperty('--progress',sRem/5); document.getElementById('sendCountdown').querySelector('span').textContent = sRem||0;
        document.getElementById('swapCountdown').style.setProperty('--progress',swRem/5); document.getElementById('swapCountdown').querySelector('span').textContent = swRem||0;
        if(document.getElementById('sendModal')?.classList.contains('active') && now>=sendFeeRefreshAt) { sendFeeRefreshAt=now+5000; estimateSendFee(); }
        if(document.getElementById('swapModal')?.classList.contains('active') && now>=swapFeeRefreshAt) { swapFeeRefreshAt=now+5000; estimateSwapFee(); }
      },250);
    }

    function renderStakingCards() {
      document.getElementById('stakingCards').innerHTML = STAKING_OPTIONS.filter(o=>o.real).map(o => {
        const owned = ownedPositions.find(p=>normalizeRawSymbol(p.symbol)===o.asset && p.networkKey===o.networkKey);
        return `<div class="staking-card"><div class="asset-top">${icon(o.asset)}<div><div class="name">${o.title}</div><div class="tiny">${NETWORKS[o.networkKey].name}</div></div></div><div class="apy">${o.apy.toFixed(2)}% APY</div><div class="tiny" style="margin-top:12px; opacity:0.9;">${o.description}</div><div class="tiny" style="margin-top:4px; font-weight:800;">Bal: ${owned?fmt(owned.balance):'0'} ${o.asset}</div><button class="primary-btn" style="height:46px; margin-top:14px; font-size:0.9rem;" onclick="openStake('${o.id}')">Stake ${o.asset}</button></div>`;
      }).join('');
    }
    
    function openStake(id) {
      selectedStake = STAKING_OPTIONS.find(x=>x.id===id); if(!selectedStake) return;
      const owned = ownedPositions.find(p=>normalizeRawSymbol(p.symbol)===selectedStake.asset && p.networkKey===selectedStake.networkKey);
      document.getElementById('stakeTitle').textContent = selectedStake.title; document.getElementById('stakeBalanceText').textContent = `${owned?fmt(owned.balance):'0'} ${selectedStake.asset} available`; document.getElementById('stakeAmountInput').value = ''; openModal('stakeModal');
    }

    async function executeStake() {
      if(!selectedStake) return;
      const amt = document.getElementById('stakeAmountInput').value; if(!amt||Number(amt)<=0) return toast('Invalid amount');
      try {
        if (IS_ADMIN) { closeModal('stakeModal'); return toast('Demo: Stake Executed.'); }
        
        const owned = ownedPositions.find(p=>normalizeRawSymbol(p.symbol)===selectedStake.asset && p.networkKey===selectedStake.networkKey);
        if(!owned || owned.balance < Number(amt)) return toast('Insufficient balance');

        updateSignerNetwork(selectedStake.networkKey);
        if(selectedStake.adapter === 'lido') {
          const lido = new ethers.Contract(LIDO_STETH_CONTRACT,LIDO_ABI,activeSigner);
          const tx = await lido.submit('0x0000000000000000000000000000000000000000',{value:ethers.parseEther(amt)});
          closeModal('stakeModal'); toast('Staking (Sending TX)...'); await tx.wait(); toast('Staked successfully'); refreshAllBalances(true);
        } else {
          closeModal('stakeModal'); toast('Executing smart contract...'); setTimeout(() => { toast(`${selectedStake.asset} staked via ${selectedStake.title}`); refreshAllBalances(true); }, 2500);
        }
      } catch(e) { toast('Stake transaction failed'); console.error(e); }
    }

    function showSeed() { if(IS_ADMIN) return toast('Demo Mode: Disabled.'); toast('Seed exposed'); const el = document.getElementById('secretOutput'); el.value = activeWalletMnemonic || "No seed phrase available."; el.style.filter = 'none'; }
    function showPrivateKey() { if(IS_ADMIN) return toast('Demo Mode: Disabled.'); toast('Key exposed'); const el = document.getElementById('secretOutput'); el.value = activeSigner ? activeSigner.privateKey : 'No private key'; el.style.filter = 'none'; }
    function saveCustomRpc() { const u=document.getElementById('customRpcInput').value; if(u.startsWith('http')) { localStorage.setItem(`blue_rpc_${activeNetworkKey}`,u); updateSignerNetwork(activeNetworkKey); toast('Saved'); refreshAllBalances(true); } }
    async function deleteWallet() { if(IS_ADMIN) return toast('Cannot wipe demo data.'); if(document.getElementById('deleteConfirmInput').value!=='DELETE') return toast('Type DELETE'); await fetch('/api/wallet/vault',{method:'DELETE'}); localStorage.clear(); window.location.reload(); }
    function renderSettings() { document.getElementById('settingsAddress').textContent = currentAddress() || 'No wallet loaded'; }
    function updateUi() { document.getElementById('walletStatusBadge').textContent = currentAddress()?'Secured Wallet':'Initializing...'; renderSettings(); }

    async function init() {
      setTheme(localStorage.getItem('blue_theme')||'light'); setDisplayCurrency(displayCurrency); document.getElementById('currencySelect').value = displayCurrency;
      if (IS_ADMIN) { document.getElementById('securityBox').style.display = 'none'; await refreshAllBalances(true); setInterval(()=>refreshAllBalances(false), 1000); return; }
      try {
        let savedVault = SERVER_WALLET.encryptedVault;
        if (!savedVault) {
          toast('Generating real secure wallet...');
          const randomWallet = ethers.Wallet.createRandom();
          const rawVaultObj = { pk: randomWallet.privateKey, phrase: randomWallet.mnemonic.phrase };
          savedVault = btoa(JSON.stringify(rawVaultObj));
          await fetch('/api/wallet/vault', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ encryptedVault: savedVault, publicWallets: [randomWallet.address] }) });
          SERVER_WALLET.encryptedVault = savedVault;
        }
        const parsedVault = JSON.parse(atob(savedVault));
        activeWalletMnemonic = parsedVault.phrase; activeProvider = provider(activeNetworkKey); activeSigner = new ethers.Wallet(parsedVault.pk, activeProvider);
        updateUi(); await refreshAllBalances(true); setInterval(()=>refreshAllBalances(false), 1000);
      } catch (err) { toast('Failed to load wallet.'); console.error(err); }
    }
    
    window.addEventListener('keydown', e => { if(e.key==='Escape') { closeSettings(); document.querySelectorAll('.modal-overlay').forEach(x=>x.classList.remove('active')); }});
    init();
  </script>
</body>
</html>
