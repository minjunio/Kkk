<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>BlueCrypto Wallet</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />  <style>
    :root {
      color-scheme: light;
      --bg-1: #eaf7ff;
      --bg-2: #c8ecff;
      --bg-3: #8fdcff;
      --bg-4: #f8fdff;
      --card: rgba(255, 255, 255, 0.68);
      --card-strong: rgba(255, 255, 255, 0.9);
      --card-soft: rgba(255, 255, 255, 0.42);
      --border: rgba(255, 255, 255, 0.72);
      --border-blue: rgba(2, 132, 199, 0.16);
      --primary: #0277bd;
      --primary-2: #0ea5e9;
      --primary-dark: #075985;
      --text: #0f172a;
      --muted: #64748b;
      --muted-2: #94a3b8;
      --success: #059669;
      --success-bg: rgba(5, 150, 105, 0.12);
      --danger: #e11d48;
      --danger-bg: rgba(225, 29, 72, 0.12);
      --warning: #d97706;
      --warning-bg: rgba(217, 119, 6, 0.12);
      --shadow: 0 18px 50px rgba(14, 116, 144, 0.14);
      --shadow-soft: 0 10px 30px rgba(14, 116, 144, 0.1);
      --radius: 24px;
      --radius-sm: 16px;
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="midnight"] {
      color-scheme: dark;
      --bg-1: #020617;
      --bg-2: #082f49;
      --bg-3: #075985;
      --bg-4: #0f172a;
      --card: rgba(15, 23, 42, 0.68);
      --card-strong: rgba(15, 23, 42, 0.92);
      --card-soft: rgba(15, 23, 42, 0.44);
      --border: rgba(125, 211, 252, 0.18);
      --border-blue: rgba(125, 211, 252, 0.18);
      --primary: #38bdf8;
      --primary-2: #7dd3fc;
      --primary-dark: #e0f2fe;
      --text: #f8fafc;
      --muted: #cbd5e1;
      --muted-2: #94a3b8;
      --shadow: 0 18px 50px rgba(0, 0, 0, 0.32);
      --shadow-soft: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(255,255,255,0.9), transparent 30%),
        radial-gradient(circle at 88% 18%, rgba(14,165,233,0.25), transparent 28%),
        linear-gradient(135deg, var(--bg-1), var(--bg-2) 42%, var(--bg-3));
      background-attachment: fixed;
      overflow-x: hidden;
      padding-bottom: calc(86px + var(--safe-bottom));
    }

    body::before,
    body::after {
      content: "";
      position: fixed;
      z-index: -1;
      border-radius: 999px;
      filter: blur(8px);
      opacity: 0.7;
      pointer-events: none;
    }

    body::before {
      width: 270px;
      height: 270px;
      left: -90px;
      top: 110px;
      background: rgba(255, 255, 255, 0.38);
    }

    body::after {
      width: 340px;
      height: 340px;
      right: -130px;
      bottom: 110px;
      background: rgba(125, 211, 252, 0.36);
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      border: 0;
    }

    .app-shell {
      width: min(1180px, 100%);
      margin: 0 auto;
      padding: 18px 18px 0;
    }

    .glass {
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 80;
      padding: calc(10px + var(--safe-top)) 14px 10px;
      border-bottom: 1px solid var(--border);
      background: rgba(248, 253, 255, 0.54);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }

    [data-theme="midnight"] .topbar {
      background: rgba(2, 6, 23, 0.56);
    }

    .topbar-inner {
      width: min(1180px, 100%);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
    }

    .logo {
      width: 42px;
      height: 42px;
      flex: 0 0 auto;
      border-radius: 15px;
      display: grid;
      place-items: center;
      color: white;
      font-weight: 900;
      letter-spacing: -0.05em;
      background: linear-gradient(135deg, #0284c7, #38bdf8);
      box-shadow: 0 12px 28px rgba(2, 132, 199, 0.28);
    }

    .brand-text {
      min-width: 0;
    }

    .brand-title {
      font-size: 1.06rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--primary-dark);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .brand-subtitle {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 0 rgba(5,150,105,0.5);
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(5,150,105,0.45); }
      80% { box-shadow: 0 0 0 9px rgba(5,150,105,0); }
      100% { box-shadow: 0 0 0 0 rgba(5,150,105,0); }
    }

    .top-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 9px;
      flex: 0 0 auto;
    }

    .icon-button {
      width: 43px;
      height: 43px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      color: var(--primary-dark);
      cursor: pointer;
      background: var(--card-strong);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .icon-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 36px rgba(2, 132, 199, 0.16);
    }

    .profile-chip {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 7px 10px 7px 8px;
      border-radius: 999px;
      background: var(--card-strong);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
      font-size: 0.82rem;
      font-weight: 800;
      color: var(--primary-dark);
    }

    .avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg, #bae6fd, #0284c7 70%);
      border: 2px solid rgba(255,255,255,0.8);
    }

    .hero-card {
      position: relative;
      overflow: hidden;
      margin-top: 18px;
      border-radius: 32px;
      padding: 24px;
      min-height: 230px;
      background:
        radial-gradient(circle at 15% 20%, rgba(255,255,255,0.76), transparent 25%),
        linear-gradient(135deg, rgba(2,132,199,0.92), rgba(14,165,233,0.72));
      color: white;
      box-shadow: 0 24px 68px rgba(2, 132, 199, 0.24);
    }

    .hero-card::before {
      content: "";
      position: absolute;
      width: 240px;
      height: 240px;
      right: -85px;
      top: -70px;
      border-radius: 50%;
      background: rgba(255,255,255,0.18);
    }

    .hero-card::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      right: 20px;
      bottom: -105px;
      border-radius: 50%;
      background: rgba(255,255,255,0.12);
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    .hero-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 34px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(255,255,255,0.18);
      border: 1px solid rgba(255,255,255,0.2);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    .network-select {
      border: 1px solid rgba(255,255,255,0.25);
      background: rgba(255,255,255,0.16);
      color: white;
      border-radius: 999px;
      padding: 8px 11px;
      font-size: 0.78rem;
      font-weight: 800;
      outline: none;
    }

    .network-select option {
      color: #0f172a;
    }

    .balance-label {
      color: rgba(255,255,255,0.82);
      font-size: 0.88rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .balance-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }

    .balance {
      font-size: clamp(2.15rem, 8vw, 4.2rem);
      line-height: 0.95;
      letter-spacing: -0.08em;
      font-weight: 900;
    }

    .pnl-chip,
    .status-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 11px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 900;
      white-space: nowrap;
    }

    .pnl-positive { color: var(--success); background: var(--success-bg); }
    .pnl-negative { color: var(--danger); background: var(--danger-bg); }
    .pnl-neutral { color: var(--muted); background: rgba(100, 116, 139, 0.12); }

    .hero-card .pnl-positive,
    .hero-card .pnl-negative,
    .hero-card .pnl-neutral {
      color: white;
      background: rgba(255,255,255,0.18);
      border: 1px solid rgba(255,255,255,0.22);
    }

    .hero-meta {
      margin-top: 22px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .hero-meta-item {
      padding: 13px;
      border-radius: 18px;
      background: rgba(255,255,255,0.14);
      border: 1px solid rgba(255,255,255,0.18);
    }

    .hero-meta-label {
      font-size: 0.7rem;
      font-weight: 800;
      color: rgba(255,255,255,0.76);
      margin-bottom: 5px;
    }

    .hero-meta-value {
      font-size: 0.95rem;
      font-weight: 900;
      color: white;
    }

    .quick-actions {
      margin-top: -22px;
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 11px;
      padding: 0 14px;
    }

    .action-button {
      min-height: 78px;
      border-radius: 22px;
      cursor: pointer;
      color: var(--primary-dark);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 7px;
      background: var(--card-strong);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
      font-weight: 900;
      font-size: 0.82rem;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .action-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 17px 34px rgba(2, 132, 199, 0.15);
    }

    .action-icon {
      width: 34px;
      height: 34px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      background: rgba(14, 165, 233, 0.12);
      color: var(--primary);
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 370px;
      gap: 18px;
      margin-top: 20px;
    }

    .panel {
      border-radius: var(--radius);
      padding: 18px;
      overflow: hidden;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .panel-title {
      font-size: 1rem;
      font-weight: 900;
      letter-spacing: -0.035em;
      color: var(--primary-dark);
    }

    .panel-subtitle {
      margin-top: 2px;
      color: var(--muted);
      font-size: 0.78rem;
      font-weight: 700;
    }

    .mini-button {
      padding: 9px 12px;
      border-radius: 13px;
      background: rgba(14,165,233,0.1);
      color: var(--primary-dark);
      border: 1px solid var(--border-blue);
      cursor: pointer;
      font-weight: 900;
      font-size: 0.78rem;
      white-space: nowrap;
    }

    .mini-button.danger {
      color: var(--danger);
      background: var(--danger-bg);
      border-color: rgba(225, 29, 72, 0.16);
    }

    .asset-list,
    .market-list,
    .vault-list {
      display: grid;
      gap: 10px;
    }

    .asset-card,
    .market-card,
    .vault-card {
      display: grid;
      align-items: center;
      gap: 12px;
      padding: 14px;
      border-radius: 20px;
      background: var(--card-soft);
      border: 1px solid var(--border);
      box-shadow: 0 7px 20px rgba(14, 116, 144, 0.07);
    }

    .asset-card {
      grid-template-columns: minmax(0, 1.35fr) 0.8fr 0.85fr 0.95fr auto;
    }

    .market-card {
      grid-template-columns: minmax(0, 1.2fr) 0.8fr 0.65fr;
    }

    .vault-card {
      grid-template-columns: minmax(0, 1fr) 0.75fr 0.68fr;
    }

    .asset-main {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
    }

    .coin-icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      overflow: hidden;
      background: var(--card-strong);
      border: 1px solid var(--border);
      box-shadow: 0 7px 18px rgba(2, 132, 199, 0.12);
      font-size: 0.74rem;
      font-weight: 900;
      color: var(--primary-dark);
    }

    .coin-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .asset-name {
      font-size: 0.94rem;
      font-weight: 900;
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .asset-symbol {
      margin-top: 3px;
      color: var(--muted);
      font-size: 0.76rem;
      font-weight: 800;
    }

    .cell-label {
      display: none;
      color: var(--muted);
      font-size: 0.7rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .cell-value {
      color: var(--text);
      font-size: 0.9rem;
      font-weight: 900;
      text-align: right;
    }

    .cell-sub {
      margin-top: 4px;
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 800;
      text-align: right;
    }

    .market-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      margin-bottom: 12px;
      padding-bottom: 1px;
    }

    .market-tabs::-webkit-scrollbar { display: none; }

    .tab {
      flex: 0 0 auto;
      padding: 10px 13px;
      border-radius: 999px;
      color: var(--muted);
      background: rgba(255,255,255,0.32);
      border: 1px solid var(--border);
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 900;
    }

    .tab.active {
      color: white;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      box-shadow: 0 12px 25px rgba(2, 132, 199, 0.22);
    }

    .insight-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .insight-card {
      padding: 15px;
      border-radius: 20px;
      background: var(--card-soft);
      border: 1px solid var(--border);
    }

    .insight-label {
      color: var(--muted);
      font-size: 0.72rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 8px;
    }

    .insight-value {
      color: var(--primary-dark);
      font-size: 1.15rem;
      font-weight: 950;
      letter-spacing: -0.04em;
    }

    .empty-state {
      padding: 26px 18px;
      border-radius: 22px;
      background: var(--card-soft);
      border: 1px dashed var(--border-blue);
      text-align: center;
      color: var(--muted);
      font-weight: 800;
      line-height: 1.55;
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(12px + var(--safe-bottom));
      transform: translateX(-50%);
      z-index: 75;
      width: min(430px, calc(100% - 28px));
      padding: 9px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      border-radius: 24px;
      background: rgba(255,255,255,0.72);
      border: 1px solid var(--border);
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.15);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }

    [data-theme="midnight"] .bottom-nav {
      background: rgba(15,23,42,0.74);
    }

    .bottom-nav button {
      min-height: 48px;
      border-radius: 17px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 900;
      font-size: 0.72rem;
      display: grid;
      place-items: center;
      gap: 2px;
    }

    .bottom-nav button.active {
      color: white;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      box-shadow: 0 10px 22px rgba(2, 132, 199, 0.22);
    }

    .drawer-overlay,
    .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      background: rgba(15, 23, 42, 0.36);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .drawer-overlay.active,
    .modal-overlay.active {
      display: block;
    }

    .settings-drawer {
      position: absolute;
      top: 0;
      right: 0;
      width: min(440px, 100%);
      height: 100%;
      padding: calc(18px + var(--safe-top)) 16px calc(22px + var(--safe-bottom));
      background: var(--card-strong);
      border-left: 1px solid var(--border);
      box-shadow: -20px 0 50px rgba(15, 23, 42, 0.14);
      overflow-y: auto;
      animation: slideIn 0.24s ease both;
    }

    @keyframes slideIn {
      from { transform: translateX(30px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    .drawer-header,
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 16px;
    }

    .drawer-title,
    .modal-title {
      color: var(--primary-dark);
      font-size: 1.25rem;
      font-weight: 950;
      letter-spacing: -0.05em;
    }

    .drawer-subtitle,
    .modal-subtitle {
      margin-top: 3px;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 700;
      line-height: 1.45;
    }

    .close-button {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      cursor: pointer;
      background: rgba(14,165,233,0.1);
      color: var(--primary-dark);
      border: 1px solid var(--border-blue);
      font-size: 1.2rem;
      font-weight: 900;
    }

    .setting-section {
      margin-top: 14px;
      padding: 14px;
      border-radius: 22px;
      background: var(--card-soft);
      border: 1px solid var(--border);
    }

    .setting-section h3 {
      color: var(--primary-dark);
      font-size: 0.95rem;
      font-weight: 950;
      letter-spacing: -0.03em;
      margin-bottom: 10px;
    }

    .form-grid {
      display: grid;
      gap: 11px;
    }

    .form-row {
      display: grid;
      gap: 7px;
      position: relative;
    }

    .form-row label {
      color: var(--muted);
      font-size: 0.76rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .input,
    .select {
      width: 100%;
      min-height: 46px;
      padding: 12px 13px;
      border-radius: 15px;
      outline: none;
      color: var(--text);
      background: var(--card-strong);
      border: 1px solid var(--border-blue);
      font-weight: 800;
    }

    .input:focus,
    .select:focus {
      border-color: rgba(14,165,233,0.58);
      box-shadow: 0 0 0 4px rgba(14,165,233,0.12);
    }

    .button-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 12px;
    }

    .primary-button,
    .secondary-button {
      min-height: 48px;
      border-radius: 16px;
      cursor: pointer;
      font-weight: 950;
      letter-spacing: -0.01em;
    }

    .primary-button {
      color: white;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      box-shadow: 0 14px 28px rgba(2, 132, 199, 0.22);
    }

    .secondary-button {
      color: var(--primary-dark);
      background: var(--card-strong);
      border: 1px solid var(--border-blue);
    }

    .asset-manager-list {
      display: grid;
      gap: 8px;
      max-height: 310px;
      overflow-y: auto;
      padding-right: 3px;
    }

    .manager-item {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px;
      align-items: center;
      padding: 11px;
      border-radius: 16px;
      background: var(--card-strong);
      border: 1px solid var(--border);
    }

    .manager-name {
      font-weight: 950;
      color: var(--text);
      font-size: 0.86rem;
    }

    .manager-balance {
      color: var(--muted);
      margin-top: 3px;
      font-size: 0.74rem;
      font-weight: 800;
    }

    .manager-actions {
      display: flex;
      gap: 6px;
    }

    .small-icon-button {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      cursor: pointer;
      color: var(--primary-dark);
      background: rgba(14,165,233,0.1);
      border: 1px solid var(--border-blue);
      font-weight: 950;
    }

    .small-icon-button.danger {
      color: var(--danger);
      background: var(--danger-bg);
      border-color: rgba(225, 29, 72, 0.16);
    }

    .suggestions {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      max-height: 210px;
      overflow-y: auto;
      display: none;
      border-radius: 16px;
      background: var(--card-strong);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
      z-index: 10;
    }

    .suggestions.active { display: block; }

    .suggestion {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 12px;
      cursor: pointer;
      font-size: 0.84rem;
      font-weight: 850;
      border-bottom: 1px solid rgba(14,165,233,0.08);
    }

    .suggestion:hover {
      background: rgba(14,165,233,0.09);
    }

    .modal-card {
      width: min(440px, calc(100% - 28px));
      max-height: calc(100vh - 28px - var(--safe-top) - var(--safe-bottom));
      overflow-y: auto;
      margin: calc(14px + var(--safe-top)) auto 0;
      border-radius: 26px;
      padding: 18px;
      background: var(--card-strong);
      border: 1px solid var(--border);
      box-shadow: 0 25px 60px rgba(15, 23, 42, 0.22);
      animation: popIn 0.22s ease both;
    }

    @keyframes popIn {
      from { transform: translateY(18px) scale(0.98); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: calc(92px + var(--safe-bottom));
      transform: translateX(-50%) translateY(12px);
      z-index: 140;
      max-width: min(420px, calc(100% - 28px));
      padding: 12px 14px;
      border-radius: 16px;
      background: rgba(15, 23, 42, 0.88);
      color: white;
      box-shadow: 0 18px 40px rgba(15,23,42,0.24);
      opacity: 0;
      pointer-events: none;
      font-weight: 850;
      font-size: 0.85rem;
      transition: all 0.22s ease;
    }

    .toast.active {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .hide-desktop { display: none; }

    @media (max-width: 940px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .profile-chip span { display: none; }
      .app-shell { padding: 14px 14px 0; }
      .hero-card { padding: 20px; border-radius: 29px; min-height: 236px; }
      .hero-top { margin-bottom: 28px; }
      .quick-actions {
        grid-template-columns: repeat(4, 1fr);
        padding: 0 4px;
        gap: 8px;
      }
      .action-button {
        min-height: 70px;
        border-radius: 20px;
        font-size: 0.74rem;
      }
      .action-icon { width: 31px; height: 31px; }
      .hero-meta { grid-template-columns: 1fr; }
      .hero-meta-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 13px; }
      .hero-meta-label { margin-bottom: 0; }
      .panel { padding: 14px; border-radius: 23px; }
      .asset-card,
      .market-card,
      .vault-card {
        grid-template-columns: 1fr;
        align-items: stretch;
        padding: 14px;
      }
      .asset-card > div:not(.asset-main),
      .market-card > div:not(.asset-main),
      .vault-card > div:not(.asset-main) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-top: 9px;
        border-top: 1px solid rgba(14,165,233,0.09);
      }
      .cell-label { display: block; }
      .cell-value, .cell-sub { text-align: right; }
      .hide-mobile { display: none !important; }
      .hide-desktop { display: block; }
      .insight-grid { grid-template-columns: 1fr 1fr; }
      .drawer-overlay.active { display: block; }
      .settings-drawer { width: 100%; }
      .button-row { grid-template-columns: 1fr; }
    }

    @media (max-width: 410px) {
      .brand-title { font-size: 0.96rem; }
      .brand-subtitle { font-size: 0.68rem; }
      .topbar { padding-left: 10px; padding-right: 10px; }
      .logo { width: 39px; height: 39px; }
      .icon-button { width: 40px; height: 40px; border-radius: 14px; }
      .quick-actions { grid-template-columns: repeat(2, 1fr); margin-top: 12px; }
      .hero-card { margin-bottom: 0; }
      .balance { font-size: 2.45rem; }
      .insight-grid { grid-template-columns: 1fr; }
    }
  </style></head>
