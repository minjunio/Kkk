      <div class="modal-head">
        <div>
          <div class="modal-title">Receive Crypto</div>
          <div class="modal-sub">Scan QR or copy your address below.</div>
        </div>
        <button class="close" onclick="closeModal('receiveModal')">×</button>
      </div>

