    }

    function createFromSettings() {
      closeSettings();
      openModal('createWalletModal');
    }

    async function showSeedInSettings() {
      const passcode = document.getElementById('settingsPasscode').value;

      if (!ACTIVE_DECRYPTED_WALLET) {
        await unlockExistingWallet(passcode);
      }

      if (!ACTIVE_DECRYPTED_WALLET) return;

      const firstWallet = ACTIVE_DECRYPTED_WALLET.wallets.find(w => w.type === 'evm');

      if (!firstWallet) {
        toast('No EVM wallet found');
        return;
      }

      document.getElementById('secretOutput').value = firstWallet.phrase;
      toast('Seed phrase shown in settings');
    }

    async function showKeyInSettings() {
      const passcode = document.getElementById('settingsPasscode').value;

      if (!ACTIVE_DECRYPTED_WALLET) {
        await unlockExistingWallet(passcode);
      }

      if (!ACTIVE_DECRYPTED_WALLET) return;

      const firstWallet = ACTIVE_DECRYPTED_WALLET.wallets.find(w => w.type === 'evm');

      if (!firstWallet) {
        toast('No EVM wallet found');
        return;
      }

      document.getElementById('secretOutput').value = firstWallet.privateKey;
      toast('Private key shown in settings');
    }

    function initializeFromServer() {
      if (SERVER_WALLET?.publicWallets) {
        localStorage.setItem('bluecrypto_public_wallets', JSON.stringify(SERVER_WALLET.publicWallets));
      }

      activeProvider = getProvider();

      updateWalletUi();
      refreshBalances();

      if (!SERVER_WALLET?.encryptedVault) {
        setTimeout(() => {
          openModal('createWalletModal');
          toast('Create a wallet for this email account');
        }, 500);
      }

      setInterval(() => runAutoStakeCheck(false), 60 * 60 * 1000);
    }

    window.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeSettings();
        document.querySelectorAll('.modal-overlay.active').forEach(el => el.classList.remove('active'));
      }
    });

    document.documentElement.setAttribute('data-theme', localStorage.getItem('blue_wallet_theme') || 'light');

    renderNetworks();
    renderSendAssets();
    renderSwapAssets();
    renderStakeStrategySelects();
    renderAutoStakePlanner();
    initializeFromServer();
  </script>
</body>
</html>