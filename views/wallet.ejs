<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Blue Wallet</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      color-scheme: light;
      --bg: #f5f9ff;
      --surface: #ffffff;
      --surface-2: #f7fbff;
      --surface-3: #eef6ff;
      --border: rgba(15, 23, 42, 0.08);
      --border-strong: rgba(2, 132, 199, 0.25);
      --text: #0f172a;
      --muted: #64748b;
      --primary: #0284c7;
      --primary-2: #2563eb;
      --danger: #e11d48;
      --success: #0284c7;
      --shadow: 0 24px 70px rgba(15, 23, 42, 0.09);
      --soft-shadow: 0 12px 32px rgba(15, 23, 42, 0.07);
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg: #050816;
      --surface: #0d1628;
      --surface-2: #111d33;
      --surface-3: #15233d;
      --border: rgba(125, 211, 252, 0.13);
      --border-strong: rgba(56, 189, 248, 0.3);
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #38bdf8;
      --primary-2: #2563eb;
      --danger: #fb7185;
      --success: #38bdf8;
      --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
      --soft-shadow: 0 12px 34px rgba(0, 0, 0, 0.22);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(2, 132, 199, 0.1), transparent 30%),
        linear-gradient(135deg, var(--bg), #e8f3ff);
      padding-bottom: calc(92px + var(--safe-bottom));
    }

    [data-theme="dark"] body {
      background:
        radial-gradient(circle at top left, rgba(56, 189, 248, 0.14), transparent 30%),
        linear-gradient(135deg, #050816, #08111f);
    }

    button, input, select {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: calc(10px + var(--safe-top)) 14px 10px;
      background: rgba(245, 249, 255, 0.92);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(16px);
    }

    [data-theme="dark"] .topbar {
      background: rgba(5, 8, 22, 0.9);
    }

    .topbar-inner {
      width: min(1120px, 100%);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .logo {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: white;
      font-weight: 950;
      letter-spacing: -0.06em;
      background: linear-gradient(135deg, #2563eb, #38bdf8);
      box-shadow: 0 12px 28px rgba(37, 99, 235, 0.2);
    }

    .brand-title {
      font-weight: 950;
      letter-spacing: -0.04em;
      white-space: nowrap;
    }

    .brand-sub {
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .top-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .icon-btn,
    .small-btn,
    .primary-btn,
    .secondary-btn,
    .danger-btn,
    .pill-btn {
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .icon-btn {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      box-shadow: var(--soft-shadow);
    }

    .icon-btn:hover,
    .small-btn:hover,
    .primary-btn:hover,
    .secondary-btn:hover,
    .danger-btn:hover,
    .pill-btn:hover {
      transform: translateY(-1px);
      border-color: var(--border-strong);
    }

    .user-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 10px 7px 7px;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--soft-shadow);
      font-size: 0.8rem;
      font-weight: 900;
    }

    .avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary-2), var(--primary));
    }

    .shell {
      width: min(1120px, 100%);
      margin: 0 auto;
      padding: 16px;
    }

    .hero {
      border-radius: 28px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      padding: 22px;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 0.8fr;
      gap: 18px;
      align-items: stretch;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      color: var(--primary);
      background: rgba(2, 132, 199, 0.08);
      border: 1px solid var(--border-strong);
      font-size: 0.75rem;
      font-weight: 950;
    }

    .pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--primary);
      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(2,132,199,.4); }
      80% { box-shadow: 0 0 0 9px rgba(2,132,199,0); }
      100% { box-shadow: 0 0 0 0 rgba(2,132,199,0); }
    }

    .main-address {
      margin-top: 18px;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 800;
      word-break: break-all;
    }

    .big-balance {
      margin-top: 10px;
      font-size: clamp(2.25rem, 7vw, 4.5rem);
      line-height: 0.95;
      letter-spacing: -0.07em;
      font-weight: 950;
      font-variant-numeric: tabular-nums;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      align-content: end;
    }

    .action-card {
      min-height: 74px;
      border-radius: 20px;
      padding: 13px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text);
      text-align: left;
    }

    .action-card.primary {
      color: white;
      background: linear-gradient(135deg, var(--primary-2), var(--primary));
      border-color: transparent;
    }

    .action-card strong {
      display: block;
      font-weight: 950;
      margin-bottom: 4px;
    }

    .action-card span {
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 800;
    }

    .action-card.primary span {
      color: rgba(255,255,255,0.82);
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 16px;
      margin-top: 16px;
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--soft-shadow);
      padding: 16px;
    }

    .panel + .panel {
      margin-top: 16px;
    }

    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 13px;
    }

    .panel-title {
      font-size: 1.03rem;
      font-weight: 950;
      letter-spacing: -0.04em;
    }

    .panel-sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: 0.78rem;
      line-height: 1.45;
      font-weight: 750;
    }

    .token-list,
    .network-list {
      display: grid;
      gap: 8px;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
      align-items: center;
      padding: 12px;
      border-radius: 17px;
      background: var(--surface-2);
      border: 1px solid var(--border);
    }

    .asset-main {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
    }

    .coin {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      background: var(--surface-3);
      border: 1px solid var(--border);
      color: var(--primary);
      font-size: 0.74rem;
      font-weight: 950;
      overflow: hidden;
    }

    .coin img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .name {
      font-weight: 950;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 800;
      word-break: break-all;
    }

    .value {
      text-align: right;
      font-weight: 950;
      font-variant-numeric: tabular-nums;
    }

    .value-sub {
      margin-top: 3px;
      text-align: right;
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 800;
    }

    .small-btn {
      padding: 9px 12px;
      border-radius: 13px;
      background: var(--surface-2);
      color: var(--text);
      border: 1px solid var(--border);
      font-size: 0.77rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .primary-btn,
    .secondary-btn,
    .danger-btn {
      min-height: 47px;
      border-radius: 15px;
      font-weight: 950;
    }

    .primary-btn {
      color: white;
      background: linear-gradient(135deg, var(--primary-2), var(--primary));
      box-shadow: 0 14px 30px rgba(37,99,235,0.18);
    }

    .secondary-btn {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .danger-btn {
      color: white;
      background: linear-gradient(135deg, #be123c, #fb7185);
    }

    .pill-row {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 2px;
      margin-bottom: 13px;
    }

    .pill-btn {
      flex: 0 0 auto;
      padding: 10px 13px;
      border-radius: 999px;
      background: var(--surface-2);
      color: var(--muted);
      border: 1px solid var(--border);
      font-size: 0.76rem;
      font-weight: 950;
    }

    .pill-btn.active {
      color: white;
      background: linear-gradient(135deg, var(--primary-2), var(--primary));
      border-color: transparent;
    }

    .form-grid {
      display: grid;
      gap: 10px;
    }

    .form-row {
      display: grid;
      gap: 7px;
    }

    .form-row label {
      color: var(--muted);
      font-size: 0.72rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .input,
    .select {
      width: 100%;
      min-height: 46px;
      border-radius: 14px;
      padding: 12px;
      background: var(--surface-2);
      color: var(--text);
      border: 1px solid var(--border);
      outline: none;
      font-weight: 850;
    }

    .input:focus,
    .select:focus {
      border-color: var(--border-strong);
      box-shadow: 0 0 0 4px rgba(2,132,199,0.08);
    }

    .button-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 10px;
    }

    .modal-overlay,
    .drawer-overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      background: rgba(0,0,0,0.42);
      backdrop-filter: blur(8px);
    }

    .modal-overlay.active,
    .drawer-overlay.active {
      display: block;
    }

    .modal-card {
      width: min(520px, calc(100% - 26px));
      max-height: calc(100vh - 28px);
      overflow-y: auto;
      margin: calc(14px + var(--safe-top)) auto 0;
      padding: 16px;
      border-radius: 22px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      animation: pop 0.22s ease both;
    }

    .drawer {
      position: absolute;
      top: 0;
      right: 0;
      width: min(470px, 100%);
      height: 100%;
      overflow-y: auto;
      padding: calc(18px + var(--safe-top)) 16px calc(20px + var(--safe-bottom));
      background: var(--surface);
      border-left: 1px solid var(--border);
      box-shadow: -24px 0 80px rgba(0,0,0,0.22);
      animation: slide 0.23s ease both;
    }

    @keyframes pop {
      from { transform: translateY(18px) scale(0.98); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    @keyframes slide {
      from { transform: translateX(36px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    .modal-head,
    .drawer-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 14px;
    }

    .modal-title,
    .drawer-title {
      font-size: 1.25rem;
      font-weight: 950;
      letter-spacing: -0.055em;
    }

    .modal-sub,
    .drawer-sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 750;
      line-height: 1.45;
    }

    .close {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      background: var(--surface-2);
      color: var(--text);
      border: 1px solid var(--border);
      font-size: 1.25rem;
      font-weight: 950;
    }

    .section {
      margin-top: 12px;
      border-radius: 19px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      padding: 13px;
    }

    .section h3 {
      font-size: 0.93rem;
      font-weight: 950;
      letter-spacing: -0.035em;
      margin-bottom: 9px;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: calc(94px + var(--safe-bottom));
      transform: translateX(-50%) translateY(12px);
      z-index: 150;
      max-width: min(430px, calc(100% - 28px));
      padding: 12px 14px;
      border-radius: 15px;
      background: rgba(2,6,23,0.92);
      color: white;
      box-shadow: var(--soft-shadow);
      opacity: 0;
      pointer-events: none;
      transition: all 0.22s ease;
      font-weight: 850;
      font-size: 0.84rem;
    }

    .toast.active {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(12px + var(--safe-bottom));
      transform: translateX(-50%);
      z-index: 70;
      width: min(430px, calc(100% - 28px));
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      padding: 8px;
      border-radius: 22px;
      background: rgba(255,255,255,0.92);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(14px);
    }

    [data-theme="dark"] .bottom-nav {
      background: rgba(13,22,40,0.9);
    }

    .bottom-nav button {
      min-height: 48px;
      border-radius: 16px;
      background: transparent;
      color: var(--muted);
      font-size: 0.72rem;
      font-weight: 950;
    }

    .bottom-nav button.active {
      color: white;
      background: linear-gradient(135deg, var(--primary-2), var(--primary));
    }

    @media (max-width: 900px) {
      .hero-grid,
      .grid {
        grid-template-columns: 1fr;
      }

      .hero-actions {
        grid-template-columns: repeat(4, 1fr);
      }

      .action-card {
        text-align: center;
      }
    }

    @media (max-width: 620px) {
      .shell {
        padding: 13px;
      }

      .hero {
        padding: 18px;
        border-radius: 24px;
      }

      .hero-actions {
        grid-template-columns: repeat(2, 1fr);
      }

      .row {
        grid-template-columns: 1fr;
      }

      .value,
      .value-sub {
        text-align: left;
      }

      .button-row {
        grid-template-columns: 1fr;
      }

      .user-chip span {
        display: none;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="logo">B</div>
        <div>
          <div class="brand-title">Blue Wallet</div>
          <div class="brand-sub"><span class="pulse"></span><span id="statusText">Secure EVM wallet</span></div>
        </div>
      </div>

      <div class="top-actions">
        <button class="icon-btn" onclick="goTrading()" aria-label="Trading">↗</button>
        <button class="icon-btn" onclick="refreshBalances()" aria-label="Refresh">⟳</button>
        <button class="icon-btn" onclick="openSettings()" aria-label="Settings">⚙</button>
        <div class="user-chip">
          <div class="avatar"></div>
          <span><%= typeof username !== 'undefined' ? username : 'user' %></span>
        </div>
      </div>
    </div>
  </header>

  <main class="shell">
    <section class="hero">
      <div class="hero-grid">
        <div>
          <div class="eyebrow"><span class="pulse"></span> Real wallet</div>
          <div class="main-address" id="walletAddressText">No wallet loaded</div>
          <div class="big-balance" id="totalBalance">$0.00</div>
          <div class="main-address" id="activeNetworkText">Network: Ethereum</div>
        </div>

        <div class="hero-actions">
          <button class="action-card primary" onclick="openModal('receiveModal')"><strong>Receive</strong><span>Show address</span></button>
          <button class="action-card" onclick="openModal('sendModal')"><strong>Send</strong><span>Native + ERC-20</span></button>
          <button class="action-card" onclick="openModal('swapModal')"><strong>Swap</strong><span>0x quote route</span></button>
          <button class="action-card" onclick="openModal('stakeModal')"><strong>Stake</strong><span>ETH via Lido</span></button>
        </div>
      </div>
    </section>

    <section class="grid">
      <div>
        <section class="panel" id="assetsSection">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Real balances</h2>
              <p class="panel-sub">Native EVM coin and selected ERC-20 token balances from RPC.</p>
            </div>
            <button class="small-btn" onclick="refreshBalances()">Refresh</button>
          </div>
          <div class="token-list" id="tokenList"></div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Networks</h2>
              <p class="panel-sub">Choose the EVM chain to read balances and send from.</p>
            </div>
          </div>
          <div class="pill-row" id="networkPills"></div>
          <div class="network-list" id="networkInfo"></div>
        </section>
      </div>

      <aside>
        <section class="panel">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Wallet security</h2>
              <p class="panel-sub">Your key is encrypted client-side. The server stores encrypted vault only.</p>
            </div>
          </div>
          <div class="button-row">
            <button class="secondary-btn" onclick="unlockExistingWallet()">Unlock</button>
            <button class="primary-btn" onclick="createNewRealWalletForAccount()">Create</button>
          </div>
          <div class="button-row">
            <button class="secondary-btn" onclick="revealSecretPhrase()">Seed</button>
            <button class="secondary-btn" onclick="revealPrivateKey()">Private key</button>
          </div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Public address</h2>
              <p class="panel-sub">Use this to receive crypto on selected EVM chains.</p>
            </div>
          </div>
          <div class="token-list" id="publicWalletList"></div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Fee estimate</h2>
              <p class="panel-sub">Fees are estimated before sending/staking.</p>
            </div>
          </div>
          <div class="token-list" id="feeBox">
            <div class="row">
              <div>
                <div class="name">Current gas</div>
                <div class="sub" id="gasText">Load wallet first</div>
              </div>
            </div>
          </div>
        </section>
      </aside>
    </section>
  </main>

  <nav class="bottom-nav">
    <button class="active" onclick="scrollToTop()">Home</button>
    <button onclick="document.getElementById('assetsSection').scrollIntoView({behavior:'smooth'})">Assets</button>
    <button onclick="goTrading()">Trading</button>
    <button onclick="openSettings()">Settings</button>
  </nav>

  <div class="modal-overlay" id="receiveModal" onclick="overlayClose(event, 'receiveModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Receive</div>
          <div class="modal-sub">Send only assets supported by the selected EVM network to this address.</div>
        </div>
        <button class="close" onclick="closeModal('receiveModal')">×</button>
      </div>

      <div class="section">
        <h3 id="receiveNetworkTitle">EVM address</h3>
        <div class="sub" id="receiveAddressText">No wallet loaded</div>
        <div class="button-row">
          <button class="secondary-btn" onclick="copyAddress()">Copy address</button>
          <button class="secondary-btn" onclick="refreshBalances()">Refresh</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="sendModal" onclick="overlayClose(event, 'sendModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Send</div>
          <div class="modal-sub">Sends a real on-chain transaction from your unlocked wallet.</div>
        </div>
        <button class="close" onclick="closeModal('sendModal')">×</button>
      </div>

      <div class="form-grid">
        <div class="form-row">
          <label>Asset</label>
          <select class="select" id="sendAssetSelect"></select>
        </div>

        <div class="form-row">
          <label>To address</label>
          <input class="input" id="sendToInput" placeholder="0x..." />
        </div>

        <div class="form-row">
          <label>Amount</label>
          <input class="input" id="sendAmountInput" type="number" step="any" placeholder="0.00" />
        </div>

        <div class="section">
          <h3>Fee</h3>
          <div class="sub" id="sendFeePreview">Estimate appears before send.</div>
        </div>

        <div class="button-row">
          <button class="secondary-btn" onclick="estimateSendFee()">Estimate fee</button>
          <button class="primary-btn" onclick="sendRealTransaction()">Send</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="swapModal" onclick="overlayClose(event, 'swapModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Swap</div>
          <div class="modal-sub">Requires your server to proxy 0x Swap API with an API key.</div>
        </div>
        <button class="close" onclick="closeModal('swapModal')">×</button>
      </div>

      <div class="form-grid">
        <div class="form-row">
          <label>Sell token address</label>
          <input class="input" id="swapSellToken" placeholder="Native ETH: 0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" />
        </div>

        <div class="form-row">
          <label>Buy token address</label>
          <input class="input" id="swapBuyToken" placeholder="USDC / token contract address" />
        </div>

        <div class="form-row">
          <label>Sell amount</label>
          <input class="input" id="swapAmount" type="number" step="any" placeholder="0.00" />
        </div>

        <div class="section">
          <h3>Quote</h3>
          <div class="sub" id="swapQuoteText">No quote loaded.</div>
        </div>

        <div class="button-row">
          <button class="secondary-btn" onclick="getSwapQuote()">Get quote</button>
          <button class="primary-btn" onclick="executeSwap()">Swap</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="stakeModal" onclick="overlayClose(event, 'stakeModal')">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <div class="modal-title">Stake ETH</div>
          <div class="modal-sub">Stakes ETH into Lido on Ethereum mainnet and receives stETH.</div>
        </div>
        <button class="close" onclick="closeModal('stakeModal')">×</button>
      </div>

      <div class="form-grid">
        <div class="form-row">
          <label>ETH amount</label>
          <input class="input" id="stakeAmountInput" type="number" step="any" placeholder="0.00" />
        </div>

        <div class="section">
          <h3>Important</h3>
          <div class="sub">
            This is a real Ethereum mainnet transaction. You need ETH for the stake amount and gas.
          </div>
        </div>

        <div class="button-row">
          <button class="secondary-btn" onclick="estimateStakeFee()">Estimate fee</button>
          <button class="primary-btn" onclick="stakeEthLido()">Stake ETH</button>
        </div>
      </div>
    </div>
  </div>

  <div class="drawer-overlay" id="settingsOverlay" onclick="overlayClose(event, 'settingsOverlay')">
    <aside class="drawer">
      <div class="drawer-head">
        <div>
          <div class="drawer-title">Settings</div>
          <div class="drawer-sub">RPC, theme, wallet security, and session controls.</div>
        </div>
        <button class="close" onclick="closeSettings()">×</button>
      </div>

      <section class="section">
        <h3>Wallet</h3>
        <div class="button-row">
          <button class="secondary-btn" onclick="unlockExistingWallet()">Unlock wallet</button>
          <button class="primary-btn" onclick="createNewRealWalletForAccount()">Create wallet</button>
        </div>
        <div class="button-row">
          <button class="secondary-btn" onclick="revealSecretPhrase()">Show seed</button>
          <button class="secondary-btn" onclick="revealPrivateKey()">Show key</button>
        </div>
      </section>

      <section class="section">
        <h3>Theme</h3>
        <div class="button-row">
          <button class="secondary-btn" onclick="setTheme('light')">Light</button>
          <button class="secondary-btn" onclick="setTheme('dark')">Dark</button>
        </div>
      </section>

      <section class="section">
        <h3>RPC</h3>
        <div class="form-grid">
          <div class="form-row">
            <label>Custom RPC URL for current network</label>
            <input class="input" id="customRpcInput" placeholder="https://..." />
          </div>
          <button class="primary-btn" onclick="saveCustomRpc()">Save RPC</button>
        </div>
      </section>

      <section class="section">
        <h3>Logout</h3>
        <form action="/logout" method="POST">
          <button class="danger-btn" type="submit" style="width:100%;">Logout</button>
        </form>
      </section>
    </aside>
  </div>

  <div class="toast" id="toast"></div>

  <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.5/dist/ethers.umd.min.js"></script>

  <script>
    const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
    const CURRENT_EMAIL = "<%= typeof email !== 'undefined' ? email : '' %>";

    const NATIVE_TOKEN = '0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee';
    const LIDO_STETH_CONTRACT = '0xae7ab96520DE3A18E5e111B5EaAb095312D7fE84';

    const NETWORKS = {
      ethereum: {
        name: 'Ethereum',
        chainId: 1,
        symbol: 'ETH',
        rpc: 'https://cloudflare-eth.com',
        explorer: 'https://etherscan.io/tx/'
      },
      polygon: {
        name: 'Polygon',
        chainId: 137,
        symbol: 'MATIC',
        rpc: 'https://polygon-rpc.com',
        explorer: 'https://polygonscan.com/tx/'
      },
      bsc: {
        name: 'BNB Chain',
        chainId: 56,
        symbol: 'BNB',
        rpc: 'https://bsc-dataseed.binance.org',
        explorer: 'https://bscscan.com/tx/'
      },
      avalanche: {
        name: 'Avalanche C-Chain',
        chainId: 43114,
        symbol: 'AVAX',
        rpc: 'https://api.avax.network/ext/bc/C/rpc',
        explorer: 'https://snowtrace.io/tx/'
      },
      arbitrum: {
        name: 'Arbitrum',
        chainId: 42161,
        symbol: 'ETH',
        rpc: 'https://arb1.arbitrum.io/rpc',
        explorer: 'https://arbiscan.io/tx/'
      },
      optimism: {
        name: 'Optimism',
        chainId: 10,
        symbol: 'ETH',
        rpc: 'https://mainnet.optimism.io',
        explorer: 'https://optimistic.etherscan.io/tx/'
      },
      base: {
        name: 'Base',
        chainId: 8453,
        symbol: 'ETH',
        rpc: 'https://mainnet.base.org',
        explorer: 'https://basescan.org/tx/'
      }
    };

    const ERC20_TOKENS = {
      ethereum: [
        { symbol: 'USDT', name: 'Tether USD', address: '0xdAC17F958D2ee523a2206206994597C13D831ec7', decimals: 6 },
        { symbol: 'USDC', name: 'USD Coin', address: '0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48', decimals: 6 },
        { symbol: 'LINK', name: 'Chainlink', address: '0x514910771AF9Ca656af840dff83E8264EcF986CA', decimals: 18 },
        { symbol: 'UNI', name: 'Uniswap', address: '0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984', decimals: 18 },
        { symbol: 'stETH', name: 'Lido stETH', address: LIDO_STETH_CONTRACT, decimals: 18 }
      ],
      polygon: [
        { symbol: 'USDT', name: 'Tether USD', address: '0xc2132D05D31c914a87C6611C10748AEb04B58e8F', decimals: 6 },
        { symbol: 'USDC', name: 'USD Coin', address: '0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174', decimals: 6 }
      ],
      bsc: [
        { symbol: 'USDT', name: 'Tether USD', address: '0x55d398326f99059fF775485246999027B3197955', decimals: 18 },
        { symbol: 'USDC', name: 'USD Coin', address: '0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d', decimals: 18 }
      ],
      avalanche: [
        { symbol: 'USDT', name: 'Tether USD', address: '0x9702230A8Ea53601f5cD2dc00fDBC13d4dF4A8c7', decimals: 6 },
        { symbol: 'USDC', name: 'USD Coin', address: '0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E', decimals: 6 }
      ],
      arbitrum: [
        { symbol: 'USDT', name: 'Tether USD', address: '0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9', decimals: 6 },
        { symbol: 'USDC', name: 'USD Coin', address: '0xaf88d065e77c8cC2239327C5EDb3A432268e5831', decimals: 6 }
      ],
      optimism: [
        { symbol: 'USDT', name: 'Tether USD', address: '0x94b008aD8eD3f9fE1ef8bE45b16bB2fF12a2bA8a', decimals: 6 },
        { symbol: 'USDC', name: 'USD Coin', address: '0x0b2C639c533813f4Aa9D7837CAF62653d097Ff85', decimals: 6 }
      ],
      base: [
        { symbol: 'USDC', name: 'USD Coin', address: '0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913', decimals: 6 }
      ]
    };

    const ERC20_ABI = [
      'function balanceOf(address owner) view returns (uint256)',
      'function transfer(address to, uint256 amount) returns (bool)',
      'function decimals() view returns (uint8)',
      'function symbol() view returns (string)',
      'function approve(address spender, uint256 amount) returns (bool)',
      'function allowance(address owner, address spender) view returns (uint256)'
    ];

    const LIDO_ABI = [
      'function submit(address _referral) payable returns (uint256)'
    ];

    let activeNetworkKey = localStorage.getItem('blue_active_network') || 'ethereum';
    let ACTIVE_DECRYPTED_WALLET = null;
    let activeSigner = null;
    let activeProvider = null;
    let activeBalances = [];
    let toastTimer = null;

    function toast(message) {
      const el = document.getElementById('toast');
      el.textContent = message;
      el.classList.add('active');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove('active'), 2500);
    }

    function money(value) {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 2
      }).format(Number(value || 0));
    }

    function fmt(value, decimals = 6) {
      return Number(value || 0).toLocaleString(undefined, {
        maximumFractionDigits: decimals
      });
    }

    function shortAddress(address) {
      if (!address) return 'No wallet loaded';
      return `${address.slice(0, 6)}...${address.slice(-4)}`;
    }

    function tokenIcon(symbol) {
      return `<div class="coin"><img src="https://assets.coincap.io/assets/icons/${String(symbol).toLowerCase()}@2x.png" onerror="this.remove();this.parentNode.textContent='${String(symbol).slice(0, 4)}'" /></div>`;
    }

    function getRpcUrl(networkKey = activeNetworkKey) {
      const custom = localStorage.getItem(`blue_rpc_${networkKey}`);
      return custom || NETWORKS[networkKey].rpc;
    }

    function getProvider(networkKey = activeNetworkKey) {
      return new ethers.JsonRpcProvider(getRpcUrl(networkKey), NETWORKS[networkKey].chainId);
    }

    async function ensureUnlocked() {
      if (ACTIVE_DECRYPTED_WALLET && activeSigner) return activeSigner;
      const unlocked = await unlockExistingWallet();
      if (!unlocked) throw new Error('Wallet not unlocked');
      return activeSigner;
    }

    function updateWalletUi() {
      const publicWallet = getPublicWallet();
      const address = publicWallet?.address || ACTIVE_DECRYPTED_WALLET?.wallets?.[0]?.address || null;
      const network = NETWORKS[activeNetworkKey];

      document.getElementById('walletAddressText').textContent = address
        ? `${network.name}: ${address}`
        : 'No wallet loaded';

      document.getElementById('receiveAddressText').textContent = address || 'No wallet loaded';
      document.getElementById('receiveNetworkTitle').textContent = `${network.name} receive address`;
      document.getElementById('activeNetworkText').textContent = `Network: ${network.name}`;

      renderPublicWallets();
      renderNetworks();
      renderSendAssets();
    }

    function getPublicWallet() {
      const wallets = JSON.parse(localStorage.getItem('bluecrypto_public_wallets') || '[]');
      return wallets[0] || SERVER_WALLET?.publicWallets?.[0] || null;
    }

    function renderPublicWallets() {
      const list = document.getElementById('publicWalletList');
      const wallet = getPublicWallet();

      if (!wallet) {
        list.innerHTML = `<div class="row"><div><div class="name">No wallet</div><div class="sub">Create or unlock a wallet first.</div></div></div>`;
        return;
      }

      list.innerHTML = `
        <div class="row">
          <div>
            <div class="name">${wallet.type?.toUpperCase() || 'EVM'} address</div>
            <div class="sub">${wallet.address}</div>
          </div>
          <button class="small-btn" onclick="copyAddress()">Copy</button>
        </div>
      `;
    }

    function renderNetworks() {
      const pills = document.getElementById('networkPills');
      pills.innerHTML = Object.entries(NETWORKS).map(([key, net]) => `
        <button class="pill-btn ${key === activeNetworkKey ? 'active' : ''}" onclick="setNetwork('${key}')">${net.name}</button>
      `).join('');

      const net = NETWORKS[activeNetworkKey];
      document.getElementById('networkInfo').innerHTML = `
        <div class="row">
          <div>
            <div class="name">${net.name}</div>
            <div class="sub">Chain ID ${net.chainId} · Native ${net.symbol}</div>
          </div>
          <button class="small-btn" onclick="refreshBalances()">Refresh</button>
        </div>
      `;
    }

    function setNetwork(key) {
      activeNetworkKey = key;
      localStorage.setItem('blue_active_network', key);
      activeProvider = getProvider(key);

      if (ACTIVE_DECRYPTED_WALLET) {
        activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey, activeProvider);
      }

      updateWalletUi();
      refreshBalances();
    }

    function renderSendAssets() {
      const select = document.getElementById('sendAssetSelect');
      const net = NETWORKS[activeNetworkKey];
      const tokens = ERC20_TOKENS[activeNetworkKey] || [];

      select.innerHTML = [
        `<option value="native">${net.symbol} · Native</option>`,
        ...tokens.map(t => `<option value="${t.address}">${t.symbol} · ${t.name}</option>`)
      ].join('');
    }

    async function refreshBalances() {
      try {
        const wallet = getPublicWallet();

        if (!wallet?.address) {
          renderTokenList([]);
          document.getElementById('totalBalance').textContent = '$0.00';
          toast('Create or unlock wallet first');
          return;
        }

        document.getElementById('statusText').textContent = 'Reading balances...';

        const provider = getProvider();
        const net = NETWORKS[activeNetworkKey];

        const nativeWei = await provider.getBalance(wallet.address);
        const nativeBalance = Number(ethers.formatEther(nativeWei));

        const balances = [{
          type: 'native',
          symbol: net.symbol,
          name: net.name,
          address: null,
          balance: nativeBalance,
          decimals: 18
        }];

        for (const token of ERC20_TOKENS[activeNetworkKey] || []) {
          try {
            const contract = new ethers.Contract(token.address, ERC20_ABI, provider);
            const raw = await contract.balanceOf(wallet.address);
            const balance = Number(ethers.formatUnits(raw, token.decimals));
            balances.push({ ...token, type: 'erc20', balance });
          } catch (error) {
            balances.push({ ...token, type: 'erc20', balance: 0, error: true });
          }
        }

        activeBalances = balances;
        renderTokenList(balances);
        renderSendAssets();
        updateGasInfo();

        document.getElementById('statusText').textContent = 'Balances updated';
      } catch (error) {
        console.error(error);
        toast('Could not read balances. Check RPC.');
        document.getElementById('statusText').textContent = 'RPC error';
      }
    }

    function renderTokenList(balances) {
      const list = document.getElementById('tokenList');

      if (!balances.length) {
        list.innerHTML = `<div class="row"><div><div class="name">No balances loaded</div><div class="sub">Create wallet then refresh.</div></div></div>`;
        return;
      }

      list.innerHTML = balances.map(token => `
        <div class="row">
          <div class="asset-main">
            ${tokenIcon(token.symbol)}
            <div>
              <div class="name">${token.symbol}</div>
              <div class="sub">${token.name}${token.error ? ' · read error' : ''}</div>
            </div>
          </div>
          <div>
            <div class="value">${fmt(token.balance, token.balance < 1 ? 8 : 6)}</div>
            <div class="value-sub">${token.type === 'native' ? 'Native' : 'ERC-20'}</div>
          </div>
        </div>
      `).join('');

      document.getElementById('totalBalance').textContent = `${balances.length} assets`;
    }

    async function updateGasInfo() {
      try {
        const provider = getProvider();
        const fee = await provider.getFeeData();
        const gasPrice = fee.gasPrice ? ethers.formatUnits(fee.gasPrice, 'gwei') : 'N/A';
        document.getElementById('gasText').textContent = `${Number(gasPrice).toFixed(3)} gwei on ${NETWORKS[activeNetworkKey].name}`;
      } catch {
        document.getElementById('gasText').textContent = 'Unable to estimate gas';
      }
    }

    async function estimateSendFee() {
      try {
        const signer = await ensureUnlocked();
        const asset = document.getElementById('sendAssetSelect').value;
        const to = document.getElementById('sendToInput').value.trim();
        const amount = document.getElementById('sendAmountInput').value.trim();

        if (!ethers.isAddress(to)) throw new Error('Invalid recipient');
        if (!amount || Number(amount) <= 0) throw new Error('Invalid amount');

        let gas;

        if (asset === 'native') {
          gas = await signer.estimateGas({
            to,
            value: ethers.parseEther(amount)
          });
        } else {
          const token = getTokenByAddress(asset);
          const contract = new ethers.Contract(asset, ERC20_ABI, signer);
          gas = await contract.transfer.estimateGas(to, ethers.parseUnits(amount, token.decimals));
        }

        const fee = await signer.provider.getFeeData();
        const gasPrice = fee.gasPrice || 0n;
        const estimatedWei = gas * gasPrice;

        document.getElementById('sendFeePreview').textContent =
          `Estimated gas: ${gas.toString()} · Fee: ${ethers.formatEther(estimatedWei)} ${NETWORKS[activeNetworkKey].symbol}`;

        return gas;
      } catch (error) {
        document.getElementById('sendFeePreview').textContent = error.message || 'Fee estimate failed';
        toast(error.message || 'Fee estimate failed');
        return null;
      }
    }

    async function sendRealTransaction() {
      try {
        const confirmed = confirm('This will send a real on-chain transaction. Continue?');
        if (!confirmed) return;

        const signer = await ensureUnlocked();
        const asset = document.getElementById('sendAssetSelect').value;
        const to = document.getElementById('sendToInput').value.trim();
        const amount = document.getElementById('sendAmountInput').value.trim();

        if (!ethers.isAddress(to)) throw new Error('Invalid recipient');
        if (!amount || Number(amount) <= 0) throw new Error('Invalid amount');

        let tx;

        if (asset === 'native') {
          tx = await signer.sendTransaction({
            to,
            value: ethers.parseEther(amount)
          });
        } else {
          const token = getTokenByAddress(asset);
          const contract = new ethers.Contract(asset, ERC20_ABI, signer);
          tx = await contract.transfer(to, ethers.parseUnits(amount, token.decimals));
        }

        toast('Transaction sent');
        document.getElementById('sendFeePreview').innerHTML =
          `TX sent: <a href="${NETWORKS[activeNetworkKey].explorer}${tx.hash}" target="_blank" rel="noopener">${tx.hash}</a>`;

        await tx.wait();
        toast('Transaction confirmed');
        refreshBalances();
      } catch (error) {
        console.error(error);
        toast(error.shortMessage || error.message || 'Send failed');
      }
    }

    function getTokenByAddress(address) {
      return (ERC20_TOKENS[activeNetworkKey] || []).find(t => t.address.toLowerCase() === address.toLowerCase());
    }

    async function estimateStakeFee() {
      try {
        if (activeNetworkKey !== 'ethereum') {
          toast('Lido staking is Ethereum mainnet only');
          return;
        }

        const signer = await ensureUnlocked();
        const amount = document.getElementById('stakeAmountInput').value.trim();

        if (!amount || Number(amount) <= 0) throw new Error('Invalid amount');

        const lido = new ethers.Contract(LIDO_STETH_CONTRACT, LIDO_ABI, signer);

        const gas = await lido.submit.estimateGas(ethers.ZeroAddress, {
          value: ethers.parseEther(amount)
        });

        const fee = await signer.provider.getFeeData();
        const estimatedWei = gas * (fee.gasPrice || 0n);

        toast(`Estimated fee: ${ethers.formatEther(estimatedWei)} ETH`);
      } catch (error) {
        toast(error.shortMessage || error.message || 'Stake fee estimate failed');
      }
    }

    async function stakeEthLido() {
      try {
        if (activeNetworkKey !== 'ethereum') {
          toast('Switch to Ethereum first');
          return;
        }

        const confirmed = confirm('This will stake real ETH through Lido and receive stETH. Continue?');
        if (!confirmed) return;

        const signer = await ensureUnlocked();
        const amount = document.getElementById('stakeAmountInput').value.trim();

        if (!amount || Number(amount) <= 0) throw new Error('Invalid amount');

        const lido = new ethers.Contract(LIDO_STETH_CONTRACT, LIDO_ABI, signer);

        const tx = await lido.submit(ethers.ZeroAddress, {
          value: ethers.parseEther(amount)
        });

        toast('Stake transaction sent');
        await tx.wait();

        toast('ETH staked. stETH should appear after refresh.');
        refreshBalances();
      } catch (error) {
        console.error(error);
        toast(error.shortMessage || error.message || 'Staking failed');
      }
    }

    async function getSwapQuote() {
      try {
        const signer = await ensureUnlocked();
        const sellToken = document.getElementById('swapSellToken').value.trim() || NATIVE_TOKEN;
        const buyToken = document.getElementById('swapBuyToken').value.trim();
        const amount = document.getElementById('swapAmount').value.trim();

        if (!buyToken) throw new Error('Enter buy token address');
        if (!amount || Number(amount) <= 0) throw new Error('Invalid amount');

        const sellAmountWei = ethers.parseEther(amount).toString();

        const response = await fetch('/api/swap/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            chainId: NETWORKS[activeNetworkKey].chainId,
            taker: await signer.getAddress(),
            sellToken,
            buyToken,
            sellAmount: sellAmountWei
          })
        });

        if (!response.ok) throw new Error('Swap quote failed. Add /api/swap/quote on server.');

        const quote = await response.json();
        window.__BLUE_SWAP_QUOTE = quote;

        document.getElementById('swapQuoteText').textContent =
          `Quote loaded. Estimated gas: ${quote.gas || 'N/A'}. Ready to execute.`;
      } catch (error) {
        console.error(error);
        document.getElementById('swapQuoteText').textContent = error.message || 'Quote failed';
        toast(error.message || 'Quote failed');
      }
    }

    async function executeSwap() {
      try {
        const quote = window.__BLUE_SWAP_QUOTE;
        if (!quote) throw new Error('Get a quote first');

        const signer = await ensureUnlocked();

        const confirmed = confirm('This will execute a real swap transaction. Continue?');
        if (!confirmed) return;

        const tx = await signer.sendTransaction({
          to: quote.to,
          data: quote.data,
          value: quote.value ? BigInt(quote.value) : 0n,
          gasLimit: quote.gas ? BigInt(quote.gas) : undefined
        });

        toast('Swap transaction sent');
        document.getElementById('swapQuoteText').innerHTML =
          `TX sent: <a href="${NETWORKS[activeNetworkKey].explorer}${tx.hash}" target="_blank" rel="noopener">${tx.hash}</a>`;

        await tx.wait();
        toast('Swap confirmed');
        refreshBalances();
      } catch (error) {
        console.error(error);
        toast(error.shortMessage || error.message || 'Swap failed');
      }
    }

    function openSettings() {
      document.getElementById('settingsOverlay').classList.add('active');
    }

    function closeSettings() {
      document.getElementById('settingsOverlay').classList.remove('active');
    }

    function openModal(id) {
      document.getElementById(id).classList.add('active');
      renderSendAssets();
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    function overlayClose(event, id) {
      if (event.target.id === id) document.getElementById(id).classList.remove('active');
    }

    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function goTrading() {
      window.location.href = '/trading';
    }

    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('blue_wallet_theme', theme);
      toast(`${theme === 'dark' ? 'Dark' : 'Light'} mode enabled`);
    }

    function copyAddress() {
      const address = getPublicWallet()?.address || ACTIVE_DECRYPTED_WALLET?.wallets?.[0]?.address;
      if (!address) return toast('No address');
      navigator.clipboard?.writeText(address);
      toast('Address copied');
    }

    function saveCustomRpc() {
      const value = document.getElementById('customRpcInput').value.trim();
      if (!value.startsWith('http')) return toast('Enter a valid RPC URL');
      localStorage.setItem(`blue_rpc_${activeNetworkKey}`, value);
      activeProvider = getProvider();
      if (ACTIVE_DECRYPTED_WALLET) {
        activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey, activeProvider);
      }
      toast('RPC saved');
      refreshBalances();
    }

    function bytesToBase64(bytes) {
      return btoa(String.fromCharCode(...new Uint8Array(bytes)));
    }

    function base64ToBytes(base64) {
      return Uint8Array.from(atob(base64), c => c.charCodeAt(0));
    }

    async function deriveAesKey(secret, saltBase64) {
      const salt = base64ToBytes(saltBase64);

      const keyMaterial = await crypto.subtle.importKey(
        'raw',
        new TextEncoder().encode(secret),
        'PBKDF2',
        false,
        ['deriveKey']
      );

      return crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt,
          iterations: 250000,
          hash: 'SHA-256'
        },
        keyMaterial,
        {
          name: 'AES-GCM',
          length: 256
        },
        false,
        ['encrypt', 'decrypt']
      );
    }

    async function encryptVault(vaultObject, secret) {
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const saltBase64 = bytesToBase64(salt);

      const key = await deriveAesKey(secret, saltBase64);

      const encrypted = await crypto.subtle.encrypt(
        { name: 'AES-GCM', iv },
        key,
        new TextEncoder().encode(JSON.stringify(vaultObject))
      );

      return {
        version: 1,
        kdf: 'PBKDF2-SHA256',
        cipher: 'AES-GCM',
        iterations: 250000,
        salt: saltBase64,
        iv: bytesToBase64(iv),
        data: bytesToBase64(encrypted)
      };
    }

    async function decryptVault(encryptedVault, secret) {
      const key = await deriveAesKey(secret, encryptedVault.salt);
      const iv = base64ToBytes(encryptedVault.iv);
      const encryptedData = base64ToBytes(encryptedVault.data);

      const decrypted = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv },
        key,
        encryptedData
      );

      return JSON.parse(new TextDecoder().decode(decrypted));
    }

    function generateRealEvmWallet() {
      const wallet = ethers.Wallet.createRandom();

      return {
        type: 'evm',
        standard: 'BIP39',
        phrase: wallet.mnemonic.phrase,
        privateKey: wallet.privateKey,
        address: wallet.address,
        networks: Object.values(NETWORKS).map(n => n.name),
        createdAt: new Date().toISOString()
      };
    }

    async function saveEncryptedWalletToServer(encryptedVault, wallets) {
      const response = await fetch('/api/wallet/vault', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ encryptedVault, publicWallets: wallets })
      });

      if (!response.ok) throw new Error('Unable to save encrypted wallet');
      return response.json();
    }

    async function createNewRealWalletForAccount() {
      const passcode = prompt('Create a wallet encryption passcode. Use at least 8 characters.');
      if (!passcode || passcode.length < 8) return toast('Passcode must be at least 8 characters');

      const confirmed = confirm(
        'This creates a real wallet. Save your seed phrase. If you lose your passcode and seed phrase, funds cannot be recovered. Continue?'
      );

      if (!confirmed) return;

      const realWallet = generateRealEvmWallet();

      const vaultObject = {
        wallets: [realWallet],
        createdAt: new Date().toISOString()
      };

      const secret = `${CURRENT_EMAIL}:${passcode}`;
      const encryptedVault = await encryptVault(vaultObject, secret);

      const publicWallets = [{
        type: 'evm',
        address: realWallet.address,
        networks: realWallet.networks,
        createdAt: realWallet.createdAt
      }];

      await saveEncryptedWalletToServer(encryptedVault, publicWallets);

      localStorage.setItem('bluecrypto_public_wallets', JSON.stringify(publicWallets));

      ACTIVE_DECRYPTED_WALLET = vaultObject;
      activeProvider = getProvider();
      activeSigner = new ethers.Wallet(realWallet.privateKey, activeProvider);

      toast('Wallet created and encrypted');
      updateWalletUi();
      refreshBalances();
    }

    async function unlockExistingWallet() {
      if (!SERVER_WALLET || !SERVER_WALLET.encryptedVault) {
        toast('No encrypted wallet exists yet');
        return null;
      }

      const passcode = prompt('Enter your wallet encryption passcode');
      if (!passcode) return null;

      try {
        const secret = `${CURRENT_EMAIL}:${passcode}`;
        ACTIVE_DECRYPTED_WALLET = await decryptVault(SERVER_WALLET.encryptedVault, secret);

        activeProvider = getProvider();
        activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey, activeProvider);

        toast('Wallet unlocked');
        updateWalletUi();
        refreshBalances();

        return ACTIVE_DECRYPTED_WALLET;
      } catch (error) {
        console.error(error);
        toast('Wrong passcode or corrupted wallet vault');
        return null;
      }
    }

    async function revealSecretPhrase() {
      const unlocked = ACTIVE_DECRYPTED_WALLET || await unlockExistingWallet();
      if (!unlocked) return;

      const firstWallet = unlocked.wallets.find(w => w.type === 'evm');
      if (!firstWallet) return toast('No EVM wallet found');

      const confirmed = confirm('Your seed phrase controls real funds. Never share it. Show it now?');
      if (!confirmed) return;

      alert(`Seed phrase:\n\n${firstWallet.phrase}`);
    }

    async function revealPrivateKey() {
      const unlocked = ACTIVE_DECRYPTED_WALLET || await unlockExistingWallet();
      if (!unlocked) return;

      const firstWallet = unlocked.wallets.find(w => w.type === 'evm');
      if (!firstWallet) return toast('No EVM wallet found');

      const confirmed = confirm('Your private key controls real funds. Never share it. Show it now?');
      if (!confirmed) return;

      alert(`Private key:\n\n${firstWallet.privateKey}`);
    }

    function initializeFromServer() {
      if (SERVER_WALLET?.publicWallets) {
        localStorage.setItem('bluecrypto_public_wallets', JSON.stringify(SERVER_WALLET.publicWallets));
      }

      activeProvider = getProvider();
      updateWalletUi();
      refreshBalances();

      if (!SERVER_WALLET?.encryptedVault) {
        setTimeout(() => {
          const make = confirm('No real wallet exists for this account yet. Create one now?');
          if (make) createNewRealWalletForAccount();
        }, 600);
      }
    }

    window.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeSettings();
        document.querySelectorAll('.modal-overlay.active').forEach(el => el.classList.remove('active'));
      }
    });

    document.documentElement.setAttribute('data-theme', localStorage.getItem('blue_wallet_theme') || 'light');

    renderNetworks();
    renderSendAssets();
    initializeFromServer();
  </script>
</body>
</html>