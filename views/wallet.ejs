                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>
                    <path d="M12 8v4"/>
                    <path d="M12 16h.01"/>
                  </svg>
                </span>
                Wallet Seeds
              </div>
              <div class="section-sub">Demo seed display. Never expose real seed phrases in production.</div>
            </div>
          </div>

          <div class="form-grid">
            <div class="field">
              <label>Normal Crypto Wallet Seed</label>
              <div class="seed-box" id="normalSeedBox">—</div>
              <button class="mini-btn" onclick="toggleSeedBlur('normalSeedBox')">Reveal / Hide</button>
            </div>

            <div class="field">
              <label>Tensor Wallet Seed</label>
              <div class="seed-box" id="tensorSeedBox">—</div>
