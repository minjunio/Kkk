          </div>
          
          <div class="name" id="receiveTitle" style="margin-bottom:12px; font-size:1.1rem;">Select Asset</div>

          <div class="receive-address-box">
            <input id="receiveAddressInput" readonly onclick="this.select(); copyReceiveAddress();" />
