<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blue API Wallet</title>
    <style>
        :root {
            --bg-main: #0b0e14;
            --bg-card: #151a27;
            --bg-modal: rgba(11, 14, 20, 0.85);
            --primary-blue: #2563eb;
            --primary-blue-glow: rgba(37, 99, 235, 0.4);
            --text-main: #ffffff;
            --text-muted: #94a3b8;
            --success: #10b981;
            --danger: #ef4444;
            --border-radius: 16px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body { background-color: var(--bg-main); color: var(--text-main); display: flex; justify-content: center; min-height: 100vh; }

        .app-container { width: 100%; max-width: 600px; padding: 24px; display: flex; flex-direction: column; gap: 24px; }

        header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
        .brand h1 { font-size: 1.2rem; color: var(--text-muted); font-weight: 500; }
        .welcome-msg { font-size: 1.1rem; font-weight: 600; background: linear-gradient(90deg, #60a5fa, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        .portfolio-card {
            background: linear-gradient(145deg, var(--bg-card) 0%, #1a2235 100%);
            padding: 32px 24px;
            border-radius: var(--border-radius);
            text-align: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2), 0 0 20px var(--primary-blue-glow);
            border: 1px solid rgba(59, 130, 246, 0.2);
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            user-select: none;
            position: relative;
        }
        .portfolio-card:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3), 0 0 30px var(--primary-blue-glow); }
        .portfolio-card .label { color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
        .portfolio-card .balance { font-size: 3rem; font-weight: 700; margin-bottom: 12px; transition: color 0.3s ease; }
        .portfolio-card .hint { font-size: 0.8rem; color: var(--primary-blue); opacity: 0.8; }
        
        .live-indicator {
            position: absolute;
            top: 16px;
            right: 16px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            color: var(--success);
        }
        .live-dot { width: 8px; height: 8px; background-color: var(--success); border-radius: 50%; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.2); } 100% { opacity: 1; transform: scale(1); } }

        .assets-section h3 { font-size: 1.1rem; margin-bottom: 16px; color: var(--text-muted); }
        .asset-list { display: flex; flex-direction: column; gap: 12px; }
        
        .asset-item {
            background-color: var(--bg-card);
            padding: 16px;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid rgba(255, 255, 255, 0.03);
        }
        .asset-info { display: flex; align-items: center; gap: 16px; }
        .asset-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 4px;
        }
        .asset-icon img { width: 100%; height: 100%; object-fit: contain; }
        
        .asset-details h4 { font-size: 1.1rem; }
        .asset-details p { font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; }
        .asset-value { text-align: right; }
        .asset-value h4 { font-size: 1.1rem; }
        
        .price-change { font-size: 0.85rem; margin-top: 4px; color: var(--text-muted); }
        
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: var(--bg-modal);
            backdrop-filter: blur(5px); display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.3s ease; z-index: 1000;
        }
        .modal-overlay.active { opacity: 1; pointer-events: all; }
        .modal-content {
            background-color: var(--bg-card); padding: 32px; border-radius: var(--border-radius);
            width: 90%; max-width: 400px; border: 1px solid rgba(255, 255, 255, 0.1);
            transform: translateY(20px); transition: transform 0.3s ease; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }
        .modal-overlay.active .modal-content { transform: translateY(0); }
        .modal-content h2 { margin-bottom: 24px; font-size: 1.4rem; }
        
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-size: 0.9rem; color: var(--text-muted); }
        .form-group input { width: 100%; padding: 12px 16px; background-color: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: var(--text-main); font-size: 1rem; outline: none; }
        .form-group input:focus { border-color: var(--primary-blue); }
        #modalError { color: var(--danger); font-size: 0.85rem; margin-bottom: 16px; display: none; }
        
        .modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
        button { padding: 12px; border: none; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; color: white; transition: opacity 0.2s; }
        button:hover { opacity: 0.9; }
        .btn-add { background-color: var(--success); }
        .btn-deduct { background-color: var(--danger); }
        .btn-cancel { background-color: transparent; border: 1px solid rgba(255, 255, 255, 0.2); width: 100%; }
        
        @media (max-width: 480px) { header { flex-direction: column; align-items: flex-start; gap: 8px; } .welcome-msg { font-size: 1.5rem; } }
    </style>
</head>
<body>

    <div class="app-container">
        <header>
            <div class="brand">
                <h1>Blue API Wallet</h1>
            </div>
            <div class="welcome-msg">Welcome back, minjunio</div>
        </header>

        <main>
            <section class="portfolio-card" id="portfolioCard">
                <div class="live-indicator">
                    <div class="live-dot"></div> Live
                </div>
                <p class="label">Total Portfolio Value</p>
                <h1 class="balance" id="totalBalance">$0.00</h1>
                <p class="hint">Double-click to manage funds</p>
            </section>

            <section class="assets-section">
                <h3>Your Assets</h3>
                <div class="asset-list" id="assetList">
                    </div>
            </section>
        </main>
    </div>

    <div class="modal-overlay" id="manageModal">
        <div class="modal-content">
            <h2>Manage Portfolio</h2>
            <p id="modalError">Please fill out all fields correctly.</p>
            <div class="form-group">
                <label for="currencyInput">Asset Symbol (e.g. BTC, ETH)</label>
                <input type="text" id="currencyInput" placeholder="ETH" autocomplete="off">
            </div>
            <div class="form-group">
                <label for="amountInput">Amount of Coins</label>
                <input type="number" id="amountInput" placeholder="0.5" step="0.0001" min="0">
            </div>
            <div class="modal-actions">
                <button class="btn-add" onclick="processTransaction('add')">Add</button>
                <button class="btn-deduct" onclick="processTransaction('deduct')">Deduct</button>
            </div>
            <button class="btn-cancel" onclick="closeModal()">Cancel</button>
        </div>
    </div>

    <script>
        // Store portfolio as an array of objects. Amount is the number of coins (not USD).
        let portfolio = [
            { currency: 'ETH', amount: 0 }, 
            { currency: 'BTC', amount: 0 }
        ];
        let livePrices = {}; // Stores live prices from the API

        const portfolioCard = document.getElementById('portfolioCard');
        const manageModal = document.getElementById('manageModal');
        const currencyInput = document.getElementById('currencyInput');
        const amountInput = document.getElementById('amountInput');
        const modalError = document.getElementById('modalError');

        portfolioCard.addEventListener('dblclick', openModal);
        function openModal() {
            manageModal.classList.add('active');
            currencyInput.value = ''; amountInput.value = ''; modalError.style.display = 'none';
            currencyInput.focus();
        }
        function closeModal() { manageModal.classList.remove('active'); }
        manageModal.addEventListener('click', (e) => { if (e.target === manageModal) closeModal(); });

        function processTransaction(type) {
            const currency = currencyInput.value.trim().toUpperCase();
            const amount = parseFloat(amountInput.value);

            if (!currency || isNaN(amount) || amount <= 0) {
                modalError.style.display = 'block';
                return;
            }

            let assetIndex = portfolio.findIndex(a => a.currency === currency);

            if (type === 'add') {
                if (assetIndex >= 0) portfolio[assetIndex].amount += amount;
                else portfolio.push({ currency, amount });
            } else if (type === 'deduct') {
                if (assetIndex >= 0) {
                    portfolio[assetIndex].amount -= amount;
                    if (portfolio[assetIndex].amount <= 0) portfolio.splice(assetIndex, 1);
                } else {
                    modalError.innerText = "Cannot deduct an asset you don't own.";
                    modalError.style.display = 'block';
                    return;
                }
            }
            
            // Force an immediate price fetch to catch the new coin
            fetchLivePrices(); 
            closeModal();
        }

        // Live Price Fetching (CryptoCompare Fast API)
        async function fetchLivePrices() {
            if (portfolio.length === 0) {
                updateUI();
                return;
            }

            // Extract all symbols from portfolio
            const symbols = portfolio.map(a => a.currency).join(',');
            
            try {
                const response = await fetch(`https://min-api.cryptocompare.com/data/pricemulti?fsyms=${symbols}&tsyms=USD`);
                const data = await response.json();
                
                // Map API data to our livePrices object
                portfolio.forEach(asset => {
                    if (data[asset.currency] && data[asset.currency].USD) {
                        livePrices[asset.currency] = data[asset.currency].USD;
                    }
                });
                
                updateUI();
            } catch (error) {
                console.error("Error fetching live prices:", error);
            }
        }

        // Generate high quality icons using CoinCap API, fallback to default generic icon
        function getIconUrl(symbol) {
            return `https://assets.coincap.io/assets/icons/${symbol.toLowerCase()}@2x.png`;
        }

        function updateUI() {
            let totalValue = 0;
            const assetListEl = document.getElementById('assetList');
            assetListEl.innerHTML = '';
            
            if (portfolio.length === 0) {
                document.getElementById('totalBalance').innerText = '$0.00';
                assetListEl.innerHTML = '<p style="color: var(--text-muted); text-align: center; padding: 20px 0;">No assets found. Double-click portfolio to add.</p>';
                return;
            }

            portfolio.forEach(asset => {
                const currentPrice = livePrices[asset.currency] || 0;
                const assetUsdValue = asset.amount * currentPrice;
                totalValue += assetUsdValue;

                const formattedUsdValue = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(assetUsdValue);
                const formattedPrice = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(currentPrice);

                const assetHtml = `
                    <div class="asset-item">
                        <div class="asset-info">
                            <div class="asset-icon">
                                <img src="${getIconUrl(asset.currency)}" onerror="this.style.display='none'">
                            </div>
                            <div class="asset-details">
                                <h4>${asset.currency}</h4>
                                <p>${asset.amount} Coins</p>
                            </div>
                        </div>
                        <div class="asset-value">
                            <h4>${formattedUsdValue}</h4>
                            <div class="price-change">@ ${formattedPrice}</div>
                        </div>
                    </div>
                `;
                assetListEl.insertAdjacentHTML('beforeend', assetHtml);
            });

            // Update Total Header
            document.getElementById('totalBalance').innerText = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD'
            }).format(totalValue);
        }

        // Fetch prices immediately on load, then every 3 seconds
        fetchLivePrices();
        setInterval(fetchLivePrices, 3000);

    </script>
</body>
</html>
