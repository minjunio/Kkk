    async function getSwapQuote() {
      try {
        const signer = await ensureUnlocked();
        const sellToken = document.getElementById('swapSellSelect').value;
        const buyTokenRaw = document.getElementById('swapBuyToken').value.trim();
        const amount = document.getElementById('swapAmount').value.trim();

        if (!buyTokenRaw) throw new Error('Enter buy token contract address');
        if (!amount || Number(amount) <= 0) throw new Error('Invalid amount');

        const sellTokenMeta = sellToken === NATIVE_TOKEN ? null : getTokenByAddress(sellToken);
        const decimals = sellToken === NATIVE_TOKEN ? 18 : sellTokenMeta.decimals;
        const sellAmount = ethers.parseUnits(amount, decimals).toString();

        const response = await fetch('/api/swap/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            chainId: NETWORKS[activeNetworkKey].chainId,
            network: activeNetworkKey,
            taker: await signer.getAddress(),
            sellToken,
            buyToken: buyTokenRaw,
            sellAmount
          })
        });

        if (!response.ok) throw new Error('Swap quote failed. Add /api/swap/quote on server.');

        const quote = await response.json();
        window.__BLUE_SWAP_QUOTE = quote;

        document.getElementById('swapQuoteText').textContent =
          `Quote loaded. Estimated gas: ${quote.gas || 'N/A'}. Review before swapping.`;

        toast('Swap quote loaded');
