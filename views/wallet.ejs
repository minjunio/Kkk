<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Tensor Wallet | Ecosystem</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lightweight-charts/dist/lightweight-charts.standalone.production.js"></script>

  <style>
    :root {
      color-scheme: light;
      --bg1: #e9f8ff; --bg2: #f8fcff; --bg3: #d7f0ff;
      --glass: rgba(255,255,255,0.85); --glass2: rgba(255,255,255,0.7);
      --solid: #ffffff; --soft: #f0f7ff; --soft-hover: #e0f0ff;
      --text: #0f172a; --muted: #64748b; --muted2: #94a3b8;
      --blue: #0284c7; --blue2: #2563eb; --cyan: #38bdf8;
      --pink: #e11d48; --orange: #d97706; --green: #10b981;
      --tensor: #8b5cf6; --tensor2: #d946ef; 
      --border: rgba(2,132,199,0.12); --border2: rgba(2,132,199,0.35);
      --shadow: 0 24px 64px rgba(37,99,235,0.12); --shadow2: 0 12px 32px rgba(2,132,199,0.08);
      --safe-top: env(safe-area-inset-top); --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg1: #06111f; --bg2: #050816; --bg3: #0a2942;
      --glass: rgba(13,22,40,0.88); --glass2: rgba(17,29,51,0.72);
      --solid: #0d1628; --soft: #111d33; --soft-hover: #1e293b;
      --text: #f8fafc; --muted: #94a3b8; --muted2: #64748b;
      --blue: #38bdf8; --tensor: #a78bfa; --tensor2: #e879f9;
      --border: rgba(125,211,252,0.16); --border2: rgba(56,189,248,0.36);
      --shadow: 0 28px 86px rgba(0,0,0,0.5); --shadow2: 0 14px 38px rgba(0,0,0,0.3);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: Inter, system-ui, sans-serif; -webkit-tap-highlight-color: transparent; }
    html, body { width: 100%; min-height: 100vh; overflow-x: hidden; scroll-behavior: smooth; }
    body {
      color: var(--text);
      background: radial-gradient(circle at 10% 0%, rgba(56,189,248,0.25), transparent 35%), radial-gradient(circle at 90% 15%, rgba(37,99,235,0.15), transparent 30%), radial-gradient(circle at 50% 100%, rgba(14,165,233,0.2), transparent 40%), linear-gradient(135deg, var(--bg1), var(--bg2) 50%, var(--bg3));
      background-attachment: fixed; padding-bottom: calc(92px + var(--safe-bottom)); -webkit-font-smoothing: antialiased;
    }
    button, input, select, textarea { font: inherit; outline: none; border: none; background: transparent; }
    button { cursor: pointer; transition: transform 0.1s ease, filter 0.1s ease; }
    button:active { transform: scale(0.97); filter: brightness(0.95); }

    .topbar { position: sticky; top: 0; z-index: 50; padding: calc(10px + var(--safe-top)) 12px 10px; background: rgba(248,251,255,0.7); border-bottom: 1px solid var(--border); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); }
    [data-theme="dark"] .topbar { background: rgba(5,8,22,0.8); }
    .topbar-inner { width: min(980px, 100%); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; }
    .logo { width: 46px; height: 46px; border-radius: 18px; display: grid; place-items: center; color: white; font-weight: 900; font-size: 1.2rem; background: linear-gradient(135deg, var(--tensor), var(--tensor2)); box-shadow: 0 12px 28px rgba(139,92,246,0.25); }
    .brand-title { font-weight: 900; letter-spacing: -0.04em; font-size: 1.1rem; }
    .brand-sub { color: var(--muted); font-size: 0.75rem; font-weight: 700; margin-top: 2px; }
    .top-actions { display: flex; gap: 8px; }
    .icon-btn { width: 44px; height: 44px; border-radius: 16px; background: var(--glass); border: 1px solid var(--border); color: var(--text); box-shadow: var(--shadow2); backdrop-filter: blur(16px); font-weight: 900; display: grid; place-items: center; }

    .shell { width: min(980px, 100%); margin: 0 auto; padding: 12px; }
    .hero { position: relative; overflow: hidden; border-radius: 32px; padding: 32px 24px; background: var(--glass); border: 1px solid var(--border); box-shadow: var(--shadow); backdrop-filter: blur(32px); text-align: center; }
    
    .badge { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 99px; color: var(--tensor); background: rgba(139,92,246,0.1); border: 1px solid var(--tensor); font-size: 0.75rem; font-weight: 800; margin-bottom: 16px; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--tensor); animation: pulse 2s infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(139,92,246,0.5); } 70% { box-shadow: 0 0 0 8px rgba(139,92,246,0); } 100% { box-shadow: 0 0 0 0 rgba(139,92,246,0); } }
    
    .portfolio-overview { margin-bottom: 24px; }
    .balance { font-size: clamp(3rem, 12vw, 5.5rem); font-weight: 900; line-height: 1; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }

    .pnl-line { margin-top: 16px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 99px; background: var(--glass2); border: 1px solid var(--border); color: var(--muted); font-weight: 800; font-size: 0.9rem; }
    .pnl-line.up { color: var(--green); background: rgba(16,185,129,0.08); border-color: rgba(16,185,129,0.2); }
    .pnl-line.down { color: var(--pink); background: rgba(225,29,72,0.08); border-color: rgba(225,29,72,0.2); }
    
    .flash-up { color: var(--green) !important; text-shadow: 0 0 8px rgba(16,185,129,0.4); transition: 0.1s; }
    .flash-down { color: var(--pink) !important; text-shadow: 0 0 8px rgba(225,29,72,0.4); transition: 0.1s; }
    
    .quick { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 24px; }
    .quick-btn { min-height: 76px; border-radius: 24px; padding: 12px; text-align: center; color: var(--text); background: var(--solid); border: 1px solid var(--border); box-shadow: var(--shadow2); display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .quick-btn.primary { color: white; background: linear-gradient(135deg, var(--blue2), var(--cyan)); border: none; box-shadow: 0 16px 32px rgba(37,99,235,0.25); }
    .quick-btn.tensor-btn { color: white; background: linear-gradient(135deg, var(--tensor), var(--tensor2)); border: none; box-shadow: 0 16px 32px rgba(139,92,246,0.25); }
    .quick-btn strong { font-size: 0.95rem; font-weight: 900; margin-bottom: 4px; }
    .quick-btn span { color: var(--muted); font-size: 0.7rem; font-weight: 700; }
    .quick-btn.primary span, .quick-btn.tensor-btn span { color: rgba(255,255,255,0.9); }

    .panel { margin-top: 14px; border-radius: 28px; padding: 20px; background: var(--glass); border: 1px solid var(--border); box-shadow: var(--shadow2); backdrop-filter: blur(24px); }
    .panel.tensor-panel { border-color: rgba(139,92,246,0.3); background: linear-gradient(180deg, rgba(139,92,246,0.05), var(--glass)); }
    .panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .title { font-size: 1.25rem; font-weight: 900; letter-spacing: -0.03em; }

    .asset-scroll { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-bottom: 6px; }
    .asset-scroll::-webkit-scrollbar { display: none; }
    
    .asset-card { flex: 0 0 190px; scroll-snap-align: start; border-radius: 24px; padding: 16px; background: var(--glass2); border: 1px solid var(--border); color: var(--text); text-align: left; box-shadow: var(--shadow2); transition: 0.15s ease; position: relative; cursor: pointer; }
    .asset-card:hover { border-color: var(--cyan); }
    .asset-card:active { transform: scale(0.97); }
    .asset-card.tensor { border-color: rgba(139,92,246,0.4); background: rgba(139,92,246,0.05); }
    .asset-card.tensor:hover { border-color: var(--tensor); }
    .asset-card.watch { background: linear-gradient(180deg, var(--glass2), rgba(255,255,255,0.3)); }

    .asset-top { display: flex; align-items: center; gap: 12px; }
    .coin { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--solid); border: 1px solid var(--border); color: var(--blue); font-weight: 900; font-size: 0.75rem; flex-shrink: 0; padding: 4px; overflow: hidden; }
    .coin.tensor-coin { border: none; background: transparent; padding: 0; }
    .coin.tensor-coin svg { width: 44px; height: 44px; }
    .coin img { width: 100%; height: 100%; object-fit: contain; }

    .name { font-weight: 900; font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tiny { color: var(--muted); font-size: 0.75rem; font-weight: 700; margin-top: 2px; }
    .asset-value { margin-top: 14px; font-size: 1.25rem; font-weight: 900; font-variant-numeric: tabular-nums; }
    .asset-sub { margin-top: 6px; color: var(--muted); font-size: 0.75rem; font-weight: 700; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }

    .small-btn { height: 38px; padding: 0 14px; font-size: 0.85rem; border-radius: 16px; font-weight: 800; background: var(--solid); border: 1px solid var(--border); color: var(--text); }
    .primary-btn { width: 100%; height: 52px; border-radius: 20px; font-size: 0.95rem; font-weight: 900; color: white; background: linear-gradient(135deg, var(--blue2), var(--cyan)); box-shadow: 0 12px 24px rgba(37,99,235,0.25); }
    .tensor-primary-btn { width: 100%; height: 52px; border-radius: 20px; font-size: 0.95rem; font-weight: 900; color: white; background: linear-gradient(135deg, var(--tensor), var(--tensor2)); box-shadow: 0 12px 24px rgba(139,92,246,0.25); }
    .secondary-btn { width: 100%; height: 52px; border-radius: 20px; font-size: 0.95rem; font-weight: 800; background: var(--solid); border: 1px solid var(--border); color: var(--text); }

    .form { display: grid; gap: 16px; }
    .field { display: grid; gap: 8px; }
    label { color: var(--muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }

    .input, .select { width: 100%; height: 54px; padding: 0 16px; border-radius: 18px; background: var(--soft); border: 1px solid var(--border); color: var(--text); font-weight: 800; font-size: 0.95rem; transition: border-color 0.2s; }
    .input:focus, .select:focus { border-color: var(--cyan); }
    .select { appearance: none; background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e"); background-repeat: no-repeat; background-position: right 16px center; background-size: 18px; padding-right: 48px; }

    .box { padding: 18px; border-radius: 24px; background: var(--glass2); border: 1px solid var(--border); }
    .box.tensor { background: rgba(139,92,246,0.05); border-color: rgba(139,92,246,0.2); }
    .box.bad { color: var(--pink); background: rgba(225,29,72,0.06); border-color: rgba(225,29,72,0.15); }

    .defi-input-wrap { display: flex; align-items: center; justify-content: space-between; background: var(--soft); border-radius: 20px; padding: 12px 16px; border: 1px solid var(--border); transition: 0.2s; }
    .defi-input-wrap:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); background: var(--solid); }
    .defi-input-wrap.tensor-focus:focus-within { border-color: var(--tensor); box-shadow: 0 0 0 3px rgba(139,92,246,0.1); }
    .defi-amount { flex: 1; font-size: 1.8rem; font-weight: 900; background: transparent; color: var(--text); padding: 0; outline: none; border: none; font-variant-numeric: tabular-nums; width: 100%; }
    .defi-amount::placeholder { color: var(--muted2); }

    .pill-toggle { display: flex; background: var(--soft); border-radius: 99px; padding: 6px; border: 1px solid var(--border); }
    .pill-toggle button { flex: 1; height: 42px; border-radius: 99px; font-size: 0.95rem; font-weight: 800; color: var(--muted); transition: 0.2s; }
    .pill-toggle button.active { background: var(--solid); color: var(--text); box-shadow: var(--shadow2); border: 1px solid var(--border); }

    .modal-overlay, .drawer-overlay { position: fixed; inset: 0; z-index: 100; display: none; background: rgba(15,23,42,0.5); backdrop-filter: blur(16px); padding: 16px; overflow-y: auto; }
    .modal-overlay.active, .drawer-overlay.active { display: block; }
    .modal-card { width: min(500px, 100%); margin: calc(12px + var(--safe-top)) auto 20px auto; padding: 28px; border-radius: 36px; background: rgba(255,255,255,0.95); border: 1px solid var(--border); box-shadow: 0 32px 80px rgba(0,0,0,0.1); backdrop-filter: blur(40px); animation: pop 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.1) both; }
    [data-theme="dark"] .modal-card { background: rgba(13,22,40,0.95); box-shadow: 0 32px 80px rgba(0,0,0,0.4); }
    
    .drawer { position: absolute; top: 0; right: 0; width: min(440px, 100%); height: 100%; overflow-y: auto; padding: calc(24px + var(--safe-top)) 24px calc(24px + var(--safe-bottom)); background: var(--solid); border-left: 1px solid var(--border); box-shadow: -20px 0 80px rgba(0,0,0,0.2); animation: slide 0.25s ease both; }

    @keyframes pop { from { transform: translateY(20px) scale(0.95); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }
    @keyframes slide { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    .modal-head, .drawer-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .modal-title, .drawer-title { font-size: 1.4rem; font-weight: 900; letter-spacing: -0.04em; }
    .close { width: 44px; height: 44px; border-radius: 18px; background: var(--soft); border: 1px solid var(--border); font-size: 1.4rem; font-weight: 900; color: var(--text); display:grid; place-items:center; }

    .toast { position: fixed; left: 50%; bottom: calc(100px + var(--safe-bottom)); transform: translateX(-50%) translateY(20px); z-index: 150; padding: 14px 24px; border-radius: 20px; background: rgba(15,23,42,0.95); color: white; font-weight: 800; font-size: 0.9rem; box-shadow: 0 16px 32px rgba(0,0,0,0.3); opacity: 0; pointer-events: none; transition: all 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1); white-space:nowrap; }
    .toast.active { opacity: 1; transform: translateX(-50%) translateY(0); }

    .bottom-nav { position: fixed; left: 50%; bottom: calc(12px + var(--safe-bottom)); transform: translateX(-50%); z-index: 70; width: min(440px, calc(100% - 24px)); display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 8px; border-radius: 28px; background: rgba(255,255,255,0.92); border: 1px solid var(--border); box-shadow: var(--shadow); backdrop-filter: blur(24px); }
    [data-theme="dark"] .bottom-nav { background: rgba(13,22,40,0.95); }
    .bottom-nav button { min-height: 58px; border-radius: 20px; color: var(--muted); background: transparent; font-size: 0.75rem; font-weight: 800; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; }
    .bottom-nav button svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; transition:0.2s; }
    .bottom-nav button.active { color: var(--blue); background: var(--soft); box-shadow: inset 0 0 0 1px var(--border); }
    .bottom-nav button.active svg { stroke: var(--blue); }

    @media (max-width: 580px) {
      .hero { padding: 24px 20px; border-radius: 28px; }
      .balance { font-size: 3.2rem; }
      .quick { grid-template-columns: repeat(4, 1fr); gap: 6px; }
      .quick-btn { min-height: 72px; padding: 10px 4px; border-radius: 20px; }
      .quick-btn strong { font-size: 0.8rem; }
      .panel { padding: 16px; border-radius: 24px; }
      .asset-card { flex-basis: 170px; }
      .modal-card { width: 100%; border-radius: 36px 36px 0 0; margin: auto auto 0 auto; max-height: 92vh; }
      .drawer { width: 100%; }
      .defi-amount { font-size: 1.6rem; }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <div class="logo">T</div>
        <div>
          <div class="brand-title">Tensor Wallet</div>
          <div class="brand-sub" id="statusText">Connecting...</div>
        </div>
      </a>
      <div class="top-actions">
        <button class="icon-btn" onclick="openSettings()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="shell">
    <section class="hero" id="homeSection">
      <div class="badge"><span class="dot"></span><span id="walletStatusBadge">Connecting...</span></div>
      
      <div class="portfolio-overview">
        <div class="balance" id="totalUsd">$0.00</div>
        <div class="pnl-line up" id="pnlLine">Updating Portfolio...</div>
      </div>
      
      <div class="quick">
        <button class="quick-btn tensor-btn" onclick="openModal('tensorSwapModal')"><strong>Tensor</strong><span>AI Swap</span></button>
        <button class="quick-btn primary" onclick="openModal('receiveModal')"><strong>Receive</strong><span>Scan QR</span></button>
        <button class="quick-btn" onclick="openModal('sendModal')"><strong>Send</strong><span>Transfer</span></button>
        <button class="quick-btn" onclick="openModal('swapModal')"><strong>DEX</strong><span>Trade</span></button>
      </div>
    </section>

    <section class="panel" id="assetsSection">
      <div class="panel-head"><h2 class="title">Crypto Assets</h2><button class="small-btn" onclick="refreshAllBalances(true)">Sync</button></div>
      <div class="asset-scroll" id="assetCards"></div>
    </section>

    <section class="panel tensor-panel" id="tensorAssetsSection">
      <div class="panel-head"><h2 class="title" style="color:var(--tensor);">Tensor Assets (AI)</h2><button class="small-btn" style="color:var(--tensor); border-color:var(--tensor);" onclick="openModal('tensorSendModal')">Transfer</button></div>
      <div class="asset-scroll" id="tensorCards"></div>
    </section>
  </main>

  <nav class="bottom-nav">
    <button id="navHome" class="active" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); navSetActive('navHome');"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Home</button>
    <button id="navTrading" onclick="window.location.href='trading'"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg>Trading</button>
    <button id="navSettings" onclick="openSettings()"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>Settings</button>
  </nav>

  <div class="modal-overlay" id="sendModal" onclick="overlayClose(event,'sendModal')">
    <div class="modal-card">
      <div class="modal-head"><div><div class="modal-title">Send Crypto</div><div class="modal-sub">Fast & secure transfers.</div></div><button class="close" onclick="closeModal('sendModal')"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></div>
      <div class="form">
        <div class="field">
          <label>Select Asset</label>
          <select class="select" id="sendAssetSelect" onchange="updateSendMaxBalance()"></select>
        </div>
        
        <div class="box">
          <div style="display:flex; justify-content:space-between; margin-bottom:12px;">
            <label>Amount</label>
            <div class="tiny" id="sendBalanceText">0.00 available</div>
          </div>
          <div class="defi-input-wrap">
            <input class="defi-amount" id="sendAmountInput" type="number" step="any" placeholder="0" />
            <button class="small-btn" style="height:32px; padding:0 12px; font-size:0.8rem; border-color:var(--blue); color:var(--blue);" onclick="setMaxSend()">MAX</button>
          </div>
        </div>
        
        <div class="field">
          <label>Recipient Address</label>
          <input class="input" id="sendToInput" placeholder="0x... or Address" autocomplete="off" />
        </div>
        
        <button class="primary-btn" onclick="executeCryptoSend()" style="height:56px;">Confirm Send</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="tensorSendModal" onclick="overlayClose(event,'tensorSendModal')">
    <div class="modal-card" style="border-color:var(--tensor);">
      <div class="modal-head"><div><div class="modal-title" style="color:var(--tensor);">Send AI Token</div><div class="modal-sub">Transfer via T0x network.</div></div><button class="close" onclick="closeModal('tensorSendModal')"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></div>
      <div class="form">
        <div class="field"><label>Asset</label><select class="select" id="tenSendSelect" onchange="updateTenSendBal()"></select></div>
        <div class="box tensor">
          <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
            <label>Amount</label>
            <div class="tiny" id="tenSendBalTxt" style="color:var(--tensor);">0.00 available</div>
          </div>
          <div class="defi-input-wrap tensor-focus">
            <input class="defi-amount" id="tenSendAmt" type="number" step="any" placeholder="0" />
            <button class="small-btn" style="height:32px; padding:0 12px; font-size:0.8rem; border-color:var(--tensor); color:var(--tensor);" onclick="maxTenSend()">MAX</button>
          </div>
        </div>
        <div class="field"><label>Recipient Address (T0x...)</label><input class="input" id="tenSendTo" placeholder="T0x..." /></div>
        <button class="tensor-primary-btn" style="height:56px;" onclick="executeTensorSend()">Send AI Token</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="receiveModal" onclick="overlayClose(event,'receiveModal')">
    <div class="modal-card">
      <div class="modal-head"><div><div class="modal-title">Receive</div><div class="modal-sub">Select network and asset.</div></div><button class="close" onclick="closeModal('receiveModal')"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></div>
      <div class="form">
        <div class="pill-toggle">
          <button id="btnRecCrypto" class="active" onclick="switchRecMode('crypto')">Standard Crypto</button>
          <button id="btnRecTensor" onclick="switchRecMode('tensor')">Tensor (AI) Network</button>
        </div>
        <input type="hidden" id="receiveGroupSelect" value="crypto" />

        <div class="field" id="recNetWrap"><label>Network Chain</label><select class="select" id="receiveNetworkSelect" onchange="renderReceiveAssets()"></select></div>
        
        <div class="box" style="text-align:center; padding:32px 24px;">
          <div style="background:white; display:inline-block; padding:12px; border-radius:24px; margin-bottom:20px; box-shadow:var(--shadow2);"><div id="qrBox"></div></div>
          <div style="display:flex; align-items:center; background:var(--solid); border:1px solid var(--border); border-radius:18px; padding:6px 6px 6px 16px;">
             <input id="receiveAddressInput" readonly onclick="this.select(); copyReceiveAddress();" style="flex:1; font-size:0.95rem; font-family:monospace; color:var(--text); background:transparent; border:none; outline:none;" />
             <button class="icon-btn" style="width:40px; height:40px; background:var(--blue); color:white; border:none; border-radius:14px; flex-shrink:0;" id="copyAddrBtn" onclick="copyReceiveAddress()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="tensorSwapModal" onclick="overlayClose(event,'tensorSwapModal')">
    <div class="modal-card" style="border-color:var(--tensor);">
      <div class="modal-head"><div><div class="modal-title" style="color:var(--tensor);">Tensor Swap</div><div class="modal-sub">Acquire AI tokens via USDT.</div></div><button class="close" onclick="closeModal('tensorSwapModal')"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></div>
      <div class="form">
        <div class="box tensor">
          <div style="display:flex; justify-content:space-between; margin-bottom:12px;">
            <label>You Pay</label><div class="tiny" id="tenSwapUsdtBal">0.00 available</div>
          </div>
          <div class="defi-input-wrap tensor-focus">
            <input class="defi-amount" id="tenSwapAmountIn" type="number" step="any" placeholder="0" oninput="calcTensorOutput()" />
            <div style="background:var(--solid); border:1px solid var(--border); border-radius:99px; padding:8px 14px; font-weight:800; font-size:0.95rem; display:flex; align-items:center; gap:8px;">USDT</div>
          </div>
        </div>
        
        <div class="box tensor" style="background:rgba(139,92,246,0.03);">
          <label style="margin-bottom:12px; display:block;">You Receive</label>
          <div class="defi-input-wrap tensor-focus" style="background:transparent; border-color:transparent; padding:0;">
             <input class="defi-amount" id="tenSwapReceiveTxt" type="text" readonly placeholder="0" style="color:var(--tensor);" />
             <select class="select" id="tenSwapSelectOut" onchange="calcTensorOutput()" style="width:auto; height:48px; padding:0 36px 0 16px; border-radius:99px; background-color:var(--solid); box-shadow:var(--shadow2);"></select>
          </div>
        </div>
        <button class="tensor-primary-btn" style="height:60px; font-size:1.1rem;" onclick="executeTensorSwap()">Execute Swap</button>
      </div>
    </div>
  </div>

  <div class="drawer-overlay" id="settingsOverlay" onclick="overlayClose(event,'settingsOverlay')">
    <aside class="drawer">
      <div class="drawer-head"><div><div class="drawer-title">Settings</div><div class="drawer-sub">Preferences and security.</div></div><button class="close" onclick="closeSettings()"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></div>
      <div class="form">
        <div class="box"><div class="name">Web3 Address</div><div class="tiny" id="settingsAddress" style="font-family:monospace; margin-top:6px; font-size:0.85rem; word-break:break-all;">Loading...</div></div>
        <div class="box tensor"><div class="name" style="color:var(--tensor);">Tensor Address (T0x)</div><div class="tiny" id="settingsTensorAddress" style="font-family:monospace; margin-top:6px; font-size:0.85rem; word-break:break-all;">Loading...</div></div>
        
        <div class="field" style="margin-top:16px;"><label>Display currency</label><select class="select" id="currencySelect" onchange="setDisplayCurrency(this.value)"><option value="USD">USD</option><option value="AED">AED</option><option value="EUR">EUR</option><option value="GBP">GBP</option><option value="SAR">SAR</option></select></div>
        <div class="field"><label>Theme</label><div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;"><button class="secondary-btn" style="height:48px;" onclick="setTheme('light')">Light</button><button class="secondary-btn" style="height:48px;" onclick="setTheme('dark')">Dark</button></div></div>
        
        <form action="/logout" method="POST" style="margin-top:24px;"><button class="secondary-btn" style="height:48px; border-color:var(--pink); color:var(--pink);" type="submit">Secure Logout</button></form>
      </div>
    </aside>
  </div>

  <div class="toast" id="toast"></div>

  <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.5/dist/ethers.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>

  <script>
    const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
    const CURRENT_EMAIL = "<%= typeof email !== 'undefined' ? email : '' %>";
    const USER_ROLE = "<%= typeof role !== 'undefined' ? role : 'user' %>";
    const IS_ADMIN = USER_ROLE === 'staff';

    const DISPLAY_RATES = { USD:{symbol:'$',rate:1}, AED:{symbol:'AED ',rate:3.6725}, EUR:{symbol:'€',rate:.92}, GBP:{symbol:'£',rate:.79}, SAR:{symbol:'SAR ',rate:3.75} };
    
    const NETWORKS = { 
      ethereum:{name:'Ethereum',chainId:1,symbol:'ETH'}, 
      bsc:{name:'BNB Chain',chainId:56,symbol:'BNB'}, 
      polygon:{name:'Polygon',chainId:137,symbol:'MATIC'},
      bitcoin:{name:'Bitcoin Native',chainId:null,symbol:'BTC'},
      solana:{name:'Solana Native',chainId:null,symbol:'SOL'}
    };

    let displayCurrency = localStorage.getItem('blue_display_currency') || 'USD';
    let activeSigner = null, allBalances = [], combinedAssets = [], ownedPositions = [];
    let tensorAddress = "", baseTensorData = [], tensorBalances = {};
    let prices = {};
    let toastTimer;

    // Tensor Global Integration
    async function initTensor() {
      tensorAddress = SERVER_WALLET?.tensorAddress || "T0x...Loading";
      await fetchTensorData();
      setInterval(fetchTensorData, 4000); // Polling globally without cache
    }

    async function fetchTensorData() {
       try {
         const res = await fetch(`/api/tensor?_t=${Date.now()}`); // Force skip cache
         if(res.ok) {
            const data = await res.json();
            baseTensorData = data.registry || [];
            tensorAddress = data.address || tensorAddress;
            tensorBalances = data.balances || {};
            renderTensorCards();
         }
       } catch(e) { console.error('Tensor fetch failed', e); }
    }

    function renderTensorCards() {
      const box = document.getElementById('tensorCards');
      if(!baseTensorData.length) { box.innerHTML = `<div class="asset-card tensor"><div class="name">No Tensor Assets</div><div class="tiny">Admin must deploy tokens.</div></div>`; return; }
      
      let totTenUsd = 0;
      box.innerHTML = baseTensorData.map(t => {
        const bal = tensorBalances[t.id] || 0; 
        const val = bal * t.price; 
        totTenUsd += val;
        const diff = t.startPrice ? (((t.price - t.startPrice)/t.startPrice)*100) : 0;

        return `<div class="asset-card tensor">
          <div class="asset-top">
            <div class="coin tensor-coin">${t.icon}</div>
            <div style="width:calc(100% - 56px); overflow:hidden;">
              <div class="name">${t.symbol}</div>
            </div>
          </div>
          <div class="asset-value">${money(t.price)}</div>
          <div class="asset-sub">
            <span class="${diff>=0?'pnl-line up':'pnl-line down'}" style="padding:2px 8px; font-size:0.7rem; margin:0; border:none; background:transparent;">${diff>=0?'+':''}${diff.toFixed(2)}%</span>
          </div>
          <div class="tiny" style="margin-top:8px; opacity:0.8; font-size:0.7rem;">Holds: ${fmt(bal,2)} ${t.symbol}</div>
        </div>`;
      }).join('');
      
      renderTotals(totTenUsd);
    }

    // --- SWAP / SEND TENSOR ---
    function openTensorSwap() {
      const s = document.getElementById('tenSwapSelectOut');
      s.innerHTML = baseTensorData.map(t => `<option value="${t.id}">${t.symbol}</option>`).join('');
      document.getElementById('tenSwapUsdtBal').textContent = `${fmt(getUsdtBalanceTotal())} available`;
      document.getElementById('tenSwapAmountIn').value = ''; document.getElementById('tenSwapReceiveTxt').value = '';
    }

    function calcTensorOutput() {
      const amt = Number(document.getElementById('tenSwapAmountIn').value||0);
      const tId = document.getElementById('tenSwapSelectOut').value;
      const t = baseTensorData.find(x=>x.id===tId);
      if(!t || amt<=0) { document.getElementById('tenSwapReceiveTxt').value = ''; return; }
      const feeAmount = amt * 0.000001;
      const netAmount = amt - feeAmount;
      document.getElementById('tenSwapReceiveTxt').value = fmt(netAmount / t.price, 4);
    }

    async function executeTensorSwap() {
      const amt = Number(document.getElementById('tenSwapAmountIn').value||0);
      const tId = document.getElementById('tenSwapSelectOut').value;
      if(amt<=0) return toast('Invalid swap amount');
      
      toast('Processing Swap...');
      try {
        const res = await fetch('/api/tensor/swap', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tokenId: tId, usdtAmount: amt })
        });
        if(res.ok) { fetchTensorData(); closeModal('tensorSwapModal'); return toast(`Swap successful!`); }
      } catch(e) { toast('Network error'); }
    }

    function updateTenSendBal() {
      const tId = document.getElementById('tenSendSelect').value;
      document.getElementById('tenSendBalTxt').textContent = `${fmt(tensorBalances[tId] || 0)} available`;
    }
    
    function maxTenSend() { document.getElementById('tenSendAmt').value = tensorBalances[document.getElementById('tenSendSelect').value] || 0; }
    
    async function executeTensorSend() {
      const tId = document.getElementById('tenSendSelect').value; const amt = Number(document.getElementById('tenSendAmt').value);
      const to = document.getElementById('tenSendTo').value.trim();
      if(!to.startsWith('T0x') || amt<=0 || (tensorBalances[tId]||0) < amt) return toast('Invalid details or insufficient balance');
      
      toast('Processing T0x Tx...');
      try {
         const res = await fetch('/api/tensor/send', {
             method: 'POST', headers: { 'Content-Type': 'application/json' },
             body: JSON.stringify({ tokenId: tId, amount: amt, toAddress: to })
         });
         if(res.ok) { fetchTensorData(); closeModal('tensorSendModal'); return toast('AI Token Sent Successfully'); }
      } catch(e) { toast('Transfer failed.'); }
    }

    // --- STANDARD CRYPTO SWAP/SEND ---
    function populateSendAssets() {
        const select = document.getElementById('sendAssetSelect');
        select.innerHTML = ownedPositions.map(p => `<option value="${p.symbol}">${p.symbol} (${p.networkKey})</option>`).join('');
        if(ownedPositions.length === 0) select.innerHTML = '<option value="">No Assets Available</option>';
        updateSendMaxBalance();
    }

    function updateSendMaxBalance() {
        const sym = document.getElementById('sendAssetSelect').value;
        const pos = ownedPositions.find(p => p.symbol === sym);
        document.getElementById('sendBalanceText').textContent = pos ? `${fmt(pos.balance)} available` : '0.00 available';
    }

    function setMaxSend() {
        const sym = document.getElementById('sendAssetSelect').value;
        const pos = ownedPositions.find(p => p.symbol === sym);
        if(pos) document.getElementById('sendAmountInput').value = pos.balance;
    }

    async function executeCryptoSend() {
        const sym = document.getElementById('sendAssetSelect').value;
        const amt = Number(document.getElementById('sendAmountInput').value);
        const to = document.getElementById('sendToInput').value.trim();
        const pos = ownedPositions.find(p => p.symbol === sym);

        if(!pos || amt <= 0 || amt > pos.balance || !to) return toast('Invalid transfer details');

        toast('Broadcasting Transaction...');
        try {
            const res = await fetch('/api/wallet/send', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ asset: sym, network: pos.networkKey, amount: amt, toAddress: to })
            });
            if(res.ok) { 
                refreshAllBalances(true); 
                closeModal('sendModal'); 
                document.getElementById('sendAmountInput').value = '';
                document.getElementById('sendToInput').value = '';
                return toast(`Sent ${amt} ${sym} Successfully`); 
            }
        } catch(e) { toast('Transfer failed.'); }
    }

    function getUsdtBalanceTotal() {
        return ownedPositions.filter(p => p.symbol === 'USDT').reduce((acc, p) => acc + Number(p.balance), 0);
    }

    function switchRecMode(mode) {
        document.getElementById('btnRecCrypto').className = mode === 'crypto' ? 'active' : '';
        document.getElementById('btnRecTensor').className = mode === 'tensor' ? 'active' : '';
        document.getElementById('receiveGroupSelect').value = mode;
        renderReceiveAssets();
    }

    function renderReceiveAssets() {
      const g = document.getElementById('receiveGroupSelect').value;
      const nw = document.getElementById('recNetWrap');
      
      if(g === 'tensor') {
        nw.style.display = 'none'; 
        document.getElementById('receiveAddressInput').value = tensorAddress; renderQr(tensorAddress);
      } else {
        nw.style.display = 'block'; 
        const netKey = document.getElementById('receiveNetworkSelect').value || 'ethereum';
        
        let addr = IS_ADMIN ? '0xAdminDemoWallet...' : (activeSigner?.address || 'No wallet connected');
        if (netKey === 'bitcoin') addr = 'bc1q' + Array.from(crypto.getRandomValues(new Uint8Array(18))).map(b=>b.toString(16).padStart(2,'0')).join('');
        if (netKey === 'solana') addr = Array.from(crypto.getRandomValues(new Uint8Array(22))).map(b=>b.toString(36)).join('');
        
        document.getElementById('receiveAddressInput').value = addr; renderQr(addr);
      }
    }

    // HELPER FUNCTIONS
    function toast(msg) { const el = document.getElementById('toast'); el.textContent = msg; el.classList.add('active'); clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('active'), 2500); }
    function money(val) { const cfg = DISPLAY_RATES[displayCurrency] || DISPLAY_RATES.USD; return `${cfg.symbol}${(Number(val||0) * cfg.rate).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`; }
    function fmt(val, dec=6) { return Number(val||0).toLocaleString(undefined,{maximumFractionDigits:dec}); }
    function icon(sym) { return `<div class="coin"><img src="https://assets.coincap.io/assets/icons/${String(sym).toLowerCase()}@2x.png" onerror="this.remove();this.parentNode.textContent='${String(sym).slice(0,4)}'" /></div>`; }

    function openModal(id) { 
        document.getElementById(id).classList.add('active'); 
        if(id==='tensorSwapModal') openTensorSwap(); 
        if(id==='tensorSendModal') { document.getElementById('tenSendSelect').innerHTML = baseTensorData.map(t=>`<option value="${t.id}">${t.symbol}</option>`).join(''); updateTenSendBal(); } 
        if(id==='receiveModal') renderReceiveAssets(); 
        if(id==='sendModal') populateSendAssets();
    }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }
    function overlayClose(e,id) { if(e.target.id === id) closeModal(id); }
    function navSetActive(id) { document.querySelectorAll('.bottom-nav button').forEach(b=>b.classList.remove('active')); document.getElementById(id)?.classList.add('active'); }
    
    function openSettings() { document.getElementById('settingsOverlay').classList.add('active'); document.getElementById('settingsAddress').textContent = IS_ADMIN ? "0xAdminDemo..." : (activeSigner ? activeSigner.address : "Loading..."); document.getElementById('settingsTensorAddress').textContent = tensorAddress; navSetActive('navSettings'); }
    function closeSettings() { document.getElementById('settingsOverlay').classList.remove('active'); navSetActive('navHome'); }
    function setTheme(t) { document.documentElement.setAttribute('data-theme',t); localStorage.setItem('blue_theme',t); }
    function setDisplayCurrency(c) { displayCurrency = c; localStorage.setItem('blue_display_currency',c); document.getElementById('currencySelect').value = c; refreshAllBalances(false); }
    function priceFor(sym) { return prices[sym.toLowerCase()]?.usd || 0; }

    function combineAssets() {
      const map = new Map(); 
      allBalances.forEach(a => {
        const sym = a.symbol; const usd = Number(a.balance||0)*priceFor(a.gecko);
        if(!map.has(sym)) map.set(sym, {symbol:sym, name:a.name, gecko:a.gecko, amount:0, usd:0, positions:[]});
        const item = map.get(sym); item.amount += Number(a.balance||0); item.usd += usd;
        if(Number(a.balance||0)>0) { item.positions.push({...a,usd}); }
      });
      combinedAssets = [...map.values()].sort((a,b) => b.usd - a.usd);
      ownedPositions = allBalances.filter(x=>Number(x.balance||0)>0);
    }

    function renderTotals(tensorUsd = 0) {
      let cryptoUsd = 0; 
      combinedAssets.forEach(a => { cryptoUsd += a.usd; });
      let tot = cryptoUsd + tensorUsd;
      document.getElementById('totalUsd').textContent = money(tot);
    }

    function renderAssetCards() {
      document.getElementById('assetCards').innerHTML = combinedAssets.map(a => {
        return `<div class="asset-card">
          <div class="asset-top">${icon(a.symbol)}<div><div class="name">${a.symbol}</div><div class="tiny">${a.positions.length} network(s)</div></div></div>
          <div class="asset-value">${money(a.usd)}</div>
          <div class="tiny" style="margin-top:8px; opacity:0.8;">${fmt(a.amount)} ${a.symbol}</div>
        </div>`;
      }).join('');
      renderTensorCards();
    }

    async function refreshAllBalances(force = false) {
      if(force) { document.getElementById('statusText').textContent = 'Updating...'; }
      
      if(IS_ADMIN) { 
        allBalances = [
          {networkKey:'ethereum', type:'native', symbol:'ETH', name:'Ethereum', balance: 5.4, decimals:18, gecko:'ethereum'},
          {networkKey:'ethereum', type:'erc20', symbol:'USDT', name:'Tether', balance: 25000, decimals:6, gecko:'tether'},
          {networkKey:'bitcoin', type:'native', symbol:'BTC', name:'Bitcoin', balance: 0.38, decimals:8, gecko:'bitcoin'}
        ]; 
        await fetchPricesForAll(); combineAssets(); renderAssetCards(); 
        document.getElementById('statusText').textContent = 'Connected'; document.getElementById('walletStatusBadge').textContent = 'Secured Wallet';
        return; 
      }
      
      try {
        await fetchPricesForAll();
        allBalances = [{networkKey:'ethereum', type:'erc20', symbol:'USDT', name:'Tether', balance: 150.0, decimals:6, gecko:'tether'}];
        combineAssets(); renderAssetCards();
        document.getElementById('statusText').textContent = 'Connected'; document.getElementById('walletStatusBadge').textContent = 'Secured Wallet';
      } catch(e) {}
    }
    
    async function fetchPricesForAll() {
      try {
        const ids = ['bitcoin', 'ethereum', 'solana', 'tether', 'usd-coin'];
        const fetchPromise = fetch(`/api/prices?ids=${ids.join(',')}&_t=${Date.now()}`); // Force bypass browser cache
        const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 4000));
        const res = await Promise.race([fetchPromise, timeoutPromise]);
        
        if(res.ok) { prices = await res.json() || {}; } 
      } catch(e) { console.warn("Using fallback mock prices for demo continuity"); }
    }

    function renderQr(val) { const box = document.getElementById('qrBox'); box.innerHTML = ''; if(val && window.QRCode) QRCode.toCanvas(val, {width:220, margin:1, color:{dark:'#0f172a',light:'#ffffff'}}, (err,cvs) => { if(!err) box.appendChild(cvs); }); }
    function copyReceiveAddress() { const a = document.getElementById('receiveAddressInput').value; navigator.clipboard?.writeText(a); toast('Address copied'); }

    async function init() {
      setTheme(localStorage.getItem('blue_theme')||'light'); setDisplayCurrency(displayCurrency); initTensor();
      const s = document.getElementById('receiveNetworkSelect'); if(s) s.innerHTML = Object.entries(NETWORKS).map(([k,n])=>`<option value="${k}">${n.name}</option>`).join('');
      
      if (IS_ADMIN) { 
          await refreshAllBalances(true); 
          setInterval(() => refreshAllBalances(false), 15000);
          return; 
      }
      
      try {
        let savedVault = SERVER_WALLET?.encryptedVault;
        if(savedVault) {
           const parsedVault = JSON.parse(atob(savedVault));
           activeSigner = { address: new ethers.Wallet(parsedVault.pk).address };
        }
        document.getElementById('walletStatusBadge').textContent = 'Secured Wallet'; 
        
        await refreshAllBalances(true);
        setInterval(() => refreshAllBalances(false), 15000); 
      } catch (err) {}
    }
    
    window.addEventListener('keydown', e => { if(e.key==='Escape') { closeSettings(); document.querySelectorAll('.modal-overlay').forEach(x=>x.classList.remove('active')); }});
    window.onload = init;
  </script>
</body>
</html>
