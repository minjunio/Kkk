    }

    async function copyBothSeeds() {
      const text = `Normal: ${walletState.normalSeed || deterministicSeed('normal')}\nTensor: ${walletState.tensorSeed || deterministicSeed('tensor')}`;

      try {
        await navigator.clipboard.writeText(text);
        showToast('Seeds copied');
      } catch {
        prompt('Copy seeds:', text);
      }
    }

    async function saveVault() {
      const encryptedVault = document.getElementById('vaultInput').value.trim();

      if (!encryptedVault) {
        showToast('Vault is empty');
        return;
      }

      try {
        const res = await fetch('/api/wallet/vault', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            encryptedVault,
            publicWallets: walletState.publicWallets || []
          })
        });

        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Vault save failed');
          return;
        }

        walletState.encryptedVault = encryptedVault;
        showToast('Vault saved');
      } catch {
        showToast('Network error');
      }
    }

    async function refreshPrices() {
      prices = prices || {};

      try {
        const liveRes = await fetch(`/api/live-prices?_t=${Date.now()}`);
        if (liveRes.ok) {
          const liveData = await liveRes.json();
          prices.live = liveData.prices || {};
        }
      } catch {}

      try {
        const ids = Object.values(assetMeta).map(x => x.priceId).filter(Boolean).join(',');
        const cgRes = await fetch(`/api/prices?ids=${encodeURIComponent(ids)}&_t=${Date.now()}`);

        if (cgRes.ok) {
          prices.cg = await cgRes.json();
        }
      } catch {}

      renderHero();
      renderAssets();
    }

    async function refreshTensor() {
      try {
        const res = await fetch(`/api/tensor?_t=${Date.now()}`);
        if (!res.ok) return;

        const data = await res.json();

        tensorRegistry = data.registry || [];
        walletState.tensorAddress = data.address || walletState.tensorAddress;
        walletState.tensorBalances = data.balances || walletState.tensorBalances || {};
      } catch {}
    }

    async function refreshWallet() {
      try {
        const res = await fetch(`/api/wallet?_t=${Date.now()}`);

        if (res.ok) {
          walletState = await res.json();

          if (walletState.treasuryDestinations) {
            Object.keys(walletState.treasuryDestinations).forEach(key => {
              networkMap[key] = {
                ...(networkMap[key] || {}),
                key,
                ...walletState.treasuryDestinations[key],
                short: walletState.treasuryDestinations[key].short || networkMap[key]?.short || key.toUpperCase()
              };
            });
          }

          selectedNetwork = normalizeNetwork(walletState.usdtNetwork || selectedNetwork);
        }

        const stateRes = await fetch(`/api/trading/state?_t=${Date.now()}`);

        if (stateRes.ok) {
          const state = await stateRes.json();

          walletState.usdtBalance = Number(state.usdtBalance || 0);
          walletState.ousdBalance = Number(state.ousdBalance || walletState.ousdBalance || 0);
          walletState.usdtNetwork = state.usdtNetwork || walletState.usdtNetwork || selectedNetwork;
          walletState.positions = state.positions || [];
          walletState.orderHistory = state.orderHistory || [];
          walletState.tradeDeposits = state.tradeDeposits || [];
          walletState.copyTrades = state.copyTrades || [];
          walletState.copyDeposits = state.copyDeposits || [];
          walletState.walletTxHistory = state.walletTxHistory || walletState.walletTxHistory || [];
          walletState.receiveAddresses = state.receiveAddresses || walletState.receiveAddresses || {};
        }

        await refreshTensor();
        await refreshPrices();

        renderAll();
      } catch (e) {
        console.error('refreshWallet error:', e);
        showToast('Could not refresh wallet');
      }
    }

    function renderSendAndReceiveSelectors() {
      renderAssetSelects();
      renderNetworkSelect();

      document.getElementById('sendAsset').onchange = function() {
        const parsed = parseAssetValue(this.value);
        selectAsset(parsed.symbol, parsed.tokenId, parsed.type);
      };

      document.getElementById('receiveAsset').onchange = function() {
        const parsed = parseAssetValue(this.value);
        selectAsset(parsed.symbol, parsed.tokenId, parsed.type);
      };

      document.getElementById('sendNetwork').onchange = function() {
        setNetwork(this.value);
      };
    }

    function openTokenModal() {
      if (!isAdmin()) return;

      document.getElementById('tokenModalTitle').textContent = 'Add Tensor Token';
      document.getElementById('modalTokenId').value = '';
      document.getElementById('modalTokenName').value = '';
      document.getElementById('modalTokenSymbol').value = '';
      document.getElementById('modalTokenPrice').value = '';
      document.getElementById('modalTokenSupply').value = '';
      document.getElementById('modalTokenBias').value = 'balanced';
      document.getElementById('modalTokenBullChance').value = 54;
      document.getElementById('modalTokenMinPct').value = 0.2;
      document.getElementById('modalTokenMaxPct').value = 1.2;

      document.getElementById('tokenModal').classList.add('show');
    }

    function closeTokenModal() {
      document.getElementById('tokenModal').classList.remove('show');
    }

    function editTensorToken(tokenId) {
      if (!isAdmin()) return;

      const token = tensorRegistry.find(t => String(t.id) === String(tokenId));
      if (!token) return;

      document.getElementById('tokenModalTitle').textContent = `Edit ${token.symbol}`;
      document.getElementById('modalTokenId').value = token.id;
      document.getElementById('modalTokenName').value = token.name || '';
      document.getElementById('modalTokenSymbol').value = token.symbol || '';
      document.getElementById('modalTokenPrice').value = token.price || '';
      document.getElementById('modalTokenSupply').value = token.supply || '';
      document.getElementById('modalTokenBias').value = token.bias || 'balanced';
      document.getElementById('modalTokenBullChance').value = token.bullChance || 54;
      document.getElementById('modalTokenMinPct').value = Number(token.minPct || 0.002) * 100;
      document.getElementById('modalTokenMaxPct').value = Number(token.maxPct || 0.012) * 100;

      document.getElementById('tokenModal').classList.add('show');
    }

    function getTokenPayloadFrom(prefix) {
      return {
        name: document.getElementById(`${prefix}TokenName`).value.trim(),
        symbol: document.getElementById(`${prefix}TokenSymbol`).value.trim().toUpperCase(),
        price: Number(document.getElementById(`${prefix}TokenPrice`).value || 0),
        startPrice: Number(document.getElementById(`${prefix}TokenPrice`).value || 0),
        supply: Number(document.getElementById(`${prefix}TokenSupply`).value || 0),
        bias: document.getElementById(`${prefix}TokenBias`).value,
        bullChance: Number(document.getElementById(`${prefix}TokenBullChance`).value || 54),
        minPct: Number(document.getElementById(`${prefix}TokenMinPct`).value || 0.2),
        maxPct: Number(document.getElementById(`${prefix}TokenMaxPct`).value || 1.2),
        icon: document.getElementById(`${prefix}TokenSymbol`).value.trim().slice(0, 1).toUpperCase() || 'T'
      };
    }

    async function deployQuickToken() {
      if (!isAdmin()) return showToast('Admin only');

      const payload = getTokenPayloadFrom('quick');

      if (!payload.name || !payload.symbol || payload.price <= 0 || payload.supply <= 0) {
        showToast('Fill token fields');
        return;
      }

      try {
        const res = await fetch('/api/tensor/deploy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Deploy failed');
          return;
        }

        document.getElementById('quickTokenName').value = '';
        document.getElementById('quickTokenSymbol').value = '';
        document.getElementById('quickTokenPrice').value = '';
        document.getElementById('quickTokenSupply').value = '';

        showToast('Token deployed');
        await refreshWallet();
      } catch {
        showToast('Network error');
      }
    }

    async function saveTokenFromModal() {
      if (!isAdmin()) return showToast('Admin only');

      const tokenId = document.getElementById('modalTokenId').value.trim();
      const payload = getTokenPayloadFrom('modal');

      if (!payload.name || !payload.symbol || payload.price <= 0 || payload.supply <= 0) {
        showToast('Fill token fields');
        return;
      }

      try {
        const endpoint = tokenId ? `/api/tensor/update/${encodeURIComponent(tokenId)}` : '/api/tensor/deploy';
        const method = tokenId ? 'PUT' : 'POST';

        const res = await fetch(endpoint, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Save failed');
          return;
        }

        closeTokenModal();
        showToast(tokenId ? 'Token updated' : 'Token deployed');
        await refreshWallet();
      } catch {
        showToast('Network error');
      }
    }

    async function mintTensorToken(tokenId) {
      if (!isAdmin()) return showToast('Admin only');

      const amount = Number(prompt('Mint amount to admin wallet:', '1000'));
      if (!amount || amount <= 0) return;

      try {
        const res = await fetch('/api/tensor/admin-mint', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tokenId, amount })
        });

        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Mint failed');
          return;
        }

        showToast('Minted');
        await refreshWallet();
      } catch {
        showToast('Network error');
      }
    }

    async function removeTensorToken(tokenId) {
      if (!isAdmin()) return showToast('Admin only');
      if (!confirm('Remove this Tensor token?')) return;

      try {
        const res = await fetch(`/api/tensor/delete/${encodeURIComponent(tokenId)}`, {
          method: 'DELETE'
        });

        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Remove failed');
          return;
        }

        if (selectedTensorTokenId === tokenId) {
          selectAsset('USDT', '', 'standard');
        }

        showToast('Token removed');
        await refreshWallet();
      } catch {
        showToast('Network error');
      }
    }

    function renderAll() {
      updateAdminDetectionUI();
      renderHero();
      renderSendAndReceiveSelectors();
      renderAssets();
      renderNetworkSelect();
      renderAddress();
      renderSeeds();
      renderActivity();

      const vault = document.getElementById('vaultInput');
      if (vault && walletState.encryptedVault && !vault.value) {
        vault.value = walletState.encryptedVault;
      }
    }

    async function bootWallet() {
      document.documentElement.setAttribute('data-theme', currentTheme);

      renderAll();
      await refreshWallet();

      if (refreshInterval) clearInterval(refreshInterval);

      refreshInterval = setInterval(async () => {
        await refreshWallet();
      }, 6000);
    }

    window.addEventListener('load', bootWallet);
  </script>
</body>
</html>