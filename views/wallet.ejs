    async function sendSelectedAsset() {
      const parsed = parseSelectValue(document.getElementById('sendAsset').value);
      const amount = Number(document.getElementById('sendAmount').value || 0);
      const toAddress = document.getElementById('sendTo').value.trim();

      selectedWalletType = parsed.type;
      selectedAsset = parsed.symbol;
      selectedTokenId = parsed.tokenId || '';

      const balance = getSelectedBalance();

      if (!parsed.symbol || !amount || amount <= 0 || !toAddress) {
        showToast('Fill send details');
        return;
      }

      if (amount > balance) {
        showToast(`Insufficient ${parsed.symbol} balance`);
        validateSendAmountLive();
        return;
      }

      try {
        const endpoint = parsed.type === 'tensor' ? '/api/tensor/send' : '/api/wallet/send';

        const body = parsed.type === 'tensor'
          ? {
              tokenId: parsed.tokenId,
              amount,
              toAddress
            }
          : {
              asset: parsed.symbol,
              network: selectedNetwork,
              amount,
              toAddress
            };

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Send failed');
          return;
        }

        document.getElementById('sendAmount').value = '';
        document.getElementById('sendTo').value = '';

        showToast(data.txHash ? `Sent: ${shortAddress(data.txHash)}` : 'Sent');
        await refreshWallet();
      } catch {
        showToast('Network error');
      }
    }

