  </div>

  <div class="toast" id="toast"></div>

  <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.5/dist/ethers.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>

  <script>
    const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
    const CURRENT_EMAIL = "<%= typeof email !== 'undefined' ? email : '' %>";
    const USER_ROLE = "<%= typeof role !== 'undefined' ? role : 'user' %>";
    const IS_ADMIN = USER_ROLE === 'staff';

    const DISPLAY_RATES = { USD:{symbol:'$',rate:1}, AED:{symbol:'AED ',rate:3.6725}, EUR:{symbol:'€',rate:.92}, GBP:{symbol:'£',rate:.79}, SAR:{symbol:'SAR ',rate:3.75} };
    
    const NETWORKS = { 
      ethereum:{name:'Ethereum',chainId:1,symbol:'ETH'}, 
      bsc:{name:'BNB Chain',chainId:56,symbol:'BNB'}, 
      polygon:{name:'Polygon',chainId:137,symbol:'MATIC'},
      bitcoin:{name:'Bitcoin Native',chainId:null,symbol:'BTC'},
      solana:{name:'Solana Native',chainId:null,symbol:'SOL'}
    };
    
    const CHAIN_ASSETS = {
      ethereum: [{symbol:'ETH', name:'Ethereum'}, {symbol:'USDT', name:'Tether'}, {symbol:'USDC', name:'USD Coin'}],
      bsc: [{symbol:'BNB', name:'BNB'}, {symbol:'USDT', name:'Tether'}],
      polygon: [{symbol:'MATIC', name:'Polygon'}, {symbol:'USDT', name:'Tether'}, {symbol:'USDC', name:'USD Coin'}],
      bitcoin: [{symbol:'BTC', name:'Bitcoin'}],
      solana: [{symbol:'SOL', name:'Solana'}, {symbol:'USDC', name:'USD Coin'}]
    };

    const TENSOR_ICONS = [
      `<svg viewBox="0 0 24 24" fill="url(#grad1)"><defs><linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#ec4899" /><stop offset="100%" stop-color="#8b5cf6" /></linearGradient></defs><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
      `<svg viewBox="0 0 24 24" fill="#0ea5e9"><circle cx="12" cy="12" r="10"/><path fill="#ffffff" d="M12 6a6 6 0 1 0 0 12 6 6 0 0 0 0-12z"/></svg>`,
      `<svg viewBox="0 0 24 24" fill="#10b981"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path stroke="#ffffff" stroke-width="2" d="M12 8v4l3 3"/></svg>`,
      `<svg viewBox="0 0 24 24" stroke="#f59e0b" stroke-width="2" fill="none"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
      `<svg viewBox="0 0 24 24" fill="#8b5cf6"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line stroke="#ffffff" stroke-width="2" x1="8" y1="21" x2="16" y2="21"/><line stroke="#ffffff" stroke-width="2" x1="12" y1="17" x2="12" y2="21"/></svg>`,
      `<svg viewBox="0 0 24 24" fill="#f43f5e"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`,
      `<svg viewBox="0 0 24 24" fill="#84cc16"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`
    ];

    const WATCH_ASSETS = [{symbol:'BTC',name:'Bitcoin',gecko:'bitcoin'}, {symbol:'ETH',name:'Ethereum',gecko:'ethereum'}, {symbol:'SOL',name:'Solana',gecko:'solana'}];
    const TOP_5_STRIP = ['bitcoin', 'ethereum', 'solana', 'binancecoin', 'ripple']; 
    
    // Fail-safe Mock Prices to ensure the UI ALWAYS loads quickly
    const MOCK_PRICES = {
        'bitcoin': { usd: 65420.50, usd_24h_change: 2.45 },
        'ethereum': { usd: 3510.20, usd_24h_change: 1.12 },
        'solana': { usd: 145.60, usd_24h_change: -0.5 },
        'binancecoin': { usd: 590.30, usd_24h_change: 0.8 },
        'ripple': { usd: 0.52, usd_24h_change: -1.2 },
        'tether': { usd: 1.00, usd_24h_change: 0 },
        'usd-coin': { usd: 1.00, usd_24h_change: 0 }
    };

    let displayCurrency = localStorage.getItem('blue_display_currency') || 'USD';
    let activeSigner = null, allBalances = [], combinedAssets = [], ownedPositions = [];
    let tensorAddress = "", tensorRegistry = [], tensorBalances = {};
    let prices = {};
    let toastTimer;

    // TENSOR HIGH-FREQUENCY TICKER ENGINE
    let baseTensorData = [];
    let visualTensorData = [];
    let hftInterval = null;

    // CHART ENGINE
    let chartingIntervalObject = null;
    let activeChartTokenId = null;
    let tvChart = null, lineSeries = null, candleSeries = null;
    let currentChartType = 'candle';
    let currentTF = 1; // 1m, 5m, 15m, 60m, 1440m
    let rawCandleData = [];

    async function initTensor() {
      tensorAddress = SERVER_WALLET?.tensorAddress || "T0x...Loading";
      
      if (!SERVER_WALLET?.tensorVault) {
         try {
           const randWallet = ethers.Wallet.createRandom();
           const phrase = randWallet.mnemonic.phrase;
           await fetch('/api/tensor/vault', { 
               method: 'POST', headers: {'Content-Type': 'application/json'}, 
               body: JSON.stringify({ tensorVault: phrase })
           });
           if (SERVER_WALLET) SERVER_WALLET.tensorVault = phrase;
         } catch(e) {}
      }

      if (IS_ADMIN) {
        document.getElementById('adminSettingsControls').style.display = 'block';
        document.getElementById('adTenIconPicker').innerHTML = TENSOR_ICONS.map((svg, i) => `<button class="icon-option ${i===0?'selected':''}" onclick="selAdTenIcon(this, ${i})">${svg}</button>`).join('');
        window.selectedTenIcon = 0;
        
        const saved = JSON.parse(localStorage.getItem('blue_admin_balances')) || {eth: 5.4, usdt: 25000, btc: 0.38};
        document.getElementById('adBalETH').value = saved.eth;
        document.getElementById('adBalUSDT').value = saved.usdt;
        document.getElementById('adBalBTC').value = saved.btc;
      }
      
      await fetchTensorData();
      
      // Real backend sync every 5 seconds
      setInterval(fetchTensorData, 5000);
      
      // Visual High-Frequency Ticker (every 800ms)
      hftInterval = setInterval(simulateHFT, 800);
    }

    function simulateHFT() {
        if(!visualTensorData.length) return;
        let requiresRender = false;
        
        visualTensorData.forEach(t => {
            if(t.bias === 'pegged') return; // Stablecoins don't jitter
            // Jitter by up to 0.05% visually
            const jitter = 1 + ((Math.random() - 0.5) * 0.001); 
            const newPrice = t.displayPrice * jitter;
            
            // Only update DOM if change is noticeable to save CPU
            if (Math.abs(newPrice - t.displayPrice) > (t.displayPrice * 0.0001)) {
                t.displayPrice = newPrice;
                requiresRender = true;
                
                // Update DOM directly for speed if elements exist
                const priceEl = document.getElementById(`tprice-${t.id}`);
                const changeEl = document.getElementById(`tchg-${t.id}`);
                if (priceEl && changeEl) {
                    priceEl.textContent = money(newPrice);
                    const diff = t.startPrice ? (((newPrice - t.startPrice)/t.startPrice)*100) : 0;
                    changeEl.textContent = `${diff>=0?'+':''}${diff.toFixed(2)}%`;
                    changeEl.className = diff>=0 ? 'pnl-line up flash-up' : 'pnl-line down flash-down';
                    setTimeout(() => {
                        if(changeEl) changeEl.className = diff>=0 ? 'pnl-line up' : 'pnl-line down';
                    }, 200);
                }
            }
        });
        
        if (requiresRender) {
            let totTenUsd = 0;
            visualTensorData.forEach(t => { totTenUsd += (tensorBalances[t.id] || 0) * t.displayPrice; });
            renderTotals(totTenUsd);
            if(document.getElementById('tensorSwapModal').classList.contains('active')) calcTensorOutput();
        }
    }

    async function fetchTensorData() {
       try {
         const res = await fetch('/api/tensor');
         if(res.ok) {
            const data = await res.json();
            baseTensorData = data.registry || [];
            tensorAddress = data.address || tensorAddress;
            tensorBalances = data.balances || {};
         }
       } catch(e) { 
           baseTensorData = JSON.parse(localStorage.getItem('blue_tensor_registry')) || [];
           tensorBalances = JSON.parse(localStorage.getItem(`blue_ten_bal_${CURRENT_EMAIL.split('@')[0]}`)) || {};
       }
       
       // Sync visual data
       if(baseTensorData.length !== visualTensorData.length) {
           visualTensorData = JSON.parse(JSON.stringify(baseTensorData));
           visualTensorData.forEach(t => t.displayPrice = t.price);
           renderTensorCards();
       } else {
           baseTensorData.forEach((bt, i) => {
               visualTensorData[i] = {...bt, displayPrice: visualTensorData[i].displayPrice}; 
               // Trend towards true backend price smoothly
               visualTensorData[i].displayPrice = visualTensorData[i].displayPrice + ((bt.price - visualTensorData[i].displayPrice) * 0.5);
           });
       }
       
       if (IS_ADMIN) {
           const mintSel = document.getElementById('adMintSelect');
           if(mintSel && mintSel.options.length !== baseTensorData.length) {
               mintSel.innerHTML = baseTensorData.map(t => `<option value="${t.id}">${t.symbol}</option>`).join('');
           }
       }
    }

    function renderTensorCards() {
      const box = document.getElementById('tensorCards');
      if(!visualTensorData.length) { 
        box.innerHTML = `<div class="asset-card tensor"><div class="name">No Tensor Assets</div><div class="tiny">Admin must deploy tokens.</div></div>`; 
        return; 
      }
      
      let totTenUsd = 0;
      box.innerHTML = visualTensorData.map(t => {
        const bal = tensorBalances[t.id] || 0; 
        const p = t.displayPrice || t.price;
        const val = bal * p; 
        totTenUsd += val;
        const diff = t.startPrice ? (((p - t.startPrice)/t.startPrice)*100) : 0;
        const adminBtn = IS_ADMIN ? `<button class="small-btn" style="position:absolute; top:12px; right:12px; height:24px; padding:0 8px; font-size:0.65rem;" onclick="event.stopPropagation(); openTensorManage('${t.id}')">Manage</button>` : '';

        return `<div class="asset-card tensor" onclick="openTensorAnalytics('${t.id}')">
          ${adminBtn}
          <div class="asset-top">
            <div class="coin tensor-coin">${t.icon}</div>
            <div style="width:calc(100% - 56px); overflow:hidden;">
              <div class="name">${t.symbol}</div>
              <div class="tiny" style="color:var(--tensor); font-weight:800;">Dom: ${fmt(t.dominance || 0, 2)}%</div>
            </div>
          </div>
          <div class="asset-value" id="tprice-${t.id}">${money(p)}</div>
          <div class="asset-sub">
            <span id="tchg-${t.id}" class="${diff>=0?'pnl-line up':'pnl-line down'}" style="padding:2px 8px; font-size:0.7rem; margin:0; border:none; background:transparent;">${diff>=0?'+':''}${diff.toFixed(2)}%</span>
          </div>
          <div class="tiny" style="margin-top:8px; opacity:0.8; font-size:0.7rem;">
            Cap: $${formatCompact(t.marketCap || 0)} <br> Holds: ${fmt(bal,2)} ${t.symbol}
          </div>
        </div>`;
      }).join('');
      
      renderTotals(totTenUsd);
    }

    // --- Admin Functions ---
    function selAdTenIcon(btn, i) { document.querySelectorAll('.icon-option').forEach(b=>b.classList.remove('selected')); btn.classList.add('selected'); window.selectedTenIcon = i; }
    
    function saveAdminBalances() {
      const eth = Number(document.getElementById('adBalETH').value);
      const usdt = Number(document.getElementById('adBalUSDT').value);
      const btc = Number(document.getElementById('adBalBTC').value);
      localStorage.setItem('blue_admin_balances', JSON.stringify({eth, usdt, btc}));
      toast('Demo crypto balances saved!');
      refreshAllBalances(true);
    }
    
    async function adminMintTensor() {
       const tId = document.getElementById('adMintSelect').value;
       const amt = Number(document.getElementById('adMintAmount').value);
       if(!tId || amt <= 0) return toast('Invalid mint amount');
       
       try {
         const res = await fetch('/api/tensor/admin-mint', {
           method: 'POST', headers: { 'Content-Type': 'application/json' },
           body: JSON.stringify({ tokenId: tId, amount: amt })
         });
         
         if(res.ok) {
           toast(`Minted ${amt} to Admin Wallet!`);
           fetchTensorData();
         } else { toast('Failed to mint.'); }
       } catch (e) { toast('Network error.'); }
    }

    async function deployTensorToken() {
      const name = document.getElementById('adTenName').value; 
      const symbol = document.getElementById('adTenSym').value.toUpperCase();
      const price = Number(document.getElementById('adTenPrice').value); 
      const bias = document.getElementById('adTenBias').value;
      const bullChance = Number(document.getElementById('adTenBullChance').value) || 60;
      const supply = Number(document.getElementById('adTenSupply').value);
      const minPct = Number(document.getElementById('adTenMinPct').value);
      const maxPct = Number(document.getElementById('adTenMaxPct').value);

      if(!name || !symbol || price <= 0 || supply <= 0 || minPct < 0 || maxPct < 0) return toast('Invalid details');
      
      try {
        const res = await fetch('/api/tensor/deploy', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, symbol, price, bias, bullChance, minPct, maxPct, icon: TENSOR_ICONS[window.selectedTenIcon], supply })
        });
        if(res.ok) { toast(`${symbol} deployed!`); fetchTensorData(); closeSettings(); } 
        else throw new Error('Failed');
      } catch (e) { toast('Deployment failed.'); }
    }

    function openTensorManage(id) {
      const t = baseTensorData.find(x => x.id === id);
      if(!t) return;
      document.getElementById('editTokenId').value = id;
      document.getElementById('manageTokenName').textContent = `Editing ${t.symbol}`;
      document.getElementById('editBias').value = t.bias || 'random';
      document.getElementById('editBullChance').value = t.bullChance || 60;
      document.getElementById('editMinPct').value = (t.minPct || 0.01) * 100;
      document.getElementById('editMaxPct').value = (t.maxPct || 0.05) * 100;
      document.getElementById('editSupply').value = t.supply || 10000000;
      openModal('tensorManageModal');
    }

    async function updateTensorToken() {
      const id = document.getElementById('editTokenId').value;
      const bias = document.getElementById('editBias').value;
      const bullChance = document.getElementById('editBullChance').value;
      const minPct = document.getElementById('editMinPct').value;
      const maxPct = document.getElementById('editMaxPct').value;
      const supply = document.getElementById('editSupply').value;

      try {
        const res = await fetch(`/api/tensor/update/${id}`, {
          method: 'PUT', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ bias, bullChance, minPct, maxPct, supply })
        });
        if(res.ok) { toast('Token mechanics updated.'); closeModal('tensorManageModal'); fetchTensorData(); }
      } catch(e) { toast('Update failed.'); }
    }

    async function deleteTensorToken() {
      const id = document.getElementById('editTokenId').value;
      try {
        const res = await fetch(`/api/tensor/delete/${id}`, { method: 'DELETE' });
        if(res.ok) { toast('Token deleted.'); closeModal('tensorManageModal'); fetchTensorData(); }
      } catch(e) { toast('Deletion failed.'); }
    }

    // --- CHARTING ENGINE (Lightweight Charts) ---
    function initChart() {
        if(tvChart) return;
        const container = document.getElementById('chartContainer');
        tvChart = LightweightCharts.createChart(container, {
            layout: { background: { type: 'solid', color: 'transparent' }, textColor: '#64748b' },
            grid: { vertLines: { color: 'rgba(2, 132, 199, 0.05)' }, horzLines: { color: 'rgba(2, 132, 199, 0.05)' } },
            rightPriceScale: { borderVisible: false },
            timeScale: { borderVisible: false, timeVisible: true, fixLeftEdge: true },
            crosshair: { mode: 0, vertLine: { color: '#38bdf8', labelBackgroundColor: '#0284c7' }, horzLine: { color: '#38bdf8', labelBackgroundColor: '#0284c7' } }
        });
        
        candleSeries = tvChart.addCandlestickSeries({ upColor: '#10b981', downColor: '#e11d48', borderVisible: false, wickUpColor: '#10b981', wickDownColor: '#e11d48' });
        lineSeries = tvChart.addLineSeries({ color: '#38bdf8', lineWidth: 2 });
        lineSeries.applyOptions({ visible: false });
        
        // Handle resizing naturally
        new ResizeObserver(entries => {
            if (entries.length === 0 || entries[0].target !== container) { return; }
            const newRect = entries[0].contentRect;
            tvChart.applyOptions({ height: newRect.height, width: newRect.width });
        }).observe(container);
    }

    function setChartType(type) {
        currentChartType = type;
        document.getElementById('chartTypeCandle').className = type === 'candle' ? 'active' : '';
        document.getElementById('chartTypeLine').className = type === 'line' ? 'active' : '';
        
        if (type === 'candle') { candleSeries.applyOptions({visible:true}); lineSeries.applyOptions({visible:false}); } 
        else { candleSeries.applyOptions({visible:false}); lineSeries.applyOptions({visible:true}); }
    }

    function setChartTF(minutes, btn) {
        currentTF = minutes;
        document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        processAndRenderChartData();
    }

    async function openTensorAnalytics(tokenId) {
      activeChartTokenId = tokenId;
      openModal('tensorChartModal');
      setTimeout(() => {
          initChart();
          fetchAndDrawChart();
      }, 100); // Allow modal animation to finish before painting canvas
      
      clearInterval(chartingIntervalObject);
      chartingIntervalObject = setInterval(fetchAndDrawChart, 5000);
    }

    async function fetchAndDrawChart() {
      if (!activeChartTokenId || !document.getElementById('tensorChartModal').classList.contains('active')) {
        clearInterval(chartingIntervalObject); return;
      }
      
      const token = baseTensorData.find(t => t.id === activeChartTokenId);
      if (!token) return;

      document.getElementById('chartModalTitle').textContent = `${token.name} (${token.symbol})`;
      document.getElementById('chartModalStats').textContent = `Cap: $${Number(token.marketCap || 0).toLocaleString(undefined, {maximumFractionDigits:0})} | Share: ${fmt(token.dominance || 0, 2)}%`;
      document.getElementById('chartMetricSupply').textContent = Number(token.supply || 0).toLocaleString();
      document.getElementById('chartMetricVolume').textContent = money(token.volume || 0);
      document.getElementById('chartMetricDominance').textContent = `${fmt(token.dominance || 0, 2)}%`;

      try {
        const response = await fetch(`/api/tensor/chart?tokenId=${activeChartTokenId}`);
        const data = await response.json();
        if (data && data.candles) {
            rawCandleData = data.candles;
            processAndRenderChartData();
        }
      } catch (e) { }
    }

    function processAndRenderChartData() {
        if(!rawCandleData || rawCandleData.length === 0 || !tvChart) return;
        
        let aggregated = [];
        let currentBucket = null;
        let msInterval = currentTF * 60 * 1000;

        rawCandleData.forEach(c => {
            const bucketTime = Math.floor(c.time / msInterval) * msInterval;
            if (!currentBucket || currentBucket.originalTime !== bucketTime) {
                if (currentBucket) aggregated.push(currentBucket);
                currentBucket = { time: Math.floor(bucketTime / 1000), originalTime: bucketTime, open: c.open, high: c.high, low: c.low, close: c.close, value: c.close };
            } else {
                currentBucket.high = Math.max(currentBucket.high, c.high);
                currentBucket.low = Math.min(currentBucket.low, c.low);
                currentBucket.close = c.close;
                currentBucket.value = c.close;
            }
        });
        if(currentBucket) aggregated.push(currentBucket);

        const unique = Array.from(new Map(aggregated.map(item => [item.time, item])).values());
        candleSeries.setData(unique);
        lineSeries.setData(unique);
    }
    // --- END CHARTING ---

    // --- SWAP / SEND ---
    function openTensorSwap() {
      const s = document.getElementById('tenSwapSelectOut');
      s.innerHTML = visualTensorData.map(t => `<option value="${t.id}">${t.symbol}</option>`).join('');
      document.getElementById('tenSwapUsdtBal').textContent = `${fmt(getUsdtBalanceTotal())} available`;
      document.getElementById('tenSwapAmountIn').value = ''; document.getElementById('tenSwapReceiveTxt').value = '';
    }

    function calcTensorOutput() {
      const amt = Number(document.getElementById('tenSwapAmountIn').value||0);
      const tId = document.getElementById('tenSwapSelectOut').value;
      const t = visualTensorData.find(x=>x.id===tId);
      if(!t || amt<=0) { document.getElementById('tenSwapReceiveTxt').value = ''; return; }
      
      const feeAmount = amt * 0.000001;
      const netAmount = amt - feeAmount;
      document.getElementById('tenSwapReceiveTxt').value = fmt(netAmount / t.displayPrice, 4);
    }

    async function executeTensorSwap() {
      const amt = Number(document.getElementById('tenSwapAmountIn').value||0);
      const tId = document.getElementById('tenSwapSelectOut').value;
      const t = baseTensorData.find(x=>x.id===tId);
      if(!t || amt<=0) return toast('Invalid swap');
      
      const realUsdt = ownedPositions.find(p=>p.symbol==='USDT');
      if(IS_ADMIN || (realUsdt && realUsdt.balance >= amt)) {
        toast('Processing Swap...');
        try {
          const res = await fetch('/api/tensor/swap', {
             method: 'POST', headers: { 'Content-Type': 'application/json' },
             body: JSON.stringify({ tokenId: t.id, usdtAmount: amt })
          });
          if(res.ok) { fetchTensorData(); closeModal('tensorSwapModal'); return toast(`Received ${t.symbol}!`); }
        } catch(e) { toast('Network error'); }
      } else { toast('Insufficient real USDT'); }
    }

    function updateTenSendBal() {
      const tId = document.getElementById('tenSendSelect').value;
      document.getElementById('tenSendBalTxt').textContent = `${fmt(tensorBalances[tId] || 0)} available`;
    }
    
    function maxTenSend() { document.getElementById('tenSendAmt').value = tensorBalances[document.getElementById('tenSendSelect').value] || 0; }
    
    async function executeTensorSend() {
      const tId = document.getElementById('tenSendSelect').value; const amt = Number(document.getElementById('tenSendAmt').value);
      const to = document.getElementById('tenSendTo').value.trim();
      if(!to.startsWith('T0x') || amt<=0 || (tensorBalances[tId]||0) < amt) return toast('Invalid details');
      
      toast('Processing T0x Tx...');
      try {
         const res = await fetch('/api/tensor/send', {
             method: 'POST', headers: { 'Content-Type': 'application/json' },
             body: JSON.stringify({ tokenId: tId, amount: amt, toAddress: to })
         });
         if(res.ok) { fetchTensorData(); closeModal('tensorSendModal'); return toast('AI Token Sent'); }
      } catch(e) { toast('Transfer failed.'); }
    }

    // --- STANDARD CRYPTO ---
    function switchRecMode(mode) {
        document.getElementById('btnRecCrypto').className = mode === 'crypto' ? 'active' : '';
        document.getElementById('btnRecTensor').className = mode === 'tensor' ? 'active' : '';
        document.getElementById('receiveGroupSelect').value = mode;
        renderReceiveAssets();
    }

    function renderReceiveAssets() {
      const g = document.getElementById('receiveGroupSelect').value;
      const nw = document.getElementById('recNetWrap');
      const box = document.getElementById('receiveAssetsList');
      
      if(g === 'tensor') {
        nw.style.display = 'none'; document.getElementById('qrNetworkBadge').textContent = 'T0x'; document.getElementById('receiveTitle').textContent = 'Tensor AI Token';
        document.getElementById('receiveAddressInput').value = tensorAddress; renderQr(tensorAddress);
        box.innerHTML = baseTensorData.map(t=>`<button class="receive-option" style="border:1px solid var(--border); padding:8px; border-radius:12px; background:var(--solid); text-align:left;"><div style="display:flex; align-items:center; gap:8px;"><div class="coin tensor-coin" style="width:24px; height:24px;">${t.icon}</div><div><div class="name" style="font-size:0.85rem;">${t.symbol}</div></div></div></button>`).join('');
      } else {
        nw.style.display = 'block'; 
        const netKey = document.getElementById('receiveNetworkSelect').value || 'ethereum';
        const net = NETWORKS[netKey];
        document.getElementById('qrNetworkBadge').textContent = net.symbol; document.getElementById('receiveTitle').textContent = `Crypto on ${net.name}`;
        
        let addr = IS_ADMIN ? '0xAdminDemoWallet...' : (activeSigner?.address || 'No wallet');
        if (netKey === 'bitcoin') addr = 'bc1q' + Array.from(crypto.getRandomValues(new Uint8Array(18))).map(b=>b.toString(16).padStart(2,'0')).join('');
        if (netKey === 'solana') addr = Array.from(crypto.getRandomValues(new Uint8Array(22))).map(b=>b.toString(36)).join('');
        
        document.getElementById('receiveAddressInput').value = addr; renderQr(addr);
        
        const arr = CHAIN_ASSETS[netKey] || [];
        box.innerHTML = arr.map((a,i) => `<button class="receive-option ${i===0?'selected':''}" style="border:1px solid var(--border); padding:8px; border-radius:12px; background:var(--solid); text-align:left;"><div style="display:flex; align-items:center; gap:8px;"><div style="transform:scale(0.7); margin:-8px;">${icon(a.symbol)}</div><div><div class="name" style="font-size:0.85rem;">${a.symbol}</div></div></div></button>`).join('');
      }
    }

    // HELPER FUNCTIONS
    function toast(msg) { const el = document.getElementById('toast'); el.textContent = msg; el.classList.add('active'); clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('active'), 2500); }
    function formatCompact(num) { return !num ? '$0' : new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',notation:'compact'}).format(num); }
    function money(val) { const cfg = DISPLAY_RATES[displayCurrency] || DISPLAY_RATES.USD; return `${cfg.symbol}${(Number(val||0) * cfg.rate).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`; }
    function fmt(val, dec=6) { return Number(val||0).toLocaleString(undefined,{maximumFractionDigits:dec}); }
    function icon(sym) { return `<div class="coin"><img src="https://assets.coincap.io/assets/icons/${String(sym).toLowerCase()}@2x.png" onerror="this.remove();this.parentNode.textContent='${String(sym).slice(0,4)}'" /></div>`; }

    function openModal(id) { document.getElementById(id).classList.add('active'); if(id==='tensorSwapModal') openTensorSwap(); if(id==='tensorSendModal') { document.getElementById('tenSendSelect').innerHTML = baseTensorData.map(t=>`<option value="${t.id}">${t.symbol}</option>`).join(''); updateTenSendBal(); } if(id==='receiveModal') renderReceiveAssets(); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); if (id === 'tensorChartModal') clearInterval(chartingIntervalObject); }
    function overlayClose(e,id) { if(e.target.id === id) closeModal(id); }
    function navSetActive(id) { document.querySelectorAll('.bottom-nav button').forEach(b=>b.classList.remove('active')); document.getElementById(id)?.classList.add('active'); }
    
    function openSettings() { document.getElementById('settingsOverlay').classList.add('active'); document.getElementById('settingsAddress').textContent = IS_ADMIN ? "0xAdminDemo..." : (activeSigner ? activeSigner.address : "Loading..."); document.getElementById('settingsTensorAddress').textContent = tensorAddress; navSetActive('navSettings'); }
    function closeSettings() { document.getElementById('settingsOverlay').classList.remove('active'); navSetActive('navHome'); }
    function setTheme(t) { document.documentElement.setAttribute('data-theme',t); localStorage.setItem('blue_theme',t); }
    function setDisplayCurrency(c) { displayCurrency = c; localStorage.setItem('blue_display_currency',c); document.getElementById('currencySelect').value = c; refreshAllBalances(false); }
    function priceFor(sym) { return prices[sym.toLowerCase()]?.usd || 0; }

    function combineAssets() {
      const map = new Map(); 
      WATCH_ASSETS.forEach(w => map.set(w.symbol, {symbol:w.symbol, name:w.name, gecko:w.gecko, amount:0, usd:0, positions:[], isWatch:true}));
      allBalances.forEach(a => {
        const sym = a.symbol; const usd = Number(a.balance||0)*priceFor(a.gecko);
        if(!map.has(sym)) map.set(sym, {symbol:sym, name:a.name, gecko:a.gecko, amount:0, usd:0, positions:[], isWatch:false});
        const item = map.get(sym); item.amount += Number(a.balance||0); item.usd += usd;
        if(Number(a.balance||0)>0) { item.isWatch=false; item.positions.push({...a,usd}); }
      });
      combinedAssets = [...map.values()].sort((a,b) => b.usd - a.usd);
      ownedPositions = allBalances.filter(x=>Number(x.balance||0)>0);
    }

    function renderTotals(tensorUsd = 0) {
      let cryptoUsd = 0; 
      combinedAssets.forEach(a => { cryptoUsd += a.usd; });
      let tot = cryptoUsd + tensorUsd;
      
      document.getElementById('totalUsd').textContent = money(tot);
      
      // Update Donut Chart visually
      if (tot > 0) {
          const cryptoPct = (cryptoUsd / tot) * 100;
          const tensorPct = (tensorUsd / tot) * 100;
          
          document.getElementById('donutCrypto').setAttribute('stroke-dasharray', `${cryptoPct}, 100`);
          document.getElementById('donutTensor').setAttribute('stroke-dasharray', `${tensorPct}, 100`);
          document.getElementById('donutTensor').setAttribute('stroke-dashoffset', `-${cryptoPct}`);
      }
    }

    function renderAssetCards() {
      document.getElementById('assetCards').innerHTML = combinedAssets.map(a => {
        return `<div class="asset-card ${a.usd<=0?'watch':''}">
          <div class="asset-top">${icon(a.symbol)}<div><div class="name">${a.symbol}</div><div class="tiny">${a.positions.length?`${a.positions.length} network(s)`:'Watchlist'}</div></div></div>
          <div class="asset-value">${a.usd>0?money(a.usd):money(priceFor(a.gecko))}</div>
          <div class="tiny" style="margin-top:8px; opacity:0.8;">${fmt(a.amount)} ${a.symbol}</div>
        </div>`;
      }).join('');
      renderTensorCards();
    }

    function renderMarketStrip() {
      const strip = document.getElementById('topMarketCards');
      strip.innerHTML = TOP_5_STRIP.map(gecko => {
        const p = prices[gecko]; if(!p) return '';
        const chg = p.usd_24h_change || 0;
        const sym = gecko === 'bitcoin' ? 'BTC' : gecko === 'ethereum' ? 'ETH' : gecko === 'solana' ? 'SOL' : gecko === 'binancecoin' ? 'BNB' : 'XRP';
        return `<div class="market-card">
           <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">${icon(sym)} <strong>${sym}</strong></div>
           <div style="font-weight:900; font-size:1.1rem;">${money(p.usd)}</div>
           <div class="${chg>=0?'pnl-line up':'pnl-line down'}" style="margin-top:4px; padding:2px 6px; font-size:0.7rem;">${chg>=0?'+':''}${chg.toFixed(2)}%</div>
        </div>`;
      }).join('');
    }

    async function refreshAllBalances(force = false) {
      if(force) { document.getElementById('statusText').textContent = 'Updating...'; }
      
      if(IS_ADMIN) { 
        const saved = JSON.parse(localStorage.getItem('blue_admin_balances')) || {eth: 5.4, usdt: 25000, btc: 0.38};
        allBalances = [
          {networkKey:'ethereum', type:'native', symbol:'ETH', name:'Ethereum', balance: saved.eth, decimals:18, gecko:'ethereum'},
          {networkKey:'ethereum', type:'erc20', symbol:'USDT', name:'Tether', balance: saved.usdt, decimals:6, gecko:'tether'},
          {networkKey:'bitcoin', type:'native', symbol:'BTC', name:'Bitcoin', balance: saved.btc, decimals:8, gecko:'bitcoin'}
        ]; 
        await fetchPricesForAll(); combineAssets(); renderAssetCards(); 
        document.getElementById('statusText').textContent = 'Connected'; document.getElementById('walletStatusBadge').textContent = 'Secured Wallet';
        return; 
      }
      
      try {
        await fetchPricesForAll();
        allBalances = [{networkKey:'ethereum', type:'erc20', symbol:'USDT', name:'Tether', balance: 150.0, decimals:6, gecko:'tether'}];
        combineAssets(); renderAssetCards();
        document.getElementById('statusText').textContent = 'Connected'; document.getElementById('walletStatusBadge').textContent = 'Secured Wallet';
      } catch(e) {}
    }
    
    async function fetchPricesForAll() {
      try {
        // Wrap fetch with Promise.race for strict timeouts to prevent hanging UI
        const ids = [...TOP_5_STRIP, 'tether', 'usd-coin'];
        const fetchPromise = fetch(`/api/prices?ids=${ids.join(',')}`);
        const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 4000));
        
        const res = await Promise.race([fetchPromise, timeoutPromise]);
        
        if(res.ok) { prices = await res.json() || {}; } 
        else throw new Error('API Fail');
      } catch(e) {
        console.warn("Using fallback mock prices for demo continuity");
        prices = MOCK_PRICES; // Fallback to ensure UI always works
      }
      renderMarketStrip();
    }

    function renderQr(val) { const box = document.getElementById('qrBox'); box.innerHTML = ''; if(val && window.QRCode) QRCode.toCanvas(val, {width:220, margin:1, color:{dark:'#0f172a',light:'#ffffff'}}, (err,cvs) => { if(!err) box.appendChild(cvs); }); }
    function copyReceiveAddress() { const a = document.getElementById('receiveAddressInput').value; navigator.clipboard?.writeText(a); toast('Address copied'); document.getElementById('copyAddrBtn').innerHTML='<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>'; setTimeout(()=>document.getElementById('copyAddrBtn').innerHTML='<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>',2000); }

    function showSeed() { if(IS_ADMIN) return toast('Demo Mode.'); const el = document.getElementById('secretOutput'); el.value = SERVER_WALLET?.encryptedVault ? JSON.parse(atob(SERVER_WALLET.encryptedVault)).phrase : 'No Web3 Seed'; el.style.filter = 'none'; }
    function showTensorSeed() { if(IS_ADMIN) return toast('Demo Mode.'); const el = document.getElementById('secretOutput'); el.value = SERVER_WALLET?.tensorVault || 'No Tensor Seed Generated'; el.style.filter = 'none'; }

    async function init() {
      setTheme(localStorage.getItem('blue_theme')||'light'); setDisplayCurrency(displayCurrency); initTensor();
      const s = document.getElementById('receiveNetworkSelect'); if(s) s.innerHTML = Object.entries(NETWORKS).map(([k,n])=>`<option value="${k}">${n.name}</option>`).join('');
      
      if (IS_ADMIN) { 
          await refreshAllBalances(true); 
          setInterval(() => refreshAllBalances(false), 15000);
          return; 
      }
      
      try {
        let savedVault = SERVER_WALLET?.encryptedVault;
        if (!savedVault && window.ethers) {
          const randomWallet = ethers.Wallet.createRandom();
          savedVault = btoa(JSON.stringify({ pk: randomWallet.privateKey, phrase: randomWallet.mnemonic.phrase }));
          await fetch('/api/wallet/vault', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ encryptedVault: savedVault, publicWallets: [randomWallet.address] }) });
        }
        if(savedVault) {
           const parsedVault = JSON.parse(atob(savedVault));
           activeSigner = { address: new ethers.Wallet(parsedVault.pk).address };
        }
        document.getElementById('walletStatusBadge').textContent = 'Secured Wallet'; 
        
        await refreshAllBalances(true);
        setInterval(() => refreshAllBalances(false), 15000); // Auto refresh prices without UI blocking
      } catch (err) {}
    }
    
    window.addEventListener('keydown', e => { if(e.key==='Escape') { closeSettings(); document.querySelectorAll('.modal-overlay').forEach(x=>x.classList.remove('active')); clearInterval(chartingIntervalObject); }});
    window.onload = init;
  </script>
</body>
</html>
