    function calculatePositionPnl(p) {
      const entry = Number(p.entryPrice || 0);
      const mark = Number(p.markPrice || p.entryPrice || 0);
      const size = Number(p.size || 0);
      if (!entry || !size) return 0;
      const diff = p.side === 'short' ? entry - mark : mark - entry;
      return (diff / entry) * size;
    }

