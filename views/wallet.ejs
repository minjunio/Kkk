<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blue API Wallet - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #07090e;
            --bg-panel: #11151f;
            --bg-panel-hover: #161c29;
            --primary: #2563eb;
            --primary-glow: rgba(37, 99, 235, 0.2);
            --text-main: #f8fafc;
            --text-muted: #64748b;
            --success: #10b981;
            --success-bg: rgba(16, 185, 129, 0.1);
            --danger: #ef4444;
            --danger-bg: rgba(239, 68, 68, 0.1);
            --border: rgba(255, 255, 255, 0.05);
            --radius: 16px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        
        body { 
            background-color: var(--bg-dark); 
            color: var(--text-main); 
            min-height: 100vh;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(37, 99, 235, 0.08), transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(37, 99, 235, 0.05), transparent 25%);
        }

        /* Top Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
            border-bottom: 1px solid var(--border);
            background: rgba(11, 14, 20, 0.8);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-section { display: flex; align-items: center; gap: 12px; }
        .logo-box { width: 36px; height: 36px; background: var(--primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem; box-shadow: 0 0 15px var(--primary-glow); }
        .brand-name { font-size: 1.2rem; font-weight: 600; letter-spacing: 0.5px; }
        
        .user-profile { display: flex; align-items: center; gap: 12px; font-weight: 500; color: var(--text-muted); }
        .user-avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6, #1d4ed8); border: 2px solid var(--bg-panel); }

        /* Main Dashboard Layout */
        .dashboard {
            max-width: 1200px;
            margin: 32px auto;
            padding: 0 24px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
        }

        /* Overview Cards */
        .overview-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .card {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
            background: linear-gradient(90deg, transparent, var(--primary), transparent);
            opacity: 0; transition: opacity 0.3s ease;
        }
        .card:hover::before { opacity: 1; }

        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; color: var(--text-muted); font-size: 0.9rem; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; }
        .card-balance { font-size: 2.5rem; font-weight: 700; margin-bottom: 8px; }
        
        .pnl-badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; }
        .pnl-positive { color: var(--success); background: var(--success-bg); }
        .pnl-negative { color: var(--danger); background: var(--danger-bg); }

        /* Action Buttons */
        .actions { display: flex; gap: 12px; margin-top: 24px; }
        .btn { flex: 1; padding: 12px; border-radius: 10px; font-weight: 600; font-size: 0.9rem; cursor: pointer; border: none; transition: all 0.2s; text-align: center; }
        .btn-primary { background: var(--primary); color: white; box-shadow: 0 4px 15px var(--primary-glow); }
        .btn-primary:hover { background: #1d4ed8; transform: translateY(-2px); }
        .btn-secondary { background: rgba(255, 255, 255, 0.05); color: white; border: 1px solid var(--border); }
        .btn-secondary:hover { background: rgba(255, 255, 255, 0.1); }

        /* Data Tables (Portfolio & Staking) */
        .section-header { display: flex; justify-content: space-between; align-items: center; margin: 32px 0 16px 0; }
        .section-header h2 { font-size: 1.3rem; font-weight: 600; }
        
        .table-container { background: var(--bg-panel); border: 1px solid var(--border); border-radius: var(--radius); overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { padding: 16px 24px; color: var(--text-muted); font-size: 0.8rem; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid var(--border); }
        td { padding: 20px 24px; border-bottom: 1px solid var(--border); vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        tr:hover { background: var(--bg-panel-hover); }

        .asset-cell { display: flex; align-items: center; gap: 16px; }
        .asset-icon { width: 40px; height: 40px; border-radius: 50%; background: var(--bg-dark); padding: 4px; display: flex; align-items: center; justify-content: center; }
        .asset-icon img { width: 100%; height: 100%; object-fit: contain; }
        .asset-name { font-weight: 600; font-size: 1rem; }
        .asset-symbol { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }

        .value-cell { font-weight: 600; }
        .sub-value { font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; font-weight: 400; }

        /* Staking Specific */
        .staking-profit-text { color: var(--success); font-weight: 600; text-shadow: 0 0 10px rgba(16, 185, 129, 0.2); }
        .apy-badge { background: rgba(37, 99, 235, 0.1); color: var(--primary); padding: 4px 8px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; }

        /* Modal */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; z-index: 1000; }
        .modal-overlay.active { opacity: 1; pointer-events: all; }
        .modal-content { background: var(--bg-panel); padding: 32px; border-radius: var(--radius); width: 90%; max-width: 400px; border: 1px solid var(--border); transform: translateY(20px); transition: transform 0.3s ease; }
        .modal-overlay.active .modal-content { transform: translateY(0); }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-size: 0.9rem; color: var(--text-muted); }
        .form-group input { width: 100%; padding: 14px; background: rgba(0, 0, 0, 0.3); border: 1px solid var(--border); border-radius: 10px; color: white; outline: none; }
        .form-group input:focus { border-color: var(--primary); }

        @media (max-width: 768px) {
            .overview-grid { grid-template-columns: 1fr; }
            th, td { padding: 16px; }
            .hide-mobile { display: none; }
        }
    </style>
</head>
<body>

    <nav>
        <div class="brand-section">
            <div class="logo-box">B</div>
            <div class="brand-name">Blue API Wallet</div>
        </div>
        <div class="user-profile">
            <span>minjunio</span>
            <div class="user-avatar"></div>
        </div>
    </nav>

    <div class="dashboard">
        <div class="overview-grid">
            <div class="card" ondblclick="openModal()">
                <div class="card-header">
                    <span>Spot Portfolio Value</span>
                    <span style="color: var(--success); font-size: 0.8rem;">● Live</span>
                </div>
                <div class="card-balance" id="totalBalance">$0.00</div>
                <div class="pnl-badge pnl-positive" id="totalPnl">
                    +$0.00 (0.00%) All-Time
                </div>
                <div class="actions">
                    <button class="btn btn-primary" onclick="openModal()">+ Add Asset</button>
                    <button class="btn btn-secondary">Trade</button>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <span>Active Staking Value</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary)"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div class="card-balance" id="stakingBalance">$0.00</div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border);">
                    <span style="color: var(--text-muted); font-size: 0.9rem;">Total Earned Rewards</span>
                    <span class="staking-profit-text" id="stakingProfits">+$0.00</span>
                </div>
            </div>
        </div>

        <div class="section-header">
            <h2>Spot Assets</h2>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Asset</th>
                        <th>Price</th>
                        <th>Holdings</th>
                        <th class="hide-mobile">Avg Buy Price</th>
                        <th>Total Value & PnL</th>
                    </tr>
                </thead>
                <tbody id="portfolioList">
                    </tbody>
            </table>
        </div>

        <div class="section-header">
            <h2>Active Staking Vaults</h2>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Asset</th>
                        <th>Staked Amount</th>
                        <th>Current APY</th>
                        <th>Rewards Earned</th>
                    </tr>
                </thead>
                <tbody id="stakingList">
                    </tbody>
            </table>
        </div>
    </div>

    <div class="modal-overlay" id="manageModal">
        <div class="modal-content">
            <h2 style="margin-bottom: 24px;">Manage Spot Asset</h2>
            <div class="form-group">
                <label>Asset Symbol (e.g. ETH, SOL)</label>
                <input type="text" id="currencyInput" placeholder="ETH" autocomplete="off">
            </div>
            <div class="form-group">
                <label>Amount of Coins</label>
                <input type="number" id="amountInput" placeholder="0.00" step="0.0001" min="0">
            </div>
            <div class="form-group">
                <label>Average Buy Price (USD) - For PnL</label>
                <input type="number" id="buyPriceInput" placeholder="Optional" step="0.01" min="0">
            </div>
            <div style="display: flex; gap: 12px; margin-top: 32px;">
                <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                <button class="btn btn-primary" onclick="addAsset()">Confirm</button>
            </div>
        </div>
    </div>

    <script>
        // State Management - Expanded Coin List & Staking
        let portfolio = [
            { currency: 'ETH', name: 'Ethereum', amount: 4.25, avgBuyPrice: 2850.50 },
            { currency: 'BTC', name: 'Bitcoin', amount: 0.15, avgBuyPrice: 62000.00 },
            { currency: 'SOL', name: 'Solana', amount: 145.5, avgBuyPrice: 85.20 },
            { currency: 'LINK', name: 'Chainlink', amount: 450, avgBuyPrice: 14.50 },
            { currency: 'ADA', name: 'Cardano', amount: 8500, avgBuyPrice: 0.45 }
        ];

        let stakingVaults = [
            { currency: 'ETH', name: 'Ethereum', stakedAmount: 2.5, apy: 4.5, earnedAmount: 0.045 },
            { currency: 'DOT', name: 'Polkadot', stakedAmount: 350, apy: 12.8, earnedAmount: 14.2 },
            { currency: 'SOL', name: 'Solana', stakedAmount: 50, apy: 7.2, earnedAmount: 1.8 }
        ];

        let liveData = {}; // Stores price and 24h change

        // Modal Logic
        const manageModal = document.getElementById('manageModal');
        function openModal() { manageModal.classList.add('active'); }
        function closeModal() { manageModal.classList.remove('active'); }
        manageModal.addEventListener('click', (e) => { if (e.target === manageModal) closeModal(); });

        function addAsset() {
            const sym = document.getElementById('currencyInput').value.toUpperCase();
            const amt = parseFloat(document.getElementById('amountInput').value);
            const buyPrice = parseFloat(document.getElementById('buyPriceInput').value) || 0;

            if (sym && amt > 0) {
                const existing = portfolio.find(a => a.currency === sym);
                if (existing) {
                    existing.amount += amt;
                    // Rough average down calculation
                    existing.avgBuyPrice = ((existing.amount * existing.avgBuyPrice) + (amt * buyPrice)) / (existing.amount + amt);
                } else {
                    portfolio.push({ currency: sym, name: sym, amount: amt, avgBuyPrice: buyPrice });
                }
                fetchLivePrices();
                closeModal();
            }
        }

        function getIconUrl(symbol) {
            return `https://assets.coincap.io/assets/icons/${symbol.toLowerCase()}@2x.png`;
        }

        function formatUSD(num) {
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num);
        }

        async function fetchLivePrices() {
            // Get unique symbols from both portfolio and staking
            const allSymbols = [...new Set([...portfolio.map(a => a.currency), ...stakingVaults.map(a => a.currency)])].join(',');
            
            try {
                // Using CryptoCompare's full data endpoint to get prices AND 24h changes
                const res = await fetch(`https://min-api.cryptocompare.com/data/pricemultifull?fsyms=${allSymbols}&tsyms=USD`);
                const data = await res.json();
                
                if (data.RAW) {
                    Object.keys(data.RAW).forEach(sym => {
                        liveData[sym] = {
                            price: data.RAW[sym].USD.PRICE,
                            change24h: data.RAW[sym].USD.CHANGEPCT24HOUR
                        };
                    });
                }
                updateDashboard();
            } catch (error) {
                console.error("API Error:", error);
            }
        }

        function updateDashboard() {
            let totalSpotValue = 0;
            let totalSpotCost = 0;
            
            const portfolioHtml = portfolio.map(asset => {
                const live = liveData[asset.currency] || { price: 0, change24h: 0 };
                const currentTotal = asset.amount * live.price;
                const costBasis = asset.amount * asset.avgBuyPrice;
                
                totalSpotValue += currentTotal;
                totalSpotCost += costBasis;

                // PnL Logic
                const profitLoss = currentTotal - costBasis;
                const pnlClass = profitLoss >= 0 ? 'pnl-positive' : 'pnl-negative';
                const pnlSign = profitLoss >= 0 ? '+' : '';

                return `
                    <tr>
                        <td>
                            <div class="asset-cell">
                                <div class="asset-icon"><img src="${getIconUrl(asset.currency)}" onerror="this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSJub25lIiBzdHJva2U9IiM2NDc0OGIiIHN0cm9rZS13aWR0aD0iMiIgY3JjbGUgY3g9IjEyIiBjeT0iMTIiIHI9IjEwIi8+PC9zdmc+'"></div>
                                <div>
                                    <div class="asset-name">${asset.name}</div>
                                    <div class="asset-symbol">${asset.currency}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="value-cell">${formatUSD(live.price)}</div>
                            <div class="sub-value ${live.change24h >= 0 ? 'pnl-positive' : 'pnl-negative'}" style="background:transparent; padding:0;">
                                ${live.change24h >= 0 ? '▲' : '▼'} ${Math.abs(live.change24h).toFixed(2)}% (24h)
                            </div>
                        </td>
                        <td>
                            <div class="value-cell">${asset.amount}</div>
                            <div class="sub-value">${asset.currency}</div>
                        </td>
                        <td class="hide-mobile">
                            <div class="value-cell">${asset.avgBuyPrice > 0 ? formatUSD(asset.avgBuyPrice) : '--'}</div>
                        </td>
                        <td>
                            <div class="value-cell">${formatUSD(currentTotal)}</div>
                            ${asset.avgBuyPrice > 0 ? `<div class="sub-value ${pnlClass}" style="background:transparent; padding:0;">${pnlSign}${formatUSD(profitLoss)}</div>` : ''}
                        </td>
                    </tr>
                `;
            }).join('');
            
            document.getElementById('portfolioList').innerHTML = portfolioHtml;

            // Update Header Totals
            document.getElementById('totalBalance').innerText = formatUSD(totalSpotValue);
            
            if (totalSpotCost > 0) {
                const totalPnl = totalSpotValue - totalSpotCost;
                const totalPnlPct = (totalPnl / totalSpotCost) * 100;
                const pnlEl = document.getElementById('totalPnl');
                
                pnlEl.className = `pnl-badge ${totalPnl >= 0 ? 'pnl-positive' : 'pnl-negative'}`;
                pnlEl.innerText = `${totalPnl >= 0 ? '+' : ''}${formatUSD(totalPnl)} (${totalPnlPct.toFixed(2)}%) All-Time`;
            }

            // Staking Calculations
            let totalStakingValue = 0;
            let totalEarnedUsd = 0;

            const stakingHtml = stakingVaults.map(vault => {
                const live = liveData[vault.currency] || { price: 0 };
                const vaultValue = vault.stakedAmount * live.price;
                const earnedUsd = vault.earnedAmount * live.price;
                
                totalStakingValue += vaultValue;
                totalEarnedUsd += earnedUsd;

                return `
                    <tr>
                        <td>
                            <div class="asset-cell">
                                <div class="asset-icon"><img src="${getIconUrl(vault.currency)}" onerror="this.style.display='none'"></div>
                                <div>
                                    <div class="asset-name">${vault.name}</div>
                                    <div class="asset-symbol">${vault.currency}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="value-cell">${vault.stakedAmount} ${vault.currency}</div>
                            <div class="sub-value">${formatUSD(vaultValue)}</div>
                        </td>
                        <td>
                            <span class="apy-badge">${vault.apy}% APY</span>
                        </td>
                        <td>
                            <div class="staking-profit-text">+${vault.earnedAmount.toFixed(4)} ${vault.currency}</div>
                            <div class="sub-value">${formatUSD(earnedUsd)}</div>
                        </td>
                    </tr>
                `;
            }).join('');

            document.getElementById('stakingList').innerHTML = stakingHtml;
            document.getElementById('stakingBalance').innerText = formatUSD(totalStakingValue);
            document.getElementById('stakingProfits').innerText = `+${formatUSD(totalEarnedUsd)}`;
        }

        // Initialize and setup interval
        fetchLivePrices();
        setInterval(fetchLivePrices, 10000); // Poll every 10 seconds to respect API limits

    </script>
</body>
</html>
