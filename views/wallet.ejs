<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Tensor Wallet | Wallet</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>

  <style>
    :root {
      --bg-base: #070a0f;
      --bg-base-2: #0b0f17;
      --bg-panel: rgba(17, 24, 39, 0.86);
      --bg-panel-solid: #111827;
      --bg-card: rgba(15, 23, 42, 0.72);
      --bg-hover: rgba(45, 55, 72, 0.9);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.14);
      --border-strong: rgba(148, 163, 184, 0.24);

      --green: #0ecb81;
      --green-glow: rgba(14, 203, 129, 0.18);
      --red: #f6465d;
      --red-glow: rgba(246, 70, 93, 0.18);
      --tensor: #8b5cf6;
      --tensor-2: #3b82f6;
      --tensor-soft: rgba(139, 92, 246, 0.18);
      --yellow: #f59e0b;

      --shadow: 0 22px 70px rgba(0,0,0,0.38);
      --radius: 18px;
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="light"] {
      --bg-base: #f6f8fb;
      --bg-base-2: #eef2f8;
      --bg-panel: rgba(255,255,255,0.90);
      --bg-panel-solid: #ffffff;
      --bg-card: rgba(255,255,255,0.84);
      --bg-hover: rgba(226, 232, 240, 0.9);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border: rgba(15, 23, 42, 0.10);
      --border-strong: rgba(15, 23, 42, 0.18);
      --shadow: 0 18px 55px rgba(15,23,42,0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.22), transparent 28%),
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.14), transparent 24%),
        linear-gradient(180deg, var(--bg-base), var(--bg-base-2));
      color: var(--text-main);
      font-variant-numeric: tabular-nums;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent 70%);
      z-index: 0;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
      outline: none;
      border: none;
      background: transparent;
      color: inherit;
    }

    button {
      cursor: pointer;
      transition: transform 0.08s ease, opacity 0.12s ease, background 0.12s ease, border-color 0.12s ease;
    }

    button:active {
      transform: scale(0.98);
    }

    button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .app {
      position: relative;
      z-index: 1;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: calc(10px + var(--safe-top)) 14px 10px;
      background: rgba(7, 10, 15, 0.78);
      backdrop-filter: blur(22px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    [data-theme="light"] .topbar {
      background: rgba(255,255,255,0.78);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 950;
      font-size: 1.08rem;
      color: var(--text-main);
    }

    .brand-logo {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,0.35), transparent 22%),
        linear-gradient(135deg, var(--tensor), var(--tensor-2));
      box-shadow: 0 12px 30px rgba(139, 92, 246, 0.35);
    }

    .brand-logo svg {
      width: 19px;
      height: 19px;
      stroke: white;
    }

    .top-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .icon-btn {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-main);
    }

    .admin-badge {
      display: none;
      padding: 7px 10px;
      border: 1px solid rgba(139,92,246,0.42);
      background: rgba(139,92,246,0.16);
      color: #c4b5fd;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .admin-badge.show {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .page {
      width: min(1640px, 100%);
      margin: 0 auto;
      padding: 12px 12px calc(84px + var(--safe-bottom));
      display: grid;
      gap: 14px;
    }

    @media (min-width: 1100px) {
      .page {
        grid-template-columns: minmax(0, 1fr) 380px;
        align-items: start;
        padding-bottom: 18px;
      }
    }

    .main-column {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
    }

    .panel {
      border-radius: var(--radius);
      padding: 14px;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
    }

    .hero {
      padding: 16px;
      border-radius: 22px;
      background:
        radial-gradient(circle at 0% 0%, rgba(139,92,246,0.30), transparent 28%),
        radial-gradient(circle at 100% 0%, rgba(14,203,129,0.12), transparent 24%),
        var(--bg-panel);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      overflow: hidden;
      position: relative;
      backdrop-filter: blur(18px);
    }

    .hero::before {
      content: "";
      position: absolute;
      top: -150px;
      right: -120px;
      width: 280px;
      height: 280px;
      background: radial-gradient(circle, rgba(139,92,246,0.22), transparent 68%);
      pointer-events: none;
    }

    .hero-head {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
      position: relative;
      z-index: 1;
    }

    .wallet-label {
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }

    .wallet-balance {
      margin-top: 5px;
      font-size: clamp(2rem, 7vw, 4.2rem);
      font-weight: 950;
      letter-spacing: -0.075em;
      line-height: 1;
    }

    .wallet-sub {
      margin-top: 8px;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 800;
      line-height: 1.4;
      max-width: 720px;
    }

    .network-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      border: 1px solid rgba(139,92,246,0.34);
      background: rgba(139,92,246,0.14);
      color: #c4b5fd;
      font-size: 0.74rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 15px;
      position: relative;
      z-index: 1;
    }

    .primary-btn,
    .mini-btn,
    .danger-btn,
    .green-btn,
    .yellow-btn {
      min-height: 40px;
      border-radius: 13px;
      padding: 9px 12px;
      font-size: 0.78rem;
      font-weight: 950;
      border: 1px solid transparent;
      text-align: center;
    }

    .primary-btn {
      color: #fff;
      background: linear-gradient(135deg, var(--tensor), var(--tensor-2));
      box-shadow: 0 14px 30px rgba(59,130,246,0.18);
    }

    .green-btn {
      color: #fff;
      background: linear-gradient(135deg, #0ecb81, #10b981);
      box-shadow: 0 14px 30px rgba(14,203,129,0.14);
    }

    .yellow-btn {
      color: var(--yellow);
      background: rgba(245,158,11,0.14);
      border-color: rgba(245,158,11,0.26);
    }

    .mini-btn {
      background: var(--bg-card);
      color: var(--text-main);
      border-color: var(--border);
    }

    .danger-btn {
      background: var(--red-glow);
      color: var(--red);
      border-color: rgba(246,70,93,0.24);
    }

    .stats-grid {
      margin-top: 16px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      position: relative;
      z-index: 1;
    }

    .stat-card {
      background: rgba(7,10,15,0.42);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 11px;
      min-width: 0;
    }

    [data-theme="light"] .stat-card {
      background: rgba(255,255,255,0.72);
    }

    .stat-label {
      color: var(--text-muted);
      font-size: 0.65rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .stat-value {
      margin-top: 5px;
      font-weight: 950;
      font-size: 0.92rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 1rem;
      font-weight: 950;
    }

    .section-title-icon {
      width: 28px;
      height: 28px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: var(--tensor-soft);
      color: #c4b5fd;
    }

    .section-sub {
      color: var(--text-muted);
      font-size: 0.76rem;
      font-weight: 760;
      line-height: 1.42;
      margin-top: 3px;
    }

    .asset-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    @media (min-width: 760px) {
      .asset-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .asset-card {
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      background: rgba(7, 10, 15, 0.48);
      border: 1px solid var(--border);
      padding: 12px;
      cursor: pointer;
      transition: 0.16s ease;
    }

    [data-theme="light"] .asset-card {
      background: rgba(255,255,255,0.82);
    }

    .asset-card:hover,
    .asset-card.active {
      border-color: rgba(139,92,246,0.52);
      transform: translateY(-1px);
      box-shadow: 0 18px 40px rgba(0,0,0,0.14);
    }

    .asset-card.active::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--tensor), transparent);
    }

    .asset-top {
      display: flex;
      justify-content: space-between;
      gap: 9px;
      align-items: center;
    }

    .coin {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
    }

    .coin-icon {
      width: 34px;
      height: 34px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, rgba(139,92,246,0.88), rgba(59,130,246,0.82));
      color: white;
      font-weight: 950;
      overflow: hidden;
      flex: 0 0 auto;
    }

    .coin-icon svg {
      width: 22px;
      height: 22px;
      display: block;
    }

    .coin-name {
      min-width: 0;
    }

    .coin-symbol {
      font-weight: 950;
      font-size: 0.94rem;
      line-height: 1.1;
    }

    .coin-full {
      margin-top: 3px;
      color: var(--text-muted);
      font-size: 0.68rem;
      font-weight: 820;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .asset-price {
      margin-top: 12px;
      font-weight: 950;
      font-size: 1.1rem;
      letter-spacing: -0.03em;
    }

    .asset-row {
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 850;
    }

    .asset-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
      margin-top: 10px;
    }

    .asset-actions button {
      min-height: 32px;
      border-radius: 10px;
      font-size: 0.68rem;
      font-weight: 950;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-main);
    }

    .asset-actions button.remove {
      color: var(--red);
      background: var(--red-glow);
      border-color: rgba(246,70,93,0.24);
    }

    .text-green {
      color: var(--green);
    }

    .text-red {
      color: var(--red);
    }

    .side-panel {
      position: sticky;
      top: 68px;
      height: fit-content;
      display: grid;
      gap: 14px;
    }

    .tabs {
      display: flex;
      gap: 7px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .tabs::-webkit-scrollbar {
      display: none;
    }

    .tab {
      padding: 8px 10px;
      font-weight: 900;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.82rem;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }

    .tab.active {
      color: var(--text-main);
      border-bottom-color: var(--tensor);
    }

    .qr-card {
      display: grid;
      gap: 12px;
    }

    .qr-box {
      width: 178px;
      height: 178px;
      margin: 0 auto;
      background: white;
      border-radius: 18px;
      padding: 12px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,0.3);
      box-shadow: 0 18px 45px rgba(0,0,0,0.20);
    }

    #qrCanvas,
    #modalQrCanvas {
      width: 154px !important;
      height: 154px !important;
      display: block;
    }

    .address-box,
    .seed-box {
      padding: 11px;
      border-radius: 14px;
      background: rgba(7,10,15,0.48);
      border: 1px solid var(--border);
      word-break: break-all;
      font-size: 0.76rem;
      color: var(--text-main);
      font-weight: 850;
      line-height: 1.44;
      text-align: center;
    }

    .seed-box {
      text-align: left;
      user-select: text;
      filter: blur(4px);
    }

    .seed-box.revealed {
      filter: none;
    }

    [data-theme="light"] .address-box,
    [data-theme="light"] .seed-box {
      background: rgba(248,250,252,0.90);
    }

    .network-select {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 7px;
    }

    .network-btn {
      min-height: 36px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-muted);
      font-size: 0.72rem;
      font-weight: 950;
    }

    .network-btn.active {
      background: rgba(139,92,246,0.16);
      color: #c4b5fd;
      border-color: rgba(139,92,246,0.38);
    }

    .form {
      display: grid;
      gap: 10px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .field {
      display: grid;
      gap: 6px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      color: var(--text-muted);
      font-size: 0.67rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .field input,
    .field select,
    .field textarea {
      min-height: 42px;
      background: rgba(7,10,15,0.58);
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 9px 11px;
      font-size: 0.84rem;
      font-weight: 850;
      width: 100%;
    }

    [data-theme="light"] .field input,
    [data-theme="light"] .field select,
    [data-theme="light"] .field textarea {
      background: rgba(248,250,252,0.92);
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: rgba(139,92,246,0.72);
      box-shadow: 0 0 0 3px rgba(139,92,246,0.10);
    }

    .mini-note {
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 760;
      line-height: 1.44;
    }

    .tx-list {
      display: grid;
      gap: 9px;
    }

    .tx-card {
      padding: 11px;
      border-radius: 15px;
      border: 1px solid var(--border);
      background: rgba(7,10,15,0.42);
    }

    [data-theme="light"] .tx-card {
      background: rgba(255,255,255,0.78);
    }

    .tx-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
    }

    .tx-title {
      font-weight: 950;
      font-size: 0.82rem;
    }

    .tx-date {
      color: var(--text-muted);
      font-size: 0.66rem;
      font-weight: 800;
    }

    .tx-detail {
      margin-top: 7px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 760;
      line-height: 1.44;
      word-break: break-all;
    }

    .empty {
      padding: 22px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 800;
      border: 1px dashed var(--border-strong);
      border-radius: 16px;
      background: rgba(7,10,15,0.22);
    }

    .admin-panel {
      display: none;
    }

    .admin-panel.show {
      display: block;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: calc(74px + var(--safe-bottom));
      transform: translateX(-50%) translateY(20px);
      z-index: 200;
      min-width: 220px;
      max-width: calc(100% - 28px);
      padding: 11px 13px;
      border-radius: 14px;
      background: rgba(15,23,42,0.94);
      border: 1px solid var(--border-strong);
      color: white;
      font-weight: 900;
      font-size: 0.78rem;
      box-shadow: 0 18px 50px rgba(0,0,0,0.35);
      opacity: 0;
      pointer-events: none;
      transition: 0.18s ease;
      text-align: center;
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .bottom-nav {
      position: fixed;
      left: 0;
      bottom: 0;
      width: 100%;
      height: calc(60px + var(--safe-bottom));
      background: rgba(7,10,15,0.86);
      backdrop-filter: blur(22px);
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding-bottom: var(--safe-bottom);
      z-index: 60;
    }

    [data-theme="light"] .bottom-nav {
      background: rgba(255,255,255,0.86);
    }

    @media (min-width: 1024px) {
      .bottom-nav {
        display: none;
      }
    }

    .bottom-nav button {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 800;
      width: 100%;
      height: 100%;
      justify-content: center;
    }

    .bottom-nav button svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.5;
    }

    .bottom-nav button.active {
      color: var(--text-main);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(0,0,0,0.66);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      backdrop-filter: blur(12px);
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal {
      width: min(620px, 100%);
      max-height: 90vh;
      overflow: auto;
      background: var(--bg-panel-solid);
      border: 1px solid var(--border-strong);
      border-radius: 22px;
      padding: 16px;
      box-shadow: 0 30px 90px rgba(0,0,0,0.50);
    }

    .modal-title {
      font-size: 1.08rem;
      font-weight: 950;
    }

    .modal-desc {
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 780;
      line-height: 1.44;
      margin-top: 6px;
    }

    .modal-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 13px;
    }

    @media (max-width: 720px) {
      .brand span:last-child {
        display: none;
      }

      .admin-badge {
        display: none !important;
      }

      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }

      .asset-grid {
        grid-template-columns: 1fr;
      }

      .network-select {
        grid-template-columns: 1fr 1fr;
      }

      .hero-head {
        flex-direction: column;
      }

      .hero-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <script>
      const SERVER_EMAIL = <%- JSON.stringify(typeof email !== 'undefined' ? email : '') %>;
      const SERVER_ROLE = <%- JSON.stringify(typeof role !== 'undefined' ? role : '') %>;
      const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
