    function runAutoStakeCheck(manual = false) {
      const current = STAKE_OPTIONS.find(o => o.id === autoStakeSettings.currentStrategy) || STAKE_OPTIONS[0];
      const best = STAKE_OPTIONS.slice().sort((a, b) => b.apy - a.apy)[0];

      autoStakeSettings.lastCheck = Date.now();

      if (!autoStakeSettings.enabled) {
        localStorage.setItem('blue_auto_stake', JSON.stringify(autoStakeSettings));
        if (manual) toast('Auto-stake is off');
        updateWalletUi();
        return;
      }

      if (best.apy <= current.apy || best.id === current.id) {
        autoStakeSettings.candidate = null;
        localStorage.setItem('blue_auto_stake', JSON.stringify(autoStakeSettings));
        if (manual) toast('Current strategy is still best');
        updateWalletUi();
        return;
      }

      if (!autoStakeSettings.candidate || autoStakeSettings.candidate.id !== best.id) {
        autoStakeSettings.candidate = {
          ...best,
          detectedAt: Date.now(),
          readyAt: Date.now() + SEVEN_DAYS_MS
        };

        localStorage.setItem('blue_auto_stake', JSON.stringify(autoStakeSettings));
        if (manual) toast('Higher APY found. 7-day watch started.');
        updateWalletUi();
        return;
      }

      if (Date.now() >= autoStakeSettings.candidate.readyAt) {
        if (best.id === autoStakeSettings.candidate.id && best.apy > current.apy) {
          autoStakeSettings.currentStrategy = best.id;
          autoStakeSettings.candidate = null;
          localStorage.setItem('blue_auto_stake', JSON.stringify(autoStakeSettings));

          if (best.real && best.adapter === 'lido') {
            toast('7-day APY confirmed. Use Stake ETH to execute Lido staking.');
          } else {
            toast('7-day APY confirmed. Adapter required for real auto-switch.');
          }

          updateWalletUi();
          return;
        }
      }

      localStorage.setItem('blue_auto_stake', JSON.stringify(autoStakeSettings));
      if (manual) toast('APY watch updated');
      updateWalletUi();
    }

