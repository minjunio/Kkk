<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Blue Wallet</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: light;
      --bg1: #eaf7ff;
      --bg2: #f8fbff;
      --bg3: #d8efff;
      --card: rgba(255,255,255,.88);
      --card2: rgba(255,255,255,.64);
      --solid: #ffffff;
      --solid2: #f4f9ff;
      --text: #0f172a;
      --muted: #64748b;
      --muted2: #94a3b8;
      --blue: #0284c7;
      --blue2: #2563eb;
      --pink: #e11d48;
      --green: #16a34a;
      --orange: #d97706;
      --border: rgba(15, 23, 42, .08);
      --border2: rgba(2,132,199,.22);
      --shadow: 0 24px 80px rgba(37,99,235,.13);
      --shadow2: 0 12px 34px rgba(15,23,42,.08);
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg1: #07111f;
      --bg2: #050816;
      --bg3: #0b2940;
      --card: rgba(13,22,40,.88);
      --card2: rgba(17,29,51,.7);
      --solid: #0d1628;
      --solid2: #111d33;
      --text: #f8fafc;
      --muted: #94a3b8;
      --muted2: #64748b;
      --blue: #38bdf8;
      --blue2: #2563eb;
      --border: rgba(125,211,252,.13);
      --border2: rgba(56,189,248,.28);
      --shadow: 0 24px 80px rgba(0,0,0,.36);
      --shadow2: 0 12px 34px rgba(0,0,0,.22);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at 12% 8%, rgba(56,189,248,.24), transparent 28%),
        radial-gradient(circle at 92% 12%, rgba(37,99,235,.13), transparent 24%),
        radial-gradient(circle at 50% 100%, rgba(14,165,233,.16), transparent 28%),
        linear-gradient(135deg, var(--bg1), var(--bg2) 48%, var(--bg3));
      background-attachment: fixed;
      overflow-x: hidden;
      padding-bottom: calc(86px + var(--safe-bottom));
    }

    button, input, select, textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: calc(10px + var(--safe-top)) 12px 10px;
      background: rgba(248,251,255,.72);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(18px);
    }

    [data-theme="dark"] .topbar {
      background: rgba(5,8,22,.76);
    }

    .topbar-inner {
      width: min(1040px, 100%);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .logo {
      width: 40px;
      height: 40px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      color: #fff;
      font-weight: 950;
      background: linear-gradient(135deg, var(--blue2), #38bdf8);
      box-shadow: 0 14px 32px rgba(37,99,235,.22);
      flex: 0 0 auto;
    }

    .brand-title {
      font-size: 1rem;
      font-weight: 950;
      letter-spacing: -.045em;
      white-space: nowrap;
    }

    .brand-sub {
      margin-top: 2px;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      color: var(--text);
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow2);
      font-weight: 950;
      transition: transform .18s ease, border-color .18s ease;
    }

    .icon-btn:hover {
      transform: translateY(-1px);
      border-color: var(--border2);
    }

    .shell {
      width: min(1040px, 100%);
      margin: 0 auto;
      padding: 12px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      border-radius: 30px;
      padding: 18px;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(22px);
    }

    .hero::before {
      content: "";
      position: absolute;
      right: -80px;
      bottom: -120px;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(2,132,199,.18), transparent 70%);
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      color: var(--blue);
      background: rgba(2,132,199,.08);
      border: 1px solid var(--border2);
      font-size: .74rem;
      font-weight: 950;
    }

    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--blue);
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(2,132,199,.42); }
      80% { box-shadow: 0 0 0 9px rgba(2,132,199,0); }
      100% { box-shadow: 0 0 0 0 rgba(2,132,199,0); }
    }

    .balance {
      margin-top: 12px;
      font-size: clamp(2.2rem, 12vw, 4.8rem);
      line-height: .95;
      font-weight: 950;
      letter-spacing: -.075em;
      font-variant-numeric: tabular-nums;
    }

    .address {
      margin-top: 10px;
      color: var(--muted);
      font-size: .8rem;
      font-weight: 800;
      word-break: break-all;
      line-height: 1.45;
    }

    .chips {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      scrollbar-width: none;
      margin-top: 13px;
      padding-bottom: 2px;
    }

    .chips::-webkit-scrollbar {
      display: none;
    }

    .chip {
      flex: 0 0 auto;
      padding: 8px 10px;
      border-radius: 999px;
      color: var(--muted);
      background: var(--card2);
      border: 1px solid var(--border);
      font-size: .72rem;
      font-weight: 900;
    }

    .quick {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      margin-top: 14px;
    }

    .quick-btn {
      min-height: 70px;
      border-radius: 21px;
      padding: 10px;
      color: var(--text);
      background: var(--solid);
      border: 1px solid var(--border);
      box-shadow: var(--shadow2);
      text-align: center;
      transition: transform .18s ease, border-color .18s ease;
    }

    .quick-btn.primary {
      color: #fff;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
      border-color: transparent;
    }

    .quick-btn:hover {
      transform: translateY(-1px);
      border-color: var(--border2);
    }

    .quick-btn strong {
      display: block;
      font-size: .86rem;
      font-weight: 950;
      margin-bottom: 4px;
    }

    .quick-btn span {
      color: var(--muted);
      font-size: .68rem;
      font-weight: 850;
    }

    .quick-btn.primary span {
      color: rgba(255,255,255,.82);
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 12px;
      margin-top: 12px;
    }

    .panel {
      border-radius: 24px;
      padding: 14px;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow2);
      backdrop-filter: blur(18px);
      overflow: hidden;
    }

    .panel + .panel {
      margin-top: 12px;
    }

    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 12px;
    }

    .title {
      font-size: 1rem;
      font-weight: 950;
      letter-spacing: -.04em;
    }

    .sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: .75rem;
      font-weight: 760;
      line-height: 1.45;
    }

    .list {
      display: grid;
      gap: 8px;
    }

    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
      padding: 12px;
      border-radius: 18px;
      background: var(--card2);
      border: 1px solid var(--border);
    }

    .asset {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .coin {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      background: var(--solid2);
      border: 1px solid var(--border);
      color: var(--blue);
      font-weight: 950;
      font-size: .72rem;
      overflow: hidden;
    }

    .coin img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .name {
      font-weight: 950;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tiny {
      margin-top: 3px;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
      word-break: break-word;
      line-height: 1.45;
    }

    .value {
      text-align: right;
      font-weight: 950;
      font-variant-numeric: tabular-nums;
    }

    .value-sub {
      margin-top: 3px;
      text-align: right;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
    }

    .small-btn, .primary-btn, .secondary-btn, .danger-btn {
      min-height: 44px;
      border-radius: 15px;
      font-weight: 950;
      transition: transform .18s ease, border-color .18s ease, opacity .18s ease;
    }

    .small-btn {
      padding: 0 12px;
      color: var(--text);
      background: var(--solid);
      border: 1px solid var(--border);
      font-size: .75rem;
      white-space: nowrap;
    }

    .primary-btn {
      color: #fff;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
      box-shadow: 0 14px 30px rgba(37,99,235,.18);
    }

    .secondary-btn {
      color: var(--text);
      background: var(--solid);
      border: 1px solid var(--border);
    }

    .danger-btn {
      color: #fff;
      background: linear-gradient(135deg, #be123c, #fb7185);
    }

    .small-btn:hover, .primary-btn:hover, .secondary-btn:hover, .danger-btn:hover {
      transform: translateY(-1px);
      border-color: var(--border2);
    }

    .primary-btn:disabled, .secondary-btn:disabled {
      opacity: .55;
      transform: none;
      cursor: not-allowed;
    }

    .pills {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      scrollbar-width: none;
      margin-bottom: 10px;
    }

    .pills::-webkit-scrollbar {
      display: none;
    }

    .pill {
      flex: 0 0 auto;
      min-height: 39px;
      padding: 0 13px;
      border-radius: 999px;
      background: var(--solid);
      color: var(--muted);
      border: 1px solid var(--border);
      font-size: .74rem;
      font-weight: 950;
    }

    .pill.active {
      color: #fff;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
      border-color: transparent;
    }

    .form {
      display: grid;
      gap: 10px;
    }

    .field {
      display: grid;
      gap: 7px;
    }

    label {
      color: var(--muted);
      font-size: .7rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .input, .select, .textarea {
      width: 100%;
      min-height: 46px;
      border-radius: 15px;
      padding: 12px;
      color: var(--text);
      background: var(--solid2);
      border: 1px solid var(--border);
      outline: none;
      font-weight: 850;
    }

    .textarea {
      min-height: 112px;
      resize: vertical;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: .8rem;
      line-height: 1.5;
    }

    .input:focus, .select:focus, .textarea:focus {
      border-color: var(--border2);
      box-shadow: 0 0 0 4px rgba(2,132,199,.08);
    }

    .button-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 10px;
    }

    .button-row.one {
      grid-template-columns: 1fr;
    }

    .box {
      margin-top: 10px;
      padding: 12px;
      border-radius: 18px;
      background: var(--card2);
      border: 1px solid var(--border);
    }

    .box.warn {
      color: var(--orange);
      background: rgba(217,119,6,.1);
      border-color: rgba(217,119,6,.18);
    }

    .box.good {
      color: var(--green);
      background: rgba(22,163,74,.09);
      border-color: rgba(22,163,74,.14);
    }

    .box.bad {
      color: var(--pink);
      background: rgba(225,29,72,.08);
      border-color: rgba(225,29,72,.14);
    }

    .modal-overlay, .drawer-overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      background: rgba(15,23,42,.42);
      backdrop-filter: blur(10px);
      padding: 10px;
    }

    .modal-overlay.active, .drawer-overlay.active {
      display: block;
    }

    .modal-card {
      width: min(520px, 100%);
      max-height: calc(100vh - 20px - var(--safe-top) - var(--safe-bottom));
      overflow-y: auto;
      margin: calc(10px + var(--safe-top)) auto 0;
      padding: 14px;
      border-radius: 26px;
      background: var(--solid);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      animation: pop .22s ease both;
    }

    .drawer {
      position: absolute;
      top: 0;
      right: 0;
      width: min(470px, 100%);
      height: 100%;
      overflow-y: auto;
      padding: calc(16px + var(--safe-top)) 14px calc(18px + var(--safe-bottom));
      background: var(--solid);
      border-left: 1px solid var(--border);
      box-shadow: -24px 0 80px rgba(0,0,0,.22);
      animation: slide .23s ease both;
    }

    @keyframes pop {
      from { transform: translateY(18px) scale(.98); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    @keyframes slide {
      from { transform: translateX(36px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    .modal-head, .drawer-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
      margin-bottom: 12px;
    }

    .modal-title, .drawer-title {
      font-size: 1.22rem;
      font-weight: 950;
      letter-spacing: -.055em;
    }

    .modal-sub, .drawer-sub {
      margin-top: 3px;
      color: var(--muted);
      font-size: .8rem;
      font-weight: 760;
      line-height: 1.45;
    }

    .close {
      width: 40px;
      height: 40px;
      border-radius: 15px;
      color: var(--text);
      background: var(--solid2);
      border: 1px solid var(--border);
      font-size: 1.2rem;
      font-weight: 950;
      flex: 0 0 auto;
    }

    .pin-dots {
      display: flex;
      justify-content: center;
      gap: 11px;
      margin: 18px 0 16px;
    }

    .pin-dot {
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: var(--solid2);
      border: 1px solid var(--border2);
    }

    .pin-dot.filled {
      background: var(--blue);
      border-color: var(--blue);
      box-shadow: 0 0 0 5px rgba(2,132,199,.08);
    }

    .pin-pad {
      width: min(310px, 100%);
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .pin-key {
      aspect-ratio: 1 / .78;
      border-radius: 22px;
      color: var(--text);
      background: var(--solid2);
      border: 1px solid var(--border);
      font-size: 1.25rem;
      font-weight: 950;
      box-shadow: var(--shadow2);
    }

    .pin-key.action {
      font-size: .78rem;
      color: var(--muted);
    }

    .secret-card {
      filter: blur(5px);
      user-select: none;
      transition: filter .2s ease;
    }

    .secret-card.visible {
      filter: none;
      user-select: text;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: calc(92px + var(--safe-bottom));
      transform: translateX(-50%) translateY(12px);
      z-index: 150;
      max-width: min(430px, calc(100% - 28px));
      padding: 12px 14px;
      border-radius: 16px;
      background: rgba(2,6,23,.92);
      color: #fff;
      box-shadow: var(--shadow2);
      opacity: 0;
      pointer-events: none;
      transition: all .22s ease;
      font-weight: 850;
      font-size: .84rem;
    }

    .toast.active {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(10px + var(--safe-bottom));
      transform: translateX(-50%);
      z-index: 70;
      width: min(430px, calc(100% - 24px));
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      padding: 7px;
      border-radius: 22px;
      background: rgba(255,255,255,.9);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(16px);
    }

    [data-theme="dark"] .bottom-nav {
      background: rgba(13,22,40,.9);
    }

    .bottom-nav button {
      min-height: 47px;
      border-radius: 16px;
      color: var(--muted);
      background: transparent;
      font-size: .7rem;
      font-weight: 950;
    }

    .bottom-nav button.active {
      color: #fff;
      background: linear-gradient(135deg, var(--blue2), var(--blue));
    }

    @media (max-width: 900px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      body {
        padding-bottom: calc(82px + var(--safe-bottom));
      }

      .shell {
        padding: 10px;
      }

      .topbar {
        padding-left: 10px;
        padding-right: 10px;
      }

      .hero {
        border-radius: 26px;
        padding: 14px;
      }

      .quick {
        grid-template-columns: repeat(2, 1fr);
      }

      .quick-btn {
        min-height: 68px;
      }

      .panel {
        padding: 12px;
        border-radius: 22px;
      }

      .row {
        grid-template-columns: 1fr;
      }

      .value, .value-sub {
        text-align: left;
      }

      .button-row {
        grid-template-columns: 1fr;
      }

      .brand-sub {
        display: none;
      }

      .icon-btn {
        width: 38px;
        height: 38px;
      }

      .drawer {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="logo">B</div>
        <div>
          <div class="brand-title">Blue Wallet</div>
          <div class="brand-sub" id="statusText">Cloud secure wallet</div>
        </div>
      </div>

      <div class="top-actions">
        <button class="icon-btn" onclick="refreshBalances()">⟳</button>
        <button class="icon-btn" onclick="openSettings()">⚙</button>
      </div>
    </div>
  </header>

  <main class="shell">
    <section class="hero">
      <div class="hero-content">
        <div class="badge"><span class="dot"></span><span id="lockBadge">Locked wallet</span></div>
        <div class="balance" id="totalBalance">0 assets</div>
        <div class="address" id="walletAddressText">Create or unlock your wallet to receive crypto.</div>

        <div class="chips">
          <span class="chip" id="activeNetworkText">Ethereum</span>
          <span class="chip" id="pinStateText">4-digit PIN encrypted</span>
          <span class="chip" id="tokenCountText">0 tokens</span>
        </div>

        <div class="quick">
          <button class="quick-btn primary" onclick="openModal('receiveModal')">
            <strong>Receive</strong>
            <span>Assets / USDT</span>
          </button>
          <button class="quick-btn" onclick="openModal('sendModal')">
            <strong>Send</strong>
            <span>Real tx</span>
          </button>
          <button class="quick-btn" onclick="openModal('swapModal')">
            <strong>Swap</strong>
            <span>Fee quote</span>
          </button>
          <button class="quick-btn" onclick="openModal('pinModal')">
            <strong>Unlock</strong>
            <span>PIN pad</span>
          </button>
        </div>
      </div>
    </section>

    <section class="grid">
      <div>
        <section class="panel" id="assetsSection">
          <div class="panel-head">
            <div>
              <h2 class="title">Assets</h2>
              <p class="sub">Native coin and popular tokens on the selected network.</p>
            </div>
            <button class="small-btn" onclick="refreshBalances()">Refresh</button>
          </div>
          <div class="list" id="tokenList"></div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <div>
              <h2 class="title">Receive networks</h2>
              <p class="sub">USDT and tokens use the same address on each EVM network.</p>
            </div>
          </div>
          <div class="pills" id="networkPills"></div>
