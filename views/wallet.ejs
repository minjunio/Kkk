    const ERC20_ABI = [
      'function balanceOf(address owner) view returns (uint256)',
      'function transfer(address to, uint256 amount) returns (bool)',
      'function decimals() view returns (uint8)',
      'function symbol() view returns (string)',
      'function approve(address spender, uint256 amount) returns (bool)',
      'function allowance(address owner, address spender) view returns (uint256)'
    ];

    let activeNetworkKey = localStorage.getItem('blue_active_network') || 'ethereum';
    let ACTIVE_DECRYPTED_WALLET = null;
    let activeProvider = null;
    let activeSigner = null;
    let balances = [];
    let toastTimer;
    let pinMode = 'unlock';
    let pinBuffer = '';

    function toast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.add('active');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove('active'), 2600);
    }

    function short(addr) {
      if (!addr) return 'No wallet';
      return `${addr.slice(0,6)}...${addr.slice(-4)}`;
    }

    function fmt(v, d = 6) {
      return Number(v || 0).toLocaleString(undefined, { maximumFractionDigits: d });
    }

    function icon(symbol) {
      return `<div class="coin"><img src="https://assets.coincap.io/assets/icons/${String(symbol).toLowerCase()}@2x.png" onerror="this.remove();this.parentNode.textContent='${String(symbol).slice(0,4)}'" /></div>`;
    }

    function rpcUrl(key = activeNetworkKey) {
      return localStorage.getItem(`blue_rpc_${key}`) || NETWORKS[key].rpc;
    }

    function provider(key = activeNetworkKey) {
      return new ethers.JsonRpcProvider(rpcUrl(key), NETWORKS[key].chainId);
    }

    function getPublicWallet() {
      const local = JSON.parse(localStorage.getItem('bluecrypto_public_wallets') || '[]');
      return local[0] || SERVER_WALLET?.publicWallets?.[0] || null;
    }

    function currentAddress() {
      return getPublicWallet()?.address || ACTIVE_DECRYPTED_WALLET?.wallets?.[0]?.address || null;
    }

    function openModal(id) {
      document.getElementById(id).classList.add('active');
      if (id === 'pinModal') resetPin();
      renderAllSelects();
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    function overlayClose(e, id) {
      if (e.target.id === id) document.getElementById(id).classList.remove('active');
    }

    function openSettings() {
      document.getElementById('settingsOverlay').classList.add('active');
      renderSettings();
    }

    function closeSettings() {
      document.getElementById('settingsOverlay').classList.remove('active');
    }

    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('blue_theme', theme);
      toast(`${theme} mode enabled`);
    }

    function renderPinPad() {
      const dots = document.getElementById('pinDots');
      dots.innerHTML = Array.from({length:4}).map((_, i) => `<div class="pin-dot ${i < pinBuffer.length ? 'filled' : ''}"></div>`).join('');

      const pad = document.getElementById('pinPad');
      const keys = ['1','2','3','4','5','6','7','8','9','clear','0','del'];

      pad.innerHTML = keys.map(k => {
        const label = k === 'del' ? '⌫' : k === 'clear' ? 'Clear' : k;
        return `<button class="pin-key ${isNaN(Number(k)) ? 'action' : ''}" onclick="pinPress('${k}')">${label}</button>`;
      }).join('');

      document.getElementById('pinTitle').textContent = pinMode === 'create' ? 'Create wallet PIN' : 'Unlock wallet';
      document.getElementById('pinSubtitle').textContent = pinMode === 'create'
        ? 'Choose a 4-digit PIN to encrypt your wallet.'
        : 'Enter your 4-digit wallet PIN.';

      document.getElementById('unlockTab').classList.toggle('active', pinMode === 'unlock');
      document.getElementById('createTab').classList.toggle('active', pinMode === 'create');
    }

    function resetPin() {
      pinBuffer = '';
      renderPinPad();
    }

    function setPinMode(mode) {
      pinMode = mode;
      resetPin();
    }

    async function pinPress(k) {
      if (k === 'clear') {
        pinBuffer = '';
        renderPinPad();
        return;
      }

      if (k === 'del') {
        pinBuffer = pinBuffer.slice(0, -1);
        renderPinPad();
        return;
      }

      if (pinBuffer.length >= 4) return;

      pinBuffer += k;
      renderPinPad();

      if (pinBuffer.length === 4) {
        if (pinMode === 'create') await createWalletWithPin(pinBuffer);
        else await unlockWithPin(pinBuffer);
      }
    }

    function bytesToBase64(bytes) {
      return btoa(String.fromCharCode(...new Uint8Array(bytes)));
    }

    function base64ToBytes(base64) {
      return Uint8Array.from(atob(base64), c => c.charCodeAt(0));
    }

    async function deriveAesKey(secret, saltBase64) {
      const salt = base64ToBytes(saltBase64);
      const keyMaterial = await crypto.subtle.importKey(
        'raw',
        new TextEncoder().encode(secret),
        'PBKDF2',
        false,
        ['deriveKey']
      );

      return crypto.subtle.deriveKey(
        { name:'PBKDF2', salt, iterations:250000, hash:'SHA-256' },
        keyMaterial,
        { name:'AES-GCM', length:256 },
        false,
        ['encrypt','decrypt']
      );
    }

    async function encryptVault(vaultObject, secret) {
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const saltBase64 = bytesToBase64(salt);
      const key = await deriveAesKey(secret, saltBase64);

      const encrypted = await crypto.subtle.encrypt(
        { name:'AES-GCM', iv },
        key,
        new TextEncoder().encode(JSON.stringify(vaultObject))
      );

      return {
        version: 1,
        pinLength: 4,
        kdf: 'PBKDF2-SHA256',
        cipher: 'AES-GCM',
        iterations: 250000,
        salt: saltBase64,
        iv: bytesToBase64(iv),
        data: bytesToBase64(encrypted)
      };
    }

    async function decryptVault(encryptedVault, secret) {
      const key = await deriveAesKey(secret, encryptedVault.salt);
      const iv = base64ToBytes(encryptedVault.iv);
      const data = base64ToBytes(encryptedVault.data);

      const decrypted = await crypto.subtle.decrypt({ name:'AES-GCM', iv }, key, data);
      return JSON.parse(new TextDecoder().decode(decrypted));
    }

    function generateWallet() {
      const w = ethers.Wallet.createRandom();
      return {
        type: 'evm',
        phrase: w.mnemonic.phrase,
        privateKey: w.privateKey,
        address: w.address,
        createdAt: new Date().toISOString()
      };
    }

    async function saveVault(encryptedVault, publicWallets) {
      const res = await fetch('/api/wallet/vault', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ encryptedVault, publicWallets })
      });

      if (!res.ok) throw new Error('Could not save wallet vault');
      return res.json();
    }

    async function createWalletWithPin(pin) {
      try {
        if (SERVER_WALLET?.encryptedVault) {
          toast('Wallet already exists. Unlock it instead.');
          setPinMode('unlock');
          return;
        }

        const real = generateWallet();
        const vault = { wallets: [real], createdAt: new Date().toISOString() };
        const secret = `${CURRENT_EMAIL}:${pin}`;
        const encryptedVault = await encryptVault(vault, secret);

        const publicWallets = [{
          type: 'evm',
          address: real.address,
          networks: Object.values(NETWORKS).map(n => n.name),
          createdAt: real.createdAt
        }];

        await saveVault(encryptedVault, publicWallets);
        localStorage.setItem('bluecrypto_public_wallets', JSON.stringify(publicWallets));

        ACTIVE_DECRYPTED_WALLET = vault;
        activeProvider = provider();
        activeSigner = new ethers.Wallet(real.privateKey, activeProvider);

        closeModal('pinModal');
        toast('Wallet created and encrypted');

        updateUi();
        refreshBalances();
      } catch (err) {
        console.error(err);
        toast(err.message || 'Wallet creation failed');
        resetPin();
      }
    }

    async function unlockWithPin(pin) {
      try {
        if (!SERVER_WALLET?.encryptedVault) {
          toast('No wallet exists. Create one first.');
          setPinMode('create');
          return;
        }

        const secret = `${CURRENT_EMAIL}:${pin}`;
        ACTIVE_DECRYPTED_WALLET = await decryptVault(SERVER_WALLET.encryptedVault, secret);

        activeProvider = provider();
        activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey, activeProvider);

        closeModal('pinModal');
        toast('Wallet unlocked');

        updateUi();
        refreshBalances();
      } catch (err) {
        console.error(err);
        toast('Wrong PIN');
        resetPin();
      }
    }

    async function unlockFromSettings() {
      const pin = document.getElementById('settingsPin').value.trim();
      if (!/^[0-9]{4}$/.test(pin)) {
        toast('Enter a 4-digit PIN');
        return false;
      }
      await unlockWithPin(pin);
      return Boolean(ACTIVE_DECRYPTED_WALLET);
    }

    async function ensureUnlocked() {
      if (activeSigner) return activeSigner;
      openModal('pinModal');
      throw new Error('Unlock wallet first');
    }

    function renderNetworks() {
      document.getElementById('networkPills').innerHTML = Object.entries(NETWORKS).map(([k,n]) => `
        <button class="pill ${k === activeNetworkKey ? 'active' : ''}" onclick="setNetwork('${k}')">${n.name}</button>
      `).join('');

      document.getElementById('networkList').innerHTML = Object.entries(NETWORKS).map(([k,n]) => `
        <div class="row">
          <div>
            <div class="name">${n.name}</div>
            <div class="tiny">${n.symbol} · Chain ${n.chainId} · ${short(currentAddress())}</div>
          </div>
          <button class="small-btn" onclick="setNetwork('${k}')">${k === activeNetworkKey ? 'Active' : 'Use'}</button>
        </div>
      `).join('');
    }

    function setNetwork(k) {
      activeNetworkKey = k;
      localStorage.setItem('blue_active_network', k);
      activeProvider = provider();
      if (ACTIVE_DECRYPTED_WALLET) {
        activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey, activeProvider);
      }
      updateUi();
      refreshBalances();
    }

    function receiveOptionsFor(networkKey) {
      const net = NETWORKS[networkKey];
      return [
        { type:'native', symbol: net.symbol, name: `${net.symbol} native`, address: NATIVE_TOKEN, decimals:18 },
        ...(ERC20_TOKENS[networkKey] || [])
      ];
    }

    function renderReceiveSelects() {
      const n = document.getElementById('receiveNetworkSelect');
      if (!n) return;

      n.innerHTML = Object.entries(NETWORKS).map(([k,v]) => `<option value="${k}">${v.name}</option>`).join('');
      n.value = activeNetworkKey;
      renderReceiveAssets();
    }

    function renderReceiveAssets() {
      const k = document.getElementById('receiveNetworkSelect').value;
      const a = document.getElementById('receiveAssetSelect');

      a.innerHTML = receiveOptionsFor(k).map(x => `<option value="${x.address}">${x.symbol} · ${x.name}</option>`).join('');
      renderReceiveCard();
    }

    function renderReceiveCard() {
      const k = document.getElementById('receiveNetworkSelect').value;
      const selected = document.getElementById('receiveAssetSelect');
      const assetName = selected.selectedOptions[0]?.textContent || 'Asset';
      const addr = currentAddress();

      document.getElementById('receiveAssetName').textContent = `Receive ${assetName} on ${NETWORKS[k].name}`;
      document.getElementById('receiveAddressText').textContent = addr
        ? `${addr} — only send ${assetName} on ${NETWORKS[k].name}`
        : 'Create or unlock wallet first.';
    }

    function setReceiveNetworkActive() {
      const k = document.getElementById('receiveNetworkSelect').value;
      setNetwork(k);
      closeModal('receiveModal');
    }

    function copyReceiveAddress() {
      const addr = currentAddress();
      if (!addr) return toast('No address available');
      navigator.clipboard?.writeText(addr);
      toast('Address copied');
    }

    function copyAddress() {
      copyReceiveAddress();
    }

    function renderAssetSelects() {
      const net = NETWORKS[activeNetworkKey];
      const opts = [
        `<option value="native">${net.symbol} · Native</option>`,
        ...(ERC20_TOKENS[activeNetworkKey] || []).map(t => `<option value="${t.address}">${t.symbol} · ${t.name}</option>`)
      ].join('');

      const send = document.getElementById('sendAssetSelect');
      if (send) send.innerHTML = opts;

      const sell = document.getElementById('swapSellSelect');
      if (sell) sell.innerHTML = [
        `<option value="${NATIVE_TOKEN}">${net.symbol} · Native</option>`,
        ...(ERC20_TOKENS[activeNetworkKey] || []).map(t => `<option value="${t.address}">${t.symbol} · ${t.name}</option>`)
      ].join('');

      const buy = document.getElementById('swapBuySelect');
      if (buy) buy.innerHTML = (ERC20_TOKENS[activeNetworkKey] || []).map(t => `<option value="${t.address}">${t.symbol} · ${t.name}</option>`).join('');
    }

    function renderAllSelects() {
      renderAssetSelects();
      renderReceiveSelects();
    }

    async function refreshBalances() {
      try {
        const addr = currentAddress();
        if (!addr) {
          renderTokenList([]);
          return;
        }

        document.getElementById('statusText').textContent = 'Reading balances...';

        const p = provider();
        const net = NETWORKS[activeNetworkKey];
        const native = Number(ethers.formatEther(await p.getBalance(addr)));

        const out = [{ type:'native', symbol:net.symbol, name:net.name, balance:native, decimals:18, address:null }];

        for (const token of ERC20_TOKENS[activeNetworkKey] || []) {
          try {
            const c = new ethers.Contract(token.address, ERC20_ABI, p);
            const raw = await c.balanceOf(addr);
            out.push({ ...token, type:'erc20', balance:Number(ethers.formatUnits(raw, token.decimals)) });
          } catch {
            out.push({ ...token, type:'erc20', balance:0, error:true });
          }
        }

        balances = out;
        renderTokenList(out);
        document.getElementById('statusText').textContent = 'Balances updated';
      } catch (err) {
        console.error(err);
        toast('Balance read failed. Check RPC.');
        document.getElementById('statusText').textContent = 'RPC error';
      }
    }

    function renderTokenList(list) {
      const el = document.getElementById('tokenList');

      if (!list.length) {
        el.innerHTML = `
          <div class="row">
            <div>
              <div class="name">No wallet loaded</div>
              <div class="tiny">Tap Unlock or Settings to create your 4-digit PIN wallet.</div>
            </div>
            <button class="small-btn" onclick="openModal('pinModal')">Open</button>
          </div>`;
        document.getElementById('totalBalance').textContent = '0 assets';
        document.getElementById('tokenCountText').textContent = '0 tokens';
        return;
      }

      el.innerHTML = list.map(t => `
        <div class="row">
          <div class="asset">
            ${icon(t.symbol)}
            <div>
              <div class="name">${t.symbol}</div>
              <div class="tiny">${t.name}${t.error ? ' · read error' : ''}</div>
            </div>
          </div>
          <div>
            <div class="value">${fmt(t.balance, t.balance < 1 ? 8 : 6)}</div>
            <div class="value-sub">${t.type === 'native' ? 'Native' : 'ERC-20'}</div>
          </div>
        </div>
      `).join('');

      const nonZero = list.filter(x => Number(x.balance) > 0).length;
      document.getElementById('totalBalance').textContent = `${nonZero}/${list.length} assets`;
      document.getElementById('tokenCountText').textContent = `${list.length} tokens`;
    }

    function updateUi() {
      const addr = currentAddress();
      const net = NETWORKS[activeNetworkKey];

      document.getElementById('walletAddressText').textContent = addr
        ? `${net.name}: ${addr}`
        : 'Create or unlock your wallet to receive crypto.';

      document.getElementById('activeNetworkText').textContent = net.name;
      document.getElementById('lockBadge').textContent = activeSigner ? 'Unlocked wallet' : 'Locked wallet';
      document.getElementById('swapNetworkHint').textContent = `${net.name} swap routing`;
      document.getElementById('settingsAddress').textContent = addr || 'No wallet loaded';
      document.getElementById('settingsReceiveOptions').textContent =
        `Native ${net.symbol}, ${receiveOptionsFor(activeNetworkKey).map(x => x.symbol).join(', ')} on ${net.name}`;

      document.getElementById('walletMiniList').innerHTML = `
        <div class="row">
          <div>
            <div class="name">${addr ? short(addr) : 'No wallet'}</div>
            <div class="tiny">${addr ? 'EVM address active on all supported networks' : 'Create wallet from PIN pad'}</div>
          </div>
          <button class="small-btn" onclick="openSettings()">Info</button>
        </div>
      `;

      renderNetworks();
      renderAllSelects();
    }

    function getTokenByAddress(address) {
      return (ERC20_TOKENS[activeNetworkKey] || []).find(t => t.address.toLowerCase() === String(address).toLowerCase());
    }

    async function estimateSendFee() {
      try {
        if (!activeSigner) {
          document.getElementById('sendFeePreview').textContent = 'Unlock wallet to estimate gas.';
          return null;
        }

        const asset = document.getElementById('sendAssetSelect').value;
        const to = document.getElementById('sendToInput').value.trim();
        const amount = document.getElementById('sendAmountInput').value.trim();

        if (!ethers.isAddress(to) || !amount || Number(amount) <= 0) {
          document.getElementById('sendFeePreview').textContent = 'Enter valid address and amount.';
          return null;
        }

        let gas;
        if (asset === 'native') {
          gas = await activeSigner.estimateGas({ to, value: ethers.parseEther(amount) });
        } else {
          const token = getTokenByAddress(asset);
          const c = new ethers.Contract(asset, ERC20_ABI, activeSigner);
          gas = await c.transfer.estimateGas(to, ethers.parseUnits(amount, token.decimals));
        }

        const feeData = await activeSigner.provider.getFeeData();
        const gasPrice = feeData.gasPrice || 0n;
        const total = gas * gasPrice;

        document.getElementById('sendFeePreview').textContent =
          `Gas ${gas.toString()} · fee ≈ ${ethers.formatEther(total)} ${NETWORKS[activeNetworkKey].symbol}`;

        return gas;
      } catch (err) {
        document.getElementById('sendFeePreview').textContent = err.shortMessage || err.message || 'Fee estimate failed';
        return null;
      }
    }

    function openSendConfirm() {
      const asset = document.getElementById('sendAssetSelect').selectedOptions[0]?.textContent || '';
      const to = document.getElementById('sendToInput').value.trim();
      const amount = document.getElementById('sendAmountInput').value.trim();

      document.getElementById('sendConfirmText').textContent =
        `Send ${amount || '0'} ${asset} to ${to || 'no address'} on ${NETWORKS[activeNetworkKey].name}.`;

      openModal('sendConfirmModal');
    }

    async function sendRealTransaction() {
      try {
        const signer = await ensureUnlocked();
        const asset = document.getElementById('sendAssetSelect').value;
        const to = document.getElementById('sendToInput').value.trim();
        const amount = document.getElementById('sendAmountInput').value.trim();

        if (!ethers.isAddress(to)) throw new Error('Invalid address');
        if (!amount || Number(amount) <= 0) throw new Error('Invalid amount');

        let tx;
        if (asset === 'native') {
          tx = await signer.sendTransaction({ to, value: ethers.parseEther(amount) });
        } else {
          const token = getTokenByAddress(asset);
          const c = new ethers.Contract(asset, ERC20_ABI, signer);
          tx = await c.transfer(to, ethers.parseUnits(amount, token.decimals));
        }

        closeModal('sendConfirmModal');
        closeModal('sendModal');
        toast('Transaction sent');

        await tx.wait();

        toast('Transaction confirmed');
        refreshBalances();
      } catch (err) {
        console.error(err);
        toast(err.shortMessage || err.message || 'Send failed');
      }
    }

    function sellTokenMeta() {
      const val = document.getElementById('swapSellSelect').value;
      if (val === NATIVE_TOKEN) return { symbol: NETWORKS[activeNetworkKey].symbol, decimals: 18, address: NATIVE_TOKEN };
      return getTokenByAddress(val);
    }

    async function estimateSwapFee() {
      const amount = document.getElementById('swapAmount').value.trim();
      const sell = sellTokenMeta();
      const buyAddr = document.getElementById('swapBuySelect').value;
      const buy = getTokenByAddress(buyAddr);

      if (!amount || Number(amount) <= 0) {
        document.getElementById('swapQuoteText').textContent = 'Enter amount to estimate fee.';
        return;
      }

      document.getElementById('swapQuoteText').textContent =
        `Estimated route: ${amount} ${sell?.symbol || 'SELL'} → ${buy?.symbol || 'BUY'} on ${NETWORKS[activeNetworkKey].name}. Get quote for exact gas and fee.`;
    }

    async function getSwapQuote() {
      try {
        const signer = await ensureUnlocked();
        const sellToken = document.getElementById('swapSellSelect').value;
        const buyToken = document.getElementById('swapBuySelect').value;
        const amount = document.getElementById('swapAmount').value.trim();
        const sell = sellTokenMeta();

        if (!amount || Number(amount) <= 0) throw new Error('Invalid amount');

        const sellAmount = ethers.parseUnits(amount, sell.decimals).toString();

        const res = await fetch('/api/swap/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            chainId: NETWORKS[activeNetworkKey].chainId,
            network: activeNetworkKey,
            taker: await signer.getAddress(),
            sellToken,
            buyToken,
            sellAmount
          })
        });

        if (!res.ok) throw new Error('Swap quote route is not ready on server.');

        const quote = await res.json();
        window.__BLUE_SWAP_QUOTE = quote;

        document.getElementById('swapQuoteText').textContent =
          `Quote ready. Estimated gas: ${quote.gas || 'N/A'} · protocol fee: ${quote.protocolFee || '0'} · review before swap.`;

        toast('Quote loaded');
      } catch (err) {
        console.error(err);
        document.getElementById('swapQuoteText').textContent = err.message || 'Quote failed';
        toast(err.message || 'Quote failed');
      }
    }

    function openSwapConfirm() {
      const q = window.__BLUE_SWAP_QUOTE;
      if (!q) return toast('Get a quote first');

      document.getElementById('swapConfirmText').textContent =
        `Execute swap on ${NETWORKS[activeNetworkKey].name}. Gas: ${q.gas || 'N/A'}.`;

      openModal('swapConfirmModal');
    }

    async function executeSwap() {
      try {
        const q = window.__BLUE_SWAP_QUOTE;
        if (!q) throw new Error('Get quote first');

        const signer = await ensureUnlocked();

        const tx = await signer.sendTransaction({
          to: q.to,
          data: q.data,
          value: q.value ? BigInt(q.value) : 0n,
          gasLimit: q.gas ? BigInt(q.gas) : undefined
        });

        closeModal('swapConfirmModal');
        closeModal('swapModal');
        toast('Swap sent');

        await tx.wait();

        toast('Swap confirmed');
        refreshBalances();
      } catch (err) {
        console.error(err);
        toast(err.shortMessage || err.message || 'Swap failed');
      }
    }

    async function showSeed() {
      const pin = document.getElementById('settingsPin').value.trim();
      if (!ACTIVE_DECRYPTED_WALLET) await unlockWithPin(pin);
      if (!ACTIVE_DECRYPTED_WALLET) return;

      const out = document.getElementById('secretOutput');
      out.value = ACTIVE_DECRYPTED_WALLET.wallets[0].phrase;
      out.classList.add('visible');
      toast('Seed phrase shown');
    }

    async function showPrivateKey() {
      const pin = document.getElementById('settingsPin').value.trim();
      if (!ACTIVE_DECRYPTED_WALLET) await unlockWithPin(pin);
      if (!ACTIVE_DECRYPTED_WALLET) return;

      const out = document.getElementById('secretOutput');
      out.value = ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey;
      out.classList.add('visible');
      toast('Private key shown');
    }

    function saveCustomRpc() {
      const v = document.getElementById('customRpcInput').value.trim();
      if (!v.startsWith('http')) return toast('Enter a valid RPC URL');

      localStorage.setItem(`blue_rpc_${activeNetworkKey}`, v);
      activeProvider = provider();

      if (ACTIVE_DECRYPTED_WALLET) {
        activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey, activeProvider);
      }

      toast('RPC saved');
      refreshBalances();
    }

    function initialize() {
      document.documentElement.setAttribute('data-theme', localStorage.getItem('blue_theme') || 'light');

      if (SERVER_WALLET?.publicWallets) {
        localStorage.setItem('bluecrypto_public_wallets', JSON.stringify(SERVER_WALLET.publicWallets));
      }

      activeProvider = provider();

      renderPinPad();
      updateUi();

      if (!SERVER_WALLET?.encryptedVault) {
        setTimeout(() => {
          setPinMode('create');
          openModal('pinModal');
          toast('Create a 4-digit wallet PIN');
        }, 500);
      } else {
        refreshBalances();
      }
    }

    window.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        closeSettings();
        document.querySelectorAll('.modal-overlay.active').forEach(x => x.classList.remove('active'));
      }
    });

    initialize();
  </script>
</body>
</html>