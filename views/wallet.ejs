<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>BlueCrypto</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: light;
      --bg1: #e9f8ff;
      --bg2: #f8fcff;
      --bg3: #d7f0ff;
      --glass: rgba(255,255,255,0.85);
      --glass2: rgba(255,255,255,0.65);
      --solid: #ffffff;
      --soft: #f0f7ff;
      --text: #0f172a;
      --muted: #64748b;
      --muted2: #94a3b8;
      --blue: #0284c7;
      --blue2: #2563eb;
      --cyan: #38bdf8;
      --pink: #e11d48;
      --orange: #d97706;
      --green: #10b981;
      --border: rgba(2,132,199,0.12);
      --border2: rgba(2,132,199,0.35);
      --shadow: 0 24px 64px rgba(37,99,235,0.12);
      --shadow2: 0 12px 32px rgba(2,132,199,0.08);
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg1: #06111f;
      --bg2: #050816;
      --bg3: #0a2942;
      --glass: rgba(13,22,40,0.88);
      --glass2: rgba(17,29,51,0.72);
      --solid: #0d1628;
      --soft: #111d33;
      --text: #f8fafc;
      --muted: #94a3b8;
      --muted2: #64748b;
      --blue: #38bdf8;
      --border: rgba(125,211,252,0.16);
      --border2: rgba(56,189,248,0.36);
      --shadow: 0 28px 86px rgba(0,0,0,0.5);
      --shadow2: 0 14px 38px rgba(0,0,0,0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, -apple-system, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    /* Fixed manual scrolling by removing overflow limits */
    html, body {
      width: 100%;
      min-height: 100vh;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }

    body {
      color: var(--text);
      background:
        radial-gradient(circle at 10% 0%, rgba(56,189,248,0.25), transparent 35%),
        radial-gradient(circle at 90% 15%, rgba(37,99,235,0.15), transparent 30%),
        radial-gradient(circle at 50% 100%, rgba(14,165,233,0.2), transparent 40%),
        linear-gradient(135deg, var(--bg1), var(--bg2) 50%, var(--bg3));
      background-attachment: fixed;
      padding-bottom: calc(92px + var(--safe-bottom));
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    button, input, select, textarea { font: inherit; outline: none; }
    button { border: 0; cursor: pointer; transition: transform 0.1s ease, filter 0.1s ease; }
    button:active { transform: scale(0.97); filter: brightness(0.95); }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: calc(10px + var(--safe-top)) 12px 10px;
      background: rgba(248,251,255,0.7);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }

    [data-theme="dark"] .topbar { background: rgba(5,8,22,0.8); }

    .topbar-inner {
      width: min(980px, 100%);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .logo {
      width: 46px;
      height: 46px;
      border-radius: 18px;
      display: grid;
      place-items: center;
      color: white;
      font-weight: 900;
      font-size: 1.2rem;
      background: linear-gradient(135deg, var(--blue2), var(--cyan));
      box-shadow: 0 12px 28px rgba(37,99,235,0.25);
    }

    .brand-title { font-weight: 900; letter-spacing: -0.04em; font-size: 1.1rem; }
    .brand-sub { color: var(--muted); font-size: 0.75rem; font-weight: 700; margin-top: 2px; }
    .top-actions { display: flex; gap: 8px; }

    .icon-btn {
      width: 44px; height: 44px; border-radius: 16px; background: var(--glass);
      border: 1px solid var(--border); color: var(--text); box-shadow: var(--shadow2);
      backdrop-filter: blur(16px); font-weight: 900; display: grid; place-items: center;
    }

    .shell { width: min(980px, 100%); margin: 0 auto; padding: 12px; }

    .hero {
      position: relative; overflow: hidden; border-radius: 32px; padding: 24px;
      background: var(--glass); border: 1px solid var(--border); box-shadow: var(--shadow);
      backdrop-filter: blur(32px); -webkit-backdrop-filter: blur(32px);
    }

    .hero::before {
      content: ""; position: absolute; right: -80px; bottom: -100px; width: 280px; height: 280px;
      border-radius: 50%; background: radial-gradient(circle, rgba(2,132,199,0.2), transparent 60%); pointer-events: none;
    }

    .badge {
      display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 99px;
      color: var(--blue); background: rgba(2,132,199,0.1); border: 1px solid var(--border2);
      font-size: 0.75rem; font-weight: 800; margin-bottom: 8px;
    }

    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); animation: pulse 2s infinite; }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(2,132,199,0.5); }
      70% { box-shadow: 0 0 0 8px rgba(2,132,199,0); }
      100% { box-shadow: 0 0 0 0 rgba(2,132,199,0); }
    }

    .balance { font-size: clamp(2.8rem, 12vw, 5.5rem); font-weight: 900; line-height: 1; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; margin-top: 4px; }

    .pnl-line {
      margin-top: 12px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px;
      border-radius: 99px; background: var(--glass2); border: 1px solid var(--border);
      color: var(--muted); font-weight: 800; font-size: 0.85rem;
    }
    .pnl-line.up { color: var(--blue); background: rgba(2,132,199,0.08); border-color: rgba(2,132,199,0.15); }
    .pnl-line.down { color: var(--pink); background: rgba(225,29,72,0.08); border-color: rgba(225,29,72,0.15); }

    .market-strip { margin-top: 24px; display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-bottom: 8px; }
    .market-strip::-webkit-scrollbar { display: none; }

    .market-card {
      flex: 0 0 148px; scroll-snap-align: start; padding: 14px; border-radius: 22px;
      background: var(--glass2); border: 1px solid var(--border); box-shadow: var(--shadow2);
      color: var(--text); text-align: left;
    }
    .market-card strong { display: block; font-size: 0.9rem; font-weight: 900; margin-top: 8px; }
    .market-price { margin-top: 4px; font-size: 1.05rem; font-weight: 900; font-variant-numeric: tabular-nums; }
    .change { margin-top: 4px; font-size: 0.75rem; font-weight: 800; }
    .change.up { color: var(--blue); } .change.down { color: var(--pink); }

    .quick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; }
    .quick-btn {
      min-height: 76px; border-radius: 24px; padding: 12px; text-align: center; color: var(--text);
      background: var(--solid); border: 1px solid var(--border); box-shadow: var(--shadow2);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .quick-btn.primary { color: white; background: linear-gradient(135deg, var(--blue2), var(--cyan)); border: none; box-shadow: 0 16px 32px rgba(37,99,235,0.25); }
    .quick-btn strong { font-size: 0.95rem; font-weight: 900; margin-bottom: 4px; }
    .quick-btn span { color: var(--muted); font-size: 0.7rem; font-weight: 700; }
    .quick-btn.primary span { color: rgba(255,255,255,0.9); }

    .panel {
      margin-top: 14px; border-radius: 28px; padding: 20px; background: var(--glass);
      border: 1px solid var(--border); box-shadow: var(--shadow2);
      backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    }
    .panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .title { font-size: 1.25rem; font-weight: 900; letter-spacing: -0.03em; }

    .asset-scroll { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-bottom: 6px; }
    .asset-scroll::-webkit-scrollbar { display: none; }

    .asset-card, .staking-card {
      flex: 0 0 190px; scroll-snap-align: start; border-radius: 24px; padding: 16px;
      background: var(--glass2); border: 1px solid var(--border); color: var(--text);
      text-align: left; box-shadow: var(--shadow2);
    }
    .asset-card.watch { background: linear-gradient(180deg, var(--glass2), rgba(255,255,255,0.3)); }
    [data-theme="dark"] .asset-card.watch { background: linear-gradient(180deg, var(--glass2), rgba(17,29,51,0.4)); }
    .asset-card.selected, .receive-option.selected { border-color: var(--cyan); box-shadow: 0 0 0 4px rgba(56,189,248,0.2); }

    .asset-top { display: flex; align-items: center; gap: 12px; }
    .coin {
      width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%;
      background: var(--soft); border: 1px solid var(--border); color: var(--blue);
      font-weight: 900; font-size: 0.75rem; overflow: hidden; flex-shrink: 0;
    }
    /* Fixed logo sharpness: removed destructive CSS rendering props, relying on layout */
    .coin img { width: 100%; height: 100%; object-fit: contain; }

    .name { font-weight: 900; font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tiny { color: var(--muted); font-size: 0.75rem; font-weight: 700; margin-top: 2px; }
    .asset-value { margin-top: 14px; font-size: 1.25rem; font-weight: 900; font-variant-numeric: tabular-nums; }
    .asset-sub { margin-top: 6px; color: var(--muted); font-size: 0.75rem; font-weight: 700; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .apy { margin-top: 12px; font-size: 1.8rem; font-weight: 900; color: var(--blue); letter-spacing: -0.04em; }

    .small-btn { height: 38px; padding: 0 14px; font-size: 0.85rem; border-radius: 16px; font-weight: 800; background: var(--solid); border: 1px solid var(--border); color: var(--text); }
    .primary-btn { width: 100%; height: 52px; border-radius: 20px; font-size: 0.95rem; font-weight: 900; color: white; background: linear-gradient(135deg, var(--blue2), var(--cyan)); box-shadow: 0 12px 24px rgba(37,99,235,0.25); }
    .secondary-btn { width: 100%; height: 52px; border-radius: 20px; font-size: 0.95rem; font-weight: 800; background: var(--solid); border: 1px solid var(--border); color: var(--text); }

    .form { display: grid; gap: 12px; }
    .field { display: grid; gap: 8px; }
    label { color: var(--muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }

    .input, .select {
      width: 100%; height: 54px; padding: 0 16px; border-radius: 18px; background: var(--soft);
      border: 1px solid var(--border); color: var(--text); font-weight: 800; font-size: 0.95rem; transition: border-color 0.2s;
    }
    .input:focus, .select:focus { border-color: var(--cyan); }
    .select {
      appearance: none; -webkit-appearance: none;
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat; background-position: right 16px center; background-size: 18px; padding-right: 48px;
    }

    .box { padding: 18px; border-radius: 24px; background: var(--glass2); border: 1px solid var(--border); }
    .box.bad { color: var(--pink); background: rgba(225,29,72,0.06); border-color: rgba(225,29,72,0.15); }

    .receive-hero {
      display: flex; flex-direction: column; align-items: center; background: var(--solid);
      border-radius: 28px; padding: 24px; border: 1px solid var(--border); margin-bottom: 16px; box-shadow: var(--shadow2);
    }
    .qr-wrapper {
      position: relative; width: 220px; height: 220px; background: #fff; padding: 12px;
      border-radius: 24px; border: 1px solid var(--border); box-shadow: 0 8px 24px rgba(0,0,0,0.05); margin-bottom: 20px;
    }
    .qr-wrapper canvas { width: 100% !important; height: 100% !important; border-radius: 12px; display: block; }
    .qr-badge {
      position: absolute; top: -12px; right: -12px; background: var(--blue); color: #fff;
      font-size: 0.8rem; font-weight: 900; padding: 6px 14px; border-radius: 99px; box-shadow: 0 4px 12px rgba(2,132,199,0.3);
    }
    .receive-address-box {
      width: 100%; display: flex; align-items: center; gap: 8px; background: var(--soft);
      padding: 8px 8px 8px 16px; border-radius: 20px; border: 1px solid var(--border);
    }
    .receive-address-box input { flex: 1; background: transparent; border: none; font-size: 0.85rem; color: var(--text); font-family: monospace; font-weight: 700; }
    .receive-option { display: flex; align-items: center; justify-content: space-between; padding: 14px; border-radius: 20px; background: var(--solid); border: 1px solid var(--border); cursor: pointer; }

    .countdown-ring { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--blue) calc(var(--progress,1) * 360deg), rgba(100,116,139,0.1) 0deg); position: relative; }
    .countdown-ring::before { content: ""; position: absolute; width: 34px; height: 34px; border-radius: 50%; background: var(--solid); }
    .countdown-ring span { position: relative; z-index: 1; font-weight: 900; font-size: 0.85rem; color: var(--blue); }

    .chart-canvas { width: 100%; height: 320px; display: block; touch-action: none; border-radius: 16px; background: var(--solid); border: 1px solid var(--border); }
    .timeframe-row { display: flex; gap: 8px; margin: 14px 0; overflow-x: auto; scrollbar-width: none; }
    .timeframe-row::-webkit-scrollbar { display: none; }
    .timeframe-btn { height: 38px; padding: 0 16px; border-radius: 99px; background: var(--solid); border: 1px solid var(--border); color: var(--muted); font-weight: 800; font-size: 0.85rem; flex-shrink: 0; }
    .timeframe-btn.active { background: linear-gradient(135deg, var(--blue2), var(--cyan)); color: white; border-color: transparent; box-shadow: 0 8px 20px rgba(37,99,235,0.2); }

    .modal-overlay, .drawer-overlay {
      position: fixed; inset: 0; z-index: 100; display: none; background: rgba(15,23,42,0.6);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); padding: 16px; overflow-y: auto;
    }
    .modal-overlay.active, .drawer-overlay.active { display: block; }
    .modal-card { width: min(500px, 100%); margin: calc(12px + var(--safe-top)) auto 20px auto; padding: 24px; border-radius: 32px; background: var(--solid); border: 1px solid var(--border); box-shadow: var(--shadow); animation: pop 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.1) both; }
    .drawer { position: absolute; top: 0; right: 0; width: min(440px, 100%); height: 100%; overflow-y: auto; padding: calc(24px + var(--safe-top)) 24px calc(24px + var(--safe-bottom)); background: var(--solid); border-left: 1px solid var(--border); box-shadow: -20px 0 80px rgba(0,0,0,0.2); animation: slide 0.25s ease both; }

    @keyframes pop { from { transform: translateY(20px) scale(0.95); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }
    @keyframes slide { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    .modal-head, .drawer-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .modal-title, .drawer-title { font-size: 1.4rem; font-weight: 900; letter-spacing: -0.04em; }
    .close { width: 44px; height: 44px; border-radius: 18px; background: var(--soft); border: 1px solid var(--border); font-size: 1.4rem; font-weight: 900; color: var(--text); }

    .toast {
      position: fixed; left: 50%; bottom: calc(100px + var(--safe-bottom)); transform: translateX(-50%) translateY(20px);
      z-index: 150; padding: 14px 24px; border-radius: 20px; background: rgba(15,23,42,0.95); color: white;
      font-weight: 800; font-size: 0.9rem; box-shadow: 0 16px 32px rgba(0,0,0,0.3); opacity: 0; pointer-events: none;
      transition: all 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1); white-space:nowrap;
    }
    .toast.active { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* 3-Item Bottom Navigation */
    .bottom-nav {
      position: fixed; left: 50%; bottom: calc(12px + var(--safe-bottom)); transform: translateX(-50%);
      z-index: 70; width: min(440px, calc(100% - 24px)); display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 8px; padding: 8px; border-radius: 28px; background: rgba(255,255,255,0.92);
      border: 1px solid var(--border); box-shadow: var(--shadow); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    }
    [data-theme="dark"] .bottom-nav { background: rgba(13,22,40,0.95); }

    .bottom-nav button {
      min-height: 58px; border-radius: 20px; color: var(--muted); background: transparent; font-size: 0.75rem;
      font-weight: 800; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
    }
    .bottom-nav button svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; transition:0.2s; }
    .bottom-nav button.active { color: var(--blue); background: var(--soft); box-shadow: inset 0 0 0 1px var(--border); }
    .bottom-nav button.active svg { stroke: var(--blue); }

    @media (max-width: 580px) {
      .hero { padding: 20px; border-radius: 28px; }
      .quick { grid-template-columns: repeat(3, 1fr); gap: 8px; }
      .quick-btn { min-height: 72px; padding: 10px 4px; border-radius: 20px; }
      .quick-btn strong { font-size: 0.85rem; }
      .panel { padding: 16px; border-radius: 24px; }
      .asset-card, .staking-card { flex-basis: 170px; }
      .modal-card { width: 100%; border-radius: 32px 32px 0 0; margin: auto auto 0 auto; max-height: 92vh; }
      .drawer { width: 100%; }
      .chart-canvas { height: 260px; }
      .brand-sub { display: none; }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <div class="logo">B</div>
        <div>
          <div class="brand-title">BlueCrypto</div>
          <div class="brand-sub" id="statusText">Loading wallet</div>
        </div>
      </a>

      <div class="top-actions">
        <button class="icon-btn" onclick="refreshAllBalances(true)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </button>
        <button class="icon-btn" onclick="openSettings()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="shell">
    <section class="hero" id="homeSection">
      <div class="hero-inner">
        <div class="badge"><span class="dot"></span><span id="walletStatusBadge">Connecting...</span></div>
        <div class="balance" id="totalUsd">$0.00</div>
        <div class="pnl-line" id="pnlLine">24h PnL $0.00 · ROI 0.00%</div>

        <div class="market-strip" id="topMarketCards"></div>

        <div class="quick">
          <button class="quick-btn primary" onclick="openModal('receiveModal')">
            <strong>Receive</strong>
            <span>Scan QR</span>
          </button>
          <button class="quick-btn" onclick="openModal('sendModal')">
            <strong>Send</strong>
            <span>Transfer</span>
          </button>
          <button class="quick-btn" onclick="openModal('swapModal')">
            <strong>Swap</strong>
            <span>Trade</span>
          </button>
        </div>
      </div>
    </section>

    <section class="panel" id="assetsSection">
      <div class="panel-head">
        <h2 class="title">My Assets</h2>
        <button class="small-btn" onclick="refreshAllBalances(true)">Refresh</button>
      </div>
      <div class="asset-scroll" id="assetCards"></div>
    </section>

    <section class="panel" id="stakingSection">
      <div class="panel-head">
        <h2 class="title">High-Yield Staking</h2>
