  <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.5/dist/ethers.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>

  <script>
    const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
    const CURRENT_EMAIL = "<%= typeof email !== 'undefined' ? email : '' %>";
    const USER_ROLE = "<%= typeof role !== 'undefined' ? role : 'user' %>";
    const IS_ADMIN = USER_ROLE === 'staff';
    const NATIVE_TOKEN = '0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee';

    const DISPLAY_RATES = { USD:{symbol:'$',rate:1}, AED:{symbol:'AED ',rate:3.6725}, EUR:{symbol:'€',rate:.92}, GBP:{symbol:'£',rate:.79}, SAR:{symbol:'SAR ',rate:3.75} };
    const NETWORKS = { ethereum:{name:'Ethereum',chainId:1,symbol:'ETH',rpc:'https://cloudflare-eth.com'}, bsc:{name:'BNB Chain',chainId:56,symbol:'BNB',rpc:'https://bsc-dataseed.binance.org'}, polygon:{name:'Polygon',chainId:137,symbol:'MATIC',rpc:'https://polygon-rpc.com'} };
    const ERC20_TOKENS = { ethereum:[ {symbol:'USDT',name:'Tether',address:'0xdAC17F958D2ee523a2206206994597C13D831ec7',decimals:6,gecko:'tether'} ], bsc:[ {symbol:'USDT',name:'Tether',address:'0x55d398326f99059fF775485246999027B3197955',decimals:18,gecko:'tether'} ], polygon:[ {symbol:'USDT',name:'Tether',address:'0xc2132D05D31c914a87C6611C10748AEb04B58e8F',decimals:6,gecko:'tether'} ] };

    const TENSOR_ICONS = [
      `<svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
      `<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>`,
      `<svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4l3 3"/></svg>`,
      `<svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
      `<svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`
    ];

    const NATIVE_GECKO = { ethereum:'ethereum', bsc:'binancecoin', polygon:'matic-network' };
    const WATCH_ASSETS = [{symbol:'BTC',name:'Bitcoin',gecko:'bitcoin'}, {symbol:'ETH',name:'Ethereum',gecko:'ethereum'}, {symbol:'SOL',name:'Solana',gecko:'solana'}];
    const BINANCE_SYMBOLS = { BTC:'BTCUSDT', ETH:'ETHUSDT', SOL:'SOLUSDT' };
    
    let activeNetworkKey = localStorage.getItem('blue_active_network') || 'ethereum';
    let displayCurrency = localStorage.getItem('blue_display_currency') || 'USD';
    let activeProvider = null, activeSigner = null, allBalances = [], combinedAssets = [], ownedPositions = [];
    let tensorAddress = "", tensorRegistry = [], tensorBalances = {};
    let selectedSend = null, selectedSwapSell = null, selectedReceiveAsset = null;
    let prices = {}, binancePrices = {}, marketMeta = {};
    let toastTimer, countdownTimer = null;
    
    // --- TENSOR LOGIC ---
    function initTensor() {
      tensorAddress = "T0x" + Array.from(new Uint8Array(crypto.subtle ? crypto.getRandomValues(new Uint8Array(20)) : [1,2,3])).map(b=>b.toString(16).padStart(2,'0')).join('');
      const hashedEmail = CURRENT_EMAIL.split('@')[0];
      tensorAddress = localStorage.getItem(`blue_ten_addr_${hashedEmail}`) || tensorAddress;
      localStorage.setItem(`blue_ten_addr_${hashedEmail}`, tensorAddress);

      tensorRegistry = JSON.parse(localStorage.getItem('blue_tensor_registry')) || [];
      tensorBalances = JSON.parse(localStorage.getItem(`blue_ten_bal_${hashedEmail}`)) || {};
      
      if (IS_ADMIN) {
        document.getElementById('adminTensorPanel').style.display = 'block';
        const picker = document.getElementById('adTenIconPicker');
        picker.innerHTML = TENSOR_ICONS.map((svg, i) => `<button class="icon-option ${i===0?'selected':''}" onclick="selAdTenIcon(this, ${i})">${svg}</button>`).join('');
        window.selectedTenIcon = 0;
      }
      setInterval(runTensorMarket, 8000);
    }
    
    function selAdTenIcon(btn, i) { document.querySelectorAll('.icon-option').forEach(b=>b.classList.remove('selected')); btn.classList.add('selected'); window.selectedTenIcon = i; }
    
    function deployTensorToken() {
      const name = document.getElementById('adTenName').value; const sym = document.getElementById('adTenSym').value.toUpperCase();
      const price = Number(document.getElementById('adTenPrice').value); const vol = document.getElementById('adTenVol').value;
      if(!name || !sym || price <= 0) return toast('Invalid details');
      
      const cAddr = "T0x" + Math.random().toString(16).slice(2, 22) + Math.random().toString(16).slice(2, 22);
      tensorRegistry.push({ id:cAddr, name, symbol:sym, price, startPrice:price, vol, icon: TENSOR_ICONS[window.selectedTenIcon] });
      localStorage.setItem('blue_tensor_registry', JSON.stringify(tensorRegistry));
      toast(`${sym} deployed to Tensor Network!`); renderTensorCards();
    }

    function runTensorMarket() {
      if(!tensorRegistry.length) return;
      tensorRegistry.forEach(t => {
        const r = Math.random(); let change = 0;
        if(t.vol === 'bull') change = r < 0.65 ? (Math.random()*0.03) : -(Math.random()*0.015);
        else if(t.vol === 'bear') change = r < 0.65 ? -(Math.random()*0.03) : (Math.random()*0.015);
        else if(t.vol === 'stable') change = r < 0.5 ? (Math.random()*0.002) : -(Math.random()*0.002);
        else if(t.vol === 'hyper') change = r < 0.5 ? (Math.random()*0.15) : -(Math.random()*0.15);
        t.price = Math.max(0.000001, t.price * (1 + change));
      });
      localStorage.setItem('blue_tensor_registry', JSON.stringify(tensorRegistry));
      renderTensorCards(); if(document.getElementById('tensorSwapModal').classList.contains('active')) calcTensorOutput();
    }

    function getUsdtBalanceTotal() { return ownedPositions.filter(p=>p.symbol==='USDT').reduce((acc,p)=>acc+Number(p.balance),0); }

    function openTensorSwap() {
      const s = document.getElementById('tenSwapSelectOut');
      s.innerHTML = tensorRegistry.map(t => `<option value="${t.id}">${t.symbol} - ${money(t.price)}</option>`).join('');
      document.getElementById('tenSwapUsdtBal').textContent = `${fmt(getUsdtBalanceTotal())} USDT available`;
      document.getElementById('tenSwapAmountIn').value = ''; document.getElementById('tenSwapReceiveTxt').textContent = '0.00';
    }

    function calcTensorOutput() {
      const amt = Number(document.getElementById('tenSwapAmountIn').value||0);
      const tId = document.getElementById('tenSwapSelectOut').value;
      const t = tensorRegistry.find(x=>x.id===tId);
      if(!t || amt<=0) { document.getElementById('tenSwapReceiveTxt').textContent = '0.00'; return; }
      document.getElementById('tenSwapReceiveTxt').textContent = fmt(amt / t.price, 4) + ' ' + t.symbol;
    }

    async function executeTensorSwap() {
      const amt = Number(document.getElementById('tenSwapAmountIn').value||0);
      const tId = document.getElementById('tenSwapSelectOut').value;
      const t = tensorRegistry.find(x=>x.id===tId);
      if(!t || amt<=0) return toast('Invalid swap');
      
      const realUsdt = ownedPositions.find(p=>p.symbol==='USDT');
      if(IS_ADMIN || (realUsdt && realUsdt.balance >= amt)) {
        toast('Simulating USDT Burn via Network...');
        // In reality we'd require a real Web3 TX to a burn address here. Simulating for demo.
        setTimeout(() => {
          tensorBalances[t.id] = (tensorBalances[t.id] || 0) + (amt / t.price);
          localStorage.setItem(`blue_ten_bal_${CURRENT_EMAIL.split('@')[0]}`, JSON.stringify(tensorBalances));
          closeModal('tensorSwapModal'); toast(`Received ${t.symbol} on Tensor Network!`); renderTensorCards();
        }, 1500);
      } else { toast('Insufficient real USDT'); }
    }

    function updateTenSendBal() {
      const tId = document.getElementById('tenSendSelect').value;
      const bal = tensorBalances[tId] || 0;
      document.getElementById('tenSendBalTxt').textContent = `${fmt(bal)} available`;
    }
    function maxTenSend() { document.getElementById('tenSendAmt').value = tensorBalances[document.getElementById('tenSendSelect').value] || 0; }
    
    function executeTensorSend() {
      const tId = document.getElementById('tenSendSelect').value; const amt = Number(document.getElementById('tenSendAmt').value);
      const to = document.getElementById('tenSendTo').value.trim();
      if(!to.startsWith('T0x') || amt<=0 || (tensorBalances[tId]||0) < amt) return toast('Invalid details or balance');
      
      toast('Processing on Tensor Network...');
      setTimeout(() => {
        tensorBalances[tId] -= amt; localStorage.setItem(`blue_ten_bal_${CURRENT_EMAIL.split('@')[0]}`, JSON.stringify(tensorBalances));
        closeModal('tensorSendModal'); toast('AI Token Sent'); renderTensorCards();
      }, 1000);
    }

    function renderTensorCards() {
      const box = document.getElementById('tensorCards');
      if(!tensorRegistry.length) { box.innerHTML = `<div class="asset-card tensor"><div class="name">No Tensor Assets</div><div class="tiny">Admin must deploy tokens.</div></div>`; return; }
      
      let totTenUsd = 0;
      box.innerHTML = tensorRegistry.map(t => {
        const bal = tensorBalances[t.id] || 0; const val = bal * t.price; totTenUsd += val;
        const diff = ((t.price - t.startPrice)/t.startPrice)*100;
        return `<div class="asset-card tensor">
          <div class="asset-top"><div class="coin tensor-coin">${t.icon}</div><div><div class="name">${t.symbol}</div><div class="tiny">${t.name}</div></div></div>
          <div class="asset-value">${money(t.price)}</div>
          <div class="asset-sub"><span class="${diff>=0?'change up':'change down'}">${diff>=0?'+':''}${diff.toFixed(2)}%</span></div>
          <div class="tiny" style="margin-top:8px; opacity:0.8;">Bal: ${fmt(bal,4)} ${t.symbol} (${money(val)})</div>
        </div>`;
      }).join('');
      
      // We could add totTenUsd to totalUsd, but keeping AI ecosystem value separate or blended is a choice. We will blend it.
      renderTotals(totTenUsd);
    }
    // --- END TENSOR ---

    function toast(msg) { const el = document.getElementById('toast'); el.textContent = msg; el.classList.add('active'); clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('active'), 2500); }
    function formatCompact(num) { return !num ? '$0' : new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',notation:'compact'}).format(num); }
    function money(val) { const cfg = DISPLAY_RATES[displayCurrency] || DISPLAY_RATES.USD; return `${cfg.symbol}${(Number(val||0) * cfg.rate).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`; }
    function fmt(val, dec=6) { return Number(val||0).toLocaleString(undefined,{maximumFractionDigits:dec}); }
    function icon(sym) { return `<div class="coin"><img src="https://assets.coincap.io/assets/icons/${String(sym).toLowerCase()}@2x.png" onerror="this.remove();this.parentNode.textContent='${String(sym).slice(0,4)}'" /></div>`; }

    function openModal(id) { document.getElementById(id).classList.add('active'); if(id==='tensorSwapModal') openTensorSwap(); if(id==='tensorSendModal') { document.getElementById('tenSendSelect').innerHTML = tensorRegistry.map(t=>`<option value="${t.id}">${t.symbol}</option>`).join(''); updateTenSendBal(); } if(id==='receiveModal') renderReceiveAssets(); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }
    function overlayClose(e,id) { if(e.target.id === id) closeModal(id); }
    function navSetActive(id) { document.querySelectorAll('.bottom-nav button').forEach(b=>b.classList.remove('active')); document.getElementById(id)?.classList.add('active'); }
    function openSettings() { document.getElementById('settingsOverlay').classList.add('active'); document.getElementById('settingsAddress').textContent = currentAddress()||'None'; document.getElementById('settingsTensorAddress').textContent = tensorAddress; navSetActive('navSettings'); }
    function closeSettings() { document.getElementById('settingsOverlay').classList.remove('active'); navSetActive('navHome'); }
    function setTheme(t) { document.documentElement.setAttribute('data-theme',t); localStorage.setItem('blue_theme',t); }
    function setDisplayCurrency(c) { displayCurrency = c; localStorage.setItem('blue_display_currency',c); document.getElementById('currencySelect').value = c; refreshAllBalances(false); }
    function currentAddress() { return IS_ADMIN ? "0xAdminDemoWalletNotRealAddress123456789" : (activeSigner ? activeSigner.address : null); }
    function priceFor(a) { return prices[a.type==='native'?NATIVE_GECKO[a.networkKey]:a.gecko]?.usd||0; }

    function combineAssets() {
      const map = new Map(); WATCH_ASSETS.forEach(w => map.set(w.symbol, {symbol:w.symbol, name:w.name, gecko:w.gecko, amount:0, usd:0, positions:[], isWatch:true}));
      allBalances.forEach(a => {
        const sym = a.symbol; const usd = Number(a.balance||0)*priceFor(a);
        if(!map.has(sym)) map.set(sym, {symbol:sym, name:a.name, gecko:a.gecko, amount:0, usd:0, positions:[], isWatch:false});
        const item = map.get(sym); item.amount += Number(a.balance||0); item.usd += usd;
        if(Number(a.balance||0)>0) { item.isWatch=false; item.positions.push({...a,usd}); }
      });
      combinedAssets = [...map.values()].sort((a,b) => b.usd - a.usd);
      ownedPositions = allBalances.filter(x=>Number(x.balance||0)>0);
    }

    function renderTotals(tensorUsd = 0) {
      let tot = tensorUsd; combinedAssets.forEach(a => { tot += a.usd; });
      document.getElementById('totalUsd').textContent = money(tot);
    }

    function renderAssetCards() {
      document.getElementById('assetCards').innerHTML = combinedAssets.map(a => {
        return `<div class="asset-card ${a.usd<=0?'watch':''}">
          <div class="asset-top">${icon(a.symbol)}<div><div class="name">${a.symbol}</div><div class="tiny">${a.positions.length?`${a.positions.length} network(s)`:'Watchlist'}</div></div></div>
          <div class="asset-value">${a.usd>0?money(a.usd):money(priceFor(a))}</div>
          <div class="tiny" style="margin-top:8px; opacity:0.8;">${fmt(a.amount)} ${a.symbol}</div>
        </div>`;
      }).join('');
      renderTensorCards();
    }

    async function refreshAllBalances(force = false) {
      if(force) document.getElementById('statusText').textContent = 'Updating...';
      if(IS_ADMIN) { allBalances = [{networkKey:'ethereum', type:'erc20', symbol:'USDT', name:'Tether', balance: 5000, decimals:6, gecko:'tether'}]; combineAssets(); renderAssetCards(); return; }
      
      const addr = currentAddress(); if(!addr) return;
      try {
        const res = await fetch('/api/prices?ids=tether,ethereum,bitcoin'); prices = await res.json() || {};
        // Demo simplified sync
        allBalances = [{networkKey:'ethereum', type:'erc20', symbol:'USDT', balance: 150.0, decimals:6, gecko:'tether'}];
        combineAssets(); renderAssetCards();
        document.getElementById('statusText').textContent = 'Connected'; document.getElementById('walletStatusBadge').textContent = 'Secured Wallet';
      } catch(e) {}
    }

    function renderReceiveAssets() {
      const g = document.getElementById('receiveGroupSelect').value;
      const nw = document.getElementById('recNetWrap');
      const box = document.getElementById('receiveAssetsList');
      
      if(g === 'tensor') {
        nw.style.display = 'none'; document.getElementById('qrNetworkBadge').textContent = 'T0x'; document.getElementById('receiveTitle').textContent = 'Tensor AI Token';
        document.getElementById('receiveAddressInput').value = tensorAddress; renderQr(tensorAddress);
        box.innerHTML = tensorRegistry.map(t=>`<button class="receive-option"><div style="display:flex; align-items:center; gap:12px;"><div class="coin tensor-coin">${t.icon}</div><div style="text-align:left;"><div class="name">${t.symbol}</div><div class="tiny">${t.name}</div></div></div></button>`).join('');
      } else {
        nw.style.display = 'block'; const net = NETWORKS[document.getElementById('receiveNetworkSelect').value || 'ethereum'];
        document.getElementById('qrNetworkBadge').textContent = net.symbol; document.getElementById('receiveTitle').textContent = `Crypto on ${net.name}`;
        document.getElementById('receiveAddressInput').value = currentAddress()||'No wallet'; renderQr(currentAddress());
        box.innerHTML = `<button class="receive-option selected"><div style="display:flex; align-items:center; gap:12px;">${icon(net.symbol)}<div><div class="name">${net.symbol}</div></div></div></button>`;
      }
    }

    function renderQr(val) { const box = document.getElementById('qrBox'); box.innerHTML = ''; if(val && window.QRCode) QRCode.toCanvas(val, {width:220, margin:1, color:{dark:'#0f172a',light:'#ffffff'}}, (err,cvs) => { if(!err) box.appendChild(cvs); }); }
    function copyReceiveAddress() { const a = document.getElementById('receiveAddressInput').value; navigator.clipboard?.writeText(a); toast('Address copied'); document.getElementById('copyAddrBtn').textContent='Copied!'; setTimeout(()=>document.getElementById('copyAddrBtn').textContent='Copy',2000); }

    function showSeed() { if(IS_ADMIN) return toast('Demo Mode: Disabled.'); const el = document.getElementById('secretOutput'); el.value = activeWalletMnemonic || "No seed"; el.style.filter = 'none'; }
    function showPrivateKey() { if(IS_ADMIN) return toast('Demo Mode: Disabled.'); const el = document.getElementById('secretOutput'); el.value = activeSigner ? activeSigner.privateKey : 'No key'; el.style.filter = 'none'; }
    async function deleteWallet() { if(IS_ADMIN) return toast('Cannot wipe demo.'); if(document.getElementById('deleteConfirmInput').value!=='DELETE') return toast('Type DELETE'); await fetch('/api/wallet/vault',{method:'DELETE'}); localStorage.clear(); window.location.reload(); }

    async function init() {
      setTheme(localStorage.getItem('blue_theme')||'light'); setDisplayCurrency(displayCurrency); initTensor();
      const s = document.getElementById('receiveNetworkSelect'); if(s) s.innerHTML = Object.entries(NETWORKS).map(([k,n])=>`<option value="${k}">${n.name}</option>`).join('');
      
      if (IS_ADMIN) { await refreshAllBalances(true); return; }
      try {
        let savedVault = SERVER_WALLET.encryptedVault;
        if (!savedVault) {
          const randomWallet = ethers.Wallet.createRandom();
          savedVault = btoa(JSON.stringify({ pk: randomWallet.privateKey, phrase: randomWallet.mnemonic.phrase }));
          await fetch('/api/wallet/vault', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ encryptedVault: savedVault, publicWallets: [randomWallet.address] }) });
          SERVER_WALLET.encryptedVault = savedVault;
        }
        const parsedVault = JSON.parse(atob(savedVault));
        activeWalletMnemonic = parsedVault.phrase; activeProvider = new ethers.JsonRpcProvider(NETWORKS.ethereum.rpc); activeSigner = new ethers.Wallet(parsedVault.pk, activeProvider);
        document.getElementById('walletStatusBadge').textContent = 'Secured Wallet'; await refreshAllBalances(true);
      } catch (err) { console.error(err); }
    }
    window.addEventListener('keydown', e => { if(e.key==='Escape') { closeSettings(); document.querySelectorAll('.modal-overlay').forEach(x=>x.classList.remove('active')); }});
    init();
  </script>
</body>
</html>
