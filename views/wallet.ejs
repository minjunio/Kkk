    };

    const NATIVE_GECKO = { ethereum:'ethereum', bsc:'binancecoin', polygon:'matic-network', base:'ethereum', arbitrum:'ethereum', optimism:'ethereum', avalanche:'avalanche-2' };
    const WATCH_ASSETS = [{symbol:'BTC',name:'Bitcoin',gecko:'bitcoin'}, {symbol:'SOL',name:'Solana',gecko:'solana'}, {symbol:'ETH',name:'Ethereum',gecko:'ethereum'}, {symbol:'BNB',name:'BNB',gecko:'binancecoin'}, {symbol:'XRP',name:'XRP',gecko:'ripple'}];
    const BINANCE_SYMBOLS = { BTC:'BTCUSDT', ETH:'ETHUSDT', SOL:'SOLUSDT', BNB:'BNBUSDT', XRP:'XRPUSDT' };
    const TOP_MARKETS = ['BTC','SOL','ETH','BNB','XRP'];

    // Expanded Staking Options
    const STAKING_OPTIONS = [
      {id:'lido-eth',title:'Lido ETH',asset:'ETH',networkKey:'ethereum',apy:3.4,real:true,adapter:'lido',description:'Stake ETH and receive stETH directly.'},
