        <div class="box bad" id="securityBox" style="margin-top:16px;">
          <div class="name" style="color:var(--pink);">Security & Recovery</div>
          <div class="tiny" style="margin-bottom:12px;">Backup keys before wiping data.</div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <button class="secondary-btn" style="height:44px; font-size:0.85rem;" onclick="showSeed()">Web3 Seed</button>
            <button class="secondary-btn" style="height:44px; font-size:0.85rem;" onclick="showTensorSeed()">Tensor Seed</button>
          </div>
          <textarea class="input" id="secretOutput" readonly style="margin-top:12px; height:90px; font-size:0.8rem; line-height:1.4; filter:blur(5px); transition:0.3s; cursor:pointer;" onclick="this.style.filter='none'; this.select()"></textarea>
        </div>
