<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Tensor Wallet | Wallet</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>

  <style>
    :root {
      --bg-base: #070a0f;
      --bg-base-2: #0b0f17;
      --bg-panel: rgba(17, 24, 39, 0.86);
      --bg-panel-solid: #111827;
      --bg-card: rgba(15, 23, 42, 0.72);
      --bg-hover: rgba(45, 55, 72, 0.9);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.14);
      --border-strong: rgba(148, 163, 184, 0.24);

      --green: #0ecb81;
      --green-glow: rgba(14, 203, 129, 0.18);
      --red: #f6465d;
      --red-glow: rgba(246, 70, 93, 0.18);
      --tensor: #8b5cf6;
      --tensor-2: #3b82f6;
      --tensor-soft: rgba(139, 92, 246, 0.18);
      --yellow: #f59e0b;

      --shadow: 0 22px 70px rgba(0,0,0,0.38);
      --radius: 18px;
      --safe-top: env(safe-area-inset-top);
      --safe-bottom: env(safe-area-inset-bottom);
    }

    [data-theme="light"] {
      --bg-base: #f6f8fb;
      --bg-base-2: #eef2f8;
      --bg-panel: rgba(255,255,255,0.90);
      --bg-panel-solid: #ffffff;
      --bg-card: rgba(255,255,255,0.84);
      --bg-hover: rgba(226, 232, 240, 0.9);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border: rgba(15, 23, 42, 0.10);
      --border-strong: rgba(15, 23, 42, 0.18);
      --shadow: 0 18px 55px rgba(15,23,42,0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.22), transparent 28%),
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.14), transparent 24%),
        linear-gradient(180deg, var(--bg-base), var(--bg-base-2));
      color: var(--text-main);
      font-variant-numeric: tabular-nums;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent 70%);
      z-index: 0;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
      outline: none;
      border: none;
      background: transparent;
      color: inherit;
    }

    button {
      cursor: pointer;
      transition: transform 0.08s ease, opacity 0.12s ease, background 0.12s ease, border-color 0.12s ease;
    }

    button:active {
      transform: scale(0.98);
    }

    button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .app {
      position: relative;
      z-index: 1;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: calc(10px + var(--safe-top)) 14px 10px;
      background: rgba(7, 10, 15, 0.78);
      backdrop-filter: blur(22px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    [data-theme="light"] .topbar {
      background: rgba(255,255,255,0.78);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 950;
      font-size: 1.08rem;
      color: var(--text-main);
    }

    .brand-logo {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,0.35), transparent 22%),
        linear-gradient(135deg, var(--tensor), var(--tensor-2));
      box-shadow: 0 12px 30px rgba(139, 92, 246, 0.35);
    }

    .brand-logo svg {
      width: 19px;
      height: 19px;
      stroke: white;
    }

    .top-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .icon-btn {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-main);
    }

    .admin-badge {
      display: none;
      padding: 7px 10px;
      border: 1px solid rgba(139,92,246,0.42);
      background: rgba(139,92,246,0.16);
      color: #c4b5fd;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .admin-badge.show {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .page {
      width: min(1640px, 100%);
      margin: 0 auto;
      padding: 12px 12px calc(84px + var(--safe-bottom));
      display: grid;
      gap: 14px;
    }

    @media (min-width: 1100px) {
      .page {
        grid-template-columns: minmax(0, 1fr) 380px;
        align-items: start;
        padding-bottom: 18px;
      }
    }

    .main-column {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
    }

    .panel {
      border-radius: var(--radius);
      padding: 14px;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
    }

    .hero {
      padding: 16px;
      border-radius: 22px;
      background:
        radial-gradient(circle at 0% 0%, rgba(139,92,246,0.30), transparent 28%),
        radial-gradient(circle at 100% 0%, rgba(14,203,129,0.12), transparent 24%),
        var(--bg-panel);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      overflow: hidden;
      position: relative;
      backdrop-filter: blur(18px);
    }

    .hero::before {
      content: "";
      position: absolute;
      top: -150px;
      right: -120px;
      width: 280px;
      height: 280px;
      background: radial-gradient(circle, rgba(139,92,246,0.22), transparent 68%);
      pointer-events: none;
    }

    .hero-head {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
      position: relative;
      z-index: 1;
    }

    .wallet-label {
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }

    .wallet-balance {
      margin-top: 5px;
      font-size: clamp(2rem, 7vw, 4.2rem);
      font-weight: 950;
      letter-spacing: -0.075em;
      line-height: 1;
    }

    .wallet-sub {
      margin-top: 8px;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 800;
      line-height: 1.4;
      max-width: 720px;
    }

    .network-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      border: 1px solid rgba(139,92,246,0.34);
      background: rgba(139,92,246,0.14);
      color: #c4b5fd;
      font-size: 0.74rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 15px;
      position: relative;
      z-index: 1;
    }

    .primary-btn,
    .mini-btn,
    .danger-btn,
    .green-btn {
      min-height: 40px;
      border-radius: 13px;
      padding: 9px 12px;
      font-size: 0.78rem;
      font-weight: 950;
      border: 1px solid transparent;
      text-align: center;
    }

    .primary-btn {
      color: #fff;
      background: linear-gradient(135deg, var(--tensor), var(--tensor-2));
      box-shadow: 0 14px 30px rgba(59,130,246,0.18);
    }

    .green-btn {
      color: #fff;
      background: linear-gradient(135deg, #0ecb81, #10b981);
      box-shadow: 0 14px 30px rgba(14,203,129,0.14);
    }

    .mini-btn {
      background: var(--bg-card);
      color: var(--text-main);
      border-color: var(--border);
    }

    .danger-btn {
      background: var(--red-glow);
      color: var(--red);
      border-color: rgba(246,70,93,0.24);
    }

    .stats-grid {
      margin-top: 16px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      position: relative;
      z-index: 1;
    }

    .stat-card {
      background: rgba(7,10,15,0.42);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 11px;
      min-width: 0;
    }

    [data-theme="light"] .stat-card {
      background: rgba(255,255,255,0.72);
    }

    .stat-label {
      color: var(--text-muted);
      font-size: 0.65rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .stat-value {
      margin-top: 5px;
      font-weight: 950;
      font-size: 0.92rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 1rem;
      font-weight: 950;
    }

    .section-title-icon {
      width: 28px;
      height: 28px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: var(--tensor-soft);
      color: #c4b5fd;
    }

    .section-sub {
      color: var(--text-muted);
      font-size: 0.76rem;
      font-weight: 760;
      line-height: 1.42;
      margin-top: 3px;
    }

    .asset-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    @media (min-width: 760px) {
      .asset-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .asset-card {
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      background: rgba(7, 10, 15, 0.48);
      border: 1px solid var(--border);
      padding: 12px;
      cursor: pointer;
      transition: 0.16s ease;
    }

    [data-theme="light"] .asset-card {
      background: rgba(255,255,255,0.82);
    }

    .asset-card:hover,
    .asset-card.active {
      border-color: rgba(139,92,246,0.52);
      transform: translateY(-1px);
      box-shadow: 0 18px 40px rgba(0,0,0,0.14);
    }

    .asset-card.active::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--tensor), transparent);
    }

    .asset-top {
      display: flex;
      justify-content: space-between;
      gap: 9px;
      align-items: center;
    }

    .coin {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
    }

    .coin-icon {
      width: 34px;
      height: 34px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, rgba(139,92,246,0.88), rgba(59,130,246,0.82));
      color: white;
      font-weight: 950;
      overflow: hidden;
      flex: 0 0 auto;
    }

    .coin-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .coin-name {
      min-width: 0;
    }

    .coin-symbol {
      font-weight: 950;
      font-size: 0.94rem;
      line-height: 1.1;
    }

    .coin-full {
      margin-top: 3px;
      color: var(--text-muted);
      font-size: 0.68rem;
      font-weight: 820;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .asset-price {
      margin-top: 12px;
      font-weight: 950;
      font-size: 1.1rem;
      letter-spacing: -0.03em;
    }

    .asset-row {
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 850;
    }

    .text-green {
      color: var(--green);
    }

    .text-red {
      color: var(--red);
    }

    .side-panel {
      position: sticky;
      top: 68px;
      height: fit-content;
      display: grid;
      gap: 14px;
    }

    .tabs {
      display: flex;
      gap: 7px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .tabs::-webkit-scrollbar {
      display: none;
    }

    .tab {
      padding: 8px 10px;
      font-weight: 900;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.82rem;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }

    .tab.active {
      color: var(--text-main);
      border-bottom-color: var(--tensor);
    }

    .qr-card {
      display: grid;
      gap: 12px;
    }

    .qr-box {
      width: 178px;
      height: 178px;
      margin: 0 auto;
      background: white;
      border-radius: 18px;
      padding: 12px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,0.3);
      box-shadow: 0 18px 45px rgba(0,0,0,0.20);
    }

    #qrCanvas {
      width: 154px !important;
      height: 154px !important;
      display: block;
    }

    .address-box {
      padding: 11px;
      border-radius: 14px;
      background: rgba(7,10,15,0.48);
      border: 1px solid var(--border);
      word-break: break-all;
      font-size: 0.76rem;
      color: var(--text-main);
      font-weight: 850;
      line-height: 1.44;
      text-align: center;
    }

    [data-theme="light"] .address-box {
      background: rgba(248,250,252,0.90);
    }

    .network-select {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 7px;
    }

    .network-btn {
      min-height: 36px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-muted);
      font-size: 0.72rem;
      font-weight: 950;
    }

    .network-btn.active {
      background: rgba(139,92,246,0.16);
      color: #c4b5fd;
      border-color: rgba(139,92,246,0.38);
    }

    .form {
      display: grid;
      gap: 10px;
    }

    .field {
      display: grid;
      gap: 6px;
    }

    .field label {
      color: var(--text-muted);
      font-size: 0.67rem;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .field input,
    .field select,
    .field textarea {
      min-height: 42px;
      background: rgba(7,10,15,0.58);
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 9px 11px;
      font-size: 0.84rem;
      font-weight: 850;
      width: 100%;
    }

    [data-theme="light"] .field input,
    [data-theme="light"] .field select,
    [data-theme="light"] .field textarea {
      background: rgba(248,250,252,0.92);
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: rgba(139,92,246,0.72);
      box-shadow: 0 0 0 3px rgba(139,92,246,0.10);
    }

    .mini-note {
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 760;
      line-height: 1.44;
    }

    .wallet-list {
      display: grid;
      gap: 9px;
    }

    .wallet-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 10px;
      padding: 10px;
      border-radius: 15px;
      border: 1px solid var(--border);
      background: rgba(7,10,15,0.42);
    }

    [data-theme="light"] .wallet-row {
      background: rgba(255,255,255,0.78);
    }

    .wallet-row-title {
      font-size: 0.8rem;
      font-weight: 950;
    }

    .wallet-row-sub {
      margin-top: 3px;
      color: var(--text-muted);
      font-size: 0.68rem;
      font-weight: 800;
      word-break: break-all;
    }

    .tx-list {
      display: grid;
      gap: 9px;
    }

    .tx-card {
      padding: 11px;
      border-radius: 15px;
      border: 1px solid var(--border);
      background: rgba(7,10,15,0.42);
    }

    [data-theme="light"] .tx-card {
      background: rgba(255,255,255,0.78);
    }

    .tx-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
    }

    .tx-title {
      font-weight: 950;
      font-size: 0.82rem;
    }

    .tx-date {
      color: var(--text-muted);
      font-size: 0.66rem;
      font-weight: 800;
    }

    .tx-detail {
      margin-top: 7px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 760;
      line-height: 1.44;
      word-break: break-all;
    }

    .empty {
      padding: 22px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 800;
      border: 1px dashed var(--border-strong);
      border-radius: 16px;
      background: rgba(7,10,15,0.22);
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: calc(74px + var(--safe-bottom));
      transform: translateX(-50%) translateY(20px);
      z-index: 200;
      min-width: 220px;
      max-width: calc(100% - 28px);
      padding: 11px 13px;
      border-radius: 14px;
      background: rgba(15,23,42,0.94);
      border: 1px solid var(--border-strong);
      color: white;
      font-weight: 900;
      font-size: 0.78rem;
      box-shadow: 0 18px 50px rgba(0,0,0,0.35);
      opacity: 0;
      pointer-events: none;
      transition: 0.18s ease;
      text-align: center;
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .bottom-nav {
      position: fixed;
      left: 0;
      bottom: 0;
      width: 100%;
      height: calc(60px + var(--safe-bottom));
      background: rgba(7,10,15,0.86);
      backdrop-filter: blur(22px);
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding-bottom: var(--safe-bottom);
      z-index: 60;
    }

    [data-theme="light"] .bottom-nav {
      background: rgba(255,255,255,0.86);
    }

    @media (min-width: 1024px) {
      .bottom-nav {
        display: none;
      }
    }

    .bottom-nav button {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      color: var(--text-muted);
      font-size: 0.7rem;
      font-weight: 800;
      width: 100%;
      height: 100%;
      justify-content: center;
    }

    .bottom-nav button svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.5;
    }

    .bottom-nav button.active {
      color: var(--text-main);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(0,0,0,0.66);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      backdrop-filter: blur(12px);
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal {
      width: min(580px, 100%);
      max-height: 90vh;
      overflow: auto;
      background: var(--bg-panel-solid);
      border: 1px solid var(--border-strong);
      border-radius: 22px;
      padding: 16px;
      box-shadow: 0 30px 90px rgba(0,0,0,0.50);
    }

    .modal-title {
      font-size: 1.08rem;
      font-weight: 950;
    }

    .modal-desc {
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 780;
      line-height: 1.44;
      margin-top: 6px;
    }

    .modal-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 13px;
    }

    @media (max-width: 720px) {
      .brand span:last-child {
        display: none;
      }

      .admin-badge {
        display: none !important;
      }

      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }

      .asset-grid {
        grid-template-columns: 1fr;
      }

      .network-select {
        grid-template-columns: 1fr 1fr;
      }

      .hero-head {
        flex-direction: column;
      }

      .hero-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <script>
      const SERVER_EMAIL = <%- JSON.stringify(typeof email !== 'undefined' ? email : '') %>;
      const SERVER_ROLE = <%- JSON.stringify(typeof role !== 'undefined' ? role : '') %>;
      const SERVER_WALLET = <%- typeof wallet !== 'undefined' ? wallet : 'null' %>;
    </script>

    <header class="topbar">
      <a href="/wallet" class="brand">
        <span class="brand-logo">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H19a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5.5A2.5 2.5 0 0 1 3 18.5v-11Z"/>
            <path d="M18 12h.01"/>
            <path d="M3 8h18"/>
          </svg>
        </span>
        <span>Tensor Wallet</span>
      </a>

      <div class="top-actions">
        <div id="adminDetectedBadge" class="admin-badge">● Admin</div>

        <button class="icon-btn" onclick="refreshWallet()" aria-label="Refresh wallet">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 12a9 9 0 0 1-15.5 6.2"/>
            <path d="M3 12A9 9 0 0 1 18.5 5.8"/>
            <path d="M18 2v4h4"/>
            <path d="M6 22v-4H2"/>
          </svg>
        </button>

        <button class="icon-btn" onclick="toggleTheme()" aria-label="Toggle theme">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <button class="icon-btn" onclick="window.location.href='/logout'" aria-label="Logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <path d="M16 17l5-5-5-5"/>
            <path d="M21 12H9"/>
          </svg>
        </button>
      </div>
    </header>

    <main class="page">
      <div class="main-column">
        <section class="hero">
          <div class="hero-head">
            <div>
              <div class="wallet-label">Total Wallet Balance</div>
              <div class="wallet-balance">$<span id="totalBalance">0.00</span></div>
              <div class="wallet-sub">
                This wallet balance is the same USDT used for live trading, copy trading, and Tensor swaps. Trading and copying deduct directly from this synced wallet balance.
              </div>
            </div>

            <div class="network-pill" id="selectedNetworkPill">USDT • Ethereum</div>
          </div>

          <div class="hero-actions">
            <button class="primary-btn" onclick="window.location.href='/trading'">Open Trading</button>
            <button class="green-btn" onclick="openReceiveModal()">Receive</button>
            <button class="mini-btn" onclick="focusSendForm()">Send</button>
            <button class="mini-btn" onclick="copyCurrentAddress()">Copy Address</button>
          </div>

          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-label">USDT Balance</div>
              <div class="stat-value">$<span id="usdtBalance">0.00</span></div>
            </div>

            <div class="stat-card">
              <div class="stat-label">Tensor Address</div>
              <div class="stat-value" id="tensorAddressShort">—</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">Active Trades</div>
              <div class="stat-value" id="activeTradesCount">0</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">Copy Trades</div>
              <div class="stat-value" id="copyTradesCount">0</div>
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"/>
                    <path d="M12 6v12"/>
                  </svg>
                </span>
                Assets
              </div>
              <div class="section-sub">Fast wallet asset view. Select an asset to receive or send.</div>
            </div>

            <button class="mini-btn" onclick="refreshPrices()">Refresh Prices</button>
          </div>

          <div class="asset-grid" id="assetGrid"></div>
        </section>

        <section class="panel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M3 3v18h18"/>
                    <path d="M7 15l4-4 3 3 5-6"/>
                  </svg>
                </span>
                Trading / Copy Activity
              </div>
              <div class="section-sub">Live trades, copy allocations, and recent deposits are synced from the server.</div>
            </div>
          </div>

          <div class="tabs">
            <div class="tab active" onclick="switchActivityTab('positions', this)">Positions</div>
            <div class="tab" onclick="switchActivityTab('copy', this)">Copy Trades</div>
            <div class="tab" onclick="switchActivityTab('deposits', this)">Deposits</div>
            <div class="tab" onclick="switchActivityTab('history', this)">History</div>
          </div>

          <div id="positionsView" class="tx-list"></div>
          <div id="copyView" class="tx-list" style="display:none;"></div>
          <div id="depositsView" class="tx-list" style="display:none;"></div>
          <div id="historyView" class="tx-list" style="display:none;"></div>
        </section>
      </div>

      <aside class="side-panel">
        <section class="panel qr-card">
          <div class="section-head" style="margin-bottom:0;">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                  </svg>
                </span>
                Receive
              </div>
              <div class="section-sub">Select network. QR stays visible in dark mode.</div>
            </div>
          </div>

          <div class="network-select" id="networkSelect"></div>

          <div class="qr-box">
            <canvas id="qrCanvas"></canvas>
          </div>

          <div class="address-box" id="receiveAddress">Loading address...</div>

          <button class="primary-btn" onclick="copyCurrentAddress()">Copy Receive Address</button>
        </section>

        <section class="panel" id="sendPanel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M22 2L11 13"/>
                    <path d="M22 2l-7 20-4-9-9-4 20-7Z"/>
                  </svg>
                </span>
                Send
              </div>
              <div class="section-sub">Demo send endpoint. It records a simulated transaction hash.</div>
            </div>
          </div>

          <div class="form">
            <div class="field">
              <label>Asset</label>
              <select id="sendAsset"></select>
            </div>

            <div class="field">
              <label>Network</label>
              <select id="sendNetwork"></select>
            </div>

            <div class="field">
              <label>Amount</label>
              <input id="sendAmount" type="number" step="any" placeholder="0.00">
            </div>

            <div class="field">
              <label>To Address</label>
              <textarea id="sendTo" rows="3" placeholder="Paste recipient address"></textarea>
            </div>

            <button class="green-btn" onclick="sendAsset()">Send Asset</button>

            <div class="mini-note">
              For this demo, send returns a generated tx hash. Real on-chain transfers require wallet signing infrastructure.
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="section-head">
            <div>
              <div class="section-title">
                <span class="section-title-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>
                    <path d="M9 12l2 2 4-4"/>
                  </svg>
                </span>
                Vault
              </div>
              <div class="section-sub">Encrypted vault storage hook for your frontend wallet data.</div>
            </div>
          </div>

          <div class="form">
            <div class="field">
              <label>Encrypted Vault JSON</label>
              <textarea id="vaultInput" rows="4" placeholder="Encrypted wallet payload"></textarea>
            </div>

            <button class="mini-btn" onclick="saveVault()">Save Vault</button>
          </div>
        </section>
      </aside>
    </main>

    <nav class="bottom-nav">
      <button class="active" onclick="window.location.href='/wallet'">
        <svg viewBox="0 0 24 24">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Wallet
      </button>

      <button onclick="window.location.href='/trading'">
        <svg viewBox="0 0 24 24">
          <path d="M3 3v18h18"/>
          <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/>
        </svg>
        Trading
      </button>
    </nav>

    <div class="modal-backdrop" id="receiveModal">
      <div class="modal">
        <div class="modal-title">Receive <span id="receiveModalAsset">USDT</span></div>
        <div class="modal-desc">Use the selected network and address below.</div>

        <div style="margin:14px auto 12px;" class="qr-box">
          <canvas id="modalQrCanvas"></canvas>
        </div>

        <div class="address-box" id="modalReceiveAddress">Loading...</div>

        <div class="modal-actions">
          <button class="mini-btn" onclick="closeReceiveModal()">Close</button>
          <button class="primary-btn" onclick="copyCurrentAddress()">Copy Address</button>
        </div>
      </div>
    </div>

    <div class="toast" id="toast">Copied</div>
  </div>

  <script>
    let currentTheme = localStorage.getItem('blue_theme') || 'dark';
    let walletState = SERVER_WALLET || {};
    let tensorRegistry = [];
    let selectedAsset = 'USDT';
    let selectedNetwork = normalizeNetwork(walletState.usdtNetwork || 'eth');
    let prices = {};
    let refreshInterval = null;

    const networkMap = {
      eth: {
        key: 'eth',
        network: 'Ethereum',
        short: 'ERC20',
        symbol: 'ETH',
        address: '0x0ab846457e6f9c7e9720a8e8782c9d1f8a260e5a'
      },
      arbitrum: {
        key: 'arbitrum',
        network: 'Arbitrum',
        short: 'ARB',
        symbol: 'ARB',
        address: '0x0ab846457e6f9c7e9720a8e8782c9d1f8a260e5a'
      },
      sol: {
        key: 'sol',
        network: 'Solana',
        short: 'SOL',
        symbol: 'SOL',
        address: '9prrQtQxzdt5Kt7nPHUxwWAVQLZATrj2bjU27k5Xkt5i'
      },
      trx: {
        key: 'trx',
        network: 'TRON',
        short: 'TRC20',
        symbol: 'TRX',
        address: 'TPwY7YfXuufmgfCLF7ie9E2nyo6KhT4fn2'
      }
    };

    const assetMeta = {
      USDT: {
        name: 'Tether USD',
        symbol: 'USDT',
        icon: '₮',
        stable: true,
        networks: ['eth', 'arbitrum', 'sol', 'trx']
      },
      OUSD: {
        name: 'Origin Dollar',
        symbol: 'OUSD',
        icon: 'O',
        stable: true,
        networks: ['eth', 'arbitrum', 'sol']
      },
      BTC: {
        name: 'Bitcoin',
        symbol: 'BTC',
        icon: '₿',
        priceId: 'bitcoin',
        networks: ['eth', 'arbitrum', 'sol']
      },
      ETH: {
        name: 'Ethereum',
        symbol: 'ETH',
        icon: 'Ξ',
        priceId: 'ethereum',
        networks: ['eth', 'arbitrum']
      },
      SOL: {
        name: 'Solana',
        symbol: 'SOL',
        icon: '◎',
        priceId: 'solana',
        networks: ['sol']
      },
      BNB: {
        name: 'BNB',
        symbol: 'BNB',
        icon: 'B',
        priceId: 'binancecoin',
        networks: ['eth', 'arbitrum']
      },
      XRP: {
        name: 'XRP',
        symbol: 'XRP',
        icon: 'X',
        priceId: 'ripple',
        networks: ['eth']
      },
      DOGE: {
        name: 'Dogecoin',
        symbol: 'DOGE',
        icon: 'D',
        priceId: 'dogecoin',
        networks: ['eth']
      }
    };

    function isAdmin() {
      const role = String(SERVER_ROLE || '').toLowerCase();
      const email = String(SERVER_EMAIL || '').toLowerCase();
      const walletRole = String(walletState?.role || '').toLowerCase();

      return role === 'staff'
        || role === 'admin'
        || walletRole === 'staff'
        || walletRole === 'admin'
        || email === 'admin@tensorwallet.local';
    }

    function updateAdminDetectionUI() {
      const badge = document.getElementById('adminDetectedBadge');
      if (badge) badge.classList.toggle('show', isAdmin());
    }

    function normalizeNetwork(network) {
      const raw = String(network || '').trim().toLowerCase();

      if (raw.includes('arb')) return 'arbitrum';
      if (raw.includes('sol')) return 'sol';
      if (raw.includes('tron') || raw.includes('trc') || raw.includes('trx')) return 'trx';
      if (raw.includes('eth') || raw.includes('erc')) return 'eth';

      return 'eth';
    }

    function formatMoney(n, decimals = 2) {
      return (Number(n) || 0).toLocaleString(undefined, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    function formatPriceSmart(price) {
      price = Number(price) || 0;

      if (price >= 1000) return price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (price >= 1) return price.toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });

      return price.toLocaleString(undefined, { minimumFractionDigits: 6, maximumFractionDigits: 6 });
    }

    function shortAddress(address) {
      const a = String(address || '');
      if (a.length <= 16) return a;
      return `${a.slice(0, 7)}...${a.slice(-6)}`;
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function showToast(message = 'Done') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.classList.add('show');

      clearTimeout(showToast.timer);
      showToast.timer = setTimeout(() => toast.classList.remove('show'), 1800);
    }

    function toggleTheme() {
      currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', currentTheme);
      localStorage.setItem('blue_theme', currentTheme);
      drawQrCodes();
    }

    function getUsdtBalance() {
      return Number(walletState.usdtBalance || 0);
    }

    function getTensorBalance(tokenId) {
      return Number(walletState.tensorBalances?.[tokenId] || 0);
    }

    function getCurrentAddress() {
      if (selectedAsset === 'USDT' || selectedAsset === 'OUSD') {
        return networkMap[selectedNetwork]?.address || networkMap.eth.address;
      }

      const custom = findPublicWalletAddress(selectedAsset, selectedNetwork);
      if (custom) return custom;

      if (selectedNetwork === 'sol') return networkMap.sol.address;
      if (selectedNetwork === 'trx') return networkMap.trx.address;

      return walletState.tensorAddress || networkMap.eth.address;
    }

    function findPublicWalletAddress(asset, network) {
      const candidates = [];

      if (Array.isArray(walletState.publicWallets)) candidates.push(...walletState.publicWallets);
      if (Array.isArray(walletState.assets)) candidates.push(...walletState.assets);
      if (Array.isArray(walletState.wallets)) candidates.push(...walletState.wallets);
      if (Array.isArray(walletState.balances)) candidates.push(...walletState.balances);

      const item = candidates.find(x => {
        const text = JSON.stringify(x || {}).toLowerCase();
        return text.includes(String(asset).toLowerCase()) && text.includes(String(network).toLowerCase());
      });

      if (!item) return '';

      return item.address || item.publicAddress || item.walletAddress || item.depositAddress || '';
    }

    function buildAssetList() {
      const baseAssets = Object.values(assetMeta).map(meta => {
        let balance = 0;
        let usdValue = 0;
        let price = 1;
        let change = 0;

        if (meta.symbol === 'USDT') {
          balance = getUsdtBalance();
          price = 1;
          usdValue = balance;
        } else if (meta.symbol === 'OUSD') {
          balance = Number(walletState.ousdBalance || walletState.OUSD || walletState.ousd || 0);
          price = 1;
          usdValue = balance;
        } else {
          const cg = prices[meta.priceId] || {};
          price = Number(cg.usd || 0);
          change = Number(cg.usd_24h_change || 0);
          balance = Number(walletState[`${meta.symbol.toLowerCase()}Balance`] || 0);
          usdValue = balance * price;
        }

        return {
          ...meta,
          balance,
          price,
          usdValue,
          change,
          tokenId: null,
          type: 'standard'
        };
      });

      const tensorAssets = tensorRegistry.map(t => {
        const balance = getTensorBalance(t.id);
        const price = Number(t.price || 0);

        return {
          name: t.name || t.symbol,
          symbol: t.symbol,
          icon: t.icon || String(t.symbol || 'T').slice(0, 1),
          balance,
          price,
          usdValue: balance * price,
          change: Number(t.changePercent24h || 0),
          tokenId: t.id,
          type: 'tensor',
          networks: ['eth', 'arbitrum', 'sol']
        };
      });

      return [...baseAssets, ...tensorAssets];
    }

    function calculateTotalBalance() {
      const assets = buildAssetList();
      const assetTotal = assets.reduce((sum, asset) => sum + Number(asset.usdValue || 0), 0);
      return assetTotal;
    }

    function renderHero() {
      const total = calculateTotalBalance();
      const usdt = getUsdtBalance();
      const activeTrades = Array.isArray(walletState.positions) ? walletState.positions.length : 0;
      const copyTrades = Array.isArray(walletState.copyTrades) ? walletState.copyTrades.length : 0;

      document.getElementById('totalBalance').textContent = formatMoney(total);
      document.getElementById('usdtBalance').textContent = formatMoney(usdt);
      document.getElementById('activeTradesCount').textContent = activeTrades;
      document.getElementById('copyTradesCount').textContent = copyTrades;

      const tensorAddress = walletState.tensorAddress || '—';
      document.getElementById('tensorAddressShort').textContent = shortAddress(tensorAddress);

      const network = networkMap[selectedNetwork] || networkMap.eth;
      document.getElementById('selectedNetworkPill').textContent = `${selectedAsset} • ${network.network}`;
    }

    function renderNetworkSelect() {
      const asset = assetMeta[selectedAsset] || { networks: ['eth', 'arbitrum', 'sol', 'trx'] };
      const networks = asset.networks || ['eth', 'arbitrum', 'sol', 'trx'];

      if (!networks.includes(selectedNetwork)) {
        selectedNetwork = networks[0] || 'eth';
      }

      document.getElementById('networkSelect').innerHTML = networks.map(key => {
        const n = networkMap[key] || networkMap.eth;

        return `
          <button class="network-btn ${selectedNetwork === key ? 'active' : ''}" onclick="setNetwork('${key}')">
            ${escapeHtml(n.short)}
          </button>
        `;
      }).join('');

      const sendNetwork = document.getElementById('sendNetwork');

      if (sendNetwork) {
        sendNetwork.innerHTML = networks.map(key => {
          const n = networkMap[key] || networkMap.eth;
          return `<option value="${key}" ${selectedNetwork === key ? 'selected' : ''}>${escapeHtml(n.network)} ${escapeHtml(n.short)}</option>`;
        }).join('');
      }
    }

    function renderAssets() {
      const assets = buildAssetList();
      const grid = document.getElementById('assetGrid');

      grid.innerHTML = assets.map(asset => {
        const change = Number(asset.change || 0);
        const changeClass = change >= 0 ? 'text-green' : 'text-red';
        const selected = selectedAsset === asset.symbol && (!asset.tokenId || asset.tokenId === window.selectedTensorTokenId);

        return `
          <div class="asset-card ${selected ? 'active' : ''}" onclick="selectAsset('${escapeHtml(asset.symbol)}', '${escapeHtml(asset.tokenId || '')}')">
            <div class="asset-top">
              <div class="coin">
                <div class="coin-icon">${escapeHtml(asset.icon || asset.symbol.slice(0, 1))}</div>
                <div class="coin-name">
                  <div class="coin-symbol">${escapeHtml(asset.symbol)}</div>
                  <div class="coin-full">${escapeHtml(asset.name)}</div>
                </div>
              </div>
              <div class="${changeClass}" style="font-size:.72rem;font-weight:950;">
                ${asset.stable ? 'Stable' : `${change >= 0 ? '+' : ''}${change.toFixed(2)}%`}
              </div>
            </div>

            <div class="asset-price">$${formatMoney(asset.usdValue || 0)}</div>

            <div class="asset-row">
              <span>Balance</span>
              <span>${formatPriceSmart(asset.balance || 0)} ${escapeHtml(asset.symbol)}</span>
            </div>

            <div class="asset-row">
              <span>Price</span>
              <span>$${formatPriceSmart(asset.price || 0)}</span>
            </div>
          </div>
        `;
      }).join('');

      renderSendAssetOptions(assets);
    }

    function renderSendAssetOptions(assets = buildAssetList()) {
      const sendAsset = document.getElementById('sendAsset');
      if (!sendAsset) return;

      sendAsset.innerHTML = assets.map(asset => {
        return `<option value="${escapeHtml(asset.symbol)}" ${selectedAsset === asset.symbol ? 'selected' : ''}>${escapeHtml(asset.symbol)} - ${escapeHtml(asset.name)}</option>`;
      }).join('');
    }

    function renderAddress() {
      const address = getCurrentAddress();
      const network = networkMap[selectedNetwork] || networkMap.eth;

      document.getElementById('receiveAddress').textContent = address;
      document.getElementById('selectedNetworkPill').textContent = `${selectedAsset} • ${network.network}`;

      const modalAddress = document.getElementById('modalReceiveAddress');
      if (modalAddress) modalAddress.textContent = address;

      const modalAsset = document.getElementById('receiveModalAsset');
      if (modalAsset) modalAsset.textContent = selectedAsset;

      drawQrCodes();
    }

    function drawQrCodes() {
      const address = getCurrentAddress();
      const payload = `${selectedAsset}:${address}?network=${selectedNetwork}`;
      const qrCanvas = document.getElementById('qrCanvas');
      const modalQrCanvas = document.getElementById('modalQrCanvas');

      if (window.QRCode && qrCanvas) {
        QRCode.toCanvas(qrCanvas, payload, {
          width: 154,
          margin: 1,
          color: {
            dark: '#000000',
            light: '#ffffff'
          }
        });
      }

      if (window.QRCode && modalQrCanvas) {
        QRCode.toCanvas(modalQrCanvas, payload, {
          width: 154,
          margin: 1,
          color: {
            dark: '#000000',
            light: '#ffffff'
          }
        });
      }
    }

    function renderActivity() {
      renderPositions();
      renderCopyTrades();
      renderDeposits();
      renderHistory();
    }

    function renderPositions() {
      const positions = walletState.positions || [];
      const view = document.getElementById('positionsView');

      if (!positions.length) {
        view.innerHTML = `<div class="empty">No active trading positions.</div>`;
        return;
      }

      view.innerHTML = positions.map(p => {
        const pnl = calculatePositionPnl(p);
        const roi = Number(p.margin || 0) > 0 ? (pnl / Number(p.margin)) * 100 : 0;
        const color = pnl >= 0 ? 'text-green' : 'text-red';

        return `
          <div class="tx-card">
            <div class="tx-top">
              <div>
                <div class="tx-title">${escapeHtml(p.symbol)} ${escapeHtml(p.side)} ${Number(p.leverage || 1)}x</div>
                <div class="tx-date">${p.openedAt ? new Date(p.openedAt).toLocaleString() : 'Open position'}</div>
              </div>
              <div style="text-align:right;">
                <div class="${color}" style="font-weight:950;">${pnl >= 0 ? '+' : '-'}$${formatMoney(Math.abs(pnl))}</div>
                <div class="${color}" style="font-size:.7rem;font-weight:900;">${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%</div>
              </div>
            </div>
            <div class="tx-detail">
              Margin $${formatMoney(p.margin)} • Size $${formatMoney(p.size)} • Entry $${formatPriceSmart(p.entryPrice)} • Mark $${formatPriceSmart(p.markPrice)}
              ${p.treasuryAddress ? `<br>Deposit: ${escapeHtml(shortAddress(p.treasuryAddress))}` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function calculatePositionPnl(p) {
      const entry = Number(p.entryPrice || 0);
      const mark = Number(p.markPrice || p.entryPrice || 0);
      const size = Number(p.size || 0);

      if (!entry || !size) return 0;

      const diff = p.side === 'short' ? entry - mark : mark - entry;
      return (diff / entry) * size;
    }

    function renderCopyTrades() {
      const trades = walletState.copyTrades || [];
      const view = document.getElementById('copyView');

      if (!trades.length) {
        view.innerHTML = `<div class="empty">No active copy trades.</div>`;
        return;
      }

      view.innerHTML = trades.map(c => {
        const pnl = Number(c.pnl || 0);
        const roi = Number(c.roi || 0);
        const color = pnl >= 0 ? 'text-green' : 'text-red';

        return `
          <div class="tx-card">
            <div class="tx-top">
              <div>
                <div class="tx-title">${escapeHtml(c.profileName || 'Copy Portfolio')}</div>
                <div class="tx-date">${c.startedAt ? new Date(c.startedAt).toLocaleString() : 'Started'}</div>
              </div>
              <div style="text-align:right;">
                <div class="${color}" style="font-weight:950;">${pnl >= 0 ? '+' : '-'}$${formatMoney(Math.abs(pnl))}</div>
                <div class="${color}" style="font-size:.7rem;font-weight:900;">${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%</div>
              </div>
            </div>
            <div class="tx-detail">
              Allocated: $${formatMoney(c.amountUsdt)} USDT • Current value: $${formatMoney(c.markValueUsdt || Number(c.amountUsdt || 0) + pnl)}
              <br>Mirrored positions: ${(c.mirroredPositions || c.copiedPositions || []).length}
              ${c.treasuryAddress ? `<br>Deposit: ${escapeHtml(shortAddress(c.treasuryAddress))}` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderDeposits() {
      const deposits = [
        ...(walletState.tradeDeposits || []),
        ...(walletState.copyDeposits || [])
      ];

      const view = document.getElementById('depositsView');

      if (!deposits.length) {
        view.innerHTML = `<div class="empty">No recorded deposits yet.</div>`;
        return;
      }

      view.innerHTML = deposits.slice(0, 40).map(d => {
        return `
          <div class="tx-card">
            <div class="tx-top">
              <div>
                <div class="tx-title">${escapeHtml(d.type || 'Deposit')}</div>
                <div class="tx-date">${d.createdAt ? new Date(d.createdAt).toLocaleString() : ''}</div>
              </div>
              <div style="font-weight:950;">$${formatMoney(d.amountUsdt || 0)}</div>
            </div>
            <div class="tx-detail">
              Network: ${escapeHtml(d.destinationNetwork || d.sourceUsdtNetwork || 'Auto')}
              <br>Address: ${escapeHtml(d.destinationAddress || '')}
              <br>TX: ${escapeHtml(d.txHash || '')}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderHistory() {
      const history = walletState.orderHistory || [];
      const view = document.getElementById('historyView');

      if (!history.length) {
        view.innerHTML = `<div class="empty">No closed trade history.</div>`;
        return;
      }

      view.innerHTML = history.slice(0, 40).map(h => {
        const pnl = Number(h.pnl || 0);
        const roi = Number(h.roi || 0);
        const color = pnl >= 0 ? 'text-green' : 'text-red';

        return `
          <div class="tx-card">
            <div class="tx-top">
              <div>
                <div class="tx-title">${escapeHtml(h.symbol || 'TRADE')} ${escapeHtml(h.side || '')} ${Number(h.leverage || 1)}x</div>
                <div class="tx-date">${h.closedAt ? new Date(h.closedAt).toLocaleString() : ''}</div>
              </div>
              <div style="text-align:right;">
                <div class="${color}" style="font-weight:950;">${pnl >= 0 ? '+' : '-'}$${formatMoney(Math.abs(pnl))}</div>
                <div class="${color}" style="font-size:.7rem;font-weight:900;">${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%</div>
              </div>
            </div>
            <div class="tx-detail">
              ${escapeHtml(h.closeReason || 'Closed')} • Entry $${formatPriceSmart(h.entryPrice || 0)} • Close $${formatPriceSmart(h.closePrice || 0)}
            </div>
          </div>
        `;
      }).join('');
    }

    function switchActivityTab(tab, el) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      el.classList.add('active');

      document.getElementById('positionsView').style.display = tab === 'positions' ? 'grid' : 'none';
      document.getElementById('copyView').style.display = tab === 'copy' ? 'grid' : 'none';
      document.getElementById('depositsView').style.display = tab === 'deposits' ? 'grid' : 'none';
      document.getElementById('historyView').style.display = tab === 'history' ? 'grid' : 'none';
    }

    function selectAsset(symbol, tokenId = '') {
      selectedAsset = symbol;
      window.selectedTensorTokenId = tokenId || '';

      const meta = assetMeta[selectedAsset];
      if (meta && meta.networks && !meta.networks.includes(selectedNetwork)) {
        selectedNetwork = meta.networks[0];
      }

      renderNetworkSelect();
      renderAssets();
      renderAddress();
      renderHero();

      const sendAsset = document.getElementById('sendAsset');
      if (sendAsset) sendAsset.value = selectedAsset;
    }

    async function setNetwork(key) {
      selectedNetwork = normalizeNetwork(key);

      renderNetworkSelect();
      renderAddress();
      renderHero();

      try {
        const res = await fetch('/api/wallet/usdt-network', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ network: selectedNetwork })
        });

        if (res.ok) {
          const data = await res.json();
          walletState.usdtNetwork = data.usdtNetwork || selectedNetwork;
        }
      } catch {}
    }

    async function copyCurrentAddress() {
      const address = getCurrentAddress();

      try {
        await navigator.clipboard.writeText(address);
        showToast('Address copied');
      } catch {
        prompt('Copy address:', address);
      }
    }

    function openReceiveModal() {
      renderAddress();
      document.getElementById('receiveModal').classList.add('show');
    }

    function closeReceiveModal() {
      document.getElementById('receiveModal').classList.remove('show');
    }

    function focusSendForm() {
      document.getElementById('sendPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => document.getElementById('sendAmount').focus(), 350);
    }

    async function sendAsset() {
      const asset = document.getElementById('sendAsset').value;
      const network = document.getElementById('sendNetwork').value;
      const amount = Number(document.getElementById('sendAmount').value || 0);
      const toAddress = document.getElementById('sendTo').value.trim();

      if (!asset || !network || !amount || amount <= 0 || !toAddress) {
        showToast('Fill send details');
        return;
      }

      try {
        const res = await fetch('/api/wallet/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            asset,
            network,
            amount,
            toAddress
          })
        });

        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Send failed');
          return;
        }

        document.getElementById('sendAmount').value = '';
        document.getElementById('sendTo').value = '';

        showToast(`Sent: ${shortAddress(data.txHash || '')}`);
      } catch {
        showToast('Network error');
      }
    }

    async function saveVault() {
      const encryptedVault = document.getElementById('vaultInput').value.trim();

      if (!encryptedVault) {
        showToast('Vault is empty');
        return;
      }

      try {
        const res = await fetch('/api/wallet/vault', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            encryptedVault,
            publicWallets: walletState.publicWallets || []
          })
        });

        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Vault save failed');
          return;
        }

        walletState.encryptedVault = encryptedVault;
        showToast('Vault saved');
      } catch {
        showToast('Network error');
      }
    }

    async function refreshWallet() {
      try {
        const res = await fetch(`/api/wallet?_t=${Date.now()}`);

        if (res.ok) {
          walletState = await res.json();

          if (walletState.treasuryDestinations) {
            Object.keys(walletState.treasuryDestinations).forEach(key => {
              networkMap[key] = {
                ...(networkMap[key] || {}),
                key,
                ...walletState.treasuryDestinations[key],
                short: networkMap[key]?.short || key.toUpperCase()
              };
            });
          }

          selectedNetwork = normalizeNetwork(walletState.usdtNetwork || selectedNetwork);
        }

        const stateRes = await fetch(`/api/trading/state?_t=${Date.now()}`);

        if (stateRes.ok) {
          const state = await stateRes.json();

          walletState.usdtBalance = Number(state.usdtBalance || 0);
          walletState.usdtNetwork = state.usdtNetwork || walletState.usdtNetwork || selectedNetwork;
          walletState.positions = state.positions || [];
          walletState.orderHistory = state.orderHistory || [];
          walletState.tradeDeposits = state.tradeDeposits || [];
          walletState.copyTrades = state.copyTrades || [];
          walletState.copyDeposits = state.copyDeposits || [];

          selectedNetwork = normalizeNetwork(walletState.usdtNetwork || selectedNetwork);
        }

        await refreshTensor();
        await refreshPrices();

        renderAll();
      } catch (e) {
        console.error('refreshWallet error:', e);
        showToast('Could not refresh wallet');
      }
    }

    async function refreshTensor() {
      try {
        const res = await fetch(`/api/tensor?_t=${Date.now()}`);

        if (!res.ok) return;

        const data = await res.json();

        tensorRegistry = data.registry || [];
        walletState.tensorAddress = data.address || walletState.tensorAddress;
        walletState.tensorBalances = data.balances || walletState.tensorBalances || {};
      } catch {}
    }

    async function refreshPrices() {
      const ids = Object.values(assetMeta)
        .map(a => a.priceId)
        .filter(Boolean)
        .join(',');

      if (!ids) return;

      try {
        const res = await fetch(`/api/prices?ids=${encodeURIComponent(ids)}&_t=${Date.now()}`);
        if (res.ok) prices = await res.json();
      } catch {}

      renderHero();
      renderAssets();
    }

    function renderSendSelectors() {
      const assets = buildAssetList();
      renderSendAssetOptions(assets);
      renderNetworkSelect();

      const sendAsset = document.getElementById('sendAsset');
      const sendNetwork = document.getElementById('sendNetwork');

      sendAsset.onchange = function() {
        selectAsset(this.value, '');
      };

      sendNetwork.onchange = function() {
        setNetwork(this.value);
      };
    }

    function renderAll() {
      updateAdminDetectionUI();
      renderHero();
      renderSendSelectors();
      renderAssets();
      renderNetworkSelect();
      renderAddress();
      renderActivity();

      const vault = document.getElementById('vaultInput');
      if (vault && walletState.encryptedVault && !vault.value) {
        vault.value = walletState.encryptedVault;
      }
    }

    async function bootWallet() {
      document.documentElement.setAttribute('data-theme', currentTheme);

      selectedNetwork = normalizeNetwork(walletState.usdtNetwork || selectedNetwork);

      renderAll();

      await refreshWallet();

      if (refreshInterval) clearInterval(refreshInterval);

      refreshInterval = setInterval(async () => {
        await refreshWallet();
      }, 5000);
    }

    window.addEventListener('load', bootWallet);
  </script>
</body>
</html>