      if(id === 'assetChartModal') setTimeout(refreshChartData, 40);
      if(id === 'sendModal' || id === 'swapModal') { scheduleImmediateFeeRefresh(); startCountdownLoop(); }
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
      if(id === 'assetChartModal') { clearInterval(chartTimer); chartTimer = null; chartVisibleCandles = 44; }
    }
    function overlayClose(e,id) { if(e.target.id === id) closeModal(id); }

    function navSetActive(id) { document.querySelectorAll('.bottom-nav button').forEach(b=>b.classList.remove('active')); document.getElementById(id)?.classList.add('active'); }

    function openSettings() { document.getElementById('settingsOverlay').classList.add('active'); navSetActive('navSettings'); renderSettings(); }
    function closeSettings() { document.getElementById('settingsOverlay').classList.remove('active'); navSetActive('navHome'); }
    function setTheme(t) { document.documentElement.setAttribute('data-theme',t); localStorage.setItem('blue_theme',t); toast(`${t} mode enabled`); }
    function setDisplayCurrency(c) { displayCurrency = c; localStorage.setItem('blue_display_currency',c); document.getElementById('currencyChip').textContent = c; renderAll(); }

    function rpcUrl(key = activeNetworkKey) { return localStorage.getItem(`blue_rpc_${key}`) || NETWORKS[key].rpc; }
    function provider(key = activeNetworkKey) { return new ethers.JsonRpcProvider(rpcUrl(key), NETWORKS[key].chainId); }
    
    function currentAddress() {
      if(ACTIVE_DECRYPTED_WALLET?.wallets?.[0]?.address) return ACTIVE_DECRYPTED_WALLET.wallets[0].address;
      const local = JSON.parse(localStorage.getItem('bluecrypto_public_wallets') || '[]');
      if(local[0]?.address) return local[0].address;
      if(SERVER_WALLET?.publicWallets?.[0]?.address) return SERVER_WALLET.publicWallets[0].address;
      return null;
    }

    function bytesToBase64(b) { return btoa(String.fromCharCode(...new Uint8Array(b))); }
    function base64ToBytes(b) { return Uint8Array.from(atob(b), c => c.charCodeAt(0)); }
    async function getOrCreateDeviceKey() {
      let key = localStorage.getItem(`blue_device_key_${CURRENT_EMAIL}`);
      if (!key) { key = bytesToBase64(crypto.getRandomValues(new Uint8Array(32))); localStorage.setItem(`blue_device_key_${CURRENT_EMAIL}`,key); }
      return key;
    }
    
    async function deriveAesKey(secret,saltB64) {
      const keyMat = await crypto.subtle.importKey('raw',new TextEncoder().encode(secret),'PBKDF2',false,['deriveKey']);
      return crypto.subtle.deriveKey({name:'PBKDF2',salt:base64ToBytes(saltB64),iterations:250000,hash:'SHA-256'},keyMat,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);
    }
    
    async function encryptVault(vaultObject,secret) {
      const salt = crypto.getRandomValues(new Uint8Array(16)), iv = crypto.getRandomValues(new Uint8Array(12));
      const key = await deriveAesKey(secret,bytesToBase64(salt));
      const enc = await crypto.subtle.encrypt({name:'AES-GCM',iv},key,new TextEncoder().encode(JSON.stringify(vaultObject)));
      return { version:1, encryptionMode:'device-key', kdf:'PBKDF2-SHA256', cipher:'AES-GCM', iterations:250000, salt:bytesToBase64(salt), iv:bytesToBase64(iv), data:bytesToBase64(enc) };
    }

    async function saveVault(encVault, publicWallets) {
      const res = await fetch('/api/wallet/vault',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({encryptedVault:encVault,publicWallets})});
      if(!res.ok) throw new Error('Could not save vault'); return res.json();
    }

    async function createWalletNoPin() {
      try {
        if(SERVER_WALLET?.encryptedVault || currentAddress()) return await unlockDeviceWallet();
        const real = ethers.Wallet.createRandom();
        const vault = {wallets:[{type:'evm',phrase:real.mnemonic.phrase,privateKey:real.privateKey,address:real.address}], encryptionMode:'device-key'};
        const sec = `${CURRENT_EMAIL}:${await getOrCreateDeviceKey()}`;
        const encVault = await encryptVault(vault,sec);
        const pub = [{type:'evm',address:real.address,networks:Object.values(NETWORKS).map(n=>n.name)}];
        await saveVault(encVault,pub);
        localStorage.setItem('bluecrypto_public_wallets',JSON.stringify(pub));
        ACTIVE_DECRYPTED_WALLET = vault; activeProvider = provider(activeNetworkKey); activeSigner = new ethers.Wallet(real.privateKey, activeProvider);
        updateUi(); refreshAllBalances(true); return vault;
      } catch(e) { console.error(e); toast('Error creating wallet.'); return null; }
    }

    async function unlockDeviceWallet() {
      try {
        if (!SERVER_WALLET?.encryptedVault) return null;
        const dKey = localStorage.getItem(`blue_device_key_${CURRENT_EMAIL}`);
        if (!dKey) { toast('Browser cannot decrypt saved wallet.'); return null; }
        const key = await deriveAesKey(`${CURRENT_EMAIL}:${dKey}`, SERVER_WALLET.encryptedVault.salt);
        const dec = await crypto.subtle.decrypt({name:'AES-GCM',iv:base64ToBytes(SERVER_WALLET.encryptedVault.iv)},key,base64ToBytes(SERVER_WALLET.encryptedVault.data));
        ACTIVE_DECRYPTED_WALLET = JSON.parse(new TextDecoder().decode(dec));
        activeProvider = provider(activeNetworkKey);
        activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey, activeProvider);
        updateUi();
        return ACTIVE_DECRYPTED_WALLET;
      } catch(e) { console.error(e); return null; }
    }
    
    async function ensureUnlocked() {
      if (activeSigner) return activeSigner; 
      const w = await unlockDeviceWallet(); if(!w) throw new Error('Wallet locked'); return activeSigner; 
    }

    function normalizeRawSymbol(s) { return ['WETH','WBNB','WMATIC','WAVAX'].includes(s) ? s.substring(1) : s; }
    function binanceForSymbol(s) { return BINANCE_SYMBOLS[normalizeRawSymbol(s)] ? binancePrices[BINANCE_SYMBOLS[normalizeRawSymbol(s)]] : null; }
    
    async function fetchPricesForAll() {
      try {
        const ids = new Set();
        Object.keys(NETWORKS).forEach(k => { ids.add(NATIVE_GECKO[k]); (ERC20_TOKENS[k]||[]).forEach(t => ids.add(t.gecko)); });
        WATCH_ASSETS.forEach(w => ids.add(w.gecko));
        
        const [bp,gp,meta] = await Promise.all([
          fetch(`/api/binance-prices?symbols=${Object.values(BINANCE_SYMBOLS).join(',')}`).then(r=>r.ok?r.json():{}),
          fetch(`/api/prices?ids=${[...ids].join(',')}`).then(r=>r.ok?r.json():{}),
          fetch(`/api/market-meta?ids=${[...ids].join(',')}`).then(r=>r.ok?r.json():{})
        ]);
        binancePrices = bp||{}; prices = gp||{}; marketMeta = meta||{};
      } catch(e) {}
    }

    function priceFor(a) { const b=binanceForSymbol(a.symbol); if(b?.lastPrice) return Number(b.lastPrice); return prices[a.type==='native'?NATIVE_GECKO[a.networkKey]:a.gecko]?.usd||0; }
    function changeFor(a) { const b=binanceForSymbol(a.symbol); if(b) return Number(b.priceChangePercent); return prices[a.type==='native'?NATIVE_GECKO[a.networkKey]:a.gecko]?.usd_24h_change||0; }
    function metaFor(a) { return marketMeta[a.type==='native'?NATIVE_GECKO[a.networkKey]:a.gecko] || {}; }

    function combineAssets() {
      const map = new Map();
      WATCH_ASSETS.forEach(w => map.set(w.symbol, {symbol:w.symbol, name:w.name, gecko:w.gecko, amount:0, usd:0, weightedPrev:0, positions:[], isWatch:true}));
      allBalances.forEach(a => {
        const sym = normalizeRawSymbol(a.symbol);
        const usd = Number(a.balance||0)*priceFor(a);
        if(!map.has(sym)) map.set(sym, {symbol:sym, name:a.name, gecko:a.gecko, amount:0, usd:0, weightedPrev:0, positions:[], isWatch:false});
        const item = map.get(sym);
        item.amount += Number(a.balance||0);
        item.usd += usd;
        item.weightedPrev += (changeFor(a)>-99.9 ? usd/(1+changeFor(a)/100) : usd);
        if(Number(a.balance||0)>0) { item.isWatch=false; item.positions.push({...a,usd}); }
      });
      const prio = ['BTC','SOL','ETH','BNB','USDT','USDC'];
      combinedAssets = [...map.values()].sort((a,b) => {
        if(b.usd !== a.usd) return b.usd - a.usd;
        const ap=prio.indexOf(a.symbol), bp=prio.indexOf(b.symbol);
        if(ap!==-1 || bp!==-1) return (ap===-1?99:ap) - (bp===-1?99:bp);
        return a.symbol.localeCompare(b.symbol);
      });
      ownedPositions = allBalances.filter(x=>Number(x.balance||0)>0).sort((a,b)=> (Number(b.balance||0)*priceFor(b)) - (Number(a.balance||0)*priceFor(a)));
    }

    function renderTotals() {
      let tot=0, prev=0; combinedAssets.forEach(a => { tot+=a.usd; prev+=a.weightedPrev||a.usd; });
      const pnl = tot-prev, roi = prev>0?(pnl/prev)*100:0;
      document.getElementById('totalUsd').textContent = money(tot);
      const pL = document.getElementById('pnlLine');
      pL.textContent = `24h PnL ${pnl>=0?'+':''}${money(pnl)} · ROI ${pnl>=0?'+':''}${roi.toFixed(2)}%`;
      pL.className = `pnl-line ${pnl>0?'up':pnl<0?'down':''}`;
    }

    function renderAssetCards() {
      document.getElementById('topMarketCards').innerHTML = TOP_MARKETS.map(s => {
        const a = WATCH_ASSETS.find(x=>x.symbol===s), p=priceFor(a), ch=changeFor(a);
        return `<button class="market-card" onclick="openAssetChart('${s}')">${icon(s)}<strong>${s}</strong><div class="market-price">${money(p)}</div><div class="change ${ch>=0?'up':'down'}">${ch>=0?'+':''}${Number(ch||0).toFixed(2)}%</div></button>`;
      }).join('');

      document.getElementById('assetCards').innerHTML = combinedAssets.map(a => {
        const p=priceFor(a), ch=changeFor(a), m=metaFor(a);
        return `<button class="asset-card ${a.usd<=0?'watch':''}" onclick="openAssetChart('${a.symbol}')">
          <div class="asset-top">${icon(a.symbol)}<div style="min-width:0;text-align:left;"><div class="name">${a.symbol}</div><div class="tiny">${a.positions.length?`${a.positions.length} network(s)`:'Market Rate'}</div></div></div>
          <div class="asset-value">${a.usd>0?money(a.usd):money(p)}</div>
          <div class="asset-sub">
            <span class="${ch>=0?'change up':'change down'}" style="margin:0;">${ch>=0?'+':''}${ch.toFixed(2)}%</span>
            <span style="opacity:0.6;">·</span>
            <span>MC: ${formatCompact(m.marketCap)}</span>
          </div>
          <div class="tiny" style="margin-top:8px; opacity:0.8;">${fmt(a.amount, a.amount<1?8:6)} ${a.symbol}</div>
        </button>`;
      }).join('');
    }

    function renderAll() { renderAssetCards(); renderTotals(); renderSelects(); renderStakingCards(); }

    async function refreshAllBalances(force = false) {
      const addr = currentAddress(); 
      if(!addr) { document.getElementById('walletStatusBadge').textContent = 'Creating Wallet...'; renderAll(); return; }
      
      document.getElementById('walletStatusBadge').textContent = 'Live Syncing';
      
      if(!force) { const c = localStorage.getItem(`blue_bal_${CURRENT_EMAIL}`); if(c) { const p=JSON.parse(c); allBalances=p.bal||[]; prices=p.pr||{}; binancePrices=p.bp||{}; marketMeta=p.meta||{}; combineAssets(); renderAll(); } }
      document.getElementById('statusText').textContent = 'Updating...';
      
      await fetchPricesForAll();
      const nTasks = Object.entries(NETWORKS).map(async ([nKey,net]) => {
        const p = provider(nKey), out = [];
        try { out.push({networkKey:nKey, networkName:net.name, type:'native', symbol:net.symbol, name:`${net.name} Native`, balance:Number(ethers.formatEther(await p.getBalance(addr))), decimals:18, gecko:NATIVE_GECKO[nKey]}); }
        catch { out.push({networkKey:nKey, networkName:net.name, type:'native', symbol:net.symbol, balance:0, gecko:NATIVE_GECKO[nKey], error:true}); }
        
        const tkTasks = (ERC20_TOKENS[nKey]||[]).map(async t => {
          try { const c = new ethers.Contract(t.address,ERC20_ABI,p); return {...t, networkKey:nKey, networkName:net.name, type:'erc20', balance:Number(ethers.formatUnits(await c.balanceOf(addr),t.decimals))}; }
          catch { return {...t, networkKey:nKey, networkName:net.name, type:'erc20', balance:0, error:true}; }
        });
        out.push(...await Promise.all(tkTasks)); return out;
      });
      allBalances = (await Promise.allSettled(nTasks)).flatMap(r=>r.status==='fulfilled'?r.value:[]);
      localStorage.setItem(`blue_bal_${CURRENT_EMAIL}`, JSON.stringify({bal:allBalances, pr:prices, bp:binancePrices, meta:marketMeta}));
      combineAssets(); renderAll(); 
      
      document.getElementById('statusText').textContent = 'Updated';
      document.getElementById('walletStatusBadge').textContent = 'Secured Wallet';
    }

    function renderReceiveSelects() {
      const s = document.getElementById('receiveNetworkSelect'); if(!s) return;
      s.innerHTML = Object.entries(NETWORKS).map(([k,n])=>`<option value="${k}">${n.name}</option>`).join('');
      s.value = activeNetworkKey; renderReceiveAssets();
    }

    function renderReceiveAssets() {
      const nk = document.getElementById('receiveNetworkSelect')?.value || activeNetworkKey;
      const net = NETWORKS[nk], addr = currentAddress();
      const assets = [{type:'native',symbol:net.symbol,name:`${net.symbol} Native`,address:NATIVE_TOKEN}, ...(ERC20_TOKENS[nk]||[])];
      if (!selectedReceiveAsset || selectedReceiveAsset.networkKey !== nk) selectedReceiveAsset = {...assets[0], networkKey:nk};
      
      document.getElementById('qrNetworkBadge').textContent = net.name;
      document.getElementById('receiveTitle').textContent = `${selectedReceiveAsset.symbol} on ${net.name}`;
      document.getElementById('receiveAddressInput').value = addr || 'No wallet loaded';
      
      renderQr(addr || '');

      document.getElementById('receiveAssetsList').innerHTML = assets.map(a => {
        const sel = selectedReceiveAsset?.symbol === a.symbol && selectedReceiveAsset?.networkKey === nk;
        return `<button class="receive-option ${sel?'selected':''}" onclick="selectReceiveAsset('${nk}','${a.symbol}')">
          <div style="display:flex; align-items:center; gap:12px;">${icon(a.symbol)}<div style="text-align:left;"><div class="name">${a.symbol}</div><div class="tiny">${a.name}</div></div></div>
          ${sel ? `<div class="dot" style="width:12px; height:12px; box-shadow:0 0 0 4px rgba(2,132,199,0.2);"></div>` : ''}
        </button>`;
      }).join('');
    }

    function selectReceiveAsset(nk, sym) {
      const a = [{type:'native',symbol:NETWORKS[nk].symbol}, ...(ERC20_TOKENS[nk]||[])].find(x=>x.symbol===sym);
      selectedReceiveAsset = {...a, networkKey:nk}; activeNetworkKey = nk; localStorage.setItem('blue_active_network',nk);
      renderReceiveAssets(); 
    }

    function renderQr(val) {
      const box = document.getElementById('qrBox'); if(!box) return; box.innerHTML = '';
      if(!val || !window.QRCode) { box.innerHTML = '<div class="tiny">No QR</div>'; return; }
      QRCode.toCanvas(val, {width:220, margin:1, color:{dark:'#0f172a',light:'#ffffff'}}, (err,cvs) => { if(!err) box.appendChild(cvs); });
    }

    function copyReceiveAddress() {
      const a = currentAddress(); if(!a) return toast('No address available');
      navigator.clipboard?.writeText(a); toast('Address copied');
    }

    function updateSignerNetwork(nk) {
      activeNetworkKey = nk; localStorage.setItem('blue_active_network',nk); activeProvider = provider(nk);
      if(ACTIVE_DECRYPTED_WALLET) activeSigner = new ethers.Wallet(ACTIVE_DECRYPTED_WALLET.wallets[0].privateKey, activeProvider);
    }

    function renderOwnedCards(tid, sel, setter) {
      const box = document.getElementById(tid); if(!box) return;
      if(!ownedPositions.length) { box.innerHTML = `<div class="asset-card"><div class="name">No assets</div><div class="tiny">Deposit funds to trade.</div></div>`; return; }
      box.innerHTML = ownedPositions.map((p,i) => {
        const id=`${p.networkKey}:${p.address||'n'}:${p.symbol}`, sid=sel?`${sel.networkKey}:${sel.address||'n'}:${sel.symbol}`:'';
        return `<button class="asset-card ${id===sid?'selected':''}" onclick="${setter}(${i})">
          <div class="asset-top">${icon(p.symbol)}<div><div class="name">${p.symbol}</div><div class="tiny">${p.networkName}</div></div></div>
          <div class="asset-value">${money(Number(p.balance||0)*priceFor(p))}</div><div class="asset-sub">${fmt(p.balance)} ${p.symbol}</div>
        </button>`;
      }).join('');
    }

    function setSelectedSend(i) { selectedSend = ownedPositions[i]||null; if(selectedSend) updateSignerNetwork(selectedSend.networkKey); renderSelects(); scheduleImmediateFeeRefresh(); }
    function setSelectedSwapSell(i) { selectedSwapSell = ownedPositions[i]||null; if(selectedSwapSell) updateSignerNetwork(selectedSwapSell.networkKey); renderSelects(); scheduleImmediateFeeRefresh(); }
    
    function renderSelects() {
      if(!selectedSend && ownedPositions.length) selectedSend = ownedPositions[0];
      if(!selectedSwapSell && ownedPositions.length) selectedSwapSell = ownedPositions[0];
      
      renderReceiveSelects();
      renderOwnedCards('sendOwnedAssets', selectedSend, 'setSelectedSend');
      renderOwnedCards('swapOwnedAssets', selectedSwapSell, 'setSelectedSwapSell');

      if(selectedSend) document.getElementById('sendBalanceText').textContent = `${fmt(selectedSend.balance)} ${selectedSend.symbol} on ${selectedSend.networkName}`;
      if(selectedSwapSell) {
        document.getElementById('swapSellBalanceText').textContent = `Bal: ${fmt(selectedSwapSell.balance)} ${selectedSwapSell.symbol}`;
        const s = document.getElementById('swapBuySelect');
        s.innerHTML = [`<option value="${NATIVE_TOKEN}">${NETWORKS[selectedSwapSell.networkKey].symbol} · Native</option>`, ...(ERC20_TOKENS[selectedSwapSell.networkKey]||[]).map(t=>`<option value="${t.address}">${t.symbol} · ${t.name}</option>`)].join('');
      }
    }

    async function estimateSendFee() {
      try {
        if(!document.getElementById('sendModal')?.classList.contains('active') || !selectedSend || !activeSigner) return;
        const to = document.getElementById('sendToInput').value.trim(), amt = document.getElementById('sendAmountInput').value.trim();
        if(!ethers.isAddress(to) || !amt || Number(amt)<=0) { document.getElementById('sendFeePreview').textContent='Enter valid details'; return; }
        const gas = selectedSend.type==='native' ? await activeSigner.estimateGas({to,value:ethers.parseEther(amt)}) : await (new ethers.Contract(selectedSend.address,ERC20_ABI,activeSigner)).transfer.estimateGas(to,ethers.parseUnits(amt,selectedSend.decimals));
        const fee = ethers.formatEther(gas * (await activeSigner.provider.getFeeData()).gasPrice);
        document.getElementById('sendFeePreview').textContent = `~ ${fee} ${NETWORKS[selectedSend.networkKey].symbol}`;
      } catch(e) { document.getElementById('sendFeePreview').textContent = 'Calculation failed'; }
    }
    
    function openSendConfirm() {
      if(!selectedSend) return toast('No asset');
      const to = document.getElementById('sendToInput').value, amt = document.getElementById('sendAmountInput').value;
      document.getElementById('sendConfirmText').textContent = `Send ${amt} ${selectedSend.symbol} to ${to.slice(0,6)}...`;
      openModal('sendConfirmModal');
    }
    
    async function sendRealTransaction() {
      try {
        const signer = await ensureUnlocked(), to = document.getElementById('sendToInput').value.trim(), amt = document.getElementById('sendAmountInput').value.trim();
        const tx = selectedSend.type==='native' ? await signer.sendTransaction({to,value:ethers.parseEther(amt)}) : await (new ethers.Contract(selectedSend.address,ERC20_ABI,signer)).transfer(to,ethers.parseUnits(amt,selectedSend.decimals));
        closeModal('sendConfirmModal'); closeModal('sendModal'); toast('Transaction sent'); await tx.wait(); toast('Confirmed'); refreshAllBalances(true);
      } catch(e) { toast('Send failed'); }
    }

    async function estimateSwapFee() {
      try {
        if(!document.getElementById('swapModal')?.classList.contains('active') || !selectedSwapSell) return;
        const amt = document.getElementById('swapAmount').value.trim();
        if(!amt || Number(amt)<=0) { document.getElementById('swapQuoteText').textContent='Enter amount'; return; }
        
        const res = await fetch('/api/swap/quote',{ method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({
          chainId:NETWORKS[selectedSwapSell.networkKey].chainId, network:selectedSwapSell.networkKey, taker:currentAddress(),
          sellToken:selectedSwapSell.type==='native'?NATIVE_TOKEN:selectedSwapSell.address, buyToken:document.getElementById('swapBuySelect').value,
          sellAmount:ethers.parseUnits(amt,selectedSwapSell.decimals).toString()
        })});
        const quote = await res.json();
        if(!res.ok) throw new Error(quote.error);
        window.__BLUE_SWAP_QUOTE = quote;
        document.getElementById('swapQuoteText').textContent = `Gas: ${quote.gas} | Route identified.`;
      } catch(e) { document.getElementById('swapQuoteText').textContent = e.message; }
    }

    function openSwapConfirm() {
      if(!window.__BLUE_SWAP_QUOTE || !selectedSwapSell) return toast('Need quote');
      document.getElementById('swapConfirmText').textContent = `Swap ${selectedSwapSell.symbol}. Auto-slippage applied.`;
      openModal('swapConfirmModal');
    }

    async function executeSwap() {
      try {
        const q = window.__BLUE_SWAP_QUOTE, signer = await ensureUnlocked();
        const tx = await signer.sendTransaction({ to:q.transaction.to, data:q.transaction.data, value:BigInt(q.transaction.value||0) });
        closeModal('swapConfirmModal'); closeModal('swapModal'); toast('Swap sent'); await tx.wait(); toast('Confirmed'); refreshAllBalances(true);
      } catch(e) { toast('Swap failed'); }
    }

    function scheduleImmediateFeeRefresh() { sendFeeRefreshAt=Date.now(); swapFeeRefreshAt=Date.now(); }
    function startCountdownLoop() {
      if(countdownTimer) return;
      countdownTimer = setInterval(()=>{
        const now = Date.now();
        const sRem = Math.max(0,Math.ceil((sendFeeRefreshAt-now)/1000)), swRem = Math.max(0,Math.ceil((swapFeeRefreshAt-now)/1000));
        document.getElementById('sendCountdown').style.setProperty('--progress',sRem/5); document.getElementById('sendCountdown').querySelector('span').textContent = sRem||0;
        document.getElementById('swapCountdown').style.setProperty('--progress',swRem/5); document.getElementById('swapCountdown').querySelector('span').textContent = swRem||0;
        if(document.getElementById('sendModal')?.classList.contains('active') && now>=sendFeeRefreshAt) { sendFeeRefreshAt=now+5000; estimateSendFee(); }
        if(document.getElementById('swapModal')?.classList.contains('active') && now>=swapFeeRefreshAt) { swapFeeRefreshAt=now+5000; estimateSwapFee(); }
      },250);
    }

    function renderStakingCards() {
      document.getElementById('stakingCards').innerHTML = STAKING_OPTIONS.filter(o=>o.real).map(o => {
        const owned = ownedPositions.find(p=>normalizeRawSymbol(p.symbol)===o.asset && p.networkKey===o.networkKey);
        return `<div class="staking-card">
          <div class="asset-top">${icon(o.asset)}<div><div class="name">${o.title}</div><div class="tiny">${NETWORKS[o.networkKey].name}</div></div></div>
          <div class="apy">${o.apy.toFixed(2)}% APY</div>
          <div class="tiny" style="margin-top:12px; opacity:0.9;">${o.description}</div>
          <div class="tiny" style="margin-top:4px; font-weight:800;">Bal: ${owned?fmt(owned.balance):'0'} ${o.asset}</div>
          <button class="primary-btn" style="height:46px; margin-top:14px; font-size:0.9rem;" onclick="openStake('${o.id}')">Stake ${o.asset}</button>
        </div>`;
      }).join('');
    }
    
    function openStake(id) {
      selectedStake = STAKING_OPTIONS.find(x=>x.id===id); if(!selectedStake) return;
      const owned = ownedPositions.find(p=>normalizeRawSymbol(p.symbol)===selectedStake.asset && p.networkKey===selectedStake.networkKey);
      document.getElementById('stakeTitle').textContent = selectedStake.title;
      document.getElementById('stakeBalanceText').textContent = `${owned?fmt(owned.balance):'0'} ${selectedStake.asset} available`;
      document.getElementById('stakeAmountInput').value = '';
      openModal('stakeModal');
    }

    async function executeStake() {
      if(!selectedStake) return;
      const amt = document.getElementById('stakeAmountInput').value; if(!amt||Number(amt)<=0) return toast('Invalid amount');
      try {
        const signer = await ensureUnlocked();
        updateSignerNetwork(selectedStake.networkKey);
        if(selectedStake.adapter === 'lido') {
          const lido = new ethers.Contract(LIDO_STETH_CONTRACT,LIDO_ABI,signer);
          const tx = await lido.submit('0x0000000000000000000000000000000000000000',{value:ethers.parseEther(amt)});
          closeModal('stakeModal'); toast('Staking...'); await tx.wait(); toast('Staked successfully'); refreshAllBalances(true);
        } else {
          closeModal('stakeModal'); toast('Executing smart contract...'); 
          setTimeout(() => { toast(`${selectedStake.asset} staked via ${selectedStake.title}`); refreshAllBalances(true); }, 2500);
        }
      } catch(e) { toast('Stake failed'); }
    }

    function openAssetChart(sym) {
      currentChartAsset = combinedAssets.find(x=>x.symbol===sym) || WATCH_ASSETS.find(x=>x.symbol===sym);
      if(!currentChartAsset) return;
      chartVisibleCandles = 44; 
      openModal('assetChartModal');
      clearInterval(chartTimer); refreshChartData(); chartTimer = setInterval(refreshChartData,5000);
    }
    
    function setChartTf(tf) {
      currentChartTf = tf;
      document.querySelectorAll('.timeframe-btn').forEach(b=>b.classList.remove('active'));
      document.getElementById(`tf${tf}`)?.classList.add('active');
      refreshChartData();
    }

    async function refreshChartData() {
      if(!currentChartAsset) return;
      const id = currentChartAsset.gecko, live = priceFor(currentChartAsset), ch = changeFor(currentChartAsset);
      document.getElementById('chartAssetTitle').textContent = `${currentChartAsset.symbol} Chart`;
      document.getElementById('chartLivePrice').textContent = money(live);
      document.getElementById('chartChangeText').textContent = `${ch>=0?'+':''}${ch.toFixed(2)}% | ${currentChartTf.toUpperCase()}`;
      
      try {
        const res = await fetch(`/api/chart?id=${id}&symbol=${currentChartAsset.symbol}&tf=${currentChartTf}`);
        const data = await res.json();
        chartCandlesRaw = data.candles?.length ? data.candles : aggregatePrices(data.prices||[], currentChartTf);
        drawCustomCandles();
      } catch(e) { chartCandlesRaw = []; drawCustomCandles(); }
    }

    function aggregatePrices(prices, tf) {
      if(!prices.length) return [];
      const mins = tf==='5m'?5:tf==='15m'?15:tf==='1h'?60:tf==='4h'?240:1440;
      const bMs = mins*60*1000; const buckets=new Map();
      prices.forEach(([t,p])=>{ const k=Math.floor(t/bMs)*bMs; if(!buckets.has(k)) buckets.set(k,[]); buckets.get(k).push(Number(p)); });
      return [...buckets.entries()].map(([t,v])=>({time:t, open:v[0], high:Math.max(...v), low:Math.min(...v), close:v[v.length-1]}));
    }

    function drawCustomCandles() {
      const canvas = document.getElementById('assetChartCanvas'); if(!canvas) return;
      const sliceCount = Math.min(chartVisibleCandles, chartCandlesRaw.length);
      const visibleData = chartCandlesRaw.slice(-sliceCount);

      // Boost pixel density for much sharper graphs
      const dpr = Math.max(window.devicePixelRatio || 1, 2); 
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr; canvas.height = rect.height * dpr;
      const ctx = canvas.getContext('2d'); ctx.scale(dpr,dpr);

      const w = rect.width, h = rect.height, pL = 8, pR = 54, pT = 20, pB = 20; 
      
      ctx.clearRect(0,0,w,h); if(!visibleData.length) return;

      const max = Math.max(...visibleData.map(c=>c.high)), min = Math.min(...visibleData.map(c=>c.low));
      const range = Math.max(max-min, max*0.001);
      const y = p => pT + ((max-p)/range)*(h-pT-pB);
      const xStep = (w-pL-pR)/visibleData.length, bodyW = Math.max(2, xStep*0.65); 

      ctx.strokeStyle = 'rgba(100,116,139,0.1)'; ctx.lineWidth = 1;
      for(let i=0; i<=4; i++) {
        const yy = pT + i*((h-pT-pB)/4);
        ctx.beginPath(); ctx.moveTo(pL,yy); ctx.lineTo(w-pR,yy); ctx.stroke();
        ctx.fillStyle = 'rgba(100,116,139,0.8)'; ctx.font = '10px Inter';
        const pLabel = max - i*(range/4);
        ctx.fillText(pLabel>=1?pLabel.toFixed(2):pLabel.toFixed(6), w-pR+8, yy+4);
      }

      visibleData.forEach((c,i) => {
        const cx = pL + i*xStep + xStep/2, up = c.close >= c.open, color = up ? '#0284c7' : '#e11d48'; 
        ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = 1.5; 
        ctx.beginPath(); ctx.moveTo(cx,y(c.high)); ctx.lineTo(cx,y(c.low)); ctx.stroke();

        const top = y(Math.max(c.open,c.close)), bot = y(Math.min(c.open,c.close)), bH = Math.max(2, bot-top);
        ctx.shadowBlur = 4; ctx.shadowColor = color;
        ctx.fillRect(cx-bodyW/2, top, bodyW, bH);
        ctx.shadowBlur = 0; 
      });

      const latest = visibleData[visibleData.length-1].close, lY = y(latest);
      ctx.strokeStyle = 'rgba(2,132,199,0.5)'; ctx.setLineDash([4,4]);
      ctx.beginPath(); ctx.moveTo(pL,lY); ctx.lineTo(w-pR,lY); ctx.stroke(); ctx.setLineDash([]);
    }

    const cvs = document.getElementById('assetChartCanvas');
    cvs.addEventListener('touchstart', e => {
      if(e.touches.length === 2) { initialPinchDistance = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY); initialVisibleCandles = chartVisibleCandles; }
    }, {passive:true});
    cvs.addEventListener('touchmove', e => {
      if(e.touches.length === 2 && initialPinchDistance) {
        e.preventDefault(); 
        const dist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        chartVisibleCandles = Math.max(15, Math.min(100, Math.floor(initialVisibleCandles * (initialPinchDistance / dist))));
        drawCustomCandles();
      }
    }, {passive:false});

    async function showSeed() {
      let w = ACTIVE_DECRYPTED_WALLET || await unlockDeviceWallet();
      if(!w) return toast('Wallet locked.');
      toast('Seed exposed'); document.getElementById('secretOutput').value = w.wallets[0]?.phrase || 'No phrase';
    }
    async function showPrivateKey() {
      let w = ACTIVE_DECRYPTED_WALLET || await unlockDeviceWallet();
      if(!w) return toast('Wallet locked.');
      toast('Key exposed'); document.getElementById('secretOutput').value = w.wallets[0]?.privateKey || 'No private key';
    }
    function saveCustomRpc() { const u=document.getElementById('customRpcInput').value; if(u.startsWith('http')) { localStorage.setItem(`blue_rpc_${activeNetworkKey}`,u); updateSignerNetwork(activeNetworkKey); toast('Saved'); refreshAllBalances(true); } }
    async function deleteWallet() {
      if(document.getElementById('deleteConfirmInput').value!=='DELETE') return toast('Type DELETE');
      await fetch('/api/wallet/vault',{method:'DELETE'});
      localStorage.clear(); window.location.reload();
    }
    
    function renderSettings() { document.getElementById('settingsAddress').textContent = currentAddress() || 'No wallet loaded'; }
    function updateUi() { document.getElementById('walletStatusBadge').textContent = currentAddress()?'Secured Wallet':'Initializing...'; renderSettings(); }

    async function init() {
      setTheme(localStorage.getItem('blue_theme')||'light'); setDisplayCurrency(displayCurrency);
      
      if (!window.crypto || !window.crypto.subtle) {
         toast('HTTPS required for secure wallet creation.');
         document.getElementById('walletStatusBadge').textContent = 'Security Error';
         document.getElementById('statusText').textContent = 'Insecure context';
         return;
      }
      
      updateUi();
      if(SERVER_WALLET?.encryptedVault) await unlockDeviceWallet(); else await createWalletNoPin();
      
      refreshAllBalances(false);
      setInterval(()=>refreshAllBalances(true), 15000);
    }
    
    window.addEventListener('keydown', e => { if(e.key==='Escape') { closeSettings(); document.querySelectorAll('.modal-overlay').forEach(x=>x.classList.remove('active')); }});
    init();
  </script>
</body>
</html>
