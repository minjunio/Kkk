        <div class="metrics-row"><span>Est. Short Liq. Price</span><span class="metrics-val" style="color:#f59e0b;" id="liqShort">0.00</span></div>
        <div class="metrics-row"><span>USDT Route</span><span class="metrics-val" id="treasuryRoute">Auto</span></div>
        <div class="metrics-row"><span>Destination</span><span class="metrics-val" id="treasuryAddress">Auto</span></div>
