<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Tensor | Pro Trading Terminal</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lightweight-charts/dist/lightweight-charts.standalone.production.js"></script>

  <style>
    :root {
      color-scheme: light;
      --bg1: #e9f8ff; --bg2: #f8fcff; --bg3: #d7f0ff;
      --glass: rgba(255,255,255,0.85); --glass2: rgba(255,255,255,0.7);
      --solid: #ffffff; --soft: #f0f7ff; --soft-hover: #e0f0ff;
      --text: #0f172a; --muted: #64748b; --muted2: #94a3b8;
      --blue: #0284c7; --blue2: #2563eb; --cyan: #38bdf8;
      --pink: #e11d48; --green: #10b981;
      --tensor: #8b5cf6; --tensor2: #d946ef; 
      --border: rgba(2,132,199,0.12);
      --shadow2: 0 12px 32px rgba(2,132,199,0.08);
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg1: #060b13; --bg2: #050816; --bg3: #0a1929;
      --glass: rgba(13,22,40,0.88); --glass2: rgba(17,29,51,0.72);
      --solid: #0d1628; --soft: #111d33; --soft-hover: #1e293b;
      --text: #f8fafc; --muted: #94a3b8; --muted2: #64748b;
      --blue: #38bdf8; --tensor: #a78bfa; --tensor2: #e879f9;
      --border: rgba(125,211,252,0.12);
      --shadow2: 0 14px 38px rgba(0,0,0,0.4);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: Inter, system-ui, sans-serif; -webkit-tap-highlight-color: transparent; }
    html, body { width: 100%; height: 100vh; overflow-x: hidden; background: var(--bg2); color: var(--text); }
    
    /* Topbar */
    .topbar { position: sticky; top: 0; z-index: 50; padding: 12px 16px; background: var(--solid); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; }
    .logo { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; color: white; font-weight: 900; background: linear-gradient(135deg, var(--tensor), var(--tensor2)); }
    .brand-title { font-weight: 900; font-size: 1.1rem; }
    .top-actions { display: flex; gap: 12px; }
    .icon-btn { width: 36px; height: 36px; border-radius: 10px; background: var(--soft); border: 1px solid var(--border); color: var(--text); display: grid; place-items: center; cursor: pointer; transition: 0.1s; }
    .icon-btn:hover { background: var(--soft-hover); }

    /* Main Layout */
    .trading-layout { display: grid; grid-template-columns: 1fr 340px; gap: 16px; max-width: 1600px; margin: 0 auto; padding: 16px; height: calc(100vh - 61px); overflow: hidden; }
    
    .left-col { display: flex; flex-direction: column; gap: 16px; overflow: hidden; }
    .right-col { display: flex; flex-direction: column; gap: 16px; overflow-y: auto; padding-right: 4px; }
    .right-col::-webkit-scrollbar { width: 4px; }
    .right-col::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

    .panel { background: var(--solid); border: 1px solid var(--border); border-radius: 20px; padding: 16px; display: flex; flex-direction: column; }

    /* Chart Header */
    .chart-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 16px; flex-wrap: wrap; }
    .asset-selector { appearance: none; background: transparent; border: none; font-size: 1.8rem; font-weight: 900; color: var(--text); outline: none; cursor: pointer; }
    .price-display { font-size: 1.8rem; font-weight: 900; font-variant-numeric: tabular-nums; }
    .price-up { color: var(--green); } .price-down { color: var(--pink); }
    .stat-box { display: flex; flex-direction: column; gap: 2px; }
    .stat-label { font-size: 0.7rem; color: var(--muted); font-weight: 700; text-transform: uppercase; }
    .stat-val { font-size: 0.9rem; font-weight: 800; font-variant-numeric: tabular-nums; }

    /* Chart Area */
    .chart-controls { display: flex; gap: 8px; margin-bottom: 8px; }
    .pill-btn { padding: 4px 12px; border-radius: 99px; font-size: 0.75rem; font-weight: 800; background: var(--soft); color: var(--muted); border: 1px solid transparent; cursor: pointer; transition: 0.2s; }
    .pill-btn.active { background: var(--tensor); color: white; box-shadow: 0 4px 12px rgba(139,92,246,0.3); }
    .chart-container { flex: 1; min-height: 400px; width: 100%; position: relative; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); }

    /* Positions Table */
    .positions-panel { flex: 0 0 280px; overflow: hidden; padding: 0; }
    .pos-tabs { display: flex; gap: 16px; padding: 12px 16px 0; border-bottom: 1px solid var(--border); }
    .pos-tab { padding: 8px 4px; font-size: 0.9rem; font-weight: 800; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; }
    .pos-tab.active { color: var(--text); border-bottom-color: var(--tensor); }
    .table-wrap { overflow: auto; height: calc(100% - 41px); }
    table { width: 100%; border-collapse: collapse; text-align: left; font-variant-numeric: tabular-nums; }
    th { font-size: 0.75rem; color: var(--muted); font-weight: 700; padding: 12px 16px; position: sticky; top: 0; background: var(--solid); z-index: 10; border-bottom: 1px solid var(--border); }
    td { padding: 12px 16px; font-size: 0.85rem; font-weight: 600; border-bottom: 1px solid var(--border); }
    tr:hover td { background: var(--soft); }
    .side-long { color: var(--green); font-weight: 800; } .side-short { color: var(--pink); font-weight: 800; }
    .pnl-pos { color: var(--green); } .pnl-neg { color: var(--pink); }

    /* Order Entry */
    .order-type-tabs { display: flex; background: var(--soft); border-radius: 12px; padding: 4px; margin-bottom: 16px; }
    .order-tab { flex: 1; text-align: center; padding: 8px; font-size: 0.85rem; font-weight: 800; color: var(--muted); cursor: pointer; border-radius: 8px; transition: 0.2s; }
    .order-tab.active { background: var(--solid); color: var(--text); box-shadow: 0 2px 8px rgba(0,0,0,0.05); }

    .input-group { background: var(--soft); border-radius: 16px; padding: 12px 16px; border: 1px solid var(--border); margin-bottom: 16px; transition: 0.2s; display: flex; align-items: center; justify-content: space-between; }
    .input-group:focus-within { border-color: var(--tensor); box-shadow: 0 0 0 3px rgba(139,92,246,0.1); background: var(--solid); }
    .input-group input { width: 100%; background: transparent; border: none; font-size: 1.2rem; font-weight: 900; color: var(--text); outline: none; font-variant-numeric: tabular-nums; }
    .input-suffix { font-size: 0.85rem; font-weight: 800; color: var(--muted); margin-left: 8px; }

    /* Advanced Custom Leverage Slider */
    .leverage-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .lev-badge { background: rgba(139,92,246,0.1); color: var(--tensor); padding: 4px 10px; border-radius: 8px; font-weight: 900; font-size: 0.9rem; border: 1px solid rgba(139,92,246,0.2); }
    .slider-container { position: relative; width: 100%; margin-bottom: 24px; padding: 10px 0; }
    input[type=range] { -webkit-appearance: none; width: 100%; background: transparent; position: relative; z-index: 3; cursor: pointer; }
    input[type=range]:focus { outline: none; }
    input[type=range]::-webkit-slider-runnable-track { width: 100%; height: 6px; background: var(--border); border-radius: 4px; }
    input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; height: 20px; width: 20px; border-radius: 50%; background: white; border: 3px solid var(--tensor); margin-top: -7px; box-shadow: 0 2px 6px rgba(0,0,0,0.2); transition: transform 0.1s; }
    input[type=range]:active::-webkit-slider-thumb { transform: scale(1.2); }
    .slider-progress { position: absolute; top: 10px; left: 0; height: 6px; background: var(--tensor); border-radius: 4px; pointer-events: none; z-index: 2; width: 10%; }
    .lev-marks { display: flex; justify-content: space-between; margin-top: -4px; padding: 0 4px; position: relative; z-index: 1; }
    .lev-marks span { font-size: 0.7rem; font-weight: 700; color: var(--muted2); cursor: pointer; }

    .order-details { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; padding: 12px; background: var(--soft); border-radius: 12px; }
    .detail-row { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 700; }
    .detail-label { color: var(--muted); }
    .detail-val { color: var(--text); font-variant-numeric: tabular-nums; }

    .action-btn { width: 100%; height: 56px; border-radius: 16px; font-size: 1.05rem; font-weight: 900; color: white; border: none; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: 0.15s; }
    .action-btn:active { transform: scale(0.97); }
    .btn-long { background: var(--green); box-shadow: 0 8px 24px rgba(16,185,129,0.2); margin-bottom: 12px; }
    .btn-long:hover { background: #059669; }
    .btn-short { background: var(--pink); box-shadow: 0 8px 24px rgba(225,29,72,0.2); }
    .btn-short:hover { background: #be123c; }

    .close-btn { background: var(--soft); color: var(--text); border: 1px solid var(--border); padding: 6px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 800; cursor: pointer; transition: 0.2s; }
    .close-btn:hover { border-color: var(--tensor); color: var(--tensor); }

    @media (max-width: 1000px) {
      .trading-layout { grid-template-columns: 1fr; overflow-y: auto; height: auto; padding-bottom: 100px; }
      .chart-container { min-height: 350px; }
      .positions-panel { min-height: 300px; }
    }
  </style>
</head>
<body>

  <header class="topbar">
    <a href="/wallet" class="brand">
      <div class="logo">T</div>
      <div class="brand-title">Tensor Trade</div>
    </a>
    <div class="top-actions">
      <div class="icon-btn" onclick="toggleTheme()" title="Toggle Theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </div>
      <a href="/wallet" class="icon-btn" title="Back to Wallet">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
      </a>
    </div>
  </header>

  <main class="trading-layout">
    
    <div class="left-col">
      <div class="panel" style="flex: 1; display: flex; flex-direction: column;">
        
        <div class="chart-header">
          <div style="display: flex; align-items: center; gap: 16px;">
            <select id="assetSelect" class="asset-selector" onchange="switchAsset(this.value)">
              <option value="none">Loading...</option>
            </select>
            <div id="tickerPrice" class="price-display">$0.00</div>
          </div>
          
          <div style="display: flex; gap: 24px;">
            <div class="stat-box"><span class="stat-label">24h Change</span><span id="tickerChange" class="stat-val price-up">+0.00%</span></div>
            <div class="stat-box"><span class="stat-label">24h Vol (USDT)</span><span id="tickerVol" class="stat-val">0.00</span></div>
            <div class="stat-box"><span class="stat-label">Funding / 8h</span><span class="stat-val" style="color: var(--tensor);">0.0150%</span></div>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div class="chart-controls">
              <button class="pill-btn tf-btn active" onclick="setTF(1, this)">1m</button>
              <button class="pill-btn tf-btn" onclick="setTF(5, this)">5m</button>
              <button class="pill-btn tf-btn" onclick="setTF(15, this)">15m</button>
              <button class="pill-btn tf-btn" onclick="setTF(60, this)">1H</button>
              <button class="pill-btn tf-btn" onclick="setTF(1440, this)">1D</button>
            </div>
            <div class="chart-controls">
              <button class="pill-btn type-btn active" onclick="setType('candle', this)">Candles</button>
              <button class="pill-btn type-btn" onclick="setType('line', this)">Line</button>
            </div>
        </div>

        <div class="chart-container" id="chartContainer"></div>
      </div>

      <div class="panel positions-panel">
        <div class="pos-tabs">
          <div class="pos-tab active" onclick="switchTab('positions', this)">Active Positions (1)</div>
          <div class="pos-tab" onclick="switchTab('history', this)">Trade History</div>
        </div>
        
        <div class="table-wrap" id="tabPositions">
          <table>
            <thead>
              <tr>
                <th>Symbol</th><th>Side</th><th>Size (USDT)</th><th>Entry Price</th><th>Mark Price</th><th>Liq. Price</th><th>Margin Ratio</th><th>Unrealized PnL</th><th>Action</th>
              </tr>
            </thead>
            <tbody id="positionsBody">
              </tbody>
          </table>
        </div>

        <div class="table-wrap" id="tabHistory" style="display: none;">
          <table>
            <thead>
              <tr>
                <th>Time</th><th>Symbol</th><th>Side</th><th>Exec. Price</th><th>Size</th><th>Realized PnL</th><th>Status</th>
              </tr>
            </thead>
            <tbody id="historyBody">
               </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="right-col">
      <div class="panel">
        <div class="order-type-tabs">
          <div class="order-tab active">Cross Margin</div>
          <div class="order-tab">Isolated</div>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.8rem;">
          <span style="color: var(--muted); font-weight:700;">Avail. Margin</span>
          <span style="font-weight: 800; font-variant-numeric: tabular-nums;" id="availBal">0.00 USDT</span>
        </div>

        <div class="input-group">
          <div><div class="stat-label">Order Size</div><input type="number" id="tradeAmt" placeholder="0.00" oninput="updateCalculations()"></div>
          <div class="input-suffix">USDT</div>
        </div>

        <div class="leverage-header">
          <span class="stat-label">Leverage Adjustment</span>
          <span class="lev-badge" id="levValText">10x</span>
        </div>
        
        <div class="slider-container">
          <div class="slider-progress" id="levProgress" style="width: 6.66%;"></div>
          <input type="range" id="levSlider" min="1" max="150" value="10" oninput="updateLevSlider(this.value)">
          <div class="lev-marks">
            <span onclick="setLev(1)">1x</span><span onclick="setLev(25)">25x</span><span onclick="setLev(50)">50x</span><span onclick="setLev(100)">100x</span><span onclick="setLev(150)">150x</span>
          </div>
        </div>

        <div class="order-details">
          <div class="detail-row"><span class="detail-label">Position Size</span><span class="detail-val" id="detPosSize">0.00 USDT</span></div>
          <div class="detail-row"><span class="detail-label">Est. Liq Price (Long)</span><span class="detail-val price-up" id="detLiqLong">-</span></div>
          <div class="detail-row"><span class="detail-label">Est. Liq Price (Short)</span><span class="detail-val price-down" id="detLiqShort">-</span></div>
          <div class="detail-row"><span class="detail-label">Est. Maker Fee</span><span class="detail-val" id="detFee">0.00 USDT</span></div>
        </div>

        <button class="action-btn btn-long" onclick="executeTrade('long')">
          Buy / Long
        </button>
        <button class="action-btn btn-short" onclick="executeTrade('short')">
          Sell / Short
        </button>

      </div>
    </div>
  </main>

  <script>
    // System Variables
    let currentTheme = localStorage.getItem('blue_theme') || 'dark';
    document.documentElement.setAttribute('data-theme', currentTheme);
    
    let baseTensorData = [];
    let currentAsset = null;
    let livePrice = 0;
    
    // Chart Variables
    let tvChart = null, candleSeries = null, lineSeries = null;
    let currentTF = 1;
    let currentChartType = 'candle';
    let chartInterval;

    // --- Core Logic ---
    async function initTerminal() {
      // 1. Fetch Registry
      try {
        const res = await fetch(`/api/tensor?_t=${Date.now()}`);
        if(res.ok) {
           const data = await res.json();
           baseTensorData = data.registry || [];
           // Populate Dropdown
           const sel = document.getElementById('assetSelect');
           sel.innerHTML = baseTensorData.map(t => `<option value="${t.id}">${t.symbol}/USDT</option>`).join('');
           if(baseTensorData.length > 0) switchAsset(baseTensorData[0].id);
        }
      } catch(e) { console.error('Failed to load assets.'); }

      // 2. Initialize Chart
      initChart();
      
      // 3. Mock Balances / Positions for demonstration
      document.getElementById('availBal').textContent = '2,450.50 USDT';
      renderPositions();
      renderHistory();
      updateLevSlider(document.getElementById('levSlider').value);
    }

    function switchAsset(id) {
        currentAsset = baseTensorData.find(t => t.id === id);
        if(!currentAsset) return;
        
        livePrice = currentAsset.price;
        document.getElementById('tickerPrice').textContent = money(livePrice);
        
        const diff = currentAsset.startPrice ? (((livePrice - currentAsset.startPrice)/currentAsset.startPrice)*100) : 0;
        const chgEl = document.getElementById('tickerChange');
        chgEl.textContent = `${diff >= 0 ? '+' : ''}${diff.toFixed(2)}%`;
        chgEl.className = `stat-val ${diff >= 0 ? 'price-up' : 'price-down'}`;
        
        document.getElementById('tickerVol').textContent = formatCompact(currentAsset.volume || 0);

        clearInterval(chartInterval);
        fetchAndDrawChart();
        chartInterval = setInterval(fetchAndDrawChart, 3000); // Fast poll for terminal
        updateCalculations();
    }

    // --- Leveraged Calculations ---
    function updateLevSlider(val) {
        document.getElementById('levValText').innerText = val + 'x';
        document.getElementById('levSlider').value = val;
        // Calculate fill percentage (min is 1, max is 150)
        const pct = ((val - 1) / (150 - 1)) * 100;
        document.getElementById('levProgress').style.width = pct + '%';
        updateCalculations();
    }
    function setLev(val) { updateLevSlider(val); }

    function updateCalculations() {
        const amt = Number(document.getElementById('tradeAmt').value || 0);
        const lev = Number(document.getElementById('levSlider').value);
        const posSize = amt * lev;
        
        document.getElementById('detPosSize').textContent = `${fmt(posSize)} USDT`;
        document.getElementById('detFee').textContent = `${fmt(posSize * 0.0004)} USDT`; // 0.04% maker fee example

        if (livePrice > 0 && amt > 0) {
            // Simplified Liquidation Formula: Entry * (1 ± (1/Leverage))
            const mmr = 0.005; // 0.5% Maintenance margin
            const liqLong = livePrice * (1 - (1/lev) + mmr);
            const liqShort = livePrice * (1 + (1/lev) - mmr);
            
            document.getElementById('detLiqLong').textContent = money(Math.max(0, liqLong));
            document.getElementById('detLiqShort').textContent = money(Math.max(0, liqShort));
        } else {
            document.getElementById('detLiqLong').textContent = '-';
            document.getElementById('detLiqShort').textContent = '-';
        }
    }

    function executeTrade(side) {
        const amt = Number(document.getElementById('tradeAmt').value || 0);
        if (amt <= 0) return alert('Enter a valid amount');
        const lev = Number(document.getElementById('levSlider').value);
        alert(`Request Sent: ${side.toUpperCase()} ${currentAsset.symbol} | Size: ${fmt(amt*lev)} USDT @ ${lev}x Leverage`);
        // Here you would post to /api/trading/execute
        document.getElementById('tradeAmt').value = '';
        updateCalculations();
    }

    // --- Charting Engine (Lightweight Charts) ---
    function initChart() {
        const container = document.getElementById('chartContainer');
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const textColor = isDark ? '#94a3b8' : '#64748b';
        const gridColor = isDark ? 'rgba(56,189,248,0.05)' : 'rgba(2,132,199,0.08)';

        tvChart = LightweightCharts.createChart(container, {
            layout: { background: { type: 'solid', color: 'transparent' }, textColor: textColor },
            grid: { vertLines: { color: gridColor }, horzLines: { color: gridColor } },
            rightPriceScale: { borderVisible: false, scaleMargins: { top: 0.1, bottom: 0.1 } },
            timeScale: { 
                borderVisible: false, 
                timeVisible: true, 
                secondsVisible: false, 
                fixLeftEdge: true,
                tickMarkFormatter: (time) => {
                    const date = new Date(time * 1000);
                    return date.toLocaleTimeString(navigator.language, { hour: '2-digit', minute: '2-digit' });
                }
            },
            crosshair: { mode: 0, vertLine: { color: '#8b5cf6', labelBackgroundColor: '#8b5cf6' }, horzLine: { color: '#8b5cf6', labelBackgroundColor: '#8b5cf6' } }
        });
        
        candleSeries = tvChart.addCandlestickSeries({ upColor: '#10b981', downColor: '#e11d48', borderVisible: false, wickUpColor: '#10b981', wickDownColor: '#e11d48' });
        lineSeries = tvChart.addLineSeries({ color: '#a78bfa', lineWidth: 2, crosshairMarkerVisible: true, lastValueVisible: true });
        lineSeries.applyOptions({ visible: false });
        
        new ResizeObserver(entries => {
            if (entries.length === 0 || entries[0].target !== container) return;
            const newRect = entries[0].contentRect;
            tvChart.applyOptions({ height: newRect.height, width: newRect.width });
        }).observe(container);
    }

    function setTF(minutes, btn) {
        currentTF = minutes;
        document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        fetchAndDrawChart(); // Re-fetch immediately
    }

    function setType(type, btn) {
        currentChartType = type;
        document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (type === 'candle') { candleSeries.applyOptions({visible:true}); lineSeries.applyOptions({visible:false}); } 
        else { candleSeries.applyOptions({visible:false}); lineSeries.applyOptions({visible:true}); }
    }

    async function fetchAndDrawChart() {
      if (!currentAsset) return;
      try {
        const response = await fetch(`/api/tensor/chart?tokenId=${currentAsset.id}&_t=${Date.now()}`);
        const data = await response.json();
        if (data && data.candles) processAndRenderChartData(data.candles);
      } catch (e) { }
    }

    function processAndRenderChartData(raw) {
        if(!raw || raw.length === 0 || !tvChart) return;
        
        let aggregated = [];
        let currentBucket = null;
        let msInterval = currentTF * 60 * 1000;

        raw.forEach(c => {
            const bucketTime = Math.floor(c.time / msInterval) * msInterval;
            if (!currentBucket || currentBucket.originalTime !== bucketTime) {
                if (currentBucket) aggregated.push(currentBucket);
                currentBucket = { time: Math.floor(bucketTime / 1000), originalTime: bucketTime, open: c.open, high: c.high, low: c.low, close: c.close, value: c.close };
            } else {
                currentBucket.high = Math.max(currentBucket.high, c.high);
                currentBucket.low = Math.min(currentBucket.low, c.low);
                currentBucket.close = c.close;
                currentBucket.value = c.close;
            }
        });
        if(currentBucket) aggregated.push(currentBucket);

        const unique = Array.from(new Map(aggregated.map(item => [item.time, item])).values());
        candleSeries.setData(unique);
        lineSeries.setData(unique);
    }

    // --- UI Helpers ---
    function toggleTheme() {
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('blue_theme', newTheme);
        currentTheme = newTheme;
        location.reload(); // Quickest way to force chart re-render with new colors
    }

    function switchTab(tab, btn) {
        document.querySelectorAll('.pos-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tabPositions').style.display = tab === 'positions' ? 'block' : 'none';
        document.getElementById('tabHistory').style.display = tab === 'history' ? 'block' : 'none';
    }

    // --- Formatters ---
    function money(val) { return `$${Number(val||0).toLocaleString(undefined,{minimumFractionDigits:4,maximumFractionDigits:4})}`; }
    function fmt(val, dec=2) { return Number(val||0).toLocaleString(undefined,{minimumFractionDigits:dec,maximumFractionDigits:dec}); }
    function formatCompact(num) { return new Intl.NumberFormat('en-US',{notation:'compact', compactDisplay:'short'}).format(num); }

    // --- Mock Data Renderers ---
    function renderPositions() {
        // Example Active Position
        const tbody = document.getElementById('positionsBody');
        tbody.innerHTML = `
            <tr>
                <td><strong style="color:var(--text);">NRL</strong><div style="font-size:0.7rem; color:var(--tensor); font-weight:800;">50x</div></td>
