            </tr>
            <tr>
                <td style="color:var(--muted);">${new Date(Date.now() - 86400000).toLocaleTimeString()}</td>
                <td><strong style="color:var(--text);">SYN</strong></td>
                <td class="side-long">LONG</td>
                <td>$0.4510</td>
                <td>1,000.00</td>
                <td class="pnl-neg">- $450.00</td>
                <td class="price-down">Liquidated</td>
            </tr>
        `;
    }

    window.onload = initTerminal;
  </script>
