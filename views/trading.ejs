          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Actively Copying
        </h3>
        <p style="font-size:0.9rem; color:var(--text-muted); margin-bottom:6px;">Allocation: <span id="activeCopyAllocation" style="font-weight:900; color:var(--text-main);"></span></p>
        <p style="font-size:0.9rem; color:var(--text-muted); margin-bottom:16px;">Active Trades: <span id="activeCopyTradesCount" style="font-weight:900; color:var(--text-main);">0</span></p>
        <button class="btn-short" style="width:100%; height:40px; font-size:0.9rem;" onclick="stopCopying()">Stop Copying</button>
      </div>

      <h3 style="font-size:1.05rem; color:var(--text-muted); margin-bottom:16px; border-bottom:1px solid var(--border); padding-bottom:10px;">Available Traders</h3>
      <div id="copyProfilesList">
        <div style="text-align:center; padding:30px; color:var(--text-muted); font-size:0.85rem;">Loading profiles...</div>
