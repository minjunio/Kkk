  <script>
    let currentTheme = localStorage.getItem('blue_theme') || 'dark';
    let isPaper = false;
    let marginMode = 'cross';
    let tensorAssets = [];
    let activeToken = null;
    let prevPrices = {};

    let lastDisplayedPrice = 0;
    let lastServerPrice = 0;
    let localVisualPrice = 0;
    let visualTrendPower = 0;
    let latestFormattedChartData = [];
    let currentTF = 60;

    let liveState = {
      usdtBalance: SERVER_WALLET && SERVER_WALLET.usdtBalance !== undefined ? Number(SERVER_WALLET.usdtBalance) : 0,
      positions: SERVER_WALLET && SERVER_WALLET.positions ? SERVER_WALLET.positions : [],
      orderHistory: SERVER_WALLET && SERVER_WALLET.orderHistory ? SERVER_WALLET.orderHistory : []
    };

    let paperState = {
      usdtBalance: Number(localStorage.getItem('paper_balance')) || 5000,
      positions: JSON.parse(localStorage.getItem('paper_positions') || '[]'),
      orderHistory: JSON.parse(localStorage.getItem('paper_history') || '[]')
    };

    let chartInstance = null;
    let currentChartStyle = 'candlestick';
    let rawChartData = [];
    let priceInterval = null;
    let hasInitialZoomed = false;

    function formatPriceSmart(price) {
      price = Number(price) || 0;
      if (price >= 1000) {
        return price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
      if (price >= 1) {
        return price.toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      }
      return price.toLocaleString(undefined, { minimumFractionDigits: 6, maximumFractionDigits: 6 });
    }

    function formatMoney(num) {
      const n = Number(num) || 0;
      return `$${n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function formatDate(ts) {
      if (!ts) return '-';
      const d = new Date(ts);
      if (Number.isNaN(d.getTime())) return '-';
      return d.toLocaleString();
    }

    function toggleTheme() {
      currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', currentTheme);
      localStorage.setItem('blue_theme', currentTheme);
      updateChartTheme();
    }

    function setTradingMode(mode) {
      isPaper = mode === 'paper';
      document.getElementById('modeLive').className = isPaper ? '' : 'active';
      document.getElementById('modePaper').className = isPaper ? 'active' : '';
      document.getElementById('addFundsBtn').style.display = isPaper ? 'block' : 'none';
      renderBalancesAndPositions();
    }

    function setMarginMode(mode) {
      marginMode = mode;
      document.getElementById('modeCross').className = mode === 'cross' ? 'active' : '';
      document.getElementById('modeIsolated').className = mode === 'isolated' ? 'active' : '';
      updateMetrics();
    }

    function addPaperFunds() {
      const amt = Number(prompt('Add Paper USDT', '1000'));
      if (amt > 0) {
        paperState.usdtBalance += amt;
        savePaperState();
        renderBalancesAndPositions();
      }
    }

    function savePaperState() {
      localStorage.setItem('paper_balance', paperState.usdtBalance);
      localStorage.setItem('paper_positions', JSON.stringify(paperState.positions));
      localStorage.setItem('paper_history', JSON.stringify(paperState.orderHistory));
    }

    function setGraphMood(isUp) {
      const chartWrap = document.getElementById('chartWrap');
      if (!chartWrap) return;

      chartWrap.classList.remove('pump', 'dump');
      void chartWrap.offsetWidth;
      chartWrap.classList.add(isUp ? 'pump' : 'dump');

      setTimeout(() => {
        chartWrap.classList.remove('pump', 'dump');
      }, 420);
    }

    function getLifetimeHigh(currentPrice = 0) {
      let highest = Number(currentPrice) || 0;

      if (activeToken) {
        highest = Math.max(
          highest,
          Number(activeToken.lifetimeHigh || 0),
          Number(activeToken.allTimeHigh || 0),
          Number(activeToken.highestPrice || 0),
          Number(activeToken.high24h || 0)
        );
      }

      if (rawChartData && rawChartData.length) {
        rawChartData.forEach(c => {
          highest = Math.max(
            highest,
            Number(c.high || 0),
            Number(c.close || 0),
            Number(c.open || 0)
          );
        });
      }

      return highest;
    }

    function updateLivePriceUI(price, previousPrice) {
      if (!activeToken) return;

      const p = Number(price) || 0;
      const prev = Number(previousPrice) || p;
      const isUp = p >= prev;

      const sessionOpen = Number(activeToken.startPrice || prev || p);
      const movePct = sessionOpen > 0 ? ((p - sessionOpen) / sessionOpen) * 100 : 0;

      const colorClass = isUp ? 'text-green' : 'text-red';
      const sessionColorClass = movePct >= 0 ? 'text-green' : 'text-red';
      const sign = movePct >= 0 ? '+' : '';

      const chartSub = document.getElementById('chartSub');
      const livePriceMove = document.getElementById('livePriceMove');
      const liveMarkMini = document.getElementById('liveMarkMini');
      const high24hVal = document.getElementById('high24hVal');
      const low24hVal = document.getElementById('low24hVal');
      const lifetimeHighVal = document.getElementById('lifetimeHighVal');

      if (chartSub) {
        chartSub.innerText = `$${formatPriceSmart(p)}`;
        chartSub.className = `chart-price ${colorClass}`;
      }

      if (liveMarkMini) {
        liveMarkMini.innerText = `$${formatPriceSmart(p)}`;
        liveMarkMini.className = `chart-stat-value chart-live-mark ${colorClass}`;
      }

      if (livePriceMove) {
        livePriceMove.innerText = `${sign}${movePct.toFixed(2)}%`;
        livePriceMove.className = `chart-stat-value ${sessionColorClass}`;
      }

      if (high24hVal) {
        const h24 = Number(activeToken.high24h || activeToken.high24 || p);
        high24hVal.innerText = `$${formatPriceSmart(h24)}`;
      }

      if (low24hVal) {
        const l24 = Number(activeToken.low24h || activeToken.low24 || p);
        low24hVal.innerText = `$${formatPriceSmart(l24)}`;
      }

      if (lifetimeHighVal) {
        const lifetimeHigh = getLifetimeHigh(p);
        lifetimeHighVal.innerText = `$${formatPriceSmart(lifetimeHigh)}`;
      }

      const stripPrice = document.getElementById(`price-${activeToken.id}`);
      if (stripPrice) {
        stripPrice.innerText = `$${formatPriceSmart(p)}`;
        stripPrice.style.color = isUp ? 'var(--green)' : 'var(--red)';
      }

      if (Math.abs(p - prev) / Math.max(prev, 1) > 0.00001) {
        setGraphMood(isUp);
      }
    }

    function updateChartPriceLabel(price, previousPrice) {
      if (!chartInstance || !activeToken) return;

      const p = Number(price) || 0;
      const prev = Number(previousPrice) || p;
      const isUp = p >= prev;
      const labelColor = isUp ? '#0ecb81' : '#f6465d';

      chartInstance.clearAnnotations();

      chartInstance.addYaxisAnnotation({
        y: p,
        borderColor: labelColor,
        strokeDashArray: 0,
        label: {
          borderColor: labelColor,
          position: 'right',
          offsetX: 0,
          offsetY: 0,
          text: `${activeToken.symbol} $${formatPriceSmart(p)}`,
          style: {
            color: '#fff',
            background: labelColor,
            fontSize: '12px',
            fontWeight: 900,
            padding: { left: 7, right: 7, top: 4, bottom: 4 }
          }
        }
      }, false);
    }

    function makeDramaticVisualPrice(serverPrice) {
      const truePrice = Number(serverPrice) || 0;
      if (!truePrice) return 0;

      if (!localVisualPrice) {
        localVisualPrice = truePrice;
        lastServerPrice = truePrice;
        return truePrice;
      }

      const realMove = lastServerPrice > 0 ? (truePrice - lastServerPrice) / lastServerPrice : 0;

      visualTrendPower = visualTrendPower * 0.68 + realMove * 18;

      const dramaticNoise = (Math.random() - 0.5) * 0.0009;
      const dramaticMove = visualTrendPower + dramaticNoise;

      localVisualPrice = localVisualPrice + (truePrice - localVisualPrice) * 0.35;
      localVisualPrice = localVisualPrice * (1 + dramaticMove);

      const maxDistance = truePrice * 0.006;
      if (Math.abs(localVisualPrice - truePrice) > maxDistance) {
        localVisualPrice = truePrice + Math.sign(localVisualPrice - truePrice) * maxDistance;
      }

      lastServerPrice = truePrice;
      return Math.max(0.000001, localVisualPrice);
    }

    async function fetchCoreData() {
      try {
        const tokenRes = await fetch(`/api/tensor?_t=${Date.now()}`);
        if (tokenRes.ok) {
          const data = await tokenRes.json();
          const newAssets = data.registry || [];
          tensorAssets = newAssets;

          if (activeToken) {
            const updatedActive = tensorAssets.find(t => t.id === activeToken.id);
            if (updatedActive) {
              const oldPrice = Number(activeToken.price) || 0;
              activeToken = updatedActive;

              if (!localVisualPrice) localVisualPrice = activeToken.price;

              updateLivePriceUI(activeToken.price, oldPrice || activeToken.price);
              updateChartPriceLabel(activeToken.price, oldPrice || activeToken.price);
            }
          }

          renderAssetStrip();

          if (!activeToken && tensorAssets.length > 0) {
            selectAsset(tensorAssets[0].id);
          }
        }

        const stateRes = await fetch(`/api/trading/state?_t=${Date.now()}`);
        if (stateRes.ok) {
          liveState = await stateRes.json();
          renderBalancesAndPositions();
        }
      } catch (e) {
        console.error('fetchCoreData error:', e);
      }
    }

    async function loadChartDataForActive() {
      if (!activeToken) return;
      try {
        const res = await fetch(`/api/tensor/chart?tokenId=${activeToken.id}&_t=${Date.now()}`);
        const data = await res.json();
        rawChartData = data.candles || [];
        renderChart();
      } catch (e) {
        console.error('loadChartDataForActive error:', e);
      }
    }

    function startLiveTicker() {
      if (priceInterval) clearInterval(priceInterval);

      priceInterval = setInterval(() => {
        if (!activeToken || !chartInstance || !rawChartData.length) return;

        const serverPrice = Number(activeToken.price) || 0;
        const previousPrice = lastDisplayedPrice || serverPrice;
        const visualPrice = makeDramaticVisualPrice(serverPrice);

        updateLivePriceUI(visualPrice, previousPrice);

        const lastCandle = rawChartData[rawChartData.length - 1];
        const tempCandle = {
          ...lastCandle,
          close: visualPrice,
          high: Math.max(lastCandle.high, visualPrice),
          low: Math.min(lastCandle.low, visualPrice)
        };

        renderChart(tempCandle);
        updateChartPriceLabel(visualPrice, previousPrice);
        renderActivePositionsOnly(visualPrice);

        lastDisplayedPrice = visualPrice;
      }, 350);
    }

    function initApexChart() {
      const isDark = currentTheme === 'dark';
      const textCol = '#848E9C';
      const gridCol = isDark ? '#2b3139' : '#eaecef';

      const options = {
        series: [{ data: [] }],
        chart: {
          type: currentChartStyle,
          height: '100%',
          background: 'transparent',
          animations: {
            enabled: true,
            easing: 'easeout',
            speed: 180,
            dynamicAnimation: { enabled: true, speed: 180 }
          },
          toolbar: {
            show: false
          },
          zoom: {
            enabled: true,
            type: 'x',
            autoScaleYaxis: true
          },
          selection: {
            enabled: false
          },
          fontFamily: 'Inter, sans-serif',
          events: {
            mounted: function(chartContext) {
              chartContext.el.addEventListener('wheel', function(e) {
                if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
                e.preventDefault();

                const minX = chartContext.w.globals.minX;
                const maxX = chartContext.w.globals.maxX;

                if (minX === undefined || maxX === undefined || !latestFormattedChartData.length) return;

                const range = maxX - minX;
                const shift = range * 0.12 * (e.deltaY > 0 ? 1 : -1);
                chartContext.zoomX(minX + shift, maxX + shift);
              }, { passive: false });
            }
          }
        },
        theme: {
          mode: isDark ? 'dark' : 'light'
        },
        plotOptions: {
          candlestick: {
            colors: {
              upward: '#0ecb81',
              downward: '#f6465d'
            },
            wick: { useFillColor: true }
          }
        },
        stroke: {
          curve: 'straight',
          width: 2,
          colors: ['#8b5cf6']
        },
        xaxis: {
          type: 'datetime',
          labels: {
            style: { colors: textCol },
            datetimeFormatter: { hour: 'HH:mm', day: 'dd MMM', month: 'MMM yy' },
            datetimeUTC: false
          },
          axisBorder: { show: false },
          axisTicks: { show: false },
          tooltip: {
            enabled: true,
            formatter: val => new Date(val).toLocaleString()
          },
          crosshairs: {
            show: true,
            position: 'back',
            stroke: { color: '#8b5cf6', width: 1, dashArray: 3 }
          }
        },
        yaxis: {
          opposite: true,
          labels: {
            style: { colors: textCol },
            formatter: v => formatPriceSmart(v)
          },
          tooltip: { enabled: true },
          crosshairs: {
            show: true,
            stroke: { color: '#8b5cf6', width: 1, dashArray: 3 }
          }
        },
        tooltip: {
          enabled: true,
          theme: isDark ? 'dark' : 'light',
          x: { format: 'dd MMM yyyy HH:mm' }
        },
        grid: {
          borderColor: gridCol,
          strokeDashArray: 0,
          padding: { top: 44, right: 0, bottom: 0, left: 10 }
        }
      };

      chartInstance = new ApexCharts(document.querySelector('#apexChartContainer'), options);
      chartInstance.render();
    }

    function updateChartTheme() {
      if (!chartInstance) return;
      const isDark = currentTheme === 'dark';

      chartInstance.updateOptions({
        theme: { mode: isDark ? 'dark' : 'light' },
        xaxis: { labels: { style: { colors: '#848E9C' } } },
        yaxis: { labels: { style: { colors: '#848E9C' } } },
        tooltip: { theme: isDark ? 'dark' : 'light' },
        grid: { borderColor: isDark ? '#2b3139' : '#eaecef' }
      });
    }

    function setChartStyle(style) {
      currentChartStyle = style;
      document.getElementById('btnStyleCandle').className = style === 'candlestick' ? 'active' : '';
      document.getElementById('btnStyleLine').className = style === 'line' ? 'active' : '';

      if (chartInstance) {
        chartInstance.updateOptions({ chart: { type: style } });
        renderChart();
      }
    }

    function renderChart(visualLastCandle = null) {
      if (!chartInstance || !rawChartData.length) return;

      const dataToProcess = [...rawChartData];
      if (visualLastCandle) {
        dataToProcess[dataToProcess.length - 1] = visualLastCandle;
      }

      let aggregated = [];
      let currentBucket = null;
      let msInterval = currentTF * 60 * 1000;

      dataToProcess.forEach(c => {
        const bucketTime = Math.floor(c.time / msInterval) * msInterval;

        if (!currentBucket || currentBucket.originalTime !== bucketTime) {
          if (currentBucket) aggregated.push(currentBucket);

          currentBucket = {
            time: bucketTime,
            originalTime: bucketTime,
            open: c.open,
            high: c.high,
            low: c.low,
            close: c.close
          };
        } else {
          currentBucket.high = Math.max(currentBucket.high, c.high);
          currentBucket.low = Math.min(currentBucket.low, c.low);
          currentBucket.close = c.close;
        }
      });

      if (currentBucket) aggregated.push(currentBucket);

      const formattedData = aggregated.map(b => {
        if (currentChartStyle === 'candlestick') {
          return { x: b.time, y: [b.open, b.high, b.low, b.close] };
        }
        return { x: b.time, y: b.close };
      });

      latestFormattedChartData = formattedData;
      chartInstance.updateSeries([{ data: formattedData }], false);

      const latest = aggregated[aggregated.length - 1];
      if (latest) {
        const prev = lastDisplayedPrice || latest.open;
        updateChartPriceLabel(latest.close, prev);
      }

      if (!hasInitialZoomed && formattedData.length > 20) {
        const minX = formattedData[Math.max(0, formattedData.length - 80)].x;
        const maxX = formattedData[formattedData.length - 1].x;
        chartInstance.zoomX(minX, maxX);
        hasInitialZoomed = true;
      }
    }

    function renderAssetStrip() {
      const strip = document.getElementById('assetStrip');

      strip.innerHTML = tensorAssets.map(t => {
        const startPrice = t.startPrice || t.price;
        const chg = startPrice > 0 ? ((t.price - startPrice) / startPrice) * 100 : 0;
        const colClass = chg >= 0 ? 'text-green' : 'text-red';

        return `
          <div class="market-card ${activeToken?.id === t.id ? 'active' : ''}" id="strip-${t.id}" onclick="selectAsset('${t.id}')">
            <div style="display:flex; justify-content:space-between;">
              <span style="font-weight:800; font-size:0.85rem; color:var(--text-main);">${t.symbol}</span>
              <span class="${colClass}" style="font-size:0.75rem; font-weight:800;">${chg >= 0 ? '+' : ''}${chg.toFixed(2)}%</span>
            </div>
            <div style="font-weight:900; font-size:1.1rem; margin-top: 4px; color:var(--text-main);" id="price-${t.id}">
              $${formatPriceSmart(t.price)}
            </div>
          </div>
        `;
      }).join('');
    }

    function selectAsset(id) {
      hasInitialZoomed = false;
      activeToken = tensorAssets.find(x => x.id === id);
      if (!activeToken) return;

      lastDisplayedPrice = activeToken.price;
      lastServerPrice = activeToken.price;
      localVisualPrice = activeToken.price;
      visualTrendPower = 0;

      document.querySelectorAll('.market-card').forEach(c => c.classList.remove('active'));
      const selectedCard = document.getElementById(`strip-${id}`);
      if (selectedCard) selectedCard.classList.add('active');

      document.getElementById('chartTitle').innerHTML = `
        ${activeToken.symbol}
        <span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">/USDT</span>
      `;

      updateLivePriceUI(activeToken.price, activeToken.price);
      updateMetrics();
      loadChartDataForActive();
      startLiveTicker();
    }

    function getLiqPrice(entry, sizeUsd, marginUsd, side, mode, availBal) {
      if (sizeUsd <= 0 || marginUsd <= 0) return 0;

      if (mode === 'isolated') {
        const drop = (marginUsd / sizeUsd) * entry;
        return side === 'long' ? entry - drop : entry + drop;
      }

      const drop = ((marginUsd + availBal) / sizeUsd) * entry;
      return Math.max(0, side === 'long' ? entry - drop : entry + drop);
    }

    function updateLeverage(val) {
      document.getElementById('levSlider').value = val;
      document.getElementById('levValDisplay').innerText = val;
      updateMetrics();
    }

    function updateMetrics() {
      const margin = Number(document.getElementById('tradeAmt').value) || 0;
      const lev = Number(document.getElementById('levSlider').value) || 1;
      const price = activeToken ? activeToken.price : 1;
      const state = isPaper ? paperState : liveState;

      const posSize = margin * lev;
      document.getElementById('posSize').innerText = `${posSize.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} USDT`;

      if (margin > 0 && price > 0) {
        const liqL = getLiqPrice(price, posSize, margin, 'long', marginMode, state.usdtBalance);
        const liqS = getLiqPrice(price, posSize, margin, 'short', marginMode, state.usdtBalance);

        document.getElementById('liqLong').innerText = liqL > 0 ? `${formatPriceSmart(liqL)}` : '--';
        document.getElementById('liqShort').innerText = liqS > 0 ? `${formatPriceSmart(liqS)}` : '--';
      } else {
        document.getElementById('liqLong').innerText = '0.00';
        document.getElementById('liqShort').innerText = '0.00';
      }
    }

    function getCurrentState() {
      return isPaper ? paperState : liveState;
    }

    function renderBalancesAndPositions() {
      const state = getCurrentState();

      document.getElementById('availUsdt').innerText = state.usdtBalance.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });

      renderActivePositionsOnly();

      const hView = document.getElementById('historyPosView');

      if (state.orderHistory.length === 0) {
        hView.innerHTML = `
          <div style="text-align:center; padding: 20px; color:var(--text-muted); font-size:0.8rem; font-weight:700;">
            No history.
          </div>
        `;
      } else {
        hView.innerHTML = state.orderHistory.slice(0, 15).map((p, idx) => {
          const pnlNum = Number(p.pnl || 0);
          const roiNum = Number(p.margin || 0) > 0 ? (pnlNum / Number(p.margin || 1)) * 100 : 0;
          const col = pnlNum >= 0 ? 'text-green' : 'text-red';
          const sign = pnlNum >= 0 ? '+' : '';

          return `
            <div class="pos-card">
              <div class="pos-header" style="margin-bottom:8px;">
                <div>
                  <span style="font-weight:900;">${p.symbol}</span>
                  <span class="type-badge ${p.side}">${p.side} ${p.leverage}x</span>
                </div>
                <div class="${col}" style="font-weight:900;">${sign}$${pnlNum.toFixed(2)}</div>
              </div>

              <div class="pos-grid">
                <div class="pos-item"><span class="pos-label">ROI</span><span class="pos-val ${roiNum >= 0 ? 'text-green' : 'text-red'}">${roiNum >= 0 ? '+' : ''}${roiNum.toFixed(2)}%</span></div>
                <div class="pos-item"><span class="pos-label">Margin</span><span class="pos-val">$${Number(p.margin || 0).toFixed(2)}</span></div>
                <div class="pos-item"><span class="pos-label">Entry</span><span class="pos-val">$${formatPriceSmart(p.entryPrice || 0)}</span></div>
                <div class="pos-item"><span class="pos-label">Exit</span><span class="pos-val">$${formatPriceSmart(p.closePrice || 0)}</span></div>
                <div class="pos-item"><span class="pos-label">Mode</span><span class="pos-val">${(p.marginMode || 'Cross')}</span></div>
                <div class="pos-item"><span class="pos-label">Closed</span><span class="pos-val">${formatDate(p.closedAt)}</span></div>
              </div>

              <div style="font-size:0.7rem; color:var(--text-muted); margin-top:10px;">
                Closed via ${p.closeReason || 'Market'} @ $${formatPriceSmart(p.closePrice || 0)}
              </div>

              <div class="history-actions">
                <button class="history-btn" onclick="downloadTradeImage(${idx})">Download Image</button>
                <button class="history-btn secondary" onclick="generateTradeLink(${idx})">Verified Link</button>
              </div>

              <div class="share-status" id="shareStatus-${idx}"></div>
            </div>
          `;
        }).join('');
      }

      updateMetrics();
    }

    function renderActivePositionsOnly(overrideVisualPrice = null) {
      const state = getCurrentState();
      document.getElementById('posCount').innerText = state.positions.length;
      const container = document.getElementById('activePosView');

      if (state.positions.length === 0) {
        container.innerHTML = `
          <div style="text-align:center; padding: 20px; color:var(--text-muted); font-size:0.8rem; font-weight:700;">
            No open positions.
          </div>
        `;
        return;
      }

      container.innerHTML = state.positions.map(p => {
        const token = tensorAssets.find(t => t.id === p.tokenId);
        const currentPrice = (overrideVisualPrice && token && activeToken && token.id === activeToken.id)
          ? overrideVisualPrice
          : (token ? token.price : p.entryPrice);

        const pnlRaw = p.side === 'long' ? (currentPrice - p.entryPrice) : (p.entryPrice - currentPrice);
        const pnl = (pnlRaw / p.entryPrice) * p.size;
        const roi = (pnl / p.margin) * 100;
        const liq = getLiqPrice(p.entryPrice, p.size, p.margin, p.side, p.marginMode || 'cross', state.usdtBalance);

        const col = pnl >= 0 ? 'text-green' : 'text-red';
        const sign = pnl >= 0 ? '+' : '';

        return `
          <div class="pos-card">
            <div class="pos-header">
              <div>
                <span style="font-weight:900; font-size:1.1rem; color:var(--text-main);">${p.symbol}</span>
                <span class="type-badge ${p.side}">${p.side} ${p.leverage}x</span>
              </div>

              <div style="text-align:right;">
                <div class="${col}" style="font-weight:900; font-size:1.1rem;">${sign}$${pnl.toFixed(2)}</div>
                <div class="${col}" style="font-size:0.8rem; font-weight:800;">${sign}${roi.toFixed(2)}% ROI</div>
              </div>
            </div>

            <div class="pos-grid">
              <div class="pos-item"><span class="pos-label">Size</span><span class="pos-val">$${p.size.toLocaleString(undefined, { maximumFractionDigits: 2 })}</span></div>
              <div class="pos-item"><span class="pos-label">Margin</span><span class="pos-val">$${p.margin.toLocaleString(undefined, { maximumFractionDigits: 2 })}</span></div>
              <div class="pos-item"><span class="pos-label">Entry Price</span><span class="pos-val">$${formatPriceSmart(p.entryPrice)}</span></div>
              <div class="pos-item"><span class="pos-label">Mark Price</span><span class="pos-val">$${formatPriceSmart(currentPrice)}</span></div>
              <div class="pos-item"><span class="pos-label">Liq. Price</span><span class="pos-val" style="color:#f59e0b;">$${formatPriceSmart(Math.max(0, liq))}</span></div>
              <div class="pos-item"><span class="pos-label">Mode</span><span class="pos-val" style="text-transform:capitalize;">${p.marginMode || 'Cross'}</span></div>
            </div>

            <button class="close-btn" onclick="closePosition('${p.id}')">Close Position</button>
          </div>
        `;
      }).join('');
    }

    function switchTab(tab, el) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      el.classList.add('active');
      document.getElementById('activePosView').style.display = tab === 'active' ? 'grid' : 'none';
      document.getElementById('historyPosView').style.display = tab === 'history' ? 'grid' : 'none';
    }

    async function executeTrade(side) {
      const margin = Number(document.getElementById('tradeAmt').value);
      const lev = Number(document.getElementById('levSlider').value);

      if (!margin || margin <= 0) return alert('Enter margin amount');
      if (!activeToken) return alert('No asset selected');

      if (isPaper) {
        if (margin > paperState.usdtBalance) return alert('Insufficient Paper USDT Balance');

        const posSize = margin * lev;
        paperState.usdtBalance -= margin;
        paperState.positions.push({
          id: Date.now().toString(),
          tokenId: activeToken.id,
          symbol: activeToken.symbol,
          side,
          margin,
          leverage: lev,
          size: posSize,
          entryPrice: activeToken.price,
          marginMode
        });

        savePaperState();
        document.getElementById('tradeAmt').value = '';
        renderBalancesAndPositions();
        switchTab('active', document.querySelector('.tab:first-child'));
      } else {
        try {
          const res = await fetch('/api/trading/execute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tokenId: activeToken.id, side, margin, leverage: lev, marginMode })
          });

          const data = await res.json();
          if (res.ok) {
            liveState.usdtBalance = data.usdtBalance;
            liveState.positions.unshift(data.position);
            document.getElementById('tradeAmt').value = '';
            renderBalancesAndPositions();
            switchTab('active', document.querySelector('.tab:first-child'));
          } else {
            alert(data.error || 'Trade failed');
          }
        } catch (e) {
          alert('Network error');
        }
      }
    }

    async function closePosition(id) {
      if (isPaper) {
        const idx = paperState.positions.findIndex(p => String(p.id) === String(id));
        if (idx === -1) return;

        const pos = paperState.positions[idx];
        const token = tensorAssets.find(t => t.id === pos.tokenId);
        const currentPrice = token ? token.price : pos.entryPrice;
        const pnl = (pos.side === 'long' ? (currentPrice - pos.entryPrice) : (pos.entryPrice - currentPrice)) / pos.entryPrice * pos.size;

        paperState.usdtBalance += (pos.margin + pnl);
        paperState.positions.splice(idx, 1);
        paperState.orderHistory.unshift({
          ...pos,
          closePrice: currentPrice,
          pnl,
          closeReason: 'Market Close',
          closedAt: Date.now()
        });

        savePaperState();
        renderBalancesAndPositions();
      } else {
        try {
          const res = await fetch('/api/trading/close', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ positionId: id })
          });
          if (res.ok) {
            await fetchCoreData();
          } else {
            alert('Failed to close position.');
          }
        } catch (e) {
          console.error(e);
        }
      }
    }

    function checkPaperLiquidations() {
      if (!isPaper || paperState.positions.length === 0) return;

      let changed = false;

      paperState.positions = paperState.positions.filter(pos => {
        const token = tensorAssets.find(t => t.id === pos.tokenId);
        if (!token) return true;

        const liqPrice = getLiqPrice(pos.entryPrice, pos.size, pos.margin, pos.side, pos.marginMode || 'cross', paperState.usdtBalance);
        const isLiq = pos.side === 'long' ? token.price <= liqPrice : token.price >= liqPrice;

        if (isLiq) {
          paperState.orderHistory.unshift({
            ...pos,
            closePrice: token.price,
            pnl: -pos.margin,
            closeReason: 'LIQUIDATION',
            closedAt: Date.now()
          });
          changed = true;
          return false;
        }
        return true;
      });

      if (changed) {
        savePaperState();
        renderBalancesAndPositions();
      }
    }

    function getHistoryTradeByIndex(index) {
      const state = getCurrentState();
      return state.orderHistory[index] || null;
    }

    function buildTradeSnapshot(trade, shareUrl = '') {
      const pnl = Number(trade.pnl || 0);
      const margin = Number(trade.margin || 0);
      const roi = margin > 0 ? (pnl / margin) * 100 : 0;
      const mark = Number(trade.closePrice || trade.markPrice || trade.exitPrice || trade.entryPrice || 0);
      const symbol = trade.symbol || 'TENSOR';
      const lev = Number(trade.leverage || 1);
      const mode = trade.marginMode || 'Cross';

      return {
        symbol,
        side: trade.side || 'long',
        leverage: lev,
        margin,
        size: Number(trade.size || 0),
        entryPrice: Number(trade.entryPrice || 0),
        markPrice: mark,
        pnl,
        roi,
        mode,
        openedAt: trade.openedAt || trade.createdAt || null,
        closedAt: trade.closedAt || null,
        trader: CURRENT_EMAIL || 'Tensor User',
        shareUrl,
        closeReason: trade.closeReason || 'Market Close'
      };
    }

    function populateTradeExportCard(snapshot, shareUrl = '') {
      document.getElementById('exportSubtitle').innerText = `${snapshot.closeReason} • ${snapshot.symbol} snapshot`;
      document.getElementById('exportSymbol').innerText = `${snapshot.symbol} / USDT`;

      const sideEl = document.getElementById('exportSide');
      sideEl.innerText = `${snapshot.side.toUpperCase()} ${snapshot.leverage}x`;
      sideEl.className = `share-side ${snapshot.side === 'short' ? 'short' : 'long'}`;

      const pnlEl = document.getElementById('exportPnl');
      pnlEl.innerText = `${snapshot.pnl >= 0 ? '+' : ''}${formatMoney(snapshot.pnl)}`;
      pnlEl.style.color = snapshot.pnl >= 0 ? '#34d399' : '#fb7185';

      const roiEl = document.getElementById('exportRoi');
      roiEl.innerText = `${snapshot.roi >= 0 ? '+' : ''}${snapshot.roi.toFixed(2)}%`;
      roiEl.style.color = snapshot.roi >= 0 ? '#34d399' : '#fb7185';

      document.getElementById('exportEntry').innerText = `$${formatPriceSmart(snapshot.entryPrice)}`;
      document.getElementById('exportMark').innerText = `$${formatPriceSmart(snapshot.markPrice)}`;
      document.getElementById('exportMargin').innerText = formatMoney(snapshot.margin);
      document.getElementById('exportSize').innerText = formatMoney(snapshot.size);
      document.getElementById('exportLev').innerText = `${snapshot.leverage}x`;
      document.getElementById('exportMode').innerText = snapshot.mode;
      document.getElementById('exportOpened').innerText = formatDate(snapshot.openedAt);
      document.getElementById('exportClosed').innerText = formatDate(snapshot.closedAt);
      document.getElementById('exportTrader').innerText = snapshot.trader || 'Tensor User';
      document.getElementById('exportFooterLeft').innerText = `Generated by Tensor Wallet • ${new Date().toLocaleString()}`;
      document.getElementById('exportShareUrl').innerText = shareUrl || 'Private snapshot';
    }

    async function downloadTradeImage(index) {
      const trade = getHistoryTradeByIndex(index);
      if (!trade) return alert('Trade not found.');

      const snapshot = buildTradeSnapshot(trade);
      populateTradeExportCard(snapshot);

      const node = document.getElementById('tradeExportCard');
      const canvas = await html2canvas(node, {
        backgroundColor: null,
        scale: 2,
        useCORS: true
      });

      const link = document.createElement('a');
      link.download = `tensor-trade-${snapshot.symbol}-${Date.now()}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();

      const statusEl = document.getElementById(`shareStatus-${index}`);
      if (statusEl) statusEl.innerText = 'Image downloaded successfully.';
    }

    async function generateTradeLink(index) {
      const trade = getHistoryTradeByIndex(index);
      if (!trade) return alert('Trade not found.');

      const statusEl = document.getElementById(`shareStatus-${index}`);
      if (statusEl) statusEl.innerText = 'Generating verified link...';

      try {
        const snapshot = buildTradeSnapshot(trade);

        const res = await fetch('/api/trade-share/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ snapshot })
        });

        const data = await res.json();

        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'Failed to generate verified link.');
        }

        populateTradeExportCard(snapshot, data.url);

        if (navigator.clipboard && data.url) {
          try {
            await navigator.clipboard.writeText(data.url);
          } catch (_) {}
        }

        if (statusEl) {
          statusEl.innerText = `Verified link created: ${data.url}`;
        }

        alert(`Verified link created and copied if clipboard is allowed:\n\n${data.url}`);
      } catch (e) {
        if (statusEl) statusEl.innerText = `Error: ${e.message}`;
        alert(e.message || 'Could not create verified link.');
      }
    }

    window.onload = () => {
      document.documentElement.setAttribute('data-theme', currentTheme);
      initApexChart();

      document.getElementById('availUsdt').innerText = liveState.usdtBalance.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });

      fetchCoreData();

      setInterval(async () => {
        await fetchCoreData();
        checkPaperLiquidations();
      }, 1800);
    };
  </script>
</body>
</html>