    <button class="active" onclick="window.location.href='/trading'"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg>Trading</button>
  </nav>

  <div class="modal-overlay" id="copyModal">
    <div class="modal">
      <div class="modal-header">
        <h2>Copy Trading Hub</h2>
        <span class="modal-close" onclick="closeCopyHub()">&times;</span>
      </div>

      <div id="adminCopySection" style="display:none; margin-bottom: 24px; padding: 18px; border: 1px solid var(--tensor); border-radius: 8px; background: rgba(139,92,246,0.05);">
        <h3 style="margin-bottom:8px; font-size:1.15rem; color:var(--text-main);">Admin Master Profile</h3>
        <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:16px;">Status: <span id="adminCopyStatus" style="font-weight:900; color:var(--text-main);"></span></p>
        <button class="btn-tensor" style="width:100%;" onclick="toggleAdminCopyProfile()">Toggle Profile Status</button>
      </div>

      <div id="activeCopyingSection" style="display:none; margin-bottom: 24px; padding: 18px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-base);">
