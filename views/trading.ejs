          borderColor: isDark ? '#2b3139' : '#eaecef'
        }
      });
    }

    function setChartStyle(style) {
      currentChartStyle = style;

      document.getElementById('btnStyleCandle').className = style === 'candlestick' ? 'active' : '';
      document.getElementById('btnStyleLine').className = style === 'line' ? 'active' : '';

      if (chartInstance) {
        chartInstance.updateOptions({
          chart: { type: style }
        });

        renderChart();
      }
    }

    function setChartTF(minutes, btn) {
      currentTF = minutes;

      document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      hasInitialZoomed = false;
      renderChart();
    }

    function renderChart(visualLastCandle = null) {
      if (!chartInstance || !rawChartData.length) return;

      const dataToProcess = [...rawChartData];

      if (visualLastCandle) {
        dataToProcess[dataToProcess.length - 1] = visualLastCandle;
      }

      let aggregated = [];
      let currentBucket = null;
      let msInterval = currentTF * 60 * 1000;

      dataToProcess.forEach(c => {
        const bucketTime = Math.floor(c.time / msInterval) * msInterval;

        if (!currentBucket || currentBucket.originalTime !== bucketTime) {
          if (currentBucket) aggregated.push(currentBucket);

          currentBucket = {
            time: bucketTime,
            originalTime: bucketTime,
            open: c.open,
            high: c.high,
            low: c.low,
            close: c.close
          };
        } else {
          currentBucket.high = Math.max(currentBucket.high, c.high);
          currentBucket.low = Math.min(currentBucket.low, c.low);
          currentBucket.close = c.close;
        }
      });

      if (currentBucket) aggregated.push(currentBucket);

      const formattedData = aggregated.map(b => {
        if (currentChartStyle === 'candlestick') {
          return {
            x: b.time,
            y: [b.open, b.high, b.low, b.close]
          };
        }

        return {
          x: b.time,
          y: b.close
        };
      });

      latestFormattedChartData = formattedData;

      chartInstance.updateSeries([{ data: formattedData }], false);

      const latest = aggregated[aggregated.length - 1];

      if (latest) {
        const prev = lastDisplayedPrice || latest.open;
        updateChartPriceLabel(latest.close, prev);
      }

      if (!hasInitialZoomed && formattedData.length > 20) {
        const minX = formattedData[Math.max(0, formattedData.length - 60)].x;
        const maxX = formattedData[formattedData.length - 1].x;

        chartInstance.zoomX(minX, maxX);
        hasInitialZoomed = true;
      }
    }

    function renderAssetStrip() {
      const strip = document.getElementById('assetStrip');

      strip.innerHTML = tensorAssets.map(t => {
        const startPrice = t.startPrice || t.price;
        const chg = startPrice > 0 ? ((t.price - startPrice) / startPrice) * 100 : 0;
        const colClass = chg >= 0 ? 'text-green' : 'text-red';

        return `
          <div class="market-card ${activeToken?.id === t.id ? 'active' : ''}" id="strip-${t.id}" onclick="selectAsset('${t.id}')">
            <div style="display:flex; justify-content:space-between;">
              <span style="font-weight:800; font-size:0.85rem; color:var(--text-main);">${t.symbol}</span>
              <span class="${colClass}" style="font-size:0.75rem; font-weight:800;">${chg >= 0 ? '+' : ''}${chg.toFixed(2)}%</span>
            </div>
            <div style="font-weight:900; font-size:1.1rem; margin-top: 4px; color:var(--text-main);" id="price-${t.id}">
              $${formatPriceSmart(t.price)}
            </div>
          </div>
        `;
      }).join('');
    }

    function selectAsset(id) {
      hasInitialZoomed = false;

      activeToken = tensorAssets.find(x => x.id === id);
      if (!activeToken) return;

      lastDisplayedPrice = activeToken.price;
      lastServerPrice = activeToken.price;
      localVisualPrice = activeToken.price;
      visualTrendPower = 0;

      document.querySelectorAll('.market-card').forEach(c => c.classList.remove('active'));

      const selectedCard = document.getElementById(`strip-${id}`);
      if (selectedCard) selectedCard.classList.add('active');

      document.getElementById('chartTitle').innerHTML = `
        ${activeToken.symbol}
        <span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">/USDT</span>
      `;

      updateLivePriceUI(activeToken.price, activeToken.price);
      updateMetrics();
      loadChartDataForActive();
      startLiveTicker();
    }

    function getLiqPrice(entry, sizeUsd, marginUsd, side, mode, availBal) {
      if (sizeUsd <= 0 || marginUsd <= 0) return 0;

      if (mode === 'isolated') {
        const drop = (marginUsd / sizeUsd) * entry;
        return side === 'long' ? entry - drop : entry + drop;
      }

      const drop = ((marginUsd + availBal) / sizeUsd) * entry;
      return Math.max(0, side === 'long' ? entry - drop : entry + drop);
    }

    function updateLeverage(val) {
      document.getElementById('levSlider').value = val;
      document.getElementById('levValDisplay').innerText = val;
      updateMetrics();
    }

    function updateMetrics() {
      const margin = Number(document.getElementById('tradeAmt').value) || 0;
      const lev = Number(document.getElementById('levSlider').value) || 1;
      const price = activeToken ? activeToken.price : 1;
      const state = isPaper ? paperState : liveState;

      const posSize = margin * lev;

      document.getElementById('posSize').innerText = `${posSize.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      })} USDT`;

      if (margin > 0 && price > 0) {
        const liqL = getLiqPrice(price, posSize, margin, 'long', marginMode, state.usdtBalance);
        const liqS = getLiqPrice(price, posSize, margin, 'short', marginMode, state.usdtBalance);

        document.getElementById('liqLong').innerText = liqL > 0 ? `${formatPriceSmart(liqL)}` : '--';
        document.getElementById('liqShort').innerText = liqS > 0 ? `${formatPriceSmart(liqS)}` : '--';
      } else {
        document.getElementById('liqLong').innerText = '0.00';
        document.getElementById('liqShort').innerText = '0.00';
      }
    }

    function renderBalancesAndPositions() {
      const state = isPaper ? paperState : liveState;

      document.getElementById('availUsdt').innerText = state.usdtBalance.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });

      renderActivePositionsOnly();

      const hView = document.getElementById('historyPosView');

      if (state.orderHistory.length === 0) {
        hView.innerHTML = `
          <div style="text-align:center; padding: 20px; color:var(--text-muted); font-size:0.8rem; font-weight:700;">
            No history.
          </div>
        `;
      } else {
        hView.innerHTML = state.orderHistory.slice(0, 15).map(p => {
          const col = p.pnl >= 0 ? 'text-green' : 'text-red';
          const sign = p.pnl >= 0 ? '+' : '';

          return `
            <div class="pos-card">
              <div class="pos-header" style="border:none; margin:0; padding:0;">
                <div>
                  <span style="font-weight:900;">${p.symbol}</span>
                  <span class="type-badge ${p.side}">${p.side} ${p.leverage}x</span>
                </div>
                <div class="${col}" style="font-weight:900;">${sign}$${Number(p.pnl || 0).toFixed(2)}</div>
              </div>
              <div style="font-size:0.7rem; color:var(--text-muted); margin-top:4px;">
                Closed via ${p.closeReason || 'Market'} @ $${formatPriceSmart(p.closePrice || 0)}
              </div>
            </div>
          `;
        }).join('');
      }

      updateMetrics();
    }

    function renderActivePositionsOnly(overrideVisualPrice = null) {
      const state = isPaper ? paperState : liveState;

      document.getElementById('posCount').innerText = state.positions.length;

      const container = document.getElementById('activePosView');

      if (state.positions.length === 0) {
        container.innerHTML = `
          <div style="text-align:center; padding: 20px; color:var(--text-muted); font-size:0.8rem; font-weight:700;">
            No open positions.
          </div>
        `;
        return;
      }

      container.innerHTML = state.positions.map(p => {
        const token = tensorAssets.find(t => t.id === p.tokenId);
        const currentPrice = overrideVisualPrice && token && activeToken && token.id === activeToken.id
          ? overrideVisualPrice
          : token ? token.price : p.entryPrice;

        const pnlRaw = p.side === 'long'
          ? currentPrice - p.entryPrice
          : p.entryPrice - currentPrice;

        const pnl = (pnlRaw / p.entryPrice) * p.size;
        const roi = (pnl / p.margin) * 100;
        const liq = getLiqPrice(p.entryPrice, p.size, p.margin, p.side, p.marginMode || 'cross', state.usdtBalance);

        const col = pnl >= 0 ? 'text-green' : 'text-red';
        const sign = pnl >= 0 ? '+' : '';

        return `
          <div class="pos-card">
            <div class="pos-header">
              <div>
                <span style="font-weight:900; font-size:1.1rem; color:var(--text-main);">${p.symbol}</span>
                <span class="type-badge ${p.side}">${p.side} ${p.leverage}x</span>
              </div>

              <div style="text-align:right;">
                <div class="${col}" style="font-weight:900; font-size:1.1rem;">${sign}$${pnl.toFixed(2)}</div>
                <div class="${col}" style="font-size:0.8rem; font-weight:800;">${sign}${roi.toFixed(2)}% ROI</div>
              </div>
            </div>

            <div class="pos-grid">
              <div class="pos-item">
                <span class="pos-label">Size</span>
                <span class="pos-val">$${p.size.toLocaleString(undefined, { maximumFractionDigits: 2 })}</span>
              </div>

              <div class="pos-item">
                <span class="pos-label">Margin</span>
                <span class="pos-val">$${p.margin.toLocaleString(undefined, { maximumFractionDigits: 2 })}</span>
              </div>

              <div class="pos-item">
                <span class="pos-label">Entry Price</span>
                <span class="pos-val">$${formatPriceSmart(p.entryPrice)}</span>
              </div>

              <div class="pos-item">
                <span class="pos-label">Mark Price</span>
                <span class="pos-val">$${formatPriceSmart(currentPrice)}</span>
              </div>

              <div class="pos-item">
                <span class="pos-label">Liq. Price</span>
                <span class="pos-val" style="color:#f59e0b;">$${formatPriceSmart(Math.max(0, liq))}</span>
              </div>

              <div class="pos-item">
                <span class="pos-label">Mode</span>
                <span class="pos-val" style="text-transform:capitalize;">${p.marginMode || 'Cross'}</span>
              </div>
            </div>

            <button class="close-btn" onclick="closePosition('${p.id}')">Close Position</button>
          </div>
        `;
      }).join('');
    }

    function switchTab(tab, el) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      el.classList.add('active');

      document.getElementById('activePosView').style.display = tab === 'active' ? 'grid' : 'none';
      document.getElementById('historyPosView').style.display = tab === 'history' ? 'grid' : 'none';
    }

    async function executeTrade(side) {
      const margin = Number(document.getElementById('tradeAmt').value);
      const lev = Number(document.getElementById('levSlider').value);

      if (!margin || margin <= 0) return alert('Enter margin amount');
      if (!activeToken) return alert('No asset selected');

      if (isPaper) {
        if (margin > paperState.usdtBalance) {
          return alert('Insufficient Paper USDT Balance');
        }

        const posSize = margin * lev;

        paperState.usdtBalance -= margin;

        paperState.positions.push({
          id: Date.now().toString(),
          tokenId: activeToken.id,
          symbol: activeToken.symbol,
          side,
          margin,
          leverage: lev,
          size: posSize,
          entryPrice: activeToken.price,
          marginMode
        });

        savePaperState();

        document.getElementById('tradeAmt').value = '';

        renderBalancesAndPositions();
        switchTab('active', document.querySelector('.tab:first-child'));

        return;
      }

      try {
        const res = await fetch('/api/trading/execute', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            tokenId: activeToken.id,
            side,
            margin,
            leverage: lev,
            marginMode
          })
        });

        const data = await res.json();

        if (res.ok) {
          liveState.usdtBalance = data.usdtBalance;
          liveState.positions.unshift(data.position);

          document.getElementById('tradeAmt').value = '';

          renderBalancesAndPositions();
          switchTab('active', document.querySelector('.tab:first-child'));
        } else {
          alert(data.error || 'Trade failed');
        }
      } catch (e) {
        alert('Network error');
      }
    }

    async function closePosition(id) {
      if (isPaper) {
        const idx = paperState.positions.findIndex(p => String(p.id) === String(id));

        if (idx === -1) return;

        const pos = paperState.positions[idx];
        const token = tensorAssets.find(t => t.id === pos.tokenId);
        const currentPrice = token ? token.price : pos.entryPrice;

        const pnl = (
          pos.side === 'long'
            ? currentPrice - pos.entryPrice
            : pos.entryPrice - currentPrice
        ) / pos.entryPrice * pos.size;

        paperState.usdtBalance += pos.margin + pnl;
        paperState.positions.splice(idx, 1);
        paperState.orderHistory.unshift({
          ...pos,
          closePrice: currentPrice,
          pnl,
          closeReason: 'Market Close'
        });

        savePaperState();
        renderBalancesAndPositions();

        return;
      }

      try {
        const res = await fetch('/api/trading/close', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            positionId: id
          })
        });

        if (res.ok) {
          await fetchCoreData();
        } else {
          alert('Failed to close position.');
        }
      } catch (e) {
        console.error('closePosition error:', e);
      }
    }

    function checkPaperLiquidations() {
      if (!isPaper || paperState.positions.length === 0) return;

      let changed = false;

      paperState.positions = paperState.positions.filter(pos => {
        const token = tensorAssets.find(t => t.id === pos.tokenId);

        if (!token) return true;

        const liqPrice = getLiqPrice(
          pos.entryPrice,
          pos.size,
          pos.margin,
          pos.side,
          pos.marginMode || 'cross',
          paperState.usdtBalance
        );

        const isLiq = pos.side === 'long'
          ? token.price <= liqPrice
          : token.price >= liqPrice;

        if (isLiq) {
          paperState.orderHistory.unshift({
            ...pos,
            closePrice: token.price,
            pnl: -pos.margin,
            closeReason: 'LIQUIDATION'
          });

          changed = true;
          return false;
        }

        return true;
      });

      if (changed) {
        savePaperState();
        renderBalancesAndPositions();
      }
    }

    window.onload = () => {
      document.documentElement.setAttribute('data-theme', currentTheme);

      initApexChart();

      document.getElementById('availUsdt').innerText = liveState.usdtBalance.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });

      fetchCoreData();

      setInterval(async () => {
        await fetchCoreData();
        checkPaperLiquidations();
      }, 1800);
    };
  </script>
</body>
</html>