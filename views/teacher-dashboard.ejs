<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Teacher Dashboard • Credity</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&family=Space+Grotesk:wght@500;700&family=Cinzel:wght@500;700;800&family=Montserrat:wght@400;500;600;700;800&family=Pinyon+Script&display=swap');

    * {
      box-sizing: border-box;
      min-width: 0;
    }

    html,
    body {
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: #f6f7f9;
      color: #0f172a;
      -webkit-font-smoothing: antialiased;
    }

    .app-shell {
      min-height: 100vh;
      display: flex;
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
    }

    .sidebar {
      width: 304px;
      min-width: 304px;
      max-width: 304px;
      height: 100vh;
      position: sticky;
      top: 0;
      background: #ffffff;
      border-right: 1px solid #e5e7eb;
      overflow: hidden;
      z-index: 50;
    }

    .sidebar-inner {
      height: 100%;
      width: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 18px;
    }

    .main-shell {
      flex: 1;
      width: calc(100vw - 304px);
      max-width: calc(100vw - 304px);
      overflow-x: hidden;
    }

    .page {
      width: 100%;
      max-width: 100%;
      padding: 24px;
    }

    .panel {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .panel-strong {
      background: #ffffff;
      border: 1px solid #dbe1ea;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.045);
    }

    .input {
      width: 100%;
      max-width: 100%;
      background: #ffffff;
      border: 1px solid #d8dee8;
      transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .input:focus {
      border-color: #2563eb;
      outline: none;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
    }

    .btn {
      font-weight: 500;
      border-radius: 12px;
      transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
      max-width: 100%;
      text-align: center;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn-primary {
      background: #1d4ed8;
      color: #ffffff;
      border: 1px solid #1d4ed8;
    }

    .btn-primary:hover {
      background: #1e40af;
      border-color: #1e40af;
    }

    .btn-dark {
      background: #111827;
      color: #ffffff;
      border: 1px solid #111827;
    }

    .btn-dark:hover {
      background: #030712;
      border-color: #030712;
    }

    .btn-light {
      background: #ffffff;
      color: #111827;
      border: 1px solid #d8dee8;
    }

    .btn-light:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .btn-green {
      background: #059669;
      color: #ffffff;
      border: 1px solid #059669;
    }

    .btn-green:hover {
      background: #047857;
      border-color: #047857;
    }

    .btn-purple {
      background: #7c3aed;
      color: #ffffff;
      border: 1px solid #7c3aed;
    }

    .btn-purple:hover {
      background: #6d28d9;
      border-color: #6d28d9;
    }

    .btn-red {
      background: #dc2626;
      color: #ffffff;
      border: 1px solid #dc2626;
    }

    .btn-red:hover {
      background: #b91c1c;
      border-color: #b91c1c;
    }

    .side-link {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      color: #475569;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.16s ease;
      border: 1px solid transparent;
    }

    .side-link:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    .side-link.active {
      background: #eff6ff;
      color: #1d4ed8;
      border-color: #bfdbfe;
    }

    .class-box {
      width: 100%;
      text-align: left;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      border-radius: 16px;
      padding: 14px;
      transition: all 0.16s ease;
      overflow: hidden;
    }

    .class-box:hover {
      border-color: #bfdbfe;
      background: #f8fafc;
    }

    .class-box.active {
      background: #111827;
      color: #ffffff;
      border-color: #111827;
    }

    .class-box.active .muted-on-active {
      color: rgba(255, 255, 255, 0.68);
    }

    .task-link.active {
      background: #111827;
      color: #ffffff;
      border-color: #111827;
    }

    .task-link.active .muted-on-active {
      color: rgba(255,255,255,0.68);
    }

    .custom-scroll::-webkit-scrollbar {
      height: 6px;
      width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
      background: #eef2f7;
      border-radius: 999px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
      background: #c8d0dc;
      border-radius: 999px;
    }

    .table-wrap {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .safe-table {
      width: 100%;
      min-width: 780px;
      border-collapse: collapse;
    }

    .grid-safe {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 14px;
      width: 100%;
      max-width: 100%;
    }

    .two-col-safe {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 18px;
      width: 100%;
      max-width: 100%;
    }

    .three-col-safe {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      width: 100%;
      max-width: 100%;
    }

    .font-signature {
      font-family: 'Pinyon Script', cursive;
    }

    .cert-container {
      container-type: inline-size;
      perspective: 1000px;
      width: 100%;
      max-width: 100%;
    }

    .certificate-preview {
      width: 100%;
      max-width: 100%;
      background: white;
      box-shadow: 0 18px 44px rgba(15, 23, 42, 0.16);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      transform-style: preserve-3d;
      display: flex;
      flex-direction: column;
      color: #1e293b;
    }

    .anti-forge-layer {
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      overflow: hidden;
      opacity: 0.22;
    }

    .anti-forge-line {
      position: absolute;
      left: -10%;
      width: 120%;
      white-space: nowrap;
      font-size: 0.92cqi;
      letter-spacing: 0.22em;
      color: rgba(15, 23, 42, 0.18);
      text-transform: uppercase;
      transform: rotate(-10deg);
      font-weight: 700;
      font-family: 'Montserrat', sans-serif;
    }

    .anti-forge-line:nth-child(1) { top: 15%; }
    .anti-forge-line:nth-child(2) { top: 24%; }
    .anti-forge-line:nth-child(3) { top: 33%; }
    .anti-forge-line:nth-child(4) { top: 42%; }
    .anti-forge-line:nth-child(5) { top: 51%; }
    .anti-forge-line:nth-child(6) { top: 60%; }
    .anti-forge-line:nth-child(7) { top: 69%; }
    .anti-forge-line:nth-child(8) { top: 78%; }

    .cert-wave-watermark {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      opacity: 0.13;
      background:
        radial-gradient(circle at 25% 18%, rgba(37, 99, 235, 0.16), transparent 30%),
        radial-gradient(circle at 80% 74%, rgba(124, 58, 237, 0.14), transparent 32%);
    }

    .cert-wave-watermark::before {
      content: '';
      position: absolute;
      left: -10%;
      right: -10%;
      top: 35%;
      height: 38%;
      background:
        url("data:image/svg+xml,%3Csvg width='900' height='260' viewBox='0 0 900 260' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 140 C120 40 210 40 330 140 S540 240 660 140 S780 40 900 140' fill='none' stroke='%232563eb' stroke-width='18' stroke-linecap='round' opacity='.42'/%3E%3Cpath d='M0 190 C120 90 210 90 330 190 S540 290 660 190 S780 90 900 190' fill='none' stroke='%237c3aed' stroke-width='12' stroke-linecap='round' opacity='.28'/%3E%3C/svg%3E")
        center / cover no-repeat;
      transform: rotate(-8deg);
    }

    .cert-seal {
      width: 9cqi;
      height: 9cqi;
      border-radius: 50%;
      border: 0.45cqi double currentColor;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.1cqi;
      margin: 0 auto 1.5cqi;
      position: relative;
      opacity: 0.92;
    }

    .cert-seal::before,
    .cert-seal::after {
      content: '';
      position: absolute;
      inset: -0.9cqi;
      border: 0.18cqi solid currentColor;
      border-radius: 50%;
      opacity: 0.25;
    }

    .cert-seal::after {
      inset: 1.1cqi;
      opacity: 0.18;
    }

    .draggable-logo {
      position: absolute;
      cursor: grab;
      z-index: 80;
      width: 8.5cqi;
      height: 8.5cqi;
      min-width: 28px;
      min-height: 28px;
      mix-blend-mode: multiply;
      pointer-events: auto;
    }

    .draggable-logo:active {
      cursor: grabbing;
    }

    .draggable-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      pointer-events: none;
      user-select: none;
    }

    .tpl-1-degree {
      font-family: 'Cinzel', serif;
      border: 2.6cqw solid #111827;
      outline: 0.55cqw solid #b45309;
      outline-offset: -1.35cqw;
      background:
        radial-gradient(circle at center, rgba(180,83,9,0.055), transparent 42%),
        linear-gradient(#fffdf8, #fefaf0);
      box-shadow: inset 0 0 0 1.5cqw #f8f1e3, inset 0 0 90px rgba(180, 83, 9, 0.08);
    }

    .tpl-1-degree::before {
      content: '';
      position: absolute;
      inset: 2.1cqw;
      border: 0.28cqw solid rgba(17,24,39,0.22);
      pointer-events: none;
      z-index: 2;
    }

    .tpl-1-degree::after {
      content: '';
      position: absolute;
      inset: 3cqw;
      border: 0.12cqw dashed rgba(180,83,9,0.34);
      pointer-events: none;
      z-index: 2;
    }

    .tpl-1-degree .cert-title {
      font-size: 4.3cqi;
      color: #111827;
      font-weight: 800;
      border-bottom: 0.28cqw solid #b45309;
      padding-bottom: 1.15cqw;
      display: inline-block;
      letter-spacing: 0.035em;
    }

    .tpl-2-university {
      font-family: 'Playfair Display', serif;
      border: 3cqw solid #172554;
      background:
        linear-gradient(135deg, rgba(29,78,216,0.05), transparent 35%),
        linear-gradient(#ffffff, #f8fafc);
    }

    .tpl-2-university::before {
      content: '';
      position: absolute;
      inset: 1.7cqw;
      border: 0.45cqw double #1d4ed8;
      opacity: 0.42;
      pointer-events: none;
      z-index: 2;
    }

    .tpl-2-university::after {
      content: 'ACADEMIC EXCELLENCE';
      position: absolute;
      left: 50%;
      bottom: 3.5cqw;
      transform: translateX(-50%);
      font-size: 0.95cqi;
      letter-spacing: 0.45em;
      color: rgba(30,64,175,0.38);
      font-family: 'Montserrat', sans-serif;
      z-index: 2;
    }

    .tpl-2-university .cert-title {
      font-size: 3.75cqi;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: #172554;
      font-weight: 800;
    }

    .tpl-3-corporate {
      font-family: 'Montserrat', sans-serif;
      border-top: 5.7cqw solid #0f172a;
      border-bottom: 1.9cqw solid #0f172a;
      background:
        linear-gradient(90deg, rgba(15,23,42,0.035) 0 1px, transparent 1px),
        linear-gradient(#ffffff, #f8fafc);
      background-size: 4cqw 4cqw;
    }

    .tpl-3-corporate::before {
      content: '';
      position: absolute;
      top: 1.5cqw;
      left: 3cqw;
      right: 3cqw;
      height: 0.22cqw;
      background: linear-gradient(90deg, #2563eb, #7c3aed, #0f172a);
      z-index: 2;
    }

    .tpl-3-corporate .cert-title {
      font-size: 3.35cqi;
      font-weight: 800;
      letter-spacing: 0.14em;
      color: #0f172a;
      text-transform: uppercase;
    }

    .tpl-4-tech {
      font-family: 'Space Grotesk', sans-serif;
      border: 0.7cqw solid #0f172a;
      background:
        radial-gradient(circle at 15% 15%, rgba(37,99,235,0.12), transparent 20%),
        radial-gradient(circle at 90% 75%, rgba(124,58,237,0.10), transparent 24%),
        linear-gradient(rgba(15,23,42,0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15,23,42,0.045) 1px, transparent 1px),
        #ffffff;
      background-size: auto, auto, 3.3cqw 3.3cqw, 3.3cqw 3.3cqw;
    }

    .tpl-4-tech::before {
      content: '';
      position: absolute;
      inset: 2cqw;
      border: 0.2cqw solid rgba(37,99,235,0.34);
      box-shadow: 0 0 0 0.5cqw rgba(124,58,237,0.06);
      z-index: 2;
      pointer-events: none;
    }

    .tpl-4-tech .cert-title {
      font-size: 3.35cqi;
      text-transform: uppercase;
      color: #0f172a;
      letter-spacing: 0.11em;
      font-weight: 800;
    }

    .tpl-5-scholar {
      font-family: 'Cinzel', serif;
      border: 1.75cqw solid #92400e;
      background:
        radial-gradient(circle at center, rgba(146,64,14,0.08), transparent 38%),
        linear-gradient(135deg, #fffbeb, #fef3c7);
    }

    .tpl-5-scholar::before {
      content: '';
      position: absolute;
      inset: 1.15cqw;
      border: 0.35cqw double #b45309;
      pointer-events: none;
      z-index: 2;
      opacity: 0.72;
    }

    .tpl-5-scholar::after {
      content: '';
      position: absolute;
      inset: 3.2cqw;
      border: 0.14cqw solid rgba(146,64,14,0.25);
      pointer-events: none;
      z-index: 2;
    }

    .tpl-5-scholar .cert-title {
      font-size: 4cqi;
      color: #92400e;
      font-weight: 800;
    }

    .tpl-6-minimal {
      font-family: 'Inter', sans-serif;
      border-left: 6.8cqw solid #0f172a;
      background:
        linear-gradient(90deg, rgba(15,23,42,0.04), transparent 45%),
        #f8fafc;
    }

    .tpl-6-minimal::before {
      content: '';
      position: absolute;
      top: 4cqw;
      right: 4cqw;
      width: 14cqw;
      height: 14cqw;
      border: 0.35cqw solid rgba(15,23,42,0.08);
      border-radius: 50%;
      z-index: 2;
      pointer-events: none;
    }

    .tpl-6-minimal .cert-title {
      font-size: 3.55cqi;
      font-weight: 800;
      text-align: left;
      color: #0f172a;
    }

    .tpl-7-dark {
      font-family: 'Space Grotesk', sans-serif;
      border: 0.65cqw solid #334155;
      background:
        radial-gradient(circle at 50% 0%, #1e293b, #0f172a 62%),
        #0f172a;
      color: #f8fafc !important;
    }

    .tpl-7-dark::before {
      content: '';
      position: absolute;
      inset: 2cqw;
      border: 0.18cqw solid rgba(255,255,255,0.18);
      pointer-events: none;
      z-index: 2;
    }

    .tpl-7-dark .cert-title,
    .tpl-7-dark .cert-text-color {
      color: white !important;
    }

    .tpl-7-dark .anti-forge-line {
      color: rgba(255,255,255,0.13);
    }

    .tpl-7-dark .draggable-logo {
      mix-blend-mode: normal;
      filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.55));
    }

    .badge-preview-shape-circle { border-radius: 50%; }
    .badge-preview-shape-shield { clip-path: polygon(50% 100%, 0 80%, 0 0, 100% 0, 100% 80%); }
    .badge-preview-shape-hexagon { clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); }
    .badge-preview-shape-diamond { clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); }
    .badge-preview-shape-star { clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }

    .mobile-overlay {
      display: none;
    }

    @media (max-width: 1279px) {
      .app-shell {
        display: block;
      }

      .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        transform: translateX(-100%);
        transition: transform 0.22s ease;
        z-index: 80;
        width: 304px;
        max-width: calc(100vw - 32px);
        min-width: 0;
      }

      .sidebar.open {
        transform: translateX(0);
      }

      .mobile-overlay {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.42);
        z-index: 70;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.22s ease;
      }

      .mobile-overlay.open {
        opacity: 1;
        pointer-events: auto;
      }

      .main-shell {
        width: 100%;
        max-width: 100%;
      }

      .page {
        padding: 16px;
      }

      .two-col-safe,
      .three-col-safe {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .page {
        padding: 14px;
      }

      .panel,
      .panel-strong {
        border-radius: 16px;
      }

      .safe-table {
        min-width: 720px;
      }
    }
  </style>
</head>

<body>
  <%
    const safeBadges = typeof badges !== 'undefined' && Array.isArray(badges) ? badges : [];
    const safeTests = typeof tests !== 'undefined' && Array.isArray(tests) ? tests : [];
    const safeEvents = typeof events !== 'undefined' && Array.isArray(events) ? events : [];
    const safeClasses = typeof classes !== 'undefined' && Array.isArray(classes)
      ? classes
      : (typeof studentKeys !== 'undefined' && Array.isArray(studentKeys) ? studentKeys : []);

    const teacherName = user && user.name ? user.name : 'Teacher';
    const firstName = teacherName.split(' ')[0];

    function assignedForClass(cls) {
      return Array.isArray(cls.assignedTests)
        ? cls.assignedTests
        : safeTests.filter(t => Array.isArray(cls.assignedTestIds) && cls.assignedTestIds.map(Number).includes(Number(t.id)));
    }

    const totalStudents = safeClasses.reduce((sum, c) => {
      if (Array.isArray(c.students)) return sum + c.students.length;
      return sum + Number(c.usageCount || 0);
    }, 0);

    const totalSubmissions = typeof submissions !== 'undefined' && Array.isArray(submissions)
      ? submissions.length
      : safeClasses.reduce((sum, c) => sum + Number(c.submissionCount || 0), 0);
  %>

  <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>

  <div class="app-shell">
    <aside id="sidebar" class="sidebar">
      <div class="sidebar-inner custom-scroll">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center shrink-0">
              <span class="text-white font-semibold text-xl">C</span>
            </div>

            <div>
              <div class="font-semibold text-xl leading-none truncate">Credity</div>
              <div class="text-[11px] text-slate-500 uppercase tracking-wider mt-1 truncate">Teacher Dashboard</div>
            </div>
          </div>

          <button type="button" onclick="closeSidebar()" class="xl:hidden w-9 h-9 rounded-lg border border-slate-200 flex items-center justify-center">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="panel rounded-xl p-4 mb-5">
          <div class="text-sm font-semibold truncate"><%= teacherName %></div>
          <div class="text-xs text-slate-500 mt-1">Teacher workspace</div>
        </div>

        <nav class="space-y-1 mb-6">
          <button class="side-link active" data-view-link="overview" onclick="showView('overview')">
            <i class="fa-solid fa-gauge-high w-5 shrink-0"></i>
            <span class="truncate">Overview</span>
          </button>

          <button class="side-link" data-view-link="classes" onclick="showView('classes')">
            <i class="fa-solid fa-users-rectangle w-5 shrink-0"></i>
            <span class="truncate">Classes</span>
          </button>

          <button class="side-link" data-view-link="tasks" onclick="showView('tasks')">
            <i class="fa-solid fa-clipboard-question w-5 shrink-0"></i>
            <span class="truncate">Assignments</span>
          </button>

          <button class="side-link" data-view-link="credentials" onclick="showView('credentials')">
            <i class="fa-solid fa-certificate w-5 shrink-0"></i>
            <span class="truncate">Certificates</span>
          </button>

          <button class="side-link" data-view-link="badges" onclick="showView('badges')">
            <i class="fa-solid fa-award w-5 shrink-0"></i>
            <span class="truncate">Badges</span>
          </button>

          <button class="side-link" data-view-link="announcements" onclick="showView('announcements')">
            <i class="fa-solid fa-bullhorn w-5 shrink-0"></i>
            <span class="truncate">Announcements</span>
          </button>
        </nav>

        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Class Boxes</div>
            <span class="text-xs text-slate-400"><%= safeClasses.length %></span>
          </div>

          <div class="space-y-2">
            <% if (safeClasses.length > 0) { %>
              <% safeClasses.forEach((cls, idx) => {
                const cTasks = assignedForClass(cls);
                const cStudents = Array.isArray(cls.students) ? cls.students : [];
              %>
                <button
                  type="button"
                  class="class-box <%= idx === 0 ? 'active' : '' %>"
                  data-class-button="<%= cls.id %>"
                  onclick="selectClass('<%= cls.id %>')">
                  <div class="flex items-center justify-between gap-2">
                    <div class="text-sm font-semibold truncate"><%= cls.className %></div>
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 border border-slate-200 shrink-0 text-slate-700"><%= cTasks.length %></span>
                  </div>
                  <div class="text-xs text-slate-500 muted-on-active mt-1 truncate">
                    <%= cStudents.length || cls.usageCount || 0 %> students • <%= cTasks.length %> assignments
                  </div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="text-sm text-slate-500 border border-dashed border-slate-300 rounded-xl p-4 text-center">
                No classes yet
              </div>
            <% } %>
          </div>
        </div>

        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Assignment Bar</div>
            <span class="text-xs text-slate-400"><%= safeTests.length %></span>
          </div>

          <div class="space-y-2 max-h-72 overflow-y-auto custom-scroll pr-1">
            <% if (safeTests.length > 0) { %>
              <% safeTests.forEach(task => { %>
                <button
                  type="button"
                  class="task-link w-full text-left px-3 py-3 border border-slate-200 rounded-xl bg-white hover:bg-slate-50 transition"
                  data-task-button="<%= task.id %>"
                  onclick="selectTask('<%= task.id %>')">
                  <div class="text-sm font-medium truncate"><%= task.title %></div>
                  <div class="text-xs text-slate-500 muted-on-active mt-1 truncate"><%= task.questions ? task.questions.length : 0 %> questions</div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="text-sm text-slate-500 border border-dashed border-slate-300 rounded-xl p-4 text-center">
                No assignments yet
              </div>
            <% } %>
          </div>
        </div>

        <div class="mt-6 space-y-2">
          <a href="/assessment" class="btn btn-primary w-full py-3 text-sm flex items-center justify-center gap-2">
            <i class="fa-solid fa-plus"></i>
            Make Assignment
          </a>

          <a href="/logout" class="btn btn-light w-full py-3 text-sm flex items-center justify-center gap-2">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            Logout
          </a>
        </div>
      </div>
    </aside>

    <main class="main-shell">
      <nav class="xl:hidden bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="px-4 py-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <button type="button" onclick="openSidebar()" class="w-10 h-10 rounded-lg border border-slate-200 flex items-center justify-center shrink-0">
              <i class="fa-solid fa-bars"></i>
            </button>

            <div>
              <div class="font-semibold text-lg leading-none truncate">Credity Teacher</div>
              <div class="text-[11px] text-slate-500 uppercase tracking-wider mt-1 truncate">Dashboard</div>
            </div>
          </div>

          <a href="/assessment" class="btn btn-dark px-4 py-2 text-sm shrink-0">
            New
          </a>
        </div>
      </nav>

      <div class="page">
        <section class="view-panel" data-view-panel="overview">
          <div class="panel-strong rounded-2xl p-5 md:p-8 mb-6">
            <div class="grid lg:grid-cols-[minmax(0,1.3fr)_minmax(260px,.7fr)] gap-6 items-center">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-blue-50 text-blue-700 text-xs font-medium tracking-[1.5px] rounded-lg border border-blue-100 mb-5">
                  <i class="fa-solid fa-chart-simple"></i>
                  <span>TEACHER ACTION CENTER</span>
                </div>

                <h1 class="text-4xl md:text-6xl font-semibold tracking-tighter text-slate-950 leading-none break-words">
                  Welcome back, <%= firstName %>.
                </h1>

                <p class="mt-5 text-lg md:text-xl text-slate-600 max-w-3xl leading-relaxed">
                  Manage class boxes, create and delete assignments, design professional certificates with anti-forge marks, and build verified badges.
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                  <a href="/assessment" class="btn btn-primary inline-flex items-center justify-center gap-3 px-6 py-3.5">
                    <i class="fa-solid fa-file-circle-plus"></i>
                    Make Assignment
                  </a>

                  <button onclick="showView('classes')" class="btn btn-light inline-flex items-center justify-center gap-3 px-6 py-3.5">
                    <i class="fa-solid fa-users-rectangle text-emerald-600"></i>
                    View Classes
                  </button>

                  <button onclick="showView('credentials')" class="btn btn-light inline-flex items-center justify-center gap-3 px-6 py-3.5">
                    <i class="fa-solid fa-certificate text-blue-600"></i>
                    Create Certificate
                  </button>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="panel rounded-xl p-4">
                  <div class="w-10 h-10 bg-emerald-50 text-emerald-700 rounded-lg flex items-center justify-center mb-4 border border-emerald-100">
                    <i class="fa-solid fa-users-rectangle"></i>
                  </div>
                  <div class="text-3xl md:text-4xl font-semibold"><%= safeClasses.length %></div>
                  <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Classes</div>
                </div>

                <div class="panel rounded-xl p-4">
                  <div class="w-10 h-10 bg-blue-50 text-blue-700 rounded-lg flex items-center justify-center mb-4 border border-blue-100">
                    <i class="fa-solid fa-clipboard-question"></i>
                  </div>
                  <div class="text-3xl md:text-4xl font-semibold"><%= safeTests.length %></div>
                  <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Assignments</div>
                </div>

                <div class="panel rounded-xl p-4">
                  <div class="w-10 h-10 bg-violet-50 text-violet-700 rounded-lg flex items-center justify-center mb-4 border border-violet-100">
                    <i class="fa-solid fa-award"></i>
                  </div>
                  <div class="text-3xl md:text-4xl font-semibold"><%= safeBadges.length %></div>
                  <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Badges</div>
                </div>

                <div class="panel rounded-xl p-4">
                  <div class="w-10 h-10 bg-amber-50 text-amber-700 rounded-lg flex items-center justify-center mb-4 border border-amber-100">
                    <i class="fa-solid fa-square-poll-vertical"></i>
                  </div>
                  <div class="text-3xl md:text-4xl font-semibold"><%= totalSubmissions %></div>
                  <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Submissions</div>
                </div>
              </div>
            </div>
          </div>

          <div class="grid-safe">
            <% if (safeClasses.length > 0) { %>
              <% safeClasses.forEach(cls => {
                const cTasks = assignedForClass(cls);
                const cStudents = Array.isArray(cls.students) ? cls.students : [];
                const cResults = Array.isArray(cls.results) ? cls.results : [];
              %>
                <button type="button" onclick="selectClass('<%= cls.id %>')" class="panel-strong rounded-2xl p-5 text-left hover:border-blue-300 transition">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <div class="text-lg font-semibold truncate"><%= cls.className %></div>
                      <div class="text-sm text-slate-500 mt-1 truncate"><%= cls.key %></div>
                    </div>
                    <i class="fa-solid fa-arrow-right text-slate-300 shrink-0"></i>
                  </div>

                  <div class="grid grid-cols-3 gap-2 mt-5">
                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-3">
                      <div class="text-xs text-slate-500 uppercase tracking-wider">Tasks</div>
                      <div class="text-xl font-semibold mt-1"><%= cTasks.length %></div>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-3">
                      <div class="text-xs text-slate-500 uppercase tracking-wider">Students</div>
                      <div class="text-xl font-semibold mt-1"><%= cStudents.length || cls.usageCount || 0 %></div>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-3">
                      <div class="text-xs text-slate-500 uppercase tracking-wider">Scores</div>
                      <div class="text-xl font-semibold mt-1"><%= cResults.length %></div>
                    </div>
                  </div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="panel-strong rounded-2xl p-10 text-center">
                <i class="fa-solid fa-users-rectangle text-4xl text-slate-300 mb-4"></i>
                <div class="text-xl font-semibold">No classes yet</div>
                <p class="text-slate-500 mt-2">Create your first class key from the Classes section.</p>
              </div>
            <% } %>
          </div>
        </section>

        <section class="view-panel hidden" data-view-panel="classes">
          <div class="grid lg:grid-cols-[minmax(260px,360px)_minmax(0,1fr)] gap-6">
            <div class="panel-strong rounded-2xl p-5 md:p-6 h-fit">
              <h3 class="text-2xl font-semibold">Create Class Key</h3>
              <p class="text-sm text-slate-500 mt-1 mb-6">
                Create a class, share the key, then assign assessments.
              </p>

              <form action="/generate-student-key" method="POST" class="space-y-5">
                <div>
                  <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Class Name</label>
                  <input type="text" name="className" placeholder="Grade 10A - Python" class="input px-4 py-3 rounded-lg font-medium" required>
                </div>

                <button type="submit" class="btn btn-green w-full py-4">
                  Generate Class Key
                </button>
              </form>

              <div class="mt-6 p-5 bg-emerald-50 border border-emerald-100 rounded-xl">
                <div class="font-semibold text-emerald-800">Class flow</div>
                <ol class="text-sm text-emerald-700 mt-2 space-y-1 list-decimal list-inside">
                  <li>Create a class key.</li>
                  <li>Students join with the key.</li>
                  <li>Assign new or existing assessments.</li>
                  <li>View scores and submissions.</li>
                </ol>
              </div>
            </div>

            <div>
              <% if (safeClasses.length > 0) { %>
                <% safeClasses.forEach((cls, idx) => {
                  const assignedTests = assignedForClass(cls);
                  const classAnnouncements = Array.isArray(cls.announcements) ? cls.announcements : [];
                  const students = Array.isArray(cls.students) ? cls.students : [];
                  const results = Array.isArray(cls.results) ? cls.results : [];
                %>
                  <div class="class-panel panel-strong rounded-2xl p-5 md:p-6 <%= idx === 0 ? '' : 'hidden' %>" data-class-panel="<%= cls.id %>">
                    <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-5">
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <h3 class="text-2xl md:text-3xl font-semibold text-slate-950 break-words"><%= cls.className %></h3>
                          <span class="text-[10px] font-medium px-3 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700">
                            <%= cls.active === false ? 'DISABLED' : 'ACTIVE' %>
                          </span>
                        </div>

                        <div class="text-sm text-slate-500 mt-1">
                          <%= students.length || cls.usageCount || 0 %> students joined • <%= assignedTests.length %> assignments • <%= results.length %> submissions
                        </div>
                      </div>

                      <div class="flex flex-wrap items-center gap-2">
                        <code class="max-w-full overflow-x-auto custom-scroll px-3 py-2 bg-slate-50 border border-slate-200 text-slate-900 rounded-lg text-xs font-semibold tracking-wider"><%= cls.key %></code>
                        <button type="button" onclick="copyText('<%= cls.key %>')" class="btn btn-dark px-3 py-2 text-xs">
                          Copy
                        </button>
                      </div>
                    </div>

                    <div class="three-col-safe mt-6">
                      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
                        <div class="text-xs text-slate-500 font-medium uppercase tracking-wider">Students</div>
                        <div class="text-3xl font-semibold mt-1"><%= students.length || cls.usageCount || 0 %></div>
                      </div>

                      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
                        <div class="text-xs text-slate-500 font-medium uppercase tracking-wider">Assignments</div>
                        <div class="text-3xl font-semibold mt-1"><%= assignedTests.length %></div>
                      </div>

                      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
                        <div class="text-xs text-slate-500 font-medium uppercase tracking-wider">Submissions</div>
                        <div class="text-3xl font-semibold mt-1"><%= results.length %></div>
                      </div>
                    </div>

                    <div class="two-col-safe mt-6">
                      <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
                        <div class="flex items-center justify-between gap-3 mb-4">
                          <div>
                            <div class="font-semibold">Assignments</div>
                            <p class="text-xs text-slate-500 mt-1">Assign existing work or make a new one.</p>
                          </div>

                          <a href="/assessment" class="btn btn-primary text-xs px-3 py-2 shrink-0">
                            New Assignment
                          </a>
                        </div>

                        <form action="/assign-class-test" method="POST" class="grid sm:grid-cols-[minmax(0,1fr)_auto] gap-2">
                          <input type="hidden" name="classId" value="<%= cls.id %>">

                          <select name="testId" class="input px-4 py-3 rounded-lg text-sm font-medium" required>
                            <option value="">Select assignment...</option>
                            <% safeTests.forEach(t => { %>
                              <option value="<%= t.id %>"><%= t.title %></option>
                            <% }) %>
                          </select>

                          <button type="submit" class="btn btn-dark px-5 py-3 text-sm">
                            Assign
                          </button>
                        </form>

                        <div class="mt-4">
                          <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Assigned to this class</div>

                          <% if (assignedTests.length > 0) { %>
                            <div class="space-y-2">
                              <% assignedTests.forEach(t => { %>
                                <div class="bg-white border border-slate-200 rounded-lg p-3 task-row" data-task-row="<%= t.id %>">
                                  <div class="flex items-center justify-between gap-3">
                                    <div>
                                      <div class="text-sm font-medium truncate"><%= t.title %></div>
                                      <div class="text-xs text-slate-500"><%= t.questions ? t.questions.length : 0 %> questions</div>
                                    </div>

                                    <div class="flex items-center gap-2 shrink-0">
                                      <form action="/unassign-class-test" method="POST">
                                        <input type="hidden" name="classId" value="<%= cls.id %>">
                                        <input type="hidden" name="testId" value="<%= t.id %>">
                                        <button type="submit" class="btn btn-light px-3 py-2 text-xs">
                                          Unassign
                                        </button>
                                      </form>

                                      <form action="/delete-test" method="POST" onsubmit="return confirm('Delete this assignment completely? Scores and class links will remain historically in submissions, but the assignment will be removed.');">
                                        <input type="hidden" name="testId" value="<%= t.id %>">
                                        <button type="submit" class="btn btn-red px-3 py-2 text-xs">
                                          Delete
                                        </button>
                                      </form>
                                    </div>
                                  </div>
                                </div>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <div class="text-sm text-slate-500 bg-white border border-dashed border-slate-300 rounded-lg p-4 text-center">
                              No assignments attached to this class.
                            </div>
                          <% } %>
                        </div>
                      </div>

                      <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
                        <div class="font-semibold">Class Announcement</div>
                        <p class="text-xs text-slate-500 mt-1 mb-4">Only students in this class see this.</p>

                        <form action="/class-announcement" method="POST" class="space-y-3">
                          <input type="hidden" name="classId" value="<%= cls.id %>">

                          <input type="text" name="title" placeholder="Announcement title" class="input px-4 py-3 rounded-lg text-sm font-medium" required>
                          <textarea name="description" placeholder="Write the announcement..." class="input px-4 py-3 rounded-lg h-20 text-sm"></textarea>

                          <button type="submit" class="btn btn-purple w-full py-3 text-sm">
                            Post to Class
                          </button>
                        </form>

                        <div class="mt-4">
                          <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Recent Announcements</div>

                          <% if (classAnnouncements.length > 0) { %>
                            <div class="space-y-2 max-h-44 overflow-y-auto custom-scroll pr-1">
                              <% classAnnouncements.slice().reverse().forEach(a => { %>
                                <div class="bg-white border border-slate-200 rounded-lg p-3">
                                  <div class="text-sm font-medium break-words"><%= a.title %></div>
                                  <div class="text-xs text-slate-500 mt-1 break-words"><%= a.description || 'No description.' %></div>
                                </div>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <div class="text-sm text-slate-500 bg-white border border-dashed border-slate-300 rounded-lg p-4 text-center">
                              No announcements yet.
                            </div>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="mt-6 bg-white border border-slate-200 rounded-xl overflow-hidden">
                      <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                        <div class="font-semibold">Student Roster & Scores</div>
                        <div class="text-xs text-slate-500 mt-1">Full name, email, completed tests, pending tasks, and scores.</div>
                      </div>

                      <% if (students.length > 0) { %>
                        <div class="table-wrap custom-scroll">
                          <table class="safe-table text-left text-sm">
                            <thead>
                              <tr class="border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500 bg-white">
                                <th class="px-5 py-3 font-medium">Student</th>
                                <th class="px-5 py-3 font-medium">Email</th>
                                <th class="px-5 py-3 font-medium">Joined</th>
                                <th class="px-5 py-3 font-medium">Completed</th>
                                <th class="px-5 py-3 font-medium">Pending</th>
                                <th class="px-5 py-3 font-medium">Average</th>
                              </tr>
                            </thead>

                            <tbody class="divide-y divide-slate-100">
                              <% students.forEach(student => { %>
                                <tr class="hover:bg-slate-50">
                                  <td class="px-5 py-4">
                                    <div class="font-medium text-slate-950"><%= student.fullName %></div>
                                    <div class="text-xs text-slate-500">ID: <%= student.userId %></div>
                                  </td>

                                  <td class="px-5 py-4 text-slate-600"><%= student.email %></td>
                                  <td class="px-5 py-4 text-slate-600 whitespace-nowrap"><%= student.joinedAtFormatted || '—' %></td>

                                  <td class="px-5 py-4">
                                    <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700 text-xs font-medium">
                                      <%= student.completedCount || 0 %>
                                    </span>
                                  </td>

                                  <td class="px-5 py-4">
                                    <span class="px-2.5 py-1 rounded-full bg-amber-50 border border-amber-100 text-amber-700 text-xs font-medium">
                                      <%= student.pendingCount || 0 %>
                                    </span>
                                  </td>

                                  <td class="px-5 py-4">
                                    <% if (student.averageScore !== null && student.averageScore !== undefined) { %>
                                      <span class="font-semibold text-slate-950"><%= student.averageScore %>%</span>
                                    <% } else { %>
                                      <span class="text-slate-400">No score</span>
                                    <% } %>
                                  </td>
                                </tr>

                                <% if (student.submissions && student.submissions.length > 0) { %>
                                  <tr class="bg-slate-50">
                                    <td colspan="6" class="px-5 py-4">
                                      <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Scores</div>

                                      <div class="grid md:grid-cols-2 gap-2">
                                        <% student.submissions.forEach(submission => { %>
                                          <div class="bg-white border border-slate-200 rounded-lg p-3 flex items-center justify-between gap-3">
                                            <div>
                                              <div class="text-sm font-medium text-slate-900 truncate"><%= submission.testTitle %></div>
                                              <div class="text-xs text-slate-500 mt-1"><%= submission.submittedAtFormatted || '' %></div>
                                            </div>

                                            <div class="text-right shrink-0">
                                              <div class="text-lg font-semibold <%= submission.passed ? 'text-emerald-700' : 'text-red-600' %>">
                                                <%= submission.score %>%
                                              </div>
                                              <div class="text-[10px] uppercase tracking-wider text-slate-500">
                                                <%= submission.passed ? 'Passed' : 'Failed' %>
                                              </div>
                                            </div>
                                          </div>
                                        <% }) %>
                                      </div>
                                    </td>
                                  </tr>
                                <% } %>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                      <% } else { %>
                        <div class="p-8 text-center text-slate-500">
                          <i class="fa-solid fa-user-group text-3xl text-slate-300 mb-3"></i>
                          <div class="font-medium text-slate-800">No students joined yet</div>
                          <p class="text-sm mt-1">Copy the class key and send it to your students.</p>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="panel-strong rounded-2xl p-12 text-center">
                  <i class="fa-solid fa-users-rectangle text-5xl text-slate-300 mb-5"></i>
                  <div class="text-2xl font-semibold">No classes yet</div>
                  <p class="text-slate-500 mt-2">Generate your first class key to start enrolling students.</p>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <section class="view-panel hidden" data-view-panel="tasks">
          <div class="panel-strong rounded-2xl p-5 md:p-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
              <div>
                <h2 class="text-3xl font-semibold tracking-tight">Assignments</h2>
                <p class="text-slate-500 mt-1">Create new assignments from the builder, or delete existing ones here.</p>
              </div>

              <a href="/assessment" class="btn btn-primary px-5 py-3 text-sm inline-flex items-center justify-center gap-2">
                <i class="fa-solid fa-plus"></i>
                New Assignment
              </a>
            </div>

            <% if (safeTests.length > 0) { %>
              <div class="grid-safe">
                <% safeTests.forEach(task => {
                  const linkedClasses = safeClasses.filter(cls => {
                    const ids = Array.isArray(cls.assignedTestIds) ? cls.assignedTestIds.map(Number) : [];
                    return ids.includes(Number(task.id));
                  });
                %>
                  <div class="panel rounded-xl p-5 task-card" data-task-card="<%= task.id %>">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h3 class="text-lg font-semibold truncate"><%= task.title %></h3>
                        <p class="text-xs text-slate-500 mt-1"><%= task.questions ? task.questions.length : 0 %> questions</p>
                      </div>

                      <span class="px-2.5 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-medium shrink-0">
                        Assignment
                      </span>
                    </div>

                    <div class="mt-4">
                      <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Assigned Classes</div>
                      <% if (linkedClasses.length > 0) { %>
                        <div class="flex flex-wrap gap-2">
                          <% linkedClasses.forEach(cls => { %>
                            <button type="button" onclick="selectClass('<%= cls.id %>')" class="px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs font-medium text-slate-700 max-w-full truncate">
                              <%= cls.className %>
                            </button>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <div class="text-sm text-slate-500">Not assigned to a class yet.</div>
                      <% } %>
                    </div>

                    <form action="/delete-test" method="POST" class="mt-5" onsubmit="return confirm('Delete this assignment completely?');">
                      <input type="hidden" name="testId" value="<%= task.id %>">
                      <button type="submit" class="btn btn-red w-full py-3 text-sm">
                        Delete Assignment
                      </button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="border border-dashed border-slate-300 rounded-xl p-12 text-center">
                <i class="fa-solid fa-clipboard-question text-4xl text-slate-300 mb-4"></i>
                <div class="font-medium">No assignments yet</div>
                <p class="text-sm text-slate-500 mt-1">Create an assessment first.</p>
              </div>
            <% } %>
          </div>
        </section>

