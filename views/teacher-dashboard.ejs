        subtitle: 'Diagonal heritage corners',
        accent: '#6b1531',
        secondary: '#c6a45d',
        paper: '#fffafb',
        border: '6px double #6b1531'
      },
      {
        className: 'tpl-platinum',
        name: 'Digital Platinum',
        subtitle: 'Circuit grid credential',
        accent: '#334155',
        secondary: '#8ea2b7',
        paper: '#f1f5f9',
        border: '3px solid #334155'
      },
      {
        className: 'tpl-midnight',
        name: 'Midnight Prestige',
        subtitle: 'Dark luxury presentation',
        accent: '#d7b76d',
        secondary: '#8ab4ff',
        paper: '#0f172a',
