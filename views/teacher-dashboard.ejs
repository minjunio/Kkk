                    class="panel rounded-xl p-5 task-card"
                    data-task-card="<%= test.id %>"
                  >
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h3 class="text-lg font-semibold break-anywhere">
                          <%= test.title %>
