              <h3 class="text-2xl font-semibold">Post Global Announcement</h3>
              <p class="text-sm text-slate-500 mt-1 mb-6">
                Global announcements appear for students generally. For class-only posts, use the selected class panel.
              </p>

              <form action="/post-event" method="POST" class="space-y-5">
                <input type="text" name="title" placeholder="Winter Skill Challenge 2026" class="input px-4 py-3 rounded-lg font-medium" required>

                <textarea name="description" placeholder="Complete 3 badges to earn recognition." class="input px-4 py-3 rounded-lg h-24 text-sm"></textarea>

                <select name="specialBadgeId" class="input px-4 py-3 rounded-lg font-medium">
                  <option value="">No special badge attached</option>
                  <% safeBadges.forEach(b => { %>
                    <option value="<%= b.id || b.templateId %>"><%= b.title %></option>
                  <% }) %>
                </select>

                <button type="submit" class="btn btn-purple w-full py-4">
                  Publish Announcement
                </button>
              </form>
            </div>

            <div class="panel-strong rounded-2xl p-5 md:p-6">
              <h3 class="text-2xl font-semibold mb-5">Global Announcements</h3>

              <% if (safeEvents.length > 0) { %>
                <div class="space-y-3 max-h-[30rem] overflow-y-auto custom-scroll pr-1">
                  <% safeEvents.slice().reverse().forEach(e => { %>
                    <div class="bg-white border border-slate-200 rounded-lg p-5">
                      <div class="font-medium break-words"><%= e.title %></div>
                      <p class="text-sm text-slate-500 mt-1 break-words"><%= e.description || 'No description.' %></p>
