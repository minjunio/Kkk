<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Teacher Dashboard • Credity</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Space+Grotesk:wght@500;700&family=Cinzel:wght@500;700&family=Montserrat:wght@400;500;600;700&family=Pinyon+Script&display=swap');

    * { box-sizing: border-box; }

    body {
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: #f6f7f9;
      color: #0f172a;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .panel-strong {
      background: #fff;
      border: 1px solid #dbe1ea;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.045);
    }

    .input {
      background: #fff;
      border: 1px solid #d8dee8;
      transition: border-color .18s ease, box-shadow .18s ease;
    }

    .input:focus {
      border-color: #2563eb;
      outline: none;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
    }

    .btn {
      font-weight: 500;
      border-radius: 12px;
      transition: background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;
    }

    .btn:active { transform: translateY(1px); }

    .btn-primary {
      background: #1d4ed8;
      color: #fff;
      border: 1px solid #1d4ed8;
    }

    .btn-primary:hover {
      background: #1e40af;
      border-color: #1e40af;
    }

    .btn-dark {
      background: #111827;
      color: #fff;
      border: 1px solid #111827;
    }

    .btn-dark:hover {
      background: #030712;
      border-color: #030712;
    }

    .btn-light {
      background: #fff;
      color: #111827;
      border: 1px solid #d8dee8;
    }

    .btn-light:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .btn-green {
      background: #059669;
      color: #fff;
      border: 1px solid #059669;
    }

    .btn-green:hover {
      background: #047857;
      border-color: #047857;
    }

    .btn-purple {
      background: #7c3aed;
      color: #fff;
      border: 1px solid #7c3aed;
    }

    .btn-purple:hover {
      background: #6d28d9;
      border-color: #6d28d9;
    }

    .side-link {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      color: #475569;
      font-size: 14px;
      font-weight: 500;
      transition: all .16s ease;
    }

    .side-link:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    .side-link.active {
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
    }

    .class-link.active,
    .task-link.active {
      background: #111827;
      color: #fff;
      border-color: #111827;
    }

    .custom-scroll::-webkit-scrollbar {
      height: 6px;
      width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
      background: #eef2f7;
      border-radius: 999px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
      background: #c8d0dc;
      border-radius: 999px;
    }

    .font-signature { font-family: 'Pinyon Script', cursive; }

    .cert-container {
      container-type: inline-size;
      perspective: 1000px;
    }

    .certificate-preview {
      background: white;
      box-shadow: 0 18px 44px rgba(15, 23, 42, .16);
      transition: all .3s ease;
      position: relative;
      overflow: hidden;
      transform-style: preserve-3d;
      display: flex;
      flex-direction: column;
      color: #1e293b;
    }

    .cert-wave-watermark {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      opacity: .13;
      background:
        radial-gradient(circle at 25% 18%, rgba(37, 99, 235, .16), transparent 30%),
        radial-gradient(circle at 80% 74%, rgba(124, 58, 237, .14), transparent 32%);
    }

    .cert-wave-watermark::before {
      content: '';
      position: absolute;
      left: -10%;
      right: -10%;
      top: 35%;
      height: 38%;
      background:
        url("data:image/svg+xml,%3Csvg width='900' height='260' viewBox='0 0 900 260' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 140 C120 40 210 40 330 140 S540 240 660 140 S780 40 900 140' fill='none' stroke='%232563eb' stroke-width='18' stroke-linecap='round' opacity='.42'/%3E%3Cpath d='M0 190 C120 90 210 90 330 190 S540 290 660 190 S780 90 900 190' fill='none' stroke='%237c3aed' stroke-width='12' stroke-linecap='round' opacity='.28'/%3E%3C/svg%3E")
        center / cover no-repeat;
      transform: rotate(-8deg);
    }

    .draggable-logo {
      position: absolute;
      cursor: grab;
      z-index: 80;
      width: 8.5cqi;
      height: 8.5cqi;
      min-width: 28px;
      min-height: 28px;
      mix-blend-mode: multiply;
      pointer-events: auto;
    }

    .draggable-logo:active { cursor: grabbing; }

    .draggable-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      pointer-events: none;
      user-select: none;
    }

    .tpl-1-degree {
      font-family: 'Cinzel', serif;
      border: 2.5cqw solid #1e293b;
      outline: .6cqw solid #1e293b;
      outline-offset: -1.2cqw;
      background: linear-gradient(#fffdf8, #fefaf0);
      box-shadow: inset 0 0 0 1.5cqw #f8f1e3, inset 0 0 90px rgba(180, 83, 9, .07);
    }

    .tpl-1-degree::before {
      content: '';
      position: absolute;
      inset: 1.6cqw;
      border: .45cqw solid #1e293b;
      opacity: .12;
      pointer-events: none;
      z-index: 2;
    }

    .tpl-1-degree .cert-title {
      font-size: 4.4cqi;
      color: #1e293b;
      font-weight: 700;
      border-bottom: 2.5px solid #b45309;
      padding-bottom: 1.4cqw;
      display: inline-block;
      letter-spacing: .02em;
    }

    .tpl-2-university {
      font-family: 'Playfair Display', serif;
      border: 3cqw solid #1e293b;
      background: #fff;
    }

    .tpl-2-university .cert-title {
      font-size: 3.8cqi;
      text-transform: uppercase;
      letter-spacing: .25em;
      color: #1e293b;
    }

    .tpl-3-corporate {
      font-family: 'Montserrat', sans-serif;
      border-top: 5.5cqw solid #1e293b;
      border-bottom: 1.8cqw solid #1e293b;
      background: #fff;
    }

    .tpl-3-corporate .cert-title {
      font-size: 3.5cqi;
      font-weight: 700;
      letter-spacing: .12em;
      color: #1e293b;
    }

    .tpl-4-tech {
      font-family: 'Space Grotesk', sans-serif;
      border: .6cqw solid #1e293b;
      background: #fff;
      background-image:
        linear-gradient(rgba(15,23,42,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15,23,42,.04) 1px, transparent 1px);
      background-size: 3.8cqw 3.8cqw;
    }

    .tpl-4-tech .cert-title {
      font-size: 3.5cqi;
      text-transform: uppercase;
      color: #1e293b;
      letter-spacing: .1em;
    }

    .tpl-5-scholar {
      font-family: 'Cinzel', serif;
      border: 1.6cqw solid #b45309;
      background: linear-gradient(135deg, #fffbeb, #fef3c7);
    }

    .tpl-5-scholar::after {
      content: '';
      position: absolute;
      inset: .6cqw;
      border: .35cqw solid #b45309;
      pointer-events: none;
      z-index: 2;
    }

    .tpl-5-scholar .cert-title {
      font-size: 4cqi;
      color: #92400e;
    }

    .tpl-6-minimal {
      font-family: 'Inter', sans-serif;
      border-left: 6.5cqw solid #1e293b;
      background: #f8fafc;
    }

    .tpl-6-minimal .cert-title {
      font-size: 3.6cqi;
      font-weight: 600;
      text-align: left;
      color: #1e293b;
    }

    .tpl-7-dark {
      font-family: 'Space Grotesk', sans-serif;
      border: .55cqw solid #334155;
      background: radial-gradient(circle at 50% 0%, #1e293b, #0f172a);
      color: #f8fafc !important;
    }

    .tpl-7-dark .cert-title,
    .tpl-7-dark .cert-text-color {
      color: white !important;
    }

    .tpl-7-dark .draggable-logo {
      mix-blend-mode: normal;
      filter: drop-shadow(0 0 6px rgba(255,255,255,.55));
    }

    .shape-circle { border-radius: 50%; }
    .shape-shield { clip-path: polygon(50% 100%, 0 80%, 0 0, 100% 0, 100% 80%); }
    .shape-hexagon { clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); }
    .shape-diamond { clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); }
    .shape-star { clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
  </style>
</head>

<body>
  <%
    const safeBadges = typeof badges !== 'undefined' && Array.isArray(badges) ? badges : [];
    const safeTests = typeof tests !== 'undefined' && Array.isArray(tests) ? tests : [];
    const safeEvents = typeof events !== 'undefined' && Array.isArray(events) ? events : [];
    const safeClasses = typeof classes !== 'undefined' && Array.isArray(classes)
      ? classes
      : (typeof studentKeys !== 'undefined' && Array.isArray(studentKeys) ? studentKeys : []);

    const teacherName = user && user.name ? user.name : 'Teacher';
    const firstName = teacherName.split(' ')[0];

    const totalStudents = safeClasses.reduce((sum, c) => {
      if (Array.isArray(c.students)) return sum + c.students.length;
      return sum + Number(c.usageCount || 0);
    }, 0);

    const totalSubmissions = typeof submissions !== 'undefined' && Array.isArray(submissions)
      ? submissions.length
      : safeClasses.reduce((sum, c) => sum + Number(c.submissionCount || 0), 0);

    function assignedForClass(cls) {
      return Array.isArray(cls.assignedTests)
        ? cls.assignedTests
        : safeTests.filter(t => Array.isArray(cls.assignedTestIds) && cls.assignedTestIds.map(Number).includes(Number(t.id)));
    }

    function firstClassId() {
      return safeClasses.length > 0 ? String(safeClasses[0].id) : '';
    }
  %>

  <div class="min-h-screen flex">
    <aside class="hidden xl:flex w-80 shrink-0 border-r border-slate-200 bg-white min-h-screen sticky top-0">
      <div class="w-full h-screen overflow-y-auto custom-scroll p-5 flex flex-col">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-semibold text-xl">C</span>
          </div>
          <div>
            <div class="font-semibold text-xl leading-none">Credity</div>
            <div class="text-[11px] text-slate-500 uppercase tracking-wider mt-1">Teacher Dashboard</div>
          </div>
        </div>

        <div class="panel rounded-xl p-4 mb-5">
          <div class="text-sm font-semibold"><%= teacherName %></div>
          <div class="text-xs text-slate-500 mt-1">Teacher workspace</div>
        </div>

        <nav class="space-y-1 mb-6">
          <button class="side-link active" data-view-link="overview" onclick="showView('overview')">
            <i class="fa-solid fa-gauge-high w-5"></i>
            Overview
          </button>
          <button class="side-link" data-view-link="classes" onclick="showView('classes')">
            <i class="fa-solid fa-users-rectangle w-5"></i>
            Classes
          </button>
          <button class="side-link" data-view-link="tasks" onclick="showView('tasks')">
            <i class="fa-solid fa-clipboard-question w-5"></i>
            Task Bar
          </button>
          <button class="side-link" data-view-link="credentials" onclick="showView('credentials')">
            <i class="fa-solid fa-certificate w-5"></i>
            Certificates
          </button>
          <button class="side-link" data-view-link="badges" onclick="showView('badges')">
            <i class="fa-solid fa-award w-5"></i>
            Badges
          </button>
          <button class="side-link" data-view-link="announcements" onclick="showView('announcements')">
            <i class="fa-solid fa-bullhorn w-5"></i>
            Announcements
          </button>
        </nav>

        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Classes</div>
            <span class="text-xs text-slate-400"><%= safeClasses.length %></span>
          </div>

          <div class="space-y-2">
            <% if (safeClasses.length > 0) { %>
              <% safeClasses.forEach((cls, idx) => {
                const cTasks = assignedForClass(cls);
                const cStudents = Array.isArray(cls.students) ? cls.students : [];
              %>
                <button
                  type="button"
                  class="class-link w-full text-left px-3 py-3 border border-slate-200 rounded-xl bg-white hover:bg-slate-50 transition <%= idx === 0 ? 'active' : '' %>"
                  data-class-button="<%= cls.id %>"
                  onclick="selectClass('<%= cls.id %>')">
                  <div class="flex items-center justify-between gap-2">
                    <div class="text-sm font-medium truncate"><%= cls.className %></div>
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 border border-slate-200"><%= cTasks.length %></span>
                  </div>
                  <div class="text-xs opacity-70 mt-1"><%= cStudents.length || cls.usageCount || 0 %> students</div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="text-sm text-slate-500 border border-dashed border-slate-300 rounded-xl p-4 text-center">
                No classes yet
              </div>
            <% } %>
          </div>
        </div>

        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Task Bar</div>
            <span class="text-xs text-slate-400"><%= safeTests.length %></span>
          </div>

          <div class="space-y-2 max-h-72 overflow-y-auto custom-scroll pr-1">
            <% if (safeTests.length > 0) { %>
              <% safeTests.forEach((task, idx) => { %>
                <button
                  type="button"
                  class="task-link w-full text-left px-3 py-3 border border-slate-200 rounded-xl bg-white hover:bg-slate-50 transition"
                  data-task-button="<%= task.id %>"
                  onclick="selectTask('<%= task.id %>')">
                  <div class="text-sm font-medium truncate"><%= task.title %></div>
                  <div class="text-xs opacity-70 mt-1"><%= task.questions ? task.questions.length : 0 %> questions</div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="text-sm text-slate-500 border border-dashed border-slate-300 rounded-xl p-4 text-center">
                No tasks yet
              </div>
            <% } %>
          </div>
        </div>

        <div class="mt-auto space-y-2">
          <a href="/assessment" class="btn btn-primary w-full py-3 text-sm flex items-center justify-center gap-2">
            <i class="fa-solid fa-plus"></i>
            Create Assessment
          </a>
          <a href="/logout" class="btn btn-light w-full py-3 text-sm flex items-center justify-center gap-2">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            Logout
          </a>
        </div>
      </div>
    </aside>

    <main class="flex-1 min-w-0">
      <nav class="xl:hidden bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="px-4 sm:px-6 py-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
              <span class="text-white font-semibold text-xl">C</span>
            </div>
            <div>
              <div class="font-semibold text-xl leading-none">Credity</div>
              <div class="text-[11px] text-slate-500 uppercase tracking-wider mt-1">Teacher</div>
            </div>
          </div>
          <a href="/logout" class="btn btn-light px-4 py-2 text-sm">Logout</a>
        </div>
      </nav>

      <div class="max-w-[92rem] mx-auto px-4 sm:px-6 py-8">
        <section class="mb-8 view-panel" data-view-panel="overview">
          <div class="panel-strong rounded-2xl p-6 md:p-9">
            <div class="grid xl:grid-cols-12 gap-8 items-center">
              <div class="xl:col-span-7">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-blue-50 text-blue-700 text-xs font-medium tracking-[1.5px] rounded-lg border border-blue-100 mb-5">
                  <i class="fa-solid fa-chart-simple"></i>
                  <span>TEACHER ACTION CENTER</span>
                </div>

                <h1 class="text-4xl md:text-6xl font-semibold tracking-tighter text-slate-950 leading-none">
                  Welcome back, <%= firstName %>.
                </h1>

                <p class="mt-5 text-lg md:text-xl text-slate-600 max-w-3xl leading-relaxed">
                  Use the side dashboard to click a class, view its tasks, students, scores, submissions, and announcements.
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                  <a href="/assessment" class="btn btn-primary inline-flex items-center justify-center gap-3 px-7 py-4">
                    <i class="fa-solid fa-file-circle-plus"></i>
                    Create Assessment
                  </a>

                  <button onclick="showView('classes')" class="btn btn-light inline-flex items-center justify-center gap-3 px-7 py-4">
                    <i class="fa-solid fa-users-rectangle text-emerald-600"></i>
                    Manage Classes
                  </button>

                  <button onclick="showView('credentials')" class="btn btn-light inline-flex items-center justify-center gap-3 px-7 py-4">
                    <i class="fa-solid fa-certificate text-blue-600"></i>
                    Design Credential
                  </button>
                </div>
              </div>

              <div class="xl:col-span-5">
                <div class="grid grid-cols-2 gap-4">
                  <div class="panel rounded-xl p-5">
                    <div class="w-10 h-10 bg-emerald-50 text-emerald-700 rounded-lg flex items-center justify-center mb-4 border border-emerald-100">
                      <i class="fa-solid fa-users-rectangle"></i>
                    </div>
                    <div class="text-4xl font-semibold"><%= safeClasses.length %></div>
                    <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Classes</div>
                  </div>

                  <div class="panel rounded-xl p-5">
                    <div class="w-10 h-10 bg-blue-50 text-blue-700 rounded-lg flex items-center justify-center mb-4 border border-blue-100">
                      <i class="fa-solid fa-clipboard-question"></i>
                    </div>
                    <div class="text-4xl font-semibold"><%= safeTests.length %></div>
                    <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Assessments</div>
                  </div>

                  <div class="panel rounded-xl p-5">
                    <div class="w-10 h-10 bg-violet-50 text-violet-700 rounded-lg flex items-center justify-center mb-4 border border-violet-100">
                      <i class="fa-solid fa-user-group"></i>
                    </div>
                    <div class="text-4xl font-semibold"><%= totalStudents %></div>
                    <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Students</div>
                  </div>

                  <div class="panel rounded-xl p-5">
                    <div class="w-10 h-10 bg-amber-50 text-amber-700 rounded-lg flex items-center justify-center mb-4 border border-amber-100">
                      <i class="fa-solid fa-square-poll-vertical"></i>
                    </div>
                    <div class="text-4xl font-semibold"><%= totalSubmissions %></div>
                    <div class="text-xs font-medium text-slate-500 uppercase tracking-wider">Submissions</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="view-panel hidden" data-view-panel="classes">
          <div class="grid xl:grid-cols-12 gap-8">
            <div class="xl:col-span-4 panel-strong rounded-2xl p-6 md:p-8 h-fit">
              <h3 class="text-2xl font-semibold">Create Class Key</h3>
              <p class="text-sm text-slate-500 mt-1 mb-6">
                Create a class, then students join with its key. You can assign assessments after.
              </p>

              <form action="/generate-student-key" method="POST" class="space-y-5">
                <div>
                  <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Class Name</label>
                  <input type="text" name="className" placeholder="Grade 10A - Python" class="input w-full px-4 py-3 rounded-lg font-medium" required>
                </div>

                <button type="submit" class="btn btn-green w-full py-4">
                  Generate Class Key
                </button>
              </form>

              <div class="mt-6 p-5 bg-emerald-50 border border-emerald-100 rounded-xl">
                <div class="font-semibold text-emerald-800">Class flow</div>
                <ol class="text-sm text-emerald-700 mt-2 space-y-1 list-decimal list-inside">
                  <li>Create a class key.</li>
                  <li>Student joins the class.</li>
                  <li>Assign tests from the class panel.</li>
                  <li>View scores and submissions.</li>
                </ol>
              </div>
            </div>

            <div class="xl:col-span-8 space-y-5">
              <% if (safeClasses.length > 0) { %>
                <% safeClasses.forEach((cls, idx) => {
                  const assignedTests = assignedForClass(cls);
                  const classAnnouncements = Array.isArray(cls.announcements) ? cls.announcements : [];
                  const students = Array.isArray(cls.students) ? cls.students : [];
                  const results = Array.isArray(cls.results) ? cls.results : [];
                %>
                  <div class="class-panel panel-strong rounded-2xl p-6 md:p-7 <%= idx === 0 ? '' : 'hidden' %>" data-class-panel="<%= cls.id %>">
                    <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-5">
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <h3 class="text-3xl font-semibold text-slate-950"><%= cls.className %></h3>
                          <span class="text-[10px] font-medium px-3 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700">
                            <%= cls.active === false ? 'DISABLED' : 'ACTIVE' %>
                          </span>
                        </div>

                        <div class="text-sm text-slate-500 mt-1">
                          <%= students.length || cls.usageCount || 0 %> students joined • <%= assignedTests.length %> tasks • <%= results.length %> submissions
                        </div>
                      </div>

                      <div class="flex items-center gap-2">
                        <code class="px-3 py-2 bg-slate-50 border border-slate-200 text-slate-900 rounded-lg text-xs font-semibold tracking-wider"><%= cls.key %></code>
                        <button type="button" onclick="copyText('<%= cls.key %>')" class="btn btn-dark px-3 py-2 text-xs">
                          Copy
                        </button>
                      </div>
                    </div>

                    <div class="grid md:grid-cols-3 gap-3 mt-6">
                      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
                        <div class="text-xs text-slate-500 font-medium uppercase tracking-wider">Students</div>
                        <div class="text-3xl font-semibold mt-1"><%= students.length || cls.usageCount || 0 %></div>
                      </div>

                      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
                        <div class="text-xs text-slate-500 font-medium uppercase tracking-wider">Tasks</div>
                        <div class="text-3xl font-semibold mt-1"><%= assignedTests.length %></div>
                      </div>

                      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
                        <div class="text-xs text-slate-500 font-medium uppercase tracking-wider">Submissions</div>
                        <div class="text-3xl font-semibold mt-1"><%= results.length %></div>
                      </div>
                    </div>

                    <div class="grid lg:grid-cols-2 gap-5 mt-6">
                      <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
                        <div class="flex items-center justify-between gap-3 mb-4">
                          <div>
                            <div class="font-semibold">Assign Assessment</div>
                            <p class="text-xs text-slate-500 mt-1">Assign a test to this exact class.</p>
                          </div>

                          <a href="/assessment" class="btn btn-primary text-xs px-3 py-2">New Test</a>
                        </div>

                        <form action="/assign-class-test" method="POST" class="flex flex-col sm:flex-row gap-2">
                          <input type="hidden" name="classId" value="<%= cls.id %>">

                          <select name="testId" class="input flex-1 px-4 py-3 rounded-lg text-sm font-medium" required>
                            <option value="">Select assessment...</option>
                            <% safeTests.forEach(t => { %>
                              <option value="<%= t.id %>"><%= t.title %></option>
                            <% }) %>
                          </select>

                          <button type="submit" class="btn btn-dark px-5 py-3 text-sm">Assign</button>
                        </form>

                        <div class="mt-4">
                          <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Class Tasks</div>

                          <% if (assignedTests.length > 0) { %>
                            <div class="space-y-2">
                              <% assignedTests.forEach(t => { %>
                                <div class="flex items-center justify-between gap-3 bg-white border border-slate-200 rounded-lg p-3 task-row" data-task-row="<%= t.id %>">
                                  <div>
                                    <div class="text-sm font-medium"><%= t.title %></div>
                                    <div class="text-xs text-slate-500"><%= t.questions ? t.questions.length : 0 %> questions</div>
                                  </div>

                                  <form action="/unassign-class-test" method="POST">
                                    <input type="hidden" name="classId" value="<%= cls.id %>">
                                    <input type="hidden" name="testId" value="<%= t.id %>">
                                    <button type="submit" class="text-xs font-medium text-red-500 hover:text-red-600">Remove</button>
                                  </form>
                                </div>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <div class="text-sm text-slate-500 bg-white border border-dashed border-slate-300 rounded-lg p-4 text-center">
                              No tasks assigned to this class.
                            </div>
                          <% } %>
                        </div>
                      </div>

                      <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
                        <div class="font-semibold">Class Announcement</div>
                        <p class="text-xs text-slate-500 mt-1 mb-4">Only students in this class see this.</p>

                        <form action="/class-announcement" method="POST" class="space-y-3">
                          <input type="hidden" name="classId" value="<%= cls.id %>">

                          <input type="text" name="title" placeholder="Announcement title" class="input w-full px-4 py-3 rounded-lg text-sm font-medium" required>
                          <textarea name="description" placeholder="Write the announcement..." class="input w-full px-4 py-3 rounded-lg h-20 text-sm"></textarea>

                          <button type="submit" class="btn btn-purple w-full py-3 text-sm">Post to Class</button>
                        </form>

                        <div class="mt-4">
                          <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Recent Announcements</div>

                          <% if (classAnnouncements.length > 0) { %>
                            <div class="space-y-2 max-h-44 overflow-y-auto custom-scroll pr-1">
                              <% classAnnouncements.slice().reverse().forEach(a => { %>
                                <div class="bg-white border border-slate-200 rounded-lg p-3">
                                  <div class="text-sm font-medium"><%= a.title %></div>
                                  <div class="text-xs text-slate-500 mt-1"><%= a.description || 'No description.' %></div>
                                </div>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <div class="text-sm text-slate-500 bg-white border border-dashed border-slate-300 rounded-lg p-4 text-center">
                              No announcements yet.
                            </div>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="mt-6 bg-white border border-slate-200 rounded-xl overflow-hidden">
                      <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                        <div class="font-semibold">Student Roster & Scores</div>
                        <div class="text-xs text-slate-500 mt-1">Full name, email, completed tests, pending tasks, and scores.</div>
                      </div>

                      <% if (students.length > 0) { %>
                        <div class="overflow-x-auto custom-scroll">
                          <table class="w-full text-left text-sm">
                            <thead>
                              <tr class="border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500 bg-white">
                                <th class="px-5 py-3 font-medium">Student</th>
                                <th class="px-5 py-3 font-medium">Email</th>
                                <th class="px-5 py-3 font-medium">Joined</th>
                                <th class="px-5 py-3 font-medium">Completed</th>
                                <th class="px-5 py-3 font-medium">Pending</th>
                                <th class="px-5 py-3 font-medium">Average</th>
                              </tr>
                            </thead>

                            <tbody class="divide-y divide-slate-100">
                              <% students.forEach(student => { %>
                                <tr class="hover:bg-slate-50">
                                  <td class="px-5 py-4">
                                    <div class="font-medium text-slate-950"><%= student.fullName %></div>
                                    <div class="text-xs text-slate-500">ID: <%= student.userId %></div>
                                  </td>
                                  <td class="px-5 py-4 text-slate-600"><%= student.email %></td>
                                  <td class="px-5 py-4 text-slate-600 whitespace-nowrap"><%= student.joinedAtFormatted || '—' %></td>
                                  <td class="px-5 py-4">
                                    <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700 text-xs font-medium"><%= student.completedCount || 0 %></span>
                                  </td>
                                  <td class="px-5 py-4">
                                    <span class="px-2.5 py-1 rounded-full bg-amber-50 border border-amber-100 text-amber-700 text-xs font-medium"><%= student.pendingCount || 0 %></span>
                                  </td>
                                  <td class="px-5 py-4">
                                    <% if (student.averageScore !== null && student.averageScore !== undefined) { %>
                                      <span class="font-semibold text-slate-950"><%= student.averageScore %>%</span>
                                    <% } else { %>
                                      <span class="text-slate-400">No score</span>
                                    <% } %>
                                  </td>
                                </tr>

                                <% if (student.submissions && student.submissions.length > 0) { %>
                                  <tr class="bg-slate-50">
                                    <td colspan="6" class="px-5 py-4">
                                      <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Scores</div>

                                      <div class="grid md:grid-cols-2 gap-2">
                                        <% student.submissions.forEach(submission => { %>
                                          <div class="bg-white border border-slate-200 rounded-lg p-3 flex items-center justify-between gap-3">
                                            <div>
                                              <div class="text-sm font-medium text-slate-900"><%= submission.testTitle %></div>
                                              <div class="text-xs text-slate-500 mt-1"><%= submission.submittedAtFormatted || '' %></div>
                                            </div>

                                            <div class="text-right">
                                              <div class="text-lg font-semibold <%= submission.passed ? 'text-emerald-700' : 'text-red-600' %>"><%= submission.score %>%</div>
                                              <div class="text-[10px] uppercase tracking-wider text-slate-500"><%= submission.passed ? 'Passed' : 'Failed' %></div>
                                            </div>
                                          </div>
                                        <% }) %>
                                      </div>
                                    </td>
                                  </tr>
                                <% } %>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                      <% } else { %>
                        <div class="p-8 text-center text-slate-500">
                          <i class="fa-solid fa-user-group text-3xl text-slate-300 mb-3"></i>
                          <div class="font-medium text-slate-800">No students joined yet</div>
                          <p class="text-sm mt-1">Copy the class key and send it to your students.</p>
                        </div>
                      <% } %>
                    </div>

                    <div class="mt-6 bg-white border border-slate-200 rounded-xl overflow-hidden">
                      <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                        <div class="font-semibold">Recent Submissions</div>
                        <div class="text-xs text-slate-500 mt-1">Latest scores submitted in this class.</div>
                      </div>

                      <% if (results.length > 0) { %>
                        <div class="overflow-x-auto custom-scroll">
                          <table class="w-full text-left text-sm">
                            <thead>
                              <tr class="border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500 bg-white">
                                <th class="px-5 py-3 font-medium">Student</th>
                                <th class="px-5 py-3 font-medium">Email</th>
                                <th class="px-5 py-3 font-medium">Assessment</th>
                                <th class="px-5 py-3 font-medium">Score</th>
                                <th class="px-5 py-3 font-medium">Status</th>
                                <th class="px-5 py-3 font-medium">Submitted</th>
                              </tr>
                            </thead>

                            <tbody class="divide-y divide-slate-100">
                              <% results.forEach(result => { %>
                                <tr class="hover:bg-slate-50">
                                  <td class="px-5 py-4 font-medium text-slate-950"><%= result.studentName %></td>
                                  <td class="px-5 py-4 text-slate-600"><%= result.studentEmail %></td>
                                  <td class="px-5 py-4 text-slate-600"><%= result.testTitle %></td>
                                  <td class="px-5 py-4 font-semibold"><%= result.score %>%</td>
                                  <td class="px-5 py-4">
                                    <% if (result.passed) { %>
                                      <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700 text-xs font-medium">Passed</span>
                                    <% } else { %>
                                      <span class="px-2.5 py-1 rounded-full bg-red-50 border border-red-100 text-red-700 text-xs font-medium">Failed</span>
                                    <% } %>
                                  </td>
                                  <td class="px-5 py-4 text-slate-500 whitespace-nowrap"><%= result.submittedAtFormatted || '—' %></td>
                                </tr>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                      <% } else { %>
                        <div class="p-8 text-center text-slate-500">
                          <i class="fa-solid fa-chart-simple text-3xl text-slate-300 mb-3"></i>
                          <div class="font-medium text-slate-800">No submissions yet</div>
                          <p class="text-sm mt-1">Scores will appear here when students submit assigned assessments.</p>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="panel-strong rounded-2xl p-12 text-center">
                  <i class="fa-solid fa-users-rectangle text-5xl text-slate-300 mb-5"></i>
                  <div class="text-2xl font-semibold">No classes yet</div>
                  <p class="text-slate-500 mt-2">Generate your first class key to start enrolling students.</p>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <section class="view-panel hidden" data-view-panel="tasks">
          <div class="panel-strong rounded-2xl p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
              <div>
                <h2 class="text-3xl font-semibold tracking-tight">Task Bar</h2>
                <p class="text-slate-500 mt-1">Click a task from the side bar to quickly highlight it inside the selected class.</p>
              </div>
              <a href="/assessment" class="btn btn-primary px-5 py-3 text-sm inline-flex items-center gap-2">
                <i class="fa-solid fa-plus"></i>
                Create Task
              </a>
            </div>

            <% if (safeTests.length > 0) { %>
              <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
                <% safeTests.forEach(task => { 
                  const linkedClasses = safeClasses.filter(cls => {
                    const ids = Array.isArray(cls.assignedTestIds) ? cls.assignedTestIds.map(Number) : [];
                    return ids.includes(Number(task.id));
                  });
                %>
                  <div class="panel rounded-xl p-5 task-card" data-task-card="<%= task.id %>">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h3 class="text-lg font-semibold"><%= task.title %></h3>
                        <p class="text-xs text-slate-500 mt-1"><%= task.questions ? task.questions.length : 0 %> questions</p>
                      </div>
                      <span class="px-2.5 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-medium">
                        Task
                      </span>
                    </div>

                    <div class="mt-4">
                      <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Assigned Classes</div>
                      <% if (linkedClasses.length > 0) { %>
                        <div class="flex flex-wrap gap-2">
                          <% linkedClasses.forEach(cls => { %>
                            <button onclick="selectClass('<%= cls.id %>')" class="px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs font-medium text-slate-700">
                              <%= cls.className %>
                            </button>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <div class="text-sm text-slate-500">Not assigned to a class yet.</div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="border border-dashed border-slate-300 rounded-xl p-12 text-center">
                <i class="fa-solid fa-clipboard-question text-4xl text-slate-300 mb-4"></i>
                <div class="font-medium">No tasks yet</div>
                <p class="text-sm text-slate-500 mt-1">Create an assessment first.</p>
              </div>
            <% } %>
          </div>
        </section>

        <section class="view-panel hidden" data-view-panel="credentials">
          <form id="certificateForm" action="/create-credential" method="POST" class="flex flex-col xl:flex-row gap-8">
            <input type="hidden" name="type" value="certificate">
            <input type="hidden" name="templateStyle" id="selected-certificate-template" value="tpl-1-degree">
            <div id="certificate-hidden-logos"></div>

            <div class="xl:w-3/5 panel-strong p-6 md:p-8 rounded-2xl space-y-6">
              <div>
                <h3 class="text-2xl font-semibold">Certificate Designer</h3>
                <p class="text-sm text-slate-500 mt-1">Certificates can be standalone or optionally linked to an assessment.</p>
              </div>

              <div class="bg-blue-50 p-5 rounded-xl border border-blue-100">
                <label class="text-xs font-medium text-blue-800 uppercase tracking-wider block mb-2">Optional Assessment Link</label>
                <select name="assessmentId" class="input w-full px-4 py-3 rounded-lg text-sm font-medium bg-white">
                  <option value="">Standalone certificate — no assessment</option>
                  <% safeTests.forEach(t => { %>
                    <option value="<%= t.id %>"><%= t.title %></option>
                  <% }) %>
                </select>
              </div>

              <div class="grid md:grid-cols-3 gap-4 p-4 border border-slate-200 rounded-xl bg-slate-50">
                <div>
                  <label class="text-[10px] font-medium text-slate-500 uppercase tracking-wider block mb-2">Preview Student</label>
                  <input type="text" id="cert-student" value="Alex Rivera" oninput="updateCert()" class="input w-full px-3 py-2 rounded-lg text-sm">
                </div>

                <div>
                  <label class="text-[10px] font-medium text-slate-500 uppercase tracking-wider block mb-2">Signature</label>
                  <input type="text" name="signature" id="cert-signature" value="<%= teacherName %>" oninput="updateCert()" class="input w-full px-3 py-2 rounded-lg text-sm">
                </div>

                <div>
                  <label class="text-[10px] font-medium text-slate-500 uppercase tracking-wider block mb-2">Issue Date Preview</label>
                  <input type="date" id="cert-date" oninput="updateCert()" class="input w-full px-3 py-2 rounded-lg text-sm">
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-5">
                <div>
                  <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-2">Certificate Title</label>
                  <input type="text" name="title" id="cert-title" value="Certificate of Achievement" oninput="updateCert()" class="input w-full px-4 py-3 rounded-lg text-sm font-medium" required>
                </div>

                <div>
                  <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-2">Primary Color</label>
                  <input type="color" name="designColor" id="cert-color" value="#1e293b" oninput="updateCert()" class="w-full h-11 p-0 border-0 rounded-lg cursor-pointer">
                </div>
              </div>

              <div>
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-2">Description</label>
                <textarea name="description" id="cert-desc" oninput="updateCert()" class="input w-full px-4 py-3 rounded-lg h-24 text-sm" required>has successfully completed the required learning experience and demonstrated strong understanding of the subject.</textarea>
              </div>

              <div>
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-3">Templates</label>
                <div id="template-grid" class="flex gap-2 overflow-x-auto pb-4 custom-scroll snap-x"></div>
              </div>

              <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
                <div class="flex justify-between items-center mb-4">
                  <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">Logo Tools</label>
                  <button type="button" onclick="clearCertificateLogos()" class="text-xs font-medium text-red-500">Clear logos</button>
                </div>

                <div class="flex flex-col sm:flex-row gap-2 mb-4">
                  <input type="text" id="custom-logo-input" placeholder="Paste logo URL..." class="input flex-1 px-4 py-2.5 rounded-lg text-sm">
                  <button type="button" onclick="addCustomLogo()" class="btn btn-dark px-5 py-2.5 text-sm">Add Logo</button>
                </div>

                <div class="mb-4">
                  <label class="text-[10px] font-medium text-slate-500 uppercase tracking-wider block mb-2">Active Logos</label>
                  <div id="active-logos-list" class="flex flex-wrap gap-2 bg-white p-3 rounded-lg border border-slate-200 min-h-[46px]"></div>
                </div>

                <div id="logo-grid" class="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10 gap-2 max-h-44 overflow-y-auto custom-scroll p-2 bg-white border border-slate-200 rounded-lg"></div>
              </div>

              <button type="submit" class="btn btn-primary w-full py-4 text-lg">
                Create Certificate
              </button>
            </div>

            <div class="xl:w-2/5 cert-container">
              <div class="sticky top-8">
                <div class="flex justify-between items-center mb-4">
                  <h3 class="text-sm font-medium text-slate-500 uppercase tracking-wider">Live Preview</h3>
                  <div class="text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-100 px-3 py-1 rounded-full">
                    Wave watermark
                  </div>
                </div>

                <div id="cert-preview" class="certificate-preview tpl-1-degree w-full aspect-[1.414] p-[5%] flex flex-col items-center text-center">
                  <div class="cert-wave-watermark"></div>
                  <div id="drag-boundary" class="absolute inset-0 z-50 overflow-hidden pointer-events-none"></div>

                  <div class="w-full relative z-10 mt-[7%]">
                    <div class="text-[1.65cqi] tracking-[0.3em] text-slate-500 uppercase mb-[2%] cert-text-color font-semibold">
                      This certifies that
                    </div>

                    <div id="preview-student" class="text-[5.1cqi] font-semibold text-slate-900 leading-none cert-text-color mt-[2%]">
                      Alex Rivera
                    </div>
                  </div>

                  <div class="px-[7%] my-[5%] relative z-10 w-full flex-grow">
                    <div id="preview-title" class="cert-title mb-[4%] drop-shadow-sm">
                      Certificate of Achievement
                    </div>

                    <div id="preview-desc" class="text-[1.6cqi] text-slate-600 cert-text-color leading-relaxed">
                      has successfully completed the required learning experience and demonstrated strong understanding of the subject.
                    </div>
                  </div>

                  <div class="w-full flex justify-between items-end mt-auto pt-1 pb-1 relative z-10">
                    <div class="text-center border-t border-slate-400 pt-2 min-w-[13cqi]">
                      <div id="preview-signature" class="font-signature text-[3.9cqi] text-slate-800 cert-text-color leading-none mb-0.5">
                        <%= teacherName %>
                      </div>
                      <div class="text-[0.85cqi] text-slate-500 uppercase tracking-widest cert-text-color font-semibold">
                        Teacher
                      </div>
                    </div>

                    <div class="text-center border-t border-slate-400 pt-2 min-w-[13cqi]">
                      <div id="preview-date-display" class="text-[1.45cqi] font-semibold text-slate-800 cert-text-color leading-none mb-1 mt-1">
                        Date
                      </div>
                      <div class="text-[0.85cqi] text-slate-500 uppercase tracking-widest cert-text-color font-semibold">
                        Issue Date
                      </div>
                    </div>

                    <div class="flex flex-col items-center">
                      <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&amp;data=Verify" class="w-[6.6cqi] h-[6.6cqi] mb-0.5 p-0.5 bg-white border border-slate-200 shadow-sm">
                      <div class="text-[0.82cqi] text-slate-500 uppercase cert-text-color font-semibold tracking-widest">
                        Verify
                      </div>
                    </div>
                  </div>
                </div>

                <p class="text-xs text-slate-500 mt-4 leading-relaxed">
                  Logos are draggable in the preview. The QR verification link is generated when the credential is issued.
                </p>
              </div>
            </div>
          </form>
        </section>

        <section class="view-panel hidden" data-view-panel="badges">
          <form action="/create-credential" method="POST" class="flex flex-col lg:flex-row gap-8">
            <input type="hidden" name="type" value="badge">
            <input type="hidden" id="selected-badge-icon" name="badgeIcon" value="fa-shield-halved">
            <input type="hidden" id="selected-badge-shape" name="badgeShape" value="shape-shield">

            <div class="lg:w-1/2 panel-strong p-6 md:p-8 rounded-2xl space-y-6">
              <div>
                <h3 class="text-2xl font-semibold">Badge Creator</h3>
                <p class="text-sm text-slate-500 mt-1">Badges can also be standalone or linked to an assessment.</p>
              </div>

              <div class="bg-blue-50 p-5 rounded-xl border border-blue-100">
                <label class="text-xs font-medium text-blue-800 uppercase tracking-wider block mb-2">Optional Assessment Link</label>
                <select name="assessmentId" class="input w-full px-4 py-3 rounded-lg text-sm font-medium bg-white">
                  <option value="">Standalone badge — no assessment</option>
                  <% safeTests.forEach(t => { %>
                    <option value="<%= t.id %>"><%= t.title %></option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-2">Badge Title</label>
                <input type="text" name="title" id="badge-title" value="Certified Learner" oninput="updateBadge()" class="input w-full px-4 py-3 rounded-lg font-medium" required>
              </div>

              <div>
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-2">Description</label>
                <textarea name="description" class="input w-full px-4 py-3 rounded-lg h-20 text-sm">Awarded for demonstrating strong skill understanding.</textarea>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-2">Shape</label>
                  <select id="badge-shape" onchange="updateBadge()" class="input w-full px-4 py-3 rounded-lg">
                    <option value="shape-shield">Shield</option>
                    <option value="shape-hexagon">Hexagon</option>
                    <option value="shape-circle">Circle</option>
                    <option value="shape-diamond">Diamond</option>
                    <option value="shape-star">Star</option>
                  </select>
                </div>

                <div>
                  <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-2">Color</label>
                  <input type="color" name="designColor" id="badge-color" value="#0f172a" oninput="updateBadge()" class="w-full h-12 p-0 border-0 rounded-lg cursor-pointer">
                </div>
              </div>

              <div>
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider block mb-3">Icon</label>
                <div class="grid grid-cols-6 gap-2">
                  <button type="button" onclick="setBadgeIcon('fa-shield-halved')" class="btn btn-light p-3"><i class="fa-solid fa-shield-halved text-xl"></i></button>
                  <button type="button" onclick="setBadgeIcon('fa-award')" class="btn btn-light p-3"><i class="fa-solid fa-award text-xl"></i></button>
                  <button type="button" onclick="setBadgeIcon('fa-code')" class="btn btn-light p-3"><i class="fa-solid fa-code text-xl"></i></button>
                  <button type="button" onclick="setBadgeIcon('fa-bolt')" class="btn btn-light p-3"><i class="fa-solid fa-bolt text-xl"></i></button>
                  <button type="button" onclick="setBadgeIcon('fa-brain')" class="btn btn-light p-3"><i class="fa-solid fa-brain text-xl"></i></button>
                  <button type="button" onclick="setBadgeIcon('fa-graduation-cap')" class="btn btn-light p-3"><i class="fa-solid fa-graduation-cap text-xl"></i></button>
                </div>
              </div>

              <button type="submit" class="btn btn-dark w-full py-4">
                Create Badge
              </button>
            </div>

            <div class="lg:w-1/2 flex items-center justify-center bg-slate-100 rounded-2xl p-10 md:p-14 border border-slate-200 shadow-inner overflow-hidden relative">
              <div class="absolute inset-0" style="background-image: radial-gradient(#d1d5db 1px, transparent 1px); background-size: 24px 24px; opacity: .55;"></div>

              <div class="text-center w-full relative z-10 flex flex-col items-center">
                <div id="preview-badge-text" class="text-[15px] font-semibold tracking-[3px] uppercase text-slate-900 mb-7 drop-shadow-sm">
                  Certified Learner
                </div>

                <div class="badge-preview-container relative w-56 h-56 mb-8">
                  <div id="preview-badge-base" class="shape-shield w-full h-full shadow-2xl flex flex-col justify-center items-center relative" style="background: linear-gradient(145deg, #0f172a, #1e2937);">
                    <i id="preview-badge-icon" class="fa-solid fa-shield-halved text-[3.9rem] text-white mb-3 drop-shadow-xl z-20"></i>
                  </div>
                </div>

                <div class="text-xs text-slate-500 font-medium">
                  Students receive a verification QR when issued.
                </div>
              </div>
            </div>
          </form>
        </section>

        <section class="view-panel hidden" data-view-panel="announcements">
          <div class="grid xl:grid-cols-12 gap-8">
            <div class="xl:col-span-5 panel-strong rounded-2xl p-6 md:p-8">
              <h3 class="text-2xl font-semibold">Post Global Announcement</h3>
              <p class="text-sm text-slate-500 mt-1 mb-6">
                Global announcements appear for students generally. For a class-only post, use the selected class panel.
              </p>

              <form action="/post-event" method="POST" class="space-y-5">
                <input type="text" name="title" placeholder="Winter Skill Challenge 2026" class="input w-full px-4 py-3 rounded-lg font-medium" required>

                <textarea name="description" placeholder="Complete 3 badges to earn recognition." class="input w-full px-4 py-3 rounded-lg h-24 text-sm"></textarea>

                <select name="specialBadgeId" class="input w-full px-4 py-3 rounded-lg font-medium">
                  <option value="">No special badge attached</option>
                  <% safeBadges.forEach(b => { %>
                    <option value="<%= b.id || b.templateId %>"><%= b.title %></option>
                  <% }) %>
                </select>

                <button type="submit" class="btn btn-purple w-full py-4">
                  Publish Announcement
                </button>
              </form>
            </div>

            <div class="xl:col-span-7 panel-strong rounded-2xl p-6 md:p-8">
              <h3 class="text-2xl font-semibold mb-5">Global Announcements</h3>

              <% if (safeEvents.length > 0) { %>
                <div class="space-y-3 max-h-[30rem] overflow-y-auto custom-scroll pr-1">
                  <% safeEvents.slice().reverse().forEach(e => { %>
                    <div class="bg-white border border-slate-200 rounded-lg p-5">
                      <div class="font-medium"><%= e.title %></div>
                      <p class="text-sm text-slate-500 mt-1"><%= e.description || 'No description.' %></p>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="p-10 rounded-xl border border-dashed border-slate-300 text-center">
                  <i class="fa-solid fa-bullhorn text-4xl text-slate-300 mb-4"></i>
                  <div class="font-medium">No global announcements yet</div>
                </div>
              <% } %>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    const templates = [
      { id: '1-degree', name: 'Classic Degree' },
      { id: '2-university', name: 'University' },
      { id: '3-corporate', name: 'Corporate' },
      { id: '4-tech', name: 'Tech Grid' },
      { id: '5-scholar', name: 'Scholar' },
      { id: '6-minimal', name: 'Minimal' },
      { id: '7-dark', name: 'Dark Pro' }
    ];

    const presetLogos = [
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/googlecloud/googlecloud-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg'
    ];

    let currentTemplate = 'tpl-1-degree';
    let activeLogos = [];

    function initDashboard() {
      const hash = window.location.hash.replace('#', '');
      if (hash && document.querySelector(`[data-view-panel="${hash}"]`)) showView(hash);

      const dateInput = document.getElementById('cert-date');
      if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];

      renderTemplateButtons();
      renderLogoButtons();
      renderActiveLogosList();
      updateCert();
      updateBadge();
    }

    function showView(view) {
      document.querySelectorAll('.view-panel').forEach(el => el.classList.add('hidden'));
      const panel = document.querySelector(`[data-view-panel="${view}"]`);
      if (panel) panel.classList.remove('hidden');

      document.querySelectorAll('[data-view-link]').forEach(el => el.classList.remove('active'));
      const link = document.querySelector(`[data-view-link="${view}"]`);
      if (link) link.classList.add('active');

      history.replaceState(null, '', '#' + view);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function selectClass(classId) {
      showView('classes');

      document.querySelectorAll('[data-class-button]').forEach(el => el.classList.remove('active'));
      const btn = document.querySelector(`[data-class-button="${classId}"]`);
      if (btn) btn.classList.add('active');

      document.querySelectorAll('[data-class-panel]').forEach(el => el.classList.add('hidden'));
      const panel = document.querySelector(`[data-class-panel="${classId}"]`);
      if (panel) panel.classList.remove('hidden');
    }

    function selectTask(taskId) {
      showView('tasks');

      document.querySelectorAll('[data-task-button]').forEach(el => el.classList.remove('active'));
      const btn = document.querySelector(`[data-task-button="${taskId}"]`);
      if (btn) btn.classList.add('active');

      document.querySelectorAll('[data-task-card]').forEach(el => {
        el.style.outline = '';
        el.style.outlineOffset = '';
      });

      const card = document.querySelector(`[data-task-card="${taskId}"]`);
      if (card) {
        card.style.outline = '3px solid rgba(37,99,235,.25)';
        card.style.outlineOffset = '2px';
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function renderTemplateButtons() {
      const grid = document.getElementById('template-grid');
      if (!grid) return;

      grid.innerHTML = '';

      templates.forEach((t, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-light snap-start flex-shrink-0 px-4 py-2 text-sm';
        btn.innerText = t.name;
        btn.onclick = () => setTemplate(t.id, btn);

        if (i === 0) {
          btn.style.borderColor = '#2563eb';
          btn.style.background = '#eff6ff';
          btn.style.color = '#1d4ed8';
        }

        grid.appendChild(btn);
      });
    }

    function renderLogoButtons() {
      const grid = document.getElementById('logo-grid');
      if (!grid) return;

      grid.innerHTML = '';

      presetLogos.forEach(url => {
        const img = document.createElement('img');
        img.src = url;
        img.className = 'w-10 h-10 p-1.5 cursor-pointer bg-slate-50 rounded-lg border border-transparent hover:border-blue-500 object-contain';
        img.onclick = () => addLogoToDoc(url);
        grid.appendChild(img);
      });
    }

    function setTemplate(id, clickedBtn) {
      const preview = document.getElementById('cert-preview');
      if (!preview) return;

      preview.classList.remove(currentTemplate);
      currentTemplate = `tpl-${id}`;
      preview.classList.add(currentTemplate);

      const hidden = document.getElementById('selected-certificate-template');
      if (hidden) hidden.value = currentTemplate;

      document.querySelectorAll('#template-grid button').forEach(btn => {
        btn.style.borderColor = '#d8dee8';
        btn.style.background = '#ffffff';
        btn.style.color = '#111827';
      });

      clickedBtn.style.borderColor = '#2563eb';
      clickedBtn.style.background = '#eff6ff';
      clickedBtn.style.color = '#1d4ed8';

      updateCert();
    }

    function updateCert() {
      const title = document.getElementById('cert-title')?.value || 'Certificate of Achievement';
      const desc = document.getElementById('cert-desc')?.value || '';
      const color = document.getElementById('cert-color')?.value || '#1e293b';
      const student = document.getElementById('cert-student')?.value || '[Student Name]';
      const signature = document.getElementById('cert-signature')?.value || 'Authorized Signature';
      const dateVal = document.getElementById('cert-date')?.value;

      const preview = document.getElementById('cert-preview');
      if (preview) {
        preview.style.borderColor = color;
        preview.style.outlineColor = color;
      }

      const titleEl = document.getElementById('preview-title');
      const descEl = document.getElementById('preview-desc');
      const studentEl = document.getElementById('preview-student');
      const sigEl = document.getElementById('preview-signature');
      const dateEl = document.getElementById('preview-date-display');

      if (titleEl) titleEl.innerText = title;
      if (descEl) descEl.innerText = desc;
      if (studentEl) studentEl.innerText = student;
      if (sigEl) sigEl.innerText = signature;
      if (dateEl && dateVal) dateEl.innerText = new Date(dateVal).toLocaleDateString();
    }

    function addCustomLogo() {
      const input = document.getElementById('custom-logo-input');
      const url = input.value.trim();
      if (!url) return;
      addLogoToDoc(url);
      input.value = '';
    }

    function addLogoToDoc(url) {
      if (activeLogos.length >= 3) {
        alert('You can add up to 3 logos.');
        return;
      }

      const boundary = document.getElementById('drag-boundary');
      if (!boundary) return;

      const id = 'logo_' + Date.now();
      const wrapper = document.createElement('div');
      wrapper.id = id;
      wrapper.className = 'draggable-logo';
      wrapper.style.left = (8 + activeLogos.length * 10) + '%';
      wrapper.style.top = '8%';

      const img = document.createElement('img');
      img.src = url;
      img.alt = 'Certificate logo';

      img.onload = () => {
        wrapper.appendChild(img);
        boundary.appendChild(wrapper);
        makeDraggable(wrapper);
        activeLogos.push({ id, url });
        renderActiveLogosList();
        syncHiddenLogos();
      };

      img.onerror = () => alert('Logo could not load. Use a direct image URL.');
    }

    function removeLogo(id) {
      activeLogos = activeLogos.filter(l => l.id !== id);
      const el = document.getElementById(id);
      if (el) el.remove();
      renderActiveLogosList();
      syncHiddenLogos();
    }

    function clearCertificateLogos() {
      activeLogos.forEach(l => {
        const el = document.getElementById(l.id);
        if (el) el.remove();
      });
      activeLogos = [];
      renderActiveLogosList();
      syncHiddenLogos();
    }

    function renderActiveLogosList() {
      const list = document.getElementById('active-logos-list');
      if (!list) return;

      list.innerHTML = '';

      if (activeLogos.length === 0) {
        list.innerHTML = '<span class="text-xs text-slate-400 font-medium">No logos added yet.</span>';
        return;
      }

      activeLogos.forEach((logo, index) => {
        const badge = document.createElement('div');
        badge.className = 'flex items-center gap-2 bg-slate-100 pl-2 pr-1 py-1 rounded-lg text-xs font-medium border border-slate-200';
        badge.innerHTML = `
          <img src="${logo.url}" class="w-4 h-4 object-contain" alt="">
          <span>Logo ${index + 1}</span>
          <button type="button" onclick="removeLogo('${logo.id}')" class="text-red-500 hover:text-red-600 px-1">
            <i class="fa-solid fa-xmark"></i>
          </button>
        `;
        list.appendChild(badge);
      });
    }

    function syncHiddenLogos() {
      const holder = document.getElementById('certificate-hidden-logos');
      if (!holder) return;

      holder.innerHTML = '';

      activeLogos.forEach(logo => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'logoUrl';
        input.value = logo.url;
        holder.appendChild(input);
      });
    }

    function makeDraggable(elmnt) {
      let startX = 0;
      let startY = 0;
      let startLeft = 0;
      let startTop = 0;

      elmnt.addEventListener('pointerdown', dragStart);

      function dragStart(e) {
        e.preventDefault();

        const boundary = document.getElementById('drag-boundary').getBoundingClientRect();
        const rect = elmnt.getBoundingClientRect();

        startX = e.clientX;
        startY = e.clientY;
        startLeft = ((rect.left - boundary.left) / boundary.width) * 100;
        startTop = ((rect.top - boundary.top) / boundary.height) * 100;

        elmnt.setPointerCapture(e.pointerId);
        elmnt.addEventListener('pointermove', dragMove);
        elmnt.addEventListener('pointerup', dragEnd);
        elmnt.addEventListener('pointercancel', dragEnd);
      }

      function dragMove(e) {
        const boundary = document.getElementById('drag-boundary').getBoundingClientRect();
        const deltaX = ((e.clientX - startX) / boundary.width) * 100;
        const deltaY = ((e.clientY - startY) / boundary.height) * 100;

        elmnt.style.left = Math.max(0, Math.min(startLeft + deltaX, 92)) + '%';
        elmnt.style.top = Math.max(0, Math.min(startTop + deltaY, 92)) + '%';
      }

      function dragEnd(e) {
        elmnt.releasePointerCapture(e.pointerId);
        elmnt.removeEventListener('pointermove', dragMove);
        elmnt.removeEventListener('pointerup', dragEnd);
        elmnt.removeEventListener('pointercancel', dragEnd);
      }
    }

    function setBadgeIcon(iconClass) {
      const hidden = document.getElementById('selected-badge-icon');
      const icon = document.getElementById('preview-badge-icon');
      if (hidden) hidden.value = iconClass;
      if (icon) icon.className = `fa-solid ${iconClass} text-[3.9rem] text-white mb-3 drop-shadow-xl z-20`;
    }

    function updateBadge() {
      const title = document.getElementById('badge-title')?.value || 'Badge Title';
      const shape = document.getElementById('badge-shape')?.value || 'shape-shield';
      const color = document.getElementById('badge-color')?.value || '#0f172a';

      const titleEl = document.getElementById('preview-badge-text');
      const shapeHidden = document.getElementById('selected-badge-shape');
      const base = document.getElementById('preview-badge-base');

      if (titleEl) titleEl.innerText = title;
      if (shapeHidden) shapeHidden.value = shape;
      if (base) {
        base.className = `${shape} w-full h-full shadow-2xl flex flex-col justify-center items-center relative`;
        base.style.background = `linear-gradient(145deg, ${color}, #0f172a)`;
      }
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        alert('Copied: ' + text);
      } catch {
        prompt('Copy this key:', text);
      }
    }

    window.addEventListener('load', initDashboard);
  </script>
</body>
</html>