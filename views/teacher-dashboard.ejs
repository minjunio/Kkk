                <button type="button" onclick="setBadgeIcon('fa-award')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-award text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-code')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-code text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-bolt')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-bolt text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-brain')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-brain text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-graduation-cap')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-graduation-cap text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-robot')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-robot text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-chart-line')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-chart-line text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-language')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-language text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-flask')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-flask text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-medal')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-medal text-xl"></i></button>
                <button type="button" onclick="setBadgeIcon('fa-star')" class="p-3 bg-slate-100 rounded-xl hover:bg-slate-200"><i class="fa-solid fa-star text-xl"></i></button>
