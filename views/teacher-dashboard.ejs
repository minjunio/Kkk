<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teacher Dashboard • Credity.ink</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    body { font-family: 'Inter', system_ui, sans-serif; }
    .glass { background: rgba(255,255,255,0.05); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); }
    .modern-gradient { background: linear-gradient(135deg, #6366f1, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .spotless-card { transition: all .3s cubic-bezier(.4,0,.2,1); }
    .nav-active { color: #6366f1; font-weight: 600; }
    .section-header { font-size: 1.65rem; font-weight: 700; letter-spacing: -.02em; }
    .design-option { transition: all .2s ease; }
    .design-option.active { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.2); }
    .form-input { background: #18181b; border: 1px solid #27272a; }
    .form-input:focus { border-color: #6366f1; outline: none; }
    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #18181b; border-radius: 10px; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #27272a; border-radius: 10px; }
  </style>
</head>
<body class="bg-zinc-950 text-white">
  <nav class="border-b border-white/10 bg-zinc-950/90 backdrop-blur-xl sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-8 py-4 flex justify-between items-center">
      <div class="flex items-center gap-x-3">
        <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-violet-500 rounded-2xl flex items-center justify-center">
          <span class="font-bold text-xl">C</span>
        </div>
        <span class="font-semibold text-xl tracking-tight">Credity</span>
      </div>
      
      <div class="flex items-center gap-x-3 text-sm">
        <div class="px-4 py-1.5 bg-white/5 rounded-3xl flex items-center gap-x-2 text-xs">
          <i class="fa-solid fa-chalkboard-user text-indigo-400"></i>
          <span><%= user.name %></span>
        </div>
        <a href="/logout" class="px-5 py-1.5 hover:bg-white/5 transition-colors rounded-3xl border border-white/20 text-xs">Log out</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-8 pt-10 pb-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <div class="text-sm text-indigo-400 font-medium tracking-widest">TEACHER ADMIN PORTAL</div>
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tighter">Hello, <%= user.name.split(' ')[0] %>.</h1>
      </div>
      <div class="text-xs text-white/60 bg-white/5 px-4 py-2 rounded-2xl w-fit">Manage credentials • Issue badges • Create tests</div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-10">
      <div class="glass p-5 rounded-3xl">
        <div class="text-xs text-white/60">TOTAL BADGES CREATED</div>
        <div class="text-4xl font-semibold mt-1"><%= badges.length %></div>
      </div>
      <div class="glass p-5 rounded-3xl">
        <div class="text-xs text-white/60">ACTIVE EVENTS</div>
        <div class="text-4xl font-semibold mt-1"><%= events.length %></div>
      </div>
      <div class="glass p-5 rounded-3xl">
        <div class="text-xs text-white/60">TESTS CREATED</div>
        <div class="text-4xl font-semibold mt-1"><%= tests.length %></div>
      </div>
      <div class="glass p-5 rounded-3xl">
        <div class="text-xs text-white/60">STUDENTS ENGAGED</div>
        <div class="text-4xl font-semibold mt-1">128</div>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-6">
      
      <div class="lg:col-span-7 glass rounded-3xl p-8">
        <div class="flex items-center justify-between mb-6">
          <div class="section-header text-lg md:text-xl">Create Badge or Certificate</div>
          <div class="text-xs px-3 py-1 bg-white/10 rounded-3xl">Modern Studio</div>
        </div>
        
        <form action="/create-badge" method="POST" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs text-white/60 mb-1.5">TYPE</label>
              <select name="type" class="form-input w-full rounded-2xl px-4 py-3 text-sm">
                <option value="badge">Skill Badge</option>
                <option value="certificate">Certificate</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-white/60 mb-1.5">TITLE</label>
              <input type="text" name="title" value="Advanced Python Programming" class="form-input w-full rounded-2xl px-4 py-3 text-sm" required>
            </div>
          </div>
          
          <div>
            <label class="block text-xs text-white/60 mb-1.5">DESCRIPTION</label>
            <textarea name="description" rows="2" class="form-input w-full rounded-2xl px-4 py-3 text-sm">Completed rigorous training in Python, data structures, and AI fundamentals.</textarea>
          </div>
          
          <div>
            <label class="block text-xs text-white/60 mb-2">DESIGN STUDIO</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <div class="text-[10px] mb-1 text-white/60">PRIMARY COLOR</div>
                <div class="flex gap-2">
                  <input type="color" name="designColor" value="#6366f1" class="w-9 h-9 p-0 border border-white/10 rounded-xl cursor-pointer">
                  <input type="text" value="#6366f1" class="flex-1 form-input text-xs rounded-2xl px-3">
                </div>
              </div>
              
              <div>
                <div class="text-[10px] mb-1 text-white/60">LOGOS (UP TO 3)</div>
                <div class="flex gap-2">
                  <input type="text" name="logoUrl" value="https://via.placeholder.com/60x60/6366f1/fff?text=LOGO" class="flex-1 form-input text-xs rounded-2xl px-3 py-2" placeholder="Logo URL">
                  <button type="button" onclick="addLogoField(this)" class="px-3 text-xs border border-white/20 rounded-2xl hover:bg-white/5">+</button>
                </div>
              </div>
            </div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs text-white/60 mb-1.5">SIGNATURE</label>
              <input type="text" name="signature" value="<%= user.name %>" class="form-input w-full rounded-2xl px-4 py-3 text-sm">
            </div>
            <div>
              <label class="block text-xs text-white/60 mb-1.5">VERIFICATION</label>
              <div class="text-emerald-400 text-xs flex items-center gap-x-1.5 bg-white/5 px-3 py-3 rounded-2xl">
                <i class="fa-solid fa-qrcode"></i> 
                <span>QR + Link will be auto-generated</span>
              </div>
            </div>
          </div>
          
          <button type="submit" class="w-full py-4 bg-white text-zinc-950 font-semibold rounded-3xl mt-2 hover:bg-white/90 transition-all">Create &amp; Publish Badge</button>
        </form>
      </div>

      <div class="lg:col-span-5 space-y-6">
        <div class="glass rounded-3xl p-8">
          <div class="section-header mb-5 text-lg md:text-xl">Post Special Event</div>
          <form action="/post-event" method="POST" class="space-y-4">
            <input type="text" name="title" placeholder="Winter Skill Challenge 2026" class="form-input w-full rounded-2xl px-5 py-3 text-sm" required>
            <textarea name="description" placeholder="Complete 3 skill badges to earn exclusive recognition" class="form-input w-full rounded-2xl px-5 py-3 text-sm h-20"></textarea>
            
            <div>
              <label class="text-xs text-white/60 mb-1 block">ATTACH SPECIAL BADGE (OPTIONAL)</label>
              <select name="specialBadgeId" class="form-input w-full rounded-2xl px-4 py-3 text-sm">
                <option value="">None</option>
                <% badges.forEach(b => { %>
                  <option value="<%= b.id %>"><%= b.title %></option>
                <% }) %>
              </select>
            </div>
            
            <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-indigo-500 to-violet-500 text-white font-semibold rounded-3xl hover:opacity-90 transition-opacity">Publish Event</button>
          </form>
        </div>

        <div class="glass rounded-3xl p-8">
          <div class="section-header mb-3 text-lg md:text-xl">Generate Student/Class Key</div>
          <p class="text-xs text-white/50 mb-5">Create categorized entry keys for specific student groups or classes so they can load designated tasks and earn group-specific badges.</p>
          
          <form action="/generate-student-key" method="POST" class="space-y-4">
            <div>
              <label class="block text-[10px] text-white/60 mb-1.5">CLASS / GROUP NAME</label>
              <input type="text" name="className" placeholder="e.g. Fall 2026 - Section A" class="form-input w-full rounded-2xl px-4 py-2.5 text-sm" required>
            </div>
            <div>
              <label class="block text-[10px] text-white/60 mb-1.5">LINK TO TEST / TASK</label>
              <select name="testId" class="form-input w-full rounded-2xl px-4 py-2.5 text-sm" required>
                <option value="">Select an assessment...</option>
                <% tests.forEach(t => { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </select>
            </div>
            <button type="submit" class="w-full py-3 bg-white/10 border border-white/20 hover:bg-white/20 font-medium text-xs rounded-2xl transition-colors">Generate Unique Class Key</button>
          </form>
        </div>
      </div>

      <div class="lg:col-span-12 glass rounded-3xl p-8">
        <div class="flex items-center justify-between mb-5 flex-wrap gap-3">
          <div class="section-header text-lg md:text-xl">Create Assessment / Test</div>
          <span class="text-xs px-4 py-1 rounded-3xl bg-white/10">AI-ready templates</span>
        </div>
        
        <form action="/create-test" method="POST">
          <div class="mb-5">
            <input type="text" name="title" value="Python Fundamentals Final Assessment" class="form-input w-full text-lg font-medium px-6 py-4 rounded-3xl" placeholder="Test title" required>
          </div>
          
          <div class="mb-5">
            <label class="text-xs tracking-widest text-white/60 block mb-2">QUESTIONS (JSON format for demo)</label>
            <textarea name="questions" rows="7" class="form-input w-full font-mono text-xs p-5 rounded-3xl custom-scroll" placeholder='[{"q":"What is a variable?","type":"mcq","options":["A container","A function"],"timer":45,"image":"https://picsum.photos/300/150"}]'>[{"q":"What is a variable in programming?","type":"mcq","options":["A container for data","A type of loop","A function call","A comment"],"timer":60},{"q":"Explain the difference between == and === in JavaScript.","type":"frq","timer":120}]</textarea>
          </div>
          
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <button type="submit" class="w-full sm:flex-1 py-3.5 bg-white text-zinc-950 font-semibold rounded-3xl">Create Test</button>
            <button type="button" onclick="previewTest()" class="w-full sm:w-auto px-8 py-3.5 border border-white/30 hover:bg-white/5 rounded-3xl text-sm">Preview</button>
          </div>
        </form>
      </div>
      
    </div>

    <div class="mt-16 grid lg:grid-cols-2 gap-7">
      <div>
        <div class="px-1 flex justify-between items-center mb-4">
          <div class="font-semibold">Badges &amp; Certificates Created</div>
        </div>
        <% if (badges.length > 0) { %>
          <div class="space-y-3 max-h-80 overflow-y-auto custom-scroll pr-1">
            <% badges.forEach(b => { %>
              <div class="glass p-4 rounded-3xl flex justify-between items-center text-sm">
                <div>
                  <div class="font-medium"><%= b.title %></div>
                  <div class="text-xs text-white/50"><%= b.type %> • <%= b.createdBy %></div>
                </div>
                <div class="flex gap-x-2">
                  <div class="px-3 py-px text-xs border border-white/20 rounded-2xl flex items-center">QR ready</div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-xs text-white/60 px-1">No badges created yet. Use the form above.</div>
        <% } %>
      </div>
      
      <div>
        <div class="px-1 flex justify-between items-center mb-4">
          <div class="font-semibold">Tests Created</div>
        </div>
        <% if (tests.length > 0) { %>
          <div class="space-y-3 max-h-80 overflow-y-auto custom-scroll pr-1">
            <% tests.forEach(t => { %>
              <div class="glass p-4 rounded-3xl flex justify-between items-center">
                <div>
                  <div class="font-medium"><%= t.title %></div>
                  <div class="text-xs text-white/60"><%= t.questions.length %> questions</div>
                </div>
                <div class="text-xs px-3 py-1 rounded-2xl bg-white/10">Ready</div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-xs text-white/60 px-1">No tests yet. Create one above.</div>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    function addLogoField(btn) {
      const container = btn.parentElement;
      const newInput = document.createElement('input');
      newInput.type = 'text';
      newInput.name = 'logoUrl';
      newInput.placeholder = 'Additional logo URL';
      newInput.className = 'flex-1 form-input text-xs rounded-2xl px-3 py-2 mt-2';
      container.appendChild(newInput);
    }
    
    function previewTest() {
      alert('Preview mode: In a real app this would open a live test preview modal with timer, MCQ and FRQ.');
    }
  </script>
</body>
</html>
