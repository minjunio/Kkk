<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Teacher Dashboard • Credity</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Space+Grotesk:wght@500;700&family=Cinzel:wght@500;700&family=Montserrat:wght@400;600;700;800&family=Pinyon+Script&display=swap');

    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      overflow-x: hidden;
      background: #f8fafc;
    }

    .glass {
      background: rgba(255,255,255,0.95);
      border: 1px solid #e2e8f0;
      box-shadow: 0 10px 30px rgba(15,23,42,0.05);
    }

    .modern-input {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      transition: all 0.2s ease;
    }

    .modern-input:focus {
      border-color: #2563eb;
      background: #fff;
      outline: none;
      box-shadow: 0 0 0 4px rgba(37,99,235,0.1);
    }

    .custom-scroll::-webkit-scrollbar {
      height: 6px;
      width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 999px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 999px;
    }

    .font-signature {
      font-family: 'Pinyon Script', cursive;
    }

    .tab-btn {
      transition: all 0.2s ease;
    }

    .tab-active {
      color: #2563eb;
      border-bottom-color: #2563eb;
      font-weight: 800;
    }

    .stat-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 40px rgba(15,23,42,0.08);
    }

    .cert-container {
      container-type: inline-size;
      perspective: 1000px;
    }

    .certificate-preview {
      background: white;
      box-shadow: 0 25px 60px rgba(15,23,42,0.18);
      transition: all 0.35s ease;
      position: relative;
      overflow: hidden;
      transform-style: preserve-3d;
      display: flex;
      flex-direction: column;
      color: #1e293b;
    }

    .draggable-logo {
      position: absolute;
      cursor: grab;
      z-index: 80;
      width: 8.5cqi;
      height: 8.5cqi;
      min-width: 28px;
      min-height: 28px;
      mix-blend-mode: multiply;
      pointer-events: auto;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .draggable-logo:hover {
      transform: scale(1.04);
      box-shadow: 0 8px 20px rgba(15,23,42,0.15);
    }

    .draggable-logo:active {
      cursor: grabbing;
    }

    .draggable-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      pointer-events: none;
      user-select: none;
    }

    .tpl-1-degree {
      font-family: 'Cinzel', serif;
      border: 2.5cqw solid #1e293b;
      outline: 0.6cqw solid #1e293b;
      outline-offset: -1.2cqw;
      background: linear-gradient(#fffdf8, #fefaf0);
      box-shadow: inset 0 0 0 1.5cqw #f8f1e3, inset 0 0 90px rgba(180,83,9,0.07);
    }

    .tpl-1-degree::before {
      content: '';
      position: absolute;
      inset: 1.6cqw;
      border: 0.45cqw solid #1e293b;
      opacity: 0.12;
      pointer-events: none;
    }

    .tpl-1-degree .cert-title {
      font-size: 4.4cqi;
      color: #1e293b;
      font-weight: 700;
      border-bottom: 2.5px solid #b45309;
      padding-bottom: 1.4cqw;
      display: inline-block;
      letter-spacing: 0.02em;
    }

    .tpl-2-university {
      font-family: 'Playfair Display', serif;
      border: 3cqw solid #1e293b;
      background: #fff;
    }

    .tpl-2-university::before {
      content:'';
      position:absolute;
      inset: 1.8cqw;
      border: 0.35cqw solid #1e293b;
      opacity: 0.15;
      pointer-events: none;
    }

    .tpl-2-university .cert-title {
      font-size: 3.8cqi;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: #1e293b;
    }

    .tpl-3-corporate {
      font-family: 'Montserrat', sans-serif;
      border-top: 5.5cqw solid #1e293b;
      border-bottom: 1.8cqw solid #1e293b;
      background: #fff;
    }

    .tpl-3-corporate .cert-title {
      font-size: 3.5cqi;
      font-weight: 800;
      letter-spacing: 0.12em;
      color: #1e293b;
    }

    .tpl-4-tech {
      font-family: 'Space Grotesk', sans-serif;
      border: 0.6cqw solid #1e293b;
      background: #fff;
      background-image:
        linear-gradient(rgba(15,23,42,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15,23,42,0.04) 1px, transparent 1px);
      background-size: 3.8cqw 3.8cqw;
    }

    .tpl-4-tech .cert-title {
      font-size: 3.5cqi;
      text-transform: uppercase;
      color: #1e293b;
      letter-spacing: 0.1em;
    }

    .tpl-5-scholar {
      font-family: 'Cinzel', serif;
      border: 1.6cqw solid #b45309;
      background: linear-gradient(135deg, #fffbeb, #fef3c7);
    }

    .tpl-5-scholar::after {
      content:'';
      position:absolute;
      inset: 0.6cqw;
      border: 0.35cqw solid #b45309;
      pointer-events: none;
    }

    .tpl-5-scholar .cert-title {
      font-size: 4cqi;
      color: #92400e;
    }

    .tpl-6-minimal {
      font-family: 'Inter', sans-serif;
      border-left: 6.5cqw solid #1e293b;
      background: #f8fafc;
    }

    .tpl-6-minimal .cert-title {
      font-size: 3.6cqi;
      font-weight: 800;
      text-align: left;
      color: #1e293b;
    }

    .tpl-7-executive {
      font-family: 'Playfair Display', serif;
      border: 0.25cqw solid #64748b;
      background: #fff;
      box-shadow: inset 0 0 0 2.2cqw #f1f5f9;
    }

    .tpl-7-executive .cert-title {
      font-size: 3.9cqi;
      font-style: italic;
      color: #1e293b;
    }

    .tpl-8-dark {
      font-family: 'Space Grotesk', sans-serif;
      border: 0.55cqw solid #334155;
      background: radial-gradient(circle at 50% 0%, #1e293b, #0f172a);
      color: #f8fafc !important;
    }

    .tpl-8-dark .cert-title,
    .tpl-8-dark .cert-text-color {
      color: #fff !important;
    }

    .tpl-8-dark .draggable-logo {
      mix-blend-mode: normal;
      filter: drop-shadow(0 0 6px rgba(255,255,255,0.55));
    }

    .tpl-9-honors {
      font-family: 'Cinzel', serif;
      border: 1.1cqw double #9f1239;
      outline: 2.2cqw solid #fff1f2;
      outline-offset: -3.2cqw;
      background: #fff;
    }

    .tpl-9-honors .cert-title {
      font-size: 4.1cqi;
      color: #9f1239;
    }

    .tpl-10-cyber {
      font-family: 'Space Grotesk', sans-serif;
      border-right: 3.2cqw solid #10b981;
      border-left: 3.2cqw solid #10b981;
      background: #020617;
      color: #10b981 !important;
    }

    .tpl-10-cyber .cert-title,
    .tpl-10-cyber .cert-text-color {
      color: #10b981 !important;
    }

    .tpl-10-cyber .draggable-logo {
      mix-blend-mode: normal;
      filter: drop-shadow(0 0 6px #10b981);
    }

    .tpl-11-startup {
      font-family: 'Inter', sans-serif;
      border-radius: 4.5cqw;
      border: 0.9cqw solid #1e293b;
      background: #fff;
      box-shadow: inset 0 0 3.5cqw rgba(0,0,0,0.06);
    }

    .tpl-11-startup .cert-title {
      font-size: 3.7cqi;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .tpl-12-medical {
      font-family: 'Inter', sans-serif;
      border-left: 6.5cqw solid #0369a1;
      background: #f0f9ff;
    }

    .tpl-12-medical .cert-title {
      font-size: 3.7cqi;
      color: #0369a1;
      font-weight: 900;
    }

    .shape-circle { border-radius: 50%; }
    .shape-shield { clip-path: polygon(50% 100%, 0 80%, 0 0, 100% 0, 100% 80%); }
    .shape-hexagon { clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); }
    .shape-octagon { clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%); }
    .shape-diamond { clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); }
    .shape-star { clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }

    @media (max-width: 768px) {
      .certificate-preview {
        min-height: 260px;
      }
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800">
  <%
    const safeBadges = typeof badges !== 'undefined' && Array.isArray(badges) ? badges : [];
    const safeTests = typeof tests !== 'undefined' && Array.isArray(tests) ? tests : [];
    const safeEvents = typeof events !== 'undefined' && Array.isArray(events) ? events : [];
    const safeStudentKeys = typeof studentKeys !== 'undefined' && Array.isArray(studentKeys) ? studentKeys : [];
    const teacherName = user && user.name ? user.name : 'Teacher';
    const firstName = teacherName.split(' ')[0];
    const totalKeyUses = safeStudentKeys.reduce((sum, k) => sum + Number(k.usageCount || 0), 0);
  %>

  <nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-[92rem] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-x-3">
        <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/30">
          <span class="text-white font-black text-xl">C</span>
        </div>
        <div>
          <div class="font-black text-xl tracking-tight leading-none">Credity</div>
          <div class="text-[11px] text-slate-500 font-semibold uppercase tracking-wider">Teacher Workspace</div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="hidden md:flex items-center gap-2 px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl">
          <i class="fa-solid fa-chalkboard-user text-blue-600"></i>
          <span class="text-sm font-semibold"><%= teacherName %></span>
        </div>

        <button onclick="showTab('assessment'); scrollToWorkspace();"
                class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold bg-slate-900 text-white rounded-xl hover:bg-slate-800 transition-colors">
          <i class="fa-solid fa-plus"></i>
          New Assessment
        </button>

        <a href="/logout" class="px-5 py-2.5 text-sm font-semibold border border-slate-200 rounded-xl hover:bg-slate-50">
          Logout
        </a>
      </div>
    </div>
  </nav>

  <main class="max-w-[92rem] mx-auto px-4 sm:px-6 pt-8 pb-20">

    <section class="mb-8">
      <div class="glass rounded-[2rem] p-6 md:p-10 border border-blue-100 bg-gradient-to-br from-white via-blue-50/70 to-white">
        <div class="grid xl:grid-cols-12 gap-8 items-center">
          <div class="xl:col-span-7">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-600 text-white text-xs font-black tracking-[2px] rounded-xl mb-5">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              <span>TEACHER ACTION CENTER</span>
            </div>

            <h1 class="text-4xl md:text-6xl font-black tracking-tighter text-slate-950 leading-none">
              Welcome back, <%= firstName %>.
            </h1>

            <p class="mt-5 text-lg md:text-xl text-slate-600 max-w-3xl leading-relaxed">
              Create tests, attach certificates, generate student access keys, and issue verified badges from one clean teacher dashboard.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <button onclick="showTab('assessment'); scrollToWorkspace();"
                      class="inline-flex items-center justify-center gap-3 px-7 py-4 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold rounded-2xl shadow-xl shadow-blue-600/30 transition-all active:scale-[0.98]">
                <i class="fa-solid fa-file-circle-plus"></i>
                Create Assessment
              </button>

              <button onclick="showTab('certificates'); scrollToWorkspace();"
                      class="inline-flex items-center justify-center gap-3 px-7 py-4 bg-white border border-slate-200 hover:border-blue-300 hover:bg-blue-50 text-slate-800 font-bold rounded-2xl transition-all active:scale-[0.98]">
                <i class="fa-solid fa-certificate text-blue-600"></i>
                Design Certificate
              </button>

              <button onclick="showTab('keys'); scrollToWorkspace();"
                      class="inline-flex items-center justify-center gap-3 px-7 py-4 bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50 text-slate-800 font-bold rounded-2xl transition-all active:scale-[0.98]">
                <i class="fa-solid fa-key text-emerald-600"></i>
                Generate Class Key
              </button>
            </div>
          </div>

          <div class="xl:col-span-5">
            <div class="grid grid-cols-2 gap-4">
              <div class="stat-card bg-white rounded-3xl p-5 border border-slate-200">
                <div class="w-11 h-11 bg-blue-100 text-blue-700 rounded-2xl flex items-center justify-center mb-4">
                  <i class="fa-solid fa-clipboard-question"></i>
                </div>
                <div class="text-4xl font-black text-slate-950"><%= safeTests.length %></div>
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mt-1">Assessments</div>
              </div>

              <div class="stat-card bg-white rounded-3xl p-5 border border-slate-200">
                <div class="w-11 h-11 bg-violet-100 text-violet-700 rounded-2xl flex items-center justify-center mb-4">
                  <i class="fa-solid fa-award"></i>
                </div>
                <div class="text-4xl font-black text-slate-950"><%= safeBadges.length %></div>
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mt-1">Credentials</div>
              </div>

              <div class="stat-card bg-white rounded-3xl p-5 border border-slate-200">
                <div class="w-11 h-11 bg-emerald-100 text-emerald-700 rounded-2xl flex items-center justify-center mb-4">
                  <i class="fa-solid fa-key"></i>
                </div>
                <div class="text-4xl font-black text-slate-950"><%= safeStudentKeys.length %></div>
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mt-1">Class Keys</div>
              </div>

              <div class="stat-card bg-white rounded-3xl p-5 border border-slate-200">
                <div class="w-11 h-11 bg-amber-100 text-amber-700 rounded-2xl flex items-center justify-center mb-4">
                  <i class="fa-solid fa-users"></i>
                </div>
                <div class="text-4xl font-black text-slate-950"><%= totalKeyUses %></div>
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mt-1">Student Joins</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-8">
      <div class="grid lg:grid-cols-3 gap-5">
        <div class="glass rounded-3xl p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="text-xs font-black text-blue-600 uppercase tracking-widest">Step 1</div>
              <h3 class="text-xl font-black text-slate-950 mt-1">Create a test</h3>
              <p class="text-sm text-slate-500 mt-2">Add MCQ or written questions using the quick JSON builder.</p>
            </div>
            <i class="fa-solid fa-clipboard-list text-3xl text-blue-200"></i>
          </div>
        </div>

        <div class="glass rounded-3xl p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="text-xs font-black text-violet-600 uppercase tracking-widest">Step 2</div>
              <h3 class="text-xl font-black text-slate-950 mt-1">Attach a credential</h3>
              <p class="text-sm text-slate-500 mt-2">Choose a certificate or badge that students earn after passing.</p>
            </div>
            <i class="fa-solid fa-certificate text-3xl text-violet-200"></i>
          </div>
        </div>

        <div class="glass rounded-3xl p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="text-xs font-black text-emerald-600 uppercase tracking-widest">Step 3</div>
              <h3 class="text-xl font-black text-slate-950 mt-1">Give students a key</h3>
              <p class="text-sm text-slate-500 mt-2">Generate a class key so only your students can access the test.</p>
            </div>
            <i class="fa-solid fa-user-check text-3xl text-emerald-200"></i>
          </div>
        </div>
      </div>
    </section>

    <section id="workspace" class="mb-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-4">
        <div>
          <h2 class="text-3xl font-black tracking-tight text-slate-950">Teacher Studio</h2>
          <p class="text-slate-500 mt-1">Everything here is for your own classes, assessments, and credentials.</p>
        </div>
      </div>

      <div class="flex border-b border-slate-200 mb-8 overflow-x-auto custom-scroll">
        <button onclick="showTab('assessment')" class="tab-btn tab-active px-6 py-3 border-b-2 whitespace-nowrap" id="tab-assessment">
          <i class="fa-solid fa-clipboard-question mr-2"></i> Assessment
        </button>
        <button onclick="showTab('certificates')" class="tab-btn px-6 py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap" id="tab-certificates">
          <i class="fa-solid fa-certificate mr-2"></i> Certificates
        </button>
        <button onclick="showTab('badges')" class="tab-btn px-6 py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap" id="tab-badges">
          <i class="fa-solid fa-award mr-2"></i> Badges
        </button>
        <button onclick="showTab('keys')" class="tab-btn px-6 py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap" id="tab-keys">
          <i class="fa-solid fa-key mr-2"></i> Student Keys
        </button>
        <button onclick="showTab('events')" class="tab-btn px-6 py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap" id="tab-events">
          <i class="fa-solid fa-calendar-star mr-2"></i> Events
        </button>
        <button onclick="showTab('overview')" class="tab-btn px-6 py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap" id="tab-overview">
          <i class="fa-solid fa-layer-group mr-2"></i> My Work
        </button>
      </div>

      <div id="assessment-tab" class="tab-content">
        <div class="grid xl:grid-cols-12 gap-8">
          <div class="xl:col-span-7 glass rounded-3xl p-6 md:p-8">
            <div class="flex items-start justify-between gap-4 mb-6">
              <div>
                <h3 class="text-2xl font-black text-slate-950">Quick Create Assessment</h3>
                <p class="text-sm text-slate-500 mt-1">Create a simple test now. You can link a certificate or badge after.</p>
              </div>
              <div class="hidden sm:flex w-12 h-12 rounded-2xl bg-blue-100 text-blue-700 items-center justify-center">
                <i class="fa-solid fa-file-circle-plus text-xl"></i>
              </div>
            </div>

            <form action="/create-test" method="POST" class="space-y-5">
              <div>
                <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">Assessment Title</label>
                <input type="text" name="title" value="Python Fundamentals Final Assessment" class="modern-input w-full text-lg font-bold px-5 py-4 rounded-2xl" required>
              </div>

              <div class="grid md:grid-cols-3 gap-4">
                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">Mode</label>
                  <select name="isOpen" class="modern-input w-full px-4 py-3 rounded-2xl text-sm font-semibold">
                    <option value="true">Open anytime</option>
                    <option value="false">Scheduled</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">Start Time</label>
                  <input type="datetime-local" name="examStartTime" class="modern-input w-full px-4 py-3 rounded-2xl text-sm">
                </div>

                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">End Time</label>
                  <input type="datetime-local" name="examEndTime" class="modern-input w-full px-4 py-3 rounded-2xl text-sm">
                </div>
              </div>

              <input type="hidden" name="teacherTimezone" value="Asia/Dubai">

              <div>
                <div class="flex items-center justify-between gap-3 mb-2">
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-wider">Questions JSON</label>
                  <button type="button" onclick="insertQuestionTemplate()" class="text-xs font-bold text-blue-600 hover:text-blue-700">
                    Insert Example
                  </button>
                </div>

                <textarea id="questionsBox" name="questions" rows="9" class="modern-input custom-scroll w-full font-mono text-xs p-5 rounded-2xl" required>[{"q":"What is a variable in programming?","type":"mcq","options":["A container for data","A type of loop","A function call","A comment"],"answer":"A container for data","timer":60},{"q":"Explain the difference between == and === in JavaScript.","type":"frq","timer":120}]</textarea>
              </div>

              <button type="submit" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-2xl shadow-lg shadow-blue-600/20">
                Create Assessment
              </button>
            </form>
          </div>

          <div class="xl:col-span-5 space-y-5">
            <div class="glass rounded-3xl p-6 md:p-8">
              <h3 class="text-xl font-black text-slate-950">Best teacher workflow</h3>
              <div class="mt-5 space-y-4">
                <div class="flex gap-4">
