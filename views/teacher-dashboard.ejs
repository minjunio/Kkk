                      <input
                        type="hidden"
                        name="testId"
                        value="<%= test.id %>"
                      >

                      <button
                        type="submit"
                        class="btn btn-red w-full py-3 text-sm"
                      >
                        Delete Assignment
                      </button>
                    </form>
                  </article>
                <% }) %>
              </div>
