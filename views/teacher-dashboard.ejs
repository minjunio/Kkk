            <button type="submit" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-xl text-lg shadow-lg shadow-blue-600/20">
              Create Verified Certificate
            </button>
          </div>

          <div class="xl:w-2/5 cert-container">
            <div class="sticky top-24">
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-sm font-black text-slate-400 uppercase tracking-wider">Live Preview</h3>
                <div class="text-xs font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 px-3 py-1 rounded-full">
                  QR included
                </div>
              </div>

              <div id="cert-preview" class="certificate-preview tpl-1-degree w-full aspect-[1.414] p-[5%] flex flex-col items-center text-center">
                <div id="drag-boundary" class="absolute inset-0 z-50 overflow-hidden pointer-events-none"></div>

                <div class="w-full relative z-10 mt-[7%]">
                  <div class="text-[1.65cqi] tracking-[0.3em] text-slate-500 uppercase mb-[2%] cert-text-color font-bold">
                    This certifies that
                  </div>
                  <div id="preview-student" class="text-[5.1cqi] font-black text-slate-900 leading-none cert-text-color mt-[2%]">
                    Alex Rivera
                  </div>
                </div>

                <div class="px-[7%] my-[5%] relative z-10 w-full flex-grow">
                  <div id="preview-title" class="cert-title mb-[4%] drop-shadow-sm">
                    Certificate of Achievement
                  </div>
                  <div id="preview-desc" class="text-[1.6cqi] text-slate-600 cert-text-color leading-relaxed">
                    has successfully completed the required assessment and demonstrated strong understanding of the subject.
                  </div>
                </div>

                <div class="w-full flex justify-between items-end mt-auto pt-1 pb-1 relative z-10">
                  <div class="text-center border-t border-slate-400 pt-2 min-w-[13cqi]">
                    <div id="preview-signature" class="font-signature text-[3.9cqi] text-slate-800 cert-text-color leading-none mb-0.5">
                      <%= teacherName %>
                    </div>
                    <div class="text-[0.85cqi] text-slate-500 uppercase tracking-widest cert-text-color font-black">
                      Teacher
                    </div>
                  </div>

                  <div class="text-center border-t border-slate-400 pt-2 min-w-[13cqi]">
                    <div id="preview-date-display" class="text-[1.45cqi] font-black text-slate-800 cert-text-color leading-none mb-1 mt-1">
                      Date
                    </div>
                    <div class="text-[0.85cqi] text-slate-500 uppercase tracking-widest cert-text-color font-black">
                      Issue Date
                    </div>
                  </div>

                  <div class="flex flex-col items-center">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&amp;data=Verify" class="w-[6.6cqi] h-[6.6cqi] mb-0.5 p-0.5 bg-white border border-slate-200 shadow-sm">
                    <div class="text-[0.82cqi] text-slate-500 uppercase cert-text-color font-black tracking-widest">
                      Verify
                    </div>
                  </div>
                </div>
              </div>

              <p class="text-xs text-slate-500 mt-4 leading-relaxed">
                Logos are draggable in the preview. The server will save the logo URLs and auto-generate the final QR link when a student earns it.
              </p>
            </div>
          </div>
        </form>
      </div>

      <div id="badges-tab" class="tab-content hidden">
        <form action="/create-credential" method="POST" class="flex flex-col lg:flex-row gap-8">
          <input type="hidden" name="type" value="badge">
          <input type="hidden" id="selected-badge-icon" name="badgeIcon" value="fa-shield-halved">
          <input type="hidden" id="selected-badge-shape" name="badgeShape" value="shape-shield">

          <div class="lg:w-1/2 glass p-6 md:p-8 rounded-3xl space-y-6">
            <div>
              <h3 class="text-2xl font-black text-slate-950">Badge Creator</h3>
              <p class="text-sm text-slate-500 mt-1">Create a quick skill badge for students who pass an assessment.</p>
            </div>

            <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
              <label class="text-xs font-black text-blue-800 uppercase tracking-wider block mb-2">Attach to Assessment</label>
              <select name="assessmentId" class="modern-input w-full px-4 py-3 rounded-xl text-sm font-bold bg-white" required>
                <option value="">Select assessment...</option>
                <% safeTests.forEach(t => { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </select>
            </div>

            <div>
              <label class="text-xs font-black text-slate-400 uppercase tracking-wider block mb-2">Badge Title</label>
              <input type="text" name="title" id="badge-title" value="Certified Learner" oninput="updateBadge()" class="modern-input w-full px-4 py-3 rounded-xl font-bold" required>
            </div>

            <div>
              <label class="text-xs font-black text-slate-400 uppercase tracking-wider block mb-2">Badge Description</label>
              <textarea name="description" class="modern-input w-full px-4 py-3 rounded-xl h-20 text-sm">Awarded for passing the assessment and demonstrating strong skill understanding.</textarea>
