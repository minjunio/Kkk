<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Teacher Dashboard • Credity</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Cormorant+Garamond:wght@500;600;700&family=DM+Serif+Display&family=Inter:wght@400;500;600;700;800&family=Libre+Baskerville:wght@400;700&family=Montserrat:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700;800&family=Pinyon+Script&family=Space+Grotesk:wght@500;600;700&display=swap');

    * {
      box-sizing: border-box;
      min-width: 0;
    }

    html,
    body {
      width: 100%;
      max-width: 100%;
      margin: 0;
      overflow-x: hidden;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: #f5f7fa;
      color: #0f172a;
      -webkit-font-smoothing: antialiased;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    img,
    svg,
    video,
    canvas {
      max-width: 100%;
    }

    .app-shell {
      width: 100%;
      max-width: 100vw;
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
    }

    .sidebar {
      position: sticky;
      top: 0;
      width: 304px;
      min-width: 304px;
      max-width: 304px;
      height: 100vh;
      background: #ffffff;
      border-right: 1px solid #e2e8f0;
      overflow: hidden;
      z-index: 50;
    }

    .sidebar-inner {
      width: 100%;
      height: 100%;
      padding: 18px;
      overflow-y: auto;
      overflow-x: hidden;
    }

    .main-shell {
      flex: 1;
      width: calc(100vw - 304px);
      max-width: calc(100vw - 304px);
      overflow-x: hidden;
    }

    .page {
      width: 100%;
      max-width: 100%;
      padding: 24px;
    }

    .panel {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.035);
    }

    .panel-strong {
      background: #ffffff;
      border: 1px solid #dbe2ea;
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
    }

    .input {
      width: 100%;
      max-width: 100%;
      background: #ffffff;
      border: 1px solid #d7dee8;
      color: #0f172a;
      outline: none;
      transition:
        border-color 0.16s ease,
        box-shadow 0.16s ease;
    }

    .input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    textarea.input {
      resize: vertical;
    }

    .btn {
      max-width: 100%;
      border-radius: 11px;
      font-weight: 500;
      text-align: center;
      transition:
        background 0.16s ease,
        border-color 0.16s ease,
        color 0.16s ease,
        transform 0.16s ease;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn-primary {
      color: #ffffff;
      background: #1d4ed8;
      border: 1px solid #1d4ed8;
    }

    .btn-primary:hover {
      background: #1e40af;
      border-color: #1e40af;
    }

    .btn-dark {
      color: #ffffff;
      background: #111827;
      border: 1px solid #111827;
    }

    .btn-dark:hover {
      background: #030712;
    }

    .btn-light {
      color: #111827;
      background: #ffffff;
      border: 1px solid #d7dee8;
    }

    .btn-light:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .btn-green {
      color: #ffffff;
      background: #059669;
      border: 1px solid #059669;
    }

    .btn-green:hover {
      background: #047857;
    }

    .btn-purple {
      color: #ffffff;
      background: #7c3aed;
      border: 1px solid #7c3aed;
    }

    .btn-purple:hover {
      background: #6d28d9;
    }

    .btn-red {
      color: #ffffff;
      background: #dc2626;
      border: 1px solid #dc2626;
    }

    .btn-red:hover {
      background: #b91c1c;
    }

    .side-link {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border: 1px solid transparent;
      border-radius: 12px;
      background: transparent;
      color: #475569;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.16s ease;
    }

    .side-link:hover {
      color: #0f172a;
      background: #f1f5f9;
    }

    .side-link.active {
      color: #1d4ed8;
      background: #eff6ff;
      border-color: #bfdbfe;
    }

    .class-box {
      width: 100%;
      padding: 14px;
      overflow: hidden;
      text-align: left;
      color: #0f172a;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 15px;
      transition: all 0.16s ease;
    }

    .class-box:hover {
      background: #f8fafc;
      border-color: #bfdbfe;
    }

    .class-box.active {
      color: #ffffff;
      background: #111827;
      border-color: #111827;
    }

    .class-box.active .muted-active,
    .task-link.active .muted-active {
      color: rgba(255, 255, 255, 0.66);
    }

    .task-link.active {
      color: #ffffff;
      background: #111827;
      border-color: #111827;
    }

    .grid-safe {
      width: 100%;
      max-width: 100%;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 14px;
    }

    .two-col-safe {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .three-col-safe {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .table-wrap {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
    }

    .safe-table {
      width: 100%;
      min-width: 780px;
      border-collapse: collapse;
    }

    .break-anywhere {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
      background: #eef2f7;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
      background: #c4cdd9;
      border-radius: 999px;
    }

    /* =========================================================
       CERTIFICATE BASE
       ========================================================= */

    .cert-container {
      width: 100%;
      max-width: 100%;
      container-type: inline-size;
      perspective: 1200px;
    }

    .certificate-preview {
      --cert-accent: #14213d;
      --cert-secondary: #c89b3c;
      --cert-ink: #111827;
      --cert-muted: #64748b;
      --cert-paper: #fffdf8;

      position: relative;
      width: 100%;
      max-width: 100%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      color: var(--cert-ink);
      background: var(--cert-paper);
      box-shadow:
        0 24px 60px rgba(15, 23, 42, 0.18),
        0 4px 12px rgba(15, 23, 42, 0.08);
      isolation: isolate;
      transform-style: preserve-3d;
    }

    .certificate-content {
      position: relative;
      z-index: 20;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .cert-paper-texture {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      opacity: 0.32;
      background-image:
        radial-gradient(
          circle at 12% 18%,
          rgba(15, 23, 42, 0.035) 0 0.6px,
          transparent 0.7px
        ),
        radial-gradient(
          circle at 78% 56%,
          rgba(15, 23, 42, 0.025) 0 0.55px,
          transparent 0.65px
        );
      background-size: 9px 9px, 13px 13px;
      mix-blend-mode: multiply;
    }

    .cert-rosette {
      position: absolute;
      left: 50%;
      top: 45%;
      z-index: 2;
      width: 30cqi;
      height: 30cqi;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      pointer-events: none;
      opacity: 0.065;
      background:
        repeating-radial-gradient(
          circle,
          transparent 0 0.7cqi,
          var(--cert-accent) 0.75cqi 0.85cqi,
          transparent 0.9cqi 1.5cqi
        ),
        repeating-conic-gradient(
          from 0deg,
          var(--cert-secondary) 0deg 2deg,
          transparent 2deg 8deg
        );
      mask-image:
        radial-gradient(
          circle,
          #000 0 63%,
          transparent 65%
        );
    }

    .cert-corner {
      position: absolute;
      z-index: 5;
      width: 11cqi;
      height: 11cqi;
      color: var(--cert-accent);
      opacity: 0.5;
      pointer-events: none;
    }

    .cert-corner::before,
    .cert-corner::after {
      content: '';
      position: absolute;
      border-color: currentColor;
      border-style: solid;
    }

    .cert-corner::before {
      inset: 0;
      border-width: 0.24cqi 0 0 0.24cqi;
    }

    .cert-corner::after {
      inset: 1.25cqi;
      border-width: 0.12cqi 0 0 0.12cqi;
    }

    .corner-tl {
      top: 2.2cqi;
      left: 2.2cqi;
    }

    .corner-tr {
      top: 2.2cqi;
      right: 2.2cqi;
      transform: rotate(90deg);
    }

    .corner-br {
      right: 2.2cqi;
      bottom: 2.2cqi;
      transform: rotate(180deg);
    }

    .corner-bl {
      left: 2.2cqi;
      bottom: 2.2cqi;
      transform: rotate(270deg);
    }

    .cert-top-rule {
      position: absolute;
      top: 5.2cqi;
      left: 14%;
      right: 14%;
      z-index: 4;
      height: 0.2cqi;
      opacity: 0.46;
      background:
        linear-gradient(
          90deg,
          transparent,
          var(--cert-secondary),
          var(--cert-accent),
          var(--cert-secondary),
          transparent
        );
    }

    .cert-top-rule::before,
    .cert-top-rule::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 1.7cqi;
      height: 1.7cqi;
      transform: translateY(-50%) rotate(45deg);
      border: 0.16cqi solid var(--cert-secondary);
      background: var(--cert-paper);
    }

    .cert-top-rule::before {
      left: 18%;
    }

    .cert-top-rule::after {
      right: 18%;
    }

    .cert-emblem {
      position: relative;
      width: 8.4cqi;
      height: 8.4cqi;
      margin: 0 auto 1.4cqi;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--cert-accent);
      border: 0.28cqi double currentColor;
      border-radius: 50%;
      font-size: 2.6cqi;
    }

    .cert-emblem::before {
      content: '';
      position: absolute;
      inset: -0.9cqi;
      border: 0.1cqi solid currentColor;
      border-radius: 50%;
      opacity: 0.25;
    }

    .cert-emblem::after {
      content: '';
      position: absolute;
      inset: 0.85cqi;
      border: 0.1cqi dashed currentColor;
      border-radius: 50%;
      opacity: 0.28;
    }

    .cert-pretitle {
      color: var(--cert-muted);
      font-size: 1cqi;
      font-weight: 700;
      letter-spacing: 0.42em;
      text-transform: uppercase;
    }

    .cert-recipient-label {
      margin-top: 1.55cqi;
      color: var(--cert-muted);
      font-size: 0.95cqi;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
    }

    .cert-recipient {
      margin-top: 1.2cqi;
      color: var(--cert-ink);
      font-size: 5.1cqi;
      font-weight: 700;
      line-height: 0.98;
      letter-spacing: -0.035em;
    }

    .cert-title {
      display: inline-block;
      color: var(--cert-accent);
      font-size: 3.5cqi;
      font-weight: 700;
      line-height: 1.12;
    }

    .cert-description {
      width: 82%;
      margin: 2cqi auto 0;
      color: var(--cert-muted);
      font-size: 1.45cqi;
      line-height: 1.7;
    }

    .cert-footer {
      width: 100%;
      display: grid;
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 0.82fr)
        minmax(0, 1fr);
      align-items: end;
      gap: 3cqi;
      margin-top: auto;
      padding-top: 2cqi;
    }

    .cert-footer-block {
      text-align: center;
    }

    .cert-signature-line {
      padding-top: 0.8cqi;
      border-top: 0.12cqi solid currentColor;
    }

    .cert-signature {
      color: var(--cert-ink);
      font-family: 'Pinyon Script', cursive;
      font-size: 3.4cqi;
      line-height: 0.9;
    }

    .cert-footer-label {
      margin-top: 0.6cqi;
      color: var(--cert-muted);
      font-size: 0.68cqi;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .certificate-serial {
      position: absolute;
      left: 4cqi;
      bottom: 2.7cqi;
      z-index: 9;
      color: var(--cert-muted);
      opacity: 0.58;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.57cqi;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    /*
      The words themselves follow eight wave paths.
      The phrase fills each row from the left edge to the right edge.
    */
    .security-wave-svg {
      position: absolute;
      left: -2%;
      top: 31%;
      z-index: 8;
      width: 104%;
      height: 15%;
      overflow: visible;
      color: var(--cert-accent);
      opacity: 0.22;
      transform: rotate(-0.8deg);
      pointer-events: none;
      mask-image:
        linear-gradient(
          90deg,
          transparent,
          #000 4%,
          #000 96%,
          transparent
        );
    }

    .security-wave-svg text {
      fill: currentColor;
      font-family: 'Montserrat', sans-serif;
      font-size: 8px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .security-wave-svg .wave-secondary {
      fill: var(--cert-secondary);
      opacity: 0.76;
    }

    /*
      Four concentric text rings.
      Every ring continuously repeats:
      VERIFIABLE ON CREDITY.INK
    */
    .qr-security-wrap {
      position: relative;
      width: 12.4cqi;
      height: 12.4cqi;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--cert-accent);
    }

    .qr-ring-svg {
      position: absolute;
      inset: -0.6cqi;
      z-index: 2;
      width: calc(100% + 1.2cqi);
      height: calc(100% + 1.2cqi);
      overflow: visible;
      color: var(--cert-accent);
      pointer-events: none;
    }

    .qr-ring-svg text {
      fill: currentColor;
      font-family: 'Montserrat', sans-serif;
      font-size: 6.2px;
      font-weight: 700;
      letter-spacing: 0.55px;
      text-transform: uppercase;
    }

    .qr-ring-svg .ring-two {
      fill: var(--cert-secondary);
      opacity: 0.8;
    }

    .qr-ring-svg .ring-three {
      opacity: 0.58;
    }

    .qr-ring-svg .ring-four {
      fill: var(--cert-secondary);
      opacity: 0.48;
    }

    .qr-guilloche-core {
      position: absolute;
      inset: 1.05cqi;
      z-index: 1;
      border-radius: 50%;
      opacity: 0.16;
      background:
        repeating-conic-gradient(
          from 0deg,
          var(--cert-accent) 0deg 1deg,
          transparent 1deg 5deg
        );
      mask-image:
        radial-gradient(
          circle,
          transparent 0 57%,
          #000 58% 62%,
          transparent 63%
        );
    }

    .qr-security-code {
      position: relative;
      z-index: 10;
      width: 5.9cqi;
      height: 5.9cqi;
      padding: 0.32cqi;
      object-fit: contain;
      background: #ffffff;
      border: 0.1cqi solid rgba(15, 23, 42, 0.2);
      box-shadow:
        0 0.5cqi 1.4cqi rgba(15, 23, 42, 0.12);
    }

    .draggable-logo {
      position: absolute;
      z-index: 90;
      width: 8.5cqi;
      height: 8.5cqi;
      min-width: 28px;
      min-height: 28px;
      cursor: grab;
      pointer-events: auto;
      mix-blend-mode: multiply;
    }

    .draggable-logo:active {
      cursor: grabbing;
    }

    .draggable-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      user-select: none;
      pointer-events: none;
    }

    /* =========================================================
       TEMPLATE 1 — SOVEREIGN NAVY
       Ornate centered layout with three borders.
       ========================================================= */

    .tpl-sovereign {
      --cert-accent: #14213d;
      --cert-secondary: #c89b3c;
      --cert-ink: #111827;
      --cert-muted: #596579;
      --cert-paper: #fffdf7;

      padding: 5.8%;
      font-family: 'Cinzel', serif;
      border: 2.3cqw solid #14213d;
      outline: 0.48cqw solid #c89b3c;
      outline-offset: -1.18cqw;
      background:
        radial-gradient(
          circle at center,
          rgba(200, 155, 60, 0.055),
          transparent 46%
        ),
        linear-gradient(
          135deg,
          #fffdf7,
          #fdf8ea
        );
    }

    .tpl-sovereign::before {
      content: '';
      position: absolute;
      inset: 2.05cqw;
      z-index: 3;
      border: 0.16cqw solid rgba(20, 33, 61, 0.34);
      pointer-events: none;
    }

    .tpl-sovereign::after {
      content: '';
      position: absolute;
      inset: 2.75cqw;
      z-index: 3;
      border: 0.09cqw dashed rgba(200, 155, 60, 0.5);
      pointer-events: none;
    }

    .tpl-sovereign .cert-title {
      padding: 0 1.5cqi 1cqi;
      border-bottom: 0.22cqi solid var(--cert-secondary);
      letter-spacing: 0.05em;
    }

    /* =========================================================
       TEMPLATE 2 — ROYAL UNIVERSITY
       Academic arch, larger crest, double institutional border.
       ========================================================= */

    .tpl-university {
      --cert-accent: #1e3a8a;
      --cert-secondary: #b68b2c;
      --cert-ink: #172554;
      --cert-muted: #64748b;
      --cert-paper: #ffffff;

      padding: 5.8%;
      font-family: 'Playfair Display', serif;
      border: 2.8cqw solid #172554;
      background:
        radial-gradient(
          ellipse at 50% 0%,
          rgba(30, 58, 138, 0.1),
          transparent 36%
        ),
        linear-gradient(
          #ffffff,
          #f8fafc
        );
    }

    .tpl-university::before {
      content: '';
      position: absolute;
      inset: 1.35cqw;
      z-index: 3;
      border: 0.42cqw double #b68b2c;
      opacity: 0.65;
      pointer-events: none;
    }

    .tpl-university::after {
      content: '';
      position: absolute;
      left: 12%;
      right: 12%;
      top: 3.1cqw;
      height: 12cqw;
      z-index: 2;
      border: 0.22cqw solid rgba(30, 58, 138, 0.16);
      border-bottom: 0;
      border-radius: 50% 50% 0 0 / 80% 80% 0 0;
      pointer-events: none;
    }

    .tpl-university .cert-title {
      font-size: 3.15cqi;
      text-transform: uppercase;
      letter-spacing: 0.18em;
    }

    .tpl-university .cert-emblem {
      width: 9.2cqi;
      height: 9.2cqi;
      border-width: 0.42cqi;
    }

    /* =========================================================
       TEMPLATE 3 — EXECUTIVE BLACK
       Corporate masthead with left-aligned body.
       ========================================================= */

    .tpl-executive {
      --cert-accent: #111827;
      --cert-secondary: #bfa56a;
      --cert-ink: #111827;
      --cert-muted: #64748b;
      --cert-paper: #ffffff;

      padding: 6.4% 6.8% 5.8%;
      font-family: 'Montserrat', sans-serif;
      border-top: 5.2cqw solid #111827;
      border-right: 0.9cqw solid #111827;
      border-bottom: 1.8cqw solid #111827;
      border-left: 0.9cqw solid #111827;
      background:
        linear-gradient(
          120deg,
          rgba(17, 24, 39, 0.035),
          transparent 35%
        ),
        #ffffff;
    }

    .tpl-executive::before {
      content: '';
      position: absolute;
      left: 4cqw;
      right: 4cqw;
      top: 2cqw;
      z-index: 3;
      height: 0.18cqw;
      background:
        linear-gradient(
          90deg,
          #bfa56a,
          #ffffff,
          #bfa56a
        );
    }

    .tpl-executive::after {
      content: 'EXECUTIVE CREDENTIAL';
      position: absolute;
      top: 1.25cqw;
      left: 50%;
      z-index: 4;
      transform: translateX(-50%);
      color: #ffffff;
      font-size: 0.68cqi;
      font-weight: 700;
      letter-spacing: 0.34em;
      white-space: nowrap;
    }

    .tpl-executive .certificate-content {
      text-align: left;
    }

    .tpl-executive .cert-emblem {
      margin-left: 0;
      margin-right: 0;
      border-radius: 18%;
    }

    .tpl-executive .cert-title {
      font-size: 3.15cqi;
      font-weight: 800;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .tpl-executive .cert-description {
      width: 76%;
      margin-left: 0;
    }

    /* =========================================================
       TEMPLATE 4 — MODERN AZURE
       Geometric asymmetric technology style.
       ========================================================= */

    .tpl-azure {
      --cert-accent: #0369a1;
      --cert-secondary: #38bdf8;
      --cert-ink: #0c4a6e;
      --cert-muted: #64748b;
      --cert-paper: #fafdff;

      padding: 5.8%;
      font-family: 'Space Grotesk', sans-serif;
      border: 0.7cqw solid #0369a1;
      background:
        radial-gradient(
          circle at 10% 10%,
          rgba(56, 189, 248, 0.17),
          transparent 20%
        ),
        radial-gradient(
          circle at 92% 78%,
          rgba(3, 105, 161, 0.1),
          transparent 26%
        ),
        linear-gradient(
          #ffffff,
          #f0f9ff
        );
    }

    .tpl-azure::before {
      content: '';
      position: absolute;
      right: -5cqw;
      top: -3cqw;
      z-index: 2;
      width: 22cqw;
      height: 48cqw;
      transform: rotate(13deg);
      background:
        linear-gradient(
          145deg,
          rgba(3, 105, 161, 0.12),
          rgba(56, 189, 248, 0.03)
        );
    }

    .tpl-azure::after {
      content: '';
      position: absolute;
      inset: 2cqw;
      z-index: 3;
      border: 0.18cqw solid rgba(3, 105, 161, 0.3);
      clip-path:
        polygon(
          0 0,
          35% 0,
          35% 1%,
          65% 1%,
          65% 0,
          100% 0,
          100% 100%,
          65% 100%,
          65% 99%,
          35% 99%,
          35% 100%,
          0 100%
        );
      pointer-events: none;
    }

    .tpl-azure .cert-emblem {
      border-radius: 22%;
    }

    .tpl-azure .cert-title {
      padding: 0.7cqi 1.7cqi;
      border: 0.11cqi solid rgba(3, 105, 161, 0.35);
      border-radius: 999px;
      font-size: 3cqi;
      letter-spacing: 0.06em;
    }

    /* =========================================================
       TEMPLATE 5 — GOLD SCHOLAR
       Parchment, medallion and classical typography.
       ========================================================= */

    .tpl-gold {
      --cert-accent: #78350f;
      --cert-secondary: #d4a64a;
      --cert-ink: #451a03;
      --cert-muted: #785f44;
      --cert-paper: #fffaf0;

      padding: 5.8%;
      font-family: 'Cormorant Garamond', serif;
      border: 2cqw solid #78350f;
      outline: 0.42cqw solid #d4a64a;
      outline-offset: -1.12cqw;
      background:
        radial-gradient(
          circle at center,
          rgba(212, 166, 74, 0.09),
          transparent 46%
        ),
        linear-gradient(
          145deg,
          #fffdf7,
          #faedcf
        );
    }

    .tpl-gold::before {
      content: '';
      position: absolute;
      inset: 2.2cqw;
      z-index: 3;
      border: 0.35cqw double rgba(120, 53, 15, 0.52);
      pointer-events: none;
    }

    .tpl-gold::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: 3.6cqw;
      z-index: 2;
      width: 22cqw;
      height: 4.8cqw;
      transform: translateX(-50%);
      border-top: 0.18cqw solid rgba(120, 53, 15, 0.28);
      border-bottom: 0.18cqw solid rgba(120, 53, 15, 0.28);
    }

    .tpl-gold .cert-emblem {
      width: 10cqi;
      height: 10cqi;
      border-width: 0.38cqi;
      box-shadow:
        0 0 0 0.6cqi rgba(212, 166, 74, 0.12);
    }

    .tpl-gold .cert-title {
      font-family: 'DM Serif Display', serif;
      font-size: 4cqi;
      font-weight: 500;
    }

    /* =========================================================
       TEMPLATE 6 — EMERALD LAUREATE
       Decorative laurel sides and prestigious green styling.
       ========================================================= */

    .tpl-emerald {
      --cert-accent: #065f46;
      --cert-secondary: #b9a15b;
      --cert-ink: #064e3b;
      --cert-muted: #55746b;
      --cert-paper: #fbfffd;

      padding: 5.8% 8%;
      font-family: 'Libre Baskerville', serif;
      border: 1.75cqw solid #064e3b;
      background:
        radial-gradient(
          circle at 50% 52%,
          rgba(6, 95, 70, 0.055),
          transparent 38%
        ),
        linear-gradient(
          135deg,
          #ffffff,
          #ecfdf5
        );
    }

    .tpl-emerald::before,
    .tpl-emerald::after {
      content: '❧';
      position: absolute;
      top: 50%;
      z-index: 2;
      color: rgba(6, 95, 70, 0.18);
      font-family: Georgia, serif;
      font-size: 12cqi;
    }

    .tpl-emerald::before {
      left: 0.9cqw;
      transform: translateY(-50%) rotate(-90deg);
    }

    .tpl-emerald::after {
      right: 0.9cqw;
      transform: translateY(-50%) rotate(90deg);
    }

    .tpl-emerald .cert-title {
      padding-bottom: 0.8cqi;
      border-bottom: 0.18cqi solid var(--cert-secondary);
      letter-spacing: 0.04em;
    }

    .tpl-emerald .cert-emblem {
      border-radius: 50% 50% 42% 42%;
    }

    /* =========================================================
       TEMPLATE 7 — BURGUNDY HERITAGE
       Formal burgundy certificate with diagonal corner panels.
       ========================================================= */

    .tpl-burgundy {
      --cert-accent: #6b1531;
      --cert-secondary: #c6a45d;
      --cert-ink: #4c1025;
      --cert-muted: #775967;
      --cert-paper: #fffafb;

      padding: 5.8%;
      font-family: 'Playfair Display', serif;
      border: 2.1cqw solid #6b1531;
      background:
        linear-gradient(
          135deg,
          rgba(107, 21, 49, 0.05),
          transparent 38%
        ),
        #fffafb;
    }

    .tpl-burgundy::before {
      content: '';
      position: absolute;
      left: -7cqw;
      top: -7cqw;
      z-index: 2;
      width: 21cqw;
      height: 21cqw;
      transform: rotate(45deg);
      background: rgba(107, 21, 49, 0.1);
      border: 0.5cqw solid rgba(198, 164, 93, 0.38);
    }

    .tpl-burgundy::after {
      content: '';
      position: absolute;
      right: -7cqw;
      bottom: -7cqw;
      z-index: 2;
      width: 21cqw;
      height: 21cqw;
      transform: rotate(45deg);
      background: rgba(107, 21, 49, 0.1);
      border: 0.5cqw solid rgba(198, 164, 93, 0.38);
    }

    .tpl-burgundy .cert-title {
      font-size: 3.7cqi;
      font-style: italic;
    }

    .tpl-burgundy .cert-recipient {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
    }

    /* =========================================================
       TEMPLATE 8 — DIGITAL PLATINUM
       Circuit grid and boxed digital credential title.
       ========================================================= */

    .tpl-platinum {
      --cert-accent: #334155;
      --cert-secondary: #8ea2b7;
      --cert-ink: #0f172a;
      --cert-muted: #64748b;
      --cert-paper: #ffffff;

      padding: 5.8%;
      font-family: 'Space Grotesk', sans-serif;
      border: 0.65cqw solid #334155;
      background:
        linear-gradient(
          rgba(51, 65, 85, 0.045) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(51, 65, 85, 0.045) 1px,
          transparent 1px
        ),
        linear-gradient(
          145deg,
          #ffffff,
          #f1f5f9
        );
      background-size:
        3.4cqw 3.4cqw,
        3.4cqw 3.4cqw,
        auto;
    }

    .tpl-platinum::before {
      content: '';
      position: absolute;
      inset: 2cqw;
      z-index: 3;
      border: 0.18cqw solid rgba(51, 65, 85, 0.4);
      box-shadow:
        inset 0 0 0 0.55cqw rgba(142, 162, 183, 0.08);
      pointer-events: none;
    }

    .tpl-platinum::after {
      content: 'DIGITAL CREDENTIAL • CRYPTOGRAPHICALLY VERIFIABLE';
      position: absolute;
      left: 50%;
      bottom: 2.15cqw;
      z-index: 4;
      transform: translateX(-50%);
      color: rgba(51, 65, 85, 0.42);
      font-size: 0.58cqi;
      letter-spacing: 0.2em;
      white-space: nowrap;
    }

    .tpl-platinum .cert-title {
      padding: 0.9cqi 1.6cqi;
      border: 0.14cqi solid var(--cert-accent);
      font-size: 3.05cqi;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .tpl-platinum .cert-emblem {
      border-radius: 0;
      transform: rotate(45deg);
    }

    .tpl-platinum .cert-emblem i {
      transform: rotate(-45deg);
    }

    /* =========================================================
       TEMPLATE 9 — MIDNIGHT PRESTIGE
       Dark luxury template with gold and blue security elements.
       ========================================================= */

    .tpl-midnight {
      --cert-accent: #d7b76d;
      --cert-secondary: #8ab4ff;
      --cert-ink: #ffffff;
      --cert-muted: #cbd5e1;
      --cert-paper: #0f172a;

      padding: 5.8%;
      color: #ffffff;
      font-family: 'Cinzel', serif;
      border: 0.8cqw solid #334155;
      background:
        radial-gradient(
          circle at 50% -5%,
          rgba(59, 130, 246, 0.25),
          transparent 36%
        ),
        radial-gradient(
          circle at 80% 90%,
          rgba(215, 183, 109, 0.12),
          transparent 28%
        ),
        linear-gradient(
          150deg,
          #111827,
          #020617
        );
    }

    .tpl-midnight::before {
      content: '';
      position: absolute;
      inset: 1.7cqw;
      z-index: 3;
      border: 0.26cqw double rgba(215, 183, 109, 0.68);
      pointer-events: none;
    }

    .tpl-midnight::after {
      content: '';
      position: absolute;
      inset: 2.8cqw;
      z-index: 3;
      border: 0.09cqw solid rgba(138, 180, 255, 0.28);
      pointer-events: none;
    }

    .tpl-midnight .cert-paper-texture {
      opacity: 0.12;
      mix-blend-mode: screen;
    }

    .tpl-midnight .cert-recipient,
    .tpl-midnight .cert-signature,
    .tpl-midnight .cert-title {
      color: #ffffff;
    }

    .tpl-midnight .cert-description,
    .tpl-midnight .cert-pretitle,
    .tpl-midnight .cert-recipient-label,
    .tpl-midnight .cert-footer-label {
      color: #cbd5e1;
    }

    .tpl-midnight .cert-signature-line {
      border-color: rgba(255, 255, 255, 0.45);
    }

    .tpl-midnight .qr-security-code {
      border-color: rgba(255, 255, 255, 0.35);
    }

    .tpl-midnight .draggable-logo {
      mix-blend-mode: normal;
      filter:
        drop-shadow(
          0 0 8px rgba(255, 255, 255, 0.58)
        );
    }

    /* =========================================================
       TEMPLATE 10 — MINIMAL LUXE
       Vertical side band with open, left-aligned composition.
       ========================================================= */

    .tpl-luxe {
      --cert-accent: #18181b;
      --cert-secondary: #b58b55;
      --cert-ink: #18181b;
      --cert-muted: #71717a;
      --cert-paper: #ffffff;

      padding: 6% 6% 5.5% 10%;
      font-family: 'Montserrat', sans-serif;
      border-left: 6.2cqw solid #18181b;
      border-top: 0.55cqw solid #18181b;
      border-right: 0.55cqw solid #18181b;
      border-bottom: 0.55cqw solid #18181b;
      background:
        linear-gradient(
          90deg,
          rgba(181, 139, 85, 0.08),
          transparent 24%
        ),
        #ffffff;
    }

    .tpl-luxe::before {
      content: 'CREDITY';
      position: absolute;
      left: 1.55cqw;
      top: 50%;
      z-index: 4;
      transform: translateY(-50%) rotate(-90deg);
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.25cqi;
      font-weight: 700;
      letter-spacing: 0.5em;
    }

    .tpl-luxe::after {
      content: '';
      position: absolute;
      top: 4cqw;
      right: 4cqw;
      z-index: 2;
      width: 15cqw;
      height: 15cqw;
      border: 0.24cqw solid rgba(24, 24, 27, 0.08);
      border-radius: 50%;
      box-shadow:
        0 0 0 1cqw rgba(181, 139, 85, 0.035),
        0 0 0 2cqw rgba(24, 24, 27, 0.025);
    }

    .tpl-luxe .cert-emblem {
      margin-left: 0;
      margin-right: 0;
      border-radius: 18%;
      transform: rotate(45deg);
    }

    .tpl-luxe .cert-emblem i {
      transform: rotate(-45deg);
    }

    .tpl-luxe .certificate-content {
      text-align: left;
    }

    .tpl-luxe .cert-description {
      width: 74%;
      margin-left: 0;
    }

    .tpl-luxe .cert-title {
      font-size: 3.15cqi;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* =========================================================
       HORIZONTAL TEMPLATE SELECTOR
       ========================================================= */

    .template-picker {
      display: flex;
      gap: 10px;
      padding-bottom: 8px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .template-picker-button {
      width: 170px;
      min-width: 170px;
      padding: 12px;
      scroll-snap-align: start;
      text-align: left;
      background: #ffffff;
      border: 1px solid #dbe2ea;
      border-radius: 13px;
      transition: all 0.16s ease;
    }

    .template-picker-button:hover {
      background: #f8fbff;
      border-color: #93c5fd;
    }

    .template-picker-button.active {
      background: #eff6ff;
      border-color: #2563eb;
      box-shadow:
        0 0 0 2px rgba(37, 99, 235, 0.08);
    }

    .template-miniature {
      position: relative;
      height: 74px;
      margin-bottom: 10px;
      overflow: hidden;
      border-radius: 8px;
      background: var(--mini-paper);
      border: var(--mini-border);
    }

    .template-miniature::before {
      content: '';
      position: absolute;
      inset: 9px;
      border: 1px solid var(--mini-accent);
      opacity: 0.5;
    }

    .template-miniature::after {
      content: '';
      position: absolute;
      left: 24%;
      right: 24%;
      top: 22px;
      height: 6px;
      border-top: 2px solid var(--mini-accent);
      border-bottom: 1px solid var(--mini-secondary);
    }

    /* =========================================================
       BADGES
       ========================================================= */

    .badge-shape-circle {
      border-radius: 50%;
    }

    .badge-shape-shield {
      clip-path:
        polygon(
          50% 100%,
          6% 77%,
          6% 7%,
          94% 7%,
          94% 77%
        );
    }

    .badge-shape-hexagon {
      clip-path:
        polygon(
          50% 0,
          95% 24%,
          95% 76%,
          50% 100%,
          5% 76%,
          5% 24%
        );
    }

    .badge-shape-diamond {
      clip-path:
        polygon(
          50% 0,
          100% 50%,
          50% 100%,
          0 50%
        );
    }

    .badge-shape-star {
      clip-path:
        polygon(
          50% 0,
          61% 35%,
          98% 35%,
          68% 57%,
          79% 91%,
          50% 70%,
          21% 91%,
          32% 57%,
          2% 35%,
          39% 35%
        );
    }

    .badge-security-ring {
      position: absolute;
      inset: 11%;
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: inherit;
      pointer-events: none;
    }

    .badge-security-ring::before {
      content: '';
      position: absolute;
      inset: 10%;
      border: 1px dashed rgba(255, 255, 255, 0.2);
      border-radius: inherit;
    }

    .mobile-overlay {
      display: none;
    }

    @media (max-width: 1279px) {
      .app-shell {
        display: block;
      }

      .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        width: 304px;
        max-width: calc(100vw - 32px);
        min-width: 0;
        transform: translateX(-100%);
        transition: transform 0.22s ease;
        box-shadow:
          18px 0 40px rgba(15, 23, 42, 0.12);
        z-index: 90;
      }

      .sidebar.open {
        transform: translateX(0);
      }

      .mobile-overlay {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: block;
        background: rgba(15, 23, 42, 0.45);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.22s ease;
      }

      .mobile-overlay.open {
        opacity: 1;
        pointer-events: auto;
      }

      .main-shell {
        width: 100%;
        max-width: 100%;
      }

      .page {
        padding: 16px;
      }

      .two-col-safe,
      .three-col-safe {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .page {
        padding: 12px;
      }

      .safe-table {
        min-width: 720px;
      }

      .template-picker-button {
        width: 150px;
        min-width: 150px;
      }
    }
  </style>
</head>

<body>
  <%
    const safeCredentials =
      typeof badges !== 'undefined' && Array.isArray(badges)
        ? badges
        : [];

    const safeBadges =
      safeCredentials.filter(item =>
        !item.type || item.type === 'badge'
      );

    const safeCertificates =
      safeCredentials.filter(item =>
        item.type === 'certificate'
      );

    const safeTests =
      typeof tests !== 'undefined' && Array.isArray(tests)
        ? tests
        : [];

    const safeEvents =
      typeof events !== 'undefined' && Array.isArray(events)
        ? events
        : [];

    const safeClasses =
      typeof classes !== 'undefined' && Array.isArray(classes)
        ? classes
        : (
            typeof studentKeys !== 'undefined' &&
            Array.isArray(studentKeys)
              ? studentKeys
              : []
          );

    const teacherName =
      user && (user.name || user.fullName || user.username)
        ? (
            user.name ||
            user.fullName ||
            user.username
          )
        : 'Teacher';

    const firstName =
      teacherName.split(' ')[0];

    function assignedForClass(cls) {
      if (Array.isArray(cls.assignedTests)) {
        return cls.assignedTests;
      }

      const ids =
        Array.isArray(cls.assignedTestIds)
          ? cls.assignedTestIds.map(Number)
          : [];

      return safeTests.filter(test =>
        ids.includes(Number(test.id))
      );
    }

    const totalStudents =
      safeClasses.reduce((sum, cls) => {
        if (Array.isArray(cls.students)) {
          return sum + cls.students.length;
        }

        return sum + Number(cls.usageCount || 0);
      }, 0);

    const totalSubmissions =
      typeof submissions !== 'undefined' &&
      Array.isArray(submissions)
        ? submissions.length
        : safeClasses.reduce(
            (sum, cls) =>
              sum + Number(cls.submissionCount || 0),
            0
          );
  %>

  <div
    id="mobileOverlay"
    class="mobile-overlay"
    onclick="closeSidebar()"
  ></div>

  <div class="app-shell">
    <aside
      id="sidebar"
      class="sidebar"
    >
      <div class="sidebar-inner custom-scroll">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0">
              <span class="font-semibold text-xl">C</span>
            </div>

            <div>
              <div class="font-semibold text-xl leading-none">
                Credity
              </div>

              <div class="text-[10px] text-slate-500 uppercase tracking-[0.16em] mt-1">
                Teacher Dashboard
              </div>
            </div>
          </div>

          <button
            type="button"
            onclick="closeSidebar()"
            class="xl:hidden w-9 h-9 rounded-lg border border-slate-200"
          >
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="panel rounded-xl p-4 mb-5">
          <div class="text-sm font-semibold truncate">
            <%= teacherName %>
          </div>

          <div class="text-xs text-slate-500 mt-1">
            Teacher workspace
          </div>
        </div>

        <nav class="space-y-1 mb-6">
          <button
            class="side-link active"
            data-view-link="overview"
            onclick="showView('overview')"
          >
            <i class="fa-solid fa-gauge-high w-5 shrink-0"></i>
            <span>Overview</span>
          </button>

          <button
            class="side-link"
            data-view-link="classes"
            onclick="showView('classes')"
          >
            <i class="fa-solid fa-users-rectangle w-5 shrink-0"></i>
            <span>Classes</span>
          </button>

          <button
            class="side-link"
            data-view-link="tasks"
            onclick="showView('tasks')"
          >
            <i class="fa-solid fa-clipboard-question w-5 shrink-0"></i>
            <span>Assignments</span>
          </button>

          <button
            class="side-link"
            data-view-link="certificates"
            onclick="showView('certificates')"
          >
            <i class="fa-solid fa-certificate w-5 shrink-0"></i>
            <span>Certificates</span>
          </button>

          <button
            class="side-link"
            data-view-link="badges"
            onclick="showView('badges')"
          >
            <i class="fa-solid fa-award w-5 shrink-0"></i>
            <span>Badges</span>
          </button>

          <button
            class="side-link"
            data-view-link="announcements"
            onclick="showView('announcements')"
          >
            <i class="fa-solid fa-bullhorn w-5 shrink-0"></i>
            <span>Announcements</span>
          </button>
        </nav>

        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Class Boxes
            </div>

            <span class="text-xs text-slate-400">
              <%= safeClasses.length %>
            </span>
          </div>

          <div class="space-y-2">
            <% if (safeClasses.length > 0) { %>
              <% safeClasses.forEach((cls, index) => {
                const classTasks =
                  assignedForClass(cls);

                const classStudents =
                  Array.isArray(cls.students)
                    ? cls.students
                    : [];
              %>
                <button
                  type="button"
                  class="class-box <%= index === 0 ? 'active' : '' %>"
                  data-class-button="<%= cls.id %>"
                  onclick="selectClass('<%= cls.id %>')"
                >
                  <div class="flex items-center justify-between gap-2">
                    <div class="text-sm font-semibold truncate">
                      <%= cls.className %>
                    </div>

                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-700 shrink-0">
                      <%= classTasks.length %>
                    </span>
                  </div>

                  <div class="text-xs text-slate-500 muted-active mt-1 truncate">
                    <%= classStudents.length || cls.usageCount || 0 %>
                    students
                  </div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="p-4 rounded-xl border border-dashed border-slate-300 text-center text-sm text-slate-500">
                No classes yet
              </div>
            <% } %>
          </div>
        </div>

        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Assignment Bar
            </div>

            <span class="text-xs text-slate-400">
              <%= safeTests.length %>
            </span>
          </div>

          <div class="space-y-2 max-h-72 overflow-y-auto custom-scroll pr-1">
            <% if (safeTests.length > 0) { %>
              <% safeTests.forEach(test => { %>
                <button
                  type="button"
                  class="task-link w-full text-left px-3 py-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition"
                  data-task-button="<%= test.id %>"
                  onclick="selectTask('<%= test.id %>')"
                >
                  <div class="text-sm font-medium truncate">
                    <%= test.title %>
                  </div>

                  <div class="text-xs text-slate-500 muted-active mt-1 truncate">
                    <%= test.questions ? test.questions.length : 0 %>
                    questions
                  </div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="p-4 rounded-xl border border-dashed border-slate-300 text-center text-sm text-slate-500">
                No assignments yet
              </div>
            <% } %>
          </div>
        </div>

        <div class="space-y-2 mt-6">
          <a
            href="/assessment"
            class="btn btn-primary w-full py-3 flex items-center justify-center gap-2 text-sm"
          >
            <i class="fa-solid fa-plus"></i>
            New Assignment
          </a>

          <a
            href="/logout"
            class="btn btn-light w-full py-3 flex items-center justify-center gap-2 text-sm"
          >
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            Logout
          </a>
        </div>
      </div>
    </aside>

    <main class="main-shell">
      <nav class="xl:hidden sticky top-0 z-50 bg-white border-b border-slate-200">
        <div class="px-4 py-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <button
              type="button"
              onclick="openSidebar()"
              class="w-10 h-10 rounded-lg border border-slate-200"
            >
              <i class="fa-solid fa-bars"></i>
            </button>

            <div>
              <div class="font-semibold leading-none">
                Credity Teacher
              </div>

              <div class="text-[10px] text-slate-500 uppercase tracking-wider mt-1">
                Dashboard
              </div>
            </div>
          </div>

          <a
            href="/assessment"
            class="btn btn-dark px-4 py-2 text-sm"
          >
            New
          </a>
        </div>
      </nav>

      <div class="page">
        <!-- OVERVIEW -->
        <section
          class="view-panel"
          data-view-panel="overview"
        >
          <div class="panel-strong rounded-2xl p-5 md:p-8 mb-6">
            <div class="grid lg:grid-cols-[minmax(0,1.25fr)_minmax(270px,.75fr)] gap-7 items-center">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-blue-100 bg-blue-50 text-blue-700 text-xs font-medium tracking-[0.14em] mb-5">
                  <i class="fa-solid fa-shield-halved"></i>
                  TEACHER ACTION CENTER
                </div>

                <h1 class="text-4xl md:text-6xl font-semibold tracking-tighter leading-none text-slate-950">
                  Welcome back,
                  <%= firstName %>.
                </h1>

                <p class="mt-5 max-w-3xl text-lg md:text-xl text-slate-600 leading-relaxed">
                  Manage classes, assignments, professional
                  credentials, verified badges, scores, and
                  announcements from one workspace.
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                  <a
                    href="/assessment"
                    class="btn btn-primary px-6 py-3.5 inline-flex items-center gap-2"
                  >
                    <i class="fa-solid fa-file-circle-plus"></i>
                    New Assignment
                  </a>

                  <button
                    type="button"
                    onclick="showView('classes')"
                    class="btn btn-light px-6 py-3.5 inline-flex items-center gap-2"
                  >
                    <i class="fa-solid fa-users-rectangle text-emerald-600"></i>
                    View Classes
                  </button>

                  <button
                    type="button"
                    onclick="showView('certificates')"
                    class="btn btn-light px-6 py-3.5 inline-flex items-center gap-2"
                  >
                    <i class="fa-solid fa-certificate text-blue-600"></i>
                    Design Certificate
                  </button>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="panel rounded-xl p-4">
                  <div class="w-10 h-10 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-700 flex items-center justify-center mb-4">
                    <i class="fa-solid fa-users-rectangle"></i>
                  </div>

                  <div class="text-3xl md:text-4xl font-semibold">
                    <%= safeClasses.length %>
                  </div>

                  <div class="text-xs text-slate-500 uppercase tracking-wider">
                    Classes
                  </div>
                </div>

                <div class="panel rounded-xl p-4">
                  <div class="w-10 h-10 rounded-lg bg-blue-50 border border-blue-100 text-blue-700 flex items-center justify-center mb-4">
                    <i class="fa-solid fa-clipboard-question"></i>
                  </div>

                  <div class="text-3xl md:text-4xl font-semibold">
                    <%= safeTests.length %>
                  </div>

                  <div class="text-xs text-slate-500 uppercase tracking-wider">
                    Assignments
                  </div>
                </div>

                <div class="panel rounded-xl p-4">
                  <div class="w-10 h-10 rounded-lg bg-violet-50 border border-violet-100 text-violet-700 flex items-center justify-center mb-4">
                    <i class="fa-solid fa-user-group"></i>
                  </div>

                  <div class="text-3xl md:text-4xl font-semibold">
                    <%= totalStudents %>
                  </div>

                  <div class="text-xs text-slate-500 uppercase tracking-wider">
                    Students
                  </div>
                </div>

                <div class="panel rounded-xl p-4">
                  <div class="w-10 h-10 rounded-lg bg-amber-50 border border-amber-100 text-amber-700 flex items-center justify-center mb-4">
                    <i class="fa-solid fa-square-poll-vertical"></i>
                  </div>

                  <div class="text-3xl md:text-4xl font-semibold">
                    <%= totalSubmissions %>
                  </div>

                  <div class="text-xs text-slate-500 uppercase tracking-wider">
                    Submissions
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="grid-safe">
            <% if (safeClasses.length > 0) { %>
              <% safeClasses.forEach(cls => {
                const classTasks =
                  assignedForClass(cls);

                const classStudents =
                  Array.isArray(cls.students)
                    ? cls.students
                    : [];

                const classResults =
                  Array.isArray(cls.results)
                    ? cls.results
                    : [];
              %>
                <button
                  type="button"
                  onclick="selectClass('<%= cls.id %>')"
                  class="panel-strong rounded-2xl p-5 text-left hover:border-blue-300 transition"
                >
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <div class="text-lg font-semibold truncate">
                        <%= cls.className %>
                      </div>

                      <div class="text-sm text-slate-500 mt-1 truncate">
                        <%= cls.key %>
                      </div>
                    </div>

                    <i class="fa-solid fa-arrow-right text-slate-300"></i>
                  </div>

                  <div class="grid grid-cols-3 gap-2 mt-5">
                    <div class="p-3 rounded-lg bg-slate-50 border border-slate-200">
                      <div class="text-[10px] text-slate-500 uppercase tracking-wider">
                        Tasks
                      </div>

                      <div class="text-xl font-semibold mt-1">
                        <%= classTasks.length %>
                      </div>
                    </div>

                    <div class="p-3 rounded-lg bg-slate-50 border border-slate-200">
                      <div class="text-[10px] text-slate-500 uppercase tracking-wider">
                        Students
                      </div>

                      <div class="text-xl font-semibold mt-1">
                        <%= classStudents.length || cls.usageCount || 0 %>
                      </div>
                    </div>

                    <div class="p-3 rounded-lg bg-slate-50 border border-slate-200">
                      <div class="text-[10px] text-slate-500 uppercase tracking-wider">
                        Scores
                      </div>

                      <div class="text-xl font-semibold mt-1">
                        <%= classResults.length %>
                      </div>
                    </div>
                  </div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="panel-strong rounded-2xl p-10 text-center">
                <i class="fa-solid fa-users-rectangle text-4xl text-slate-300 mb-4"></i>

                <div class="text-xl font-semibold">
                  No classes yet
                </div>

                <p class="text-slate-500 mt-2">
                  Create your first class from the Classes section.
                </p>
              </div>
            <% } %>
          </div>
        </section>

        <!-- CLASSES -->
        <section
          class="view-panel hidden"
          data-view-panel="classes"
        >
          <div class="grid lg:grid-cols-[minmax(260px,360px)_minmax(0,1fr)] gap-6">
            <div class="panel-strong rounded-2xl p-5 md:p-6 h-fit">
              <h2 class="text-2xl font-semibold">
                Create Class
              </h2>

              <p class="text-sm text-slate-500 mt-1 mb-6">
                Generate a class key and share it with students.
              </p>

              <form
                action="/generate-student-key"
                method="POST"
                class="space-y-5"
              >
                <div>
                  <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">
                    Class Name
                  </label>

                  <input
                    type="text"
                    name="className"
                    placeholder="Grade 10A - Mathematics"
                    class="input px-4 py-3 rounded-lg"
                    required
                  >
                </div>

                <button
                  type="submit"
                  class="btn btn-green w-full py-4"
                >
                  Generate Class Key
                </button>
              </form>
            </div>

            <div>
              <% if (safeClasses.length > 0) { %>
                <% safeClasses.forEach((cls, classIndex) => {
                  const assignedTests =
                    assignedForClass(cls);

                  const classAnnouncements =
                    Array.isArray(cls.announcements)
                      ? cls.announcements
                      : [];

                  const students =
                    Array.isArray(cls.students)
                      ? cls.students
                      : [];

                  const results =
                    Array.isArray(cls.results)
                      ? cls.results
                      : [];
                %>
                  <div
                    class="class-panel panel-strong rounded-2xl p-5 md:p-6 <%= classIndex === 0 ? '' : 'hidden' %>"
                    data-class-panel="<%= cls.id %>"
                  >
                    <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-5">
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <h3 class="text-2xl md:text-3xl font-semibold break-anywhere">
                            <%= cls.className %>
                          </h3>

                          <span class="px-3 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700 text-[10px] font-medium">
                            <%= cls.active === false ? 'DISABLED' : 'ACTIVE' %>
                          </span>
                        </div>

                        <div class="text-sm text-slate-500 mt-1">
                          <%= students.length || cls.usageCount || 0 %>
                          students •
                          <%= assignedTests.length %>
                          assignments •
                          <%= results.length %>
                          submissions
                        </div>
                      </div>

                      <div class="flex flex-wrap gap-2">
                        <code class="max-w-full px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 text-xs font-semibold tracking-wider overflow-x-auto">
                          <%= cls.key %>
                        </code>

                        <button
                          type="button"
                          onclick="copyText('<%= cls.key %>')"
                          class="btn btn-dark px-3 py-2 text-xs"
                        >
                          Copy
                        </button>
                      </div>
                    </div>

                    <div class="three-col-safe mt-6">
                      <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
                        <div class="text-xs text-slate-500 uppercase tracking-wider">
                          Students
                        </div>

                        <div class="text-3xl font-semibold mt-1">
                          <%= students.length || cls.usageCount || 0 %>
                        </div>
                      </div>

                      <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
                        <div class="text-xs text-slate-500 uppercase tracking-wider">
                          Assignments
                        </div>

                        <div class="text-3xl font-semibold mt-1">
                          <%= assignedTests.length %>
                        </div>
                      </div>

                      <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
                        <div class="text-xs text-slate-500 uppercase tracking-wider">
                          Submissions
                        </div>

                        <div class="text-3xl font-semibold mt-1">
                          <%= results.length %>
                        </div>
                      </div>
                    </div>

                    <div class="two-col-safe mt-6">
                      <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <div class="flex items-center justify-between gap-3 mb-4">
                          <div>
                            <div class="font-semibold">
                              Class Assignments
                            </div>

                            <p class="text-xs text-slate-500 mt-1">
                              Assign existing work or create a new test.
                            </p>
                          </div>

                          <a
                            href="/assessment?classId=<%= cls.id %>"
                            class="btn btn-primary px-3 py-2 text-xs"
                          >
                            New
                          </a>
                        </div>

                        <form
                          action="/assign-class-test"
                          method="POST"
                          class="grid sm:grid-cols-[minmax(0,1fr)_auto] gap-2"
                        >
                          <input
                            type="hidden"
                            name="classId"
                            value="<%= cls.id %>"
                          >

                          <select
                            name="testId"
                            class="input px-4 py-3 rounded-lg text-sm"
                            required
                          >
                            <option value="">
                              Select assignment...
                            </option>

                            <% safeTests.forEach(test => { %>
                              <option value="<%= test.id %>">
                                <%= test.title %>
                              </option>
                            <% }) %>
                          </select>

                          <button
                            type="submit"
                            class="btn btn-dark px-5 py-3 text-sm"
                          >
                            Assign
                          </button>
                        </form>

                        <div class="mt-4 space-y-2">
                          <% if (assignedTests.length > 0) { %>
                            <% assignedTests.forEach(test => { %>
                              <div class="p-3 rounded-lg bg-white border border-slate-200">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                  <div>
                                    <div class="text-sm font-medium break-anywhere">
                                      <%= test.title %>
                                    </div>

                                    <div class="text-xs text-slate-500 mt-1">
                                      <%= test.questions ? test.questions.length : 0 %>
                                      questions
                                    </div>
                                  </div>

                                  <div class="flex flex-wrap gap-2">
                                    <form
                                      action="/unassign-class-test"
                                      method="POST"
                                    >
                                      <input
                                        type="hidden"
                                        name="classId"
                                        value="<%= cls.id %>"
                                      >

                                      <input
                                        type="hidden"
                                        name="testId"
                                        value="<%= test.id %>"
                                      >

                                      <button
                                        type="submit"
                                        class="btn btn-light px-3 py-2 text-xs"
                                      >
                                        Unassign
                                      </button>
                                    </form>

                                    <form
                                      action="/delete-test"
                                      method="POST"
                                      onsubmit="return confirm('Delete this assignment permanently?');"
                                    >
                                      <input
                                        type="hidden"
                                        name="testId"
                                        value="<%= test.id %>"
                                      >

                                      <button
                                        type="submit"
                                        class="btn btn-red px-3 py-2 text-xs"
                                      >
                                        Delete
                                      </button>
                                    </form>
                                  </div>
                                </div>
                              </div>
                            <% }) %>
                          <% } else { %>
                            <div class="p-4 rounded-lg bg-white border border-dashed border-slate-300 text-sm text-slate-500 text-center">
                              No assignments attached.
                            </div>
                          <% } %>
                        </div>
                      </div>

                      <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <div class="font-semibold">
                          Class Announcement
                        </div>

                        <p class="text-xs text-slate-500 mt-1 mb-4">
                          Only members of this class will see it.
                        </p>

                        <form
                          action="/class-announcement"
                          method="POST"
                          class="space-y-3"
                        >
                          <input
                            type="hidden"
                            name="classId"
                            value="<%= cls.id %>"
                          >

                          <input
                            type="text"
                            name="title"
                            placeholder="Announcement title"
                            class="input px-4 py-3 rounded-lg text-sm"
                            required
                          >

                          <textarea
                            name="description"
                            placeholder="Write an announcement..."
                            class="input px-4 py-3 rounded-lg h-24 text-sm"
                          ></textarea>

                          <button
                            type="submit"
                            class="btn btn-purple w-full py-3 text-sm"
                          >
                            Post to Class
                          </button>
                        </form>

                        <div class="mt-4 space-y-2 max-h-48 overflow-y-auto custom-scroll">
                          <% if (classAnnouncements.length > 0) { %>
                            <% classAnnouncements.slice().reverse().forEach(item => { %>
                              <div class="p-3 rounded-lg bg-white border border-slate-200">
                                <div class="text-sm font-medium break-anywhere">
                                  <%= item.title %>
                                </div>

                                <div class="text-xs text-slate-500 mt-1 break-anywhere">
                                  <%= item.description || 'No description.' %>
                                </div>
                              </div>
                            <% }) %>
                          <% } else { %>
                            <div class="p-4 rounded-lg bg-white border border-dashed border-slate-300 text-sm text-slate-500 text-center">
                              No announcements yet.
                            </div>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="mt-6 rounded-xl border border-slate-200 overflow-hidden">
                      <div class="px-5 py-4 bg-slate-50 border-b border-slate-200">
                        <div class="font-semibold">
                          Students and Scores
                        </div>

                        <div class="text-xs text-slate-500 mt-1">
                          Names, emails, completion progress, and scores.
                        </div>
                      </div>

                      <% if (students.length > 0) { %>
                        <div class="table-wrap custom-scroll">
                          <table class="safe-table text-left text-sm">
                            <thead>
                              <tr class="border-b border-slate-200 text-xs text-slate-500 uppercase tracking-wider">
                                <th class="px-5 py-3 font-medium">
                                  Student
                                </th>

                                <th class="px-5 py-3 font-medium">
                                  Email
                                </th>

                                <th class="px-5 py-3 font-medium">
                                  Joined
                                </th>

                                <th class="px-5 py-3 font-medium">
                                  Completed
                                </th>

                                <th class="px-5 py-3 font-medium">
                                  Pending
                                </th>

                                <th class="px-5 py-3 font-medium">
                                  Average
                                </th>
                              </tr>
                            </thead>

                            <tbody class="divide-y divide-slate-100">
                              <% students.forEach(student => { %>
                                <tr class="hover:bg-slate-50">
                                  <td class="px-5 py-4">
                                    <div class="font-medium break-anywhere">
                                      <%= student.fullName || student.name || 'Student' %>
                                    </div>

                                    <div class="text-xs text-slate-500">
                                      ID:
                                      <%= student.userId %>
                                    </div>
                                  </td>

                                  <td class="px-5 py-4 text-slate-600 break-anywhere">
                                    <%= student.email || 'No email' %>
                                  </td>

                                  <td class="px-5 py-4 text-slate-600 whitespace-nowrap">
                                    <%= student.joinedAtFormatted || '—' %>
                                  </td>

                                  <td class="px-5 py-4">
                                    <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700 text-xs">
                                      <%= student.completedCount || 0 %>
                                    </span>
                                  </td>

                                  <td class="px-5 py-4">
                                    <span class="px-2.5 py-1 rounded-full bg-amber-50 border border-amber-100 text-amber-700 text-xs">
                                      <%= student.pendingCount || 0 %>
                                    </span>
                                  </td>

                                  <td class="px-5 py-4">
                                    <% if (
                                      student.averageScore !== null &&
                                      student.averageScore !== undefined
                                    ) { %>
                                      <span class="font-semibold">
                                        <%= student.averageScore %>%
                                      </span>
                                    <% } else { %>
                                      <span class="text-slate-400">
                                        No score
                                      </span>
                                    <% } %>
                                  </td>
                                </tr>

                                <% if (
                                  Array.isArray(student.submissions) &&
                                  student.submissions.length > 0
                                ) { %>
                                  <tr class="bg-slate-50">
                                    <td
                                      colspan="6"
                                      class="px-5 py-4"
                                    >
                                      <div class="grid md:grid-cols-2 gap-2">
                                        <% student.submissions.forEach(submission => { %>
                                          <div class="p-3 rounded-lg bg-white border border-slate-200 flex items-center justify-between gap-3">
                                            <div>
                                              <div class="text-sm font-medium break-anywhere">
                                                <%= submission.testTitle %>
                                              </div>

                                              <div class="text-xs text-slate-500 mt-1">
                                                <%= submission.submittedAtFormatted || '' %>
                                              </div>
                                            </div>

                                            <div class="font-semibold <%= submission.passed ? 'text-emerald-700' : 'text-red-600' %>">
                                              <%= submission.score %>%
                                            </div>
                                          </div>
                                        <% }) %>
                                      </div>
                                    </td>
                                  </tr>
                                <% } %>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                      <% } else { %>
                        <div class="p-10 text-center">
                          <i class="fa-solid fa-user-group text-4xl text-slate-300 mb-4"></i>

                          <div class="font-semibold">
                            No students joined
                          </div>

                          <p class="text-sm text-slate-500 mt-1">
                            Share the class key with your students.
                          </p>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="panel-strong rounded-2xl p-12 text-center">
                  <i class="fa-solid fa-users-rectangle text-5xl text-slate-300 mb-5"></i>

                  <div class="text-2xl font-semibold">
                    No classes yet
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- ASSIGNMENTS -->
        <section
          class="view-panel hidden"
          data-view-panel="tasks"
        >
          <div class="panel-strong rounded-2xl p-5 md:p-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
              <div>
                <h2 class="text-3xl font-semibold tracking-tight">
                  Assignments
                </h2>

