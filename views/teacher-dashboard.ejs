<!DOCTYPE html>
<!-- Credity Teacher Dashboard Enhanced v5 | Courses & Modules integration -->
<html lang="en" data-dashboard-version="enhanced-v5">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="credity-dashboard-version" content="enhanced-v5-courses" />
  <title>Teacher Dashboard • Credity</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    * { box-sizing: border-box; min-width: 0; }
    html, body { width: 100%; max-width: 100%; margin: 0; overflow-x: hidden; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #f5f7fa; color: #0f172a; -webkit-font-smoothing: antialiased; }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }

    .app-shell { width: 100%; max-width: 100vw; min-height: 100vh; display: flex; overflow-x: hidden; }
    .sidebar { position: sticky; top: 0; width: 304px; min-width: 304px; max-width: 304px; height: 100vh; background: #ffffff; border-right: 1px solid #e2e8f0; z-index: 50; overflow: hidden; }
    .sidebar-inner { width: 100%; height: 100%; padding: 18px; overflow-y: auto; overflow-x: hidden; }
    .main-shell { flex: 1; width: calc(100vw - 304px); max-width: calc(100vw - 304px); overflow-x: hidden; }
    .page { width: 100%; max-width: 100%; padding: 24px; }
    
    .panel { background: #ffffff; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.035); }
    .panel-strong { background: #ffffff; border: 1px solid #dbe2ea; box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05); }
    
    .input { width: 100%; max-width: 100%; background: #ffffff; border: 1px solid #d7dee8; color: #0f172a; outline: none; transition: border-color 0.16s ease, box-shadow 0.16s ease; }
    .input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }
    textarea.input { resize: vertical; }

    .btn { max-width: 100%; border-radius: 11px; font-weight: 500; text-align: center; transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.16s ease; }
    .btn:active { transform: translateY(1px); }
    .btn-primary { color: #ffffff; background: #1d4ed8; border: 1px solid #1d4ed8; }
    .btn-primary:hover { background: #1e40af; border-color: #1e40af; }
    .btn-dark { color: #ffffff; background: #111827; border: 1px solid #111827; }
    .btn-dark:hover { background: #030712; }
    .btn-light { color: #111827; background: #ffffff; border: 1px solid #d7dee8; }
    .btn-light:hover { background: #f8fafc; }
    .btn-green { color: #ffffff; background: #059669; border: 1px solid #059669; }
    .btn-purple { color: #ffffff; background: #7c3aed; border: 1px solid #7c3aed; }
    .btn-red { color: #ffffff; background: #dc2626; border: 1px solid #dc2626; }

    .side-link { width: 100%; display: flex; align-items: center; gap: 10px; padding: 11px 12px; border: 1px solid transparent; border-radius: 12px; background: transparent; color: #475569; font-size: 14px; font-weight: 500; transition: all 0.16s ease; }
    .side-link:hover { color: #0f172a; background: #f1f5f9; }
    .side-link.active { color: #1d4ed8; background: #eff6ff; border-color: #bfdbfe; }

    .class-box { width: 100%; padding: 14px; overflow: hidden; text-align: left; color: #0f172a; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 15px; transition: all 0.16s ease; }
    .class-box:hover { background: #f8fafc; border-color: #bfdbfe; }
    .class-box.active { color: #ffffff; background: #111827; border-color: #111827; }
    .class-box.active .muted-active, .task-link.active .muted-active { color: rgba(255, 255, 255, 0.66); }
    .task-link.active { color: #ffffff; background: #111827; border-color: #111827; }

    .grid-safe { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; width: 100%; max-width: 100%; }
    .two-col-safe { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; width: 100%; }
    .table-wrap { width: 100%; max-width: 100%; overflow-x: auto; }
    .safe-table { width: 100%; min-width: 780px; border-collapse: collapse; }

    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #eef2f7; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #c4cdd9; border-radius: 999px; }

    .mobile-overlay { display: none; }

    @media (max-width: 1279px) {
      .app-shell { display: block; }
      .sidebar { position: fixed; left: 0; top: 0; width: 304px; max-width: calc(100vw - 32px); min-width: 0; transform: translateX(-100%); transition: transform 0.22s ease; box-shadow: 18px 0 40px rgba(15, 23, 42, 0.12); z-index: 90; }
      .sidebar.open { transform: translateX(0); }
      .mobile-overlay { position: fixed; inset: 0; display: block; background: rgba(15, 23, 42, 0.45); opacity: 0; pointer-events: none; transition: opacity 0.22s ease; z-index: 80; }
      .mobile-overlay.open { opacity: 1; pointer-events: auto; }
      .main-shell { width: 100%; max-width: 100%; }
      .page { padding: 16px; }
      .two-col-safe { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <%
    // Ensure data variables are defined safely
    const safeTests = typeof tests !== 'undefined' && Array.isArray(tests) ? tests : [];
    const safeEvents = typeof events !== 'undefined' && Array.isArray(events) ? events : [];
    const safeClasses = typeof classes !== 'undefined' && Array.isArray(classes) ? classes : (typeof studentKeys !== 'undefined' && Array.isArray(studentKeys) ? studentKeys : []);
    const safeCourses = typeof courses !== 'undefined' && Array.isArray(courses) ? courses : [];
    const safeGlobalSubmissions = typeof submissions !== 'undefined' && Array.isArray(submissions) ? submissions : [];
    
    const safeUser = typeof user !== 'undefined' && user ? user : {};
    const teacherName = safeUser.name || safeUser.fullName || safeUser.username || 'Teacher';
    const firstName = String(teacherName).split(' ')[0];

    function assignedForClass(cls) {
      if (Array.isArray(cls.assignedTests)) return cls.assignedTests;
      const ids = Array.isArray(cls.assignedTestIds) ? cls.assignedTestIds.map(Number) : [];
      return safeTests.filter(test => ids.includes(Number(test.id)));
    }

    const totalStudents = safeClasses.reduce((sum, cls) => {
      if (Array.isArray(cls.students)) return sum + cls.students.length;
      return sum + Number(cls.usageCount || 0);
    }, 0);

    const totalSubmissions = safeClasses.reduce((sum, cls) => sum + Number(cls.submissionCount || 0), 0);
  %>

  <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>

  <div class="app-shell">
    <aside id="sidebar" class="sidebar">
      <div class="sidebar-inner custom-scroll">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0">
              <span class="font-semibold text-xl">C</span>
            </div>
            <div>
              <div class="font-semibold text-xl leading-none">Credity</div>
              <div class="text-[10px] text-slate-500 uppercase tracking-[0.16em] mt-1">Teacher Dashboard</div>
            </div>
          </div>
          <button type="button" onclick="closeSidebar()" class="xl:hidden w-9 h-9 rounded-lg border border-slate-200">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="panel rounded-xl p-4 mb-5">
          <div class="text-sm font-semibold truncate"><%= teacherName %></div>
          <div class="text-xs text-slate-500 mt-1">Teacher workspace</div>
        </div>

        <nav class="space-y-1 mb-6">
          <button class="side-link active" data-view-link="overview" onclick="showView('overview')">
            <i class="fa-solid fa-gauge-high w-5 shrink-0"></i>
            <span>Overview</span>
          </button>
          <button class="side-link" data-view-link="classes" onclick="showView('classes')">
            <i class="fa-solid fa-users-rectangle w-5 shrink-0"></i>
            <span>Classes</span>
          </button>
          <button class="side-link" data-view-link="tasks" onclick="showView('tasks')">
            <i class="fa-solid fa-clipboard-question w-5 shrink-0"></i>
            <span>Assignments / Tests</span>
          </button>
          <button class="side-link" data-view-link="courses" onclick="showView('courses')">
            <i class="fa-solid fa-book-open-reader w-5 shrink-0"></i>
            <span>Courses & Modules</span>
          </button>
          <button class="side-link" data-view-link="announcements" onclick="showView('announcements')">
            <i class="fa-solid fa-bullhorn w-5 shrink-0"></i>
            <span>Announcements</span>
          </button>
        </nav>

        <div class="mb-5">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Class Boxes</div>
            <span class="text-xs text-slate-400"><%= safeClasses.length %></span>
          </div>
          <div class="space-y-2">
            <% if (safeClasses.length > 0) { %>
              <% safeClasses.forEach((cls, index) => {
                const classTasks = assignedForClass(cls);
                const classStudents = Array.isArray(cls.students) ? cls.students : [];
              %>
                <button type="button" class="class-box <%= index === 0 ? 'active' : '' %>" data-class-button="<%= cls.id %>" onclick="selectClass('<%= cls.id %>')">
                  <div class="flex items-center justify-between gap-2">
                    <div class="text-sm font-semibold truncate"><%= cls.className %></div>
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-700 shrink-0"><%= classTasks.length %></span>
                  </div>
                  <div class="text-xs text-slate-500 muted-active mt-1 truncate">
                    <%= classStudents.length || cls.usageCount || 0 %> students
                  </div>
                </button>
              <% }) %>
            <% } else { %>
              <div class="p-4 rounded-xl border border-dashed border-slate-300 text-center text-sm text-slate-500">
                No classes yet
              </div>
            <% } %>
          </div>
        </div>

        <div class="space-y-2 mt-6">
          <a href="/logout" class="btn btn-light w-full py-3 flex items-center justify-center gap-2 text-sm">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            Logout
          </a>
        </div>
      </div>
    </aside>

    <main class="main-shell">
      <nav class="xl:hidden sticky top-0 z-50 bg-white border-b border-slate-200">
        <div class="px-4 py-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <button type="button" onclick="openSidebar()" class="w-10 h-10 rounded-lg border border-slate-200">
              <i class="fa-solid fa-bars"></i>
            </button>
            <div>
              <div class="font-semibold leading-none">Credity Teacher</div>
              <div class="text-[10px] text-slate-500 uppercase tracking-wider mt-1">Dashboard</div>
            </div>
          </div>
        </div>
      </nav>

      <div class="page">
        <!-- OVERVIEW -->
        <section class="view-panel" data-view-panel="overview">
          <div class="panel-strong rounded-2xl p-5 md:p-8 mb-6">
            <div class="grid lg:grid-cols-[minmax(0,1.25fr)_minmax(270px,.75fr)] gap-7 items-center">
              <div>
                <h1 class="text-4xl md:text-6xl font-semibold tracking-tighter leading-none text-slate-950">
                  Welcome back, <%= firstName %>.
                </h1>
                <p class="mt-5 max-w-3xl text-lg md:text-xl text-slate-600 leading-relaxed">
                  Manage classes, assignments, courses, modules, and announcements.
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                  <a href="/assessment" class="btn btn-primary px-6 py-3.5 inline-flex items-center gap-2">
                    <i class="fa-solid fa-file-circle-plus"></i>
                    New Assignment
                  </a>
                  <button type="button" onclick="showView('courses')" class="btn btn-light px-6 py-3.5 inline-flex items-center gap-2">
                    <i class="fa-solid fa-book-open text-purple-600"></i>
                    Build Course
                  </button>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="panel rounded-xl p-4">
                  <div class="text-3xl md:text-4xl font-semibold"><%= safeClasses.length %></div>
                  <div class="text-xs text-slate-500 uppercase tracking-wider">Classes</div>
                </div>
                <div class="panel rounded-xl p-4">
                  <div class="text-3xl md:text-4xl font-semibold"><%= safeTests.length %></div>
                  <div class="text-xs text-slate-500 uppercase tracking-wider">Assignments</div>
                </div>
                <div class="panel rounded-xl p-4">
                  <div class="text-3xl md:text-4xl font-semibold"><%= totalStudents %></div>
                  <div class="text-xs text-slate-500 uppercase tracking-wider">Students</div>
                </div>
                <div class="panel rounded-xl p-4">
                  <div class="text-3xl md:text-4xl font-semibold"><%= safeCourses.length %></div>
                  <div class="text-xs text-slate-500 uppercase tracking-wider">Courses</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- CLASSES -->
        <section class="view-panel hidden" data-view-panel="classes">
          <div class="grid lg:grid-cols-[minmax(260px,360px)_minmax(0,1fr)] gap-6">
            <div class="panel-strong rounded-2xl p-5 md:p-6 h-fit">
              <h2 class="text-2xl font-semibold">Create Class</h2>
              <p class="text-sm text-slate-500 mt-1 mb-6">Generate a class key and share it with students.</p>
              <form action="/generate-student-key" method="POST" class="space-y-5">
                <div>
                  <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Class Name</label>
                  <input type="text" name="className" placeholder="Grade 10A - Mathematics" class="input px-4 py-3 rounded-lg" required>
                </div>
                <button type="submit" class="btn btn-green w-full py-4">Generate Class Key</button>
              </form>
            </div>

            <div>
              <% if (safeClasses.length > 0) { %>
                <% safeClasses.forEach((cls, classIndex) => {
                  const assignedTests = assignedForClass(cls);
                  const classAnnouncements = Array.isArray(cls.announcements) ? cls.announcements : [];
                  const students = Array.isArray(cls.students) ? cls.students : [];
                %>
                  <div class="class-panel panel-strong rounded-2xl p-5 md:p-6 <%= classIndex === 0 ? '' : 'hidden' %>" data-class-panel="<%= cls.id %>">
                    <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-5">
                      <div>
                        <h3 class="text-2xl md:text-3xl font-semibold"><%= cls.className %></h3>
                        <div class="text-sm text-slate-500 mt-1">
                          <%= students.length || cls.usageCount || 0 %> students • <%= assignedTests.length %> assignments
                        </div>
                      </div>
                      <div class="flex flex-wrap gap-2">
                        <code class="max-w-full px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 text-xs font-semibold tracking-wider overflow-x-auto"><%= cls.key %></code>
                      </div>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="panel-strong rounded-2xl p-12 text-center">No classes yet.</div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- ASSIGNMENTS -->
        <section class="view-panel hidden" data-view-panel="tasks">
          <div class="panel-strong rounded-2xl p-5 md:p-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
              <div>
                <h2 class="text-3xl font-semibold tracking-tight">Assignments / Tests</h2>
                <p class="text-slate-500 mt-1">Create, review, and delete assessments.</p>
              </div>
              <a href="/assessment" class="btn btn-primary px-5 py-3 inline-flex items-center gap-2 text-sm">
                <i class="fa-solid fa-plus"></i>
                New Assignment
              </a>
            </div>

            <% if (safeTests.length > 0) { %>
              <div class="grid-safe">
                <% safeTests.forEach(test => { %>
                  <article class="panel rounded-xl p-5 task-card">
                    <h3 class="text-lg font-semibold truncate"><%= test.title %></h3>
                    <p class="text-xs text-slate-500 mt-1"><%= test.questions ? test.questions.length : 0 %> questions</p>
                    <form action="/delete-test" method="POST" class="mt-5" onsubmit="return confirm('Delete this assignment permanently?');">
                      <input type="hidden" name="testId" value="<%= test.id %>">
                      <button type="submit" class="btn btn-red w-full py-3 text-sm">Delete Assignment</button>
                    </form>
                  </article>
                <% }) %>
              </div>
            <% } else { %>
              <div class="p-12 rounded-xl border border-dashed border-slate-300 text-center">No assignments yet.</div>
            <% } %>
          </div>
        </section>

        <!-- COURSES BUILDER -->
        <section class="view-panel hidden" data-view-panel="courses">
          <div class="panel-strong rounded-2xl p-5 md:p-6 space-y-6">
            <div>
              <h2 class="text-3xl font-semibold">Course Builder</h2>
              <p class="text-sm text-slate-500 mt-1">Assign courses with links to files/videos, structured into modules and lessons.</p>
            </div>

            <form action="/create-course" method="POST" id="courseForm">
              
              <!-- Basic Course Info -->
              <div class="grid md:grid-cols-2 gap-5 mb-6">
                <div>
                  <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Course Title</label>
                  <input type="text" name="courseTitle" placeholder="e.g. Master React in 10 Days" class="input px-4 py-3 rounded-lg" required>
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Assign to Class</label>
                  <select name="classId" class="input px-4 py-3 rounded-lg" required>
                    <option value="">Select a class...</option>
                    <% safeClasses.forEach(cls => { %>
                      <option value="<%= cls.id %>"><%= cls.className %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="mb-6">
                <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Course Description</label>
                <textarea name="courseDescription" placeholder="Brief description of the course..." class="input px-4 py-3 rounded-lg h-24"></textarea>
              </div>

              <!-- Pricing Settings -->
              <div class="mb-8 p-5 rounded-xl border border-slate-200 bg-slate-50">
                <h3 class="text-lg font-semibold mb-3">Pricing Settings</h3>
                <div class="flex gap-4 mb-4">
                  <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="pricingType" value="free" checked onchange="togglePaypalForm(this.value)">
                    <span class="text-sm font-medium">Free</span>
                  </label>
                  <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="pricingType" value="paid" onchange="togglePaypalForm(this.value)">
                    <span class="text-sm font-medium">Paid Course</span>
                  </label>
                </div>

                <div id="paypalEmbedSection" class="hidden">
                  <div class="mb-4 bg-white p-4 border border-blue-200 rounded-lg text-sm text-slate-600">
                    <strong class="text-blue-800 block mb-2"><i class="fa-solid fa-circle-info"></i> How to setup paid access via PayPal:</strong>
                    1. Go to your PayPal account and generate a "Buy Now" button.<br>
                    2. Copy the full HTML <strong>Embed Code</strong> provided by PayPal.<br>
                    3. Paste that code exactly into the box below. It should look similar to the example shown in the placeholder.<br>
                    <em>Note: Once a student pays, you will manually grant them access based on PayPal receipts, or they bypass if they paste the transaction ID.</em>
                  </div>
                  <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">PayPal Embed Code (HTML)</label>
                  <textarea name="paypalEmbedCode" placeholder='<div>&#10;<style>.pp-UFWQ9F9J8N7NU{...}</style>&#10;<form action="https://www.paypal.com/..." ...>&#10;...&#10;</form>&#10;</div>' class="input px-4 py-3 rounded-lg h-32 font-mono text-sm"></textarea>
                </div>
              </div>

              <hr class="border-slate-200 mb-8">

              <!-- Modules Section -->
              <div class="mb-6 flex justify-between items-center">
                <h3 class="text-xl font-semibold">Curriculum (Modules & Lessons)</h3>
                <button type="button" onclick="addModule()" class="btn btn-dark px-4 py-2 text-sm">
                  <i class="fa-solid fa-plus mr-1"></i> Add Module
                </button>
              </div>

              <div id="modulesContainer" class="space-y-6">
                <!-- Modules injected here via JS -->
              </div>

              <!-- Final Course Test -->
              <div class="mt-8 p-5 rounded-xl border border-slate-200 bg-white">
                <label class="block text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Final Course Assessment (Optional)</label>
                <select name="finalCourseTestId" class="input px-4 py-3 rounded-lg">
                  <option value="">No final test</option>
                  <% safeTests.forEach(test => { %>
                    <option value="<%= test.id %>"><%= test.title %></option>
                  <% }) %>
                </select>
              </div>

              <button type="submit" class="btn btn-primary w-full py-4 text-lg mt-8">
                <i class="fa-solid fa-cloud-arrow-up mr-2"></i> Save & Publish Course
              </button>
            </form>

            <% if (safeCourses.length > 0) { %>
              <div class="mt-12">
                <h3 class="text-xl font-semibold mb-4">Published Courses</h3>
                <div class="space-y-4">
                  <% safeCourses.forEach(course => { %>
                    <div class="p-5 rounded-xl border border-slate-200 bg-white flex justify-between items-center">
                      <div>
                        <div class="font-semibold text-lg"><%= course.title %></div>
                        <div class="text-sm text-slate-500"><%= course.isPaid ? 'Paid' : 'Free' %> • Assigned to Class ID: <%= course.classId %></div>
                      </div>
                      <form action="/delete-course" method="POST" onsubmit="return confirm('Delete this course?')">
                        <input type="hidden" name="courseId" value="<%= course.id %>">
                        <button class="btn btn-red px-4 py-2 text-sm">Delete</button>
                      </form>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>

          </div>
        </section>

        <!-- ANNOUNCEMENTS -->
        <section class="view-panel hidden" data-view-panel="announcements">
          <div class="grid lg:grid-cols-[minmax(260px,420px)_minmax(0,1fr)] gap-6">
            <div class="panel-strong rounded-2xl p-5 md:p-6 h-fit">
              <h2 class="text-2xl font-semibold">Global Announcement</h2>
              <form action="/post-event" method="POST" class="space-y-5 mt-6">
                <input type="text" name="title" placeholder="Announcement title" class="input px-4 py-3 rounded-lg" required>
                <textarea name="description" placeholder="Announcement details..." class="input px-4 py-3 rounded-lg h-28 text-sm"></textarea>
                <button type="submit" class="btn btn-purple w-full py-4">Publish Announcement</button>
              </form>
            </div>
            <div class="panel-strong rounded-2xl p-5 md:p-6">
              <h3 class="text-2xl font-semibold mb-5">Published Announcements</h3>
              <% if (safeEvents.length > 0) { %>
                <div class="space-y-3 max-h-[34rem] overflow-y-auto custom-scroll">
                  <% safeEvents.slice().reverse().forEach(item => { %>
                    <div class="p-5 rounded-xl border border-slate-200">
                      <div class="font-semibold"><%= item.title %></div>
                      <p class="text-sm text-slate-500 mt-2"><%= item.description || 'No description.' %></p>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="p-12 rounded-xl border border-dashed border-slate-300 text-center">No announcements yet.</div>
              <% } %>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    // Navigation handling
    function openSidebar() {
      document.getElementById('sidebar').classList.add('open');
      document.getElementById('mobileOverlay').classList.add('open');
    }
    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('mobileOverlay').classList.remove('open');
    }
    function showView(view) {
      document.querySelectorAll('.view-panel').forEach(panel => panel.classList.add('hidden'));
      const selectedPanel = document.querySelector(`[data-view-panel="${view}"]`);
      if (selectedPanel) selectedPanel.classList.remove('hidden');

      document.querySelectorAll('[data-view-link]').forEach(link => link.classList.remove('active'));
      const selectedLink = document.querySelector(`[data-view-link="${view}"]`);
      if (selectedLink) selectedLink.classList.add('active');

      history.replaceState(null, '', `#${view}`);
      closeSidebar();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function selectClass(classId) {
      showView('classes');
      document.querySelectorAll('[data-class-button]').forEach(button => button.classList.remove('active'));
      const classButton = document.querySelector(`[data-class-button="${classId}"]`);
      if (classButton) classButton.classList.add('active');

      document.querySelectorAll('[data-class-panel]').forEach(panel => panel.classList.add('hidden'));
      const classPanel = document.querySelector(`[data-class-panel="${classId}"]`);
      if (classPanel) classPanel.classList.remove('hidden');
    }

    // Hash navigation routing
    const hash = window.location.hash.replace('#', '');
    if (hash && document.querySelector(`[data-view-panel="${hash}"]`)) {
      showView(hash);
    } else {
      showView('overview');
    }

    // Courses UI Handling
    function togglePaypalForm(val) {
      const el = document.getElementById('paypalEmbedSection');
      if (val === 'paid') {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    }

    let moduleCounter = 0;
    const existingTestsOptions = `<%- safeTests.map(t => `<option value="${t.id}">${t.title.replace(/"/g, '&quot;')}</option>`).join('') %>`;

    function addModule() {
      moduleCounter++;
      const container = document.getElementById('modulesContainer');
      
      const moduleHtml = `
        <div class="panel p-5 rounded-xl bg-slate-50" id="module_${moduleCounter}">
          <div class="flex justify-between items-center mb-4">
            <h4 class="font-semibold text-lg">Module ${moduleCounter}</h4>
            <button type="button" onclick="document.getElementById('module_${moduleCounter}').remove()" class="text-red-500 text-sm font-medium"><i class="fa-solid fa-trash"></i> Remove</button>
          </div>
          
          <input type="text" name="modules[${moduleCounter}][title]" placeholder="Module Title (e.g. Introduction)" class="input px-4 py-3 rounded-lg w-full mb-4" required>
          
          <div class="mb-4">
             <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Module Test (Optional)</label>
             <select name="modules[${moduleCounter}][testId]" class="input px-4 py-2 rounded-lg text-sm w-full">
               <option value="">No test for this module</option>
               ${existingTestsOptions}
             </select>
          </div>

          <div id="lessons_container_${moduleCounter}" class="space-y-3 pl-4 border-l-2 border-blue-200">
            <!-- Lessons go here -->
          </div>

          <button type="button" onclick="addLesson(${moduleCounter})" class="btn btn-light px-4 py-2 text-sm mt-4">
            <i class="fa-solid fa-plus text-blue-600 mr-1"></i> Add Lesson
          </button>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', moduleHtml);
      addLesson(moduleCounter); // add one default lesson
    }

    function addLesson(modId) {
      const container = document.getElementById(`lessons_container_${modId}`);
      const lessonCount = container.children.length + 1;
      
      const lessonHtml = `
        <div class="bg-white p-4 rounded-lg border border-slate-200 relative">
          <button type="button" onclick="this.parentElement.remove()" class="absolute top-2 right-2 text-slate-400 hover:text-red-500"><i class="fa-solid fa-xmark"></i></button>
          <div class="font-medium text-sm mb-2 text-slate-700">Lesson</div>
          <div class="grid sm:grid-cols-2 gap-3">
            <input type="text" name="modules[${modId}][lessons][][title]" placeholder="Lesson Title" class="input px-3 py-2 rounded text-sm w-full" required>
            <input type="url" name="modules[${modId}][lessons][][url]" placeholder="Link (Google Drive, YouTube...)" class="input px-3 py-2 rounded text-sm w-full" required>
          </div>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', lessonHtml);
    }
  </script>
</body>
</html>
