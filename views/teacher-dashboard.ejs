                    Shape
                  </label>

                  <select
                    id="badgeShape"
                    onchange="updateBadge()"
                    class="input px-4 py-3 rounded-lg"
                  >
                    <option value="badge-shape-shield">
                      Shield
                    </option>

                    <option value="badge-shape-hexagon">
                      Hexagon
                    </option>

                    <option value="badge-shape-circle">
                      Circle
                    </option>

                    <option value="badge-shape-diamond">
                      Diamond
                    </option>

                    <option value="badge-shape-star">
                      Star
                    </option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs text-slate-500 uppercase tracking-wider font-medium mb-2">
                    Color
                  </label>

                  <input
                    type="color"
                    id="badgeColor"
                    name="designColor"
                    value="#0f172a"
                    oninput="updateBadge()"
                    class="w-full h-12 p-0 border-0 rounded-lg cursor-pointer"
                  >
                </div>
              </div>

              <div>
                <label class="block text-xs text-slate-500 uppercase tracking-wider font-medium mb-3">
                  Icon
                </label>

                <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
                  <button
                    type="button"
                    onclick="setBadgeIcon('fa-shield-halved')"
                    class="btn btn-light p-3"
                  >
                    <i class="fa-solid fa-shield-halved text-xl"></i>
                  </button>

                  <button
                    type="button"
                    onclick="setBadgeIcon('fa-award')"
                    class="btn btn-light p-3"
                  >
                    <i class="fa-solid fa-award text-xl"></i>
                  </button>

                  <button
                    type="button"
                    onclick="setBadgeIcon('fa-code')"
                    class="btn btn-light p-3"
                  >
                    <i class="fa-solid fa-code text-xl"></i>
                  </button>

                  <button
                    type="button"
                    onclick="setBadgeIcon('fa-brain')"
                    class="btn btn-light p-3"
                  >
                    <i class="fa-solid fa-brain text-xl"></i>
                  </button>

                  <button
                    type="button"
                    onclick="setBadgeIcon('fa-bolt')"
                    class="btn btn-light p-3"
                  >
                    <i class="fa-solid fa-bolt text-xl"></i>
                  </button>

                  <button
                    type="button"
                    onclick="setBadgeIcon('fa-graduation-cap')"
                    class="btn btn-light p-3"
                  >
                    <i class="fa-solid fa-graduation-cap text-xl"></i>
                  </button>
                </div>
              </div>

              <button
                type="submit"
                class="btn btn-dark w-full py-4"
              >
                Create Badge
              </button>
            </form>

            <div class="space-y-6">
              <div class="relative min-h-[420px] p-10 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center overflow-hidden">
                <div
                  class="absolute inset-0 opacity-50"
                  style="background-image:radial-gradient(#cbd5e1 1px,transparent 1px);background-size:22px 22px"
                ></div>

                <div class="relative z-10 text-center">
                  <div
                    id="previewBadgeTitle"
                    class="text-sm font-semibold uppercase tracking-[0.22em] mb-8"
                  >
                    Certified Learner
                  </div>

                  <div class="relative w-56 h-56 mx-auto">
                    <div
                      id="previewBadgeBase"
                      class="badge-shape-shield w-full h-full flex flex-col items-center justify-center text-white shadow-2xl relative"
                      style="background:linear-gradient(145deg,#0f172a,#334155)"
                    >
                      <div class="badge-security-ring"></div>

                      <i
                        id="previewBadgeIcon"
                        class="fa-solid fa-shield-halved text-6xl relative z-10"
                      ></i>

                      <div class="mt-4 text-[10px] uppercase tracking-[0.25em] relative z-10">
                        Verified Skill
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="panel-strong rounded-2xl p-5">
                <div class="flex items-center justify-between gap-3 mb-4">
                  <h3 class="text-xl font-semibold">
                    Created Badges
                  </h3>

                  <span class="text-xs text-slate-400">
                    <%= safeBadges.length %>
                  </span>
                </div>

                <% if (safeBadges.length > 0) { %>
                  <div class="space-y-3 max-h-[28rem] overflow-y-auto custom-scroll">
                    <% safeBadges.slice().reverse().forEach(badge => { %>
                      <div class="p-4 rounded-xl border border-slate-200 flex items-center gap-3">
                        <div
                          class="w-12 h-12 rounded-xl text-white flex items-center justify-center shrink-0"
                          style="background:<%= badge.designColor || '#0f172a' %>"
                        >
                          <i class="fa-solid <%= badge.badgeIcon || 'fa-award' %>"></i>
                        </div>

                        <div>
                          <div class="font-semibold break-anywhere">
                            <%= badge.title %>
                          </div>

                          <div class="text-xs text-slate-500 mt-1">
                            <%= badge.assessmentId ? 'Linked assignment' : 'Standalone badge' %>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="p-8 rounded-xl border border-dashed border-slate-300 text-center text-sm text-slate-500">
                    No badges created yet.
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </section>

        <!-- ANNOUNCEMENTS -->
        <section
          class="view-panel hidden"
          data-view-panel="announcements"
        >
          <div class="grid lg:grid-cols-[minmax(260px,420px)_minmax(0,1fr)] gap-6">
            <div class="panel-strong rounded-2xl p-5 md:p-6 h-fit">
              <h2 class="text-2xl font-semibold">
                Global Announcement
              </h2>

              <p class="text-sm text-slate-500 mt-1 mb-6">
                Publish information to students across the platform.
              </p>

              <form
                action="/post-event"
                method="POST"
                class="space-y-5"
              >
                <input
                  type="text"
                  name="title"
                  placeholder="Announcement title"
                  class="input px-4 py-3 rounded-lg"
                  required
                >

                <textarea
                  name="description"
                  placeholder="Announcement details..."
                  class="input px-4 py-3 rounded-lg h-28 text-sm"
                ></textarea>

                <select
                  name="specialBadgeId"
                  class="input px-4 py-3 rounded-lg"
                >
                  <option value="">
                    No badge attached
                  </option>

                  <% safeBadges.forEach(badge => { %>
                    <option value="<%= badge.id || badge.templateId %>">
                      <%= badge.title %>
                    </option>
                  <% }) %>
                </select>

                <button
                  type="submit"
                  class="btn btn-purple w-full py-4"
                >
                  Publish Announcement
                </button>
              </form>
            </div>

            <div class="panel-strong rounded-2xl p-5 md:p-6">
              <h3 class="text-2xl font-semibold mb-5">
                Published Announcements
              </h3>

              <% if (safeEvents.length > 0) { %>
                <div class="space-y-3 max-h-[34rem] overflow-y-auto custom-scroll">
                  <% safeEvents.slice().reverse().forEach(item => { %>
                    <div class="p-5 rounded-xl border border-slate-200">
                      <div class="font-semibold break-anywhere">
                        <%= item.title %>
                      </div>

                      <p class="text-sm text-slate-500 mt-2 break-anywhere">
                        <%= item.description || 'No description.' %>
                      </p>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="p-12 rounded-xl border border-dashed border-slate-300 text-center">
                  <i class="fa-solid fa-bullhorn text-4xl text-slate-300 mb-4"></i>

                  <div class="font-semibold">
                    No announcements yet
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    const certificateTemplates = [
      {
        className: 'tpl-sovereign',
