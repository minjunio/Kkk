                    <% safeBadges.slice().reverse().forEach(b => { %>
                      <div class="flex items-center gap-3 border border-slate-200 rounded-xl p-4">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-white shrink-0" style="background:<%= b.designColor || '#0f172a' %>;">
                          <i class="fa-solid <%= b.badgeIcon || 'fa-award' %>"></i>
