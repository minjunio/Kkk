              </div>

              <div class="text-xs text-slate-500 font-semibold">
                Students receive a verification QR after passing.
              </div>
            </div>
          </div>
        </form>
      </div>

      <div id="keys-tab" class="tab-content hidden">
        <div class="grid xl:grid-cols-12 gap-8">
          <div class="xl:col-span-5 glass rounded-3xl p-6 md:p-8">
            <h3 class="text-2xl font-black text-slate-950">Generate Student/Class Key</h3>
            <p class="text-sm text-slate-500 mt-1 mb-6">Students paste this key on their dashboard to unlock a specific assessment.</p>

            <form action="/generate-student-key" method="POST" class="space-y-5">
              <div>
                <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">Class / Group Name</label>
                <input type="text" name="className" placeholder="Grade 10A - Python Final" class="modern-input w-full px-4 py-3 rounded-2xl font-semibold" required>
              </div>

              <div>
                <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">Assign Assessment</label>
                <select name="testId" class="modern-input w-full px-4 py-3 rounded-2xl font-semibold" required>
                  <option value="">Select assessment...</option>
                  <% safeTests.forEach(t => { %>
                    <option value="<%= t.id %>"><%= t.title %></option>
                  <% }) %>
                </select>
              </div>

              <button type="submit" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-2xl shadow-lg shadow-emerald-600/20">
                Generate Unique Key
              </button>
            </form>
          </div>

          <div class="xl:col-span-7 glass rounded-3xl p-6 md:p-8">
            <div class="flex items-center justify-between gap-4 mb-5">
              <div>
                <h3 class="text-2xl font-black text-slate-950">Recent Class Keys</h3>
                <p class="text-sm text-slate-500 mt-1">Copy and send these to your students.</p>
              </div>
            </div>

            <% if (safeStudentKeys.length > 0) { %>
              <div class="space-y-3 max-h-[30rem] overflow-y-auto custom-scroll pr-1">
                <% safeStudentKeys.slice().reverse().forEach(k => { %>
                  <div class="border border-slate-200 bg-white rounded-2xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-black text-slate-950"><%= k.className %></span>
                        <span class="text-[10px] font-black px-2 py-1 rounded-full bg-emerald-100 text-emerald-700">
                          <%= k.active === false ? 'DISABLED' : 'ACTIVE' %>
                        </span>
                      </div>
                      <div class="text-xs text-slate-500 mt-1">
                        Assessment: <span class="font-semibold"><%= k.testTitle %></span> • Joined: <%= k.usageCount || 0 %>
                      </div>
                    </div>

                    <div class="flex items-center gap-2">
                      <code class="px-3 py-2 bg-slate-100 text-slate-900 rounded-xl text-xs font-black tracking-wider"><%= k.key %></code>
                      <button type="button" onclick="copyText('<%= k.key %>')" class="px-3 py-2 bg-slate-900 text-white rounded-xl text-xs font-black">
                        Copy
                      </button>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="p-10 rounded-2xl border border-dashed border-slate-300 text-center">
                <i class="fa-solid fa-key text-4xl text-slate-300 mb-4"></i>
                <div class="font-black text-slate-900">No keys generated yet</div>
                <p class="text-sm text-slate-500 mt-1">Create an assessment, then generate a class key for students.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div id="events-tab" class="tab-content hidden">
        <div class="grid xl:grid-cols-12 gap-8">
          <div class="xl:col-span-5 glass rounded-3xl p-6 md:p-8">
            <h3 class="text-2xl font-black text-slate-950">Post Special Event</h3>
            <p class="text-sm text-slate-500 mt-1 mb-6">Show announcements, skill challenges, or badge events on student dashboards.</p>

            <form action="/post-event" method="POST" class="space-y-5">
              <div>
                <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">Event Title</label>
                <input type="text" name="title" placeholder="Winter Skill Challenge 2026" class="modern-input w-full px-4 py-3 rounded-2xl font-semibold" required>
              </div>

              <div>
                <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">Description</label>
                <textarea name="description" placeholder="Complete 3 skill badges to earn exclusive recognition." class="modern-input w-full px-4 py-3 rounded-2xl h-24 text-sm"></textarea>
              </div>

              <div>
                <label class="block text-xs font-black text-slate-400 uppercase tracking-wider mb-2">Attach Special Badge Optional</label>
                <select name="specialBadgeId" class="modern-input w-full px-4 py-3 rounded-2xl font-semibold">
                  <option value="">No badge attached</option>
                  <% safeBadges.forEach(b => { %>
                    <option value="<%= b.id || b.templateId %>"><%= b.title %></option>
                  <% }) %>
                </select>
              </div>

              <button type="submit" class="w-full py-4 bg-violet-600 hover:bg-violet-700 text-white font-black rounded-2xl shadow-lg shadow-violet-600/20">
                Publish Event
              </button>
            </form>
          </div>

          <div class="xl:col-span-7 glass rounded-3xl p-6 md:p-8">
            <h3 class="text-2xl font-black text-slate-950 mb-5">Published Events</h3>

            <% if (safeEvents.length > 0) { %>
              <div class="space-y-3 max-h-[30rem] overflow-y-auto custom-scroll pr-1">
                <% safeEvents.slice().reverse().forEach(e => { %>
                  <div class="bg-white border border-slate-200 rounded-2xl p-5">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <div class="font-black text-slate-950"><%= e.title %></div>
                        <p class="text-sm text-slate-500 mt-1"><%= e.description || 'No description.' %></p>
                        <div class="text-xs text-slate-400 mt-3">
                          <i class="fa-regular fa-calendar mr-1"></i>
                          <%= e.date || e.createdAt || 'Recently' %>
                        </div>
                      </div>

                      <% if (e.specialBadgeId) { %>
                        <span class="text-[10px] font-black px-3 py-1 rounded-full bg-amber-100 text-amber-700 whitespace-nowrap">
                          SPECIAL BADGE
                        </span>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="p-10 rounded-2xl border border-dashed border-slate-300 text-center">
                <i class="fa-regular fa-calendar text-4xl text-slate-300 mb-4"></i>
                <div class="font-black text-slate-900">No events yet</div>
                <p class="text-sm text-slate-500 mt-1">Post a student challenge or announcement.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div id="overview-tab" class="tab-content hidden">
        <div class="grid lg:grid-cols-2 gap-8">
          <div class="glass rounded-3xl p-6 md:p-8">
            <div class="flex items-center justify-between mb-5">
              <h3 class="text-2xl font-black text-slate-950">My Credentials</h3>
              <span class="text-xs font-black text-slate-500 bg-slate-100 px-3 py-1 rounded-full"><%= safeBadges.length %> total</span>
            </div>

            <% if (safeBadges.length > 0) { %>
              <div class="space-y-3 max-h-96 overflow-y-auto custom-scroll pr-1">
                <% safeBadges.slice().reverse().forEach(b => { %>
                  <div class="bg-white border border-slate-200 rounded-2xl p-4 flex items-center justify-between gap-4">
                    <div>
                      <div class="font-black text-slate-950"><%= b.title %></div>
                      <div class="text-xs text-slate-500 mt-1">
                        <%= b.type || 'credential' %> • <%= b.createdBy || teacherName %>
                      </div>
                    </div>
                    <div class="text-xs font-black px-3 py-1 rounded-full bg-emerald-100 text-emerald-700">
                      QR READY
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="p-10 rounded-2xl border border-dashed border-slate-300 text-center">
                <i class="fa-solid fa-award text-4xl text-slate-300 mb-4"></i>
                <div class="font-black text-slate-900">No credentials yet</div>
                <p class="text-sm text-slate-500 mt-1">Create a certificate or badge from the studio.</p>
              </div>
            <% } %>
          </div>

          <div class="glass rounded-3xl p-6 md:p-8">
            <div class="flex items-center justify-between mb-5">
              <h3 class="text-2xl font-black text-slate-950">My Assessments</h3>
              <span class="text-xs font-black text-slate-500 bg-slate-100 px-3 py-1 rounded-full"><%= safeTests.length %> total</span>
            </div>

            <% if (safeTests.length > 0) { %>
              <div class="space-y-3 max-h-96 overflow-y-auto custom-scroll pr-1">
                <% safeTests.slice().reverse().forEach(t => { %>
                  <div class="bg-white border border-slate-200 rounded-2xl p-4 flex items-center justify-between gap-4">
                    <div>
                      <div class="font-black text-slate-950"><%= t.title %></div>
                      <div class="text-xs text-slate-500 mt-1">
                        <%= t.questions ? t.questions.length : 0 %> questions • <%= t.requiresKey ? 'Key required' : 'Open' %>
                      </div>
                    </div>
                    <a href="/take-test/<%= t.id %>" class="text-xs font-black px-3 py-2 rounded-xl bg-slate-900 text-white">
                      Preview
                    </a>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="p-10 rounded-2xl border border-dashed border-slate-300 text-center">
                <i class="fa-solid fa-clipboard-question text-4xl text-slate-300 mb-4"></i>
                <div class="font-black text-slate-900">No assessments yet</div>
                <p class="text-sm text-slate-500 mt-1">Create your first test from the Assessment tab.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const templates = [
      { id: '1-degree', name: "Classic Degree" },
      { id: '2-university', name: "University Seal" },
      { id: '3-corporate', name: "Corporate" },
      { id: '4-tech', name: "Tech Grid" },
      { id: '5-scholar', name: "Gold Scholar" },
      { id: '6-minimal', name: "Minimal" },
      { id: '7-executive', name: "Executive" },
      { id: '8-dark', name: "Dark Pro" },
      { id: '9-honors', name: "Honors" },
      { id: '10-cyber', name: "Cyber" },
      { id: '11-startup', name: "Startup" },
      { id: '12-medical', name: "Medical" }
    ];

    const presetLogos = [
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/googlecloud/googlecloud-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-original-wordmark.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg'
    ];

    let currentTemplate = 'tpl-1-degree';
    let activeLogos = [];

    function initTeacherDashboard() {
      const dateInput = document.getElementById('cert-date');
      if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];

      renderTemplateButtons();
      renderLogoButtons();
      updateCert();
      updateBadge();
    }

    function scrollToWorkspace() {
      document.getElementById('workspace').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function showTab(tab) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(tab + '-tab').classList.remove('hidden');

      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('tab-active');
        el.classList.add('text-slate-500', 'border-transparent');
      });

      const activeBtn = document.getElementById('tab-' + tab);
      activeBtn.classList.add('tab-active');
      activeBtn.classList.remove('text-slate-500', 'border-transparent');
    }

    function renderTemplateButtons() {
      const templateGrid = document.getElementById('template-grid');
      if (!templateGrid) return;

      templateGrid.innerHTML = '';

      templates.forEach(t => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'snap-start flex-shrink-0 px-4 py-2 bg-white border border-slate-300 rounded-xl text-sm font-bold hover:border-blue-500 hover:bg-blue-50 transition-all';
        btn.innerText = t.name;
        btn.onclick = () => setTemplate(t.id, btn);
        templateGrid.appendChild(btn);
      });

      if (templateGrid.firstChild) {
        templateGrid.firstChild.classList.add('border-blue-600', 'bg-blue-50', 'text-blue-700');
      }
    }

    function renderLogoButtons() {
      const logoGrid = document.getElementById('logo-grid');
      if (!logoGrid) return;

      logoGrid.innerHTML = '';

      presetLogos.forEach(url => {
        const img = document.createElement('img');
        img.src = url;
        img.className = 'w-10 h-10 p-1.5 cursor-pointer bg-slate-50 rounded-lg border border-transparent hover:border-blue-500 object-contain';
        img.onclick = () => addLogoToDoc(url);
        logoGrid.appendChild(img);
      });
    }

    function setTemplate(id, clickedBtn) {
      const preview = document.getElementById('cert-preview');
      if (!preview) return;

      preview.classList.remove(currentTemplate);
      currentTemplate = `tpl-${id}`;
      preview.classList.add(currentTemplate);

      const hidden = document.getElementById('selected-certificate-template');
      if (hidden) hidden.value = currentTemplate;

      document.querySelectorAll('#template-grid button').forEach(btn => {
        btn.classList.remove('border-blue-600', 'bg-blue-50', 'text-blue-700');
      });

      if (clickedBtn) {
        clickedBtn.classList.add('border-blue-600', 'bg-blue-50', 'text-blue-700');
      }

      updateCert();
    }

    function updateCert() {
      const title = document.getElementById('cert-title')?.value || 'Certificate of Achievement';
      const desc = document.getElementById('cert-desc')?.value || '';
      const color = document.getElementById('cert-color')?.value || '#1e293b';
      const student = document.getElementById('cert-student')?.value || '[Student Name]';
      const signature = document.getElementById('cert-signature')?.value || 'Authorized Signature';
      const dateVal = document.getElementById('cert-date')?.value;

      const preview = document.getElementById('cert-preview');
      if (preview) {
        preview.style.borderColor = color;
        preview.style.outlineColor = color;
      }

      const titleEl = document.getElementById('preview-title');
      const descEl = document.getElementById('preview-desc');
      const studentEl = document.getElementById('preview-student');
      const sigEl = document.getElementById('preview-signature');
      const dateEl = document.getElementById('preview-date-display');

      if (titleEl) titleEl.innerText = title;
      if (descEl) descEl.innerText = desc;
      if (studentEl) studentEl.innerText = student;
      if (sigEl) sigEl.innerText = signature;
      if (dateEl && dateVal) dateEl.innerText = new Date(dateVal).toLocaleDateString();
    }

    function addCustomLogo() {
      const input = document.getElementById('custom-logo-input');
      const url = input.value.trim();

      if (!url) return;

      addLogoToDoc(url);
      input.value = '';
    }

    function addLogoToDoc(url) {
      if (activeLogos.length >= 3) {
        alert('You can add up to 3 logos.');
        return;
      }

      const boundary = document.getElementById('drag-boundary');
      if (!boundary) return;

      const id = 'logo_' + Date.now();

      const wrapper = document.createElement('div');
      wrapper.id = id;
      wrapper.className = 'draggable-logo';
      wrapper.style.left = (8 + activeLogos.length * 10) + '%';
      wrapper.style.top = '8%';

      const img = document.createElement('img');
      img.src = url;
      img.alt = 'Certificate logo';

      img.onload = () => {
        wrapper.appendChild(img);
        boundary.appendChild(wrapper);
        makeDraggable(wrapper);

        activeLogos.push({ id, url });
        renderActiveLogosList();
        syncHiddenLogos();
      };

      img.onerror = () => {
        alert('Logo could not load. Try a direct image URL ending in .png, .jpg, .svg, or .webp.');
      };
    }

    function removeLogo(id) {
      activeLogos = activeLogos.filter(l => l.id !== id);
      const el = document.getElementById(id);
      if (el) el.remove();

      renderActiveLogosList();
      syncHiddenLogos();
    }

    function clearCertificateLogos() {
      activeLogos.forEach(l => {
        const el = document.getElementById(l.id);
        if (el) el.remove();
      });

      activeLogos = [];
      renderActiveLogosList();
      syncHiddenLogos();
    }

    function renderActiveLogosList() {
      const list = document.getElementById('active-logos-list');
      if (!list) return;

      list.innerHTML = '';

      if (activeLogos.length === 0) {
        list.innerHTML = '<span class="text-xs text-slate-400 font-semibold">No logos added yet.</span>';
        return;
      }

      activeLogos.forEach((logo, index) => {
        const badge = document.createElement('div');
        badge.className = 'flex items-center gap-2 bg-slate-100 pl-2 pr-1 py-1 rounded-lg text-xs font-bold border border-slate-200';

        badge.innerHTML = `
          <img src="${logo.url}" class="w-4 h-4 object-contain" alt="">
          <span>Logo ${index + 1}</span>
          <button type="button" onclick="removeLogo('${logo.id}')" class="text-red-500 hover:text-red-600 px-1">
            <i class="fa-solid fa-xmark"></i>
          </button>
        `;

        list.appendChild(badge);
      });
    }

    function syncHiddenLogos() {
      const holder = document.getElementById('certificate-hidden-logos');
      if (!holder) return;

      holder.innerHTML = '';

      activeLogos.forEach(logo => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'logoUrl';
        input.value = logo.url;
        holder.appendChild(input);
      });
    }

    function makeDraggable(elmnt) {
      let startX = 0;
      let startY = 0;
      let startLeft = 0;
      let startTop = 0;

      elmnt.addEventListener('pointerdown', dragStart);

      function dragStart(e) {
        e.preventDefault();

        const boundary = document.getElementById('drag-boundary').getBoundingClientRect();
        const rect = elmnt.getBoundingClientRect();

        startX = e.clientX;
        startY = e.clientY;
        startLeft = ((rect.left - boundary.left) / boundary.width) * 100;
        startTop = ((rect.top - boundary.top) / boundary.height) * 100;

        elmnt.setPointerCapture(e.pointerId);
        elmnt.addEventListener('pointermove', dragMove);
        elmnt.addEventListener('pointerup', dragEnd);
        elmnt.addEventListener('pointercancel', dragEnd);
      }

      function dragMove(e) {
        const boundary = document.getElementById('drag-boundary').getBoundingClientRect();

        const deltaX = ((e.clientX - startX) / boundary.width) * 100;
        const deltaY = ((e.clientY - startY) / boundary.height) * 100;

        const newLeft = Math.max(0, Math.min(startLeft + deltaX, 92));
        const newTop = Math.max(0, Math.min(startTop + deltaY, 92));

        elmnt.style.left = newLeft + '%';
        elmnt.style.top = newTop + '%';
      }

      function dragEnd(e) {
        elmnt.releasePointerCapture(e.pointerId);
        elmnt.removeEventListener('pointermove', dragMove);
        elmnt.removeEventListener('pointerup', dragEnd);
        elmnt.removeEventListener('pointercancel', dragEnd);
      }
    }

    function setBadgeIcon(iconClass) {
      const hidden = document.getElementById('selected-badge-icon');
      const previewIcon = document.getElementById('preview-badge-icon');

      if (hidden) hidden.value = iconClass;
      if (previewIcon) {
        previewIcon.className = `fa-solid ${iconClass} text-[3.9rem] text-white mb-3 drop-shadow-xl z-20`;
      }
    }

    function updateBadge() {
      const title = document.getElementById('badge-title')?.value || 'Badge Title';
      const shape = document.getElementById('badge-shape')?.value || 'shape-shield';
      const color = document.getElementById('badge-color')?.value || '#0f172a';

      const titlePreview = document.getElementById('preview-badge-text');
      const base = document.getElementById('preview-badge-base');
      const hiddenShape = document.getElementById('selected-badge-shape');

      if (titlePreview) titlePreview.innerText = title;
      if (hiddenShape) hiddenShape.value = shape;

      if (base) {
        base.className = `badge-base ${shape} w-full h-full shadow-2xl flex flex-col justify-center items-center relative`;
        base.style.background = `linear-gradient(145deg, ${color}, #0f172a)`;
      }
    }

    function insertQuestionTemplate() {
      const box = document.getElementById('questionsBox');
      if (!box) return;

      box.value = JSON.stringify([
        {
          q: 'What is a variable in programming?',
          type: 'mcq',
          options: ['A container for data', 'A type of loop', 'A function call', 'A comment'],
          answer: 'A container for data',
          timer: 60
        },
        {
          q: 'Explain the difference between == and === in JavaScript.',
          type: 'frq',
          timer: 120
        },
        {
          q: 'Which keyword declares a constant in JavaScript?',
          type: 'mcq',
          options: ['var', 'let', 'const', 'static'],
          answer: 'const',
          timer: 45
        }
      ], null, 2);
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        alert('Copied: ' + text);
      } catch (err) {
        prompt('Copy this key:', text);
      }
    }

    window.addEventListener('load', initTeacherDashboard);
  </script>
</body>
</html>