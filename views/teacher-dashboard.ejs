      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/googlecloud/googlecloud-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg'
    ];

    let currentCertificateTemplate =
      'tpl-sovereign';

    let activeCertificateLogos = [];

    function openSidebar() {
      document
        .getElementById('sidebar')
        .classList.add('open');

      document
        .getElementById('mobileOverlay')
        .classList.add('open');
    }

    function closeSidebar() {
      document
        .getElementById('sidebar')
        .classList.remove('open');

      document
        .getElementById('mobileOverlay')
        .classList.remove('open');
    }

    function showView(view, scroll = true) {
      document
        .querySelectorAll('.view-panel')
        .forEach(panel => {
          panel.classList.add('hidden');
        });

      const selectedPanel =
        document.querySelector(
          `[data-view-panel="${view}"]`
        );

      if (selectedPanel) {
        selectedPanel.classList.remove('hidden');
      }

      document
        .querySelectorAll('[data-view-link]')
        .forEach(link => {
          link.classList.remove('active');
        });

      const selectedLink =
        document.querySelector(
          `[data-view-link="${view}"]`
        );

      if (selectedLink) {
        selectedLink.classList.add('active');
      }

      history.replaceState(
        null,
        '',
        `#${view}`
      );

      closeSidebar();

      if (scroll) {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }
    }

    function selectClass(classId) {
      showView('classes');

      document
        .querySelectorAll('[data-class-button]')
        .forEach(button => {
          button.classList.remove('active');
        });

      const classButton =
        document.querySelector(
          `[data-class-button="${classId}"]`
        );

      if (classButton) {
        classButton.classList.add('active');
      }

      document
        .querySelectorAll('[data-class-panel]')
        .forEach(panel => {
          panel.classList.add('hidden');
        });

      const classPanel =
        document.querySelector(
          `[data-class-panel="${classId}"]`
        );

      if (classPanel) {
        classPanel.classList.remove('hidden');

        setTimeout(() => {
          classPanel.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }, 100);
      }
    }

    function selectTask(taskId) {
      showView('tasks');

      document
        .querySelectorAll('[data-task-button]')
        .forEach(button => {
          button.classList.remove('active');
        });

      const taskButton =
        document.querySelector(
          `[data-task-button="${taskId}"]`
        );

      if (taskButton) {
        taskButton.classList.add('active');
      }

      document
        .querySelectorAll('[data-task-card]')
        .forEach(card => {
          card.style.outline = '';
          card.style.outlineOffset = '';
        });

      const taskCard =
        document.querySelector(
          `[data-task-card="${taskId}"]`
        );

      if (taskCard) {
        taskCard.style.outline =
          '3px solid rgba(37,99,235,.22)';

        taskCard.style.outlineOffset =
          '2px';

        setTimeout(() => {
          taskCard.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });
        }, 100);
      }
    }

    function renderTemplatePicker() {
      const container =
        document.getElementById(
          'templatePicker'
        );

      if (!container) return;

      container.innerHTML = '';

      certificateTemplates.forEach(
        (template, index) => {
          const button =
            document.createElement('button');

          button.type = 'button';

          button.className =
            `template-picker-button ${
              index === 0 ? 'active' : ''
            }`;

          button.innerHTML = `
            <div
              class="template-miniature"
              style="
                --mini-paper:${template.paper};
                --mini-accent:${template.accent};
                --mini-secondary:${template.secondary};
                --mini-border:${template.border};
              "
            ></div>

            <div class="text-sm font-semibold">
              ${template.name}
            </div>

            <div class="text-xs text-slate-500 mt-1">
              ${template.subtitle}
            </div>
          `;

          button.onclick = () =>
            setCertificateTemplate(
              template,
              button
            );

          container.appendChild(button);
        }
      );
    }

    function setCertificateTemplate(
      template,
      button
    ) {
      const preview =
        document.getElementById(
          'certificatePreview'
        );

      preview.classList.remove(
        currentCertificateTemplate
      );

      preview.classList.add(
        template.className
      );

      currentCertificateTemplate =
        template.className;

      document.getElementById(
        'selectedCertificateTemplate'
      ).value = template.className;

      document.getElementById(
        'certColor'
      ).value = template.accent;

      preview.style.setProperty(
        '--cert-accent',
        template.accent
      );

      preview.style.setProperty(
        '--cert-secondary',
        template.secondary
      );

      document
        .querySelectorAll(
          '.template-picker-button'
        )
        .forEach(item => {
          item.classList.remove('active');
        });

      button.classList.add('active');

      updateCertificate();
    }

    function updateCertificate() {
      const title =
        document.getElementById(
          'certTitle'
        )?.value ||
        'Certificate of Achievement';

      const description =
        document.getElementById(
          'certDescription'
        )?.value ||
        '';

      const student =
        document.getElementById(
          'certStudent'
        )?.value ||
        'Student Name';

      const signature =
        document.getElementById(
          'certSignature'
        )?.value ||
        'Authorized Teacher';

      const date =
        document.getElementById(
          'certDate'
        )?.value;

      const accent =
        document.getElementById(
          'certColor'
        )?.value ||
        '#14213d';

      document.getElementById(
        'previewTitle'
      ).textContent = title;

      document.getElementById(
        'previewDescription'
      ).textContent = description;

      document.getElementById(
        'previewStudent'
      ).textContent = student;

      document.getElementById(
        'previewSignature'
      ).textContent = signature;

      if (date) {
        document.getElementById(
          'previewDate'
        ).textContent =
          new Date(
            `${date}T12:00:00`
          ).toLocaleDateString();
      }

      document
        .getElementById(
          'certificatePreview'
        )
        .style.setProperty(
          '--cert-accent',
          accent
        );
    }

    function renderLogoButtons() {
      const container =
        document.getElementById(
          'logoGrid'
        );

      if (!container) return;

      container.innerHTML = '';

      presetLogos.forEach(url => {
        const button =
          document.createElement('button');

        button.type = 'button';

        button.className =
          'w-11 h-11 p-1.5 rounded-lg border border-transparent bg-slate-50 hover:border-blue-500';

        button.innerHTML = `
          <img
            src="${url}"
            alt="Preset logo"
            class="w-full h-full object-contain"
          >
        `;

        button.onclick = () =>
          addLogoToCertificate(url);

        container.appendChild(button);
      });
    }

    function addCustomLogo() {
      const input =
        document.getElementById(
          'customLogoInput'
        );

      const url =
        input.value.trim();

      if (!url) return;

      addLogoToCertificate(url);

      input.value = '';
    }

    function addLogoToCertificate(url) {
      if (
        activeCertificateLogos.length >= 3
      ) {
        alert(
          'You can add up to three logos.'
        );

        return;
      }

      const boundary =
        document.getElementById(
          'logoDragBoundary'
        );

      const id =
        `certificate_logo_${Date.now()}`;

      const wrapper =
        document.createElement('div');

      wrapper.id = id;
      wrapper.className = 'draggable-logo';

      wrapper.style.left =
        `${8 + activeCertificateLogos.length * 11}%`;

      wrapper.style.top = '7%';

      const image =
        document.createElement('img');

      image.src = url;
      image.alt = 'Certificate logo';

      image.onload = () => {
        wrapper.appendChild(image);
        boundary.appendChild(wrapper);

        makeDraggable(wrapper);

        activeCertificateLogos.push({
          id,
          url
        });

        renderActiveLogos();
        syncHiddenLogos();
      };

      image.onerror = () => {
        alert(
          'The logo could not be loaded. Use a direct image URL.'
        );
      };
    }

    function removeCertificateLogo(id) {
      activeCertificateLogos =
        activeCertificateLogos.filter(
          logo => logo.id !== id
        );

      document
        .getElementById(id)
        ?.remove();

      renderActiveLogos();
      syncHiddenLogos();
    }

    function clearCertificateLogos() {
      activeCertificateLogos.forEach(
        logo => {
          document
            .getElementById(logo.id)
            ?.remove();
        }
      );

      activeCertificateLogos = [];

      renderActiveLogos();
      syncHiddenLogos();
    }

    function renderActiveLogos() {
      const container =
        document.getElementById(
          'activeLogosList'
        );

      container.innerHTML = '';

      if (
        activeCertificateLogos.length === 0
      ) {
        container.innerHTML =
          '<span class="text-xs text-slate-400">No logos added.</span>';

        return;
      }

      activeCertificateLogos.forEach(
        (logo, index) => {
          const item =
            document.createElement('div');

          item.className =
            'max-w-full flex items-center gap-2 pl-2 pr-1 py-1 rounded-lg bg-slate-100 border border-slate-200 text-xs';

          item.innerHTML = `
            <img
              src="${logo.url}"
              alt=""
              class="w-4 h-4 object-contain"
            >

            <span class="truncate">
              Logo ${index + 1}
            </span>

            <button
              type="button"
              onclick="removeCertificateLogo('${logo.id}')"
              class="px-1 text-red-500"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>
          `;

          container.appendChild(item);
        }
      );
    }

    function syncHiddenLogos() {
      const container =
        document.getElementById(
          'certificateHiddenLogos'
        );

      container.innerHTML = '';

      activeCertificateLogos.forEach(
        logo => {
          const input =
            document.createElement('input');

          input.type = 'hidden';
          input.name = 'logoUrl';
          input.value = logo.url;

          container.appendChild(input);
        }
      );
    }

    function makeDraggable(element) {
      let startingX = 0;
      let startingY = 0;
      let startingLeft = 0;
      let startingTop = 0;

      element.addEventListener(
        'pointerdown',
        startDragging
      );

      function startDragging(event) {
        event.preventDefault();

        const boundary =
          document
            .getElementById(
              'logoDragBoundary'
            )
            .getBoundingClientRect();

        const rectangle =
          element.getBoundingClientRect();

        startingX = event.clientX;
        startingY = event.clientY;

        startingLeft =
          (
            (
              rectangle.left -
              boundary.left
            ) /
            boundary.width
          ) *
          100;

        startingTop =
          (
            (
              rectangle.top -
              boundary.top
            ) /
            boundary.height
          ) *
          100;

        element.setPointerCapture(
          event.pointerId
        );

        element.addEventListener(
          'pointermove',
          moveLogo
        );

        element.addEventListener(
          'pointerup',
          stopDragging
        );

        element.addEventListener(
          'pointercancel',
          stopDragging
        );
      }

      function moveLogo(event) {
        const boundary =
          document
            .getElementById(
              'logoDragBoundary'
            )
            .getBoundingClientRect();

        const deltaX =
          (
            (
              event.clientX -
              startingX
            ) /
            boundary.width
          ) *
          100;

        const deltaY =
          (
            (
              event.clientY -
              startingY
            ) /
            boundary.height
          ) *
          100;

        element.style.left =
          `${Math.max(
            0,
            Math.min(
              startingLeft + deltaX,
              91
            )
          )}%`;

        element.style.top =
          `${Math.max(
            0,
            Math.min(
              startingTop + deltaY,
              91
            )
          )}%`;
      }

      function stopDragging(event) {
        try {
          element.releasePointerCapture(
            event.pointerId
          );
        } catch {}

        element.removeEventListener(
          'pointermove',
          moveLogo
        );

        element.removeEventListener(
          'pointerup',
          stopDragging
        );

        element.removeEventListener(
          'pointercancel',
          stopDragging
        );
      }
    }

    function setBadgeIcon(iconClass) {
      document.getElementById(
        'selectedBadgeIcon'
      ).value = iconClass;

      document.getElementById(
        'previewBadgeIcon'
      ).className =
        `fa-solid ${iconClass} text-6xl relative z-10`;
    }

    function updateBadge() {
      const title =
        document.getElementById(
          'badgeTitle'
        )?.value ||
        'Certified Learner';

      const shape =
        document.getElementById(
          'badgeShape'
        )?.value ||
        'badge-shape-shield';

      const color =
        document.getElementById(
          'badgeColor'
        )?.value ||
        '#0f172a';

      document.getElementById(
        'previewBadgeTitle'
      ).textContent = title;

      document.getElementById(
        'selectedBadgeShape'
      ).value = shape;

      const preview =
        document.getElementById(
          'previewBadgeBase'
        );

      preview.className =
        `${shape} w-full h-full flex flex-col items-center justify-center text-white shadow-2xl relative`;

      preview.style.background =
        `linear-gradient(145deg, ${color}, #0f172a)`;
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(
          text
        );

        alert(`Copied: ${text}`);
      } catch {
        prompt(
          'Copy this value:',
          text
        );
      }
    }

    function initializeDashboard() {
      const dateInput =
        document.getElementById(
          'certDate'
        );

      if (dateInput) {
        dateInput.value =
          new Date()
            .toISOString()
            .split('T')[0];
      }

      renderTemplatePicker();
      renderLogoButtons();
      renderActiveLogos();
      updateCertificate();
      updateBadge();

      const hash =
        window.location.hash.replace(
          '#',
          ''
        );

      if (
        hash &&
        document.querySelector(
          `[data-view-panel="${hash}"]`
        )
      ) {
        showView(hash, false);
      }
    }

    window.addEventListener(
      'load',
      initializeDashboard
    );
  </script>
</body>
</html>